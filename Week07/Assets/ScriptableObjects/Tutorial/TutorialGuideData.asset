--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 157eaca233ea8054cbb544d6601ccdea, type: 3}
  m_Name: TutorialGuideData
  m_EditorClassIdentifier: Assembly-CSharp::TutorialGuideData
  PhaseGuides:
  - Phase: 2
    SpeakerSprite: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    GuideText: "\uC774\uACF3\uC5D0\uC11C \uB300\uB7C9 \uC0AC\uAC74\uC774 \uBC1C\uC0DD
      \uD560\uAC70\uAC19\uC544"
  - Phase: 3
    SpeakerSprite: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    GuideText: "\uC800\uCABD \uAD6C\uC5ED\uC5D0 \uC0AC\uB78C\uC774 \uC788\uB124 \uAC00\uC11C
      \uC774\uC57C\uAE30 \uD574\uBCFC\uAE4C?"
  - Phase: 4
    SpeakerSprite: {fileID: 0}
    GuideText: "<color=green>\uB9C8\uC6B0\uC2A4 \uC67C\uD074\uB9AD(\uC720\uC9C0)</color>\uD574
      \uD45C\uC2DC\uB41C \uAD6C\uC5ED \uAE4C\uC9C0 \uCE90\uB9AD\uD130\uB97C \uC774\uB3D9
      \uC2DC\uCF1C \uBCF4\uC138\uC694."
  - Phase: 5
    SpeakerSprite: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    GuideText: "\uC88B\uC544 \uC0AC\uB78C\uACFC \uB300\uD654 \uD574\uBD10\uC57C\uC9C0"
  - Phase: 6
    SpeakerSprite: {fileID: 0}
    GuideText: "\uC624\uB978\uCABD \uAE43\uD138\uD39C\uC744 <color=green>\uB9C8\uC6B0\uC2A4
      \uC67C\uD074\uB9AD(\uD074\uB9AD)</color>\uD558\uC5EC \uB300\uD654\uD558\uAE30\uB97C
      <color=green>\uD074\uB9AD</color>\uD558\uC5EC \uB2E4\uC74C \uC2DC\uAC04\uC73C\uB85C
      \uB118\uC5B4\uAC00 \uBD05\uC2DC\uB2E4."
  - Phase: 7
    SpeakerSprite: {fileID: 0}
    GuideText: "\uB108\uB294 \uB204\uAD6C\uC57C?"
  - Phase: 8
    SpeakerSprite: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    GuideText: "\uB098\uB294 (\uC8FC\uC778\uACF5 \uC774\uB984)\uC774\uACE0 \uC0AC\uAC74\uC744
      \uC804\uB2F4\uD558\uAE30 \uC704\uD574 \uC774\uACF3\uC5D0 \uC654\uC5B4"
  - Phase: 9
    SpeakerSprite: {fileID: 0}
    GuideText: "\uC0AC\uAC74\uC744 \uCD94\uB9AC\uD558\uB294 \uC0AC\uB78C\uC774\uC57C?"
  - Phase: 10
    SpeakerSprite: {fileID: 0}
    GuideText: "\uADF8\uB7FC \uC6B0\uB9AC\uB97C \uB3C4\uC640\uC918! \uC774\uACF3\uC5D0
      \uC0B4\uC778\uC790\uAC00 \uC788\uB300!"
  - Phase: 11
    SpeakerSprite: {fileID: 0}
    GuideText: "\uC5EC\uD0DC\uAECF \uC815\uBCF4\uB4E4\uC774 \uC788\uB294\uB370 \uB108\uC5D0\uAC8C
      \uC904\uAC8C!"
  - Phase: 12
    SpeakerSprite: {fileID: 0}
    GuideText: "\uC67C\uCABD \uC0AC\uAC74 \uAE30\uB85D\uC9C0, \uC544\uB798 \uC774\uB3D9
      \uACBD\uB85C \uAE30\uB85D\uC9C0, \uCE90\uB9AD\uD130 \uC778\uBB3C \uAE30\uB85D\uC9C0,
      \uC5ED\uD560 \uBA54\uBAA8\uC218\uCCA9 \uC5F4\uB78C \uC548\uB0B4"
  - Phase: 13
    SpeakerSprite: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    GuideText: "\uC0B4\uC778\uC790..? \uC6A9\uC758\uC790\uB4E4\uC744 \uAE30\uB85D
      \uD574\uBD10\uC57C\uACA0\uC5B4"
  - Phase: 14
    SpeakerSprite: {fileID: 0}
    GuideText: "\uC67C\uCABD \uC5ED\uD560 \uAE30\uB2A5 \uD328\uB110\uC744 <color=green>\uB9C8\uC6B0\uC2A4
      \uC67C\uD074\uB9AD(\uD074\uB9AD)</color>\uD558\uC5EC \uAC01 \uC6A9\uC758\uC790\uB4E4\uC758
      \uC5ED\uD560\uC744 \uD655\uC778\uD574 \uBCF4\uC138\uC694."
  - Phase: 15
    SpeakerSprite: {fileID: 0}
    GuideText: "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4 \uC5ED\uD560 \uAE30\uB2A5 \uD328\uB110\uC744
      <color=green>\uB9C8\uC6B0\uC2A4 \uC67C\uD074\uB9AD(\uD074\uB9AD)</color>\uD558\uC5EC
      \uB2EB\uC544\uBCF4\uC138\uC694"
  - Phase: 16
    SpeakerSprite: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    GuideText: "\uC0AC\uAC74 \uAE30\uB85D\uC9C0..? \uC774\uAC74 \uC0AC\uB78C\uB4E4\uC774
      \uC5B4\uB514\uB85C \uC774\uB3D9\uD558\uB294\uC9C0 \uBCF4\uC774\uB294\uAC70\uAD6C\uB098!"
  - Phase: 17
    SpeakerSprite: {fileID: 0}
    GuideText: "\uC67C\uCABD \uC544\uB798 \uC0AC\uAC74 \uAE30\uB85D \uD30C\uC77C\uC758 
      \uCC45\uAC08\uD53C\uB97C <color=green>\uB9C8\uC6B0\uC2A4 \uC67C\uD074\uB9AD(\uD074\uB9AD)</color>\uD558\uC5EC
      \uC9C0\uB09C \uC2DC\uAC04\uC758 \uC774\uB3D9 \uACBD\uB85C\uB97C \uB2E4\uC2DC
      \uD655\uC778\uD558\uC138\uC694."
  - Phase: 18
    SpeakerSprite: {fileID: 0}
    GuideText: "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4. \uAC19\uC740 \uCC45\uAC08\uD53C\uB97C
      <color=green>\uB9C8\uC6B0\uC2A4 \uC67C\uD074\uB9AD(\uD074\uB9AD)</color>\uD558\uC5EC
      \uB2EB\uC544\uBCF4\uC138\uC694"
  - Phase: 19
    SpeakerSprite: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    GuideText: "\uC774\uAC74 \uC0AC\uB78C\uB4E4\uC758 \uC5ED\uD560\uC744 \uAE30\uB85D\uD560
      \uC218 \uC788\uB294 \uC218\uCCA9\uC774\uAD6C\uB098"
  - Phase: 20
    SpeakerSprite: {fileID: 0}
    GuideText: "\uC624\uB978\uCABD \uD558\uB2E8\uC758 \uBA54\uBAA8 \uC218\uCCA9\uC744
      <color=green>\uB9C8\uC6B0\uC2A4 \uC67C\uD074\uB9AD(\uD074\uB9AD)</color>\uD558\uC5EC
      \uC6A9\uC758\uC790\uC758 \uC758\uC2EC \uAC00\uB294 \uC5ED\uD560 \uC815\uB9AC\uD574
      \uBCF4\uC138\uC694."
  - Phase: 21
    SpeakerSprite: {fileID: 0}
    GuideText: "\uD574\uB2F9\uD558\uB294 \uACA9\uC790 \uCE78\uC5D0 <color=green>\uB9C8\uC6B0\uC2A4
      \uC67C\uD074\uB9AD, \uC6B0\uD074\uB9AD(\uD074\uB9AD)</color>\uD558\uC5EC X
      / <color=red>O</color> / <color=blue>\u25B3</color> \uBA54\uBAA8\uAC00 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\\n
      \uACA9\uC790\uCE78\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694!"
  - Phase: 22
    SpeakerSprite: {fileID: 0}
    GuideText: "\uC798 \uD558\uC168\uC2B5\uB2C8\uB2E4!\\n\uAC19\uC740 \uACF3\uC744
      <color=green>\uB9C8\uC6B0\uC2A4 \uC67C\uD074\uB9AD(\uD074\uB9AD)</color>\uD558\uC5EC
      \uBA54\uBAA8 \uC218\uCCA9\uC744 \uB2EB\uC544 \uBCF4\uC138\uC694!"
  - Phase: 23
    SpeakerSprite: {fileID: 0}
    GuideText: "\uCE90\uB9AD\uD130 \uC778\uBB3C \uCE74\uB4DC\uB97C \uBCF4\uAE30 \uC704\uD574
      \uD574\uB2F9 \uBC84\uD2BC\uC744 \uD074\uB9AD\uD574 \uC8FC\uC138\uC694"
  - Phase: 24
    SpeakerSprite: {fileID: 0}
    GuideText: "\uD30C\uC77C\uC758 \uCC45\uAC08\uD53C\uB97C \uD074\uB9AD\uD558\uC5EC
      \uC778\uBB3C\uC758 \uC815\uBCF4\uB97C \uC5F4\uC5B4\uC8FC\uC138\uC694"
  - Phase: 25
    SpeakerSprite: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    GuideText: "\uC774\uAC74.. \uC778\uBB3C\uC758 \uC0C1\uC138 \uC815\uBCF4\uB97C
      \uC54C \uC218 \uC788\uB294 \uAE30\uB85D\uC9C0\uC774\uAD6C\uB098 \uC778\uBB3C\uC5D0
      \uB300\uD55C \uD78C\uD2B8\uB3C4 \uC788\uAD6C\uB098 \uC774\uB97C \uCC38\uACE0\uD574\uC57C\uACA0\uC5B4!"
  - Phase: 26
    SpeakerSprite: {fileID: 0}
    GuideText: "\uD3EC\uC2A4\uD2B8 \uC787\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
  - Phase: 27
    SpeakerSprite: {fileID: 0}
    GuideText: "\uD3EC\uC2A4\uD2B8 \uB2E4\uC2DC \uC787\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
  - Phase: 28
    SpeakerSprite: {fileID: 0}
    GuideText: "\uCE90\uB9AD\uD130 \uC778\uBB3C \uD30C\uC77C\uC758 \uCC45\uAC08\uD53C\uB97C
      \uB2E4\uC2DC \uB20C\uB7EC\uC8FC\uC138\uC694."
  - Phase: 29
    SpeakerSprite: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    GuideText: "\uC88B\uC544..! \uC0AC\uAC74 \uCD94\uB9AC\uAC00 \uB05D\uB098\uBA74
      \uBC1D\uD600\uC9C0\uACA0\uC9C0"
  - Phase: 30
    SpeakerSprite: {fileID: 0}
    GuideText: "\uC624\uB978\uCABD \uCC45\uC744 <color=green>\uB9C8\uC6B0\uC2A4 \uC67C\uD074\uB9AD(\uD074\uB9AD)</color>\uD558\uC5EC
      \uCD5C\uC885 \uC9D1\uD544\uC744 \uB9C8\uCCD0\uC8FC\uC138\uC694!\\n\uB9CC\uC57D
      \uC880\uB354 \uCD94\uB9AC \uD560 \uACBD\uC6B0 <color=green>\uB354 \uC0DD\uAC01\uD558\uAE30</color>\uB97C
      \uB20C\uB7EC \uC8FC\uC138\uC694."
  EventGuides:
  - EventType: 0
    SpeakerSprite: {fileID: 0}
    GuideText: "\uD558\uB8E8\uAC00 \uC9C0\uB098 \uC6D0\uC810\uC73C\uB85C \uB3CC\uC544\uC654\uC2B5\uB2C8\uB2E4.\\n\uC0C8\uB85C\uC6B4
      \uC2DC\uAC01\uC73C\uB85C \uB2E4\uC2DC \uAD00\uCC30\uD574 \uBCF4\uC138\uC694."
  - EventType: 1
    SpeakerSprite: {fileID: 0}
    GuideText: "\uC0AC\uAC74\uC774 \uB9C8\uBB34\uB9AC\uB418\uC5B4 \uC6D0\uC810\uC73C\uB85C
      \uB3CC\uC544\uC654\uC2B5\uB2C8\uB2E4.\\n\uC774 \uC815\uBCF4\uB97C \uB2E8\uC11C\uB85C
      \uD65C\uC6A9\uD558\uC138\uC694."
  - EventType: 2
    SpeakerSprite: {fileID: 0}
    GuideText: "\uB9C8\uAC10\uC77C\uC774 \uB0B4\uC77C\uB85C \uB2E4\uAC00\uC654\uC2B5\uB2C8\uB2E4.\\n\uC624\uB298
      \uC548\uC5D0 \uBC94\uC778\uC744 \uD2B9\uC815\uD574\uC57C \uD569\uB2C8\uB2E4!"
  - EventType: 3
    SpeakerSprite: {fileID: 0}
    GuideText: "\uCD5C\uC885 \uC9D1\uD544\uC785\uB2C8\uB2E4.\\n\uC5ED\uD560 \uCE74\uB4DC\uB97C
      \uC62C\uBC14\uB978 \uCE78\uC5D0 \uBC30\uCE58\uD558\uC138\uC694."
  - EventType: 4
    SpeakerSprite: {fileID: 0}
    GuideText: "\uCD94\uB9AC\uAC00 \uD2C0\uB838\uC2B5\uB2C8\uB2E4.\\n\uCC98\uC74C\uBD80\uD130
      \uB2E4\uC2DC \uB3C4\uC804\uD574 \uBCF4\uC138\uC694."
