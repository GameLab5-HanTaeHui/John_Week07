    NextPhaseOnAction: 18
    ShowArrow: 1
    ArrowPosition: {x: 350, y: 150}
    ArrowRotationZ: -150
    PreDelay: 0.3
    EnableRoleDocGroup: 0
    EnableMemoBookGroup: 0
  - Phase: 18
    PhaseType: 1
    Dialogues:
    - Speaker: 0
      Text: "\uCE90\uB9AD\uD130 \uC815\uBCF4 \uCE74\uB4DC\uB97C <color=green>\uB9C8\uC6B0\uC2A4
        \uC67C\uD074\uB9AD</color>\uD558\uC5EC \uB2EB\uC544\uC8FC\uC138\uC694."
    NextPhase: 19
    ActionPermission: 17
    NextPhaseOnAction: 19
    ShowArrow: 1
    ArrowPosition: {x: -310, y: 400}
    ArrowRotationZ: -210
    PreDelay: 0.3
    EnableRoleDocGroup: 0
    EnableMemoBookGroup: 0
  - Phase: 19
    PhaseType: 0
    Dialogues:
    - Speaker: 1
      Text: "\uB0B4 \uCD5C\uC885 \uBAA9\uD45C\uB294 \uC218\uC9D1\uD55C \uC815\uBCF4\uB97C
        \uC774\uC6A9\uD574 \uC774\uAC04\uC9C8\uB85C \uC6A9\uBCD1\uB2E8\uC744 \uBB34\uB108\uB728\uB9AC\uB294
        \uAC70\uC57C. \uC6B0\uC120 \uC5F0\uC2B5\uD574 \uBCFC\uAE4C."
    NextPhase: 20
    ActionPermission: 1
    NextPhaseOnAction: 20
    ShowArrow: 1
    ArrowPosition: {x: -310, y: 400}
    ArrowRotationZ: -210
    PreDelay: 0.3
    EnableRoleDocGroup: 0
    EnableMemoBookGroup: 0
  - Phase: 20
    PhaseType: 1
    Dialogues:
    - Speaker: 0
      Text: "\uC624\uB978\uCABD \uCD5C\uC885 \uCD94\uB9AC \uCC45\uC744 <color=green>\uB9C8\uC6B0\uC2A4
        \uD074\uB9AD</color>\uD558\uC5EC <color=green>\uCD5C\uC885 \uCD94\uB9AC</color>\uB97C
        \uC120\uD0DD \uD574\uC8FC\uC138\uC694."
    NextPhase: 21
    ActionPermission: 129
    NextPhaseOnAction: 21
    ShowArrow: 1
    ArrowPosition: {x: 550, y: 100}
    ArrowRotationZ: -15
    PreDelay: 0.3
    EnableRoleDocGroup: 0
    EnableMemoBookGroup: 0
  - Phase: 21
    PhaseType: 1
    Dialogues:
    - Speaker: 0
      Text: "\uC5D4\uBE44\uB97C \uC120\uD0DD \uD574\uC8FC\uC138\uC694."
    NextPhase: 22
    ActionPermission: 257
    NextPhaseOnAction: 22
    ShowArrow: 1
    ArrowPosition: {x: -300, y: 150}
    ArrowRotationZ: 0
    PreDelay: 0.3
    EnableRoleDocGroup: 0
    EnableMemoBookGroup: 0
  - Phase: 22
    PhaseType: 0
    Dialogues:
    - Speaker: 0
      Text: "\uCD5C\uC885 \uCD94\uB9AC\uC5D0\uC11C\uB294 \uC218\uC9D1\uD55C \uB300\uD654\uC870\uAC01\uC744
        \uBC14\uD0D5\uC73C\uB85C \uAC01\uAC01\uC758 \uC778\uBB3C\uB4E4\uC5D0\uAC8C
        \uCD5C\uC885 \uCD94\uB9AC\uB97C \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    - Speaker: 0
      Text: "\uAC19\uC740 \uC9C4\uC2E4\uC774\uB77C\uB3C4 \uC5B4\uB5A4\uBD80\uBD84\uC744,
        \uC5B4\uB514\uAE4C\uC9C0, \uB204\uAD6C\uC5D0\uAC8C \uC804\uB2EC\uD560\uC9C0\uC5D0
        \uB530\uB77C \uACB0\uACFC\uAC00 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4. \n\uCD5C\uC885
        \uB300\uD654\uB294 \uB3CC\uC774\uD0AC \uC218 \uC5C6\uC73C\uB2C8, \uC2E0\uC911\uD558\uAC8C
        \uC0DD\uAC01\uD574\uC8FC\uC138\uC694!"
    - Speaker: 1
      Text: "\uC6A9\uBCD1\uB2E8 \uC0AC\uB78C\uB4E4\uC774 \uB098\uC5D0\uAC8C \uB9D0\uC744
        \uAC70\uB294 \uC0C1\uC0C1\uC744 \uD574 \uBCFC\uAE4C?"
    - Speaker: 1
      Text: "\uB0B4\uAC00 \uC5B4\uB5A4 \uC131\uACA9\uC774\uC600\uACE0, \uC5B4\uB5A4
        \uC0AC\uAC74 \uB54C\uBB38\uC5D0 \uC774\uACF3\uC5D0 \uC654\uC5C8\uC9C0?\n\uC5B4\uB5A4\uB9D0\uC774
        \uB0A0 \uAC00\uC7A5 \uB4A4\uD754\uB4E4 \uC218 \uC788\uB294 \uB9D0\uC77C\uAE4C?"
    NextPhase: 23
    ActionPermission: 257
    NextPhaseOnAction: 23
    ShowArrow: 0
    ArrowPosition: {x: 0, y: 0}
    ArrowRotationZ: 0
    PreDelay: 0.3
    EnableRoleDocGroup: 0
    EnableMemoBookGroup: 0
  - Phase: 23
    PhaseType: 1
    Dialogues:
    - Speaker: 0
      Text: "\uC9C8\uBB38\uC9C0\uB97C \uC798 \uBCF4\uACE0 \uC815\uB2F5\uC744 \uC120\uD0DD
        \uD574\uC8FC\uC138\uC694."
    NextPhase: 24
    ActionPermission: 513
    NextPhaseOnAction: 24
    ShowArrow: 1
    ArrowPosition: {x: 750, y: 200}
    ArrowRotationZ: -180
    PreDelay: 0.3
    EnableRoleDocGroup: 0
    EnableMemoBookGroup: 0
  - Phase: 24
    PhaseType: 0
    Dialogues:
    - Speaker: 0
      Text: "\uC5D4\uBE44\uC758 \uBAA9\uD45C\uB294 \uC6A9\uBCD1\uB2E8\uC758 \uD574\uCCB4\uC785\uB2C8\uB2E4."
    - Speaker: 1
      Text: "... \n\uB0B4\uAC00 \uC2A4\uD30C\uC774\uB77C\uB294 \uAC78 \uB4E4\uD0A8\uB2E4\uBA74
        \uC758\uB8B0\uB294 \uC989\uC2DC \uC2E4\uD328\uC57C... \uB208\uC5D0 \uB744\uC9C0
        \uC54A\uAC8C \uC870\uC2EC\uD574\uC57C \uD574."
    NextPhase: 25
    ActionPermission: 513
    NextPhaseOnAction: 25
    ShowArrow: 0
    ArrowPosition: {x: 0, y: 0}
    ArrowRotationZ: 0
    PreDelay: 0.3
    EnableRoleDocGroup: 0
    EnableMemoBookGroup: 0
  - Phase: 25
    PhaseType: 0
    Dialogues:
    - Speaker: 1
      Text: "\uC88B\uC544.\n\uC774\uC81C \uAE30\uBCF8\uC801\uC778 \uAC74 \uC54C\uACA0\uC5B4."
    - Speaker: 1
      Text: "\uC0AC\uAC74\uC744 \uBAA8\uC73C\uACE0, \uC0AC\uB78C\uC744 \uC774\uD574\uD558\uACE0,
        \uB9D0\uC744 \uC5B4\uB5BB\uAC8C \uC804\uB2EC\uD560\uC9C0 \uACE0\uB978\uB2E4."
    - Speaker: 1
      Text: "\uC774 \uC6A9\uBCD1\uB2E8\uC740 \uC544\uC9C1 \uC11C\uB85C\uB97C \uB3D9\uB8CC\uB77C\uACE0
        \uBBFF\uACE0 \uC788\uC5B4. \n\uD568\uAED8 \uD574\uC628 \uC2DC\uAC04\uC774
        \uC788\uC73C\uB2C8\uAE4C. \uD558\uC9C0\uB9CC \uBBFF\uC74C\uC740 \uC0DD\uAC01\uBCF4\uB2E4
        \uC791\uC740 \uADE0\uC5F4\uB85C\uB3C4 \uBD80\uC11C\uC9C0\uAE30 \uB9C8\uB828\uC774\uC57C."
    - Speaker: 1
      Text: "\uD544\uC694\uD55C\uAC74 \uC644\uC804\uD55C \uAC70\uC9D3\uB9D0\uC774
        \uC544\uB2C8\uC57C. \n\uC9C4\uC2E4\uC744 \uD55C \uC2A4\uD47C\uB9CC \uB2F4\uC544\uC11C,
        \uAC00\uC7A5 \uAD34\uB85C\uC6CC \uD560 \uC0AC\uB78C\uC5D0\uAC8C \uB4E4\uB824\uC8FC\uACE0
        \uBD95\uAD34\uB97C \uC9C0\uCF1C \uBCF4\uB294\uAC70\uC57C."
    - Speaker: 1
      Text: "\uADF8\uB7FC \uC774\uC81C \uBCF8\uACA9\uC801\uC73C\uB85C \uC2DC\uC791\uD574\uBCF4\uC790.\n\uC774
        \uC6A9\uBCD1\uB2E8\uC774 \uC5B4\uB514\uC11C\uBD80\uD130 \uAC08\uB77C\uC84C\uB294\uC9C0."
    NextPhase: 26
    ActionPermission: 1
    NextPhaseOnAction: 26
    ShowArrow: 0
    ArrowPosition: {x: 0, y: 0}
    ArrowRotationZ: 0
    PreDelay: 0.3
    EnableRoleDocGroup: 0
    EnableMemoBookGroup: 0
