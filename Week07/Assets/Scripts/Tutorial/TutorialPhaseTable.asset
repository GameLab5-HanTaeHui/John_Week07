  m_Name: TutorialPhaseTable
  m_EditorClassIdentifier: Assembly-CSharp::TutorialPhaseTableSO
  SpeakerSprites:
  - {fileID: 21300000, guid: da951ff8cc869324ca09cf422bfaee91, type: 3}
