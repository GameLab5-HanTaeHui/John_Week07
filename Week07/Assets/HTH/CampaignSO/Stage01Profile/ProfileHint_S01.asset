%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2750608b252f9dd409bf0a650bf70a3f, type: 3}
  m_Name: ProfileHint_S01
  m_EditorClassIdentifier: Assembly-CSharp::HTH.Campaign.FragmentHintDataSO
  _stageId: CampaignMode
  _characterHints:
  - CharacterId: 1
    Hints:
    - "\uC5D4\uBE44\uB294 \uAC00\uB054, \uD63C\uC790\uC11C \uC6A9\uBCD1\uB2E8\uC758
      \uD3C9\uD654\uB85C\uC6B4 \uC77C\uC0C1\uC744 \uBC14\uB77C\uBCF8\uB2E4."
    - "\uD1A0\uB2C8\uB294 \uC5D4\uBE44\uC640 \uB458\uB9CC \uB0A8\uC558\uC744 \uB54C,
      \uB2E4\uC815\uD568 \uC18D \uBD80\uC790\uC5F0\uC2A4\uB7EC\uC6C0\uC744 \uB208\uCE58\uCC4C
      \uC218 \uC788\uC744\uC9C0 \uBAA8\uB978\uB2E4."
    - "\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4 \uC0AC\uC774\uC5D0 \uC5D4\uBE44\uB97C
      \uC138\uC6B0\uBA74, \uC5D4\uBE44\uAC00 \uAC00\uC7A5 \uD754\uB4E4\uB9B4 \uAC83
      \uAC19\uB2E4."
    - "\uBA54\uC774\uC640 \uC0C8\uD134\uC774 \uBD80\uB52A\uD788\uB294 \uC790\uB9AC\uC5D0
      \uC5D4\uBE44\uAC00 \uC788\uC73C\uBA74, \uC5D4\uBE44\uB294 \uD2C8\uC744 \uADF8\uB0E5
      \uC9C0\uB098\uCE58\uC9C0 \uC54A\uC744 \uAC83 \uAC19\uB2E4."
    - "\uC6A9\uBCD1\uB2E8 \uB0B4\uC5D0\uC11C\uB3C4 \uC720\uB3C5 \uAE4A\uC740 \uAD00\uACC4\uC758
      \uB450 \uC0AC\uB78C\uACFC \uADF8\uAC83\uC744 \uBB34\uB108\uB728\uB9AC\uB824
      \uD558\uB294 \uC0AC\uB78C, \uADF8\uB9AC\uACE0 \uC5D4\uBE44\uAC00 \uD55C\uACF3\uC5D0
      \uBAA8\uC774\uBA74 \uC5D4\uBE44\uC758 \uB9C8\uC74C\uC774 \uB4DC\uB7EC\uB0A0
      \uAC83 \uAC19\uB2E4."
  - CharacterId: 2
    Hints:
    - "\uBA54\uC774\uB97C \uD63C\uC790 \uB454\uB2E4\uBA74, \uB204\uAD70\uAC00\uC758
      \uC8FD\uC74C\uC5D0\uB3C4 \uC808\uB300 \uB3D9\uC694\uD558\uC9C0 \uC54A\uB294
      \uBAA8\uC2B5\uC744 \uBCFC \uC218 \uC788\uB2E4."
    - "\uBA54\uC774\uAC00 \uC545\uC744 \uCC98\uB2E8\uD558\uB294 \uC7A5\uBA74\uC744
      \uBCF4\uBA74 \uBA54\uC774\uAC00 \uB9C8\uC655 \uD1A0\uBC8C\uC5D0 \uB300\uD574
      \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uACE0 \uC788\uB294\uC9C0 \uC54C \uC218
      \uC788\uC744 \uAC83 \uAC19\uB2E4."
    - "\uBA48\uCD94\uACE0 \uC2F6\uC740 \uC0AC\uB78C\uACFC \uAD00\uACC4\uC758 \uD2C8\uC744
      \uC77D\uB294 \uC5D4\uBE44\uAC00 \uD568\uAED8 \uC788\uC744 \uB54C, \uBA54\uC774\uAC00
      \uC65C \uB3D9\uB8CC\uB97C \uB05D\uAE4C\uC9C0 \uBD99\uC7A1\uC73C\uB824 \uD558\uB294\uC9C0
      \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4."
    - "\uBA54\uC774\uC640 \uB8E8\uC774\uC2A4\uB97C \uB458\uB9CC \uB450\uBA74, \uC804\uC9C4\uACFC
      \uC815\uC9C0\uAC00 \uAC00\uC7A5 \uC9C1\uC811\uC801\uC73C\uB85C \uBD80\uB52A\uD790
      \uAC83 \uAC19\uB2E4."
    - "\uD504\uB9AC\uB4DC\uC640 \uC0C8\uD134\uC774 \uB3D9\uC2DC\uC5D0 \uC788\uC73C\uBA74,
      \uBA54\uC774\uC758 \uC804\uC9C4\uC774 \uCC45\uC784\uC778\uC9C0 \uAC15\uC694\uC778\uC9C0
      \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4. (\uB3D9\uB8CC\uB97C \uB300\uD558\uB294
      \uBA54\uC774\uC758 \uBC29\uC2DD\uC744 \uC54C \uC218 \uC788\uB294 2\uBC88 \uB300\uD654
      \uC870\uAC01\uC774 \uD544\uC694\uD558\uB2E4.)"
  - CharacterId: 3
    Hints:
    - "\uB370\uC6B0\uC2A4\uAC00 \uD63C\uC790 \uAE30\uB3C4\uB97C \uD560 \uB54C, \uB8E8\uC774\uC2A4\uC5D0
      \uB300\uD574 \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uB294\uC9C0 \uC54C \uC218
      \uC788\uC744 \uAC83 \uAC19\uB2E4."
    - "\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4\uB9CC \uB0A8\uAE30\uBA74, \uB458
      \uC0AC\uC774\uAC00 \uC5BC\uB9C8\uB098 \uB2EB\uD78C \uC138\uACC4\uC778\uC9C0
      \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    - "\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4 \uC0AC\uC774\uC5D0 \uC5D4\uBE44\uB97C
      \uC138\uC6B0\uBA74, \uC5D4\uBE44\uC758 \uC2DC\uC120\uC774 \uAC00\uC7A5 \uD754\uB4E4\uB9B4
      \uAC83 \uAC19\uB2E4."
    - "\uC0C8\uD134\uC740 \uB370\uC6B0\uC2A4\uC5D0\uAC8C \uB0A0\uCE74\uB85C\uC6B4
      \uC9C8\uBB38\uC744 \uD560 \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4. (\uC0C8\uD134\uC774
      \uB204\uAC00 \uBC84\uB824\uC9C0\uB294\uC9C0\uB97C \uBA3C\uC800 \uBCF8\uB2E4\uB294
      \uB300\uD654 \uC870\uAC01\uC774 \uD544\uC694\uD558\uB2E4)"
    - "\uB9C8\uC655 \uD1A0\uBC8C \uC774\uD6C4\uB97C \uBB3B\uB294 \uC0C8\uD134 \uC55E\uC5D0\uC11C,
      \uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB97C \uC815\uB9D0 \uB193\uC544\uC904
      \uC218 \uC788\uB294\uC9C0 \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4. (\uB370\uC6B0\uC2A4\uC640
      \uB8E8\uC774\uC2A4\uC758 \uB2EB\uD78C \uAD00\uACC4, \uB370\uC6B0\uC2A4\uC758
      \uBCF4\uD638 \uBC29\uC2DD\uC744 \uC54C\uC544\uC57C \uD55C\uB2E4)"
  - CharacterId: 4
    Hints:
    - "\uB8E8\uC774\uC2A4\uB294 \uD63C\uC790 \uC788\uC744 \uB54C \uAC00\uC7A5 \uC870\uC6A9\uD558\uC9C0\uB9CC,
      \uADF8 \uCE68\uBB35\uC774 \uBE44\uC5B4 \uC788\uB294 \uAC74 \uC544\uB2D0 \uAC83
      \uAC19\uB2E4."
    - "\uBA54\uC774\uC640 \uC0C8\uD134\uC774 \uBD80\uB52A\uD788\uB294 \uC790\uB9AC\uC5D0
      \uB8E8\uC774\uC2A4\uAC00 \uC788\uC73C\uBA74, \uB8E8\uC774\uC2A4\uAC00 \uCE68\uBB35\uD558\uB294
      \uC774\uC720\uAC00 \uBCF4\uC77C \uAC83 \uAC19\uB2E4. (\uC0C8\uD134\uC774 \uB370\uC6B0\uC2A4\uC5D0\uAC8C
      \uD138\uC5B4\uB193\uC740 \uB300\uD654\uC870\uAC01 \uB610\uB294 \uBA54\uC774\uC640
      \uB8E8\uC774\uC2A4\uC758 \uB2E4\uD23C\uC73C\uB85C \uC778\uD55C \uB300\uD654\uC870\uAC01\uC774
      \uD544\uC694\uD558\uB2E4)"
    - "\uBA54\uC774\uC640 \uB8E8\uC774\uC2A4\uB97C \uB458\uB9CC \uB450\uBA74, \uC804\uC9C4\uACFC
      \uC815\uC9C0\uAC00 \uAC00\uC7A5 \uC9C1\uC811\uC801\uC73C\uB85C \uBD80\uB52A\uD790
      \uAC83 \uAC19\uB2E4."
    - "\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4\uB97C \uB458\uB9CC \uB0A8\uAE30\uBA74,
      \uB8E8\uC774\uC2A4\uAC00 \uBB34\uC5C7\uC5D0 \uAE30\uB300\uACE0 \uC788\uB294\uC9C0
      \uAC00\uC7A5 \uC798 \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    - "\uB8E8\uC774\uC2A4\uAC00 \uD63C\uC790\uC788\uC744 \uB54C \uB370\uC6B0\uC2A4\uB97C
      \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uB294\uC9C0 \uC54C \uC218 \uC788\uC744\uAC83
      \uAC19\uB2E4."
  - CharacterId: 5
    Hints:
    - "\uD1A0\uB2C8\uAC00 \uD63C\uC790 \uC788\uB294 \uC0C1\uD0DC\uC5D0\uC11C \uC0AC\uB9DD
      \uC0AC\uAC74\uC744 \uBAA9\uACA9\uD55C\uB2E4\uBA74, \uADF8\uB140\uAC00 \uC5B4\uB514\uC11C\uBD80\uD130
      \uADF8\uB7F0 \uD5C8\uAE30\uB97C \uBC30\uC6E0\uB294\uC9C0 \uD758\uB9B4\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    - "\uD1A0\uB2C8\uB294 \uD63C\uC790\uC788\uC744\uB54C \uAC00\uC7A5 \uD574\uB9D1\uC740
      \uC5BC\uAD74\uC744 \uBCF4\uC77C \uC218 \uC788\uB2E4."
    - "\uD1A0\uB2C8\uAC00 \uACC4\uC18D \uD63C\uC790 \uC788\uC73C\uBA74 \uB2E4\uB978
      \uBAA8\uC2B5\uC744 \uBCFC \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    - "\uAD70\uC911 \uC18D \uD1A0\uB2C8\uC758 \uC0B4\uC778\uC740, \uADF8\uB140\uAC00
      \uC8FD\uC74C\uC744 \uBC14\uB77C\uBCF4\uB294 \uC2DC\uC120\uC744 \uC798 \uBCF4\uC5EC\uC900\uB2E4."
    - "\uC5D4\uBE44\uC640 \uD504\uB9AC\uB4DC \uC55E\uC5D0 \uD1A0\uB2C8\uB97C \uC138\uC6B0\uBA74
      \uD1A0\uB2C8\uC758 \uC695\uB9DD\uC774 \uB354 \uC120\uBA85\uD574\uC9C8 \uAC83
      \uAC19\uB2E4."
  - CharacterId: 6
    Hints:
    - "\uD504\uB9AC\uB4DC\uB97C \uD63C\uC790 \uB450\uBA74 \uD504\uB9AC\uB4DC\uC758
      \uC0DD\uAC01\uC5D0 \uB300\uD574 \uC54C \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    - "\uBA54\uC774\uC758 \uC606\uC5D0 \uD504\uB9AC\uB4DC\uB97C \uB450\uBA74, \uD504\uB9AC\uB4DC\uAC00
      \uC5B4\uB5A4 \uC2DD\uC73C\uB85C \uC55E\uC5D0 \uC11C\uB294\uC9C0 \uBCF4\uC77C
      \uB4EF\uD558\uB2E4."
    - "\uC5D4\uBE44\uB294 \uD504\uB9AC\uB4DC\uC758 \uC120\uC758\uAC00 \uC5B8\uC81C
      \uACB0\uC815\uAD8C\uC73C\uB85C \uBC14\uB00C\uB294\uC9C0 \uAC74\uB4DC\uB9B4
      \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    - "\uC0C8\uD134\uC740 \uD504\uB9AC\uB4DC\uC758 \uD76C\uC0DD\uC774 \uC815\uB9D0
      \uD0C0\uC778\uC744 \uC704\uD55C \uC120\uD0DD\uC778\uC9C0 \uBB3C\uC744 \uC218
      \uC788\uC744 \uAC83 \uAC19\uB2E4. (\uC0C8\uD134\uC774 \uB370\uC6B0\uC2A4\uC5D0\uAC8C
      \uD138\uC5B4\uB193\uC740 \uB300\uD654 \uC870\uAC01\uC774 \uD544\uC694\uD558\uB2E4.)"
    - "\uD504\uB9AC\uB4DC\uAC00 \uB354\uC6B1\uB354 \uC678\uB85C\uC6CC\uC9C0\uBA74
      \uD504\uB9AC\uB4DC\uC758 \uC0DD\uAC01\uC744 \uC54C \uC218 \uC788\uC744 \uAC83
      \uAC19\uB2E4."
  - CharacterId: 7
    Hints:
    - "\uC0C8\uD134\uC740 \uB298 \uD63C\uC790\uB2E4. \uB4A4\uC5D0 \uB204\uAD70\uAC00\uB97C
      \uB0A8\uACA8\uB450\uACE0\uC11C..."
    - "\uC0C8\uD134\uB3C4 \uB370\uC6B0\uC2A4\uC5D0\uAC8C\uB294 \uBB34\uAC70\uC6B4
      \uC77C\uC744 \uD138\uC5B4\uB193\uC744 \uC218 \uC788\uC744\uC9C0 \uBAA8\uB978\uB2E4.
      \uC0C8\uD134\uC774 \uC9C0\uB098\uC628 \uC790\uB9AC\uC5D0\uB294 \uC5B4\uB5A4
      \uC77C\uC774 \uC77C\uC5B4\uB0AC\uC744\uAE4C?"
    - "\uBA54\uC774\uAC00 \uB3D9\uB8CC\uB97C \uB300\uD558\uB294 \uBC29\uC2DD\uC744
      \uC54C\uACE0 \uB09C \uD6C4, \uD504\uB9AC\uB4DC\uC640 \uC0C8\uD134\uC774 \uB3D9\uC2DC\uC5D0
      \uC788\uC73C\uBA74 \uC0C8\uD134\uC774 \uB9C8\uC655 \uD1A0\uBC8C\uC5D0 \uB300\uD574
      \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uB294\uC9C0 \uC54C \uC218 \uC788\uC744
      \uAC83 \uAC19\uB2E4."
    - "\uC5D4\uBE44\uAC00 \uC0C8\uD134\uC744 \uAF2C\uB4DC\uAE38 \uB54C, \uC0C8\uD134\uC774
      \uACF5\uB3D9\uCCB4\uC5D0 \uB300\uD574 \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uB294\uC9C0
      \uC54C \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    - "\uB204\uAD70\uAC00\uC758 \uC8FD\uC74C \uC774\uD6C4 \uBA54\uC774\uC640 \uD504\uB9AC\uB4DC,
      \uC0C8\uD134\uC774 \uD568\uAED8 \uC788\uC73C\uBA74 \uC0C8\uD134\uC774 \uC5B4\uB5A4
      \uAC83\uC5D0 \uBD84\uB178\uD558\uB294\uC9C0 \uC54C \uC218 \uC788\uC744 \uAC83
      \uAC19\uB2E4."
