%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2750608b252f9dd409bf0a650bf70a3f, type: 3}
  m_Name: ProfileHint_S01
  m_EditorClassIdentifier: Assembly-CSharp::HTH.Campaign.FragmentHintDataSO
  _stageId: Stage_1_Phase2
  _characterHints:
  - CharacterId: 1
    Hints:
    - "\uC5D4\uBE44\uAC00 \uD63C\uC790 \uB0A8\uC73C\uBA74, \uBC29\uAE08 \uBCF8 \uB530\uB73B\uD55C
      \uAD00\uACC4\uB97C \uC624\uB798 \uACF1\uC539\uC744 \uAC83 \uAC19\uB2E4."
    - "\uD1A0\uB2C8\uB294 \uC5D4\uBE44\uC758 \uB2E4\uC815\uD568\uC774 \uB108\uBB34
      \uC798 \uB2E4\uB4EC\uC5B4\uC9C4 \uB9D0\uC774\uB77C\uACE0 \uB290\uB084\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    - "\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4 \uC0AC\uC774\uC5D0 \uC5D4\uBE44\uB97C
      \uC138\uC6B0\uBA74, \uC5D4\uBE44\uC758 \uC2DC\uC120\uC774 \uAC00\uC7A5 \uD754\uB4E4\uB9B4
      \uAC83 \uAC19\uB2E4."
    - "\uBA54\uC774\uC640 \uC0C8\uD134\uC774 \uBD80\uB52A\uD788\uB294 \uC790\uB9AC\uC5D0
      \uC5D4\uBE44\uAC00 \uC788\uC73C\uBA74, \uC5D4\uBE44\uB294 \uD2C8\uC744 \uADF8\uB0E5
      \uC9C0\uB098\uCE58\uC9C0 \uC54A\uC744 \uAC83 \uAC19\uB2E4."
    - "\uC5D4\uBE44\uAC00 \uAD00\uACC4\uC758 \uC911\uC2EC\uBD80\uC5D0 \uC624\uB798
      \uBA38\uBB3C\uBA74, \uC790\uC2E0\uC774 \uC6D0\uD558\uB294 \uAC83\uACFC \uD558\uB294
      \uC77C\uC774 \uC5C7\uAC08\uB9AC\uB294 \uC21C\uAC04\uC774 \uC62C \uAC83 \uAC19\uB2E4."
  - CharacterId: 2
    Hints:
    - "\uBA54\uC774\uAC00 \uD63C\uC790 \uB0A8\uC73C\uBA74, \uC804\uD22C\uBCF4\uB2E4
      \uB354 \uC624\uB798 \uBD99\uC7A1\uACE0 \uC788\uB294 \uC774\uC720\uB97C \uB9D0\uD560\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    - "\uD1A0\uB2C8\uB294 \uBA54\uC774\uAC00 \uB05D\uC774\uB77C\uB294 \uB9D0\uC5D0
      \uC5BC\uB9C8\uB098 \uC27D\uAC8C \uB2EC\uC544\uC624\uB974\uB294\uC9C0 \uBCFC
      \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    - "\uBA48\uCD94\uACE0 \uC2F6\uC740 \uB8E8\uC774\uC2A4 \uC55E\uC5D0\uC11C \uBA54\uC774\uB294
      \uB3D9\uB8CC\uB97C \uC5B4\uB5BB\uAC8C \uBD99\uC7A1\uB294\uC9C0 \uB4DC\uB7EC\uB0A0
      \uAC83 \uAC19\uB2E4."
    - "\uBA54\uC774\uC640 \uB8E8\uC774\uC2A4\uB97C \uB458\uB9CC \uB450\uBA74, \uC804\uC9C4\uACFC
      \uC815\uC9C0\uAC00 \uAC00\uC7A5 \uC9C1\uC811\uC801\uC73C\uB85C \uBD80\uB52A\uD790
      \uAC83 \uAC19\uB2E4."
    - "\uD504\uB9AC\uB4DC\uC640 \uC0C8\uD134\uC774 \uB3D9\uC2DC\uC5D0 \uC788\uC73C\uBA74,
      \uBA54\uC774\uC758 \uC804\uC9C4\uC774 \uCC45\uC784\uC778\uC9C0 \uAC15\uC694\uC778\uC9C0
      \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4."
  - CharacterId: 3
    Hints:
    - "\uB8E8\uC774\uC2A4\uC640 \uB5A8\uC5B4\uC9C4 \uB370\uC6B0\uC2A4\uB294 \uC790\uC2E0\uC758
      \uB9C8\uC74C\uC5D0 \uBD99\uC778 \uC774\uB984\uC744 \uACE0\uBC31\uD560\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    - "\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4\uB9CC \uB0A8\uAE30\uBA74, \uB458
      \uC0AC\uC774\uAC00 \uC5BC\uB9C8\uB098 \uB2EB\uD78C \uC138\uACC4\uC778\uC9C0
      \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    - "\uC5D4\uBE44\uAC00 \uB8E8\uC774\uC2A4\uC5D0\uAC8C \uD3B8\uD558\uAC8C \uB2E4\uAC00\uAC00\uBA74,
      \uB370\uC6B0\uC2A4\uC758 \uACBD\uACC4\uAC00 \uAC00\uC7A5 \uC120\uBA85\uD574\uC9C8
      \uAC83 \uAC19\uB2E4."
    - "\uC0C8\uD134\uC740 \uB370\uC6B0\uC2A4\uC5D0\uAC8C \uBCF4\uD638\uC640 \uAC10\uAE08\uC758
      \uACBD\uACC4\uB97C \uC9C1\uC811 \uBB3C\uC744 \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    - "\uB9C8\uC655 \uD1A0\uBC8C \uC774\uD6C4\uB97C \uB9D0\uD558\uAC8C \uD558\uBA74,
      \uB370\uC6B0\uC2A4\uAC00 \uC815\uB9D0 \uB8E8\uC774\uC2A4\uB97C \uB193\uC544\uC904
      \uC218 \uC788\uB294\uC9C0 \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
  - CharacterId: 4
    Hints:
    - "\uB8E8\uC774\uC2A4\uB294 \uD63C\uC790 \uC788\uC744 \uB54C \uAC00\uC7A5 \uC870\uC6A9\uD558\uC9C0\uB9CC,
      \uADF8 \uCE68\uBB35\uC774 \uBE44\uC5B4 \uC788\uB294 \uAC74 \uC544\uB2D0 \uAC83
      \uAC19\uB2E4."
    - "\uBA54\uC774\uC640 \uC0C8\uD134\uC774 \uBD80\uB52A\uD788\uB294 \uC790\uB9AC\uC5D0
      \uB8E8\uC774\uC2A4\uAC00 \uC788\uC73C\uBA74, \uB8E8\uC774\uC2A4\uAC00 \uCE68\uBB35\uD558\uB294
      \uC774\uC720\uAC00 \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    - "\uBA54\uC774\uC758 \uC804\uC9C4 \uC55E\uC5D0 \uB8E8\uC774\uC2A4\uB97C \uC138\uC6B0\uBA74,
      \uB8E8\uC774\uC2A4\uAC00 \uC6D0\uD558\uB294 \uAC83\uC774 \uBB34\uC5C7\uC778\uC9C0
      \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4."
    - "\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4\uB97C \uB458\uB9CC \uB0A8\uAE30\uBA74,
      \uB8E8\uC774\uC2A4\uAC00 \uBB34\uC5C7\uC5D0 \uAE30\uB300\uB294\uC9C0 \uAC00\uC7A5
      \uC798 \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    - "\uB370\uC6B0\uC2A4\uAC00 \uC0AC\uB77C\uC9C4 \uC9C1\uD6C4 \uB8E8\uC774\uC2A4\uB97C
      \uC870\uC0AC\uD558\uBA74, \uB8E8\uC774\uC2A4\uC758 \uBC84\uD300\uBAA9\uC774
      \uBB34\uC5C7\uC774\uC5C8\uB294\uC9C0 \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4."
  - CharacterId: 5
    Hints:
    - "\uD1A0\uB2C8\uB97C \uD63C\uC790 \uB450\uBA74, \uD1A0\uB2C8\uAC00 \uC5B4\uB514\uC11C\uBD80\uD130
      \uADF8\uB7F0 \uD5C8\uAE30\uB97C \uBC30\uC6E0\uB294\uC9C0 \uD758\uB9B4\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    - "\uD504\uB9AC\uB4DC\uCC98\uB7FC \uBCF4\uD638\uD558\uB824\uB294 \uC778\uBB3C
      \uC55E\uC5D0\uC11C \uD1A0\uB2C8\uB294 \uAC00\uC7A5 \uD574\uB9D1\uC740 \uC5BC\uAD74\uC744
      \uBCF4\uC77C \uC218 \uC788\uB2E4."
    - "\uC5D4\uBE44\uC640 \uD1A0\uB2C8\uB294 \uC11C\uB85C \uB2E4\uB978 \uBC29\uC2DD\uC73C\uB85C
      \uC0AC\uB78C \uC0AC\uC774\uC758 \uBCC0\uD654\uB97C \uBCF8\uB2E4."
    - "\uC0AC\uB9DD \uC9C1\uD6C4 \uD1A0\uB2C8\uB97C \uC870\uC0AC\uD558\uBA74, \uD1A0\uB2C8\uAC00
      \uC8FD\uC74C \uC774\uD6C4\uC758 \uBCC0\uD654\uB97C \uC5B4\uB5BB\uAC8C \uBCF4\uB294\uC9C0
      \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4."
    - "\uD1A0\uB2C8\uC758 \uC870\uAC01\uC744 \uCDA9\uBD84\uD788 \uBAA8\uC740 \uB4A4
      \uD63C\uC790 \uB450\uBA74, \uD1A0\uB2C8\uAC00 \uBB34\uC5C7\uC744 \uC7AC\uB8CC\uB85C
      \uC6D0\uD558\uB294\uC9C0 \uB9D0\uD560 \uAC83 \uAC19\uB2E4."
  - CharacterId: 6
    Hints:
    - "\uD504\uB9AC\uB4DC\uB294 \uD63C\uC790 \uC788\uC744 \uB54C\uB3C4 \uB204\uAD70\uAC00\uC758
      \uBAAB\uC744 \uC0DD\uAC01\uD558\uACE0 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    - "\uBA54\uC774\uC758 \uC804\uC9C4 \uC606\uC5D0 \uD504\uB9AC\uB4DC\uB97C \uB450\uBA74,
      \uD504\uB9AC\uB4DC\uAC00 \uC5B4\uB5A4 \uC2DD\uC73C\uB85C \uC55E\uC5D0 \uC11C\uB294\uC9C0
      \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    - "\uC5D4\uBE44\uB294 \uD504\uB9AC\uB4DC\uC758 \uC120\uC758\uAC00 \uC5B8\uC81C
      \uACB0\uC815\uAD8C\uC73C\uB85C \uBC14\uB00C\uB294\uC9C0 \uAC74\uB4DC\uB9B4
      \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    - "\uC0C8\uD134\uC740 \uD504\uB9AC\uB4DC\uC758 \uD76C\uC0DD\uC774 \uC815\uB9D0
      \uBAA8\uB450\uC758 \uC120\uD0DD\uC778\uC9C0 \uBB3C\uC744 \uC218 \uC788\uC744
      \uAC83 \uAC19\uB2E4."
    - "\uD504\uB9AC\uB4DC\uAC00 \uC2E4\uC81C\uB85C \uB204\uAD70\uAC00\uC758 \uC8FD\uC74C\uC744
      \uB300\uC2E0\uD55C \uB4A4\uC5D0\uB294, \uADF8 \uC2E0\uB150\uC758 \uC704\uD5D8\uC131\uC774
      \uAC00\uC7A5 \uC120\uBA85\uD574\uC9C8 \uAC83 \uAC19\uB2E4."
  - CharacterId: 7
    Hints:
    - "\uB370\uC6B0\uC2A4\uC5D0\uAC8C\uB77C\uBA74 \uC0C8\uD134\uC774 \uBB34\uAC70\uC6B4
      \uC77C\uC744 \uD138\uC5B4\uB193\uC744 \uC218 \uC788\uC744\uC9C0 \uBAA8\uB978\uB2E4.
      \uC0C8\uD134\uC774 \uC9C0\uB098\uC628 \uC790\uB9AC\uC5D0 \uBB34\uC5C7\uC774
      \uB0A8\uB294\uC9C0 \uBCF4\uC790."
    - "\uBA54\uC774\uC640 \uC0C8\uD134\uC744 \uB458\uB9CC \uB450\uBA74, \uB05D\uACFC
      \uACFC\uC815\uC758 \uCC28\uC774\uAC00 \uAC00\uC7A5 \uC9C1\uC811\uC801\uC73C\uB85C
      \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    - "\uBA54\uC774\uC640 \uD504\uB9AC\uB4DC \uC0AC\uC774\uC5D0 \uC0C8\uD134\uC774
      \uC788\uC73C\uBA74, \uC2B9\uB9AC\uC640 \uD76C\uC0DD\uC758 \uAE30\uC900\uC774
      \uAC08\uB77C\uC9C8 \uAC83 \uAC19\uB2E4."
    - "\uC5D4\uBE44\uC758 \uBD80\uB4DC\uB7EC\uC6B4 \uC911\uC7AC \uC55E\uC5D0\uC11C
      \uC0C8\uD134\uC740 \uACF5\uB3D9\uCCB4\uB77C\uB294 \uB9D0\uC744 \uC27D\uAC8C
      \uBBFF\uC9C0 \uC54A\uC744 \uAC83 \uAC19\uB2E4."
    - "\uB204\uAD70\uAC00\uC758 \uC8FD\uC74C \uC774\uD6C4 \uC0C8\uD134\uC744 \uC870\uC0AC\uD558\uBA74,
      \uC0C8\uD134\uC758 \uBD84\uB178\uAC00 \uB204\uAD6C \uD55C \uBA85\uB9CC \uD5A5\uD55C
      \uAC83\uC774 \uC544\uB2D8\uC744 \uC54C \uC218 \uC788\uB2E4."
