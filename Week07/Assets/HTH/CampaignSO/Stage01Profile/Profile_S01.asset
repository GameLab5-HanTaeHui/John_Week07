      - "\uACB0\uACFC\uC758 \uCF8C\uAC10"
      CorrectChoiceIndex: 1
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uAC89\uC740 \uB2EC\uCF64\uD574\uC57C \uD574. \uADF8\uB798\uC57C
        \uC544\uBB34\uB3C4 \uC548 \uB180\uB77C\uB2C8\uAE4C."
      Appearance: "\uBC1D\uACE0 \uC573\uB41C \uC678\uBAA8. \uC6C3\uC74C\uC774 \uB04A\uC774\uC9C0
        \uC54A\uB294\uB2E4."
      NarrativeBackground: "\uC0AC\uB78C\uC744 \uB9DB\uC73C\uB85C \uBD84\uB958\uD558\uACE0
        \uC0AC\uAC74\uC744 \uC694\uB9AC\uB85C \uC778\uC2DD\uD558\uB294 \uB3C5\uD2B9\uD55C
        \uC138\uACC4\uAD00\uC744 \uAC00\uC84C\uB2E4."
      Personality: "\uD574\uB9D1\uACE0 \uAD00\uCC30\uB825\uC774 \uC608\uB9AC\uD558\uB2E4.
        \uADF9\uC801\uC778 \uACB0\uACFC\uB97C \uC120\uD638\uD55C\uB2E4."
      GimmickRelevance: "\uC544\uC774\uCC98\uB7FC \uBCF4\uC774\uB294 \uD45C\uBA74
        \uC544\uB798 \uB0C9\uC815\uD55C \uAD00\uCC30\uC790\uAC00 \uC228\uC5B4\uC788\uB2E4."
      CardIllustration: {fileID: 21300000, guid: b084f8f70a654704f8aac460b6217ca0, type: 3}
    EpilogueText: "\uC0AC\uB78C\uC740 \uC808\uB9DD\uD560 \uB54C \uAC00\uC7A5 \uC194\uC9C1\uD55C
      \uD5A5\uC744 \uB0B8\uB2E4."
