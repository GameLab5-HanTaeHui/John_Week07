    - Question: "\uB0B4\uAC00 \uACB0\uC815\uD574\uC57C \uBAA8\uB450\uAC00 \uC0B0\uB2E4\uB294
        \uD655\uC2E0"
      Choices:
      - "\uD655\uC2E0\uD55C\uB2E4"
      - "\uC758\uC2EC\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4"
      - "\uD655\uC2E0\uD588\uC9C0\uB9CC \uD2C0\uB838\uB2E4"
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uB204\uAD70\uAC00 \uC55E\uC5D0 \uC11C\uC57C \uD55C\uB2E4\uBA74,
        \uB098\uB294 \uC790\uAFB8 \uADF8\uAC8C \uB0B4 \uBAAB\uC774\uB77C\uACE0 \uC0DD\uAC01\uD558\uAC8C
        \uB41C\uB2E4."
      Appearance: "\uD06C\uACE0 \uB4EC\uC9C1\uD55C \uCCB4\uAD6C. \uD56D\uC0C1 \uC55E\uC5D0
        \uC11C\uB824\uB294 \uC790\uC138\uB97C \uCDE8\uD55C\uB2E4."
      NarrativeBackground: "\uB300\uC2E0 \uC9CA\uC5B4\uC9C0\uB294 \uAC83\uC744 \uC2E0\uB150\uC73C\uB85C
        \uC0BC\uC544\uC654\uB2E4."
      Personality: "\uCC45\uC784\uAC10\uC774 \uAC15\uD558\uACE0 \uD5CC\uC2E0\uC801\uC774\uB2E4.
        \uD0C0\uC778\uC758 \uC120\uD0DD\uAD8C\uC744 \uBB34\uC758\uC2DD\uC801\uC73C\uB85C
        \uCE68\uD574\uD55C\uB2E4."
      GimmickRelevance: "\uD76C\uC0DD\uC591 \uD6A8\uACFC\uB97C \uAC00\uC9C4 \uCE90\uB9AD\uD130.
        \uC120\uC758\uC640 \uB3C5\uB2E8\uC758 \uACBD\uACC4\uB97C \uD750\uB9B0\uB2E4."
      CardIllustration: {fileID: 21300000, guid: 80338f499f9f79640aa74de2ef72030c, type: 3}
    EpilogueText: "\uC88B\uC740 \uC758\uB3C4\uB77C\uB294 \uB9D0 \uC544\uB798\uC5D0\uC11C\uB3C4,
      \uB204\uAD70\uAC00\uC758 \uBAAB\uC740 \uC27D\uAC8C \uAC00\uB824\uC9C8 \uC218
      \uC788\uB2E4."
