    CharacterIcon: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    ProfileItems:
    - Question: "\uAC00\uC7A5 \uB450\uB824\uC6CC\uD558\uB294 \uAC83"
      Choices:
      - "\uBC84\uB824\uC9C0\uB294 \uAC83"
      - "\uAD00\uACC4\uB97C \uB9DD\uCE58\uB294 \uAC83"
      - "\uC9C4\uC2E4\uC774 \uB4DC\uB7EC\uB098\uB294 \uAC83"
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uB2E4\uC815\uD568\uC758 \uBCF8\uC9C8"
      Choices:
      - "\uC9C4\uC2EC \uC5B4\uB9B0 \uAC10\uC815"
      - "\uC2B5\uB4DD\uB41C \uAE30\uC220"
      - "\uBAA9\uC801\uC744 \uC704\uD55C \uC218\uB2E8"
      CorrectChoiceIndex: 1
      RequiredFragmentId: 
    - Question: "\uAD00\uACC4\uC5D0\uC11C \uC6D0\uD558\uB294 \uAC83"
      Choices:
      - "\uC18C\uC18D\uAC10"
      - "\uC778\uC815"
      - "\uC628\uAE30"
      CorrectChoiceIndex: 2
      RequiredFragmentId: 
    - Question: "\uC790\uC2E0\uC744 \uBC14\uB77C\uBCF4\uB294 \uC2DC\uC120"
      Choices:
      - "\uC9C0\uD0A4\uB294 \uC790"
      - "\uD754\uB4DC\uB294 \uC790"
      - "\uAD00\uCC30\uD558\uB294 \uC790"
      CorrectChoiceIndex: 1
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uBAA8\uB450\uC5D0\uAC8C \uBD04\uC774 \uC628\uB2E4\uBA74, \uB098\uB294
        \uC65C \uB298 \uBB38\uBC16\uC5D0\uC11C \uADF8 \uC628\uB3C4\uB9CC \uD6D4\uCCD0\uBD10\uC57C
        \uD558\uB294 \uAC78\uAE4C."
      Appearance: "\uAC08\uC0C9 \uBA38\uB9AC, \uC628\uD654\uD55C \uBBF8\uC18C. \uB298
        \uC911\uAC04\uC5D0 \uC11C \uC788\uB294 \uAC83\uCC98\uB7FC \uBCF4\uC778\uB2E4."
      NarrativeBackground: "\uACB0\uD54D \uC18D\uC5D0\uC11C \uB2E4\uC815\uD568\uC744
        \uBC30\uC6E0\uC73C\uB098 \uC9C4\uC2EC\uC73C\uB85C \uB2E4\uAC00\uAC00\uB294
        \uBC95\uC740 \uB05D\uB0B4 \uBC30\uC6B0\uC9C0 \uBABB\uD588\uB2E4."
      Personality: "\uBD80\uB4DC\uB7FD\uACE0 \uAD00\uCC30\uB825\uC774 \uB6F0\uC5B4\uB098\uB2E4.
        \uAD00\uACC4\uC758 \uD2C8\uC744 \uBCF8\uB2A5\uC801\uC73C\uB85C \uAC10\uC9C0\uD55C\uB2E4."
      GimmickRelevance: "\uC8FC\uC778\uACF5\uC73C\uB85C\uC11C \uD50C\uB808\uC774\uC5B4\uC758
        \uC2DC\uC120\uC744 \uB300\uB9AC\uD558\uB294 \uB3D9\uC2DC\uC5D0 \uC2A4\uC2A4\uB85C\uB3C4
        \uAD00\uCC30 \uB300\uC0C1\uC774 \uB41C\uB2E4."
      CardIllustration: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    EpilogueText: "\uB098\uB294 \uC5B8\uC81C\uB098 \uADF8 \uBD04\uC758 \uBC14\uAE65\uC5D0
      \uC788\uC5C8\uB2E4. \uADF8\uB7F0\uB370\uB3C4, \uC190\uC744 \uBED7\uACE0 \uC2F6\uC5C8\uB2E4."
  - CharacterId: 2
    RequiredFragmentCount: 5
    CharacterFullName: "\uBA54\uC774"
    CharacterRole: "(\uBCF5\uC218\uC790)"
    CharacterIcon: {fileID: 21300000, guid: ac9088d1bf1998a44a8eeec403dd264d, type: 3}
    ProfileItems:
    - Question: "\uB05D\uC744 \uD5A5\uD574 \uB2EC\uB9AC\uB294 \uC774\uC720"
      Choices:
      - "\uC0AC\uBA85\uAC10"
      - "\uB450\uB824\uC6C0"
      - "\uC99D\uBA85\uD558\uB824\uB294 \uC695\uAD6C"
      CorrectChoiceIndex: 2
      RequiredFragmentId: 
    - Question: "\uB3D9\uB8CC\uB97C \uB300\uD558\uB294 \uBC29\uC2DD"
      Choices:
      - "\uD568\uAED8 \uAC00\uB294 \uB3D9\uBC18\uC790"
      - "\uB04C\uACE0 \uAC00\uC57C \uD560 \uC874\uC7AC"
      - "\uC9C0\uCF1C\uC57C \uD560 \uB300\uC0C1"
      CorrectChoiceIndex: 1
      RequiredFragmentId: 
    - Question: "\uBA48\uCDA4\uC5D0 \uB300\uD55C \uC778\uC2DD"
      Choices:
      - "\uD544\uC694\uD55C \uD734\uC2DD"
      - "\uC0AC\uBA85 \uC774\uD0C8"
      - "\uB098\uC57D\uD568\uC758 \uC99D\uAC70"
      CorrectChoiceIndex: 1
      RequiredFragmentId: 
    - Question: "\uAC00\uC7A5 \uC9D1\uCC29\uD558\uB294 \uAC83"
      Choices:
      - "\uAC00\uBB38\uC758 \uC774\uB984"
      - "\uB9C8\uC9C0\uB9C9 \uC99D\uBA85"
      - "\uB3D9\uB8CC\uC758 \uC0DD\uC874"
      CorrectChoiceIndex: 1
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uB204\uAD70\uAC00\uB294 \uB05D\uAE4C\uC9C0 \uAC00\uC57C \uD55C\uB2E4.
        \uB098\uB294 \uADF8 \uC790\uB9AC\uB97C \uD53C\uD558\uC9C0 \uC54A\uACA0\uB2E4."
      Appearance: "\uB2E8\uC815\uD558\uACE0 \uAC15\uC778\uD55C \uC778\uC0C1. \uD56D\uC0C1
        \uC55E\uC744 \uD5A5\uD574 \uC11C \uC788\uB2E4."
      NarrativeBackground: "\uAC00\uBB38\uC758 \uC774\uB984\uC744 \uC9CA\uC5B4\uC9C0\uACE0
        \uB9C8\uC655 \uD1A0\uBC8C\uC744 \uC0AC\uBA85\uC73C\uB85C \uC0BC\uC544\uC654\uB2E4."
      Personality: "\uACB0\uB2E8\uB825\uC774 \uAC15\uD558\uACE0 \uC758\uC9C0\uAC00
        \uD655\uACE0\uD558\uB2E4. \uBA48\uCDA4\uC744 \uC0AC\uBA85 \uC774\uD0C8\uB85C
        \uC778\uC2DD\uD55C\uB2E4."
      GimmickRelevance: "\uC804\uC9C4\uC744 \uAC15\uC694\uD558\uB294 \uAD6C\uC870
        \uC18D\uC5D0\uC11C \uD76C\uC0DD\uACFC \uCC45\uC784\uC758 \uACBD\uACC4\uB97C
        \uD750\uB9B0\uB2E4."
      CardIllustration: {fileID: 21300000, guid: ac9088d1bf1998a44a8eeec403dd264d, type: 3}
    EpilogueText: "\uC5EC\uAE30\uC11C \uBA48\uCD94\uBA74 \uC9C0\uAE08\uAE4C\uC9C0
      \uBC84\uD168 \uC628 \uC2DC\uAC04\uB9C8\uC800 \uD750\uB824\uC9C8 \uAC83 \uAC19\uC544."
  - CharacterId: 3
    RequiredFragmentCount: 5
    CharacterFullName: "\uB370\uC6B0\uC2A4"
    CharacterRole: "(\uC5F0\uC778A)"
    CharacterIcon: {fileID: 21300000, guid: 484145e7050ecd2428f736cb1261a825, type: 3}
    ProfileItems:
    - Question: "\uB8E8\uC774\uC2A4\uC5D0 \uB300\uD55C \uAC10\uC815"
      Choices:
