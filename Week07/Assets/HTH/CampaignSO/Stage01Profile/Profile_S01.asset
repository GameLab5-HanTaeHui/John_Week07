      Choices:
      - "\uC801\uADF9 \uAC1C\uC785"
      - "\uCE68\uBB35\uACFC \uAD00\uCC30"
      - "\uD68C\uD53C"
      CorrectChoiceIndex: 1
      RequiredFragmentId: 
    - Question: "\uC2A4\uC2A4\uB85C\uC5D0 \uB300\uD55C \uC778\uC2DD"
      Choices:
      - "\uBC84\uD2F0\uB294 \uC0AC\uB78C"
      - "\uAE30\uB300\uB294 \uC0AC\uB78C"
      - "\uC78A\uD600\uC9C0\uB294 \uC0AC\uB78C"
      CorrectChoiceIndex: 1
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uC544\uBB34 \uC77C\uB3C4 \uC548 \uC77C\uC5B4\uB0AC\uC73C\uBA74
        \uC88B\uACA0\uB2E4. \uC544\uBB34\uB3C4 \uBB3B\uC9C0 \uC54A\uACE0, \uC544\uBB34\uB3C4
        \uC7AC\uCD09\uD558\uC9C0 \uC54A\uB294 \uACF3\uC5D0\uC11C."
      Appearance: "\uC870\uC6A9\uD558\uACE0 \uCC3D\uBC31\uD55C \uC778\uC0C1. \uC874\uC7AC\uAC10\uC774
        \uC605\uC5B4 \uBCF4\uC778\uB2E4."
      NarrativeBackground: "\uBC18\uBCF5\uB418\uB294 \uB8E8\uD504 \uC18D\uC5D0\uC11C
        \uC815\uC2E0\uC801\uC73C\uB85C \uC18C\uC9C4\uB418\uC5B4\uAC00\uACE0 \uC788\uB2E4."
      Personality: "\uB0B4\uD5A5\uC801\uC774\uACE0 \uD53C\uB85C\uC5D0 \uC775\uC219\uD558\uB2E4.
        \uD604\uC7AC\uC758 \uC548\uC815\uC5D0 \uBA38\uBB34\uB974\uB824 \uD55C\uB2E4."
      GimmickRelevance: "\uAE30\uB300\uC5B4 \uBC84\uD2F0\uB294 \uC120\uD0DD\uC774
        \uC5BC\uB9C8\uB098 \uC704\uD0DC\uB85C\uC6B4\uC9C0\uB97C \uBCF4\uC5EC\uC900\uB2E4."
      CardIllustration: {fileID: 21300000, guid: 99bb6781bae90764faec8614b21f7e33, type: 3}
    EpilogueText: "\uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uB294
      \uC2DC\uAC04\uC774 \uD544\uC694\uD558\uB2E4."
