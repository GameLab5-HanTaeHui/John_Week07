  _stageId: Stage_1_Phase2
  _characterProfiles:
  - CharacterId: 1
    RequiredFragmentCount: 10
    CharacterFullName: "\uC5D4\uBE44"
    CharacterRole: "(\uC8FC\uC778\uACF5)"
    CharacterIcon: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    ProfileItems:
    - Question: "\uACFC\uAC70 \uD575\uC2EC \uC0AC\uAC74"
      Choices:
      - "\uC5D4\uBE44\uB294 \uC5B4\uB9B0 \uC2DC\uC808 \uC54C \uC218 \uC5C6\uB294
        \uC774\uC720\uB85C \uBD80\uBAA8\uC5D0\uAC8C\uC11C \uC720\uAE30\uB2F9\uD55C
        \uACBD\uD5D8\uC774 \uC788\uB2E4."
      - "\uC5D4\uBE44\uB294 \uC5B4\uB9B0 \uC2DC\uC808 \uB3D9\uC0DD\uACFC \uD568\uAED8
        \uB5A0\uB3CC\uC774 \uBC14\uB4DC\uC758 \uACF5\uC5F0\uC744 \uBCF8 \uACBD\uD5D8\uC774
        \uC788\uB2E4."
      - "\uC5D4\uBE44\uB294 \uC5B4\uB9B0 \uC2DC\uC808 \uD2B9\uBCC4\uD55C \uC0C1\uCC98
        \uC5C6\uC774 \uD3C9\uBC94\uD55C \uAC00\uC815\uC5D0\uC11C \uC790\uB77C \uC2A4\uC2A4\uB85C
        \uAE38\uC744 \uB5A0\uB0AC\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uD604\uC7AC \uC815\uCCB4/\uD589\uB3D9 \uC774\uC720"
      Choices:
      - "\uC5D4\uBE44\uB294 \uD604\uC7AC \uB9C8\uC655\uC774 \uC2EC\uC5B4\uB454 \uC2A4\uD30C\uC774\uB85C\uC11C
        \uC6A9\uBCD1\uB2E8\uC5D0 \uB4E4\uC5B4\uC654\uB2E4."
      - "\uC5D4\uBE44\uB294 \uD604\uC7AC \uBC14\uB4DC\uB85C\uC11C \uC6A9\uBCD1\uB2E8\uC5D0
        \uB4E4\uC5B4\uC654\uB2E4."
      - "\uC5D4\uBE44\uB294 \uC6A9\uBCD1\uB2E8\uC5D0\uC11C \uC774\uB984\uC744 \uC54C\uB9AC\uACE0
        \uBB34\uB300\uC5D0 \uC124 \uAE30\uD68C\uB97C \uC5BB\uAE30 \uC704\uD574 \uD569\uB958\uD588\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uAD00\uACC4 \uC778\uC2DD"
      Choices:
      - "\uC5D4\uBE44\uB294 \uC6A9\uBCD1\uB2E8\uC758 \uAD00\uACC4\uC640 \uC628\uAE30\uB97C
        \uB3D9\uACBD\uD558\uACE0 \uC788\uB2E4."
      - "\uC5D4\uBE44\uB294 \uC720\uBA85\uD55C \uBC29\uB791 \uAC00\uD76C \u2018\uD638\uC2DC\uB178\u2019\uB97C
        \uB3D9\uACBD\uD558\uACE0 \uC788\uB2E4."
      - "\uC5D4\uBE44\uB294 \uC6A9\uBCD1\uB2E8\uC758 \uAD00\uACC4\uBCF4\uB2E4 \uC790\uC2E0\uC758
        \uC7AC\uB2A5\uACFC \uC778\uC815\uBC1B\uB294 \uC77C\uC5D0 \uB354 \uD070 \uAD00\uC2EC\uC744
        \uB454\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uC228\uACA8\uC9C4 \uC65C\uACE1"
      Choices:
      - "\uADF8\uB7EC\uB098 \uC5D4\uBE44\uB294 \uC790\uC2E0\uC774 \uADF8 \uAD00\uACC4\uB97C
        \uBB34\uB108\uB728\uB9B4 \uC874\uC7AC\uB77C\uB294 \uC0AC\uC2E4\uC744 \uC54C\uACE0
        \uC788\uB2E4."
      - "\uADF8\uB7EC\uB098 \uC5D4\uBE44\uB294 \uC790\uC2E0\uC5D0\uAC8C \uADF8 \uC815\uB3C4\uC758
        \uC7AC\uB2A5\uC740 \uC5C6\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uC54C\uACE0 \uC788\uB2E4."
      - "\uC5D4\uBE44\uB294 \uC790\uC2E0\uC774 \uAD00\uACC4\uB97C \uD754\uB4E0\uB2E4\uB294
        \uC0AC\uC2E4\uC744 \uC790\uAC01\uD558\uC9C0 \uBABB\uD558\uACE0, \uAC08\uB4F1\uC5D0\uB3C4
        \uB454\uAC10\uD55C \uD3B8\uC774\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uCD5C\uC885 \uAE30\uC804"
      Choices:
      - "\uADF8\uB798\uC11C \uC5D4\uBE44\uB294 \uC9C0\uD0A4\uACE0 \uC2F6\uC73C\uBA74\uC11C\uB3C4
        \uC2DC\uD5D8\uD558\uACE0 \uD754\uB4DC\uB294 \uBAA8\uC21C\uB41C \uD589\uB3D9\uC744
        \uBCF4\uC778\uB2E4."
      - "\uADF8\uB798\uC11C \uC5D4\uBE44\uB294 \uC6A9\uBCD1\uB2E8 \uB3D9\uB8CC\uB4E4\uACFC
        \uACC4\uC18D \uD568\uAED8 \uB2E4\uB2C8\uBA70 \uC790\uC2E0\uC758 \uBB34\uB300\uB97C
        \uCC3E\uACE0 \uC2F6\uC5B4 \uD55C\uB2E4."
      - "\uADF8\uB798\uC11C \uC5D4\uBE44\uB294 \uB204\uAD6C\uC5D0\uAC8C\uB3C4 \uAE4A\uAC8C
        \uC5BD\uB9E4\uC774\uC9C0 \uC54A\uB294 \uC790\uC720\uB85C\uC6B4 \uBC29\uB791\uC790\uB85C
        \uB0A8\uC73C\uB824 \uD55C\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uB098\uB294 \uB298 \uB108\uD76C\uC758 \uBD04 \uBC14\uAE65\uC5D0
        \uC788\uC5C8\uB2E4. \uADF8\uB798\uC11C \uB204\uAD6C\uBCF4\uB2E4 \uADF8 \uC628\uAE30\uB97C
        \uC0AC\uB791\uD588\uACE0, \uB204\uAD6C\uBCF4\uB2E4 \uADF8\uAC83\uC744 \uB9DD\uAC00\uB728\uB9B4
        \uC218 \uC788\uC5C8\uB2E4."
      Appearance: "\uAC08\uC0C9\uBE5B \uB2E8\uBC1C\uACFC \uB0AE\uAC8C \uAC00\uB77C\uC549\uC740
        \uB208\uB9E4, \uBBFC\uD2B8\uC0C9 \uB9AC\uBCF8 \uC7A5\uC2DD\uC774 \uBD80\uB4DC\uB7FD\uC9C0\uB9CC
        \uC5B4\uB518\uAC00 \uBE44\uC5B4 \uC788\uB294 \uC778\uC0C1\uC744 \uB0A8\uAE34\uB2E4."
      NarrativeBackground: "\uC774\uC720\uB3C4 \uBAA8\uB978 \uCC44 \uBC84\uB824\uC9C4
        \uB4A4 \uB9C8\uC655\uC758 \uC2A4\uD30C\uC774\uB85C \uAE38\uB7EC\uC84C\uACE0,
        \uC6A9\uBCD1\uB2E8 \uC548\uC5D0\uC11C \uCC98\uC74C\uC73C\uB85C \uAD00\uACC4\uC758
        \uC628\uAE30\uB97C \uBC30\uC6E0\uB2E4."
      Personality: "\uB2E4\uC815\uD55C \uC911\uC7AC\uC790\uCC98\uB7FC \uBCF4\uC774\uC9C0\uB9CC,
        \uB204\uAD6C\uBCF4\uB2E4 \uAD00\uACC4\uC758 \uD2C8\uC744 \uC798 \uC77D\uACE0
        \uD754\uB4E4 \uC218 \uC788\uB2E4."
      GimmickRelevance: "\uC8FD\uC9C0 \uC54A\uACE0 \uB05D\uAE4C\uC9C0 \uB0A8\uC544
        \uBAA8\uB4E0 \uAD00\uACC4\uC758 \uACB0\uACFC\uB97C \uBAA9\uACA9\uD558\uB294
        \uC8FC\uC778\uACF5."
      CardIllustration: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    EpilogueLines:
    - "\uB098\uB294 \uB298 \uB108\uD76C\uC758 \uBD04 \uBC14\uAE65\uC5D0 \uC788\uB2E4\uACE0
      \uC0DD\uAC01\uD588\uB2E4."
    - "\uB108\uD76C\uB294 \uC11C\uB85C\uB97C \uC624\uB798 \uC54C\uACE0 \uC788\uC5C8\uACE0,
      \uB098\uB294 \uB4A4\uB2A6\uAC8C \uB07C\uC5B4\uB4E0 \uC774\uBC29\uC778\uC774\uC5C8\uC73C\uB2C8\uAE4C."
    - "\uB108\uD76C\uB97C \uBB34\uB108\uB728\uB824\uC57C \uD558\uB294 \uC0AC\uBA85\uB3C4
      \uC788\uC5C8\uB2E4. \uCC98\uC74C \uB0B4\uAC00 \uC628\uAE30\uB97C \uB290\uAF08\uB358
      \uB0A0, \uBAA8\uB978 \uCC99\uC744 \uD588\uB2E4."
    - "\uC774\uC81C\uB294 \uC548\uB2E4."
    - "\uB098\uB294 \uB108\uD76C\uB97C \uC2DC\uD5D8\uD588\uB2E4."
    - "\uADF8\uB7EC\uB098 \uB108\uD76C\uB3C4 \uAC01\uC790\uC758 \uBC29\uC2DD\uC73C\uB85C
      \uC774\uBBF8 \uD754\uB4E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    - "\uC6B0\uB9AC\uB294 \uAC19\uC740 \uBD04\uC744 \uAFC8\uAFBC \uAC83\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    - "\uADF8\uB798\uB3C4 \uADF8 \uBD04\uC774 \uB530\uB73B\uD588\uB2E4\uB294 \uAC83\uB9CC\uC740,
      \uBAA8\uB450\uAC00 \uC54C\uACE0 \uC788\uC5C8\uC744 \uAC83\uC774\uB2E4."
    - "\uB0B4\uAC00 \uB9DD\uAC00\uB728\uB9AC\uACE0 \uC2F6\uC5C8\uB358 \uAC83\uC740
      \uAD00\uACC4\uAC00 \uC544\uB2C8\uB77C, \uADF8 \uC548\uC5D0 \uB4E4\uC5B4\uAC08
      \uC790\uACA9\uC774 \uC5C6\uB2E4\uACE0 \uBBFF\uC5C8\uB358 \uB098 \uC790\uC2E0\uC774\uC5C8\uB2E4."
    - "\uC774\uC81C\uC57C \uB9D0\uD560 \uC218 \uC788\uB2E4."
    - "\uB098\uB294 \uB108\uD76C\uB97C \uC9C8\uD22C\uD588\uB2E4. \uADF8\uB9AC\uACE0
      \uB3D9\uC2DC\uC5D0, \uB108\uD76C\uC640 \uD568\uAED8 \uC788\uACE0 \uC2F6\uC5C8\uB2E4."
  - CharacterId: 2
    RequiredFragmentCount: 10
    CharacterFullName: "\uBA54\uC774"
    CharacterRole: "(\uBCF5\uC218\uC790)"
    CharacterIcon: {fileID: 21300000, guid: ac9088d1bf1998a44a8eeec403dd264d, type: 3}
    ProfileItems:
    - Question: "\uACFC\uAC70 \uD575\uC2EC \uC0AC\uAC74"
      Choices:
      - "\uBA54\uC774\uB294 \uAC00\uBB38\uC758 \uBAB0\uB77D \uC774\uD6C4, \uC790\uC2E0\uB9CC
        \uC0B4\uC544\uB0A8\uC558\uB2E4\uB294 \uC0AC\uC2E4\uC5D0 \uC758\uBBF8\uB97C
        \uBD80\uC5EC\uD574\uC57C \uD55C\uB2E4\uB294 \uAC15\uBC15\uC744 \uC9CA\uC5B4\uC84C\uB2E4."
      - "\uBA54\uC774\uB294 \uAC00\uBB38\uC758 \uBAB0\uB77D \uC774\uD6C4, \uC783\uC5B4\uBC84\uB9B0
        \uC601\uC9C0\uC640 \uC9C0\uC704\uB97C \uB418\uCC3E\uAE30 \uC704\uD574 \uC2F8\uC6B4\uB2E4."
      - "\uBA54\uC774\uB294 \uAC00\uBB38\uC758 \uBAB0\uB77D \uC774\uD6C4 \uC804\uC7C1\uACFC
        \uBA85\uC608\uB97C \uBAA8\uB450 \uB0B4\uB824\uB193\uACE0 \uC870\uC6A9\uD788
        \uC0B4\uACE0 \uC2F6\uC5B4 \uD55C\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uD604\uC7AC \uC815\uCCB4/\uD589\uB3D9 \uC774\uC720"
      Choices:
      - "\uBA54\uC774\uB294 \uB9C8\uC655\uC744 \uB2E8\uC21C\uD55C \uC801\uC774 \uC544\uB2C8\uB77C,
        \uC790\uC2E0\uC758 \uC0DD\uC874\uACFC \uC0C1\uC2E4\uC744 \uC815\uB2F9\uD654\uD574
        \uC904 \uB9C8\uC9C0\uB9C9 \uACB0\uB9D0\uB85C \uBCF8\uB2E4."
      - "\uBA54\uC774\uB294 \uB9C8\uC655\uC744 \uAC00\uBB38 \uBCF5\uAD8C\uACFC \uC815\uCE58\uC801
        \uBA85\uC608 \uD68C\uBCF5\uC744 \uC704\uD55C \uACF5\uC801\uC73C\uB85C \uBCF8\uB2E4."
      - "\uBA54\uC774\uB294 \uB9C8\uC655\uC744 \uC790\uC2E0\uC758 \uC0B6\uACFC \uBB34\uAD00\uD55C
        \uC678\uBD80\uC758 \uC815\uCE58\uC801 \uBB38\uC81C\uB85C\uB9CC \uBCF8\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uAD00\uACC4 \uC778\uC2DD"
      Choices:
      - "\uBA54\uC774\uB294 \uB3D9\uB8CC\uB4E4\uC744 \uC18C\uC911\uD788 \uC5EC\uAE30\uC9C0\uB9CC,
        \uB3D9\uC2DC\uC5D0 \uC790\uC2E0\uC774 \uBB34\uB108\uC9C0\uC9C0 \uC54A\uB3C4\uB85D
        \uB05D\uAE4C\uC9C0 \uD568\uAED8 \uC11C \uC788\uC5B4\uC57C \uD560 \uC99D\uC778\uB4E4\uB85C
        \uC778\uC2DD\uD55C\uB2E4."
      - "\uBA54\uC774\uB294 \uB3D9\uB8CC\uB4E4\uC744 \uC790\uC2E0\uC758 \uBA85\uC131\uACFC
        \uAD8C\uC704\uB97C \uC99D\uBA85\uD574 \uC904 \uC218\uD589\uB2E8\uC73C\uB85C
        \uC778\uC2DD\uD55C\uB2E4."
      - "\uBA54\uC774\uB294 \uB3D9\uB8CC\uB4E4\uC744 \uC7A0\uC2DC \uD568\uAED8 \uC77C\uD558\uB294
        \uB3D9\uC5C5\uC790\uB85C \uC5EC\uAE30\uBA70 \uAE4A\uC740 \uC720\uB300\uC5D0\uB294
        \uAD00\uC2EC\uC774 \uC5C6\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uC228\uACA8\uC9C4 \uC65C\uACE1"
      Choices:
      - "\uBA54\uC774\uB294 \uB204\uAD70\uAC00\uAC00 \uBA48\uCD94\uAC70\uB098 \uB5A0\uB098\uB294
        \uAC83\uC744 \uAC1C\uC778\uC758 \uC120\uD0DD\uC774 \uC544\uB2C8\uB77C, \uC790\uC2E0\uC774
        \uBD99\uC7A1\uC544 \uC628 \uC758\uBBF8\uAC00 \uBB34\uB108\uC9C0\uB294 \uC9D5\uC870\uB85C
        \uBC1B\uC544\uB4E4\uC778\uB2E4."
      - "\uBA54\uC774\uB294 \uB204\uAD70\uAC00\uAC00 \uBA48\uCD94\uAC70\uB098 \uB5A0\uB098\uB294
        \uAC83\uC744 \uC790\uC2E0\uC758 \uC9C0\uD718\uC5D0 \uB300\uD55C \uBA85\uB839
        \uBD88\uBCF5\uC885\uC73C\uB85C \uBC1B\uC544\uB4E4\uC778\uB2E4."
      - "\uBA54\uC774\uB294 \uB204\uAD70\uAC00\uAC00 \uBA48\uCD94\uAC70\uB098 \uB5A0\uB098\uB294
        \uAC83\uC744 \uC790\uC5F0\uC2A4\uB7EC\uC6B4 \uAC1C\uC778 \uC120\uD0DD\uC73C\uB85C
        \uBC1B\uC544\uB4E4\uC778\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uCD5C\uC885 \uAE30\uC804"
      Choices:
      - "\uACB0\uAD6D \uBA54\uC774\uB294 \uB3D9\uB8CC\uB97C \uC9C0\uD0A4\uB824\uB294
        \uB9C8\uC74C\uACFC \uC790\uC2E0\uC758 \uC11C\uC0AC\uB97C \uC644\uC131\uD558\uB824\uB294
        \uAC15\uBC15\uC744 \uAD6C\uBD84\uD558\uC9C0 \uBABB\uD574, \uBAA8\uB450\uB97C
        \uB05D\uAE4C\uC9C0 \uB04C\uACE0 \uAC00\uB824\uB294 \uC704\uD5D8\uC131\uC744
        \uC9C0\uB2CC\uB2E4."
      - "\uACB0\uAD6D \uBA54\uC774\uB294 \uAD8C\uB825\uACFC \uBA85\uC608\uB97C \uD68C\uBCF5\uD558\uAE30
        \uC704\uD574 \uD0C0\uC778\uC744 \uC774\uC6A9\uD558\uB294 \uC57C\uC2EC\uAC00\uC5D0
        \uAC00\uAE5D\uB2E4."
      - "\uACB0\uAD6D \uBA54\uC774\uB294 \uC601\uC6C5\uC774 \uB418\uAE30\uBCF4\uB2E4
        \uC2F8\uC6C0\uC5D0\uC11C \uBC97\uC5B4\uB098 \uD3C9\uC628\uD55C \uC0B6\uC744
        \uC120\uD0DD\uD558\uB824\uB294 \uC778\uBB3C\uC774\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uB05D\uC744 \uBD10\uC57C \uD55C\uB2E4. \uADF8\uB798\uC57C \uB0B4\uAC00
        \uC0B4\uC544\uB0A8\uC740 \uC774\uC720\uB3C4, \uC783\uC5B4\uC628 \uC774\uB984\uB3C4
        \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uB294\uB2E4."
      Appearance: "\uBD89\uC740 \uBB34\uB2AC\uAC00 \uC11E\uC778 \uC9D9\uC740 \uB179\uBC1C\uC744
        \uB0AE\uAC8C \uBB36\uACE0, \uC608\uB9AC\uD55C \uB208\uBE5B\uACFC \uBAA9\uC744
        \uAC10\uC2FC \uC9D9\uC740 \uCC9C\uC774 \uAC70\uCE60\uACE0 \uB2E8\uB2E8\uD55C
        \uC778\uC0C1\uC744 \uB9CC\uB4E0\uB2E4."
      NarrativeBackground: "\uAC00\uBB38\uC758 \uBAB0\uB77D \uC774\uD6C4, \uB9C8\uC655\uC744
        \uC4F0\uB7EC\uB728\uB9B0 \uC601\uC6C5\uC774 \uB418\uC5B4\uC57C \uC790\uC2E0\uC758
        \uC0DD\uC874\uACFC \uC0C1\uC2E4\uC774 \uC758\uBBF8\uB97C \uC5BB\uB294\uB2E4\uACE0
        \uBBFF\uAC8C \uB418\uC5C8\uB2E4."
      Personality: "\uB3D9\uB8CC\uB97C \uC9C4\uC2EC\uC73C\uB85C \uC544\uB07C\uC9C0\uB9CC,
        \uADF8\uB4E4\uC744 \uC790\uC2E0\uC774 \uBB34\uB108\uC9C0\uC9C0 \uC54A\uB3C4\uB85D
        \uB05D\uAE4C\uC9C0 \uD568\uAED8 \uC11C \uC788\uC5B4\uC57C \uD560 \uC99D\uC778\uCC98\uB7FC
        \uC5EC\uAE30\uBA70 \uBA48\uCDA4\uC744 \uBC1B\uC544\uB4E4\uC774\uC9C0 \uBABB\uD55C\uB2E4."
      GimmickRelevance: "\uC0B4\uC778\uC790\uC640 \uAC19\uC740 \uAD6C\uC5ED\uC5D0
        \uC788\uC73C\uBA74 \uC0B4\uC778\uC790\uB97C \uCC98\uB2E8\uD558\uB294 \uBCF5\uC218\uC790."
      CardIllustration: {fileID: 21300000, guid: ac9088d1bf1998a44a8eeec403dd264d, type: 3}
    EpilogueLines:
    - "\uB098\uB294 \uB05D\uAE4C\uC9C0 \uAC00\uC57C \uD55C\uB2E4\uACE0 \uBBFF\uC5C8\uB2E4."
    - "\uB9C8\uC655\uC744 \uC4F0\uB7EC\uB728\uB9AC\uACE0, \uBB34\uB108\uC9C4 \uC774\uB984\uC744
      \uB418\uCC3E\uACE0, \uC6B0\uB9AC\uAC00 \uAC78\uC5B4\uC628 \uAE38\uC774 \uD2C0\uB9AC\uC9C0
      \uC54A\uC558\uC74C\uC744 \uC99D\uBA85\uD574\uC57C \uD588\uB2E4. \uADF8\uB798\uC11C
      \uBA48\uCD94\uB824\uB294 \uC0AC\uB78C\uC744 \uC774\uD574\uD558\uC9C0 \uBABB\uD588\uB2E4.
      \uB0B4\uAC8C \uBA48\uCDA4\uC740 \uACE7 \uD3EC\uAE30\uC600\uACE0, \uD3EC\uAE30\uB294
      \uACE7 \uC6B0\uB9AC\uAC00 \uC783\uC5B4\uC628 \uBAA8\uB4E0 \uAC83\uC5D0 \uB300\uD55C
      \uBC30\uC2E0\uC774\uC5C8\uB2E4."
    - "\uD558\uC9C0\uB9CC \uC9C0\uAE08\uC740 \uC548\uB2E4."
    - "\uB8E8\uC774\uC2A4\uAC00 \uBA48\uCD94\uACE0 \uC2F6\uC5B4 \uD55C \uAC83\uC740
      \uC57D\uD574\uC11C\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uADF8\uB294 \uB108\uBB34
      \uC624\uB798 \uBC84\uD17C\uACE0, \uB354 \uC120\uD0DD\uD558\uBA74 \uB204\uAD70\uAC00\uB97C
      \uC783\uAC8C \uB420\uAE4C \uB450\uB824\uC6E0\uB358 \uAC83\uC774\uB2E4."
    - "\uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB97C \uBD99\uC7A1\uC740 \uAC83\uB3C4
      \uB2E8\uC21C\uD55C \uC9D1\uCC29\uB9CC\uC740 \uC544\uB2C8\uC5C8\uB2E4. \uADF8\uB140
      \uC5ED\uC2DC \uB8E8\uC774\uC2A4\uAC00 \uBB34\uB108\uC9C0\uBA74 \uC790\uC2E0\uB3C4
      \uBB34\uB108\uC9C8 \uB9CC\uD07C \uC808\uBC15\uD588\uB2E4."
    - "\uC0C8\uD134\uC758 \uC9C8\uBB38\uC740 \uB098\uB97C \uBD80\uC815\uD558\uAE30
      \uC704\uD55C \uAC83\uC774 \uC544\uB2C8\uC5C8\uB2E4. \uB0B4\uAC00 \uBCF4\uC9C0
      \uC54A\uC73C\uB824 \uD55C \uD76C\uC0DD\uC744 \uB05D\uAE4C\uC9C0 \uBCF4\uB824\uB294
      \uB208\uC774\uC5C8\uB2E4."
    - "\uB098\uB294 \uBAA8\uB450\uB97C \uB370\uB824\uAC00\uB824 \uD588\uB2E4."
    - "\uB3D9\uB8CC\uB77C\uACE0 \uBBFF\uC5C8\uAE30 \uB54C\uBB38\uC5D0."
    - "\uADF8\uB7EC\uB098 \uB3D9\uB8CC\uB77C\uBA74, \uAC01\uC790\uAC00 \uC5B4\uB514\uAE4C\uC9C0
      \uAC08 \uC218 \uC788\uB294\uC9C0\uB3C4 \uBB3C\uC5C8\uC5B4\uC57C \uD588\uB2E4."
    - "\uB0B4\uAC00 \uC6D0\uD55C \uBD04\uC740 \uC2B9\uB9AC\uC758 \uBD04\uC774\uC5C8\uB2E4."
    - "\uD558\uC9C0\uB9CC \uB204\uAD70\uAC00\uC5D0\uAC8C \uBD04\uC740 \uB3CC\uC544\uAC08
      \uC9D1\uC774\uC5C8\uACE0, \uB204\uAD70\uAC00\uC5D0\uAC8C\uB294 \uBA48\uCDB0
      \uC274 \uACF3\uC774\uC5C8\uACE0, \uB204\uAD70\uAC00\uC5D0\uAC8C\uB294 \uB354
      \uC774\uC0C1 \uB204\uAD6C\uB3C4 \uB0A8\uACA8\uC9C0\uC9C0 \uC54A\uB294 \uAE38\uC774\uC5C8\uB2E4."
    - "\uB098\uB294 \uC774\uC81C \uC548\uB2E4."
    - "\uC601\uC6C5\uC758 \uACB0\uB9D0\uC740 \uBAA8\uB450\uB97C \uB04C\uACE0 \uAC00\uB294
      \uAC83\uC774 \uC544\uB2C8\uB77C, \uBAA8\uB450\uC758 \uACC4\uC808\uC774 \uB2E4\uB974\uB2E4\uB294
      \uAC83\uC744 \uBC1B\uC544\uB4E4\uC774\uB294 \uB370\uC11C \uC2DC\uC791\uB41C\uB2E4."
  - CharacterId: 3
    RequiredFragmentCount: 10
    CharacterFullName: "\uB370\uC6B0\uC2A4"
    CharacterRole: "(\uC5F0\uC778 A)"
    CharacterIcon: {fileID: 21300000, guid: 484145e7050ecd2428f736cb1261a825, type: 3}
    ProfileItems:
    - Question: "\uACFC\uAC70 \uD575\uC2EC \uC0AC\uAC74"
      Choices:
      - "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C \uC0AC\uB791\uD558\uC9C0\uB9CC,
        \uADF8 \uAC10\uC815\uC744 \uC2E0\uC131\uD55C \uC758\uBBF8\uB85C \uD3EC\uC7A5\uD558\uBA70
        \uC815\uB2F9\uD654\uD55C\uB2E4."
      - "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C \uAD6C\uC6D0 \uB300\uC0C1\uC774\uC790
        \uB3CC\uBD10\uC57C \uD560 \uD658\uC790\uB85C \uBCF4\uACE0 \uC788\uB2E4."
      - "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uBCF4\uB2E4 \uAD50\uB2E8\uC758
        \uADDC\uC728\uACFC \uC0AC\uC81C\uB85C\uC11C\uC758 \uC758\uBB34\uB97C \uB354
        \uC6B0\uC120\uD55C\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uD604\uC7AC \uC815\uCCB4/\uD589\uB3D9 \uC774\uC720"
      Choices:
      - "\uB370\uC6B0\uC2A4\uC5D0\uAC8C \uB8E8\uC774\uC2A4\uB294 \uC5F0\uC778\uC774\uC790
        \uC0B6\uC758 \uC758\uBBF8\uC774\uBA70 \uC720\uC77C\uD55C \uAD6C\uC6D0\uC774\uB2E4."
      - "\uB370\uC6B0\uC2A4\uB294 \uC0AC\uC81C\uB85C\uC11C \uB8E8\uC774\uC2A4\uB97C
        \uBCF4\uD638\uD558\uACE0 \uCE58\uB8CC\uD558\uBA70 \uD68C\uBCF5\uC744 \uC704\uD574
        \uD5CC\uC2E0\uD558\uACE0 \uC788\uB2E4."
      - "\uB370\uC6B0\uC2A4\uC5D0\uAC8C \uB8E8\uC774\uC2A4\uB294 \uD2B9\uBCC4\uD55C
        \uAD6C\uC6D0\uC774 \uC544\uB2C8\uB77C \uB3CC\uBD10\uC57C \uD560 \uC5EC\uB7EC
        \uB3D9\uB8CC \uC911 \uD55C \uBA85\uC774\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uAD00\uACC4 \uC778\uC2DD"
      Choices:
      - "\uADF8\uB798\uC11C \uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C \uC9C0\uD0A4\uAE30
        \uC704\uD574 \uD0C0\uC778\uC744 \uBC30\uC81C\uD558\uACE0 \uAD00\uACC4\uB97C
        \uD1B5\uC81C\uD558\uB824 \uD55C\uB2E4."
      - "\uADF8\uB798\uC11C \uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uC758 \uD68C\uBCF5\uC744
        \uC704\uD574 \uC7A0\uC2DC \uC6A9\uBCD1\uB2E8 \uC0AC\uB78C\uB4E4\uACFC \uAC70\uB9AC\uB97C
        \uB450\uB824 \uD55C\uB2E4."
      - "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uAC00 \uB204\uAD6C\uC640 \uAC00\uAE4C\uC6CC\uC838\uB3C4
        \uD06C\uAC8C \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uACE0 \uAD00\uACC4\uB97C \uC5F4\uC5B4
        \uB454\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uC228\uACA8\uC9C4 \uC65C\uACE1"
      Choices:
      - "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C \uBCF4\uD638\uD558\uACE0
        \uC788\uB2E4\uACE0 \uBBFF\uC9C0\uB9CC, \uC2E4\uC81C\uB85C\uB294 \uB8E8\uC774\uC2A4\uB97C
        \uACE0\uB9BD\uC2DC\uD0A4\uACE0 \uC788\uB2E4."
      - "\uACB0\uAD6D \uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4 \uCE58\uB8CC\uC5D0
        \uD5CC\uC2E0\uC801\uC77C \uBFD0\uC778\uB370 \uC8FC\uBCC0 \uC778\uBB3C\uB4E4\uC5D0\uAC8C
        \uC624\uD574\uBC1B\uB294 \uC778\uBB3C\uC774\uB2E4."
      - "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C \uBCF4\uD638\uD558\uAE30\uBCF4\uB2E4
        \uC2A4\uC2A4\uB85C \uC120\uD0DD\uD558\uAC8C \uB450\uB294 \uBC29\uC784\uC5D0
        \uAC00\uAE4C\uC6B4 \uD0DC\uB3C4\uB97C \uBCF4\uC778\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uCD5C\uC885 \uAE30\uC804"
      Choices:
      - "\uB370\uC6B0\uC2A4\uB294 \uB9C8\uC655 \uD1A0\uBC8C\uC774 \uB05D\uB098\uB3C4
        \uB8E8\uC774\uC2A4\uB97C \uACC4\uC18D \uC18D\uBC15\uD558\uACE0 \uB193\uC544\uC8FC\uC9C0
        \uC54A\uC73C\uB824\uACE0 \uD55C\uB2E4."
      - "\uB370\uC6B0\uC2A4\uB294 \uB9C8\uC655 \uD1A0\uBC8C\uC774 \uB05D\uB098\uBA74
        \uAD50\uB2E8\uC73C\uB85C \uB3CC\uC544\uAC00 \uB8E8\uC774\uC2A4\uC758 \uD68C\uBCF5\uC744
        \uC704\uD574 \uAE30\uB3C4\uD558\uB824 \uD55C\uB2E4."
      - "\uB370\uC6B0\uC2A4\uB294 \uB9C8\uC655 \uD1A0\uBC8C\uC774 \uB05D\uB098\uBA74
        \uB8E8\uC774\uC2A4\uB97C \uB5A0\uB098 \uAD50\uB2E8\uC758 \uC0AC\uBA85\uC73C\uB85C
        \uB3CC\uC544\uAC00\uB824 \uD55C\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uB2F9\uC2E0\uC744 \uD5A5\uD55C \uB0B4 \uAE30\uB3C4\uB294 \uC5B8\uC81C\uB098
        \uC2E0\uC131\uD588\uC2B5\uB2C8\uB2E4. \uB2E8 \uD55C \uBC88\uB3C4 \uC2E0\uC5D0\uAC8C
        \uB2FF\uC740 \uC801\uC740 \uC5C6\uC5C8\uC9C0\uB9CC."
      Appearance: "\uC9D9\uC740 \uB0A8\uBCF4\uB77C\uBE5B \uBA38\uB9AC\uC640 \uAC10\uAE34
        \uB4EF\uD55C \uB208\uB9E4, \uC5B4\uB450\uC6B4 \uBCF5\uC7A5\uC774 \uC870\uC6A9\uD558\uACE0
        \uD3D0\uC1C4\uC801\uC778 \uBD84\uC704\uAE30\uB97C \uB9CC\uB4E0\uB2E4."
      NarrativeBackground: "\uAE08\uC695\uC801\uC778 \uC0AC\uC81C\uC600\uC9C0\uB9CC
        \uB8E8\uC774\uC2A4\uB97C \uB9CC\uB098 \uBB34\uB108\uC84C\uACE0, \uC0AC\uB791\uC744
        \uC2E0\uC131\uD55C \uAD6C\uC6D0\uC73C\uB85C \uD3EC\uC7A5\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4."
      Personality: "\uC628\uD654\uD558\uACE0 \uC608\uC758 \uBC14\uB974\uC9C0\uB9CC,
        \uB8E8\uC774\uC2A4\uB97C \uC9C0\uD0A8\uB2E4\uB294 \uBA85\uBAA9\uC73C\uB85C
        \uD0C0\uC778\uC744 \uBC30\uC81C\uD558\uACE0 \uAD00\uACC4\uB97C \uD1B5\uC81C\uD55C\uB2E4."
      GimmickRelevance: "\uC790\uC2E0\uC774 \uC8FD\uC73C\uBA74 \uB8E8\uC774\uC2A4\uAE4C\uC9C0
        \uBB34\uB108\uC9C0\uB294 \uC5F0\uC778 A."
      CardIllustration: {fileID: 21300000, guid: 484145e7050ecd2428f736cb1261a825, type: 3}
    EpilogueLines:
    - "\uB098\uB294 \uC0AC\uB791\uC744 \uAE30\uB3C4\uB77C\uACE0 \uBD88\uB800\uB2E4."
    - "\uB8E8\uC774\uC2A4\uB97C \uC9C0\uD0A4\uB294 \uC77C\uC774 \uACE7 \uC633\uC740
      \uC77C\uC774\uB77C\uACE0 \uBBFF\uC5C8\uB2E4. \uB204\uAC00 \uADF8\uB97C \uD754\uB4E4\uB824
      \uD558\uBA74 \uB450\uB824\uC6E0\uACE0, \uB204\uAC00 \uADF8\uB97C \uB098 \uC5C6\uC774
      \uC6C3\uAC8C \uB9CC\uB4E4\uBA74 \uBD88\uC548\uD588\uB2E4. \uB098\uB294 \uBCF4\uD638\uD55C\uB2E4\uB294
      \uB9D0\uB85C \uB0B4 \uB450\uB824\uC6C0\uC744 \uAC10\uCDC4\uB2E4."
    - "\uD558\uC9C0\uB9CC \uC774\uC81C\uB294 \uC548\uB2E4."
    - "\uB8E8\uC774\uC2A4\uAC00 \uB0B4 \uACC1\uC5D0 \uBA38\uBB38 \uAC83\uC740 \uB098\uB97C
      \uC644\uC804\uD788 \uBBFF\uC5B4\uC11C\uB9CC\uC740 \uC544\uB2C8\uC5C8\uB2E4.
      \uADF8\uB294 \uD63C\uC790 \uC11C\uAE30\uC5D4 \uB108\uBB34 \uC9C0\uCCD0 \uC788\uC5C8\uACE0,
      \uB098\uB294 \uADF8 \uC9C0\uCE68\uC744 \uC0AC\uB791\uC774\uB77C\uB294 \uC774\uB984\uC73C\uB85C
      \uBC1B\uC544\uB4E4\uC600\uB2E4."
    - "\uD504\uB9AC\uB4DC\uAC00 \uB300\uC2E0 \uC8FD\uC73C\uB824 \uD55C \uB9C8\uC74C\uB3C4
      \uC774\uD574\uD55C\uB2E4. \uB204\uAD70\uAC00\uB97C \uC9C0\uD0A4\uACE0 \uC2F6\uC744
      \uB54C, \uC6B0\uB9AC\uB294 \uB108\uBB34 \uC27D\uAC8C \uC0C1\uB300\uC758 \uC120\uD0DD\uAE4C\uC9C0
      \uB300\uC2E0\uD558\uB824 \uD55C\uB2E4."
    - "\uBA54\uC774\uAC00 \uB05D\uC744 \uBCF4\uB824 \uD55C \uAC83\uB3C4, \uC0C8\uD134\uC774
      \uB05D\uC744 \uC758\uC2EC\uD55C \uAC83\uB3C4, \uACB0\uAD6D \uBAA8\uB450\uAC00
      \uAC19\uC740 \uC9C8\uBB38 \uC55E\uC5D0 \uC11C \uC788\uC5C8\uAE30 \uB54C\uBB38\uC774\uC5C8\uB2E4."
    - "\uC5B4\uB5BB\uAC8C \uD574\uC57C \uC0AC\uB791\uD558\uB294 \uC0AC\uB78C\uC744
      \uC783\uC9C0 \uC54A\uC744 \uC218 \uC788\uB294\uAC00."
    - "\uC5B4\uB5BB\uAC8C \uD574\uC57C \uC6B0\uB9AC\uAC00 \uC800\uC9C0\uB978 \uC77C\uC744
      \uACAC\uB51C \uC218 \uC788\uB294\uAC00."
    - "\uB098\uB294 \uB8E8\uC774\uC2A4\uB97C \uAC00\uB450\uC5C8\uB2E4."
    - "\uD558\uC9C0\uB9CC \uB098\uB9CC \uADF8\uB7F0 \uAC83\uC740 \uC544\uB2C8\uC5C8\uB2E4.
      \uC6B0\uB9AC\uB294 \uBAA8\uB450 \uAC01\uC790\uC758 \uBBFF\uC74C\uC73C\uB85C
      \uB204\uAD70\uAC00\uB97C \uBD99\uC7A1\uACE0 \uC788\uC5C8\uB2E4."
    - "\uC774\uC81C \uB0B4 \uAE30\uB3C4\uAC00 \uB2FF\uC544\uC57C \uD560 \uACF3\uC744
      \uC548\uB2E4."
    - "\uB8E8\uC774\uC2A4\uAC00 \uB0B4 \uACC1\uC5D0 \uB0A8\uAE30\uB97C \uBC14\uB77C\uB294
      \uAC83\uC774 \uC544\uB2C8\uB77C, \uADF8\uAC00 \uB098 \uC5C6\uC774\uB3C4 \uAC78\uC744
      \uC218 \uC788\uAE30\uB97C \uBC14\uB77C\uB294 \uAC83."
    - "\uADF8\uAC83\uC774 \uB108\uBB34 \uB2A6\uAC8C \uBC30\uC6B4 \uC0AC\uB791\uC774\uB77C
      \uD574\uB3C4, \uB9C8\uC9C0\uB9C9 \uBB38\uC7A5\uC5D0\uB294 \uADF8\uB807\uAC8C
      \uC4F0\uACE0 \uC2F6\uB2E4."
  - CharacterId: 4
    RequiredFragmentCount: 10
    CharacterFullName: "\uB8E8\uC774\uC2A4"
    CharacterRole: "(\uC5F0\uC778 B)"
    CharacterIcon: {fileID: 21300000, guid: 99bb6781bae90764faec8614b21f7e33, type: 3}
    ProfileItems:
    - Question: "\uACFC\uAC70 \uD575\uC2EC \uC0AC\uAC74"
      Choices:
      - "\uB8E8\uC774\uC2A4\uB294 \uC804\uC7C1\uACFC \uBC18\uBCF5\uB41C \uC120\uD0DD
        \uC18D\uC5D0\uC11C \uC815\uC2E0\uC801\uC73C\uB85C \uC644\uC804\uD788 \uC18C\uC9C4\uB41C
        \uC0C1\uD0DC\uB2E4."
      - "\uB8E8\uC774\uC2A4\uB294 \uC774\uC804 \uC804\uD22C\uC5D0\uC11C \uC785\uC740
        \uC911\uC0C1\uC744 \uD68C\uBCF5\uD558\uB294 \uC911\uC774\uB2E4."
      - "\uB8E8\uC774\uC2A4\uB294 \uC804\uC7C1\uACFC \uBC18\uBCF5\uB41C \uC120\uD0DD\uC5D0\uB3C4
        \uD06C\uAC8C \uC9C0\uCE58\uC9C0 \uC54A\uC740 \uB0C9\uC815\uD55C \uC804\uB7B5\uAC00\uC5D0
        \uAC00\uAE5D\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uD604\uC7AC \uC815\uCCB4/\uD589\uB3D9 \uC774\uC720"
      Choices:
      - "\uB8E8\uC774\uC2A4\uB294 \uB300\uBD80\uBD84\uC758 \uC0C1\uD669\uC744 \uC778\uC9C0\uD558\uACE0
        \uC788\uC9C0\uB9CC \uC758\uB3C4\uC801\uC73C\uB85C \uAC1C\uC785\uD558\uC9C0
        \uC54A\uB294\uB2E4."
      - "\uB8E8\uC774\uC2A4\uB294 \uCE58\uB8CC \uC911\uC774\uAE30 \uB54C\uBB38\uC5D0
        \uC6A9\uBCD1\uB2E8 \uB0B4\uBD80\uC758 \uC77C\uC5D0 \uB300\uD574 \uC790\uC138\uD788
        \uC54C\uC9C0 \uBABB\uD55C\uB2E4."
      - "\uB8E8\uC774\uC2A4\uB294 \uAC08\uB4F1\uC774 \uC0DD\uAE30\uBA74 \uCE68\uBB35\uD558\uAE30\uBCF4\uB2E4
        \uBA3C\uC800 \uAC1C\uC785\uD574 \uC0C1\uD669\uC744 \uC815\uB9AC\uD558\uB824
        \uD55C\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uAD00\uACC4 \uC778\uC2DD"
      Choices:
      - "\uB8E8\uC774\uC2A4\uB294 \uAC08\uB4F1\uACFC \uC120\uD0DD\uC744 \uD53C\uD558\uACE0
        \uD604\uC7AC\uC758 \uC548\uC815\uB41C \uC0C1\uD0DC\uC5D0 \uBA38\uBB34\uB974\uB824
        \uD55C\uB2E4."
      - "\uB8E8\uC774\uC2A4\uB294 \uD3C9\uD654\uC8FC\uC758\uC790\uB85C, \uC804\uD22C\uB098
        \uC2F8\uC6C0\uC744 \uCD5C\uB300\uD55C \uD53C\uD558\uB824\uACE0 \uD55C\uB2E4."
      - "\uB8E8\uC774\uC2A4\uB294 \uD604\uC7AC\uC758 \uC548\uC815\uC5D0 \uBA38\uBB34\uB974\uAE30\uBCF4\uB2E4
        \uC2B9\uB9AC\uB97C \uC704\uD574 \uBD88\uD3B8\uD55C \uC120\uD0DD\uB3C4 \uAC10\uC218\uD55C\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uC228\uACA8\uC9C4 \uC65C\uACE1"
      Choices:
      - "\uB8E8\uC774\uC2A4\uC5D0\uAC8C \uB370\uC6B0\uC2A4\uB294 \uC0AC\uB791\uC774\uBA74\uC11C
        \uB3D9\uC2DC\uC5D0 \uD604\uC2E4\uC744 \uD68C\uD53C\uD560 \uC218 \uC788\uAC8C
        \uD574\uC8FC\uB294 \uBD88\uC548\uC815\uD55C \uBC84\uD300\uBAA9\uC774\uB2E4."
      - "\uB8E8\uC774\uC2A4\uC5D0\uAC8C \uB370\uC6B0\uC2A4\uB294 \uC790\uC2E0\uC744
        \uCE58\uB8CC\uD574 \uC8FC\uB294 \uC0DD\uBA85\uC758 \uC740\uC778\uC774\uB2E4."
      - "\uB8E8\uC774\uC2A4\uB294 \uB370\uC6B0\uC2A4\uC5D0\uAC8C \uAE30\uB300\uC9C0
        \uC54A\uC73C\uBA70, \uB370\uC6B0\uC2A4\uC758 \uC9D1\uCC29\uC744 \uBD84\uBA85\uD788
        \uAC70\uBD80\uD558\uACE0 \uC788\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uCD5C\uC885 \uAE30\uC804"
      Choices:
      - "\uB8E8\uC774\uC2A4\uB294 \uACB0\uAD6D \uC2A4\uC2A4\uB85C \uC0B4\uC544\uAC00\uB824
        \uD558\uAE30\uBCF4\uB2E4 \uB204\uAD70\uAC00\uC5D0\uAC8C \uAE30\uB300\uC5B4
        \uBC84\uD2F0\uB294 \uC120\uD0DD\uC744 \uD558\uACE0 \uC788\uB2E4."
      - "\uB8E8\uC774\uC2A4\uB294 \uB9C8\uC655 \uD1A0\uBC8C\uC774 \uB05D\uB098\uBA74
        \uAD50\uB2E8\uC73C\uB85C \uB3CC\uC544\uAC00 \uCE58\uB8CC\uBC1B\uC73C\uB824
        \uD55C\uB2E4."
      - "\uACB0\uAD6D \uB8E8\uC774\uC2A4\uB294 \uB204\uAD70\uAC00\uC5D0\uAC8C \uAE30\uB300\uAE30\uBCF4\uB2E4
        \uC2A4\uC2A4\uB85C \uACB0\uB9D0\uC744 \uC8FC\uB3C4\uD558\uB824\uB294 \uC778\uBB3C\uC774\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uADF8\uB0E5 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uB9C8. \uC9C0\uAE08
        \uC774\uB300\uB85C\uAC00\u2026 \uB531 \uC88B\uC73C\uB2C8\uAE4C."
      Appearance: "\uCC3D\uBC31\uD55C \uD53C\uBD80\uC640 \uC605\uC740 \uC5F0\uBCF4\uB77C
        \uC7A5\uBC1C, \uD798 \uBE60\uC9C4 \uBC18\uCBE4 \uAC10\uAE34 \uB208\uC774
        \uC9C0\uCE58\uACE0 \uBB34\uAC10\uD55C \uBD84\uC704\uAE30\uB97C \uB9CC\uB4E0\uB2E4."
      NarrativeBackground: "\uC804\uC7C1\uACFC \uBC18\uBCF5\uB41C \uC120\uD0DD \uC18D\uC5D0\uC11C
        \uC644\uC804\uD788 \uC18C\uC9C4\uB418\uC5C8\uACE0, \uB370\uC6B0\uC2A4\uAC00
        \uB9CC\uB4E0 \uC548\uC804\uC9C0\uB300 \uC548\uC5D0 \uBA38\uBB34\uB974\uB824
        \uD55C\uB2E4."
      Personality: "\uC0C1\uD669\uC744 \uBAA8\uB974\uC9C0 \uC54A\uC9C0\uB9CC \uAC1C\uC785\uD558\uC9C0
        \uC54A\uACE0, \uAC08\uB4F1\uBCF4\uB2E4 \uC815\uC9C0\uC640 \uC548\uC815\uC744
        \uC120\uD0DD\uD55C\uB2E4."
      GimmickRelevance: "\uC9C1\uC811 \uAE30\uB2A5\uC740 \uC5C6\uC9C0\uB9CC, \uB370\uC6B0\uC2A4\uC758
        \uC8FD\uC74C\uACFC \uC5F0\uACB0\uB41C \uC5F0\uC778 B."
      CardIllustration: {fileID: 21300000, guid: 99bb6781bae90764faec8614b21f7e33, type: 3}
    EpilogueLines:
    - "\uB098\uB294 \uC544\uBB34\uAC83\uB3C4 \uBAA8\uB978 \uCC99\uD588\uB2E4."
    - "\uC0AC\uC2E4\uC740 \uB2E4 \uC54C\uACE0 \uC788\uC5C8\uB2E4. \uBA54\uC774\uAC00
      \uBB34\uB9AC\uD558\uACE0 \uC788\uB2E4\uB294 \uAC83\uB3C4, \uB370\uC6B0\uC2A4\uAC00
      \uB098\uB97C \uBD99\uC7A1\uACE0 \uC788\uB2E4\uB294 \uAC83\uB3C4, \uC0C8\uD134\uC758
      \uC9C8\uBB38\uC774 \uBD88\uD3B8\uD558\uC9C0\uB9CC \uD2C0\uB9AC\uC9C0 \uC54A\uC558\uB2E4\uB294
      \uAC83\uB3C4. \uB2E4\uB9CC \uC6C0\uC9C1\uC774\uBA74 \uBB34\uC5B8\uAC00\uB97C
      \uC120\uD0DD\uD574\uC57C \uD588\uACE0, \uC120\uD0DD\uD558\uBA74 \uB204\uAD70\uAC00\uB97C
      \uC783\uC744 \uAC83 \uAC19\uC558\uB2E4."
    - "\uADF8\uB798\uC11C \uB098\uB294 \uAE30\uB300\uC5B4 \uC788\uC5C8\uB2E4."
    - "\uB370\uC6B0\uC2A4\uC758 \uACC1\uC740 \uC870\uC6A9\uD588\uACE0, \uADF8 \uC548\uC5D0\uC11C\uB294
      \uC138\uC0C1\uC774 \uC870\uAE08 \uBA40\uC5B4\uC84C\uB2E4. \uB098\uB294 \uADF8
      \uD3C9\uC628\uC744 \uC0AC\uB791\uC774\uB77C\uACE0 \uC0DD\uAC01\uD588\uB2E4.
      \uD558\uC9C0\uB9CC \uC774\uC81C\uB294 \uC548\uB2E4. \uADF8\uB140 \uC5ED\uC2DC
      \uB098\uC5D0\uAC8C \uAE30\uB300\uACE0 \uC788\uC5C8\uB2E4. \uC6B0\uB9AC\uB294
      \uC11C\uB85C\uB97C \uC9C0\uD0A8 \uAC83\uC774 \uC544\uB2C8\uB77C, \uC11C\uB85C\uB97C
      \uBCBD\uC73C\uB85C \uC0BC\uC544 \uBC84\uD2F4 \uAC83\uC778\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    - "\uBA54\uC774\uB294 \uB05D\uAE4C\uC9C0 \uAC00\uC57C \uC0B4\uC544\uB0A8\uC744
      \uC218 \uC788\uC5C8\uACE0, \uD504\uB9AC\uB4DC\uB294 \uB300\uC2E0 \uC8FD\uC5B4\uC57C
      \uB204\uAD70\uAC00\uB97C \uC9C0\uD0AC \uC218 \uC788\uB2E4\uACE0 \uBBFF\uC5C8\uB2E4."
    - "\uC5D4\uBE44\uB294 \uC6B0\uB9AC \uC0AC\uC774\uC5D0 \uB4E4\uC5B4\uC624\uACE0
      \uC2F6\uC5B4 \uD558\uBA74\uC11C\uB3C4, \uC790\uC2E0\uC774 \uC6B0\uB9AC\uB97C
      \uB9DD\uAC00\uB728\uB9B4 \uAC70\uB77C\uACE0 \uB450\uB824\uC6CC\uD588\uB2E4."
    - "\uD1A0\uB2C8\uB294 \uBB34\uB108\uC9C0\uB294 \uC21C\uAC04\uB9CC \uBCF4\uB824
      \uD588\uC9C0\uB9CC, \uC5B4\uCA4C\uBA74 \uADF8\uB140\uB3C4 \uD3C9\uC628\uD55C
      \uC5BC\uAD74 \uB4A4\uC758 \uC9C4\uC2EC\uC744 \uC54C\uACE0 \uC2F6\uC5C8\uB358
      \uAC83\uC77C\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    - "\uB098\uB294 \uBAA8\uB450\uB97C \uC774\uD574\uD588\uB2E4\uACE0 \uB9D0\uD560
      \uC218\uB294 \uC5C6\uB2E4."
    - "\uD558\uC9C0\uB9CC \uC774\uC81C\uB294 \uC548\uB2E4."
    - "\uC6B0\uB9AC\uB294 \uAC01\uC790 \uB2E4\uB978 \uBC29\uC2DD\uC73C\uB85C \uBC84\uD2F0\uACE0
      \uC788\uC5C8\uB2E4."
    - "\uB098\uB9CC \uBA48\uCDB0 \uC788\uC5C8\uB358 \uAC83\uC774 \uC544\uB2C8\uB2E4."
    - "\uBAA8\uB450\uAC00 \uC790\uAE30 \uC790\uB9AC\uC5D0\uC11C, \uBB34\uB108\uC9C0\uC9C0
      \uC54A\uC73C\uB824\uACE0 \uC560\uC4F0\uACE0 \uC788\uC5C8\uB2E4."
    - "\uADF8 \uC0AC\uC2E4\uC744 \uC54C\uC558\uB2E4\uBA74, \uB098\uB294 \uC870\uAE08\uC740
      \uC77C\uCC0D \uAC78\uC5B4\uBCFC \uC218 \uC788\uC5C8\uC744\uAE4C."
  - CharacterId: 5
