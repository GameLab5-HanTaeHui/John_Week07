      - "\uB8E8\uC774\uC2A4 \uC911\uC2EC\uC73C\uB85C"
      - "\uC5ED\uD560\uC5D0 \uB530\uB77C"
      CorrectChoiceIndex: 1
      RequiredFragmentId: 
    - Question: "\uBCF4\uD638\uC758 \uBCF8\uC9C8"
      Choices:
      - "\uC548\uC804\uC744 \uC704\uD55C \uC120\uD0DD"
      - "\uC18C\uC720\uC5D0 \uAC00\uAE4C\uC6B4 \uC9D1\uCC29"
      - "\uC0AC\uB791\uC758 \uD45C\uD604"
      CorrectChoiceIndex: 1
      RequiredFragmentId: 
    - Question: "\uB8E8\uC774\uC2A4 \uC5C6\uC774 \uC138\uACC4\uB97C \uC720\uC9C0\uD560
        \uC218 \uC788\uB294\uAC00"
      Choices:
      - "\uD560 \uC218 \uC788\uB2E4"
      - "\uD560 \uC218 \uC5C6\uB2E4"
      - "\uC2DC\uB3C4\uD574\uBCF8 \uC801 \uC5C6\uB2E4"
      CorrectChoiceIndex: 1
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uB9D0\uC758 \uC774\uB984\uC774 \uBB34\uC5C7\uC774\uB4E0, \uC81C\uAC00
        \uC9C0\uCF1C\uC57C \uD55C\uB2E4\uB294 \uC0AC\uC2E4\uC740 \uBCC0\uD558\uC9C0
        \uC54A\uC2B5\uB2C8\uB2E4."
      Appearance: "\uC870\uC6A9\uD558\uACE0 \uB2E8\uC815\uD55C \uC678\uBAA8. \uB8E8\uC774\uC2A4\uB97C
        \uBC14\uB77C\uBCFC \uB54C\uB9CC \uB208\uBE5B\uC774 \uB2EC\uB77C\uC9C4\uB2E4."
      NarrativeBackground: "\uB8E8\uC774\uC2A4\uB97C \uC0B6\uC758 \uC758\uBBF8\uC774\uC790
        \uAD6C\uC6D0\uC73C\uB85C \uC2E0\uC131\uD654\uD558\uBA70 \uC0B4\uC544\uC654\uB2E4."
      Personality: "\uCC28\uBD84\uD558\uACE0 \uC608\uC758 \uBC14\uB974\uB098 \uB8E8\uC774\uC2A4\uC5D0
        \uAD00\uD574\uC11C\uB294 \uD0C0\uD611\uC774 \uC5C6\uB2E4."
      GimmickRelevance: "\uBCF4\uD638\uB77C\uB294 \uC774\uB984\uC758 \uACE0\uB9BD\uC744
        \uAD6C\uD604\uD558\uB294 \uCE90\uB9AD\uD130."
      CardIllustration: {fileID: 21300000, guid: 484145e7050ecd2428f736cb1261a825, type: 3}
    EpilogueText: "\uB8E8\uC774\uC2A4\uAC00 \uC228\uC744 \uACE0\uB974\uB294 \uC18C\uB9AC\uB9CC
      \uB4E4\uB9AC\uBA74, \uC138\uC0C1\uC758 \uC18C\uB780\uC740 \uC7A0\uC2DC \uBA40\uC5B4\uC9C4\uB2E4."
  - CharacterId: 4
    RequiredFragmentCount: 5
