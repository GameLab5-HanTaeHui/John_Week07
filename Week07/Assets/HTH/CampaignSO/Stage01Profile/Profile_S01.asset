      - "\uB0A8\uACA8\uC9C4 \uC0AC\uB78C"
      CorrectChoiceIndex: 2
      RequiredFragmentId: 
    - Question: "\uC774\uB3D9\uC774 \uB0A8\uAE34 \uAC83"
      Choices:
      - "\uC0DD\uC874"
      - "\uC8C4\uCC45\uAC10"
      - "\uAE30\uC5B5"
      CorrectChoiceIndex: 1
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uBA3C\uC800 \uC6C0\uC9C1\uC778 \uC0AC\uB78C\uC740 \uC0B0\uB2E4.
        \uB4A4\uC5D0 \uB0A8\uC740 \uC0AC\uB78C\uC740 \uAE30\uC5B5\uC774 \uB41C\uB2E4."
      Appearance: "\uB0A0\uCE74\uB85C\uC6B4 \uB208\uBE5B. \uD56D\uC0C1 \uB4A4\uB97C
        \uD655\uC778\uD558\uB294 \uC2B5\uAD00\uC774 \uC788\uB2E4."
      NarrativeBackground: "\uC774\uB3D9\uC774 \uB0A8\uAE34 \uC8FD\uC74C\uC758 \uAE30\uC5B5\uC744
        \uC548\uACE0 \uC0B4\uC544\uAC04\uB2E4."
      Personality: "\uC758\uC2EC\uC774 \uB9CE\uACE0 \uC9C1\uC811\uC801\uC774\uB2E4.
        \uD76C\uC0DD \uAD6C\uC870 \uC790\uCCB4\uC5D0 \uBD84\uB178\uD55C\uB2E4."
      GimmickRelevance: "\uBC30\uD68C\uC790 \uD6A8\uACFC\uC640 \uC5F0\uAD00\uB41C
        \uCE90\uB9AD\uD130. \uB4A4\uC5D0 \uB0A8\uACA8\uC9C0\uB294 \uC0AC\uB78C\uC758
        \uC2DC\uC120\uC744 \uB300\uD45C\uD55C\uB2E4."
      CardIllustration: {fileID: 21300000, guid: 8808ade9a103ff54891d0fb0c80bdd0e, type: 3}
    EpilogueText: "\uB098\uB294 \uD654\uAC00 \uB09C \uAC8C \uC544\uB2C8\uB2E4. \uB2E4\uB9CC
      \uB610 \uB204\uAD70\uAC00\uB97C \uB0A8\uACA8 \uB450\uACE0 \uAC00\uB294 \uBC1C\uAC78\uC74C\uC744
      \uACAC\uB51C \uC218 \uC5C6\uC744 \uBFD0\uC774\uB2E4."
