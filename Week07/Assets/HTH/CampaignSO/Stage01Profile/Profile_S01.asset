        \uC77C\uD588\uC73C\uBA70, \uAE08\uAE30\uB41C \uC694\uB9AC\uC5D0 \uC911\uB3C5\uB418\uC5B4
        \uCD94\uBC29\uB2F9\uD588\uB2E4."
      - "\uD1A0\uB2C8\uB294 \uBC30\uB97C \uCC44\uC6B0\uAC70\uB098 \uC695\uAD6C\uB97C
        \uD574\uC18C\uD558\uAE30 \uC704\uD574 \uCDA9\uB3D9\uC801\uC73C\uB85C \uC0B4\uC778\uC744
        \uC800\uC9C0\uB978\uB2E4."
      - "\uD1A0\uB2C8\uB294 \uC8FD\uC74C\uACFC \uC804\uD22C\uC5D0 \uC775\uC219\uD558\uC9C0
        \uC54A\uC740 \uC21C\uC218\uD55C \uC544\uC774\uB85C, \uC0AC\uAC74\uC5D0 \uC6B0\uC5F0\uD788
        \uD718\uB9D0\uB838\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uD604\uC7AC \uC815\uCCB4/\uD589\uB3D9 \uC774\uC720"
      Choices:
      - "\uD1A0\uB2C8\uB294 \uAC89\uC73C\uB85C \uADC0\uC5FD\uACE0 \uD574\uB9D1\uC740
        \uB2E8\uC21C\uD55C \uC0AC\uB78C\uCC98\uB7FC \uD589\uB3D9\uD55C\uB2E4."
      - "\uD1A0\uB2C8\uB294 \uC0DD\uAC01\uD558\uB294 \uBC29\uC2DD\uC774 \uB0A8\uB4E4\uACFC
        \uB2E4\uB974\uACE0, \uB2E8\uC21C\uD558\uBA70 \uCF8C\uB77D\uC8FC\uC758\uC801\uC774\uB2E4."
      - "\uD1A0\uB2C8\uC758 \uD574\uB9D1\uC740 \uD0DC\uB3C4\uB294 \uACC4\uC0B0\uB41C
        \uAC00\uBA74\uC774 \uC544\uB2C8\uB77C \uD0C0\uACE0\uB09C \uCC9C\uC9C4\uD568\uC5D0
        \uAC00\uAE5D\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uAD00\uACC4 \uC778\uC2DD"
      Choices:
      - "\uD1A0\uB2C8\uB294 \uC0AC\uB78C\uB4E4 \uC0AC\uC774\uC758 \uAC08\uB4F1 \uD750\uB984\uACFC
        \uAC10\uC815, \uAD00\uACC4 \uBCC0\uD654\uB97C \uAD00\uCC30\uD55C \uB4A4 \uB300\uC0C1\uC744
        \uC815\uD574 \uC0B4\uC778\uD55C\uB2E4."
      - "\uD1A0\uB2C8\uB294 \uAE30\uD68C\uAC00 \uC0DD\uAE30\uBA74 \uC989\uD765\uC801\uC73C\uB85C
        \uC0B4\uC778\uC744 \uC800\uC9C0\uB978\uB2E4."
      - "\uD1A0\uB2C8\uB294 \uC0AC\uB78C\uB4E4\uC758 \uAC10\uC815 \uBCC0\uD654\uB97C
        \uAD00\uCC30\uD558\uAE30\uBCF4\uB2E4 \uAC08\uB4F1\uC744 \uC774\uD574\uD558\uC9C0
        \uBABB\uD574 \uB4A4\uB2A6\uAC8C \uBC18\uC751\uD55C\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uC228\uACA8\uC9C4 \uC65C\uACE1"
      Choices:
      - "\uD1A0\uB2C8\uB294 \uC8FD\uC74C\uBFD0\uB9CC \uC544\uB2C8\uB77C, \uADF8 \uC8FD\uC74C\uC774
        \uC8FC\uBCC0\uC5D0 \uC5B4\uB5A4 \uBCC0\uD654\uB97C \uB9CC\uB4E4\uC5B4 \uB0B4\uB294\uC9C0\uB3C4
        \uC911\uC694\uD558\uAC8C \uC5EC\uAE34\uB2E4."
      - "\uD1A0\uB2C8\uB294 \uC0B4\uC778 \uD6C4\uC5D0\uB294 \uB300\uC0C1\uC5D0 \uB300\uD574
        \uAE08\uBC29 \uC78A\uC5B4\uBC84\uB9B0\uB2E4."
      - "\uD1A0\uB2C8\uB294 \uC8FD\uC74C \uC774\uD6C4\uC758 \uAD00\uACC4 \uBCC0\uD654\uC5D0
        \uAD00\uC2EC\uC774 \uC5C6\uACE0, \uC624\uD788\uB824 \uADF8 \uC0C1\uD669\uC5D0
        \uC27D\uAC8C \uCDA9\uACA9\uBC1B\uB294\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uCD5C\uC885 \uAE30\uC804"
      Choices:
      - "\uD1A0\uB2C8\uB294 \uAE08\uAE30\uB41C \uC694\uB9AC\uC758 \uC7AC\uB8CC\uB85C\uC11C
        \uC808\uB9DD\uD55C \uC0AC\uB78C\uC758 \uC2EC\uC7A5\uC744 \uC6D0\uD574 \uC0B4\uC778\uC744
        \uC800\uC9C0\uB978\uB2E4."
      - "\uD1A0\uB2C8\uB294 \uC0AC\uB78C\uC744 \uC8FD\uC774\uB294 \uD589\uC704 \uC790\uCCB4\uC5D0\uC11C
        \uC990\uAC70\uC6C0\uC744 \uB290\uB07C\uB294 \uC778\uBB3C\uC774\uB2E4."
      - "\uACB0\uAD6D \uD1A0\uB2C8\uB294 \uC0AC\uAC74\uC744 \uC124\uACC4\uD558\uB294
        \uC778\uBB3C\uC774 \uC544\uB2C8\uB77C \uC6A9\uBCD1\uB2E8\uC774 \uC9C0\uCF1C\uC57C
        \uD560 \uC21C\uC218\uD55C \uD53C\uD574\uC790\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uC0AC\uB78C\uC740 \uBB34\uB108\uC9C8 \uB54C \uAC00\uC7A5 \uC194\uC9C1\uD55C
        \uB9DB\uC744 \uB0B4. \uADF8\uB798\uC11C \uB098\uB294 \uAE30\uB2E4\uB9AC\uB294
        \uAC8C \uC88B\uC544."
      Appearance: "\uB465\uADFC \uAE08\uBC1C \uCEEC\uACFC \uC0C8\uD558\uC580 \uBAA8\uC790,
        \uCEE4\uB2E4\uB780 \uD558\uB298\uBE5B \uB208\uC774 \uC0AC\uB791\uC2A4\uB7FD\uACE0
        \uCC9C\uC9C4\uD55C \uCCAB\uC778\uC0C1\uC744 \uC900\uB2E4."
      NarrativeBackground: "\uB9C8\uC655\uC131\uC758 \uC694\uB9AC\uC0AC\uC600\uC73C\uBA70,
        \uC778\uAC04\uC758 \uC808\uB9DD\uACFC \uAD00\uACC4\uC758 \uBD95\uAD34\uAC00
        \uB9CC\uB4E4\uC5B4\uB0B4\uB294 \uAE08\uAE30\uC758 \uB9DB\uC5D0 \uC911\uB3C5\uB418\uC5C8\uB2E4."
      Personality: "\uAC08\uB4F1\uC744 \uB9D0\uB9AC\uAE30\uBCF4\uB2E4 \uC9C0\uCF1C\uBCF4\uBA70,
        \uC0AC\uAC74\uC774 \uAC00\uC7A5 \uADF9\uC801\uC778 \uD615\uD0DC\uB85C \uC644\uC131\uB418\uAE30\uB97C
        \uAE30\uB2E4\uB9B0\uB2E4."
      GimmickRelevance: "\uAC19\uC740 \uAD6C\uC5ED\uC758 \uB204\uAD70\uAC00\uB97C
        \uC8FD\uC774\uACE0, \uB0A8\uC740 \uAD00\uACC4\uC758 \uBD95\uAD34\uAE4C\uC9C0
        \uC990\uAE30\uB294 \uC0B4\uC778\uC790."
      CardIllustration: {fileID: 21300000, guid: b084f8f70a654704f8aac460b6217ca0, type: 3}
    EpilogueLines:
    - "\uB098\uB294 \uC0AC\uB78C\uB4E4\uC774 \uBB34\uB108\uC9C0\uB294 \uC21C\uAC04\uC744
      \uC88B\uC544\uD588\uB2E4."
    - "\uADF8\uB54C\uAC00 \uAC00\uC7A5 \uC194\uC9C1\uD558\uB2E4\uACE0 \uC0DD\uAC01\uD588\uB2E4.
      \uC6C3\uB294 \uC5BC\uAD74\uC774 \uAE68\uC9C0\uACE0, \uC228\uACA8\uB454 \uB9D0\uC774
      \uD758\uB7EC\uB098\uC624\uACE0, \uAD00\uACC4\uAC00 \uB354\uB294 \uC608\uC05C
      \uBAA8\uC591\uC744 \uC720\uC9C0\uD558\uC9C0 \uBABB\uD558\uB294 \uC21C\uAC04.
      \uB098\uB294 \uADF8 \uD750\uB984\uC744 \uC9C0\uCF1C\uBCF4\uB2E4\uAC00, \uAC00\uC7A5
      \uC9C4\uD55C \uBD80\uBD84\uC744 \uACE8\uB790\uB2E4."
    - "\uD558\uC9C0\uB9CC \uC774\uC81C\uB294 \uC870\uAE08 \uC54C \uAC83 \uAC19\uB2E4."
    - "\uBA54\uC774\uAC00 \uB05D\uC744 \uBCF4\uB824 \uD588\uB358 \uAC74 \uC695\uC2EC\uB9CC\uC740
      \uC544\uB2C8\uC5C8\uB2E4. \uADF8\uB294 \uB05D\uAE4C\uC9C0 \uAC00\uC9C0 \uC54A\uC73C\uBA74
      \uC790\uC2E0\uC774 \uC0B4\uC544\uB0A8\uC740 \uC774\uC720\uB97C \uC783\uC5B4\uBC84\uB9B4
      \uAC83 \uAC19\uC558\uB358 \uAC83\uC774\uB2E4."
    - "\uB8E8\uC774\uC2A4\uAC00 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC740
      \uAC74 \uBE44\uAC81\uD574\uC11C\uB9CC\uC740 \uC544\uB2C8\uC5C8\uB2E4. \uB9D0\uC744
      \uD558\uBA74 \uB204\uAD70\uAC00\uB97C \uC120\uD0DD\uD574\uC57C \uD588\uACE0,
      \uADF8\uB294 \uB354 \uC783\uC744 \uD798\uC774 \uC5C6\uC5C8\uB2E4."
    - "\uD504\uB9AC\uB4DC\uAC00 \uB300\uC2E0 \uC8FD\uC73C\uB824 \uD55C \uAC83\uB3C4,
      \uC0C8\uD134\uC774 \uACC4\uC18D \uC9C8\uBB38\uD55C \uAC83\uB3C4, \uBAA8\uB450
      \uBB34\uC5B8\uAC00\uAC00 \uB354 \uB9DD\uAC00\uC9C0\uAE30 \uC804\uC5D0 \uB9C9\uACE0
      \uC2F6\uC5B4\uC11C\uC600\uB2E4."
    - "\uB098\uB294 \uADF8 \uB9C8\uC74C\uB4E4\uC744 \uB9DB\uC73C\uB85C\uB9CC \uBCF4\uC558\uB2E4."
    - "\uC2AC\uD514\uC740 \uC4F0\uACE0, \uC9C8\uD22C\uB294 \uC2DC\uACE0, \uC0AC\uB791\uC740
      \uB108\uBB34 \uC624\uB798 \uB053\uC774\uBA74 \uC9C8\uCC99\uD574\uC9C4\uB2E4\uACE0
      \uC0DD\uAC01\uD588\uB2E4."
    - "\uADF8\uB7F0\uB370 \uC544\uB2C8\uC5C8\uB2E4."
    - "\uADF8\uAC74 \uB9DB\uC774 \uC544\uB2C8\uB77C, \uAC01\uC790\uAC00 \uBD99\uC7A1\uC740
      \uC0B6\uC758 \uBC29\uC2DD\uC774\uC5C8\uB2E4."
    - "\uB098\uB294 \uAC08\uB4F1\uC744 \uB9D0\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    - "\uC65C\uB0D0\uD558\uBA74 \uB05D\uC744 \uBCF4\uACE0 \uC2F6\uC5C8\uAE30 \uB54C\uBB38\uC774\uB2E4."
    - "\uD558\uC9C0\uB9CC \uC774\uC81C\uB294 \uC548\uB2E4. \uC5B4\uB5A4 \uC774\uC57C\uAE30\uB294
      \uB05D\uAE4C\uC9C0 \uB053\uC5EC\uC57C \uC644\uC131\uB418\uB294 \uAC83\uC774
      \uC544\uB2C8\uB77C, \uB204\uAD70\uAC00 \uBD88\uC744 \uAEBC\uC918\uC57C \uC9C0\uCF1C\uC9C0\uB294
      \uAC83\uC774\uC5C8\uB2E4."
    - "\uC6B0\uB9AC\uAC00 \uAC19\uC740 \uC2DD\uD0C1\uC5D0 \uC549\uC744 \uC218 \uC788\uC5C8\uB2E4\uBA74,
      \uB098\uB294 \uC870\uAE08 \uB35C \uAD76\uC8FC\uB838\uC744\uAE4C."
  - CharacterId: 6
    RequiredFragmentCount: 10
    CharacterFullName: "\uD504\uB9AC\uB4DC"
    CharacterRole: "(\uD76C\uC0DD\uC591)"
    CharacterIcon: {fileID: 21300000, guid: 80338f499f9f79640aa74de2ef72030c, type: 3}
    ProfileItems:
    - Question: "\uACFC\uAC70 \uD575\uC2EC \uC0AC\uAC74"
      Choices:
      - "\uD504\uB9AC\uB4DC\uB294 \uACFC\uAC70\uC758 \uACBD\uD5D8\uC744 \uD1B5\uD574
        \uC790\uC2E0\uC774 \uBAA8\uB4E0 \uC77C\uC744 \uC9C1\uC811 \uC9CA\uC5B4\uC838\uC57C
        \uD55C\uB2E4\uB294 \uD655\uACE0\uD55C \uC2E0\uB150\uC744 \uAC16\uAC8C \uB418\uC5C8\uB2E4."
      - "\uD504\uB9AC\uB4DC\uB294 \uACFC\uAC70\uC758 \uC8C4\uCC45\uAC10 \uB54C\uBB38\uC5D0
        \uC790\uAE30\uD76C\uC0DD\uC744 \uBC18\uBCF5\uD558\uAC8C \uB418\uC5C8\uB2E4."
      - "\uD504\uB9AC\uB4DC\uB294 \uACFC\uAC70\uC758 \uACBD\uD5D8 \uC774\uD6C4 \uCC45\uC784\uC744
        \uC9CA\uC5B4\uC9C0\uAE30\uBCF4\uB2E4 \uC704\uD5D8\uD55C \uC120\uD0DD\uC744
        \uD53C\uD558\uB824 \uD55C\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uD604\uC7AC \uC815\uCCB4/\uD589\uB3D9 \uC774\uC720"
      Choices:
      - "\uD504\uB9AC\uB4DC\uB294 \uB3D9\uB8CC\uB97C \uC9C0\uD0A4\uAE30 \uC704\uD574
        \uD56D\uC0C1 \uC2A4\uC2A4\uB85C\uB97C \uD76C\uC0DD\uD558\uB824 \uD55C\uB2E4."
      - "\uD504\uB9AC\uB4DC\uB294 \uB3D9\uB8CC\uB4E4\uC744 \uBBFF\uC9C0 \uBABB\uD574
        \uC790\uC9C4\uD574\uC11C \uB098\uC120\uB2E4."
      - "\uD504\uB9AC\uB4DC\uB294 \uB3D9\uB8CC\uB97C \uC9C0\uD0A4\uAE30 \uC704\uD574
        \uC790\uC2E0\uC744 \uB0B4\uC138\uC6B0\uAE30\uBCF4\uB2E4 \uB4A4\uC5D0\uC11C
        \uC0C1\uD669\uC744 \uC9C0\uCF1C\uBCF4\uB824 \uD55C\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uAD00\uACC4 \uC778\uC2DD"
      Choices:
      - "\uADF8\uB7EC\uB098 \uD504\uB9AC\uB4DC\uB294 \uC810\uC810 \uC120\uD0DD\uACFC
        \uCC45\uC784\uC744 \uD63C\uC790 \uB5A0\uC548\uB294 \uBC29\uC2DD\uC5D0 \uC775\uC219\uD574\uC9C4\uB2E4."
      - "\uD504\uB9AC\uB4DC\uB294 \uC120\uD0DD\uACFC \uCC45\uC784\uC744 \uD63C\uC790
        \uB5A0\uC548\uB294 \uBC29\uC2DD\uC5D0 \uBD80\uB2F4\uC744 \uB290\uB07C\uACE0
        \uC788\uB2E4."
      - "\uD504\uB9AC\uB4DC\uB294 \uC120\uD0DD\uACFC \uCC45\uC784\uC744 \uD63C\uC790
        \uB5A0\uC548\uAE30\uBCF4\uB2E4 \uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C \uB118\uAE30\uB294
        \uB370 \uC775\uC219\uD558\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uC228\uACA8\uC9C4 \uC65C\uACE1"
      Choices:
      - "\uD504\uB9AC\uB4DC\uB294 \uD0C0\uC778\uC744 \uC704\uD55C\uB2E4\uACE0 \uBBFF\uC9C0\uB9CC,
        \uC2E4\uC81C\uB85C\uB294 \uD0C0\uC778\uC758 \uC120\uD0DD\uAD8C\uAE4C\uC9C0
        \uB300\uC2E0\uD558\uB824 \uD55C\uB2E4."
      - "\uD504\uB9AC\uB4DC\uB294 \uBAA8\uB450\uC758 \uC758\uACAC\uC744 \uB300\uD45C\uD558\uC5EC
        \uACB0\uB2E8\uD558\uACE0 \uD76C\uC0DD\uD55C\uB2E4."
      - "\uD504\uB9AC\uB4DC\uB294 \uD0C0\uC778\uC758 \uC120\uD0DD\uC744 \uC874\uC911\uD558\uAE30
        \uB54C\uBB38\uC5D0 \uC2A4\uC2A4\uB85C \uAC1C\uC785\uD558\uC9C0 \uC54A\uB294
        \uAC83\uC774 \uC633\uB2E4\uACE0 \uBBFF\uB294\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uCD5C\uC885 \uAE30\uC804"
      Choices:
      - "\uD504\uB9AC\uB4DC\uB294 \uACB0\uAD6D \u201C\uB0B4\uAC00 \uD76C\uC0DD\uD574\uC57C
        \uBAA8\uB450\uAC00 \uC0B0\uB2E4\u201D\uB294 \uC798\uBABB\uB41C \uD655\uC2E0\uC5D0
        \uC0AC\uB85C\uC7A1\uD78C \uC0C1\uD0DC\uB2E4."
      - "\uD504\uB9AC\uB4DC\uB294 \uACB0\uAD6D \uACFC\uD558\uAC8C \uC120\uD560 \uBFD0,
        \uBCF8\uC9C8\uC801\uC73C\uB85C\uB294 \uC21C\uC218\uD55C \uD76C\uC0DD\uC790\uC774\uB2E4."
      - "\uACB0\uAD6D \uD504\uB9AC\uB4DC\uB294 \uD76C\uC0DD\uC744 \uB450\uB824\uC6CC\uD574
        \uD55C \uAC78\uC74C \uBB3C\uB7EC\uC11C\uB294 \uD604\uC2E4\uC8FC\uC758\uC790\uC5D0
        \uAC00\uAE5D\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uB204\uAD70\uAC00\uB294 \uC81C\uBB3C\uC774 \uB418\uC5B4\uC57C
        \uD55C\uB2E4\uBA74, \uADF8 \uC790\uB9AC\uB294 \uC5B8\uC81C\uB098 \uB098\uC5EC\uC57C
        \uD55C\uB2E4."
      Appearance: "\uC9E7\uC740 \uC8FC\uD669\uBE5B \uBA38\uB9AC\uC640 \uC120\uBA85\uD55C
        \uB179\uC548, \uC790\uC2E0\uAC10 \uC788\uB294 \uBBF8\uC18C\uAC00 \uBC1D\uACE0
        \uBBFF\uC74C\uC9C1\uD55C \uC778\uC0C1\uC744 \uC900\uB2E4."
      NarrativeBackground: "\uC544\uBC84\uC9C0\uC758 \uC8FD\uC74C\uC774 \uC22D\uACE0\uD55C
        \uD76C\uC0DD\uC774 \uC544\uB2C8\uC5C8\uC74C\uC744 \uAE68\uB2EB\uACE0, \uC774\uD6C4
        \uBAA8\uB4E0 \uCC45\uC784\uC744 \uC790\uC2E0\uC774 \uBA3C\uC800 \uC9CA\uC5B4\uC9C0\uB824
        \uD55C\uB2E4."
      Personality: "\uC120\uD558\uACE0 \uBBFF\uC74C\uC9C1\uD558\uC9C0\uB9CC, \uD0C0\uC778\uC744
        \uC9C0\uD0A8\uB2E4\uB294 \uBA85\uBD84\uC73C\uB85C \uC120\uD0DD\uACFC \uCC45\uC784\uC744
        \uD63C\uC790 \uB3C5\uC810\uD558\uB824 \uD55C\uB2E4."
      GimmickRelevance: "\uB2E4\uB978 \uC778\uBB3C\uC774 \uC8FD\uC73C\uB824 \uD560
        \uB54C \uB300\uC2E0 \uC8FD\uB294 \uD76C\uC0DD\uC591."
      CardIllustration: {fileID: 21300000, guid: 80338f499f9f79640aa74de2ef72030c, type: 3}
    EpilogueLines:
    - "\uB204\uAD70\uAC00 \uC81C\uBB3C\uC774 \uB418\uC5B4\uC57C \uD55C\uB2E4\uBA74,
      \uADF8 \uC790\uB9AC\uB294 \uC5B8\uC81C\uB098 \uB098\uC5EC\uC57C \uD55C\uB2E4\uACE0
      \uBBFF\uC5C8\uB2E4."
    - "\uADF8\uB807\uAC8C \uBBFF\uC73C\uBA74 \uC26C\uC6E0\uB2E4. \uB204\uAD70\uAC00
      \uC8FD\uC5B4\uC57C \uD558\uB294 \uC0C1\uD669\uC5D0\uC11C \uB0B4\uAC00 \uBA3C\uC800
      \uB098\uC11C\uBA74, \uC801\uC5B4\uB3C4 \uB204\uAD6C\uB97C \uC0B4\uB9B4\uC9C0
      \uACE0\uB974\uC9C0 \uC54A\uC544\uB3C4 \uB410\uB2E4. \uB098\uB294 \uADF8\uAC83\uC744
      \uC120\uC758\uB77C\uACE0 \uC0DD\uAC01\uD588\uB2E4."
    - "\uD558\uC9C0\uB9CC \uC774\uC81C\uB294 \uC548\uB2E4."
    - "\uBA54\uC774\uB3C4, \uC0C8\uD134\uB3C4, \uB370\uC6B0\uC2A4\uB3C4, \uB8E8\uC774\uC2A4\uB3C4
      \uBAA8\uB450 \uAC01\uC790\uC758 \uBC29\uC2DD\uC73C\uB85C \uB204\uAD70\uAC00\uB97C
      \uC0B4\uB9AC\uB824 \uD588\uB2E4."
    - "\uBA54\uC774\uB294 \uBAA8\uB450\uB97C \uB05D\uAE4C\uC9C0 \uB370\uB824\uAC00\uC57C
      \uC6B0\uB9AC\uAC00 \uD5DB\uB418\uC9C0 \uC54A\uB294\uB2E4\uACE0 \uBBFF\uC5C8\uB2E4."
    - "\uC0C8\uD134\uC740 \uB204\uAC00 \uB0A8\uACA8\uC9C0\uB294\uC9C0 \uBB3B\uB294
      \uAC83\uC73C\uB85C \uC6B0\uB9AC\uB97C \uC9C0\uD0A4\uB824 \uD588\uB2E4."
    - "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C \uBD99\uC7A1\uC558\uACE0,
      \uB8E8\uC774\uC2A4\uB294 \uC544\uBB34\uAC83\uB3C4 \uC120\uD0DD\uD558\uC9C0
      \uC54A\uC74C\uC73C\uB85C\uC368 \uB354 \uD070 \uC0C1\uCC98\uB97C \uD53C\uD558\uB824
      \uD588\uB2E4."
    - "\uC6B0\uB9AC\uB294 \uBAA8\uB450 \uB450\uB824\uC6E0\uB2E4."
    - "\uB2E4\uB9CC \uB450\uB824\uC6C0\uC744 \uB2E4\uB8E8\uB294 \uBC29\uC2DD\uC774
      \uB2EC\uB790\uB2E4."
    - "\uB098\uB294 \uB300\uC2E0 \uC8FD\uB294 \uAC83\uC73C\uB85C \uC0AC\uB791\uC744
      \uC99D\uBA85\uD558\uB824 \uD588\uB2E4."
    - "\uD558\uC9C0\uB9CC \uB0B4\uAC00 \uC8FD\uACE0 \uB098\uBA74, \uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC740
      \uB610 \uB2E4\uB978 \uC8C4\uCC45\uAC10\uC744 \uC9CA\uC5B4\uC838\uC57C \uD55C\uB2E4.
      \uADF8\uAC83\uC744 \uC774\uC81C\uC57C \uC54C\uC558\uB2E4."
    - "\uD76C\uC0DD\uC740 \uC5B8\uC81C\uB098 \uC544\uB984\uB2E4\uC6B4 \uB9D0\uC774
      \uC544\uB2C8\uC5C8\uB2E4."
    - "\uB54C\uB85C\uB294 \uB0A8\uACA8\uC9C4 \uC0AC\uB78C\uC5D0\uAC8C \uC120\uD0DD\uD560
      \uAE30\uD68C\uC870\uCC28 \uC8FC\uC9C0 \uC54A\uB294 \uB9D0\uC774\uC5C8\uB2E4."
    - "\uADF8\uB798\uB3C4 \uB098\uB294 \uB108\uD76C\uB97C \uC9C0\uD0A4\uACE0 \uC2F6\uC5C8\uB2E4."
    - "\uADF8 \uB9C8\uC74C\uB9CC\uC740 \uAC70\uC9D3\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    - "\uC774\uC81C \uB0B4\uAC00 \uBC30\uC6CC\uC57C \uD560 \uAC83\uC740 \uB300\uC2E0
      \uC8FD\uB294 \uBC95\uC774 \uC544\uB2C8\uB77C, \uD568\uAED8 \uC0B4\uC544\uB0A8\uB294
      \uBC95\uC774\uC5C8\uB2E4."
  - CharacterId: 7
    RequiredFragmentCount: 10
    CharacterFullName: "\uC0C8\uD134"
    CharacterRole: "(\uBC30\uD68C\uC790)"
    CharacterIcon: {fileID: 21300000, guid: 8808ade9a103ff54891d0fb0c80bdd0e, type: 3}
    ProfileItems:
    - Question: "\uACFC\uAC70 \uD575\uC2EC \uC0AC\uAC74"
      Choices:
      - "\uC0C8\uD134\uC740 \uACFC\uAC70\uC5D0 \uC0B4\uC544\uB0A8\uAE30 \uC704\uD574
        \uB204\uAD70\uAC00\uB97C \uB4A4\uC5D0 \uB0A8\uACA8\uC57C \uD588\uB358 \uACBD\uD5D8\uC744
        \uBC18\uBCF5\uD574 \uC654\uB2E4."
      - "\uC0C8\uD134\uC740 \uC9C0\uAE08\uAE4C\uC9C0 \uB9CE\uC740 \uB3D9\uB8CC\uB4E4\uC758
        \uD76C\uC0DD\uC73C\uB85C \uC0B4\uC544\uB0A8\uC544 \uC654\uB2E4."
      - "\uC0C8\uD134\uC740 \uACFC\uAC70\uC5D0 \uC548\uC815\uB41C \uACF5\uB3D9\uCCB4
        \uC548\uC5D0\uC11C \uC0B4\uC544\uC654\uACE0, \uB4A4\uC5D0 \uB0A8\uACA8\uC9C4
        \uC0AC\uB78C\uC5D0 \uB300\uD55C \uAE30\uC5B5\uC774 \uC801\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uD604\uC7AC \uC815\uCCB4/\uD589\uB3D9 \uC774\uC720"
      Choices:
      - "\uC0C8\uD134\uC740 \uC5B4\uB5A4 \uC0C1\uD669\uC5D0\uC11C\uB3C4 \u201C\uADF8
        \uC120\uD0DD\uC73C\uB85C \uB204\uAC00 \uBC84\uB824\uC9C0\uB294\uAC00\u201D\uB97C
        \uBA3C\uC800 \uC0DD\uAC01\uD55C\uB2E4."
      - "\uC0C8\uD134\uC774 \uB204\uAC00 \uBC84\uB824\uC9C0\uB294\uAC00\uB97C \uBB3B\uB294
        \uC774\uC720\uB294 \uC790\uAE30 \uC0DD\uC874\uC744 \uC6B0\uC120\uD558\uAE30
        \uB54C\uBB38\uC774\uB2E4."
      - "\uC0C8\uD134\uC740 \uC120\uD0DD\uC73C\uB85C \uB204\uAC00 \uBC84\uB824\uC9C0\uB294\uAC00\uBCF4\uB2E4
        \uC790\uC2E0\uC758 \uAC10\uC815\uACFC \uC790\uC874\uC2EC\uC744 \uBA3C\uC800
        \uC0DD\uAC01\uD55C\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uAD00\uACC4 \uC778\uC2DD"
      Choices:
      - "\uC0C8\uD134\uC740 \uB9C8\uC655\uC744 \uC4F0\uB7EC\uB728\uB9AC\uB294 \uAC83\uBCF4\uB2E4
        \uADF8 \uACFC\uC815\uC5D0\uC11C \uBC1C\uC0DD\uD558\uB294 \uD76C\uC0DD\uC744
        \uB354 \uC911\uC694\uD558\uAC8C \uBCF8\uB2E4."
      - "\uC0C8\uD134\uC740 \uB9C8\uC655\uC744 \uC4F0\uB7EC\uB728\uB9AC\uB824\uB294
        \uAC1C\uC778\uC801\uC778 \uBCF5\uC218\uC5D0 \uC9D1\uC911\uD55C\uB2E4."
      - "\uC0C8\uD134\uC740 \uB9C8\uC655\uC744 \uC4F0\uB7EC\uB728\uB9AC\uB294 \uC77C\uC744
        \uAC1C\uC778\uC801\uC778 \uBCF5\uC218\uC758 \uBB38\uC81C\uB85C\uB9CC \uBC1B\uC544\uB4E4\uC778\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uC228\uACA8\uC9C4 \uC65C\uACE1"
      Choices:
      - "\uC0C8\uD134\uC740 \uACF5\uB3D9\uCCB4\uB97C \uC644\uC804\uD788 \uBBFF\uC9C0
        \uC54A\uC73C\uBA70 \uD56D\uC0C1 \uD55C \uBC1C \uB5A8\uC5B4\uC838 \uC0C1\uD669\uC744
        \uB0C9\uC815\uD558\uAC8C \uD310\uB2E8\uD55C\uB2E4."
      - "\uC0C8\uD134\uC774 \uACF5\uB3D9\uCCB4\uC5D0\uC11C \uAC70\uB9AC\uB97C \uB450\uB294
        \uC774\uC720\uB294 \uD63C\uC790 \uC0B4\uC544\uB0A8\uAE30 \uC704\uD55C \uACC4\uC0B0
        \uB54C\uBB38\uC774\uB2E4."
      - "\uC0C8\uD134\uC740 \uACF5\uB3D9\uCCB4\uC640 \uB9AC\uB354\uB97C \uC27D\uAC8C
        \uC2E0\uB8B0\uD558\uBA70, \uD070 \uACB0\uC815\uC744 \uBCC4\uB2E4\uB978 \uC758\uC2EC
        \uC5C6\uC774 \uB530\uB978\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    - Question: "\uCD5C\uC885 \uAE30\uC804"
      Choices:
      - "\uC0C8\uD134\uC740 \uACB0\uAD6D \uB204\uAD70\uAC00\uAC00 \uD76C\uC0DD\uB418\uB294
        \uAD6C\uC870 \uC790\uCCB4\uC5D0 \uBD84\uB178\uD558\uACE0 \uC758\uBB38\uC744
        \uC81C\uAE30\uD558\uB294 \uC778\uBB3C\uC774\uB2E4."
      - "\uC0C8\uD134\uC740 \uD604\uC2E4\uC744 \uB0C9\uC18C\uC801\uC73C\uB85C \uBC14\uB77C\uBCF4\uBA70
        \uACC4\uC18D\uD574\uC11C \uD2B8\uC9D1\uC744 \uC7A1\uB294 \uC778\uBB3C\uC774\uB2E4."
      - "\uACB0\uAD6D \uC0C8\uD134\uC740 \uD76C\uC0DD \uAD6C\uC870\uC5D0 \uBD84\uB178\uD558\uAE30\uBCF4\uB2E4
        \uB300\uC758\uB97C \uC704\uD574 \uD76C\uC0DD\uC744 \uBC1B\uC544\uB4E4\uC774\uB294
        \uC778\uBB3C\uC774\uB2E4."
      CorrectChoiceIndex: 0
      RequiredFragmentId: 
    ConceptCard:
      Catchphrase: "\uB0B4\uAC00 \uAC78\uC74C\uC744 \uC62E\uAE38 \uB54C\uB9C8\uB2E4,
        \uB204\uAD70\uAC00\uB294 \uB4A4\uC5D0 \uB0A8\uC558\uB2E4."
      Appearance: "\uBE5B\uBC14\uB79C \uAE08\uBC1C \uB2E8\uBC1C\uACFC \uB0AE\uAC8C
        \uAC00\uB77C\uC549\uC740 \uB208\uB9E4, \uCEE4\uB2E4\uB780 \uBCA0\uC774\uC9C0\uC0C9
        \uBAA8\uC790\uAC00 \uC624\uB798 \uB5A0\uB3C8 \uC0AC\uB78C \uAC19\uC740 \uC778\uC0C1\uC744
        \uC900\uB2E4."
      NarrativeBackground: "\uD53C\uB09C\uACFC \uC804\uC7C1 \uC18D\uC5D0\uC11C \uBA3C\uC800
        \uC6C0\uC9C1\uC5EC\uC57C \uC0B4\uC544\uB0A8\uB294 \uBC95\uC744 \uBC30\uC6E0\uACE0,
        \uADF8\uB54C\uB9C8\uB2E4 \uB4A4\uC5D0 \uB0A8\uACA8\uC9C4 \uC0AC\uB78C\uB4E4\uC744
        \uAE30\uC5B5\uD55C\uB2E4."
      Personality: "\uC2B9\uB9AC\uB098 \uAD6C\uC6D0\uBCF4\uB2E4 \uADF8 \uACFC\uC815\uC5D0\uC11C
        \uB204\uAC00 \uBC84\uB824\uC9C0\uB294\uC9C0\uB97C \uBA3C\uC800 \uBCF4\uBA70,
        \uC5B4\uB5A4 \uACB0\uB2E8 \uC55E\uC5D0\uC11C\uB3C4 \uC9C8\uBB38\uC744 \uBA48\uCD94\uC9C0
        \uC54A\uB294\uB2E4."
      GimmickRelevance: "\uC774\uB3D9\uD55C \uB4A4 \uC790\uC2E0\uC774 \uB5A0\uB09C
        \uC790\uB9AC\uC5D0 \uC8FD\uC74C\uC744 \uB0A8\uAE30\uB294 \uBC30\uD68C\uC790."
      CardIllustration: {fileID: 21300000, guid: 8808ade9a103ff54891d0fb0c80bdd0e, type: 3}
    EpilogueLines:
    - "\uB098\uB294 \uB298 \uB4A4\uB97C \uBCF4\uC558\uB2E4."
    - "\uB204\uAC00 \uB0A8\uACA8\uC9C0\uB294\uC9C0, \uB204\uAC00 \uB9D0\uC5C6\uC774
      \uBC00\uB824\uB098\uB294\uC9C0, \uB204\uAC00 \uC2B9\uB9AC\uB77C\uB294 \uB9D0
      \uC544\uB798\uC5D0\uC11C \uC0AC\uB77C\uC9C0\uB294\uC9C0. \uADF8\uB798\uC11C
      \uB098\uB294 \uC790\uC8FC \uBB3B\uACE0, \uC790\uC8FC \uC758\uC2EC\uD588\uACE0,
      \uC790\uC8FC \uD654\uB97C \uB0C8\uB2E4."
    - "\uD558\uC9C0\uB9CC \uC774\uC81C\uB294 \uC548\uB2E4."
    - "\uBA54\uC774\uAC00 \uC55E\uB9CC \uBCF8 \uAC83\uC740 \uB4A4\uB97C \uBAA8\uB978
      \uCC99\uD574\uC11C\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uADF8\uB294 \uBA48\uCD94\uB294
      \uC21C\uAC04 \uC790\uC2E0\uC774 \uC0B4\uC544\uB0A8\uC740 \uC774\uC720\uB9C8\uC800
      \uBB34\uB108\uC9C8\uAE4C \uB450\uB824\uC6E0\uB358 \uAC83\uC774\uB2E4."
    - "\uD504\uB9AC\uB4DC\uAC00 \uC2A4\uC2A4\uB85C\uB97C \uC81C\uBB3C\uB85C \uC0BC\uC73C\uB824
      \uD55C \uAC83\uB3C4, \uD76C\uC0DD\uC744 \uC88B\uC544\uD574\uC11C\uAC00 \uC544\uB2C8\uB77C
      \uB0A8\uACA8\uC9C0\uB294 \uACE0\uD1B5\uC744 \uB204\uAD6C\uBCF4\uB2E4 \uC798
      \uC54C\uC558\uAE30 \uB54C\uBB38\uC774\uC5C8\uB2E4."
    - "\uC5D4\uBE44\uAC00 \uC6B0\uB9AC\uB97C \uD754\uB4E0 \uAC83\uB3C4 \uB2E8\uC21C\uD55C
      \uBC30\uC2E0\uB9CC\uC740 \uC544\uB2C8\uC5C8\uB2E4. \uADF8\uB140\uB294 \uBD04
      \uC548\uC73C\uB85C \uB4E4\uC5B4\uC624\uACE0 \uC2F6\uC5C8\uACE0, \uB3D9\uC2DC\uC5D0
      \uC790\uC2E0\uC774 \uADF8 \uBD04\uC744 \uB9DD\uCE60\uAE4C \uB450\uB824\uC6CC\uD588\uB2E4."
    - "\uB098\uB294 \uBAA8\uB450\uAC00 \uD2C0\uB838\uB2E4\uACE0 \uC0DD\uAC01\uD588\uB2E4."
    - "\uD558\uC9C0\uB9CC \uC0AC\uC2E4\uC740 \uBAA8\uB450\uAC00 \uBB34\uC5B8\uAC00\uB97C
      \uC9C0\uD0A4\uB824 \uD588\uB2E4."
    - "\uB2E4\uB9CC \uC6B0\uB9AC\uAC00 \uC9C0\uD0A4\uB824 \uD55C \uAC83\uC774 \uC11C\uB85C
      \uB2EC\uB790\uC744 \uBFD0\uC774\uB2E4."
    - "\uADF8\uB807\uB2E4\uACE0 \uBAA8\uB4E0 \uC77C\uC774 \uC6A9\uC11C\uB418\uB294
      \uAC83\uC740 \uC544\uB2C8\uB2E4."
    - "\uC8FD\uC74C\uC740 \uB0A8\uC558\uACE0, \uC0C1\uCC98\uB3C4 \uB0A8\uC558\uB2E4."
    - "\uD558\uC9C0\uB9CC \uC774\uC81C\uB294 \uB9D0\uD560 \uC218 \uC788\uB2E4. \uC6B0\uB9AC\uB294
      \uC11C\uB85C\uB97C \uC774\uD574\uD558\uC9C0 \uBABB\uD574\uC11C \uB9DD\uAC00\uC84C\uC9C0,
      \uCC98\uC74C\uBD80\uD130 \uC11C\uB85C\uB97C \uBBF8\uC6CC\uD574\uC11C \uB9DD\uAC00\uC9C4
      \uAC83\uC740 \uC544\uB2C8\uC5C8\uB2E4."
    - "\uC6B0\uB9AC\uB294 \uAC19\uC740 \uBD04\uC744 \uAFC8\uAFB8\uC9C0 \uC54A\uC558\uB2E4."
    - "\uADF8\uB798\uB3C4 \uD55C\uB54C\uB294 \uAC19\uC740 \uAF43\uBC2D\uC5D0 \uC11C
      \uC788\uC5C8\uB2E4."
    - "\uADF8 \uC0AC\uC2E4\uB9CC\uD07C\uC740, \uB0B4\uAC00 \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0
      \uAE30\uC5B5\uD558\uACE0 \uC2F6\uB2E4."
