  - ComboId: C084
    ComboKey: '#2|#4|#5|#7'
    ParticipantIds: 02000000040000000500000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #2|#4|#5|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uC0AC\uB78C\uC744 \uB108\uBB34 \uAC00\uBCCD\uAC8C \uB2E4\uB8E8\uB294
        \uB9D0\uC740, \uB09C \uB05D\uAE4C\uC9C0 \uBABB \uB118\uACA8."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uACC4\uC18D \uC55E\uC73C\uB85C\uB9CC \uAC00\uBA74 \uC5B8\uC820\uAC00
        \uC9C4\uC9DC \uC544\uBB34\uAC83\uB3C4 \uC548 \uB0A8\uC744 \uAC83 \uAC19\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uB05D\uC744 \uBCF4\uACA0\uB2E4\uB294 \uC0AC\uB78C\uC740 \uB2E4\uB8E8\uAE30
        \uC26C\uC6CC. \uBD88\uC744 \uB354 \uC8FC\uBA74 \uC2A4\uC2A4\uB85C \uB053\uC5B4\uC624\uB974\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uACB0\uB9D0\uC774 \uD544\uC694\uD558\uB2E8 \uAC74 \uC54C\uC9C0. \uADF8\uB7F0\uB370
        \uADF8 \uACB0\uB9D0 \uBC11\uBC14\uB2E5\uC5D0 \uAE54\uB9B4 \uC0AC\uB78C\uC740
        \uB204\uAD6C\uC57C?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C085
    ComboKey: '#2|#4|#6|#7'
    ParticipantIds: 02000000040000000600000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #2|#4|#6|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uB204\uAC00 \uB0A8\uACA8\uC9C8\uC9C0\uB97C \uBB3B\uAE30 \uC804\uC5D0,
        \uBA3C\uC800 \uB05D\uB0BC \uBC29\uBC95\uC744 \uCC3E\uC544\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB124\uAC00 \uBC84\uD2F0\uB294 \uC774\uC720\uB294 \uC54C\uACA0\uB294\uB370,
        \uBAA8\uB450\uAC00 \uAC19\uC740 \uD798\uC744 \uAC00\uC9C4 \uAC74 \uC544\uB2C8\uC796\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB05D\uC744 \uC644\uC218\uD574\uC57C \uD55C\uB2E4\uBA74 \uB0B4\uAC00
        \uBC29\uD328\uAC00 \uB418\uACA0\uB2E4. \uB124\uAC00 \uBB34\uB108\uC9C0\uAC8C
        \uB450\uC9C4 \uC54A\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uD070 \uACB0\uC2EC\uC740 \uB298 \uBA4B\uC788\uAC8C \uB4E4\uB824. \uADF8\uB798\uC11C
        \uADF8 \uADF8\uB9BC\uC790\uB3C4 \uB354 \uB2A6\uAC8C \uBCF4\uC774\uB354\uB77C."
