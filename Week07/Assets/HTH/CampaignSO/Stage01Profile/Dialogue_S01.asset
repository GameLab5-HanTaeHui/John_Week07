    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uBAA8\uB450\uB97C \uB300\uC2E0 \uC9CA\uC5B4\uC9C0\uB824\uB294 \uD45C\uC815\uC774
        \uB108\uBB34 \uC775\uC219\uD574\uC11C \uB354 \uBD88\uC548\uD574."
