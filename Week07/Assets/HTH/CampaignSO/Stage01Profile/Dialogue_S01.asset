      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C058
    ComboKey: '#1|#2|#3|#5'
    ParticipantIds: 01000000020000000300000005000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#2|#3|#5"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB124\uAC00 \uD5A5\uC744 \uB9D0\uD560 \uB54C\uB9C8\uB2E4, \uB204\uAD70\uAC00\uB294
        \uC774\uBBF8 \uB3C4\uB9C8 \uC704\uC5D0 \uC624\uB978 \uAE30\uBD84\uC774 \uB4E4\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uD1A0\uB2C8, \uB124 \uC6C3\uC74C \uB4A4\uC5D0 \uC228\uC740 \uB0C4\uC0C8\uAC00
        \uB9C8\uC74C\uC5D0 \uB4E4\uC9C0 \uC54A\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB05D\uC744 \uC11C\uB450\uB97C\uC218\uB85D \uB354 \uC57D\uD55C \uC0AC\uB78C\uC774
        \uBA3C\uC800 \uB2E4\uCE69\uB2C8\uB2E4. \uADF8 \uC810\uC740 \uC78A\uC9C0 \uB9D0\uC544
        \uC8FC\uC2ED\uC2DC\uC624."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uBA54\uC774\uC758 \uCE7C\uB05D\uC740 \uCC38 \uC88B\uC740 \uD5A5\uC744
        \uB0B4. \uBBFF\uC74C\uC774 \uAC15\uD560\uC218\uB85D \uD0C0\uB4E4\uC5B4 \uAC00\uB294
        \uB0C4\uC0C8\uB3C4 \uC9C4\uD558\uAC70\uB4E0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C059
    ComboKey: '#1|#2|#3|#6'
    ParticipantIds: 01000000020000000300000006000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#2|#3|#6"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uD504\uB9AC\uB4DC, \uB2E4 \uB124 \uBAAB\uC73C\uB85C \uB9CC\uB4E4\uBA74
        \uC544\uBB34\uB3C4 \uC81C\uB300\uB85C \uC11C\uC9C0 \uBABB\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC774\uBC88\uC5D4 \uB204\uAD6C \uD558\uB098\uB9CC \uC9D0\uC744 \uB5A0\uC548\uB294
        \uBC29\uC2DD\uC73C\uB85C \uB05D\uB0B4\uACE0 \uC2F6\uC9C0 \uC54A\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB2F9\uC2E0\uC758 \uC815\uC758\uAC00 \uC81C\uAC00 \uC9C0\uD0A4\uB824\uB294
        \uC0AC\uB78C\uC744 \uC704\uD5D8\uC5D0 \uB450\uB294 \uC21C\uAC04, \uC800\uB294
        \uB2F9\uC2E0\uACFC \uAC19\uC740 \uD3B8\uC77C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB108\uBB34 \uD070 \uC774\uB984\uC744 \uC9CA\uC5B4\uC9C0\uB824 \uD558\uC9C0
        \uB9C8\uB77C. \uB05D\uAE4C\uC9C0 \uBC84\uD2F0\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4
