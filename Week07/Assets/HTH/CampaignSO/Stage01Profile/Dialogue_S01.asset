      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uADF8\uB798\uB3C4 \uB108\uBB34 \uAC00\uAE4C\uC774 \uB458 \uD544\uC694\uB294
        \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uB05D\uC744 \uBCF4\uACA0\uB2E4\uB294 \uC0AC\uB78C\uC740 \uB2E4\uB8E8\uAE30
        \uC26C\uC6CC. \uBD88\uC744 \uB354 \uC8FC\uBA74 \uC2A4\uC2A4\uB85C \uB053\uC5B4\uC624\uB974\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uC800\uB294 \uBC29\uD574\uD558\uC9C0 \uC54A\uC744\uAC8C\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uBD10, \uC774\uB7F0 \uB9D0\uB3C4 \uC548 \uBD88\uD3B8\uD558\uAC8C \uD558\uC796\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\u2026\uADF8\uB798\uC11C \uB354 \uC870\uC2EC\uD574\uC57C \uD569\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C025
    ComboKey: '#1|#2|#6'
    ParticipantIds: 010000000200000006000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#2|#6"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB124\uAC00 \uBA3C\uC800 \uC55E\uC11C\uBA74, \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC740
        \uC790\uAE30 \uC18D\uB3C4\uB97C \uC783\uAE30 \uC26C\uC6CC."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4\uB294 \uACC4\uC18D \uB4A4\uB85C
        \uBE60\uC9C4\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uD504\uB9AC\uB4DC, \uB124\uAC00 \uC9D0\uC744 \uB098\uB204\uB824\uB294
        \uAC74 \uC54C\uC9C0\uB9CC \uB9C8\uC9C0\uB9C9 \uCC45\uC784\uC740 \uB0B4\uAC00
        \uC9C4\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB8E8\uC774\uC2A4\uC758 \uC0C1\uD0DC\uB294 \uBD84\uBA85 \uC88B\uC9C0
        \uC54A\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB05D\uC744 \uC644\uC218\uD574\uC57C \uD55C\uB2E4\uBA74 \uB0B4\uAC00
        \uBC29\uD328\uAC00 \uB418\uACA0\uB2E4. \uB124\uAC00 \uBB34\uB108\uC9C0\uAC8C
        \uB450\uC9C4 \uC54A\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uC0C1\uD0DC\uB9CC \uBB38\uC81C\uAC00 \uC544\uB2C8\uC57C. \uC800 \uB458\uC740
        \uC774\uBBF8 \uC6B0\uB9AC\uC640 \uB2E4\uB978 \uACF3\uC5D0 \uC788\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uADF8\uB798\uC11C \uB354 \uBD99\uC7A1\uC544\uC57C \uD574. \uD769\uC5B4\uC9C0\uBA74
        \uB05D\uC774\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uBD99\uC7A1\uB294\uB2E4\uACE0 \uD568\uAED8 \uC788\uB294 \uAC74 \uC544\uB2C8\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C026
    ComboKey: '#1|#2|#7'
    ParticipantIds: 010000000200000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#2|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uBA54\uC774\uB294 \uC55E\uC73C\uB85C \uBC00\uACE0, \uC0C8\uD134\uC740
        \uBC1C\uBC11\uC744 \uBB3B\uB124. \uB458 \uB2E4 \uD2C0\uB9B0 \uB9D0\uC740
        \uC544\uB2C8\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC0C8\uD134 \uC5B8\uB2C8\uB294 \uB208\uC774 \uBFB0\uC871\uD574. \uCF55\uCF55
        \uCC14\uB7EC."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC0C8\uD134, \uB124 \uC9C8\uBB38\uC740 \uC774\uD574\uD55C\uB2E4. \uADF8\uB798\uB3C4
        \uB204\uAD70\uAC00\uB294 \uB9DD\uC124\uC784\uBCF4\uB2E4 \uACB0\uB2E8\uC744
        \uD0DD\uD574\uC57C \uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB108\uD76C \uB458\uC740 \uB2E4\uB974\uAC8C \uC774\uC0C1\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uBA54\uC774, \uB05D\uC744 \uBCF4\uC790\uB294 \uB9D0 \uB4A4\uC5D4 \uB298
        \uB204\uAC00 \uB0A8\uB294\uC9C0\uBD80\uD130 \uB9D0\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uC800\uD76C\uAC00 \uADF8\uB807\uAC8C \uB2EE\uC544 \uBCF4\uC774\uB098\uC694?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uC544\uB2C8. \uD558\uB098\uB294 \uC228\uAE30\uACE0, \uD558\uB098\uB294
        \uAE30\uB2E4\uB824."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uAE30\uB2E4\uB9AC\uBA74 \uC88B\uC740 \uC77C\uC774 \uC0DD\uAE30\uAE30\uB3C4
        \uD574! \uCFE0\uD0A4\uCC98\uB7FC!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C027
    ComboKey: '#1|#3|#4'
    ParticipantIds: 010000000300000004000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
