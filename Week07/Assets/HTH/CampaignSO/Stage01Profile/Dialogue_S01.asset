      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB2F9\uC2E0\uC758 \uBBF8\uC18C\uC5D0\uB294 \uC9C0\uB098\uCE58\uAC8C
        \uB9CE\uC740 \uC545\uC758\uAC00 \uBC30\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
