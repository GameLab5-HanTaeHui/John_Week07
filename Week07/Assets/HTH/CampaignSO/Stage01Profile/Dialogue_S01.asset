  - ComboId: M1
    ComboKey: '#1'
    ParticipantIds: 01000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB2E4\uB4E4 \uC11C\uB85C\uC758 \uC774\uB984\uC744 \uB108\uBB34 \uC27D\uAC8C
        \uBD80\uB978\uB2E4. \uBD80\uB974\uBA74 \uB3CC\uC544\uC624\uB294 \uAC8C \uB2F9\uC5F0\uD55C
        \uAC83\uCC98\uB7FC."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uB098\uB294 \uC5B8\uC81C\uB098 \uADF8 \uBD04\uC758 \uBC14\uAE65\uC5D0
        \uC788\uC5C8\uB2E4. \uADF8\uB7F0\uB370\uB3C4, \uC190\uC744 \uBED7\uACE0 \uC2F6\uC5C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uBD80\uC218\uACE0 \uC2F6\uC740 \uAC74 \uADF8\uB4E4\uC774 \uC544\uB2C8\uB77C\u2026
        \uADF8 \uC548\uC5D0 \uB4E4\uC5B4\uAC08 \uC218 \uC5C6\uB294 \uB098 \uC790\uC2E0\uC77C\uC9C0\uB3C4
        \uBAA8\uB978\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: M2
    ComboKey: '#2'
    ParticipantIds: 02000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uC5EC\uAE30\uC11C \uBA48\uCD94\uBA74 \uC9C0\uAE08\uAE4C\uC9C0 \uC783\uC5B4\uC628
        \uBAA8\uB4E0 \uAC83\uC774 \uC544\uBB34 \uC758\uBBF8 \uC5C6\uC5B4\uC9C4\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uB098\uB294 \uB05D\uAE4C\uC9C0 \uAC00\uC57C \uD55C\uB2E4\uACE0 \uC0DD\uAC01\uD574.
        \uADF8\uB798\uC57C \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uC2DC\uAC04\uC774 \uBB34\uB108\uC9C0\uC9C0
        \uC54A\uC744 \uAC83 \uAC19\uC544\uC11C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uB3D9\uB8CC\uB4E4\uC744 \uC544\uB080\uB2E4. \uADF8\uB798\uC11C \uB354\uB354\uC6B1
        \uD568\uAED8 \uAC00\uC57C \uD55C\uB2E4\uACE0 \uBBFF\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: M3
    ComboKey: '#3'
    ParticipantIds: 03000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4\uAC00 \uC6C3\uC9C0 \uC54A\uB294 \uB0A0\uC740, \uC138\uC0C1\uC774
        \uC870\uAE08\uC529 \uBB34\uB108\uC9C0\uB294 \uAC83\uCC98\uB7FC \uB290\uAEF4\uC9C4\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB0B4 \uAE30\uB3C4\uAC00 \uC2E0\uC5D0\uAC8C \uB2FF\uC9C0 \uC54A\uB294\uB2E4\uBA74,
        \uB0B4\uAC00 \uC9C1\uC811 \uC9C0\uD0A4\uBA74 \uB41C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uADF8\uB97C \uC704\uD5D8\uD558\uAC8C \uB9CC\uB4DC\uB294 \uBAA8\uB4E0
        \uAC83\uC5D0\uC11C \uBA40\uB9AC \uB5BC\uC5B4\uB193\uACE0 \uC2F6\uB2E4. \uC774\uAC83\uC774
        \uC0AC\uB791\uC774 \uC544\uB2C8\uBA74 \uBB34\uC5C7\uC778\uAC00."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: M4
    ComboKey: '#4'
    ParticipantIds: 04000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 4
      Text: "\uC544\uBB34 \uC77C\uB3C4 \uC548 \uC77C\uC5B4\uB0AC\uC73C\uBA74 \uC88B\uACA0\uB2E4.
        \uC544\uBB34\uB3C4 \uBB3B\uC9C0 \uC54A\uACE0, \uC544\uBB34\uB3C4 \uC7AC\uCD09\uD558\uC9C0
        \uC54A\uB294 \uACF3\uC5D0\uC11C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB370\uC6B0\uC2A4\uAC00 \uB0B4 \uC606\uC5D0 \uC788\uC73C\uBA74 \uC228\uC740
        \uC26C\uC5B4\uC9C4\uB2E4. \uADF8\uAC8C \uC633\uC740\uC9C0\uB294\u2026 \uBAA8\uB974\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB098\uB294 \uC774\uBBF8 \uB9CE\uC774 \uC9C0\uCCE4\uB2E4. \uB354 \uB098\uC544\uAC00\uC790\uB294
        \uB9D0\uC774 \uAC00\uB054\uC740 \uB108\uBB34 \uBA40\uAC8C \uB4E4\uB824."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: M5
    ComboKey: '#5'
    ParticipantIds: 05000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 5
      Text: "\uB2E4\uB4E4 \uC6C3\uC744 \uB54C\uB791 \uC870\uC6A9\uD560 \uB54C \uB0C4\uC0C8\uAC00
        \uB2EC\uB77C. \uC774\uC0C1\uD558\uC9C0? \uD1A0\uB2C8\uB9CC \uADF8\uB807\uAC8C
        \uB290\uB07C\uB098?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC544\uC9C1\uC740 \uC544\uB2C8\uC57C. \uC870\uAE08 \uB354 \uAE30\uB2E4\uB9AC\uBA74,
        \uD6E8\uC52C \uC9C4\uD574\uC9C8 \uAC83 \uAC19\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uAC89\uC740 \uB2EC\uCF64\uD574\uC57C \uD574. \uADF8\uB798\uC57C \uC544\uBB34\uB3C4
        \uC548 \uB180\uB77C\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: M6
    ComboKey: '#6'
    ParticipantIds: 06000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 6
      Text: "\uB204\uAD70\uAC00 \uC55E\uC5D0 \uC11C\uC57C \uD55C\uB2E4\uBA74, \uADF8\uAC74
        \uB098\uC5EC\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB0B4\uAC00 \uB300\uC2E0\uD558\uBA74 \uB41C\uB2E4. \uADF8\uAC8C \uAC00\uC7A5
        \uBE60\uB974\uACE0, \uAC00\uC7A5 \uB35C \uC544\uD508 \uAE38\uC774\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uD558\uC9C0\uB9CC \uAC00\uB054 \uC0DD\uAC01\uD55C\uB2E4. \uB0B4\uAC00
        \uB300\uC2E0\uD558\uB294 \uAC83\uC774 \uC815\uB9D0 \uADF8\uB4E4\uC744 \uC0B4\uB9AC\uB294
        \uC77C\uC778\uC9C0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: M7
    ComboKey: '#7'
    ParticipantIds: 07000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 7
      Text: "\uC88B\uC740 \uC774\uB984\uC740 \uB298 \uC77C\uC774 \uB05D\uB09C \uB4A4\uC5D0
        \uBD99\uB294\uB2E4. \uADF8 \uC804\uAE4C\uC9C0 \uC0AC\uB77C\uC9C0\uB294 \uAC74
        \uC798 \uBCF4\uC774\uC9C0\uB3C4 \uC54A\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uBA3C\uC800 \uC6C0\uC9C1\uC5EC\uC57C \uC0B0\uB2E4. \uD558\uC9C0\uB9CC
        \uBA3C\uC800 \uC6C0\uC9C1\uC774\uBA74, \uB204\uAD70\uAC00\uB294 \uB4A4\uC5D0
        \uB0A8\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uBA54\uC774\uB294 \uB05D\uC744 \uBCF8\uB2E4. \uB098\uB294 \uADF8 \uB05D\uAE4C\uC9C0
        \uAC00\uB294 \uAE38\uC5D0 \uB5A8\uC5B4\uC9C0\uB294 \uC0AC\uB78C\uB4E4\uC744
        \uBCF8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
