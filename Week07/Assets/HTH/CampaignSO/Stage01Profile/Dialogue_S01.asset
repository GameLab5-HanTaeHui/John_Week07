    HintOfConditionId: 
    Lines:
    - SpeakerId: 6
      Text: "\uB204\uAD70\uAC00 \uD76C\uC0DD\uD558\uAE30 \uC704\uD574 \uB0A8\uC544\uC57C
        \uD55C\uB2E4\uBA74, \uC81C\uAC00 \uB0A8\uACA0\uC2B5\uB2C8\uB2E4"
      RevealCharacterId: -1
