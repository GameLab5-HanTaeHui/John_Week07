      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uC704\uD5D8\uD55C \uC77C\uC774\uB77C\uBA74 \uC81C\uAC00 \uBA3C\uC800
        \uC55E\uC5D0 \uC11C\uACA0\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uD504\uB9AC\uB4DC, \uC774\uBC88 \uC758\uB8B0\uB294 \uC774\uC804\uACFC
        \uB2EC\uB77C. \uB124\uAC00 \uC544\uBB34\uB9AC \uB6F0\uC5B4\uB098\uB2E4\uACE0
        \uD574\uB3C4 \uD55C\uBA85\uC774 \uBA3C\uC800 \uB098\uC120\uB2E4\uACE0 \uB420
        \uC77C\uC774 \uC544\uB2C8\uC57C. \uC774\uBC88\uC5D4 \uC11C\uB85C\uC758 \uB4F1\uC744
