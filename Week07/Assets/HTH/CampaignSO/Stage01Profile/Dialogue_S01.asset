      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uD568\uBD80\uB85C \uB9D0\uD558\uC9C0 \uB9C8\uC2ED\uC2DC\uC624."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uD568\uBD80\uB85C \uBCF4\uB294 \uAC8C \uC544\uB2C8\uC57C. \uB108\uBB34
        \uB178\uACE8\uC801\uC774\uB77C \uBCF4\uC774\uB294 \uAC70\uC9C0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB2F9\uC2E0\uC740 \uBAA8\uB4E0 \uBCF4\uD638\uB97C \uAC10\uAE08\uC73C\uB85C
        \uD574\uC11D\uD558\uB294\uAD70\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
