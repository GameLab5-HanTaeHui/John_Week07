    HintOfConditionId: 
    Lines:
    - SpeakerId: 3
      Text: "\uB2F9\uC2E0\uC774 \uB300\uC2E0 \uC9CA\uC5B4\uC9C0\uB824\uB294 \uB9C8\uC74C\uC740
        \uC54C\uC9C0\uB9CC, \uADF8 \uACB0\uB2E8\uC774 \uBAA8\uB450\uB97C \uAD6C\uD558\uC9C4
