    Lines:
    - SpeakerId: 2
      Text: "\uC11C\uB85C\uB97C \uC9C0\uD0A4\uACE0 \uC2F6\uC740 \uAC74 \uC54C\uACA0\uC9C0\uB9CC,
        \uC9C0\uAE08\uC740 \uBA48\uCD9C \uB54C\uAC00 \uC544\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB2F9\uC2E0\uC774 \uBC84\uD2F8 \uD798\uC774 \uC5C6\uB2E4\uBA74, \uC81C\uAC00
        \uB300\uC2E0 \uBC84\uD2F0\uACA0\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB2E4 \uAD1C\uCC2E\uC9C0 \uC54A\uC740\uB370, \uB124\uAC00 \uAD1C\uCC2E\uB2E4\uACE0
        \uB9D0\uD558\uBA74 \uC7A0\uAE50\uC740 \uBBFF\uAC8C \uB3FC."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uD070 \uACB0\uC2EC\uC740 \uB298 \uBA4B\uC788\uAC8C \uB4E4\uB824. \uADF8\uB798\uC11C
        \uADF8 \uADF8\uB9BC\uC790\uB3C4 \uB354 \uB2A6\uAC8C \uBCF4\uC774\uB354\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_2_3_4_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 02000000030000000500000006000000
    Lines:
    - SpeakerId: 2
      Text: "\uB204\uAD70\uAC00\uC758 \uBD88\uD589\uC744 \uC6C3\uC73C\uBA70 \uB118\uAE30\uB294
        \uC0AC\uB78C\uC740, \uB09C \uC624\uB798 \uB450\uC9C0 \uC54A\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB2F9\uC2E0\uC758 \uC815\uC758\uAC00 \uC81C\uAC00 \uC9C0\uD0A4\uB824\uB294
        \uC0AC\uB78C\uC744 \uC704\uD5D8\uC5D0 \uB450\uB294 \uC21C\uAC04, \uC800\uB294
        \uB2F9\uC2E0\uACFC \uAC19\uC740 \uD3B8\uC77C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uD06C\uAC8C \uBE5B\uB098\uB294 \uB9D0\uC77C\uC218\uB85D \uC8FC\uBCC0
        \uACF5\uAE30\uAE4C\uC9C0 \uBE60\uB974\uAC8C \uB2EC\uC544\uC624\uB974\uB354\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB108\uBB34 \uD070 \uC774\uB984\uC744 \uC9CA\uC5B4\uC9C0\uB824 \uD558\uC9C0
        \uB9C8\uB77C. \uB05D\uAE4C\uC9C0 \uBC84\uD2F0\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4
        \uCDA9\uBD84\uD558\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_2_3_5_6_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 02000000030000000500000007000000
    Lines:
    - SpeakerId: 2
      Text: "\uC0AC\uB78C\uC744 \uB108\uBB34 \uAC00\uBCCD\uAC8C \uB2E4\uB8E8\uB294
        \uB9D0\uC740, \uB09C \uB05D\uAE4C\uC9C0 \uBABB \uB118\uACA8."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uBA54\uC774, \uB2F9\uC2E0\uC758 \uB73B\uC740 \uC774\uD574\uD569\uB2C8\uB2E4.
        \uB2E4\uB9CC \uB204\uAD70\uAC00\uB97C \uBC00\uC5B4\uBD99\uC774\uB294 \uB05D\uC774\uB77C\uBA74
        \uC27D\uAC8C \uB3D9\uC758\uD558\uAE34 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uB05D\uC744 \uBCF4\uACA0\uB2E4\uB294 \uC0AC\uB78C\uC740 \uB2E4\uB8E8\uAE30
        \uC26C\uC6CC. \uBD88\uC744 \uB354 \uC8FC\uBA74 \uC2A4\uC2A4\uB85C \uB053\uC5B4\uC624\uB974\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uACB0\uB9D0\uC774 \uD544\uC694\uD558\uB2E8 \uAC74 \uC54C\uC9C0. \uADF8\uB7F0\uB370
        \uADF8 \uACB0\uB9D0 \uBC11\uBC14\uB2E5\uC5D0 \uAE54\uB9B4 \uC0AC\uB78C\uC740
        \uB204\uAD6C\uC57C?"
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_2_3_5_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 02000000030000000600000007000000
    Lines:
    - SpeakerId: 2
      Text: "\uB204\uAC00 \uB0A8\uACA8\uC9C8\uC9C0\uB97C \uBB3B\uAE30 \uC804\uC5D0,
        \uBA3C\uC800 \uB05D\uB0BC \uBC29\uBC95\uC744 \uCC3E\uC544\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB05D\uC744 \uC11C\uB450\uB97C\uC218\uB85D \uB354 \uC57D\uD55C \uC0AC\uB78C\uC774
        \uBA3C\uC800 \uB2E4\uCE69\uB2C8\uB2E4. \uADF8 \uC810\uC740 \uC78A\uC9C0 \uB9D0\uC544
        \uC8FC\uC2ED\uC2DC\uC624."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB05D\uC744 \uC644\uC218\uD574\uC57C \uD55C\uB2E4\uBA74 \uB0B4\uAC00
        \uBC29\uD328\uAC00 \uB418\uACA0\uB2E4. \uB124\uAC00 \uBB34\uB108\uC9C0\uAC8C
        \uB450\uC9C4 \uC54A\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uD070 \uACB0\uC2EC\uC740 \uB298 \uBA4B\uC788\uAC8C \uB4E4\uB824. \uADF8\uB798\uC11C
        \uADF8 \uADF8\uB9BC\uC790\uB3C4 \uB354 \uB2A6\uAC8C \uBCF4\uC774\uB354\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_2_3_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 02000000040000000500000006000000
    Lines:
    - SpeakerId: 2
      Text: "\uB204\uAD70\uAC00\uC758 \uBD88\uD589\uC744 \uC6C3\uC73C\uBA70 \uB118\uAE30\uB294
        \uC0AC\uB78C\uC740, \uB09C \uC624\uB798 \uB450\uC9C0 \uC54A\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uBA54\uC774, \uB05D\uC744 \uBD10\uC57C \uD55C\uB2E4\uB294 \uB9D0\uC740
        \uC54C\uC544. \uADFC\uB370 \uB09C \uAC00\uB054 \uBA48\uCD94\uACE0 \uC2F6\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uD06C\uAC8C \uBE5B\uB098\uB294 \uB9D0\uC77C\uC218\uB85D \uC8FC\uBCC0
        \uACF5\uAE30\uAE4C\uC9C0 \uBE60\uB974\uAC8C \uB2EC\uC544\uC624\uB974\uB354\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB108\uBB34 \uD070 \uC774\uB984\uC744 \uC9CA\uC5B4\uC9C0\uB824 \uD558\uC9C0
        \uB9C8\uB77C. \uB05D\uAE4C\uC9C0 \uBC84\uD2F0\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4
        \uCDA9\uBD84\uD558\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_2_4_5_6_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 02000000040000000500000007000000
    Lines:
    - SpeakerId: 2
      Text: "\uC0AC\uB78C\uC744 \uB108\uBB34 \uAC00\uBCCD\uAC8C \uB2E4\uB8E8\uB294
        \uB9D0\uC740, \uB09C \uB05D\uAE4C\uC9C0 \uBABB \uB118\uACA8."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uACC4\uC18D \uC55E\uC73C\uB85C\uB9CC \uAC00\uBA74 \uC5B8\uC820\uAC00
        \uC9C4\uC9DC \uC544\uBB34\uAC83\uB3C4 \uC548 \uB0A8\uC744 \uAC83 \uAC19\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uB05D\uC744 \uBCF4\uACA0\uB2E4\uB294 \uC0AC\uB78C\uC740 \uB2E4\uB8E8\uAE30
        \uC26C\uC6CC. \uBD88\uC744 \uB354 \uC8FC\uBA74 \uC2A4\uC2A4\uB85C \uB053\uC5B4\uC624\uB974\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uACB0\uB9D0\uC774 \uD544\uC694\uD558\uB2E8 \uAC74 \uC54C\uC9C0. \uADF8\uB7F0\uB370
        \uADF8 \uACB0\uB9D0 \uBC11\uBC14\uB2E5\uC5D0 \uAE54\uB9B4 \uC0AC\uB78C\uC740
        \uB204\uAD6C\uC57C?"
      RevealCharacterId: -1
      RevealCharacterName: 
