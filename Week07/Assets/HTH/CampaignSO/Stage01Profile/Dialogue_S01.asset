    Lines:
    - SpeakerId: 1
      Text: "\uB458 \uC0AC\uC774 \uACF5\uAE30\uAC00 \uB108\uBB34 \uB530\uB73B\uD574\uC11C,
        \uB2E4\uB978 \uB9D0\uC774 \uB07C\uC5B4\uB4E4 \uD2C8\uC774 \uC5C6\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4\uB9CC \uBB34\uC0AC\uD558\uB2E4\uBA74, \uC800\uB294
        \uB2E4\uB978 \uC2DC\uC120\uC744 \uC5BC\uB9C8\uB4E0\uC9C0 \uAC10\uB2F9\uD560
        \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB370\uC6B0\uC2A4, \uADF8\uB807\uAC8C\uAE4C\uC9C0 \uC560\uC4F0\uC9C0
        \uC54A\uC544\uB3C4 \uB3FC. \uADF8\uB7F0\uB370\uB3C4 \uB124\uAC00 \uC788\uC73C\uBA74
        \uC870\uAE08 \uB35C \uBB34\uB108\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uC9C0\uD0A4\uACE0 \uC2F6\uC740 \uC0AC\uB78C\uC774 \uC788\uB2E4\uBA74
        \uB354\uB354\uC6B1 \uB4A4\uC5D0 \uC788\uC5B4\uB77C. \uCE7C\uB0A0\uC740 \uB0B4\uAC00
        \uB9C9\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_3_4_6_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 01000000030000000400000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4\uB97C \uBCF4\uACE0 \uC788\uC73C\uBA74,
        \uC0AC\uB78C\uC740 \uC65C \uC11C\uB85C\uC5D0\uAC8C \uB3CC\uC544\uAC00\uB824
        \uD558\uB294\uC9C0 \uC54C \uAC83\uB3C4 \uAC19\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4, \uBB34\uB9AC\uD574\uC11C \uB9D0\uD558\uC9C0 \uC54A\uC544\uB3C4
        \uB429\uB2C8\uB2E4. \uC5EC\uAE30\uC5D4 \uC81C\uAC00 \uC788\uACA0\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB124\uAC00 \uACC1\uC5D0 \uC788\uC73C\uBA74 \uD3B8\uD574. \uADF8\uAC8C
        \uC88B\uC740 \uAC74\uC9C0 \uB098\uC05C \uAC74\uC9C4 \uBAA8\uB974\uACA0\uC9C0\uB9CC."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB458\uB9CC \uBCF4\uACE0 \uC788\uC73C\uBA74 \uD3B8\uD560 \uC21C \uC788\uACA0\uC9C0.
        \uB300\uC2E0 \uB2E4\uB978 \uAC74 \uC810\uC810 \uBA40\uC5B4\uC9C8 \uD14C\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_3_4_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 01000000030000000500000006000000
    Lines:
    - SpeakerId: 1
      Text: "\uB124\uAC00 \uD5A5\uC744 \uB9D0\uD560 \uB54C\uB9C8\uB2E4, \uB204\uAD70\uAC00\uB294
        \uC774\uBBF8 \uB3C4\uB9C8 \uC704\uC5D0 \uC624\uB978 \uAE30\uBD84\uC774 \uB4E4\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB2F9\uC2E0\uC774 \uB300\uC2E0 \uC9CA\uC5B4\uC9C0\uB824\uB294 \uB9C8\uC74C\uC740
        \uC54C\uC9C0\uB9CC, \uADF8 \uACB0\uB2E8\uC774 \uBAA8\uB450\uB97C \uAD6C\uD558\uC9C4
        \uBABB\uD569\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uD504\uB9AC\uB4DC \uAC19\uC740 \uC0AC\uB78C\uC740 \uB4DC\uBB3C\uC9C0.
        \uC2A4\uC2A4\uB85C \uBA3C\uC800 \uB098\uC11C\uB824\uB294 \uC0AC\uB78C\uC740
        \uC5B4\uB514\uC11C\uB098 \uB208\uC5D0 \uB744\uAC70\uB4E0."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uAC00\uBCBC\uC6B4 \uB9D0\uB85C \uB118\uAE38 \uC218 \uC5C6\uB294 \uC120\uC774
        \uC788\uC5B4. \uADF8\uAC78 \uB118\uB294\uB2E4\uBA74 \uB098\uB294 \uAC00\uB9CC\uC788\uC9C0
        \uC54A\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_3_5_6_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 01000000030000000500000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uD1A0\uB2C8, \uB124\uAC00 \uC6C3\uC744\uC218\uB85D \uACF5\uAE30\uAC00
        \uB354 \uCC28\uAC00\uC6CC\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uC544\uBB34\uB9AC \uAC00\uBCCD\uAC8C \uB9D0\uD574\uB3C4, \uD0C0\uC778\uC744
        \uD574\uCE58\uB294 \uC77C\uAE4C\uC9C0 \uAC00\uBCBC\uC6CC\uC9C0\uC9C4 \uC54A\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC9C8\uBB38\uC774 \uB9CE\uC740 \uC0AC\uB78C\uC77C\uC218\uB85D \uB2E4\uB8E8\uAE30
        \uC5B4\uB835\uC9C0. \uADF8\uB798\uC11C \uB354 \uC624\uB798 \uB208\uC774 \uAC00."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uD1A0\uB2C8, \uB124 \uB9D0\uC740 \uC774\uC0C1\uD558\uAC8C \uC624\uB798
        \uB0A8\uC544. \uB4E3\uACE0 \uB098\uBA74 \uACF5\uAE30\uAC00 \uB2EC\uB77C\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_3_5_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 01000000030000000600000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uBAA8\uB450\uB97C \uB300\uC2E0 \uC9CA\uC5B4\uC9C0\uB824\uB294 \uD45C\uC815\uC774
        \uB108\uBB34 \uC775\uC219\uD574\uC11C \uB354 \uBD88\uC548\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uD504\uB9AC\uB4DC, \uBA3C\uC800 \uB098\uC11C\uB294 \uB9C8\uC74C\uC774
        \uB298 \uAC00\uC7A5 \uC88B\uC740 \uB2F5\uC774 \uB418\uB294 \uAC74 \uC544\uB2D9\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uC0C8\uD134, \uB124 \uC758\uC2EC\uC774 \uD544\uC694\uD55C \uAC74 \uC548\uB2E4.
        \uADF8\uB798\uB3C4 \uB204\uAD70\uAC00\uB294 \uBA3C\uC800 \uBAB8\uC744 \uC138\uC6CC\uC57C
        \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uD76C\uC0DD\uC744 \uB108\uBB34 \uC27D\uAC8C \uC88B\uC740 \uB9D0\uB85C
        \uD3EC\uC7A5\uD558\uC9C4 \uB9C8. \uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC5D0\uAC90
        \uB298 \uB2E4\uB978 \uBB34\uAC8C\uB85C \uB0A8\uC73C\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_3_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 01000000040000000500000006000000
    Lines:
    - SpeakerId: 1
      Text: "\uB124\uAC00 \uD5A5\uC744 \uB9D0\uD560 \uB54C\uB9C8\uB2E4, \uB204\uAD70\uAC00\uB294
        \uC774\uBBF8 \uB3C4\uB9C8 \uC704\uC5D0 \uC624\uB978 \uAE30\uBD84\uC774 \uB4E4\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB124 \uB9D0\uC740 \uBC30\uACE0\uD508 \uC18C\uB9AC\uC778\uB370, \uB4E3\uACE0
        \uC788\uC73C\uBA74 \uC790\uAFB8 \uB204\uAC00 \uC0AC\uB77C\uC9C8 \uAC83 \uAC19\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uD504\uB9AC\uB4DC \uAC19\uC740 \uC0AC\uB78C\uC740 \uB4DC\uBB3C\uC9C0.
        \uC2A4\uC2A4\uB85C \uBA3C\uC800 \uB098\uC11C\uB824\uB294 \uC0AC\uB78C\uC740
        \uC5B4\uB514\uC11C\uB098 \uB208\uC5D0 \uB744\uAC70\uB4E0."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uAC00\uBCBC\uC6B4 \uB9D0\uB85C \uB118\uAE38 \uC218 \uC5C6\uB294 \uC120\uC774
        \uC788\uC5B4. \uADF8\uAC78 \uB118\uB294\uB2E4\uBA74 \uB098\uB294 \uAC00\uB9CC\uC788\uC9C0
        \uC54A\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_4_5_6_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 01000000040000000500000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uD1A0\uB2C8, \uB124\uAC00 \uC6C3\uC744\uC218\uB85D \uACF5\uAE30\uAC00
        \uB354 \uCC28\uAC00\uC6CC\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC0C8\uD134 \uB9D0\uC774 \uD2C0\uB9B0 \uAC74 \uC544\uB2C8\uC9C0. \uB298
        \uB204\uAD70\uAC00\uB294 \uB4A4\uC5D0 \uB0A8\uC558\uC73C\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC9C8\uBB38\uC774 \uB9CE\uC740 \uC0AC\uB78C\uC77C\uC218\uB85D \uB2E4\uB8E8\uAE30
        \uC5B4\uB835\uC9C0. \uADF8\uB798\uC11C \uB354 \uC624\uB798 \uB208\uC774 \uAC00."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uD1A0\uB2C8, \uB124 \uB9D0\uC740 \uC774\uC0C1\uD558\uAC8C \uC624\uB798
        \uB0A8\uC544. \uB4E3\uACE0 \uB098\uBA74 \uACF5\uAE30\uAC00 \uB2EC\uB77C\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_4_5_7_frag0
    Condition:
