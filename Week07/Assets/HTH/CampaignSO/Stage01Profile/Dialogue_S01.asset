    ComboKey: '#2|#4'
    ParticipantIds: 0200000004000000
    SituationType: "\uD504\uB85C\uD30C\uC77C \uD575\uC2EC\uBB38\uC7A5"
    Trigger: "\uBA54\uC774(#2),\uB8E8\uC774\uC2A4(#4)\uAC00 \uC870\uC0AC \uC9C0\uC815
      \uAD6C\uC5ED\uC5D0 \uB458\uB9CC \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C
      \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC558\uC744 \uC2DC"
    Visibility: 
    FragmentId: P02_04
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 4
      Text: "\uBA54\uC774, \uB098\uB294 \uC774\uC81C \uC870\uAE08 \uBA48\uCD94\uACE0
        \uC2F6\uC5B4. \uB05D\uAE4C\uC9C0 \uAC00\uC57C \uD55C\uB2E4\uB294 \uB9D0\uC740
        \uC54C\uACA0\uB294\uB370\u2026 \uACC4\uC18D \uC55E\uC73C\uB85C\uB9CC \uAC00\uBA74,
        \uB0A8\uB294 \uAC8C \uBB54\uC9C0 \uBAA8\uB974\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uB8E8\uC774\uC2A4, \uBA48\uCD94\uACE0 \uC2F6\uB2E4\uB294 \uB9D0\uC774
        \uADF8\uB807\uAC8C \uC27D\uAC8C \uB098\uC628\uB2E4\uACE0? \uB204\uAD70\uAC00\uC5D0\uAC8C\uB294
        \uADF8 \uB9D0\uC774 \uC9C0\uAE08\uAE4C\uC9C0 \uBD99\uC7A1\uC544 \uC628 \uBAA8\uB4E0
        \uAC8C \uD5DB\uB418\uB2E4\uB294 \uB9D0\uCC98\uB7FC \uB4E4\uB9B4 \uC218\uB3C4
        \uC788\uB2E4."
