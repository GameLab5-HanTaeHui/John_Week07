    SituationType: "\uD504\uB85C\uD30C\uC77C \uD575\uC2EC\uBB38\uC7A5"
    Trigger: "\uC5D4\uBE44(#1), \uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4), \uD1A0\uB2C8(#5),
      4\uBA85\uC774 \uC870\uC0AC \uAD6C\uC5ED\uC5D0 \uC788\uC744 \uB54C"
    Visibility: 
    FragmentId: P01_05
    TriggerDeadIds: 
    UnlockConditionId: P05_01
    HintOfConditionId: 
    Lines:
    - SpeakerId: 5
      Text: "\uB370\uC6B0\uC2A4 \uC5B8\uB2C8\uB791 \uB8E8\uC774\uC2A4 \uC624\uBE60\uB294
        \uCC38 \uC2E0\uAE30\uD574. \uD55C\uCABD\uC774 \uC870\uAE08\uB9CC \uD754\uB4E4\uB824\uB3C4,
        \uB2E4\uB978 \uCABD \uD45C\uC815\uAE4C\uC9C0 \uAC19\uC774 \uBB34\uB108\uC9C0\uC796\uC544.
        ...\uB370\uC6B0\uC2A4 \uC5B8\uB2C8\uD55C\uD14C \uC7A5\uB09C\uCCD0\uC57C\uC9C0!
        \uAE84\uD558\uD558!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uC557! \uAE5C\uC9DD \uB180\uB790\uC796\uC544\uC694.  \uD1A0\uB2C8,
        \uC7A5\uB09C\uAC10\uC774\uB77C\uB3C4 \uCE7C\uC744 \uADF8\uB807\uAC8C \uD718\uB450\uB974\uBA74
        \uC704\uD5D8\uD569\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uAD1C\uCC2E\uC544, \uB370\uC6B0\uC2A4? \uD1A0\uB2C8\uB294 \uB180\uACE0
        \uC2F6\uC5C8\uC744 \uBFD0\uC774\uB2C8\uAE4C \uC6A9\uC11C\uD574 \uC8FC\uC790.
        \uC5B4... \uD1A0\uB2C8, \uADF8\uAC74 \uC9C4\uC9DC \uCE7C..."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uAE84\uC545!! \uD1A0\uB2C8!! \uC9C0\uAE08 \uBB50\uD558\uB294\uAC70\uC5D0\uC694!
        \uCE7C\uC744 \uB0B4\uB824\uB193\uC73C\uC138\uC694!!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uD1A0\uB2C8!! \uADF8\uB9CC\uB46C!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
