%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1266fe8242184fc43b35ffd43f99155e, type: 3}
  m_Name: Dialogue_S01
  m_EditorClassIdentifier: Assembly-CSharp::HTH.Campaign.CampaignDialogueSO
  _stageId: CampaignMode
  _dialogues:
  - DialogueId: CORE_P01_01
    ParticipantsRaw: 1
    Type: 0
    Scope: 0
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P01_01
    Lines:
    - TextId: 1
      Text: "\uB2E4\uB4E4 \uC544\uBB34\uB807\uC9C0 \uC54A\uAC8C \uC6C3\uACE0 \uC788\uB124.
        \uC800 \uC628\uAE30\uAC00 \uC5BC\uB9C8\uB098 \uD2B9\uBCC4\uD55C\uC9C0 \uBAA8\uB97C
        \uAC70\uC57C. \uB098\uB294 \uD55C \uBC88\uB3C4 \uACBD\uD5D8\uD558\uC9C0 \uBABB\uD588\uB358
        \uC628\uAE30\uB97C..."
    - TextId: 1
      Text: "...\uB098\uC5D0\uAC8C\uB3C4 \uBD80\uBAA8\uB2D8\uC774 \uC788\uC5C8\uB354\uB77C\uBA74
        \uC800\uB807\uAC8C \uB530\uB73B\uD558\uAC8C \uC6C3\uC744 \uC218 \uC788\uC5C8\uC744\uAE4C."
    DeveloperNote: "[P01_01] \uC5D4\uBE44 / \uC720\uAE30 / \uACB0\uD54D\n\uC870\uAC74:
      \uC5D4\uBE44(#1)\uAC00 \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD63C\uC790
      \uC788\uACE0, \uBAA8\uB4E0 \uAD6C\uC5ED\uC5D0\uC11C \uC0AC\uB9DD \uC0AC\uAC74\uC774
      \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC744 \uC2DC\n\uD78C\uD2B8: \uC5D4\uBE44\uB294
      \uAC00\uB054, \uD63C\uC790\uC11C \uC6A9\uBCD1\uB2E8\uC758 \uD3C9\uD654\uB85C\uC6B4
      \uC77C\uC0C1\uC744 \uBC14\uB77C\uBCF8\uB2E4."
  - DialogueId: CORE_P01_02
    ParticipantsRaw: 1,5
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P01_02
    Lines:
    - TextId: 5
      Text: "\uC5D4\uBE44\uB294 \uCC38 \uB2E4\uC815\uD558\uAC8C \uC6C3\uC5B4!"
    - TextId: 1
      Text: "\uACE0\uB9C8\uC6CC \uD1A0\uB2C8. \uD1A0\uB2C8\uB3C4 \uC6C3\uC74C\uC774
        \uCC38 \uB530\uB73B\uD574."
    - TextId: 5
      Text: "\uADF8\uB807\uAC8C \uC6C3\uB294\uAC70, \uB9C8\uC655\uC774 \uC9C1\uC811
        \uAC00\uB974\uCE5C\uAC70\uC9C0?\n\uD1A0\uB2C8\uB294 \uB9C8\uC655\uC131\uC5D0\uC11C
        \uC77C\uD588\uC5C8\uC5B4. \uC2A4\uD30C\uC774\uB97C \uC5B4\uB5BB\uAC8C \uAC00\uB974\uCE58\uB294\uC9C0
        \uB2E4 \uC54C\uC544."
    - TextId: 1
      Text: "\uBB34\uC2A8 \uC18C\uB9AC\uB97C \uD558\uB294\uAC70\uC57C \uD1A0\uB2C8?
        \uC7A5\uB09C\uC774 \uC9C0\uB098\uCCD0.\n\uB9C8\uC655\uC744 \uD1A0\uBC8C\uD558\uAE30
        \uC704\uD574 \uC9C0\uAE08\uAE4C\uC9C0 \uB3D9\uB8CC\uB4E4\uACFC \uD568\uAED8
        \uD574 \uC628\uAC70\uC796\uC544."
    - TextId: 5
      Text: "\uC544\uD558 \uADF8\uB7F0 \uCEE8\uC149? \uC54C\uACA0\uC5B4~\n\uAC71\uC815\uD558\uC9C0
        \uB9C8! \uC544\uBB34\uD55C\uD14C\uB3C4 \uC598\uAE30 \uC548 \uD574!"
    DeveloperNote: "[P01_02] \uC5D4\uBE44 / \uC2A4\uD30C\uC774 / \uC784\uBB34\n\uC870\uAC74:
      \uC5D4\uBE44(#1)\uC640 \uD1A0\uB2C8(#5), 2\uBA85\uB9CC \uC870\uC0AC \uC9C0\uC815
      \uAD6C\uC5ED\uC5D0 \uD568\uAED8 \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C
      \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8:
      \uD1A0\uB2C8\uB294 \uC5D4\uBE44\uC640 \uB458\uB9CC \uB0A8\uC558\uC744 \uB54C,
      \uB2E4\uC815\uD568 \uC18D \uBD80\uC790\uC5F0\uC2A4\uB7EC\uC6C0\uC744 \uB208\uCE58\uCC4C
      \uC218 \uC788\uC744\uC9C0 \uBAA8\uB978\uB2E4."
  - DialogueId: CORE_P01_03
    ParticipantsRaw: 1,3,4
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P01_03
    Lines:
    - TextId: 1
      Text: "\uB8E8\uC774\uC2A4, \uB370\uC6B0\uC2A4\uC640 \uC5B8\uC81C \uADF8\uB807\uAC8C
        \uCE5C\uD574\uC9C4\uAC70\uC57C? \uC608\uC804\uC5D4 \uC548\uADF8\uB7AC\uB358
        \uAC83 \uAC19\uC740\uB370 \uC774\uC81C\uB294 \uD56D\uC0C1 \uAC19\uC774 \uC788\uB124?"
    - TextId: 3
      Text: "\uC800\uB294 \uC5EC\uC2E0\uB2D8\uC758 \uC774\uB984\uC73C\uB85C \uB8E8\uC774\uC2A4\uB97C
        \uCE58\uB8CC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uD658\uC790\uB97C \uB3CC\uBCF4\uAE30
        \uC704\uD574 \uAC00\uAE4C\uC774 \uC788\uB294 \uAC74 \uB2F9\uC5F0\uD55C \uC77C\uC785\uB2C8\uB2E4."
    - TextId: 4
      Text: "\uB9DE\uC544. \uB370\uC6B0\uC2A4\uB294 \uB098\uB97C \uBC24\uB0AE\uC73C\uB85C
        \uCE58\uB8CC\uD574 \uC8FC\uACE0 \uC788\uC5B4. \uC740\uD61C\uB97C \uC5B4\uB5BB\uAC8C
        \uAC1A\uC744\uC9C0 \uBAA8\uB974\uACA0\uC744 \uC815\uB3C4\uB85C..."
    - TextId: 1
      Text: "\uADF8\uB807\uAD6C\uB098. \uB8E8\uC774\uC2A4, \uADF8\uB7FC \uC7A0\uAE50
        \uC0B0\uCC45\uC774\uB77C\uB3C4 \uAC08\uB798? \uAC00\uB054\uC740 \uBC14\uAE65
        \uACF5\uAE30\uB3C4 \uC42C\uBA74 \uD68C\uBCF5\uC5D0 \uB354 \uC88B\uC744\uAC70\uC57C."
    - TextId: 3
      Text: "\uC704\uD5D8\uD560 \uC218\uB3C4 \uC788\uC73C\uB2C8 \uC81C\uAC00 \uB8E8\uC774\uC2A4\uC640
        \uB2E4\uB140\uC624\uACA0\uC2B5\uB2C8\uB2E4. \uB8E8\uC774\uC2A4, \uAC00\uC2DC\uC8E0."
    - TextId: 4
      Text: "\uC74C... \uADF8\uB798. \uB2E4\uC74C\uC5D0 \uBD10, \uC5D4\uBE44."
    - TextId: 1
      Text: "\uC5B4.. \uADF8\uB798, \uC798 \uB2E4\uB140\uC640."
    DeveloperNote: "[P01_03] \uC5D4\uBE44 / \uAD00\uACC4\uC640 \uC628\uAE30 \uB3D9\uACBD\n\uC870\uAC74:
      \uC5D4\uBE44(#1),\uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4), 3\uBA85\uB9CC
      \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD568\uAED8 \uC788\uACE0, \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0
      \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8: \uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4
      \uC0AC\uC774\uC5D0 \uC5D4\uBE44\uB97C \uC138\uC6B0\uBA74, \uC5D4\uBE44\uAC00
      \uAC00\uC7A5 \uD754\uB4E4\uB9B4 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P01_04
    ParticipantsRaw: 1,2,7
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: "P07_02 \uB610\uB294 P07_03"
    RewardFragmentId: P01_04
    Lines:
    - TextId: 2
      Text: "\uB9C8\uC655 \uD1A0\uBC8C\uC744 \uBA48\uCD9C \uC218\uB294 \uC5C6\uC5B4.\n\uC5EC\uAE30\uC11C
        \uBB3C\uB7EC\uC11C\uBA74, \uC9C0\uAE08\uAE4C\uC9C0 \uC783\uC5B4\uC628 \uAC83\uB4E4\uC774
        \uC804\uBD80 \uC544\uBB34 \uC758\uBBF8\uB3C4 \uC5C6\uC5B4\uC838."
    - TextId: 7
      Text: "\uADF8 \uB9D0\uC740 \uD56D\uC0C1 \uB0A8\uC740 \uC0AC\uB78C\uB4E4 \uC785\uC5D0\uC11C
        \uB098\uC624\uB354\uB77C.\n\uC55E\uC73C\uB85C \uAC00\uC57C \uD55C\uB2E4\uB294
        \uB9D0 \uB4A4\uC5D0 \uB204\uAC00 \uB0A8\uB294\uC9C0\uB294 \uC544\uBB34\uB3C4
        \uBB3B\uC9C0 \uC54A\uC544."
    - TextId: 1
      Text: "\uBA54\uC774\uC758 \uB9D0\uC774 \uB9DE\uC544. \uC5EC\uAE30\uC11C \uBA48\uCD94\uBA74
        \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC774 \uACE0\uD1B5\uBC1B\uAC8C \uB420\uAC70\uC57C."
    - TextId: 7
      Text: "...\uB300\uC758 \uC55E\uC5D0 \uC791\uC740 \uD76C\uC0DD\uC740 \uC5B4\uCA54
        \uC218 \uC5C6\uB2E4\uB294\uAC70\uC9C0?"
    - TextId: 1
      Text: "\uC0C8\uD134! \uBA54\uC774\uC758 \uB73B\uC740 \uADF8\uB7F0\uAC8C \uC544\uB2C8\uC796\uC544.
        \uB108\uBB34 \uBE44\uAF2C\uBA74 \uBA54\uC774\uAC00 \uC0C1\uCC98\uBC1B\uC744\uAC70\uC57C."
    - TextId: 2
      Text: "\uC544\uB2C8, \uB098\uB294... \uADF8\uAC8C \uC544\uB2C8\uB77C.. \uBA54\uC774,
        \uB0B4 \uB9D0\uC740..."
    - TextId: 1
      Text: "\uB2E4\uC74C\uC5D0 \uC598\uAE30\uD574 \uC0C8\uD134.\"\n\n(\uD63C\uC7A3\uB9D0,
        \uBE84\uC9C0 \uACE0\uBBFC\uC911)'\uC0C8\uD134\uC758 \uB9D0\uC774 \uB9DE\uC544.
        \uD558\uC9C0\uB9CC \uC0C8\uD134\uC740 \uB108\uBB34 \uB208\uCE58\uAC00 \uBE60\uB974\uACE0
        \uC608\uB9AC\uD574. \uAC00\uC7A5 \uBA3C\uC800 \uACE0\uB9BD\uC2DC\uCF1C\uC57C
        \uD574."
    DeveloperNote: "[P01_04] \uC5D4\uBE44 / \uAD00\uACC4\uB97C \uBB34\uB108\uB728\uB9B4
      \uC874\uC7AC\uB77C\uB294 \uC790\uAC01\n\uC870\uAC74: P07_02 \uB610\uB294 P07_03\uC744
      \uD68D\uB4DD \uD55C \uC0C1\uD0DC\uC5D0\uC11C \uC5D4\uBE44(#1),\uBA54\uC774(#2),\uC0C8\uD134(#7),
      3\uBA85\uB9CC \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uC788\uC744 \uC2DC\n\uD78C\uD2B8:
      \uBA54\uC774\uC640 \uC0C8\uD134\uC774 \uBD80\uB52A\uD788\uB294 \uC790\uB9AC\uC5D0
      \uC5D4\uBE44\uAC00 \uC788\uC73C\uBA74, \uC5D4\uBE44\uB294 \uD2C8\uC744 \uADF8\uB0E5
      \uC9C0\uB098\uCE58\uC9C0 \uC54A\uC744 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P01_05
    ParticipantsRaw: 1,3,4,5
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P01_05
    Lines:
    - TextId: 5
      Text: "\uB370\uC6B0\uC2A4 \uC5B8\uB2C8\uB791 \uB8E8\uC774\uC2A4 \uC624\uBE60\uB294
        \uCC38 \uC2E0\uAE30\uD574.\n\uD55C\uCABD\uC774 \uC870\uAE08\uB9CC \uD754\uB4E4\uB824\uB3C4,
        \uB2E4\uB978 \uCABD \uD45C\uC815\uAE4C\uC9C0 \uAC19\uC774 \uBB34\uB108\uC9C0\uC796\uC544.\n...\uB370\uC6B0\uC2A4
        \uC5B8\uB2C8\uD55C\uD14C \uC7A5\uB09C\uCCD0\uC57C\uC9C0! \uAE84\uD558\uD558!"
    - TextId: 3
      Text: "\uC557! \uAE5C\uC9DD \uB180\uB790\uC796\uC544\uC694. \n\uD1A0\uB2C8,
        \uC7A5\uB09C\uAC10\uC774\uB77C\uB3C4 \uCE7C\uC744 \uADF8\uB807\uAC8C \uD718\uB450\uB974\uBA74
        \uC704\uD5D8\uD569\uB2C8\uB2E4."
    - TextId: 4
      Text: "\uAD1C\uCC2E\uC544, \uB370\uC6B0\uC2A4?\n\uD1A0\uB2C8\uB294 \uB180\uACE0
        \uC2F6\uC5C8\uC744 \uBFD0\uC774\uB2C8\uAE4C \uC6A9\uC11C\uD574 \uC8FC\uC790.\n\uC5B4...
        \uD1A0\uB2C8, \uADF8\uAC74 \uC9C4\uC9DC \uCE7C..."
    - TextId: 3
      Text: "\uAE84\uC545!! \uD1A0\uB2C8!! \uC9C0\uAE08 \uBB50\uD558\uB294\uAC70\uC5D0\uC694!\n\uCE7C\uC744
        \uB0B4\uB824\uB193\uC73C\uC138\uC694!!"
    - TextId: 1
      Text: "\uD1A0\uB2C8!! \uADF8\uB9CC\uB46C!"
    - TextId: 1
      Text: "(\uD63C\uC7A3\uB9D0)'\uB098\uB294 \uB108\uD76C\uAC00 \uB2E4\uCE58\uC9C0
        \uC54A\uC558\uC73C\uBA74 \uC88B\uACA0\uC5B4. \uC815\uB9D0\uB85C.\n\uADF8\uB7F0\uB370
        \uC65C \uC790\uAFB8\uB9CC \uB458 \uC911 \uD558\uB098\uAC00 \uBB34\uB108\uC9C0\uBA74
        \uB2E4\uB978 \uD55C\uCABD\uC774 \uC5B4\uB5BB\uAC8C \uB420\uC9C0 \uAD81\uAE08\uD574\uC9C8\uAE4C."
    DeveloperNote: "[P01_05] \uC5D4\uBE44 / \uC9C0\uD0A4\uACE0 \uD754\uB4DC\uB294
      \uC790\uAE30\uBAA8\uC21C\n\uC870\uAC74: \uC5D4\uBE44(#1), \uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4),
      \uD1A0\uB2C8(#5), 4\uBA85\uC774 \uC870\uC0AC \uAD6C\uC5ED\uC5D0 \uC788\uC744
      \uB54C\n\uD78C\uD2B8: \uC6A9\uBCD1\uB2E8 \uB0B4\uC5D0\uC11C\uB3C4 \uC720\uB3C5
      \uAE4A\uC740 \uAD00\uACC4\uC758 \uB450 \uC0AC\uB78C\uACFC \uADF8\uAC83\uC744
      \uBB34\uB108\uB728\uB9AC\uB824 \uD558\uB294 \uC0AC\uB78C, \uADF8\uB9AC\uACE0
      \uC5D4\uBE44\uAC00 \uD55C\uACF3\uC5D0 \uBAA8\uC774\uBA74 \uC5D4\uBE44\uC758
      \uB9C8\uC74C\uC774 \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P02_01
    ParticipantsRaw: 2
    Type: 0
    Scope: 1
    Alive: 1
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P02_01
    Lines:
    - TextId: 2
      Text: "\uB204\uAD6C\uC758 \uC8FD\uC74C\uC5D0\uB3C4 \uD754\uB4E4\uB9AC\uC9C0
        \uB9C8\uB77C, \uBA54\uC774.\n\uC0B4\uC544\uB0A8\uC740 \uAC83\uC5D0 \uC9D1\uC911\uD574\uB77C.
        \uB098\uB294 \uC0B4\uC544\uB0A8\uC558\uB2E4.\n\uB0B4\uAC00 \uAC00\uBB38\uC758
        \uBA78\uC871\uC5D0\uB3C4 \uC0B4\uC544 \uC788\uB294 \uAC83\uC5D0\uB294 \uC774\uC720\uAC00
        \uC788\uB2E4.\n\uADF8\uB798\uC57C\uB9CC \uD55C\uB2E4."
    DeveloperNote: "[P02_01] \uBA54\uC774 / \uC0DD\uC874\uC790 \uAC15\uBC15\n\uC870\uAC74:
      \uC0AC\uB9DD \uC0AC\uAC74\uC774 \uBC1C\uC0DD\uD55C \uC0C1\uD0DC\uC5D0\uC11C,
      \uBA54\uC774(#2) \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD63C\uC790
      \uC788\uACE0, \uBA54\uC774\uAC00 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC744 \uC2DC\n\uD78C\uD2B8:
      \uBA54\uC774\uB97C \uD63C\uC790 \uB454\uB2E4\uBA74, \uB204\uAD70\uAC00\uC758
      \uC8FD\uC74C\uC5D0\uB3C4 \uC808\uB300 \uB3D9\uC694\uD558\uC9C0 \uC54A\uB294
      \uBAA8\uC2B5\uC744 \uBCFC \uC218 \uC788\uB2E4."
  - DialogueId: CORE_P02_02
    ParticipantsRaw: 2
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P02_02
    Lines:
    - TextId: 2
      Text: "\uC601\uC6C5\uC774\uB77C\uC11C \uC0B4\uC778\uB9C8\uB97C \uC4F0\uB7EC\uD2B8\uB9B0
        \uAC8C \uC544\uB2C8\uB2E4.\n\uAC00\uBB38\uC758 \uC774\uB984\uC744 \uB418\uC0B4\uB9AC\uAE30
        \uC704\uD568\uC77C \uBFD0."
    - TextId: 2
      Text: "\uD558\uC9C0\uB9CC... \uC0B4\uC544\uAC00\uB294 \uB370 \uC774\uC720\uAC00
        \uC5C6\uB2E4\uB294 \uB9C8\uC9C0\uB9C9 \uB9D0\uC740 \uB300\uCCB4..."
    DeveloperNote: "[P02_02] \uBA54\uC774 / \uBA54\uC774\uC758 \uC99D\uBA85 \uBC29\uC2DD\n\uC870\uAC74:
      \uBA54\uC774(#2) \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uB458\n\uD78C\uD2B8:
      \uBA54\uC774\uAC00 \uC545\uC744 \uCC98\uB2E8\uD558\uB294 \uC7A5\uBA74\uC744
      \uBCF4\uBA74 \uBA54\uC774\uAC00 \uB9C8\uC655 \uD1A0\uBC8C\uC5D0 \uB300\uD574
      \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uACE0 \uC788\uB294\uC9C0 \uC54C \uC218
      \uC788\uC744 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P02_03
    ParticipantsRaw: 1,2,4
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P02_03
    Lines:
    - TextId: 4
      Text: "\uC774\uC81C \uC870\uAE08\uC740 \uBA48\uCDB0\uB3C4 \uB418\uC9C0 \uC54A\uC744\uAE4C.
        \uB05D\uAE4C\uC9C0 \uAC00\uC57C \uD55C\uB2E4\uB294 \uB9D0\uC774\u2026 \uAC00\uB054\uC740
        \uB108\uBB34 \uBA40\uAC8C \uB290\uAEF4\uC838."
    - TextId: 1
      Text: "\uB8E8\uC774\uC2A4, \uADF8\uB7EC\uBA74 \uC6B0\uB9AC\uB294 \uB9C8\uC655
        \uD1A0\uBC8C\uC744 \uBA3C\uC800 \uCD9C\uBC1C\uD560\uAC8C. \uBAB8\uC774 \uD68C\uBCF5\uB418\uBA74
        \uCC9C\uCC9C\uD788 \uB530\uB77C\uC624\uB294 \uAC74 \uC5B4\uB54C?"
    - TextId: 2
      Text: "\uD68C\uBCF5\uC774 \uC5BC\uB9C8\uB098 \uAC78\uB9AC\uB4E0 \uAE30\uB2E4\uB9B4
        \uC218 \uC788\uB2E4. \uD754\uB4E4\uB9AC\uC9C0 \uB9C8.\n\uB108\uD76C\uAC00
        \uC0AC\uB77C\uC9C0\uBA74 \uB0B4\uAC00 \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uAC83\uC744
        \uC99D\uBA85\uD574 \uC904 \uC0AC\uB78C\uB3C4 \uC0AC\uB77C\uC9C0\uACE0 \uB9D0\uC544."
    DeveloperNote: "[P02_03] \uBA54\uC774 / \uB3D9\uB8CC = \uC99D\uC778\n\uC870\uAC74:
      \uC5D4\uBE44(#1),\uBA54\uC774(#2),\uB8E8\uC774\uC2A4(#4), 3\uBA85\uB9CC \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD568\uAED8 \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815
      \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC558\uC744
      \uC2DC\n\uD78C\uD2B8: \uBA48\uCD94\uACE0 \uC2F6\uC740 \uC0AC\uB78C\uACFC \uAD00\uACC4\uC758
      \uD2C8\uC744 \uC77D\uB294 \uC5D4\uBE44\uAC00 \uD568\uAED8 \uC788\uC744 \uB54C,
      \uBA54\uC774\uAC00 \uC65C \uB3D9\uB8CC\uB97C \uB05D\uAE4C\uC9C0 \uBD99\uC7A1\uC73C\uB824
      \uD558\uB294\uC9C0 \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P02_04
    ParticipantsRaw: 2,4
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P02_04
    Lines:
    - TextId: 4
      Text: "\uBA54\uC774, \uB098\uB294 \uC774\uC81C \uC870\uAE08 \uBA48\uCD94\uACE0
        \uC2F6\uC5B4.\n\uB05D\uAE4C\uC9C0 \uAC00\uC57C \uD55C\uB2E4\uB294 \uB9D0\uC740
        \uC54C\uACA0\uB294\uB370\u2026\n\uACC4\uC18D \uC55E\uC73C\uB85C\uB9CC \uAC00\uBA74,
        \uB0A8\uB294 \uAC8C \uBB54\uC9C0 \uBAA8\uB974\uACA0\uC5B4."
    - TextId: 2
      Text: "\uB8E8\uC774\uC2A4, \uBA48\uCD94\uACE0 \uC2F6\uB2E4\uB294 \uB9D0\uC774
        \uADF8\uB807\uAC8C \uC27D\uAC8C \uB098\uC628\uB2E4\uACE0?\n\uB204\uAD70\uAC00\uC5D0\uAC8C\uB294
        \uADF8 \uB9D0\uC774 \uC9C0\uAE08\uAE4C\uC9C0 \uBD99\uC7A1\uC544 \uC628 \uBAA8\uB4E0
        \uAC8C \uD5DB\uB418\uB2E4\uB294 \uB9D0\uCC98\uB7FC \uB4E4\uB9B4 \uC218\uB3C4
        \uC788\uB2E4."
    DeveloperNote: "[P02_04] \uBA54\uC774 / \uBA48\uCDA4 = \uC758\uBBF8 \uBD95\uAD34\n\uC870\uAC74:
      \uBA54\uC774(#2),\uB8E8\uC774\uC2A4(#4)\uAC00 \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0
      \uB458\uB9CC \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C
      \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8:
      \uBA54\uC774\uC640 \uB8E8\uC774\uC2A4\uB97C \uB458\uB9CC \uB450\uBA74, \uC804\uC9C4\uACFC
      \uC815\uC9C0\uAC00 \uAC00\uC7A5 \uC9C1\uC811\uC801\uC73C\uB85C \uBD80\uB52A\uD790
      \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P02_05
    ParticipantsRaw: 2,6,7
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: P02_03
    RewardFragmentId: P02_05
    Lines:
    - TextId: 6
      Text: "\u201C\uB204\uAD70\uAC00 \uD76C\uC0DD\uD558\uAE30 \uC704\uD574 \uB0A8\uC544\uC57C
        \uD55C\uB2E4\uBA74, \uC81C\uAC00 \uB0A8\uACA0\uC2B5\uB2C8\uB2E4"
    - TextId: 7
      Text: "\u201C\uB610 \uB204\uAC00 \uB0A8\uB294\uC9C0\uBD80\uD130 \uC815\uD558\uB294
        \uAC70\uC57C?"
    - TextId: 2
      Text: "\uC544\uB2C8. \uC544\uBB34\uB3C4 \uB0A8\uAE30\uC9C0 \uC54A\uC544.\n\uB300\uC2E0
        \uC8FD\uACA0\uB2E4\uB294 \uB9D0\uB3C4 \uBA48\uCD94\uC790\uB294 \uB9D0\uB3C4
        \uD544\uC694 \uC5C6\uC5B4. \uB05D\uAE4C\uC9C0 \uD568\uAED8 \uAC00. \n\uADF8\uB798\uC57C
        \uC6B0\uB9AC\uAC00 \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uC774\uC720\uAC00 \uC0AC\uB77C\uC9C0\uC9C0
        \uC54A\uC544."
    DeveloperNote: "[P02_05] \uBA54\uC774 / \uBAA8\uB450\uB97C \uB04C\uACE0 \uAC00\uB294
      \uC704\uD5D8\uC131\n\uC870\uAC74: P02_03\uC744 \uD68D\uB4DD\uD55C \uC0C1\uD0DC\uC5D0\uC11C
      \uBA54\uC774(#2),\uD504\uB9AC\uB4DC(#6),\uC0C8\uD134(#7) 3\uBA85\uB9CC \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD568\uAED8 \uC788\uC744 \uC2DC\n\uD78C\uD2B8:
      \uD504\uB9AC\uB4DC\uC640 \uC0C8\uD134\uC774 \uB3D9\uC2DC\uC5D0 \uC788\uC73C\uBA74,
      \uBA54\uC774\uC758 \uC804\uC9C4\uC774 \uCC45\uC784\uC778\uC9C0 \uAC15\uC694\uC778\uC9C0
      \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4.\n(\uB3D9\uB8CC\uB97C \uB300\uD558\uB294
      \uBA54\uC774\uC758 \uBC29\uC2DD\uC744 \uC54C \uC218 \uC788\uB294 2\uBC88 \uB300\uD654
      \uC870\uAC01\uC774 \uD544\uC694\uD558\uB2E4.)"
  - DialogueId: CORE_P03_01
    ParticipantsRaw: 3
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P03_01
    Lines:
    - TextId: 3
      Text: "\uC5EC\uC2E0\uB2D8, \uB8E8\uC774\uC2A4\uB97C \uD5A5\uD55C \uC774 \uB9C8\uC74C\uC740
        \uACB0\uCF54 \uC695\uB9DD\uC774 \uC544\uB2D9\uB2C8\uB2E4.\n\uADF8\uC800 \uBD88\uC30D\uD55C
        \uC790\uB97C \uAC00\uC5FE\uAC8C \uC5EC\uAE30\uB294 \uD5CC\uC2E0\uC77C \uBFD0\uC785\uB2C8\uB2E4.
        \n\uC5EC\uC2E0\uB2D8\uC758 \uC774\uB984 \uC544\uB798 \uADF8\uBD84 \uACC1\uC5D0
        \uBA38\uBB3C\uACA0\uC2B5\uB2C8\uB2E4."
    DeveloperNote: "[P03_01] \uB370\uC6B0\uC2A4 / \uC0AC\uB791\uC758 \uC2E0\uC131\uD654\n\uC870\uAC74:
      \uB370\uC6B0\uC2A4(#3)\uAC00 \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD63C\uC790
      \uC788\uACE0, \uB8E8\uC774\uC2A4(#4)\uAC00 \uC0DD\uC874\uD574 \uC788\uC73C\uBA70,
      \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0
      \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8: \uB370\uC6B0\uC2A4\uAC00 \uD63C\uC790
      \uAE30\uB3C4\uB97C \uD560 \uB54C, \uB8E8\uC774\uC2A4\uC5D0 \uB300\uD574 \uC5B4\uB5BB\uAC8C
      \uC0DD\uAC01\uD558\uB294\uC9C0 \uC54C \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P03_02
    ParticipantsRaw: 3,4
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P03_02
    Lines:
    - TextId: 4
      Text: "\uC74C.. \uC624\uB298\uC740 \uBAB8 \uC0C1\uD0DC\uAC00 \uAD1C\uCC2E\uC740\uB370,
        \uB098\uAC00\uC11C \uB3D9\uB8CC\uB4E4\uC744 \uB3C4\uC640 \uC0AC\uB0E5\uC774\uB77C\uB3C4
        \uD574\uBCFC\uAE4C."
    - TextId: 3
      Text: "\"\uB8E8\uC774\uC2A4\uB294 \uC26C\uACE0 \uACC4\uC138\uC694. \uC81C\uAC00
        \uB300\uC2E0 \uB2E4\uB140\uC624\uACA0\uC2B5\uB2C8\uB2E4.\""
    - TextId: 4
      Text: "\"\uD558\uC9C0\uB9CC \uB370\uC6B0\uC2A4\uB294 \uC0AC\uB0E5 \uD574\uBCF8
        \uC801 \uC5C6\uC796\uC544? \uD798\uB4E4\uACE0 \uC704\uD5D8\uD560\uAC70\uC57C.
        \uB0B4\uAC00 \uAC08\uAC8C.\""
    - TextId: 3
      Text: "\uB8E8\uC774\uC2A4, \uB2F9\uC2E0\uC5D0\uAC8C \uD5CC\uC2E0\uD558\uB294
        \uAC83\uC774 \uC800\uC758 \uC758\uBB34\uC774\uC790 \uAE30\uC068\uC785\uB2C8\uB2E4.
        \n\uB8E8\uC774\uC2A4\uB97C \uB300\uC2E0\uD574 \uC0AC\uB0E5\uC744 \uD558\uB294
        \uAC83\uB3C4 \uC81C\uAC90 \uD798\uB4E0 \uAE30\uB3C4\uB098 \uC218\uD589\uACFC
        \uAC19\uC544\uC694.\n\uADF8\uB7EC\uB2C8 \uB8E8\uC774\uC2A4\uB294 \uC544\uBB34\uAC83\uB3C4
        \uD558\uC9C0 \uC54A\uC544\uB3C4 \uAD1C\uCC2E\uC2B5\uB2C8\uB2E4."
    - TextId: 4
      Text: "\uADF8\uB807\uAC8C \uB9D0\uD574 \uC900\uB2E4\uBA74... \uC870\uAE08 \uC26C\uACE0
        \uC788\uC744\uAC8C."
    DeveloperNote: "[P03_02] \uB370\uC6B0\uC2A4 / \uB8E8\uC774\uC2A4 = \uC0B6\uC758
      \uC758\uBBF8 / \uAD6C\uC6D0\n\uC870\uAC74: \uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4)\uAC00
      \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uB458\uB9CC \uC788\uACE0, \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0
      \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8: \uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4\uB9CC
      \uB0A8\uAE30\uBA74, \uB458 \uC0AC\uC774\uAC00 \uC5BC\uB9C8\uB098 \uB2EB\uD78C
      \uC138\uACC4\uC778\uC9C0 \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P03_03
    ParticipantsRaw: 1,3,4
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P03_03
    Lines:
    - TextId: 1
      Text: "\uB8E8\uC774\uC2A4, \uB370\uC6B0\uC2A4\uC640 \uC5B8\uC81C \uADF8\uB807\uAC8C
        \uCE5C\uD574\uC9C4\uAC70\uC57C? \uC608\uC804\uC5D4 \uC548\uADF8\uB7AC\uB358
        \uAC83 \uAC19\uC740\uB370 \uC774\uC81C\uB294 \uD56D\uC0C1 \uAC19\uC774 \uC788\uB124?"
    - TextId: 3
      Text: "\uC800\uB294 \uC5EC\uC2E0\uB2D8\uC758 \uC774\uB984\uC73C\uB85C \uB8E8\uC774\uC2A4\uB97C
        \uCE58\uB8CC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uD658\uC790\uB97C \uB3CC\uBCF4\uAE30
        \uC704\uD574 \uAC00\uAE4C\uC774 \uC788\uB294 \uAC74 \uB2F9\uC5F0\uD55C \uC77C\uC785\uB2C8\uB2E4."
    - TextId: 4
      Text: "\uB9DE\uC544. \uB370\uC6B0\uC2A4\uB294 \uB098\uB97C \uBC24\uB0AE\uC73C\uB85C
        \uCE58\uB8CC\uD574 \uC8FC\uACE0 \uC788\uC5B4. \uC740\uD61C\uB97C \uC5B4\uB5BB\uAC8C
        \uAC1A\uC744\uC9C0 \uBAA8\uB974\uACA0\uC744 \uC815\uB3C4\uB85C..."
    - TextId: 1
      Text: "\uADF8\uB807\uAD6C\uB098. \uB8E8\uC774\uC2A4, \uADF8\uB7FC \uC7A0\uAE50
        \uC0B0\uCC45\uC774\uB77C\uB3C4 \uAC08\uB798? \uAC00\uB054\uC740 \uBC14\uAE65
        \uACF5\uAE30\uB3C4 \uC42C\uBA74 \uD68C\uBCF5\uC5D0 \uB354 \uC88B\uC744\uAC70\uC57C."
    - TextId: 3
      Text: "\uC704\uD5D8\uD560 \uC218\uB3C4 \uC788\uC73C\uB2C8 \uC81C\uAC00 \uB370\uC6B0\uC2A4\uC640
        \uB2E4\uB140\uC624\uACA0\uC2B5\uB2C8\uB2E4. \uB370\uC6B0\uC2A4, \uAC00\uC2DC\uC8E0."
    - TextId: 4
      Text: "\uC74C... \uADF8\uB798. \uB2E4\uC74C\uC5D0 \uBD10, \uC5D4\uBE44."
    - TextId: 1
      Text: "\uC5B4.. \uADF8\uB798, \uC798 \uB2E4\uB140\uC640."
    DeveloperNote: "[P03_03] \uB370\uC6B0\uC2A4 / \uD0C0\uC778 \uBC30\uC81C / \uAD00\uACC4
      \uD1B5\uC81C\n\uC870\uAC74: \uC5D4\uBE44(#1),\uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4),
      3\uBA85\uB9CC \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD568\uAED8 \uC788\uACE0,
      \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0
      \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8: \uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4
      \uC0AC\uC774\uC5D0 \uC5D4\uBE44\uB97C \uC138\uC6B0\uBA74, \uC5D4\uBE44\uC758
      \uC2DC\uC120\uC774 \uAC00\uC7A5 \uD754\uB4E4\uB9B4 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P03_04
    ParticipantsRaw: 3,7
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: P07_02
    RewardFragmentId: P03_04
    Lines:
    - TextId: 7
      Text: "\uBCF4\uD638\uD55C\uB2E4\uB294 \uB9D0\uC740 \uC774\uC0C1\uD574.\n\uB4E3\uAE30\uC5D0\uB294
        \uB530\uB73B\uD55C\uB370, \uAC00\uB054\uC740 \uBB38\uC744 \uC7A0\uADF8\uB294
        \uC18C\uB9AC\uCC98\uB7FC \uB4E4\uB9AC\uAC70\uB4E0."
    - TextId: 3
      Text: "\uC0C8\uD134, \uB8E8\uC774\uC2A4\uB97C \uC704\uD5D8\uD558\uAC8C \uB450\uB294
        \uAC83\uBCF4\uB2E4 \uBB38\uC744 \uC7A0\uADF8\uB294 \uCABD\uC774 \uB0AB\uB2E4\uBA74,
        \uC800\uB294 \uAE30\uAEBC\uC774 \uADF8 \uC8C4\uB97C \uC9CA\uC5B4\uC9C0\uACA0\uC2B5\uB2C8\uB2E4."
    - TextId: 7
      Text: "\uBB38 \uC548\uCABD \uC0AC\uB78C\uC774 \uADF8\uAC78 \uC6D0\uD588\uB358\uAC74
        \uB9DE\uC544?"
    - TextId: 3
      Text: "\uC800\uB294 \uC804\uBD80 \uC54C\uACE0 \uC788\uC5B4\uC694. \uB8E8\uC774\uC2A4\uB294
        \uBD84\uBA85 \uC6D0\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    DeveloperNote: "[P03_04] \uB370\uC6B0\uC2A4 / \uBCF4\uD638\uB77C\uB294 \uC774\uB984\uC758
      \uACE0\uB9BD\n\uC870\uAC74: P07_02\uB97C \uD68D\uB4DD\uD55C \uC0C1\uD0DC\uC5D0\uC11C
      \uB370\uC6B0\uC2A4(#3),\uC0C8\uD134(#7)\uC774 \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0
      \uB458\uB9CC \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C
      \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8:
      \uC0C8\uD134\uC740 \uB370\uC6B0\uC2A4\uC5D0\uAC8C \uB0A0\uCE74\uB85C\uC6B4
      \uC9C8\uBB38\uC744 \uD560 \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4.\n(\uC0C8\uD134\uC774
      \uB204\uAC00 \uBC84\uB824\uC9C0\uB294\uC9C0\uB97C \uBA3C\uC800 \uBCF8\uB2E4\uB294
      \uB300\uD654 \uC870\uAC01\uC774 \uD544\uC694\uD558\uB2E4)"
  - DialogueId: CORE_P03_05
    ParticipantsRaw: 3,4,7
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: "P03_02 \uB610\uB294 P03_04"
    RewardFragmentId: P03_05
    Lines:
    - TextId: 7
      Text: "\uB9C8\uC655\uC744 \uD1A0\uBC8C\uD55C \uB2E4\uC74C \uB8E8\uC774\uC2A4\uAC00
        \uC2A4\uC2A4\uB85C \uAC78\uC5B4\uAC00\uACA0\uB2E4\uACE0 \uD558\uBA74 \uB370\uC6B0\uC2A4\uB294
        \uADF8 \uC190\uC744 \uB193\uC744 \uC218 \uC788\uC5B4?"
    - TextId: 3
      Text: "\uB370\uC6B0\uC2A4\uAC00 \uADF8\uAC83\uC744 \uC6D0\uD55C\uB2E4\uBA74
        \uC81C\uAC00 \uB9C9\uC744 \uBC29\uBC95\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uC800\uB294
        \uADF8\uC800 \uC5EC\uC2E0\uB2D8\uC758 \uC774\uB984 \uC544\uB798 \uB370\uC6B0\uC2A4\uB97C
        \uCE58\uB8CC\uD558\uB294 \uAC83 \uBFD0\uC774\uB2C8\uAE4C\uC694.\n\uD558\uC9C0\uB9CC
        \uB8E8\uC774\uC2A4\uB294 \uC2A4\uC2A4\uB85C \uAC78\uC5B4\uAC00\uAE30\uC5D4
        \uB108\uBB34\uB098 \uC57D\uD574\uC9C4 \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
    - TextId: 4
      Text: "\uB05D\uB09C \uB4A4\uC5D0\uB3C4\u2026 \uB098\uB294 \uACC4\uC18D \uB204\uAD70\uAC00\uC758
        \uC548\uCABD\uC5D0 \uC788\uC5B4\uC57C \uD558\uB294 \uAC78\uAE4C."
    DeveloperNote: "[P03_05] \uB370\uC6B0\uC2A4 / \uD1A0\uBC8C \uC774\uD6C4\uC758
      \uC18D\uBC15\n\uC870\uAC74: P03_02\uC640 P03_04\uB97C \uD68D\uB4DD\uD55C \uC0C1\uD0DC\uC5D0\uC11C
      \uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4),\uC0C8\uD134(#7), 3\uBA85\uB9CC
      \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815
      \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC558\uC744
      \uC2DC\n\uD78C\uD2B8: \uB9C8\uC655 \uD1A0\uBC8C \uC774\uD6C4\uB97C \uBB3B\uB294
      \uC0C8\uD134 \uC55E\uC5D0\uC11C, \uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB97C
      \uC815\uB9D0 \uB193\uC544\uC904 \uC218 \uC788\uB294\uC9C0 \uB4DC\uB7EC\uB0A0
      \uAC83 \uAC19\uB2E4.\n(\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4\uC758 \uB2EB\uD78C
      \uAD00\uACC4, \uB370\uC6B0\uC2A4\uC758 \uBCF4\uD638 \uBC29\uC2DD\uC744 \uC54C\uC544\uC57C
      \uD55C\uB2E4)"
  - DialogueId: CORE_P04_01
    ParticipantsRaw: 4
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P04_01
    Lines:
    - TextId: 4
      Text: "\uB208\uC744 \uAC10\uC73C\uBA74 \uC544\uC9C1\uB3C4 \uAC19\uC740 \uC7A5\uBA74\uC774
        \uBC18\uBCF5\uB3FC.\n\uB204\uAC00 \uC8FD\uACE0, \uB204\uAC00 \uC120\uD0DD\uD558\uACE0,
        \uB204\uAC00 \uB0A8\uB294\uC9C0\u2026 \uC54C\uACE0 \uC788\uB294\uB370\uB3C4
        \uBAB8\uC774 \uBA3C\uC800 \uBA48\uCDB0 \uBC84\uB824.\n\uBAA8\uB4E0 \uAC78
        \uC54C\uACE0 \uC788\uC9C0\uB9CC \uC6C0\uC9C1\uC774\uACE0 \uC2F6\uC9C0 \uC54A\uC544..."
    DeveloperNote: "[P04_01] \uB8E8\uC774\uC2A4 / \uC815\uC2E0\uC801 \uC18C\uC9C4\n\uC870\uAC74:
      \uB8E8\uD504\uAC00 2\uD68C \uC774\uC0C1 \uC9C4\uD589\uB41C \uC0C1\uD0DC\uC5D0\uC11C
      \uB8E8\uC774\uC2A4(#4)\uAC00 \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD63C\uC790
      \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4
      \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8: \uB8E8\uC774\uC2A4\uB294
      \uD63C\uC790 \uC788\uC744 \uB54C \uAC00\uC7A5 \uC870\uC6A9\uD558\uC9C0\uB9CC,
      \uADF8 \uCE68\uBB35\uC774 \uBE44\uC5B4 \uC788\uB294 \uAC74 \uC544\uB2D0 \uAC83
      \uAC19\uB2E4."
  - DialogueId: CORE_P04_02
    ParticipantsRaw: 2,4,7
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: "P02_04 \uB610\uB294 P07_02"
    RewardFragmentId: P04_02
    Lines:
    - TextId: 2
      Text: "\uC5EC\uAE30\uC11C \uBA48\uCD9C \uC218\uB294 \uC5C6\uC5B4. \uB05D\uAE4C\uC9C0
        \uAC00\uC57C \uD574. \uB9C8\uC655\uC744 \uD1A0\uBC8C\uD558\uC9C0 \uC54A\uC73C\uBA74
        \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC774 \uACE0\uD1B5\uBC1B\uAC8C \uB41C\uB2E4."
    - TextId: 7
      Text: "\uB05D\uAE4C\uC9C0 \uAC04\uB2E4\uB294 \uB9D0\uC740 \uC26C\uC6CC. \uADF8\uB7F0\uB370
        \uADF8 \uB05D\uC5D0 \uB3C4\uCC29\uD558\uC9C0 \uBABB\uD558\uB294 \uC0AC\uB78C\uC740
        \uB204\uAC00 \uAE30\uC5B5\uD558\uC9C0?\n\uB8E8\uC774\uC2A4, \uBB50\uB77C\uACE0
        \uB9D0 \uC880 \uD574\uBD10."
    - TextId: 4
      Text: "...\uB098\uB294 \uBAA8\uB974\uACA0\uC5B4. \uB098\uC5D0\uAC8C \uBB3B\uC9C0
        \uB9D0\uC544 \uC918."
    DeveloperNote: "[P04_02] \uB8E8\uC774\uC2A4 / \uC778\uC9C0\uD558\uC9C0\uB9CC
      \uAC1C\uC785\uD558\uC9C0 \uC54A\uC74C\n\uC870\uAC74: P02_04 \uB610\uB294 P07_02\uB97C
      \uD68D\uB4DD\uD55C \uC0C1\uD0DC\uC5D0\uC11C \uBA54\uC774(#2),\uB8E8\uC774\uC2A4(#4),\uC0C8\uD134(#7),
      3\uBA85\uB9CC \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uC788\uACE0, \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0
      \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8: \uBA54\uC774\uC640 \uC0C8\uD134\uC774
      \uBD80\uB52A\uD788\uB294 \uC790\uB9AC\uC5D0 \uB8E8\uC774\uC2A4\uAC00 \uC788\uC73C\uBA74,
      \uB8E8\uC774\uC2A4\uAC00 \uCE68\uBB35\uD558\uB294 \uC774\uC720\uAC00 \uBCF4\uC77C
      \uAC83 \uAC19\uB2E4. (\uC0C8\uD134\uC774 \uB370\uC6B0\uC2A4\uC5D0\uAC8C \uD138\uC5B4\uB193\uC740
      \uB300\uD654\uC870\uAC01 \uB610\uB294 \uBA54\uC774\uC640 \uB8E8\uC774\uC2A4\uC758
      \uB2E4\uD23C\uC73C\uB85C \uC778\uD55C \uB300\uD654\uC870\uAC01\uC774 \uD544\uC694\uD558\uB2E4)"
  - DialogueId: CORE_P04_03
    ParticipantsRaw: 2,4
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P04_03
    Lines:
    - TextId: 4
      Text: "\uBA54\uC774, \uB098\uB294 \uC774\uC81C \uC870\uAE08 \uBA48\uCD94\uACE0
        \uC2F6\uC5B4.\n\uB05D\uAE4C\uC9C0 \uAC00\uC57C \uD55C\uB2E4\uB294 \uB9D0\uC740
        \uC54C\uACA0\uB294\uB370\u2026\n\uC870\uAE08\uB9CC \uB354 \uC26C\uACE0 \uC0DD\uAC01\uD574
        \uBCF4\uB294\uAC74 \uC5B4\uB54C?"
    - TextId: 2
      Text: "\uB8E8\uC774\uC2A4, \uBA48\uCD94\uACE0 \uC2F6\uB2E4\uB294 \uB9D0\uC774
        \uADF8\uB807\uAC8C \uC27D\uAC8C \uB098\uC628\uB2E4\uACE0?\n\uB204\uAD70\uAC00\uC5D0\uAC8C\uB294
        \uADF8 \uB9D0\uC774 \uC9C0\uAE08\uAE4C\uC9C0 \uBD99\uC7A1\uC544 \uC628 \uBAA8\uB4E0
        \uAC8C \uD5DB\uB418\uB2E4\uB294 \uB9D0\uCC98\uB7FC \uB4E4\uB9B4 \uC218\uB3C4
        \uC788\uB2E4."
    DeveloperNote: "[P04_03] \uB8E8\uC774\uC2A4 / \uD604\uC7AC \uC548\uC815\uC5D0
      \uBA38\uBB34\uB974\uB824 \uD568\n\uC870\uAC74: \uBA54\uC774(#2),\uB8E8\uC774\uC2A4(#4)\uAC00
      \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uB458\uB9CC \uC788\uACE0, \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0
      \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8: \uBA54\uC774\uC640 \uB8E8\uC774\uC2A4\uB97C
      \uB458\uB9CC \uB450\uBA74, \uC804\uC9C4\uACFC \uC815\uC9C0\uAC00 \uAC00\uC7A5
      \uC9C1\uC811\uC801\uC73C\uB85C \uBD80\uB52A\uD790 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P04_04
    ParticipantsRaw: 3,4
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P04_04
    Lines:
    - TextId: 4
      Text: "\uC74C, \uC624\uB298\uC740 \uBAB8 \uC0C1\uD0DC\uAC00 \uAD1C\uCC2E\uC740\uB370,
        \uB098\uAC00\uC11C \uB3D9\uB8CC\uB4E4\uC744 \uB3C4\uC640 \uC0AC\uB0E5\uC774\uB77C\uB3C4
        \uD574\uBCFC\uAE4C."
    - TextId: 
      Text: "# \uB370\uC6B0\uC2A4\n\"\uB8E8\uC774\uC2A4\uB294 \uC26C\uACE0 \uACC4\uC138\uC694.
        \uC81C\uAC00 \uB300\uC2E0 \uB2E4\uB140\uC624\uACA0\uC2B5\uB2C8\uB2E4.\""
    - TextId: 
      Text: "#\uB8E8\uC774\uC2A4\n\"\uD558\uC9C0\uB9CC \uB370\uC6B0\uC2A4, \uC0AC\uB0E5
        \uD574\uBCF8 \uC801 \uC5C6\uC796\uC544? \uD798\uB4E4\uACE0 \uC704\uD5D8\uD560\uAC70\uC57C.\""
    - TextId: 3
      Text: "\uB8E8\uC774\uC2A4, \uB2F9\uC2E0\uC5D0\uAC8C \uD5CC\uC2E0\uD558\uB294
        \uAC83\uC774 \uC800\uC758 \uC758\uBB34\uC774\uC790 \uAE30\uC068\uC785\uB2C8\uB2E4.
        \n\uB8E8\uC774\uC2A4\uB97C \uB300\uC2E0\uD574 \uC0AC\uB0E5\uC744 \uD558\uB294
        \uAC83\uB3C4 \uC81C\uAC90 \uD798\uB4E0 \uAE30\uB3C4\uB098 \uC218\uD589\uACFC
        \uAC19\uC544\uC694.\n\uADF8\uB7EC\uB2C8 \uB8E8\uC774\uC2A4\uB294 \uC544\uBB34\uAC83\uB3C4
        \uD558\uC9C0 \uC54A\uC544\uB3C4 \uAD1C\uCC2E\uC2B5\uB2C8\uB2E4."
    - TextId: 4
      Text: "\uB370\uC6B0\uC2A4, \uB0B4\uAC00 \uB370\uC6B0\uC2A4\uC758 \uC2DC\uC57C
        \uBC16\uC73C\uB85C \uC0AC\uB77C\uC9C0\uB294\uAC8C \uC2EB\uC740\uAC70\uC9C0?\n...\uD558\uC9C0\uB9CC
        \uADF8\uB807\uAC8C\uAE4C\uC9C0 \uB9D0\uD574 \uC900\uB2E4\uBA74 \uC870\uAE08
        \uC26C\uACE0 \uC788\uC744\uAC8C."
    DeveloperNote: "[P04_04] \uB8E8\uC774\uC2A4 / \uB370\uC6B0\uC2A4 = \uBD88\uC548\uC815\uD55C
      \uBC84\uD300\uBAA9\n\uC870\uAC74: \uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4)\uAC00
      \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uB458\uB9CC \uC788\uACE0, \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0
      \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8: \uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4\uB97C
      \uB458\uB9CC \uB0A8\uAE30\uBA74, \uB8E8\uC774\uC2A4\uAC00 \uBB34\uC5C7\uC5D0
      \uAE30\uB300\uACE0 \uC788\uB294\uC9C0 \uAC00\uC7A5 \uC798 \uBCF4\uC77C \uAC83
      \uAC19\uB2E4."
  - DialogueId: CORE_P04_05
    ParticipantsRaw: 4
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P04_05
    Lines:
    - TextId: 4
      Text: "\uB370\uC6B0\uC2A4...\n\uB2F9\uC2E0 \uC5C6\uB294 \uC138\uC0C1\uC740
        \uB108\uBB34\uB098 \uCC28\uAC11\uACE0 \uB450\uB824\uC6B4 \uACF3\uC774\uC5C8\uAD70\uC694."
    - TextId: 4
      Text: "\uACE7 \uB9CC\uB098\uB7EC \uAC00\uACA0\uC2B5\uB2C8\uB2E4.\n\uC81C\uAC00
        \uAC08 \uAC83\uC744 \uC54C\uACE0 \uC788\uC73C\uB9AC\uB77C \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    DeveloperNote: "[P04_05] \uB8E8\uC774\uC2A4 / \uAE30\uB300\uC5B4 \uBC84\uD2F0\uB294
      \uC120\uD0DD\n\uC870\uAC74: \uB8E8\uC774\uC2A4(#4)\uAC00 \uC870\uC0AC \uC9C0\uC815
      \uAD6C\uC5ED\uC5D0 \uC788\uC744 \uC2DC\n\uD78C\uD2B8: \uB8E8\uC774\uC2A4\uAC00
      \uD63C\uC790\uC788\uC744 \uB54C \uB370\uC6B0\uC2A4\uB97C \uC5B4\uB5BB\uAC8C
      \uC0DD\uAC01\uD558\uB294\uC9C0 \uC54C \uC218 \uC788\uC744\uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P05_01
    ParticipantsRaw: 5
    Type: 0
    Scope: 2
    Alive: 1
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P05_01
    Lines:
    - TextId: 5
      Text: "\uB9C8\uC655\uC131 \uC8FC\uBC29\uC5D0\uC11C \uC77C\uD560 \uB54C \uBA39\uC5C8\uB358
        \uADF8 \uC74C\uC2DD\uC740 \uC774\uC0C1\uD558\uAC8C \uC624\uB798 \uAE30\uC5B5\uC5D0
        \uB0A8\uC544.\n\uC808\uB9DD\uD55C \uC778\uAC04\uC758 \uC2EC\uC7A5\uC774\uB77C
        \uADF8\uB7F0\uAC78\uAE4C?\n\uAE08\uAE30\uB41C \uC74C\uC2DD\uC744 \uBA39\uC5C8\uB2E4\uACE0
        \uCAD3\uACA8\uB0AC\uC9C0\uB9CC, \uC544\uC9C1\uAE4C\uC9C0\uB3C4 \uADF8 \uB9DB\uC774
        \uD600\uB05D\uC5D0\uC11C \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC544."
    DeveloperNote: "[P05_01] \uD1A0\uB2C8 / \uB9C8\uC655\uC131 \uC8FC\uBC29 / \uAE08\uAE30
      \uC694\uB9AC\n\uC870\uAC74: \uD1A0\uB2C8(#5) \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C
      \uD63C\uC790 \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC774 \uC544\uB2CC
      \uB2E4\uB978 \uAD6C\uC5ED\uC5D0\uC11C \uC0AC\uB9DD \uC0AC\uAC74\uC774 \uBC1C\uC0DD\uD588\uC744
      \uC2DC\n\uD78C\uD2B8: \uD1A0\uB2C8\uAC00 \uD63C\uC790 \uC788\uB294 \uC0C1\uD0DC\uC5D0\uC11C
      \uC0AC\uB9DD \uC0AC\uAC74\uC744 \uBAA9\uACA9\uD55C\uB2E4\uBA74, \uADF8\uB140\uAC00
      \uC5B4\uB514\uC11C\uBD80\uD130 \uADF8\uB7F0 \uD5C8\uAE30\uB97C \uBC30\uC6E0\uB294\uC9C0
      \uD758\uB9B4\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
  - DialogueId: CORE_P05_02
    ParticipantsRaw: 5
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P05_02
    Lines:
    - TextId: 5
      Text: "\uAC19\uC774 \uB180\uACE0\uC2F6\uC740\uB370... \uB2E4\uB4E4 \uC5B4\uB514\uAC14\uC5B4?"
    DeveloperNote: "[P05_02] \uD1A0\uB2C8 / \uADC0\uC5EC\uC6B4 \uD45C\uBA74 \uC5F0\uAE30\n\uC870\uAC74:
      \uD1A0\uB2C8(#5)\uAC00\uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC788\uC744
      \uC2DC\n\uD78C\uD2B8: \uD1A0\uB2C8\uB294 \uD63C\uC790\uC788\uC744\uB54C \uAC00\uC7A5
      \uD574\uB9D1\uC740 \uC5BC\uAD74\uC744 \uBCF4\uC77C \uC218 \uC788\uB2E4."
  - DialogueId: CORE_P05_03
    ParticipantsRaw: 5
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P05_03
    Lines:
    - TextId: 5
      Text: "\uD63C\uC790\uB294 \uB9DB\uC774 \uC548 \uB098.\n\uB204\uAC00 \uB204\uAD6C\uB97C
        \uBBF8\uC6CC\uD558\uB294\uC9C0, \uB204\uAC00 \uBA3C\uC800 \uD754\uB4E4\uB9AC\uB294\uC9C0
        \uBD10\uC57C \uD558\uB294\uB370.\n\n\uC544\uC9C1\uC740 \uB35C \uC775\uC5C8\uB124."
    DeveloperNote: "[P05_03] \uD1A0\uB2C8 / \uAD00\uCC30 \uD6C4 \uC0B4\uC778\n\uC870\uAC74:
      \uD1A0\uB2C8(#5)\uAC00\uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC788\uC744
      \uC2DC\n\uD78C\uD2B8: \uD1A0\uB2C8\uAC00 \uACC4\uC18D \uD63C\uC790 \uC788\uC73C\uBA74
      \uB2E4\uB978 \uBAA8\uC2B5\uC744 \uBCFC \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
  - DialogueId: CORE_P05_04
    ParticipantsRaw: 5
    Type: 0
    Scope: 1
    Alive: 1
    Gimmick: 1
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P05_04
    Lines:
    - TextId: 5
      Text: "\uC8FD\uC5B4\uBC84\uB838\uB124. \uC0B4\uC544\uC788\uB294 \uC2EC\uC7A5\uC744
        \uB3C4\uB824\uB0B4\uB290\uB77C \uD798\uB4E4\uC5C8\uC5B4."
    - TextId: 5
      Text: "\uBAA8\uB450 \uB2F9\uD669\uD558\uACE0 \uC788\uC5B4.\n\uB0B4\uAC00 \uADF8\uB7AC\uC744
        \uAC70\uB77C\uACE0 \uC758\uC2EC\uD558\uB294 \uC0AC\uB78C\uC870\uCC28 \uC5C6\uC5B4.\n\uC774
        \uC8FD\uC74C\uC73C\uB85C \uAC00\uC7A5 \uC808\uB9DD\uD560 \uC0AC\uB78C\uC740
        \uB204\uAD6C\uC77C\uAE4C."
    DeveloperNote: "[P05_04] \uD1A0\uB2C8 / \uC8FD\uC74C \uC774\uD6C4\uC758 \uBCC0\uD654
      \uC911\uC2DC\n\uC870\uAC74: \uC870\uC0AC \uAD6C\uC5ED\uC5D0 \uD1A0\uB2C8(#5)\uB97C
      \uD3EC\uD568\uD55C 3\uBA85 \uC774\uC0C1\uC758 \uCE90\uB9AD\uD130\uAC00 \uC874\uC7AC\uD558\uB294
      \uC0C1\uD0DC\uC5D0\uC11C, \uD1A0\uB2C8(#5)\uAC00 \uB2E4\uB978 \uCE90\uB9AD\uD130\uB97C
      \uC0AC\uB9DD\uC2DC\uCF30\uC744 \uC2DC .\n\uD78C\uD2B8: \uAD70\uC911 \uC18D
      \uD1A0\uB2C8\uC758 \uC0B4\uC778\uC740, \uADF8\uB140\uAC00 \uC8FD\uC74C\uC744
      \uBC14\uB77C\uBCF4\uB294 \uC2DC\uC120\uC744 \uC798 \uBCF4\uC5EC\uC900\uB2E4."
  - DialogueId: CORE_P05_05
    ParticipantsRaw: 1,5,6
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P05_05
    Lines:
    - TextId: 1
      Text: "\uD1A0\uB2C8, \uB9C8\uC655\uC131\uC5D0\uC11C\uB294 \uC0AC\uB78C\uC758
        \uC2EC\uC7A5\uC744 \uB9E4\uC77C \uC694\uB9AC\uD574 \uBA39\uB294\uB300.\n\uB108\uBB34
        \uBB34\uC12D\uC9C0..!"
    - TextId: 5
      Text: "\uC751? \uC544\uB2C8, \uB9E4\uC77C\uC740 \uBABB\uBA39\uC9C0! \uB9C8\uC655\uC131\uC5D0\uC11C\uB3C4
        \uAE08\uAE30\uB41C \uC694\uB9AC\uAE30\uB3C4 \uD558\uACE0,\n\uB418\uB3CC\uB9B4
        \uC218 \uC5C6\uC744 \uC815\uB3C4\uB85C \uC808\uB9DD\uD55C \uC778\uAC04\uC758
        \uC2EC\uC7A5\uC740 \uADC0\uD55C \uAC70\uB2C8\uAE4C."
    - TextId: 6
      Text: "\uC608?\n\uD1A0\uB2C8, \uC5B4\uB5BB\uAC8C \uC54C\uACE0 \uC788\uB294\uAC81\uB2C8\uAE4C?"
    DeveloperNote: "[P05_05] \uD1A0\uB2C8 / \uC808\uB9DD\uD55C \uC2EC\uC7A5\uC5D0
      \uB300\uD55C \uC695\uB9DD\n\uC870\uAC74: \uC5D4\uBE44(#1),\uD1A0\uB2C8(#5),\uD504\uB9AC\uB4DC(#6),
      3\uBA85\uB9CC \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uC788\uACE0, \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0
      \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8: \uC5D4\uBE44\uC640 \uD504\uB9AC\uB4DC
      \uC55E\uC5D0 \uD1A0\uB2C8\uB97C \uC138\uC6B0\uBA74 \uD1A0\uB2C8\uC758 \uC695\uB9DD\uC774
      \uB354 \uC120\uBA85\uD574\uC9C8 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P06_01
    ParticipantsRaw: 6
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P06_01
    Lines:
    - TextId: 6
      Text: "\uB204\uAD70\uAC00 \uD574\uC57C \uD560 \uC77C\uC774\uB77C\uBA74 \uC81C\uAC00
        \uD558\uACA0\uC2B5\uB2C8\uB2E4.\n\uC5B4\uCC28\uD53C \uBAA8\uB450\uAC00 \uACE0\uBBFC\uD558\uB2E4\uAC00
        \uACB0\uAD6D \uC798\uBABB\uB41C \uBC29\uD5A5\uC73C\uB85C \uD758\uB7EC\uAC08
        \uD14C\uB2C8\uAE4C\uC694.\n\uCC28\uB77C\uB9AC \uC81C\uAC00 \uBA3C\uC800 \uC9CA\uC5B4\uC9C0\uB294
        \uD3B8\uC774 \uB0AB\uC2B5\uB2C8\uB2E4."
    DeveloperNote: "[P06_01] \uD504\uB9AC\uB4DC / \uBAA8\uB4E0 \uC77C\uC744 \uC9C1\uC811
      \uC9CA\uC5B4\uC9C0\uB294 \uC2E0\uB150\n\uC870\uAC74: \uD504\uB9AC\uB4DC(#6)\uAC00
      \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD63C\uC790 \uC788\uACE0, \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0
      \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8: \uD504\uB9AC\uB4DC\uB97C \uD63C\uC790
      \uB450\uBA74 \uD504\uB9AC\uB4DC\uC758 \uC0DD\uAC01\uC5D0 \uB300\uD574 \uC54C
      \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P06_02
    ParticipantsRaw: 2,6
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P06_02
    Lines:
    - TextId: 2
      Text: "\uC774\uBC88 \uC758\uB8B0\uB294 \uC870\uAE08 \uC704\uD5D8\uD560 \uC218\uB3C4
        \uC788\uB2E4.\n\uC6D0\uD615\uC73C\uB85C \uC9C4\uD615\uC744 \uAD6C\uCD95\uD558\uACE0
        \uC11C\uB85C\uB97C \uC9C0\uCF1C\uC57C \uD574."
    - TextId: 6
      Text: "\uC704\uD5D8\uD55C \uC77C\uC774\uB77C\uBA74 \uC81C\uAC00 \uBA3C\uC800
        \uC55E\uC5D0 \uC11C\uACA0\uC2B5\uB2C8\uB2E4."
    - TextId: 2
      Text: "\uD504\uB9AC\uB4DC, \uC774\uBC88 \uC758\uB8B0\uB294 \uC774\uC804\uACFC
        \uB2EC\uB77C.\n\uB124\uAC00 \uC544\uBB34\uB9AC \uB6F0\uC5B4\uB098\uB2E4\uACE0
        \uD574\uB3C4 \uD55C\uBA85\uC774 \uBA3C\uC800 \uB098\uC120\uB2E4\uACE0 \uB420
        \uC77C\uC774 \uC544\uB2C8\uC57C.\n\uC774\uBC88\uC5D4 \uC11C\uB85C\uC758 \uB4F1\uC744
        \uC9C0\uCF1C\uC57C \uD574."
    - TextId: 6
      Text: "\uD558\uD558, \uAD1C\uCC2E\uC544\uC694. \uC81C\uAC00 \uD76C\uC0DD\uD558\uBA74
        \uB429\uB2C8\uB2E4.\n\uAC71\uC815\uB9D0\uACE0 \uC81C \uB4A4\uB97C \uB530\uB77C\uC624\uC138\uC694."
    - TextId: 2
      Text: "\uADF8 \uBC29\uC2DD\uC774 \uB354 \uBAA8\uB450\uB97C \uC704\uD5D8\uD558\uAC8C
        \uD560 \uC218\uB3C4 \uC788\uC5B4."
    DeveloperNote: "[P06_02] \uD504\uB9AC\uB4DC / \uC2A4\uC2A4\uB85C \uD76C\uC0DD\uD558\uB824
      \uD568\n\uC870\uAC74: \uBA54\uC774(#2),\uD504\uB9AC\uB4DC(#6)\uAC00 \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uB458\uB9CC \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815
      \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC558\uC744
      \uC2DC\n\uD78C\uD2B8: \uBA54\uC774\uC758 \uC606\uC5D0 \uD504\uB9AC\uB4DC\uB97C
      \uB450\uBA74, \uD504\uB9AC\uB4DC\uAC00 \uC5B4\uB5A4 \uC2DD\uC73C\uB85C \uC55E\uC5D0
      \uC11C\uB294\uC9C0 \uBCF4\uC77C \uB4EF\uD558\uB2E4."
  - DialogueId: CORE_P06_03
    ParticipantsRaw: 1,6
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P06_03
    Lines:
    - TextId: 1
      Text: "\uD504\uB9AC\uB4DC\uB294 \uC5B4\uB835\uACE0 \uD798\uB4E0 \uC77C\uC744
        \uD56D\uC0C1 \uBA3C\uC800 \uB098\uC11C\uC11C \uD558\uB824\uACE0 \uD558\uB124.\n\uD798\uB4E4\uC9C0\uB294
        \uC54A\uC544?"
    - TextId: 6
      Text: "\uC81C\uAC00 \uB300\uC2E0 \uC815\uD558\uBA74 \uC801\uC5B4\uB3C4 \uB204\uAD70\uAC00\uB294
        \uB35C \uB2E4\uCE69\uB2C8\uB2E4.\n\uD798\uB4E4 \uB54C\uB3C4 \uC788\uC9C0\uB9CC
        \uB2E4\uB978 \uC0AC\uB78C\uC758 \uB2F5\uB2F5\uD558\uACE0 \uBB34\uB2A5\uD55C
        \uD589\uB3D9\uC744 \uBCF4\uB294 \uAC83\uC744 \uBCF4\uB294 \uAC83\uBCF4\uB2E4\uB294
        \uB0AB\uC2B5\uB2C8\uB2E4."
    DeveloperNote: "[P06_03] \uD504\uB9AC\uB4DC / \uCC45\uC784 \uB3C5\uC810\uC5D0
      \uC775\uC219\uD574\uC9D0\n\uC870\uAC74: \uC5D4\uBE44(#1),\uD504\uB9AC\uB4DC(#6)\uAC00
      \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uB458\uB9CC \uC788\uACE0, \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0
      \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8: \uC5D4\uBE44\uB294 \uD504\uB9AC\uB4DC\uC758
      \uC120\uC758\uAC00 \uC5B8\uC81C \uACB0\uC815\uAD8C\uC73C\uB85C \uBC14\uB00C\uB294\uC9C0
      \uAC74\uB4DC\uB9B4 \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P06_04
    ParticipantsRaw: 6,7
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: P07_02
    RewardFragmentId: P06_04
    Lines:
    - TextId: 7
      Text: "\uD504\uB9AC\uB4DC, \uC8FC\uBCC0\uC5D0 \uB9C8\uBB3C\uC774 \uB098\uD0C0\uB0AC\uC5B4.\n\uADF8\uB807\uAC8C
        \uAC15\uD55C \uAC83 \uAC19\uC9C0\uB294 \uC54A\uC73C\uB2C8 \uB0B4\uAC00 \uCC98\uB9AC\uD558\uACE0
        \uC62C\uAC8C."
    - TextId: 6
      Text: "\uBB50\uB77C\uACE0\uC694? \uC704\uD5D8\uD574\uC694! \n\uC81C\uAC00 \uD574\uCE58\uC6B0\uACE0
        \uC62C\uD14C\uB2C8 \uC0C8\uD134\uC740 \uC548\uC804\uD55C \uACF3\uC5D0\uC11C
        \uAE30\uB2E4\uB9AC\uACE0 \uACC4\uC138\uC694."
    - TextId: 7
      Text: "\uC544\uB0D0, \uB098\uB3C4 \uC2AC\uC2AC \uACBD\uD5D8\uCE58\uB97C \uC5BB\uC5B4\uC11C
        \uB808\uBCA8\uC744 \uC62C\uB824\uC57C \uD574.\n\uB0B4\uAC00 \uC7A1\uC744\uD14C\uB2C8
        \uC5C4\uD638\uB9CC \uBD80\uD0C1\uD560\uAC8C."
    - TextId: 6
      Text: "\uC544\uB1E8!! \uC6A9\uC0AC\uB85C\uC11C \uC81C\uAC00 \uCC45\uC784\uC9C8
        \uBB38\uC81C\uC785\uB2C8\uB2E4.\n\uC220\uC794\uC774 \uC2DD\uAE30 \uC804\uC5D0
        \uB3CC\uC544\uC62C \uD14C\uB2C8 \uAE30\uB2E4\uB9AC\uC138\uC694!"
    - TextId: 7
      Text: "\uD504\uB9AC\uB4DC!!\n\uD558... \uAC00\uBC84\uB838\uC796\uC544..."
    DeveloperNote: "[P06_04] \uD504\uB9AC\uB4DC / \uD0C0\uC778\uC758 \uC120\uD0DD\uAD8C\uAE4C\uC9C0
      \uB300\uC2E0\uD568\n\uC870\uAC74: P07_02\uB97C \uD68D\uB4DD\uD55C \uC0C1\uD0DC\uC5D0\uC11C
      \uD504\uB9AC\uB4DC(#6),\uC0C8\uD134(#7)\uC774 \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0
      \uB458\uB9CC \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C
      \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8:
      \uC0C8\uD134\uC740 \uD504\uB9AC\uB4DC\uC758 \uD76C\uC0DD\uC774 \uC815\uB9D0
      \uD0C0\uC778\uC744 \uC704\uD55C \uC120\uD0DD\uC778\uC9C0 \uBB3C\uC744 \uC218
      \uC788\uC744 \uAC83 \uAC19\uB2E4.\n(\uC0C8\uD134\uC774 \uB370\uC6B0\uC2A4\uC5D0\uAC8C
      \uD138\uC5B4\uB193\uC740 \uB300\uD654 \uC870\uAC01\uC774 \uD544\uC694\uD558\uB2E4.)"
  - DialogueId: CORE_P06_05
    ParticipantsRaw: 6
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P06_05
    Lines:
    - TextId: 6
      Text: "\uB0B4\uAC00 \uC4F0\uB7EC\uC9C4 \uC790\uB9AC\uC5D0\uC11C \uB204\uAD70\uAC00
        \uC0B4\uC544\uB0A8\uB294\uB2E4\uBA74... \uADF8\uAC78\uB85C \uCDA9\uBD84\uD574."
    - TextId: 6
      Text: "\uC544\uB2C8\uC57C... \uC8FD\uACE0\uC2F6\uC9C0 \uC54A\uC544..."
    - TextId: 6
      Text: "\uADF8\uB7F0\uB370 \uB098\uB294 \uC65C \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0,
        \uBAA8\uB450\uB97C \uB300\uC2E0\uD574 \uD76C\uC0DD\uD558\uC57C \uD55C\uB2E4\uACE0
        \uBBFF\uACE0 \uC788\uC5C8\uC744\uAE4C..."
    - TextId: 6
      Text: "\uC5B4\uCA4C\uBA74 \uB098\uB294... \uADF8\uC800 \uC6B0\uC6D4\uAC10\uC744
        \uB290\uB07C\uACE0 \uC2F6\uC5C8\uB358 \uAC74\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB2E4..."
    DeveloperNote: "[P06_05] \uD504\uB9AC\uB4DC / \uB0B4\uAC00 \uD76C\uC0DD\uD574\uC57C
      \uBAA8\uB450\uAC00 \uC0B0\uB2E4\uB294 \uD655\uC2E0\n\uC870\uAC74: \uD504\uB9AC\uB4DC(#6)\uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uC788\uC744 \uC2DC\n\uD78C\uD2B8: \uD504\uB9AC\uB4DC\uAC00
      \uB354\uC6B1\uB354 \uC678\uB85C\uC6CC\uC9C0\uBA74 \uD504\uB9AC\uB4DC\uC758
      \uC0DD\uAC01\uC744 \uC54C \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P07_01
    ParticipantsRaw: 7
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P07_01
    Lines:
    - TextId: 7
      Text: "\uB0B4\uAC00 \uC9C0\uB098\uC628 \uC790\uB9AC\uC5D0\uB294 \uB298 \uB204\uAD70\uAC00\uAC00
        \uB0A8\uC558\uC5B4.\n\uC774\uBC88\uC5D0\uB3C4 \uACB0\uAD6D \uC774\uB807\uAC8C
        \uB418\uC5B4\uBC84\uB838\uC5B4..."
    DeveloperNote: "[P07_01] \uC0C8\uD134 / \uB4A4\uC5D0 \uB0A8\uACA8\uC57C \uD588\uB358
      \uC0DD\uC874 \uAE30\uC5B5\n\uC870\uAC74: \uC0C8\uD134(#7)\uC774 \uC774\uB3D9\uD558\uBA70
      \uC774\uC804 \uCE78\uC5D0 \uB0A8\uC740 \uC778\uBB3C\uC774 \uBC30\uD68C\uC790
      \uD6A8\uACFC\uB85C \uC0AC\uB9DD / \uC774\uB3D9 \uD6C4 \uC870\uC0AC \uC9C0\uC815
      \uAD6C\uC5ED\uC5D0\uC11C \uC0C8\uD134\uC774 \uD63C\uC790 \uB0A8\uC558\uC744
      \uC2DC\n\uD78C\uD2B8: \uC0C8\uD134\uC740 \uB298 \uD63C\uC790\uB2E4. \uB4A4\uC5D0
      \uB204\uAD70\uAC00\uB97C \uB0A8\uACA8\uB450\uACE0\uC11C..."
  - DialogueId: CORE_P07_02
    ParticipantsRaw: 7,3
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P07_02
    Lines:
    - TextId: 7
      Text: "\uB0B4\uAC00 \uC9C0\uB098\uC628 \uC790\uB9AC\uC5D0\uB294 \uB298 \uB204\uAD70\uAC00\uAC00
        \uB0A8\uC558\uC5B4.\n\uBA3C\uC800 \uC6C0\uC9C1\uC774\uBA74 \uC0B0\uB2E4\uACE0
        \uBC30\uC6E0\uB294\uB370, \n\uC774\uC0C1\uD558\uAC8C\uB3C4 \uC0B4\uC544\uB0A8\uC744\uC218\uB85D
        \uBC1C\uC790\uAD6D\uC774 \uB354 \uBB34\uAC70\uC6CC\uC838.\n\uB0B4 \uC120\uD0DD\uC740
        \uC633\uC740 \uAC83\uC774\uC5C8\uB358 \uAC78\uAE4C?"
    - TextId: 3
      Text: "\uC0C8\uD134, \uACE0\uD574\uB294 \uC8C4\uB97C \uC9C0\uC6B0\uAE30 \uC704\uD55C
        \uB9D0\uC774 \uC544\uB2D9\uB2C8\uB2E4.\n\uD558\uC9C0\uB9CC \uB2F9\uC2E0\uC774
        \uC544\uC9C1 \uBB34\uAC8C\uB97C \uB290\uB080\uB2E4\uBA74 \uC801\uC5B4\uB3C4
        \uADF8 \uC8FD\uC74C\uC744 \uC78A\uC9C0\uB294 \uC54A\uC558\uB2E4\uB294 \uB73B\uC785\uB2C8\uB2E4.\n\uADF8\uAC83\uC774
        \uC62C\uBC14\uB978 \uC77C\uC774\uC5C8\uB2E4\uBA74 \uC774\uC81C \uD560 \uC218
        \uC788\uB294 \uC77C\uC740 \uC8FD\uC740 \uC774\uB97C \uC704\uD574 \uAE30\uB3C4\uD558\uB294
        \uAC83 \uBFD0\uC785\uB2C8\uB2E4."
    - TextId: 7
      Text: "\uC815\uB9D0 \uADF8\uAC78\uB85C \uB41C\uAC78\uAE4C..."
    DeveloperNote: "[P07_02] \uC0C8\uD134 / \uB204\uAC00 \uBC84\uB824\uC9C0\uB294\uAC00\uB97C
      \uBA3C\uC800 \uBD04\n\uC870\uAC74: \uC0C8\uD134(#7)\uC774 \uC774\uB3D9\uD558\uBA70
      \uC774\uB3D9 \uC804 \uCE78\uC5D0 \uB0A8\uC740 \uC778\uBB3C\uC774 \uBC30\uD68C\uC790
      \uD6A8\uACFC\uB85C \uC0AC\uB9DD\uD558\uACE0, \uC0C8\uD134(#7)\uC758 \uC774\uB3D9
      \uBAA9\uC801\uC9C0\uC5D0\uB294 \uB370\uC6B0\uC2A4(#3) \uD63C\uC790 \uC788\uC5B4\uC57C
      \uD558\uBA70, \uC774\uB3D9 \uD6C4 \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uB294
      \uC0C8\uD134(#7),\uB370\uC6B0\uC2A4(#3) 2\uBA85\uB9CC \uC874\uC7AC\uD560 \uC2DC\n\uD78C\uD2B8:
      \uC0C8\uD134\uB3C4 \uB370\uC6B0\uC2A4\uC5D0\uAC8C\uB294 \uBB34\uAC70\uC6B4
      \uC77C\uC744 \uD138\uC5B4\uB193\uC744 \uC218 \uC788\uC744\uC9C0 \uBAA8\uB978\uB2E4.
      \uC0C8\uD134\uC774 \uC9C0\uB098\uC628 \uC790\uB9AC\uC5D0\uB294 \uC5B4\uB5A4
      \uC77C\uC774 \uC77C\uC5B4\uB0AC\uC744\uAE4C?"
  - DialogueId: CORE_P07_03
    ParticipantsRaw: 2,6,7
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: P02_03
    RewardFragmentId: P07_03
    Lines:
    - TextId: 6
      Text: "\u201C\uB204\uAD70\uAC00 \uB0A8\uC544\uC57C \uD55C\uB2E4\uBA74, \uC81C\uAC00
        \uB0A8\uACA0\uC2B5\uB2C8\uB2E4"
    - TextId: 7
      Text: "\u201C\uB610 \uB204\uAC00 \uB0A8\uB294\uC9C0\uBD80\uD130 \uC815\uD558\uB294
        \uAC70\uC57C?"
    - TextId: 2
      Text: "\uC544\uB2C8. \uC544\uBB34\uB3C4 \uB0A8\uAE30\uC9C0 \uC54A\uC544.\n\uB300\uC2E0
        \uC8FD\uACA0\uB2E4\uB294 \uB9D0\uB3C4, \uBA48\uCD94\uC790\uB294 \uB9D0\uB3C4
        \uD544\uC694 \uC5C6\uC5B4. \uB05D\uAE4C\uC9C0 \uD568\uAED8 \uAC00. \uADF8\uB798\uC57C
        \uC6B0\uB9AC\uAC00 \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uC774\uC720\uAC00 \uC0AC\uB77C\uC9C0\uC9C0
        \uC54A\uC544."
    DeveloperNote: "[P07_03] \uC0C8\uD134 / \uC2B9\uB9AC\uBCF4\uB2E4 \uACFC\uC815\uC758
      \uD76C\uC0DD\uC744 \uC911\uC2DC\n\uC870\uAC74: P02_03\uC744 \uD68D\uB4DD\uD55C
      \uC0C1\uD0DC\uC5D0\uC11C \uBA54\uC774(#2), \uD504\uB9AC\uB4DC(#6),\uC0C8\uD134(#7)
      3\uBA85\uB9CC \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD568\uAED8 \uC788\uC744
      \uC2DC\n\uD78C\uD2B8: \uBA54\uC774\uAC00 \uB3D9\uB8CC\uB97C \uB300\uD558\uB294
      \uBC29\uC2DD\uC744 \uC54C\uACE0 \uB09C \uD6C4, \uD504\uB9AC\uB4DC\uC640 \uC0C8\uD134\uC774
      \uB3D9\uC2DC\uC5D0 \uC788\uC73C\uBA74 \uC0C8\uD134\uC774 \uB9C8\uC655 \uD1A0\uBC8C\uC5D0
      \uB300\uD574 \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uB294\uC9C0 \uC54C \uC218
      \uC788\uC744 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P07_04
    ParticipantsRaw: 1,7
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P07_04
    Lines:
    - TextId: 1
      Text: "\uC0C8\uD134\uC740 \uD56D\uC0C1 \uC6B0\uB9AC\uB4E4\uACFC \uC870\uAE08
        \uB5A8\uC5B4\uC838 \uC788\uB294 \uAC83 \uAC19\uC544.\n\uAC00\uAE4C\uC774
        \uC624\uBA74 \uBAA8\uB450 \uC88B\uC544\uD560\uAC70\uC57C!"
    - TextId: 7
      Text: "\uAD1C\uCC2E\uC544. \uB098\uB294 \uC9C0\uAE08 \uC774\uB300\uB85C\uAC00
        \uB354 \uD3B8\uD574.\n\uC644\uC804\uD788 \uADF8 \uC548\uC5D0 \uC11E\uC5EC\uBC84\uB9AC\uBA74
        \uBCF4\uC774\uC9C0 \uC54A\uAC8C \uB418\uB294 \uAC83\uB3C4 \uC788\uC5B4."
    DeveloperNote: "[P07_04] \uC0C8\uD134 / \uACF5\uB3D9\uCCB4 \uBD88\uC2E0 / \uAC70\uB9AC\uB450\uAE30\n\uC870\uAC74:
      \uC5D4\uBE44(#1),\uC0C8\uD134(#7)\uC774 \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0
      \uB458\uB9CC \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C
      \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC558\uC744 \uC2DC\n\uD78C\uD2B8:
      \uC5D4\uBE44\uAC00 \uC0C8\uD134\uC744 \uAF2C\uB4DC\uAE38 \uB54C, \uC0C8\uD134\uC774
      \uACF5\uB3D9\uCCB4\uC5D0 \uB300\uD574 \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uB294\uC9C0
      \uC54C \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
  - DialogueId: CORE_P07_05
    ParticipantsRaw: 2,6,7
    Type: 0
    Scope: 1
    Alive: 0
    Gimmick: 0
    SituationCharactersRaw: 
    UnlockConditionId: 
    RewardFragmentId: P07_05
    Lines:
    - TextId: 2
      Text: "\uC9C0\uAE08\uC740 \uD754\uB4E4\uB9B4 \uB54C\uAC00 \uC544\uB2C8\uC57C.
        \uC8FD\uC74C\uC774 \uC788\uC5C8\uB354\uB77C\uB3C4 \uC55E\uC73C\uB85C \uAC00\uC57C
        \uD574."
    - TextId: 6
      Text: "\uC81C\uAC00 \uB300\uC2E0 \uC9CA\uC5B4\uC9C8 \uC218 \uC788\uC5C8\uB2E4\uBA74
        \uB354 \uC88B\uC558\uC744 \uAC81\uB2C8\uB2E4."
    - TextId: 7
      Text: "\uADF8\uB798\uC11C \uBB38\uC81C\uB77C\uB294 \uAC70\uC57C. \uC55E\uC73C\uB85C
        \uAC00\uC790\uB294 \uC0AC\uB78C\uB3C4, \uB300\uC2E0 \uB0A8\uACA0\uB2E4\uB294
        \uC0AC\uB78C\uB3C4 \uC788\uC5B4. \uADF8\uB7F0 \uB9D0\uB4E4\uC774 \uBAA8\uC77C\uC218\uB85D,
        \uB204\uAD70\uAC00\uAC00 \uD76C\uC0DD\uB418\uB294 \uAD6C\uC870\uB294 \uB354
        \uB2F9\uC5F0\uD574\uC838."
    DeveloperNote: "[P07_05] \uC0C8\uD134 / \uD76C\uC0DD \uAD6C\uC870 \uC790\uCCB4\uC5D0
      \uB300\uD55C \uBD84\uB178\n\uC870\uAC74: \uBA54\uC774(#2),\uD504\uB9AC\uB4DC(#6),\uC0C8\uD134(#7)
      3\uBA85\uB9CC \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uC788\uACE0, \uC138
      \uCE90\uB9AD\uD130\uAC00 \uBAA8\uB450 \uC0DD\uC874\uD574 \uC788\uC744 \uC2DC\n\uD78C\uD2B8:
      \uBA54\uC774\uC640 \uD504\uB9AC\uB4DC, \uC0C8\uD134\uC774 \uD568\uAED8 \uC788\uC73C\uBA74
      \uC0C8\uD134\uC774 \uC5B4\uB5A4 \uAC83\uC5D0 \uBD84\uB178\uD558\uB294\uC9C0
      \uC54C \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
