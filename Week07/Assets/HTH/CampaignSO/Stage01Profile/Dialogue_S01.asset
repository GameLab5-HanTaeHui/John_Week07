      Text: "\uC774 \uB9CE\uC740 \uB9C8\uC74C\uC774 \uD55C\uACF3\uC73C\uB85C \uAC08
        \uB9AC \uC5C6\uC796\uC544. \uADF8\uB7EC\uB2C8 \uB354 \uD53C\uACE4\uD55C \uAC70\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
