    Lines:
    - SpeakerId: 2
      Text: "\uC758\uC2EC\uB3C4 \uB450\uB824\uC6C0\uB3C4 \uB098\uC911\uC774\uB2E4.
        \uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC558\uACE0, \uB098\uB294 \uB05D\uC744
        \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB05D\uC744 \uB17C\uD558\uAE30 \uC804\uC5D0, \uB204\uAC00 \uBA3C\uC800
        \uC0C1\uCC98 \uC785\uB294\uC9C0\uBD80\uD130 \uBCF4\uC544\uC57C \uD558\uC9C0
        \uC54A\uACA0\uC2B5\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC774\uB807\uAC8C \uB2E4 \uBAA8\uC5EC\uC11C \uAC19\uC740 \uB05D\uC744
        \uBCF8\uB2E4\uB294 \uB9D0, \uC194\uC9C1\uD788 \uB09C \uC544\uC9C1\uB3C4 \uC798
        \uBAA8\uB974\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB204\uAD70\uAC00 \uBA3C\uC800 \uC4F0\uB7EC\uC838\uC57C \uD55C\uB2E4\uBA74
        \uADF8\uAC74 \uB098\uC5EC\uC57C\uC9C0, \uB108\uD76C\uAC00 \uB420 \uC21C \uC5C6\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB2E4\uB4E4 \uC790\uAE30 \uC774\uC720\uB294 \uBD84\uBA85\uD574. \uBB38\uC81C\uB294
        \uADF8\uB7F0 \uC774\uC720\uAC00 \uB298 \uB204\uAD70\uAC00\uB97C \uBC00\uC5B4\uB0B8\uB2E4\uB294
        \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_2_3_4_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0200000003000000050000000600000007000000
    Lines:
    - SpeakerId: 2
      Text: "\uC758\uC2EC\uB3C4 \uB450\uB824\uC6C0\uB3C4 \uB098\uC911\uC774\uB2E4.
        \uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC558\uACE0, \uB098\uB294 \uB05D\uC744
        \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB05D\uC744 \uB17C\uD558\uAE30 \uC804\uC5D0, \uB204\uAC00 \uBA3C\uC800
        \uC0C1\uCC98 \uC785\uB294\uC9C0\uBD80\uD130 \uBCF4\uC544\uC57C \uD558\uC9C0
        \uC54A\uACA0\uC2B5\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uB2E4\uB4E4 \uC785\uC73C\uB85C\uB294 \uACB0\uB9D0\uC744 \uB9D0\uD558\uC9C0\uB9CC,
        \uC18D\uC5D0\uC120 \uC804\uBD80 \uB2E4\uB978 \uD5C8\uAE30\uB97C \uD0A4\uC6B0\uACE0
        \uC788\uAD70."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB204\uAD70\uAC00 \uBA3C\uC800 \uC4F0\uB7EC\uC838\uC57C \uD55C\uB2E4\uBA74
        \uADF8\uAC74 \uB098\uC5EC\uC57C\uC9C0, \uB108\uD76C\uAC00 \uB420 \uC21C \uC5C6\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB2E4\uB4E4 \uC790\uAE30 \uC774\uC720\uB294 \uBD84\uBA85\uD574. \uBB38\uC81C\uB294
        \uADF8\uB7F0 \uC774\uC720\uAC00 \uB298 \uB204\uAD70\uAC00\uB97C \uBC00\uC5B4\uB0B8\uB2E4\uB294
        \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_2_3_5_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0200000004000000050000000600000007000000
    Lines:
    - SpeakerId: 2
      Text: "\uB204\uAC00 \uC5B4\uB5A4 \uB9C8\uC74C\uC73C\uB85C \uC11C \uC788\uB4E0
        \uC0C1\uAD00\uC5C6\uC5B4. \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uAC00\uB294 \uAC83\uB9CC\uC740
        \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB2E4\uB4E4 \uB108\uBB34 \uB9CE\uC740 \uAC78 \uC9CA\uC5B4\uC9C0\uACE0
        \uC788\uB124. \uB09C \uADF8\uB0E5 \uC870\uC6A9\uD788 \uB05D\uB0AC\uC73C\uBA74
        \uC88B\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC774 \uC815\uB3C4\uBA74 \uCF54\uC2A4\uAC00 \uC544\uB2C8\uB77C \uC5F0\uD68C\uC9C0.
        \uB204\uAC00 \uBA3C\uC800 \uBB34\uB108\uC9C8\uC9C0 \uAE30\uB300\uB418\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uACB0\uC815\uC774 \uD544\uC694\uD558\uB2E4\uBA74 \uB0B4\uAC00 \uAC10\uB2F9\uD558\uACA0\uB2E4.
        \uB2E4\uB9CC \uB05D\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC544 \uB2EC\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uC88B\uC544, \uB2E4\uB4E4 \uB9D0\uC740 \uBA4B\uC9C0\uB124. \uADF8\uB798\uC11C
        \uADF8 \uBA4B\uC9C4 \uACB0\uB9D0 \uC544\uB798 \uB204\uAC00 \uBA3C\uC800 \uAE54\uB9AC\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_2_4_5_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0300000004000000050000000600000007000000
    Lines:
    - SpeakerId: 3
      Text: "\uB300\uC758\uC640 \uACB0\uB9D0\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4\uB9CC,
        \uC81C\uAC8C \uAC00\uC7A5 \uC911\uC694\uD55C \uAC74 \uB8E8\uC774\uC2A4\uC758
        \uBB34\uC0AC\uC785\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB204\uAC00 \uC633\uC740\uC9C0\uBCF4\uB2E4, \uC5B8\uC81C\uCBE4 \uC880
        \uC26C\uAC8C \uB418\uB294\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uBD99\uC7A1\uB294 \uC0AC\uB78C\uB3C4 \uC788\uACE0, \uBA3C\uC800 \uB098\uC11C\uB824\uB294
        \uC0AC\uB78C\uB3C4 \uC788\uACE0, \uB05D\uAE4C\uC9C0 \uC758\uC2EC\uD558\uB294
        \uC0AC\uB78C\uB3C4 \uC788\uB124. \uC624\uB298\uC740 \uC720\uB09C\uD788 \uC18C\uB780\uC2A4\uB7EC\uC6CC."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uD754\uB4E4\uB824\uB3C4 \uC88B\uB2E4. \uB204\uAD70\uAC00\uB294 \uB05D\uAE4C\uC9C0
        \uBC84\uD2F0\uACE0 \uBAA8\uB450\uB97C \uC138\uC6CC\uC57C \uD558\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uC88B\uC740 \uB9D0\uC740 \uB9CE\uC9C0. \uADFC\uB370 \uADF8 \uB9D0\uB4E4\uC774
        \uB204\uAD6C\uB97C \uAC00\uC7A5 \uC791\uAC8C \uB9CC\uB4DC\uB294\uC9C0\uB294
        \uB298 \uB2A6\uAC8C \uBCF4\uC774\uB354\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_3_4_5_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 010000000200000003000000040000000500000006000000
    Lines:
    - SpeakerId: 1
      Text: "\uC774 \uC815\uB3C4\uB85C \uB9C8\uC74C\uC774 \uB9CE\uC544\uC9C0\uBA74,
        \uCE68\uBB35\uBCF4\uB2E4 \uC791\uC740 \uADE0\uC5F4\uC774 \uB354 \uC704\uD5D8\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uD754\uB4E4\uB9AC\uB294 \uAC74 \uC774\uD574\uD55C\uB2E4. \uADF8\uB798\uB3C4
        \uC5EC\uAE30\uC11C \uBC1C\uC744 \uBA48\uCD9C \uC21C \uC5C6\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uC5EC\uB7EC\uBD84\uC758 \uC0AC\uBA85\uC774 \uBB34\uC5C7\uC774\uB4E0,
        \uB8E8\uC774\uC2A4\uB97C \uD574\uCE58\uB294 \uC120\uD0DD\uC5D0\uB294 \uB3D9\uC758\uD560
        \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC774 \uB9CE\uC740 \uB9C8\uC74C\uC774 \uD55C\uACF3\uC73C\uB85C \uAC08
        \uB9AC \uC5C6\uC796\uC544. \uADF8\uB7EC\uB2C8 \uB354 \uD53C\uACE4\uD55C \uAC70\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC774\uC57C, \uD55C\uC790\uB9AC\uC5D0 \uC774\uB807\uAC8C \uB9CE\uC740
        \uACB0\uD54D\uC774 \uBAA8\uC774\uB2C8 \uD5A5\uC774 \uC815\uB9D0 \uC9C4\uD558\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uAC01\uC790\uC758 \uC774\uC720\uAC00 \uB2E4\uB974\uB354\uB77C\uB3C4,
        \uBB34\uB108\uC9C0\uB294 \uC21C\uAC04\uB9CC\uD07C\uC740 \uB0B4\uAC00 \uB9C9\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 1
      Text: "\uC0C8\uD134\uC740 \uB05D\uAE4C\uC9C0 \uC758\uC2EC\uD588\uC5B4\uC694.
        \uC5B4\uCA4C\uBA74 \uC6B0\uB9AC\uAC00 \uC678\uBA74\uD55C \uAC78 \uAC00\uC7A5
        \uC815\uD655\uD788 \uBCF4\uACE0 \uC788\uC5C8\uB294\uC9C0\uB3C4\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uC0C8\uD134\uC774 \uC5C6\uC73C\uBA74 \uC6B0\uB9B4 \uBA48\uCDB0 \uC138\uC6B8
        \uC0AC\uB78C\uC774 \uC904\uC5B4\uB4E0\uB2E4. \uADF8\uAC8C \uC624\uD788\uB824
        \uB450\uB835\uAD70."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uADF8\uC758 \uC9C8\uBB38\uC740 \uBD88\uD3B8\uD588\uC9C0\uB9CC, \uC644\uC804\uD788
        \uD2C0\uB9B0 \uB9D0\uC740 \uC544\uB2C8\uC5C8\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC0C8\uD134\uC740 \uACC4\uC18D \uBB3C\uC5C8\uC9C0. \uB098\uB294 \uBB3B\uB294
        \uAC83\uB3C4 \uC9C0\uCCE4\uB294\uB370\u2026 \uC774\uC81C \uB204\uAC00 \uBB3C\uC5B4\uBD10?"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC0C8\uD134 \uC5B8\uB2C8\uB294 \uD750\uB984\uC744 \uC790\uAFB8 \uB04A\uC5C8\uC5B4.
        \uADFC\uB370 \uADF8\uAC8C \uC5C6\uC73C\uB2C8\uAE4C, \uAE38\uC774 \uB108\uBB34
        \uB9E4\uB044\uB7EC\uC6CC."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uADF8\uC758 \uC758\uC2EC\uC774 \uB098\uB97C \uBA48\uCDB0 \uC138\uC6E0\uB2E4.
        \uC774\uC81C\uB294 \uB0B4\uAC00 \uC2A4\uC2A4\uB85C \uBB3C\uC5B4\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_3_4_5_6_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 010000000200000003000000040000000500000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uB2E4\uB4E4 \uAC19\uC740 \uAE38\uC744 \uBCF4\uB294 \uCC99\uD558\uC9C0\uB9CC,
        \uC2DC\uC120\uC774 \uD5A5\uD55C \uB05D\uC740 \uC804\uBD80 \uB2E4\uB974\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uC758\uC2EC\uB3C4 \uB450\uB824\uC6C0\uB3C4 \uB098\uC911\uC774\uB2E4.
        \uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC558\uACE0, \uB098\uB294 \uB05D\uC744
        \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB05D\uC744 \uB17C\uD558\uAE30 \uC804\uC5D0, \uB204\uAC00 \uBA3C\uC800
        \uC0C1\uCC98 \uC785\uB294\uC9C0\uBD80\uD130 \uBCF4\uC544\uC57C \uD558\uC9C0
        \uC54A\uACA0\uC2B5\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC774\uB807\uAC8C \uB2E4 \uBAA8\uC5EC\uC11C \uAC19\uC740 \uB05D\uC744
        \uBCF8\uB2E4\uB294 \uB9D0, \uC194\uC9C1\uD788 \uB09C \uC544\uC9C1\uB3C4 \uC798
        \uBAA8\uB974\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uB2E4\uB4E4 \uC785\uC73C\uB85C\uB294 \uACB0\uB9D0\uC744 \uB9D0\uD558\uC9C0\uB9CC,
        \uC18D\uC5D0\uC120 \uC804\uBD80 \uB2E4\uB978 \uD5C8\uAE30\uB97C \uD0A4\uC6B0\uACE0
        \uC788\uAD70."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB2E4\uB4E4 \uC790\uAE30 \uC774\uC720\uB294 \uBD84\uBA85\uD574. \uBB38\uC81C\uB294
        \uADF8\uB7F0 \uC774\uC720\uAC00 \uB298 \uB204\uAD70\uAC00\uB97C \uBC00\uC5B4\uB0B8\uB2E4\uB294
        \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 1
      Text: "\uD504\uB9AC\uB4DC\uB294 \uB05D\uAE4C\uC9C0 \uB204\uAD70\uAC00\uC758
        \uBAAB\uC744 \uB300\uC2E0 \uAC00\uC838\uAC00\uB824 \uD588\uC5B4\uC694. \uADF8\uAC8C
        \uBAA8\uB450\uB97C \uC0B4\uB9AC\uB294 \uAE38\uC774\uB77C \uBBFF\uC73C\uBA74\uC11C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uC65C \uB124\uAC00 \uBA3C\uC800\uC600\uC5B4. \uC65C \uB610 \uC774\uB7F0
        \uC2DD\uC73C\uB85C \uBE44\uC5B4 \uBC84\uB824\uC57C \uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uC88B\uC740 \uB73B\uC73C\uB85C \uD3EC\uC7A5\uD558\uAE30\uC5D4, \uB0A8\uC740
        \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uB0A8\uC740 \uBB34\uAC8C\uAC00 \uB108\uBB34
        \uD07D\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uBBF8\uC548\uD574. \uB108\uB294 \uB298 \uB300\uC2E0 \uC9CA\uC5B4\uC84C\uB294\uB370,
        \uB098\uB294 \uB05D\uAE4C\uC9C0 \uAE30\uB300\uAE30\uB9CC \uD588\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uD504\uB9AC\uB4DC \uC624\uBE60\uB294 \uAC00\uC7A5 \uBA3C\uC800 \uB098\uC130\uC5B4.
        \uADF8\uB7F0 \uC0AC\uB78C\uC740 \uC0AC\uB77C\uC9C0\uB294 \uC21C\uAC04\uAE4C\uC9C0
        \uB530\uB73B\uD558\uAD6C\uB098."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uBD10. \uACB0\uAD6D \uB9C8\uC9C0\uB9C9 \uC120\uD0DD\uAE4C\uC9C0 \uD63C\uC790
        \uAC00\uC838\uAC14\uC796\uC544. \uB0A8\uC740 \uC0AC\uB78C\uD55C\uD14C \uBB3C\uC5B4\uBCF4\uC9C0\uB3C4
        \uC54A\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_3_4_5_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 010000000200000003000000040000000600000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uC774\uB807\uAC8C \uBAA8\uC774\uBA74 \uB204\uAC00 \uBB34\uB108\uC9C8\uC9C0\uBCF4\uB2E4,
        \uB204\uAC00 \uB05D\uAE4C\uC9C0 \uC228\uAE38\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uB204\uAC00 \uC5B4\uB5A4 \uB9C8\uC74C\uC73C\uB85C \uC11C \uC788\uB4E0
        \uC0C1\uAD00\uC5C6\uC5B4. \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uAC00\uB294 \uAC83\uB9CC\uC740
        \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uBAA8\uB450\uC758 \uB73B\uC774 \uB2E4\uB974\uB2E4\uB294 \uAC74 \uC555\uB2C8\uB2E4.
        \uD558\uC9C0\uB9CC \uB8E8\uC774\uC2A4\uB9CC\uC740 \uC774 \uC18C\uB780\uC5D0\uC11C
        \uBE7C \uB450\uACE0 \uC2F6\uAD70\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB2E4\uB4E4 \uB108\uBB34 \uB9CE\uC740 \uAC78 \uC9CA\uC5B4\uC9C0\uACE0
        \uC788\uB124. \uB09C \uADF8\uB0E5 \uC870\uC6A9\uD788 \uB05D\uB0AC\uC73C\uBA74
        \uC88B\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uACB0\uC815\uC774 \uD544\uC694\uD558\uB2E4\uBA74 \uB0B4\uAC00 \uAC10\uB2F9\uD558\uACA0\uB2E4.
        \uB2E4\uB9CC \uB05D\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC544 \uB2EC\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uC88B\uC544, \uB2E4\uB4E4 \uB9D0\uC740 \uBA4B\uC9C0\uB124. \uADF8\uB798\uC11C
        \uADF8 \uBA4B\uC9C4 \uACB0\uB9D0 \uC544\uB798 \uB204\uAC00 \uBA3C\uC800 \uAE54\uB9AC\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 1
      Text: "\uD1A0\uB2C8\uB294 \uB298 \uC6C3\uACE0 \uC788\uC5C8\uC8E0. \uADF8 \uC6C3\uC74C\uC774
        \uBB34\uC5C7\uC744 \uAC00\uB9AC\uACE0 \uC788\uC5C8\uB294\uC9C0, \uC774\uC81C
        \uD655\uC778\uD560 \uC218 \uC5C6\uB124\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uD1A0\uB2C8\uAC00 \uBE60\uC84C\uB2E4\uACE0 \uD574\uC11C \uB05D\uB09C
        \uAC74 \uC544\uB2C8\uC57C. \uB0A8\uC740 \uD754\uC801\uBD80\uD130 \uD655\uC778\uD574\uC57C
        \uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uBD88\uC548\uD55C \uC544\uC774\uC600\uC2B5\uB2C8\uB2E4. \uB8E8\uC774\uC2A4\uC5D0\uAC8C
        \uAC00\uAE4C\uC774 \uC624\uC9C0 \uBABB\uD558\uAC8C \uD55C \uD310\uB2E8\uC774
        \uD2C0\uB9AC\uC9C4 \uC54A\uC558\uAD70\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uD1A0\uB2C8\uAC00 \uC870\uC6A9\uD558\uB2C8\uAE4C \uC774\uC0C1\uD574.
        \uBC1D\uC740 \uC18C\uB9AC\uAC00 \uC0AC\uB77C\uC84C\uB294\uB370, \uC548\uC2EC\uC774
        \uB418\uC9C4 \uC54A\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uC544\uC774\uCC98\uB7FC \uC6C3\uB358 \uC5BC\uAD74 \uB4A4\uC758 \uC5B4\uB460\uC744
        \uB0B4\uAC00 \uB108\uBB34 \uB2A6\uAC8C \uBD24\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB4DC\uB514\uC5B4 \uC870\uC6A9\uD574\uC84C\uB124. \uADF8\uB7F0\uB370
        \uBB38\uC81C\uB294, \uC870\uC6A9\uD574\uC9C4 \uB4A4\uC5D0\uB3C4 \uCC1C\uCC1C\uD558\uB2E4\uB294
        \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_3_4_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 010000000200000003000000050000000600000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uD55C\uC790\uB9AC\uC5D0 \uC774\uB807\uAC8C \uB2E4\uB978 \uACB0\uD54D\uC774
        \uBAA8\uC600\uB294\uB370\uB3C4 \uC544\uC9C1 \uD568\uAED8 \uC11C \uC788\uB2E4\uB294
        \uAC8C \uB354 \uC2E0\uAE30\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uAC01\uC790\uC758 \uC0DD\uAC01\uC774 \uB2E4\uB974\uB354\uB77C\uB3C4,
        \uC9C0\uAE08\uC740 \uAC19\uC740 \uBC29\uD5A5\uC744 \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB300\uC758\uC640 \uACB0\uB9D0\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4\uB9CC,
        \uC81C\uAC8C \uAC00\uC7A5 \uC911\uC694\uD55C \uAC74 \uADF8 \uC0AC\uB78C\uC758
        \uBB34\uC0AC\uC785\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC774\uC0C1\uD560 \uB9CC\uD07C \uC5EC\uB7EC \uAE30\uB958\uAC00 \uD55C\uC790\uB9AC\uC5D0
        \uBAA8\uC600\uB124. \uADF8\uB798\uC11C \uB354 \uD765\uBBF8\uB85C\uC6CC."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uD754\uB4E4\uB824\uB3C4 \uC88B\uB2E4. \uB204\uAD70\uAC00\uB294 \uB05D\uAE4C\uC9C0
        \uBC84\uD2F0\uACE0 \uBAA8\uB450\uB97C \uC138\uC6CC\uC57C \uD558\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uD070 \uB9D0\uB4E4\uC740 \uB298 \uADF8\uB7F4\uB4EF\uD558\uC9C0. \uADFC\uB370
        \uADF8 \uB9D0\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uBC00\uB824\uB098\uB294 \uCABD\uC740
        \uB204\uAC00 \uBCF4\uB098?"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 1
      Text: "\uB8E8\uC774\uC2A4\uB294 \uC26C\uACE0 \uC2F6\uB2E4\uACE0 \uD588\uC744
        \uBFD0\uC778\uB370\u2026 \uC6B0\uB9AC\uB294 \uADF8 \uB9D0\uB3C4 \uC81C\uB300\uB85C
        \uB4E3\uC9C0 \uBABB\uD588\uB124\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uB8E8\uC774\uC2A4\uAE4C\uC9C0 \uC783\uC5C8\uB2E4. \uB354\uB294 \uB204\uAD6C\uB3C4
        \uB4A4\uC5D0 \uB0A8\uAE30\uC9C0 \uC54A\uACA0\uB2E4\uACE0 \uD588\uB294\uB370."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4\uAC00 \uC5C6\uB294 \uAE38\uC774\uB77C\uBA74, \uC81C\uAC00
        \uAC78\uC5B4\uC57C \uD560 \uC774\uC720\uB3C4 \uC0AC\uB77C\uC84C\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uB8E8\uC774\uC2A4 \uC5B8\uB2C8\uB294 \uC870\uC6A9\uD588\uB294\uB370\u2026
        \uC870\uC6A9\uD55C \uB9DB\uC740 \uC0AC\uB77C\uC9C0\uACE0 \uB098\uC11C \uB354
        \uC624\uB798 \uB0A8\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uADF8\uAC00 \uB354 \uC26C\uC5B4\uB3C4 \uB41C\uB2E4\uACE0 \uB9D0\uD574\uC92C\uC5B4\uC57C
        \uD588\uB2E4. \uB0B4\uAC00 \uB300\uC2E0 \uC9CA\uC5B4\uC9C8 \uC218 \uC788\uC5C8\uB294\uB370."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uBA48\uCD94\uACE0 \uC2F6\uB2E4\uB358 \uC0AC\uB78C\uC744 \uB05D\uAE4C\uC9C0
        \uB04C\uACE0 \uC628 \uACB0\uACFC\uAC00 \uC774\uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_3_5_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 010000000200000004000000050000000600000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uC774 \uC815\uB3C4\uB85C \uB9C8\uC74C\uC774 \uB9CE\uC544\uC9C0\uBA74,
        \uCE68\uBB35\uBCF4\uB2E4 \uC791\uC740 \uADE0\uC5F4\uC774 \uB354 \uC704\uD5D8\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uD754\uB4E4\uB9AC\uB294 \uAC74 \uC774\uD574\uD55C\uB2E4. \uADF8\uB798\uB3C4
        \uC5EC\uAE30\uC11C \uBC1C\uC744 \uBA48\uCD9C \uC21C \uC5C6\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC774 \uB9CE\uC740 \uB9C8\uC74C\uC774 \uD55C\uACF3\uC73C\uB85C \uAC08
        \uB9AC \uC5C6\uC796\uC544. \uADF8\uB7EC\uB2C8 \uB354 \uD53C\uACE4\uD55C \uAC70\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC774\uC57C, \uD55C\uC790\uB9AC\uC5D0 \uC774\uB807\uAC8C \uB9CE\uC740
        \uACB0\uD54D\uC774 \uBAA8\uC774\uB2C8 \uD5A5\uC774 \uC815\uB9D0 \uC9C4\uD558\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uAC01\uC790\uC758 \uC774\uC720\uAC00 \uB2E4\uB974\uB354\uB77C\uB3C4,
        \uBB34\uB108\uC9C0\uB294 \uC21C\uAC04\uB9CC\uD07C\uC740 \uB0B4\uAC00 \uB9C9\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB610 \uC55E\uC73C\uB85C \uAC00\uC790\uACE0 \uD558\uB124. \uADF8 \uB9D0\uC774
        \uC2DC\uC791\uB420 \uB54C\uB9C8\uB2E4 \uB4A4\uC5D0 \uB0A8\uB294 \uC5BC\uAD74\uBD80\uD130
        \uB5A0\uC62C\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 1
      Text: "\uB370\uC6B0\uC2A4\uAC00 \uC0AC\uB77C\uC84C\uB2E4\uBA74, \uC774\uC81C
        \uB8E8\uC774\uC2A4\uB97C \uBD99\uC7A1\uACE0 \uC788\uB358 \uC138\uACC4\uB3C4
        \uD754\uB4E4\uB9AC\uACA0\uC8E0."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uC9C0\uAE08\uC740 \uB8E8\uC774\uC2A4\uBD80\uD130 \uCC59\uACA8. \uB354
        \uBB34\uB108\uC9C0\uB294 \uC0AC\uB78C\uC740 \uC5C6\uC5B4\uC57C \uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB370\uC6B0\uC2A4\u2026? \uB300\uB2F5\uD574. \uB098, \uC774\uC81C \uC5B4\uB514\uC5D0
        \uAE30\uB300\uC57C \uD574?"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uB458\uC774 \uD558\uB098\uCC98\uB7FC \uBD99\uC5B4 \uC788\uC5C8\uB294\uB370\u2026
        \uD558\uB098\uAC00 \uB5A8\uC5B4\uC9C0\uBA74 \uB098\uBA38\uC9C0\uB294 \uC5B4\uB5BB\uAC8C
        \uB420\uAE4C?"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB8E8\uC774\uC2A4 \uACC1\uC5D0 \uB0B4\uAC00 \uC11C\uACA0\uB2E4. \uB370\uC6B0\uC2A4\uAC00
        \uB0A8\uAE34 \uBE48\uC790\uB9AC\uB97C \uBC29\uCE58\uD558\uC9C0 \uC54A\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uD55C\uACF3\uC5D0 \uB108\uBB34 \uB9CE\uC740 \uBB34\uAC8C\uB97C \uC2E4\uC73C\uBA74,
        \uB0A8\uC740 \uCABD\uC740 \uC11C \uC788\uB294 \uBC95\uBD80\uD130 \uC78A\uC5B4\uBC84\uB9AC\uAC8C
        \uB3FC."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB370\uC6B0\uC2A4\uAC00 \uC5C6\uC73C\uBA74\u2026 \uC5EC\uAE34 \uB108\uBB34
        \uC2DC\uB044\uB7FD\uACE0, \uB108\uBB34 \uBC1D\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 1
      Text: "\uB8E8\uC774\uC2A4, \uC9C0\uAE08\uC740 \uC5EC\uAE30 \uC788\uC5B4\uC694.
        \uB204\uAD70\uAC00\uC758 \uBE48\uC790\uB9AC\uB97C \uB354 \uD06C\uAC8C \uB9CC\uB4E4
        \uD544\uC694\uB294 \uC5C6\uC796\uC544\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uB8E8\uC774\uC2A4\uB97C \uBD99\uC7A1\uC544. \uC9C0\uAE08 \uBB34\uB108\uC9C0\uBA74
        \uC804\uBD80 \uC783\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB0B4\uAC00 \uACC1\uC5D0 \uC11C\uACA0\uB2E4. \uAE30\uB300\uB3C4 \uB41C\uB2E4.
        \uADF8\uB7EC\uB2C8 \uC9C0\uAE08\uC740 \uC228\uB9CC \uC26C\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uBE48\uC790\uB9AC\uB97C \uB9D0\uB85C \uBA54\uC6B8 \uC218\uB294 \uC5C6\uC5B4.
        \uADF8\uB798\uB3C4 \uB193\uC544\uBC84\uB9AC\uAC8C \uB450\uBA74 \uC548 \uB3FC."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC624\uB298\uC740 \uC7A5\uB09C\uCE58\uBA74 \uC548 \uB418\uB294 \uB0A0
        \uAC19\uC544. \uB8E8\uC774\uC2A4 \uC5B8\uB2C8, \uB208 \uAC10\uC9C0 \uB9C8."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_4_5_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 010000000300000004000000050000000600000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uB2E4\uB4E4 \uAC19\uC740 \uAE38\uC744 \uBCF4\uB294 \uCC99\uD558\uC9C0\uB9CC,
        \uC2DC\uC120\uC774 \uD5A5\uD55C \uB05D\uC740 \uC804\uBD80 \uB2E4\uB974\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB05D\uC744 \uB17C\uD558\uAE30 \uC804\uC5D0, \uB204\uAC00 \uBA3C\uC800
        \uC0C1\uCC98 \uC785\uB294\uC9C0\uBD80\uD130 \uBCF4\uC544\uC57C \uD558\uC9C0
        \uC54A\uACA0\uC2B5\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC774\uB807\uAC8C \uB2E4 \uBAA8\uC5EC\uC11C \uAC19\uC740 \uB05D\uC744
        \uBCF8\uB2E4\uB294 \uB9D0, \uC194\uC9C1\uD788 \uB09C \uC544\uC9C1\uB3C4 \uC798
        \uBAA8\uB974\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uB2E4\uB4E4 \uC785\uC73C\uB85C\uB294 \uACB0\uB9D0\uC744 \uB9D0\uD558\uC9C0\uB9CC,
        \uC18D\uC5D0\uC120 \uC804\uBD80 \uB2E4\uB978 \uD5C8\uAE30\uB97C \uD0A4\uC6B0\uACE0
        \uC788\uAD70."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB204\uAD70\uAC00 \uBA3C\uC800 \uC4F0\uB7EC\uC838\uC57C \uD55C\uB2E4\uBA74
        \uADF8\uAC74 \uB098\uC5EC\uC57C\uC9C0, \uB108\uD76C\uAC00 \uB420 \uC21C \uC5C6\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB2E4\uB4E4 \uC790\uAE30 \uC774\uC720\uB294 \uBD84\uBA85\uD574. \uBB38\uC81C\uB294
        \uADF8\uB7F0 \uC774\uC720\uAC00 \uB298 \uB204\uAD70\uAC00\uB97C \uBC00\uC5B4\uB0B8\uB2E4\uB294
        \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 1
      Text: "\uBA54\uC774\uAC00 \uBA48\uCDC4\uC5B4\uC694. \uB204\uAD6C\uBCF4\uB2E4
        \uB05D\uC744 \uBCF4\uB824 \uD558\uB358 \uC0AC\uB78C\uC774\u2026"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uADF8\uC758 \uBC29\uC2DD\uC774 \uBD88\uC548\uD558\uAE34 \uD588\uC9C0\uB9CC,
        \uC774\uB7F0 \uACB0\uACFC\uAE4C\uC9C0 \uBC14\uB780 \uC801\uC740 \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC774\uC81C \uB354 \uAC00\uC790\uACE0 \uB9D0\uD560 \uC0AC\uB78C\uC774
        \uC904\uC5C8\uB124. \uADF8\uB7F0\uB370 \uC65C \uD558\uB098\uB3C4 \uAC00\uBCCD\uC9C0
        \uC54A\uC9C0."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uBA54\uC774 \uC5B8\uB2C8\uC758 \uBD88\uAF43\uC774 \uAEBC\uC84C\uC5B4.
        \uC774\uB807\uAC8C \uBE68\uB9AC \uC2DD\uC744 \uC904\uC740 \uBAB0\uB790\uB294\uB370."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uBA54\uC774\uAC00 \uC9CA\uC5B4\uC9C4 \uACB0\uB9D0\uC744 \uB0B4\uAC00
        \uB300\uC2E0 \uB05D\uAE4C\uC9C0 \uAC00\uC838\uAC00\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uACB0\uB9D0\uB9CC \uBCF4\uB358 \uC0AC\uB78C\uC774 \uACB0\uAD6D \uACFC\uC815\uC5D0\uC11C
        \uC0AC\uB77C\uC84C\uC5B4. \uADF8\uB798\uC11C \uB0B4\uAC00 \uACC4\uC18D \uBB3C\uC5C8\uB358
        \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_3_4_5_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 020000000300000004000000050000000600000007000000
    Lines:
    - SpeakerId: 2
      Text: "\uB204\uAC00 \uC5B4\uB5A4 \uB9C8\uC74C\uC73C\uB85C \uC11C \uC788\uB4E0
        \uC0C1\uAD00\uC5C6\uC5B4. \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uAC00\uB294 \uAC83\uB9CC\uC740
        \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uBAA8\uB450\uC758 \uB73B\uC774 \uB2E4\uB974\uB2E4\uB294 \uAC74 \uC555\uB2C8\uB2E4.
        \uD558\uC9C0\uB9CC \uB8E8\uC774\uC2A4\uB9CC\uC740 \uC774 \uC18C\uB780\uC5D0\uC11C
        \uBE7C \uB450\uACE0 \uC2F6\uAD70\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB2E4\uB4E4 \uB108\uBB34 \uB9CE\uC740 \uAC78 \uC9CA\uC5B4\uC9C0\uACE0
        \uC788\uB124. \uB09C \uADF8\uB0E5 \uC870\uC6A9\uD788 \uB05D\uB0AC\uC73C\uBA74
        \uC88B\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC774 \uC815\uB3C4\uBA74 \uCF54\uC2A4\uAC00 \uC544\uB2C8\uB77C \uC5F0\uD68C\uC9C0.
        \uB204\uAC00 \uBA3C\uC800 \uBB34\uB108\uC9C8\uC9C0 \uAE30\uB300\uB418\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uACB0\uC815\uC774 \uD544\uC694\uD558\uB2E4\uBA74 \uB0B4\uAC00 \uAC10\uB2F9\uD558\uACA0\uB2E4.
        \uB2E4\uB9CC \uB05D\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC544 \uB2EC\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uC88B\uC544, \uB2E4\uB4E4 \uB9D0\uC740 \uBA4B\uC9C0\uB124. \uADF8\uB798\uC11C
        \uADF8 \uBA4B\uC9C4 \uACB0\uB9D0 \uC544\uB798 \uB204\uAC00 \uBA3C\uC800 \uAE54\uB9AC\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uC5D4\uBE44\uAC00 \uC774\uB807\uAC8C \uC0AC\uB77C\uC9C8 \uC904\uC740
        \uBAB0\uB790\uC5B4. \uBBFF\uC5C8\uB358 \uB9CC\uD07C, \uBE48\uC790\uB9AC\uAC00
        \uB354 \uC704\uD5D8\uD558\uAC8C \uB290\uAEF4\uC9C4\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4, \uC7A0\uAE50 \uC5EC\uAE30 \uC788\uC5B4\uC694. \uC9C0\uAE08\uC740
        \uB9C8\uC74C\uC774 \uD750\uD2B8\uB7EC\uC9C0\uC9C0 \uC54A\uAC8C \uD558\uB294
        \uAC8C \uBA3C\uC800\uC785\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC5D4\uBE44\uB294 \uC870\uC6A9\uD574\uC11C \uD3B8\uD588\uB294\uB370\u2026
        \uC870\uC6A9\uD55C \uC0AC\uB78C\uB3C4 \uC774\uB807\uAC8C \uC0AC\uB77C\uC9C0\uB294\uAD6C\uB098."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC5D4\uBE44 \uC5B8\uB2C8\uB294 \uB298 \uD55C\uBC1C \uC55E\uC11C \uC788\uB294
        \uAC83 \uAC19\uC558\uB294\uB370\u2026 \uC774\uB7F0 \uC2DD\uC73C\uB85C \uBE44\uAC8C
        \uB420 \uC904\uC740 \uBAB0\uB790\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB0B4\uAC00 \uBA3C\uC800 \uB9C9\uC558\uC5B4\uC57C \uD588\uB2E4. \uC5D4\uBE44\uAC00
        \uB0A8\uAE34 \uCE68\uBB35\uAE4C\uC9C0 \uB0B4\uAC00 \uC9CA\uC5B4\uC9C0\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uBD80\uB4DC\uB7EC\uC6B4 \uB9D0 \uB4A4\uC5D0 \uBB50\uAC00 \uC788\uC5C8\uB294\uC9C0\uB294
        \uC774\uC81C \uBABB \uBB3B\uACA0\uB124. \uADF8\uB798\uB3C4 \uB204\uAC00 \uB0A8\uACBC\uB294\uC9C0\uB294
        \uBD10\uC57C \uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_2_3_4_5_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 01000000020000000300000004000000050000000600000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uC774\uB807\uAC8C \uBAA8\uC774\uBA74 \uB204\uAC00 \uBB34\uB108\uC9C8\uC9C0\uBCF4\uB2E4,
        \uB204\uAC00 \uB05D\uAE4C\uC9C0 \uC228\uAE38\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uB204\uAC00 \uC5B4\uB5A4 \uB9C8\uC74C\uC73C\uB85C \uC11C \uC788\uB4E0
        \uC0C1\uAD00\uC5C6\uC5B4. \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uAC00\uB294 \uAC83\uB9CC\uC740
        \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uBAA8\uB450\uC758 \uB73B\uC774 \uB2E4\uB974\uB2E4\uB294 \uAC74 \uC555\uB2C8\uB2E4.
        \uD558\uC9C0\uB9CC \uB8E8\uC774\uC2A4\uB9CC\uC740 \uC774 \uC18C\uB780\uC5D0\uC11C
        \uBE7C \uB450\uACE0 \uC2F6\uAD70\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB2E4\uB4E4 \uB108\uBB34 \uB9CE\uC740 \uAC78 \uC9CA\uC5B4\uC9C0\uACE0
        \uC788\uB124. \uB09C \uADF8\uB0E5 \uC870\uC6A9\uD788 \uB05D\uB0AC\uC73C\uBA74
        \uC88B\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC774 \uC815\uB3C4\uBA74 \uCF54\uC2A4\uAC00 \uC544\uB2C8\uB77C \uC5F0\uD68C\uC9C0.
        \uB204\uAC00 \uBA3C\uC800 \uBB34\uB108\uC9C8\uC9C0 \uAE30\uB300\uB418\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uACB0\uC815\uC774 \uD544\uC694\uD558\uB2E4\uBA74 \uB0B4\uAC00 \uAC10\uB2F9\uD558\uACA0\uB2E4.
        \uB2E4\uB9CC \uB05D\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC544 \uB2EC\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uC88B\uC544, \uB2E4\uB4E4 \uB9D0\uC740 \uBA4B\uC9C0\uB124. \uADF8\uB798\uC11C
        \uADF8 \uBA4B\uC9C4 \uACB0\uB9D0 \uC544\uB798 \uB204\uAC00 \uBA3C\uC800 \uAE54\uB9AC\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uC624\uB298\uC740 \uC5EC\uAE30\uC11C \uC815\uBE44\uD558\uACE0, \uB0B4\uC77C
        \uC544\uCE68 \uBC14\uB85C \uC774\uB3D9\uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\u2026\uC870\uAE08\uB9CC \uB354 \uC26C\uBA74 \uC548 \uB3FC? \uBC1C\uC774
        \uBB34\uAC70\uC6CC."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4\uC758 \uC0C1\uD0DC\uB97C \uACE0\uB824\uD574\uC57C
        \uD569\uB2C8\uB2E4. \uBB34\uB9AC\uD55C \uC774\uB3D9\uC740 \uC704\uD5D8\uD569\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB458 \uB2E4 \uB9DE\uB294 \uB9D0\uC774\uB2E4. \uC815\uBE44\uC640 \uD734\uC2DD\uC744
        \uBCD1\uD589\uD558\uC790."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uADF8\uB7FC \uC800\uB141\uC740 \uB530\uB73B\uD55C \uAC70\uC57C? \uD1A0\uB2C8\uB294
        \uAD6D\uBB3C\uC774 \uC788\uB294 \uAC8C \uC88B\uC544!"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 1
      Text: "\uC2DD\uC0AC\uBD80\uD130 \uD558\uC8E0. \uB2E4\uB4E4 \uC9C0\uCCD0 \uC788\uC73C\uB2C8\uAE4C\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uC6C0\uC9C1\uC774\uAE30 \uC804\uC5D0 \uB4A4\uC5D0 \uB0A8\uB294 \uC0AC\uB78C\uC774
        \uC5C6\uB294\uC9C0 \uD655\uC778\uD574. \uB298 \uADF8\uAC8C \uBB38\uC81C\uC600\uC73C\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC640\uC544, \uC624\uB298 \uBE75\uC740 \uC870\uAE08 \uB531\uB531\uD574!
        \uADFC\uB370 \uC539\uB2E4 \uBCF4\uBA74 \uACE0\uC18C\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\u2026\uADF8\uB7F0 \uAC78 \uC798\uB3C4 \uB290\uB07C\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 1
      Text: "\uD1A0\uB2C8\uB294 \uC791\uC740 \uCC28\uC774\uB3C4 \uC798 \uC54C\uC544\uCC28\uB9AC\uB2C8\uAE4C\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uC2DD\uC0AC\uAC00 \uB05D\uB098\uBA74 \uC7A5\uBE44 \uC810\uAC80\uC774\uB2E4.
        \uB0B4\uC77C\uC740 \uB354 \uD5D8\uD574\uC9C8 \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4\uB294 \uBA3C\uC800 \uC26C\uAC8C \uD558\uACA0\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB610 \uB530\uB85C \uB5BC\uC5B4\uB193\uB294\uAD70."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uC9C0\uAE08\uC740 \uB2E4\uD234 \uB54C\uAC00 \uC544\uB2C8\uB2E4. \uD544\uC694\uD55C
        \uC900\uBE44\uBD80\uD130 \uB05D\uB0B4\uC790."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_3_4_5_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
