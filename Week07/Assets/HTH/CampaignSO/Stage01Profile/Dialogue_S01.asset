    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uC774\uBC88 \uC758\uB8B0\uB294 \uC870\uAE08 \uC704\uD5D8\uD560 \uC218\uB3C4
        \uC788\uB2E4. \uC6D0\uD615\uC73C\uB85C \uC9C4\uD615\uC744 \uAD6C\uCD95\uD558\uACE0
        \uC11C\uB85C\uB97C \uC9C0\uCF1C\uC57C \uD574."
      RevealCharacterId: -1
