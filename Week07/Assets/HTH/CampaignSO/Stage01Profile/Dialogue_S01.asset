  - ComboId: C102
    ComboKey: '#1|#3|#4|#5|#6'
    ParticipantIds: 0100000003000000040000000500000006000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#3|#4|#5|#6"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uC774\uB807\uAC8C \uBAA8\uC774\uBA74 \uB204\uAC00 \uBB34\uB108\uC9C8\uC9C0\uBCF4\uB2E4,
        \uB204\uAC00 \uB05D\uAE4C\uC9C0 \uC228\uAE38\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uBAA8\uB450\uC758 \uB73B\uC774 \uB2E4\uB974\uB2E4\uB294 \uAC74 \uC555\uB2C8\uB2E4.
        \uD558\uC9C0\uB9CC \uB8E8\uC774\uC2A4\uB9CC\uC740 \uC774 \uC18C\uB780\uC5D0\uC11C
        \uBE7C \uB450\uACE0 \uC2F6\uAD70\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB2E4\uB4E4 \uB108\uBB34 \uB9CE\uC740 \uAC78 \uC9CA\uC5B4\uC9C0\uACE0
        \uC788\uB124. \uB09C \uADF8\uB0E5 \uC870\uC6A9\uD788 \uB05D\uB0AC\uC73C\uBA74
        \uC88B\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC774 \uC815\uB3C4\uBA74 \uCF54\uC2A4\uAC00 \uC544\uB2C8\uB77C \uC5F0\uD68C\uC9C0.
        \uB204\uAC00 \uBA3C\uC800 \uBB34\uB108\uC9C8\uC9C0 \uAE30\uB300\uB418\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uACB0\uC815\uC774 \uD544\uC694\uD558\uB2E4\uBA74 \uB0B4\uAC00 \uAC10\uB2F9\uD558\uACA0\uB2E4.
        \uB2E4\uB9CC \uB05D\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC544 \uB2EC\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C103
    ComboKey: '#1|#3|#4|#5|#7'
    ParticipantIds: 0100000003000000040000000500000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#3|#4|#5|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uD55C\uC790\uB9AC\uC5D0 \uC774\uB807\uAC8C \uB2E4\uB978 \uACB0\uD54D\uC774
        \uBAA8\uC600\uB294\uB370\uB3C4 \uC544\uC9C1 \uD568\uAED8 \uC11C \uC788\uB2E4\uB294
        \uAC8C \uB354 \uC2E0\uAE30\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB300\uC758\uC640 \uACB0\uB9D0\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4\uB9CC,
        \uC81C\uAC8C \uAC00\uC7A5 \uC911\uC694\uD55C \uAC74 \uB8E8\uC774\uC2A4\uC758
        \uBB34\uC0AC\uC785\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB204\uAC00 \uC633\uC740\uC9C0\uBCF4\uB2E4, \uC5B8\uC81C\uCBE4 \uC880
        \uC26C\uAC8C \uB418\uB294\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC228\uAE30\uB294 \uC0AC\uB78C, \uBD99\uB4DC\uB294 \uC0AC\uB78C, \uB5A0\uB3C4\uB294
        \uC0AC\uB78C\uAE4C\uC9C0. \uC624\uB298 \uACF5\uAE30\uAC00 \uAF64 \uC798 \uC775\uC5C8\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uC0AC\uB791\uC774\uB4E0 \uC758\uC2EC\uC774\uB4E0 \uB2E4 \uC88B\uC9C0.
        \uADFC\uB370 \uADF8\uB7F0 \uB9D0 \uB4A4\uC5D0 \uB0A8\uB294 \uC0AC\uB78C\uC740
        \uB204\uAC00 \uC138\uB098?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
