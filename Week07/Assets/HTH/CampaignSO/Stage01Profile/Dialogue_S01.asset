  - ComboId: C018
    ComboKey: '#4|#7'
    ParticipantIds: 0400000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #4|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 4
      Text: "\uADF8\uB7F0 \uC9C8\uBB38\uC740 \uB4E3\uAE30 \uC2EB\uC740\uB370, \uC774\uC0C1\uD558\uAC8C
        \uAC00\uC7A5 \uD53C\uD560 \uC218 \uC5C6\uB294 \uB9D0\uCC98\uB7FC \uB4E4\uB824."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uB8E8\uC774\uC2A4 \uC624\uBE60\uB294 \uC870\uC6A9\uD574\uC11C \uC88B\uC544.
        \uC606\uC5D0 \uC788\uC73C\uBA74 \uC218\uD504 \uC2DD\uB294 \uC18C\uB9AC\uB3C4
        \uB4E4\uB9B4 \uAC83 \uAC19\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB09C \uD070 \uB9D0\uBCF4\uB2E4, \uADF8 \uACFC\uC815\uC5D0\uC11C \uB193\uCE58\uB294
        \uAC8C \uC5C6\uB294\uC9C0\uBD80\uD130 \uBCF4\uB294 \uD3B8\uC774\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\u2026\uADF8\uB7F0 \uC18C\uB9AC\uB294 \uC548 \uB4E4\uB824."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uD1A0\uB2C8\uB294 \uB4E4\uB9AC\uB294 \uAC83 \uAC19\uC740\uB370? \uAE30\uBD84\uC774
        \uB9D0\uB791\uD574\uC9C0\uB294 \uC18C\uB9AC!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB108 \uC774\uC0C1\uD574. \uADFC\uB370\u2026 \uC2DC\uB044\uB7FD\uC9C4
        \uC54A\uC544\uC11C \uAD1C\uCC2E\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C019
    ComboKey: '#5|#6'
    ParticipantIds: 0500000006000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #5|#6"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 5
      Text: "\uD504\uB9AC\uB4DC \uAC19\uC740 \uC0AC\uB78C\uC740 \uB4DC\uBB3C\uC9C0.
        \uC2A4\uC2A4\uB85C \uBA3C\uC800 \uB098\uC11C\uB824\uB294 \uC0AC\uB78C\uC740
        \uC5B4\uB514\uC11C\uB098 \uB208\uC5D0 \uB744\uAC70\uB4E0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uBB34\uB9AC\uD558\uC9C0 \uB9C8\uB77C. \uD544\uC694\uD55C \uC77C\uC740
        \uB0B4\uAC00 \uD558\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uAC00\uBCBC\uC6B4 \uB9D0\uB85C \uB118\uAE38 \uC218 \uC5C6\uB294 \uC120\uC774
        \uC788\uC5B4. \uADF8\uAC78 \uB118\uB294\uB2E4\uBA74 \uB098\uB294 \uAC00\uB9CC\uC788\uC9C0
        \uC54A\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uADF8\uB7F0 \uB9D0 \uB4E4\uC73C\uBA74 \uB354 \uBBF8\uC548\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uBBF8\uC548\uD574\uD560 \uD544\uC694 \uC5C6\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uADF8\uB7EC\uB2C8\uAE4C \uB354 \uADF8\uB798. \uB098\uB294 \uC544\uBB34\uAC83\uB3C4
        \uC548 \uD558\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C020
    ComboKey: '#5|#7'
    ParticipantIds: 0500000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #5|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 5
      Text: "\uC9C8\uBB38\uC774 \uB9CE\uC740 \uC0AC\uB78C\uC77C\uC218\uB85D \uB2E4\uB8E8\uAE30
        \uC5B4\uB835\uC9C0. \uADF8\uB798\uC11C \uB354 \uC624\uB798 \uB208\uC774 \uAC00."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB108\uB3C4 \uBBFF\uC9C0 \uC54A\uB294\uAD70. \uC774 \uC5EC\uC815\uC774
        \uBAA8\uB450\uB97C \uAD6C\uD55C\uB2E4\uB294 \uB9D0\uC744."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uD1A0\uB2C8, \uB124 \uB9D0\uC740 \uC774\uC0C1\uD558\uAC8C \uC624\uB798
        \uB0A8\uC544. \uB4E3\uACE0 \uB098\uBA74 \uACF5\uAE30\uAC00 \uB2EC\uB77C\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uBBFF\uACE0 \uC548 \uBBFF\uACE0\uB97C \uC0DD\uAC01\uD558\uB294 \uAC83\uB3C4
        \uD53C\uACE4\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uADF8\uAC8C \uB124 \uBC29\uC2DD\uC774\uC57C?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uBAB0\uB77C. \uADF8\uB0E5 \uC624\uB298\uB9CC \uB118\uAE30\uACE0 \uC2F6\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C021
    ComboKey: '#6|#7'
    ParticipantIds: 0600000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #6|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 6
      Text: "\uC0C8\uD134, \uB124 \uC758\uC2EC\uC774 \uD544\uC694\uD55C \uAC74 \uC548\uB2E4.
        \uADF8\uB798\uB3C4 \uB204\uAD70\uAC00\uB294 \uBA3C\uC800 \uBAB8\uC744 \uC138\uC6CC\uC57C
        \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uD504\uB9AC\uB4DC \uC624\uBE60\uB294 \uB9E8\uB0A0 \uB300\uC2E0 \uB4E4\uC5B4\uC8FC\uB124.
        \uBB34\uAC70\uC6B4 \uAC83\uB3C4, \uC5B4\uB824\uC6B4 \uAC83\uB3C4!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uD76C\uC0DD\uC744 \uB108\uBB34 \uC27D\uAC8C \uC88B\uC740 \uB9D0\uB85C
        \uD3EC\uC7A5\uD558\uC9C4 \uB9C8. \uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC5D0\uAC90
        \uB298 \uB2E4\uB978 \uBB34\uAC8C\uB85C \uB0A8\uC73C\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB124\uAC00 \uB2E4\uCE58\uC9C0 \uC54A\uC73C\uBA74 \uADF8\uAC78\uB85C
        \uB410\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uADF8\uB7EC\uB2E4 \uD504\uB9AC\uB4DC \uC624\uBE60\uAC00 \uB0A9\uC791\uD574\uC9C0\uBA74
        \uC5B4\uB5A1\uD574?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uADF8 \uC815\uB3C4\uB85C\uB294 \uBB34\uB108\uC9C0\uC9C0 \uC54A\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC751, \uADF8\uB798\uC11C \uB354 \uC2E0\uAE30\uD574!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
