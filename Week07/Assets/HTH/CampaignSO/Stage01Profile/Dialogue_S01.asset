      Text: "\uD754\uB4E4\uB9AC\uB294 \uAC74 \uC774\uD574\uD55C\uB2E4. \uADF8\uB798\uB3C4
        \uC5EC\uAE30\uC11C \uBC1C\uC744 \uBA48\uCD9C \uC21C \uC5C6\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uC5EC\uB7EC\uBD84\uC758 \uC0AC\uBA85\uC774 \uBB34\uC5C7\uC774\uB4E0,
        \uB8E8\uC774\uC2A4\uB97C \uD574\uCE58\uB294 \uC120\uD0DD\uC5D0\uB294 \uB3D9\uC758\uD560
        \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uC774 \uB9CE\uC740 \uB9C8\uC74C\uC774 \uD55C\uACF3\uC73C\uB85C \uAC08
        \uB9AC \uC5C6\uC796\uC544. \uADF8\uB7EC\uB2C8 \uB354 \uD53C\uACE4\uD55C \uAC70\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC774\uC57C, \uD55C\uC790\uB9AC\uC5D0 \uC774\uB807\uAC8C \uB9CE\uC740
        \uACB0\uD54D\uC774 \uBAA8\uC774\uB2C8 \uD5A5\uC774 \uC815\uB9D0 \uC9C4\uD558\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uAC01\uC790\uC758 \uC774\uC720\uAC00 \uB2E4\uB974\uB354\uB77C\uB3C4,
        \uBB34\uB108\uC9C0\uB294 \uC21C\uAC04\uB9CC\uD07C\uC740 \uB0B4\uAC00 \uB9C9\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C114
    ComboKey: '#1|#2|#3|#4|#5|#7'
    ParticipantIds: 010000000200000003000000040000000500000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#2|#3|#4|#5|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB2E4\uB4E4 \uAC19\uC740 \uAE38\uC744 \uBCF4\uB294 \uCC99\uD558\uC9C0\uB9CC,
        \uC2DC\uC120\uC774 \uD5A5\uD55C \uB05D\uC740 \uC804\uBD80 \uB2E4\uB974\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC758\uC2EC\uB3C4 \uB450\uB824\uC6C0\uB3C4 \uB098\uC911\uC774\uB2E4.
        \uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC558\uACE0, \uB098\uB294 \uB05D\uC744
        \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB05D\uC744 \uB17C\uD558\uAE30 \uC804\uC5D0, \uB204\uAC00 \uBA3C\uC800
        \uC0C1\uCC98 \uC785\uB294\uC9C0\uBD80\uD130 \uBCF4\uC544\uC57C \uD558\uC9C0
        \uC54A\uACA0\uC2B5\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uC774\uB807\uAC8C \uB2E4 \uBAA8\uC5EC\uC11C \uAC19\uC740 \uB05D\uC744
        \uBCF8\uB2E4\uB294 \uB9D0, \uC194\uC9C1\uD788 \uB09C \uC544\uC9C1\uB3C4 \uC798
        \uBAA8\uB974\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uB2E4\uB4E4 \uC785\uC73C\uB85C\uB294 \uACB0\uB9D0\uC744 \uB9D0\uD558\uC9C0\uB9CC,
        \uC18D\uC5D0\uC120 \uC804\uBD80 \uB2E4\uB978 \uD5C8\uAE30\uB97C \uD0A4\uC6B0\uACE0
        \uC788\uAD70."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB2E4\uB4E4 \uC790\uAE30 \uC774\uC720\uB294 \uBD84\uBA85\uD574. \uBB38\uC81C\uB294
        \uADF8\uB7F0 \uC774\uC720\uAC00 \uB298 \uB204\uAD70\uAC00\uB97C \uBC00\uC5B4\uB0B8\uB2E4\uB294
        \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C115
    ComboKey: '#1|#2|#3|#4|#6|#7'
    ParticipantIds: 010000000200000003000000040000000600000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#2|#3|#4|#6|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uC774\uB807\uAC8C \uBAA8\uC774\uBA74 \uB204\uAC00 \uBB34\uB108\uC9C8\uC9C0\uBCF4\uB2E4,
        \uB204\uAC00 \uB05D\uAE4C\uC9C0 \uC228\uAE38\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uB204\uAC00 \uC5B4\uB5A4 \uB9C8\uC74C\uC73C\uB85C \uC11C \uC788\uB4E0
        \uC0C1\uAD00\uC5C6\uC5B4. \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uAC00\uB294 \uAC83\uB9CC\uC740
        \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uBAA8\uB450\uC758 \uB73B\uC774 \uB2E4\uB974\uB2E4\uB294 \uAC74 \uC555\uB2C8\uB2E4.
        \uD558\uC9C0\uB9CC \uB8E8\uC774\uC2A4\uB9CC\uC740 \uC774 \uC18C\uB780\uC5D0\uC11C
        \uBE7C \uB450\uACE0 \uC2F6\uAD70\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB2E4\uB4E4 \uB108\uBB34 \uB9CE\uC740 \uAC78 \uC9CA\uC5B4\uC9C0\uACE0
        \uC788\uB124. \uB09C \uADF8\uB0E5 \uC870\uC6A9\uD788 \uB05D\uB0AC\uC73C\uBA74
        \uC88B\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uACB0\uC815\uC774 \uD544\uC694\uD558\uB2E4\uBA74 \uB0B4\uAC00 \uAC10\uB2F9\uD558\uACA0\uB2E4.
        \uB2E4\uB9CC \uB05D\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC544 \uB2EC\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uC88B\uC544, \uB2E4\uB4E4 \uB9D0\uC740 \uBA4B\uC9C0\uB124. \uADF8\uB798\uC11C
        \uADF8 \uBA4B\uC9C4 \uACB0\uB9D0 \uC544\uB798 \uB204\uAC00 \uBA3C\uC800 \uAE54\uB9AC\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C116
    ComboKey: '#1|#2|#3|#5|#6|#7'
    ParticipantIds: 010000000200000003000000050000000600000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#2|#3|#5|#6|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uD55C\uC790\uB9AC\uC5D0 \uC774\uB807\uAC8C \uB2E4\uB978 \uACB0\uD54D\uC774
        \uBAA8\uC600\uB294\uB370\uB3C4 \uC544\uC9C1 \uD568\uAED8 \uC11C \uC788\uB2E4\uB294
        \uAC8C \uB354 \uC2E0\uAE30\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uAC01\uC790\uC758 \uC0DD\uAC01\uC774 \uB2E4\uB974\uB354\uB77C\uB3C4,
        \uC9C0\uAE08\uC740 \uAC19\uC740 \uBC29\uD5A5\uC744 \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB300\uC758\uC640 \uACB0\uB9D0\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4\uB9CC,
        \uC81C\uAC8C \uAC00\uC7A5 \uC911\uC694\uD55C \uAC74 \uADF8 \uC0AC\uB78C\uC758
        \uBB34\uC0AC\uC785\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC774\uC0C1\uD560 \uB9CC\uD07C \uC5EC\uB7EC \uAE30\uB958\uAC00 \uD55C\uC790\uB9AC\uC5D0
        \uBAA8\uC600\uB124. \uADF8\uB798\uC11C \uB354 \uD765\uBBF8\uB85C\uC6CC."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uD754\uB4E4\uB824\uB3C4 \uC88B\uB2E4. \uB204\uAD70\uAC00\uB294 \uB05D\uAE4C\uC9C0
        \uBC84\uD2F0\uACE0 \uBAA8\uB450\uB97C \uC138\uC6CC\uC57C \uD558\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uD070 \uB9D0\uB4E4\uC740 \uB298 \uADF8\uB7F4\uB4EF\uD558\uC9C0. \uADFC\uB370
        \uADF8 \uB9D0\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uBC00\uB824\uB098\uB294 \uCABD\uC740
        \uB204\uAC00 \uBCF4\uB098?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
