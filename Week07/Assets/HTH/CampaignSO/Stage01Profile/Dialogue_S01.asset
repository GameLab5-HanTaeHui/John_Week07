      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uBAA8\uB450\uB97C \uAD6C\uD560 \uC218 \uC5C6\uB2E4 \uD574\uB3C4, \uADF8\uB798\uC11C
