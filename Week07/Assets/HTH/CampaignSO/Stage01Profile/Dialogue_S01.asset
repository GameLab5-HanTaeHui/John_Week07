    Visibility: 
    FragmentId: P03_01
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 3
      Text: "\uC5EC\uC2E0\uB2D8, \uB8E8\uC774\uC2A4\uB97C \uD5A5\uD55C \uC774 \uB9C8\uC74C\uC740
        \uACB0\uCF54 \uC695\uB9DD\uC774 \uC544\uB2D9\uB2C8\uB2E4. \uADF8\uC800 \uBD88\uC30D\uD55C
        \uC790\uB97C \uAC00\uC5FE\uAC8C \uC5EC\uAE30\uB294 \uD5CC\uC2E0\uC77C \uBFD0\uC785\uB2C8\uB2E4. 
