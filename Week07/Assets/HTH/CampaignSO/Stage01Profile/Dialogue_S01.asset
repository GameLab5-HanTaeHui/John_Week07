    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #3|#5|#6"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 3
      Text: "\uB204\uAD70\uAC00\uB97C \uBA3C\uC800 \uBC00\uC5B4 \uB123\uB294 \uBC29\uC2DD\uC758
        \uC9C8\uC11C\uB294 \uC624\uB798 \uBC84\uD2F0\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC22D\uACE0\uD55C \uB9D0\uC740 \uBD84\uC704\uAE30\uB97C \uCC38 \uBE60\uB974\uAC8C
        \uBC14\uAFD4 \uB193\uC9C0. \uC0AC\uB78C\uB4E4 \uD45C\uC815\uAE4C\uC9C0 \uB2EC\uB77C\uC9C0\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uC0AC\uB78C\uC744 \uB3C4\uB9C8 \uC704\uC5D0 \uC62C\uB824\uB193\uB294
        \uC2DC\uC120, \uADF8\uAC74 \uC5EC\uAE30\uC11C \uB05D\uC774\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C051
    ComboKey: '#3|#5|#7'
