  - ComboId: COND_P01_01
    ComboKey: '#1'
    ParticipantIds: 01000000
    SituationType: "\uD504\uB85C\uD30C\uC77C \uD575\uC2EC\uBB38\uC7A5"
    Trigger: "\uC5D4\uBE44(#1)\uAC00 \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0
      \uD63C\uC790 \uC788\uACE0, \uBAA8\uB4E0 \uAD6C\uC5ED\uC5D0\uC11C \uC0AC\uB9DD
      \uC0AC\uAC74\uC774 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC744 \uC2DC"
    Visibility: 
    FragmentId: P01_01
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB2E4\uB4E4 \uC544\uBB34\uB807\uC9C0 \uC54A\uAC8C \uC6C3\uACE0 \uC788\uB124.
        \uC800 \uC628\uAE30\uAC00 \uC5BC\uB9C8\uB098 \uD2B9\uBCC4\uD55C\uC9C0 \uBAA8\uB97C
        \uAC70\uC57C. \uB098\uB294 \uD55C \uBC88\uB3C4 \uACBD\uD5D8\uD558\uC9C0 \uBABB\uD588\uB358
        \uC628\uAE30\uB97C..."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "...\uB098\uC5D0\uAC8C\uB3C4 \uBD80\uBAA8\uB2D8\uC774 \uC788\uC5C8\uB354\uB77C\uBA74
        \uC800\uB807\uAC8C \uB530\uB73B\uD558\uAC8C \uC6C3\uC744 \uC218 \uC788\uC5C8\uC744\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: COND_P01_02
    ComboKey: '#1|#5'
    ParticipantIds: 0100000005000000
    SituationType: "\uD504\uB85C\uD30C\uC77C \uD575\uC2EC\uBB38\uC7A5"
    Trigger: "\uC5D4\uBE44(#1)\uC640 \uD1A0\uB2C8(#5), 2\uBA85\uB9CC \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD568\uAED8 \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815
      \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC558\uC744
      \uC2DC"
    Visibility: 
    FragmentId: P01_02
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uACE0\uB9C8\uC6CC \uD1A0\uB2C8. \uD1A0\uB2C8\uB3C4 \uC6C3\uC74C\uC774
        \uCC38 \uB530\uB73B\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uADF8\uB807\uAC8C \uC6C3\uB294\uAC70, \uB9C8\uC655\uC774 \uC9C1\uC811
        \uAC00\uB974\uCE5C\uAC70\uC9C0? \uD1A0\uB2C8\uB294 \uB9C8\uC655\uC131\uC5D0\uC11C
        \uC77C\uD588\uC5C8\uC5B4. \uC2A4\uD30C\uC774\uB97C \uC5B4\uB5BB\uAC8C \uAC00\uB974\uCE58\uB294\uC9C0
        \uB2E4 \uC54C\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uBB34\uC2A8 \uC18C\uB9AC\uB97C \uD558\uB294\uAC70\uC57C \uD1A0\uB2C8?
        \uC7A5\uB09C\uC774 \uC9C0\uB098\uCCD0. \uB9C8\uC655\uC744 \uD1A0\uBC8C\uD558\uAE30
        \uC704\uD574 \uC9C0\uAE08\uAE4C\uC9C0 \uB3D9\uB8CC\uB4E4\uACFC \uD568\uAED8
        \uD574 \uC628\uAC70\uC796\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC544\uD558 \uADF8\uB7F0 \uCEE8\uC149? \uC54C\uACA0\uC5B4~ \uAC71\uC815\uD558\uC9C0
        \uB9C8! \uC544\uBB34\uD55C\uD14C\uB3C4 \uC598\uAE30 \uC548 \uD574!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: COND_P01_03
    ComboKey: '#1|#3|#4'
    ParticipantIds: 010000000300000004000000
    SituationType: "\uD504\uB85C\uD30C\uC77C \uD575\uC2EC\uBB38\uC7A5"
    Trigger: "\uC5D4\uBE44(#1),\uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4), 3\uBA85\uB9CC
      \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD568\uAED8 \uC788\uACE0, \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0
      \uC54A\uC558\uC744 \uC2DC"
    Visibility: 
    FragmentId: P01_03
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB8E8\uC774\uC2A4, \uB370\uC6B0\uC2A4\uC640 \uC5B8\uC81C \uADF8\uB807\uAC8C
        \uCE5C\uD574\uC9C4\uAC70\uC57C? \uC608\uC804\uC5D4 \uC548\uADF8\uB7AC\uB358
        \uAC83 \uAC19\uC740\uB370 \uC774\uC81C\uB294 \uD56D\uC0C1 \uAC19\uC774 \uC788\uB124?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uC800\uB294 \uC5EC\uC2E0\uB2D8\uC758 \uC774\uB984\uC73C\uB85C \uB8E8\uC774\uC2A4\uB97C
        \uCE58\uB8CC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uD658\uC790\uB97C \uB3CC\uBCF4\uAE30
        \uC704\uD574 \uAC00\uAE4C\uC774 \uC788\uB294 \uAC74 \uB2F9\uC5F0\uD55C \uC77C\uC785\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB9DE\uC544. \uB370\uC6B0\uC2A4\uB294 \uB098\uB97C \uBC24\uB0AE\uC73C\uB85C
        \uCE58\uB8CC\uD574 \uC8FC\uACE0 \uC788\uC5B4. \uC740\uD61C\uB97C \uC5B4\uB5BB\uAC8C
        \uAC1A\uC744\uC9C0 \uBAA8\uB974\uACA0\uC744 \uC815\uB3C4\uB85C..."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uADF8\uB807\uAD6C\uB098. \uB8E8\uC774\uC2A4, \uADF8\uB7FC \uC7A0\uAE50
        \uC0B0\uCC45\uC774\uB77C\uB3C4 \uAC08\uB798? \uAC00\uB054\uC740 \uBC14\uAE65
        \uACF5\uAE30\uB3C4 \uC42C\uBA74 \uD68C\uBCF5\uC5D0 \uB354 \uC88B\uC744\uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uC704\uD5D8\uD560 \uC218\uB3C4 \uC788\uC73C\uB2C8 \uC81C\uAC00 \uB8E8\uC774\uC2A4\uC640
        \uB2E4\uB140\uC624\uACA0\uC2B5\uB2C8\uB2E4. \uB8E8\uC774\uC2A4, \uAC00\uC2DC\uC8E0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uC74C... \uADF8\uB798. \uB2E4\uC74C\uC5D0 \uBD10, \uC5D4\uBE44."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uC5B4.. \uADF8\uB798, \uC798 \uB2E4\uB140\uC640."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: COND_P01_04
    ComboKey: '#1|#2|#7'
    ParticipantIds: 010000000200000007000000
    SituationType: "\uD504\uB85C\uD30C\uC77C \uD575\uC2EC\uBB38\uC7A5"
    Trigger: "P07_02 \uB610\uB294 P07_03\uC744 \uD68D\uB4DD \uD55C \uC0C1\uD0DC\uC5D0\uC11C
      \uC5D4\uBE44(#1),\uBA54\uC774(#2),\uC0C8\uD134(#7), 3\uBA85\uB9CC \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uC788\uC744 \uC2DC "
    Visibility: 
    FragmentId: P01_04
    TriggerDeadIds: 
    UnlockConditionId: "P07_02 \uB610\uB294 P07_03"
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uB9C8\uC655 \uD1A0\uBC8C\uC744 \uBA48\uCD9C \uC218\uB294 \uC5C6\uC5B4.
        \uC5EC\uAE30\uC11C \uBB3C\uB7EC\uC11C\uBA74, \uC9C0\uAE08\uAE4C\uC9C0 \uC783\uC5B4\uC628
        \uAC83\uB4E4\uC774 \uC804\uBD80 \uC544\uBB34 \uC758\uBBF8\uB3C4 \uC5C6\uC5B4\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uADF8 \uB9D0\uC740 \uD56D\uC0C1 \uB0A8\uC740 \uC0AC\uB78C\uB4E4 \uC785\uC5D0\uC11C
        \uB098\uC624\uB354\uB77C. \uC55E\uC73C\uB85C \uAC00\uC57C \uD55C\uB2E4\uB294
        \uB9D0 \uB4A4\uC5D0 \uB204\uAC00 \uB0A8\uB294\uC9C0\uB294 \uC544\uBB34\uB3C4
        \uBB3B\uC9C0 \uC54A\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uBA54\uC774\uC758 \uB9D0\uC774 \uB9DE\uC544. \uC5EC\uAE30\uC11C \uBA48\uCD94\uBA74
        \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC774 \uACE0\uD1B5\uBC1B\uAC8C \uB420\uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "...\uB300\uC758 \uC55E\uC5D0 \uC791\uC740 \uD76C\uC0DD\uC740 \uC5B4\uCA54
        \uC218 \uC5C6\uB2E4\uB294\uAC70\uC9C0?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uC0C8\uD134! \uBA54\uC774\uC758 \uB73B\uC740 \uADF8\uB7F0\uAC8C \uC544\uB2C8\uC796\uC544.
        \uB108\uBB34 \uBE44\uAF2C\uBA74 \uBA54\uC774\uAC00 \uC0C1\uCC98\uBC1B\uC744\uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC544\uB2C8, \uB098\uB294... \uADF8\uAC8C \uC544\uB2C8\uB77C.. \uBA54\uC774,
        \uB0B4 \uB9D0\uC740..."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uB2E4\uC74C\uC5D0 \uC598\uAE30\uD574 \uC0C8\uD134."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
