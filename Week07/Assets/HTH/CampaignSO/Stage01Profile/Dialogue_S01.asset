    ParticipantIds: 0200000006000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #2|#6"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uD504\uB9AC\uB4DC, \uB124\uAC00 \uC9D0\uC744 \uB098\uB204\uB824\uB294
        \uAC74 \uC54C\uC9C0\uB9CC \uB9C8\uC9C0\uB9C9 \uCC45\uC784\uC740 \uB0B4\uAC00
        \uC9C4\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uB8E8\uC774\uC2A4, \uB124 \uD798\uC774 \uD544\uC694\uD558\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB05D\uC744 \uC644\uC218\uD574\uC57C \uD55C\uB2E4\uBA74 \uB0B4\uAC00
        \uBC29\uD328\uAC00 \uB418\uACA0\uB2E4. \uB124\uAC00 \uBB34\uB108\uC9C0\uAC8C
        \uB450\uC9C4 \uC54A\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\u2026\uB0B4 \uD798 \uAC19\uC740 \uAC70 \uC774\uC81C \uBCC4\uB85C \uC548
        \uB0A8\uC558\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uADF8\uB798\uB3C4 \uC11C\uC57C \uD574. \uC544\uC9C1 \uB05D\uB098\uC9C0
        \uC54A\uC558\uC73C\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uADF8 \uB9D0\uC774 \uC81C\uC77C \uD53C\uACE4\uD574. \uC544\uC9C1, \uC544\uC9C1,
        \uC544\uC9C1\u2026"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C011
    ComboKey: '#2|#7'
    ParticipantIds: 0200000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #2|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uC0C8\uD134, \uB124 \uC9C8\uBB38\uC740 \uC774\uD574\uD55C\uB2E4. \uADF8\uB798\uB3C4
        \uB204\uAD70\uAC00\uB294 \uB9DD\uC124\uC784\uBCF4\uB2E4 \uACB0\uB2E8\uC744
        \uD0DD\uD574\uC57C \uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uBA54\uC774 \uC624\uBE60\uB294 \uC774\uC0C1\uD558\uAC8C \uC2DC\uC120\uC744
        \uBAA8\uC73C\uB294 \uC0AC\uB78C\uC774\uC57C. \uC55E\uC5D0 \uC11C\uBA74 \uB2E4\uB4E4
        \uD55C \uBC88\uCBE4 \uBCF4\uAC8C \uB418\uC796\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uBA54\uC774, \uB05D\uC744 \uBCF4\uC790\uB294 \uB9D0 \uB4A4\uC5D4 \uB298
        \uB204\uAC00 \uB0A8\uB294\uC9C0\uBD80\uD130 \uB9D0\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uADF8\uB7F0 \uB9D0\uB85C \uB4E4\uB728\uC9C0 \uC54A\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uADF8\uB798\uB3C4 \uB2E4\uB4E4 \uBA54\uC774 \uC624\uBE60\uAC00 \uB04C\uACE0
        \uAC00\uC57C \uC6C0\uC9C1\uC774\uC796\uC544?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\u2026\uADF8\uAC74 \uB0B4\uAC00 \uD574\uC57C \uD560 \uC77C\uC774\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C012
    ComboKey: '#3|#4'
    ParticipantIds: 0300000004000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #3|#4"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4, \uBB34\uB9AC\uD574\uC11C \uB9D0\uD558\uC9C0 \uC54A\uC544\uB3C4
        \uB429\uB2C8\uB2E4. \uC5EC\uAE30\uC5D4 \uC81C\uAC00 \uC788\uACA0\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uC704\uD5D8\uD55C \uC790\uB9AC\uB77C\uBA74 \uB0B4\uAC00 \uAC00\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB124\uAC00 \uACC1\uC5D0 \uC788\uC73C\uBA74 \uD3B8\uD574. \uADF8\uAC8C
        \uC88B\uC740 \uAC74\uC9C0 \uB098\uC05C \uAC74\uC9C4 \uBAA8\uB974\uACA0\uC9C0\uB9CC."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uB610 \uADF8\uB7F0 \uC2DD\uC73C\uB85C \uB05D\uB0B4\uB824 \uD558\uC9C0
        \uB9C8."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB204\uAD70\uAC00\uB294 \uAC10\uB2F9\uD574\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC774\uC81C\uB294 \uB204\uAD70\uAC00 \uD55C \uC0AC\uB78C\uC5D0\uAC8C\uB9CC
        \uAC12\uC744 \uCE58\uB974\uAC8C \uD558\uBA70 \uB098\uC544\uAC00\uACE0 \uC2F6\uC9C0
        \uC54A\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C013
    ComboKey: '#3|#5'
    ParticipantIds: 0300000005000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #3|#5"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 3
      Text: "\uB2F9\uC2E0\uC758 \uBBF8\uC18C\uC5D0\uB294 \uC9C0\uB098\uCE58\uAC8C
        \uB9CE\uC740 \uC545\uC758\uAC00 \uBC30\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC77C\uB2E8 \uB05D\uAE4C\uC9C0 \uAC00\uC57C \uB2F5\uC774 \uB098\uC628\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC870\uAE08\uB9CC \uB354 \uD754\uB4E4\uB9AC\uBA74 \uB531 \uC88B\uACA0\uB124.
        \uC544\uC9C1\uC740 \uD5A5\uC774 \uB35C \uC62C\uB790\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB05D\uAE4C\uC9C0 \uAC00\uB294 \uB3D9\uC548 \uB204\uAC00 \uB5A8\uC5B4\uC9C0\uB294\uC9C0\uB294
        \uC548 \uBCF4\uC774\uC9C0?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uADF8\uB807\uAC8C \uBA48\uCDB0 \uC11C\uC11C \uBAA8\uB450\uB97C \uAD6C\uD560
        \uC218 \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD574?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uC544\uB2C8. \uC801\uC5B4\uB3C4 \uB5A0\uBC00\uC5B4 \uB193\uACE0 \uC88B\uC740
        \uC774\uB984\uC744 \uBD99\uC774\uC9C4 \uB9D0\uC544\uC57C\uC9C0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C014
    ComboKey: '#3|#6'
    ParticipantIds: 0300000006000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #3|#6"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 3
      Text: "\uB204\uAD70\uAC00\uB97C \uBA3C\uC800 \uBC00\uC5B4 \uB123\uB294 \uBC29\uC2DD\uC758
        \uC9C8\uC11C\uB294 \uC624\uB798 \uBC84\uD2F0\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uADF8\uB0E5\u2026 \uB458\uB9CC \uC788\uC73C\uBA74 \uC548 \uB3FC?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uCC45\uC784\uC740 \uB098\uB20C \uC218 \uC788\uC5B4\uB3C4, \uCE7C\uB0A0\uC740
        \uBA3C\uC800 \uB0B4\uAC00 \uBC1B\uB294 \uD3B8\uC774 \uB0AB\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uAC00\uB2A5\uD558\uB2E4\uBA74 \uADF8\uB807\uAC8C \uB9CC\uB4E4\uACE0
        \uC2F6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB2E4\uB4E4 \uD654\uB0B4\uACA0\uC9C0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uADF8\uB4E4\uC774 \uBB34\uC5C7\uC744 \uB9D0\uD558\uB4E0, \uB2F9\uC2E0\uC774
        \uBB34\uB108\uC9C0\uB294 \uAC83\uBCF4\uB2E4 \uC911\uC694\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C015
    ComboKey: '#3|#7'
    ParticipantIds: 0300000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #3|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 3
      Text: "\uC0C8\uD134, \uC758\uC2EC\uC774 \uD544\uC694\uD558\uB2E4\uB294 \uAC74
        \uC555\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uBAA8\uB4E0 \uAC83\uC744 \uBD88\uC2E0\uB9CC\uC73C\uB85C
        \uBC84\uD2F8 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uB370\uC6B0\uC2A4 \uC5B8\uB2C8\uB294 \uB9E8\uB0A0 \uB8E8\uC774\uC2A4
        \uC624\uBE60\uB9CC \uBD10. \uAE38 \uC783\uC5B4\uBC84\uB9AC\uBA74 \uC5B4\uB5A1\uD574?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB09C \uD070 \uB9D0\uBCF4\uB2E4, \uADF8 \uACFC\uC815\uC5D0\uC11C \uB193\uCE58\uB294
        \uAC8C \uC5C6\uB294\uC9C0\uBD80\uD130 \uBCF4\uB294 \uD3B8\uC774\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uAE38\uC744 \uC783\uC740 \uC801 \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uADF8\uB798? \uD55C\uCABD\uB9CC \uBCF4\uBA74 \uB2E4\uB978 \uCABD\uC740
        \uC798 \uC548 \uBCF4\uC774\uB358\uB370!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\u2026\uBB34\uC2A8 \uB73B\uC785\uB2C8\uAE4C?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC544\uBB34 \uB73B \uC5C6\uC5B4! \uADF8\uB0E5 \uD1A0\uB2C8 \uC0DD\uAC01!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C016
    ComboKey: '#4|#5'
    ParticipantIds: 0400000005000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #4|#5"
    Visibility: 
