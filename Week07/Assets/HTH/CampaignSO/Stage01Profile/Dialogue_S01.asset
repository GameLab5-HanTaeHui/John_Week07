  - ComboId: COND_P05_03
    ComboKey: '#3|#5|#7'
    ParticipantIds: 030000000500000007000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751 / \uC0B4\uC778\uC790"
    Trigger: "P03_04\uC744 \uD68D\uB4DD\uD55C \uC0C1\uD0DC\uC5D0\uC11C, \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uB370\uC6B0\uC2A4(#3), \uD1A0\uB2C8(#5), \uC0C8\uD134(#7)
      3\uBA85\uB9CC \uC874\uC7AC\uD558\uACE0, \uD134 \uC885\uB8CC \uCC98\uB9AC \uACB0\uACFC
      \uD1A0\uB2C8(#5)\uC758 \uC0B4\uC778\uC790 \uD6A8\uACFC\uB85C \uB370\uC6B0\uC2A4(#3)\uAC00
      \uC0AC\uB9DD\uD560 \uC2DC \uD68D\uB4DD."
    Visibility: 
    FragmentId: P05_03
    TriggerDeadIds: 03000000
    UnlockConditionId: P03_04
    HintOfConditionId: 
    Lines:
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4\uB97C \uC9C0\uD0A4\uB294 \uAC8C \uC800\uC758 \uD5CC\uC2E0\uC774\uC785\uB2C8\uB2E4.
        \uB204\uAC00 \uBB50\uB77C\uACE0 \uD574\uB3C4 \uB8E8\uC774\uC2A4 \uACC1\uC5D0\uB294
        \uC81C\uAC00 \uB0A8\uC544\uC788\uC744 \uAC81\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB370\uC6B0\uC2A4, \uB108\uB294 \uB8E8\uC774\uC2A4\uB97C \uACFC\uBCF4\uD638
        \uD558\uACE0 \uC788\uC5B4. \uC774\uAC74 \uCE58\uB8CC\uB3C4 \uD5CC\uC2E0\uB3C4
        \uC544\uB0D0. \uB8E8\uC774\uC2A4\uB294 \uB354\uC774\uC0C1 \uD63C\uC790 \uC544\uBB34\uAC83\uB3C4
        \uD558\uB824\uACE0 \uD558\uC9C0 \uC54A\uC544. \uB9C8\uC9C0\uB9C9 \uACBD\uACE0\uC57C.
        \uB8E8\uC774\uC2A4\uC758 \uCE58\uB8CC\uB97C \uBA48\uCD94\uACE0 \uACC1\uC5D0\uC11C
        \uB5A0\uB098\uC918."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uC81C\uAC00 \uACFC\uBCF4\uD638\uB77C\uACE0\uC694? \uB5A0\uB098\uB77C\uACE0\uC694?
        \uC0C8\uD134\uC774 \uBB58 \uC54C\uC544\uC694? \uB8E8\uC774\uC2A4\uAC00 \uC5BC\uB9C8\uB098
        \uC9C0\uCCD0\uC788\uB294\uC9C0 \uC54C\uAE30\uB098 \uD574\uC694? \uC81C\uAC00
        \uB8E8\uC774\uC2A4\uB97C \uB3CC\uBCF4\uB294 \uAC74 \uACE0\uACB0\uD55C \uD5CC\uC2E0\uC774\uC5D0\uC694!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB370\uC6B0\uC2A4, \uB108\uB294 \uB108 \uC790\uC2E0\uC744 \uC18D\uC774\uACE0
        \uC788\uC5B4. \uADF8\uAC74 \uD5CC\uC2E0\uC774 \uC544\uB2C8\uC57C. \uB8E8\uC774\uC2A4\uB97C
        \uC0AC\uB791\uD558\uB294 \uB9C8\uC74C\uC774 \uB4A4\uD2C0\uB9B0\uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uC0AC\uB791..? \uC81C\uAC00 \uB8E8\uC774\uC2A4\uB97C \uC0AC\uB791\uD55C\uB2E4\uACE0\uC694..?
        \uC800\uB294.. \uC5EC\uC2E0\uB2D8\uAED8 \uBAA8\uB4E0 \uAC83\uC744 \uBC14\uCCE4\uB294\uB370..
        \uC81C\uAC00 \uB2E4\uB978 \uC0AC\uB78C\uC744 \uC0AC\uB791\uD55C\uB2E4\uB2C8..
        \uADF8\uB7F4\uB9AC\uAC00... \uC5C6\uB294\uB370..."
