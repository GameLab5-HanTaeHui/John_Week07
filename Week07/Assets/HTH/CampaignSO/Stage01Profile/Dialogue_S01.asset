      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB610 \uB204\uAC00 \uB0A8\uB294\uC9C0\uBD80\uD130 \uC815\uD558\uB294
        \uAC70\uC57C?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC544\uB2C8. \uC544\uBB34\uB3C4 \uB0A8\uAE30\uC9C0 \uC54A\uC544. \uB300\uC2E0
        \uC8FD\uACA0\uB2E4\uB294 \uB9D0\uB3C4 \uBA48\uCD94\uC790\uB294 \uB9D0\uB3C4
        \uD544\uC694 \uC5C6\uC5B4. \uB05D\uAE4C\uC9C0 \uD568\uAED8 \uAC00.  \uADF8\uB798\uC57C
        \uC6B0\uB9AC\uAC00 \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uC774\uC720\uAC00 \uC0AC\uB77C\uC9C0\uC9C0
