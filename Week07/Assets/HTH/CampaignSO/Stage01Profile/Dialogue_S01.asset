    Lines:
    - SpeakerId: 2
      Text: "\uB204\uAD70\uAC00\uC758 \uBD88\uD589\uC744 \uC6C3\uC73C\uBA70 \uB118\uAE30\uB294
        \uC0AC\uB78C\uC740, \uB09C \uC624\uB798 \uB450\uC9C0 \uC54A\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uD06C\uAC8C \uBE5B\uB098\uB294 \uB9D0\uC77C\uC218\uB85D \uC8FC\uBCC0
        \uACF5\uAE30\uAE4C\uC9C0 \uBE60\uB974\uAC8C \uB2EC\uC544\uC624\uB974\uB354\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB108\uBB34 \uD070 \uC774\uB984\uC744 \uC9CA\uC5B4\uC9C0\uB824 \uD558\uC9C0
        \uB9C8\uB77C. \uB05D\uAE4C\uC9C0 \uBC84\uD2F0\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4
        \uCDA9\uBD84\uD558\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uBA54\uC774, \uB05D\uC744 \uBCF4\uC790\uB294 \uB9D0 \uB4A4\uC5D4 \uB298
        \uB204\uAC00 \uB0A8\uB294\uC9C0\uBD80\uD130 \uB9D0\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_2_5_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 03000000040000000500000006000000
    Lines:
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4, \uBB34\uB9AC\uD574\uC11C \uB9D0\uD558\uC9C0 \uC54A\uC544\uB3C4
        \uB429\uB2C8\uB2E4. \uC5EC\uAE30\uC5D4 \uC81C\uAC00 \uC788\uACA0\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB124\uAC00 \uACC1\uC5D0 \uC788\uC73C\uBA74 \uD3B8\uD574. \uADF8\uAC8C
        \uC88B\uC740 \uAC74\uC9C0 \uB098\uC05C \uAC74\uC9C4 \uBAA8\uB974\uACA0\uC9C0\uB9CC."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC11C\uB85C\uB9CC \uBC14\uB77C\uBCF4\uB294 \uC0AC\uB78C\uB4E4\uC740
        \uBB34\uB108\uC9C8 \uB54C \uC18C\uB9AC\uAC00 \uB354 \uC88B\uB354\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB450 \uC0AC\uB78C\uC740 \uB4A4\uB97C \uC9C0\uCF1C\uB77C. \uC804\uBA74\uC758
        \uBB34\uAC8C\uB294 \uB0B4\uAC00 \uBC1B\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_3_4_5_6_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 03000000040000000500000007000000
    Lines:
    - SpeakerId: 3
      Text: "\uB2F9\uC2E0\uC774 \uBC84\uD2F8 \uD798\uC774 \uC5C6\uB2E4\uBA74, \uC81C\uAC00
        \uB300\uC2E0 \uBC84\uD2F0\uACA0\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB2E4 \uAD1C\uCC2E\uC9C0 \uC54A\uC740\uB370, \uB124\uAC00 \uAD1C\uCC2E\uB2E4\uACE0
        \uB9D0\uD558\uBA74 \uC7A0\uAE50\uC740 \uBBFF\uAC8C \uB3FC."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC11C\uB85C\uB9CC \uBCF4\uB294 \uC0AC\uB78C\uB4E4\uC740 \uBD84\uC704\uAE30\uB97C
        \uBE60\uB974\uAC8C \uBC14\uAFB8\uC9C0. \uAC00\uAE4C\uC6B4 \uB9CC\uD07C \uD754\uB4E4\uB9BC\uB3C4
        \uCEE4 \uBCF4\uC5EC."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uC11C\uB85C\uB97C \uBD99\uB4DC\uB294 \uC190\uC774 \uAC15\uD560\uC218\uB85D,
        \uB193\uCCD0 \uBC84\uB9AC\uB294 \uBC14\uAE65\uB3C4 \uCEE4\uC9C0\uB294 \uBC95\uC774\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_3_4_5_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 03000000040000000600000007000000
    Lines:
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4\uB9CC \uBB34\uC0AC\uD558\uB2E4\uBA74, \uC800\uB294
        \uB2E4\uB978 \uC2DC\uC120\uC744 \uC5BC\uB9C8\uB4E0\uC9C0 \uAC10\uB2F9\uD560
        \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB370\uC6B0\uC2A4, \uADF8\uB807\uAC8C\uAE4C\uC9C0 \uC560\uC4F0\uC9C0
        \uC54A\uC544\uB3C4 \uB3FC. \uADF8\uB7F0\uB370\uB3C4 \uB124\uAC00 \uC788\uC73C\uBA74
        \uC870\uAE08 \uB35C \uBB34\uB108\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB124 \uC9C8\uBB38\uC774 \uC633\uB2E4 \uD574\uB3C4, \uC544\uBB34\uB3C4
        \uB9C9\uC544\uC11C\uC9C0 \uC54A\uC73C\uBA74 \uB354 \uB9CE\uC740 \uC0AC\uB78C\uC774
        \uC4F0\uB7EC\uC9C4\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uD504\uB9AC\uB4DC, \uB124\uAC00 \uBA3C\uC800 \uB098\uC11C\uACA0\uB2E4\uB294
        \uB9D0\uB3C4 \uACB0\uAD6D\uC740 \uB124 \uCABD\uC73C\uB85C \uBB34\uAC8C\uB97C
        \uB04C\uC5B4\uC624\uB294 \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_3_4_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 03000000050000000600000007000000
    Lines:
    - SpeakerId: 3
      Text: "\uD504\uB9AC\uB4DC, \uBA3C\uC800 \uB098\uC11C\uB294 \uB9C8\uC74C\uC774
        \uB298 \uAC00\uC7A5 \uC88B\uC740 \uB2F5\uC774 \uB418\uB294 \uAC74 \uC544\uB2D9\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC790\uAE30 \uBAB8\uC73C\uB85C \uB9C9\uC544\uC11C\uB294 \uC0AC\uB78C\uC740
        \uD5A5\uC774 \uC624\uB798 \uB0A8\uC9C0. \uB108\uBB34 \uC624\uB798 \uB0A8\uC544\uC11C
        \uBB38\uC81C\uC9C0\uB9CC."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uC0C8\uD134, \uB124 \uC758\uC2EC\uC774 \uD544\uC694\uD55C \uAC74 \uC548\uB2E4.
        \uADF8\uB798\uB3C4 \uB204\uAD70\uAC00\uB294 \uBA3C\uC800 \uBAB8\uC744 \uC138\uC6CC\uC57C
        \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uD76C\uC0DD\uC744 \uB108\uBB34 \uC27D\uAC8C \uC88B\uC740 \uB9D0\uB85C
        \uD3EC\uC7A5\uD558\uC9C4 \uB9C8. \uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC5D0\uAC90
        \uB298 \uB2E4\uB978 \uBB34\uAC8C\uB85C \uB0A8\uC73C\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_3_5_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 04000000050000000600000007000000
    Lines:
    - SpeakerId: 4
      Text: "\uB124 \uC9C8\uBB38\uC740 \uD53C\uACE4\uD55C\uB370, \uADF8\uB798\uC11C
        \uB354 \uD53C\uD560 \uC218\uAC00 \uC5C6\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uD504\uB9AC\uB4DC \uAC19\uC740 \uC0AC\uB78C\uC740 \uB4DC\uBB3C\uC9C0.
        \uC2A4\uC2A4\uB85C \uBA3C\uC800 \uB098\uC11C\uB824\uB294 \uC0AC\uB78C\uC740
        \uC5B4\uB514\uC11C\uB098 \uB208\uC5D0 \uB744\uAC70\uB4E0."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB204\uAC00 \uB0A8\uACA8\uC9C8\uC9C0\uB97C \uBB3B\uB294\uB2E4\uBA74,
        \uC6B0\uC120 \uB0B4\uAC00 \uC55E\uC5D0 \uC11C\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB124\uAC00 \uBA3C\uC800 \uC81C\uB2E8\uC5D0 \uC624\uB974\uB294 \uC21C\uAC04,
        \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC740 \uAC70\uC808\uD560 \uAE30\uD68C\uC870\uCC28
        \uC783\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_4_5_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000002000000030000000400000005000000
    Lines:
    - SpeakerId: 1
      Text: "\uC774\uB807\uAC8C \uBAA8\uC774\uBA74 \uB204\uAC00 \uBB34\uB108\uC9C8\uC9C0\uBCF4\uB2E4,
        \uB204\uAC00 \uB05D\uAE4C\uC9C0 \uC228\uAE38\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uB204\uAC00 \uC5B4\uB5A4 \uB9C8\uC74C\uC73C\uB85C \uC11C \uC788\uB4E0
        \uC0C1\uAD00\uC5C6\uC5B4. \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uAC00\uB294 \uAC83\uB9CC\uC740
        \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uBAA8\uB450\uC758 \uB73B\uC774 \uB2E4\uB974\uB2E4\uB294 \uAC74 \uC555\uB2C8\uB2E4.
        \uD558\uC9C0\uB9CC \uB8E8\uC774\uC2A4\uB9CC\uC740 \uC774 \uC18C\uB780\uC5D0\uC11C
        \uBE7C \uB450\uACE0 \uC2F6\uAD70\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB2E4\uB4E4 \uB108\uBB34 \uB9CE\uC740 \uAC78 \uC9CA\uC5B4\uC9C0\uACE0
        \uC788\uB124. \uB09C \uADF8\uB0E5 \uC870\uC6A9\uD788 \uB05D\uB0AC\uC73C\uBA74
        \uC88B\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC774 \uC815\uB3C4\uBA74 \uCF54\uC2A4\uAC00 \uC544\uB2C8\uB77C \uC5F0\uD68C\uC9C0.
        \uB204\uAC00 \uBA3C\uC800 \uBB34\uB108\uC9C8\uC9C0 \uAE30\uB300\uB418\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_3_4_5_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000002000000030000000400000006000000
    Lines:
    - SpeakerId: 1
      Text: "\uD55C\uC790\uB9AC\uC5D0 \uC774\uB807\uAC8C \uB2E4\uB978 \uACB0\uD54D\uC774
        \uBAA8\uC600\uB294\uB370\uB3C4 \uC544\uC9C1 \uD568\uAED8 \uC11C \uC788\uB2E4\uB294
        \uAC8C \uB354 \uC2E0\uAE30\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uAC01\uC790\uC758 \uC0DD\uAC01\uC774 \uB2E4\uB974\uB354\uB77C\uB3C4,
        \uC9C0\uAE08\uC740 \uAC19\uC740 \uBC29\uD5A5\uC744 \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB300\uC758\uC640 \uACB0\uB9D0\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4\uB9CC,
        \uC81C\uAC8C \uAC00\uC7A5 \uC911\uC694\uD55C \uAC74 \uB8E8\uC774\uC2A4\uC758
        \uBB34\uC0AC\uC785\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB204\uAC00 \uC633\uC740\uC9C0\uBCF4\uB2E4, \uC5B8\uC81C\uCBE4 \uC880
        \uC26C\uAC8C \uB418\uB294\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uD754\uB4E4\uB824\uB3C4 \uC88B\uB2E4. \uB204\uAD70\uAC00\uB294 \uB05D\uAE4C\uC9C0
        \uBC84\uD2F0\uACE0 \uBAA8\uB450\uB97C \uC138\uC6CC\uC57C \uD558\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_3_4_6_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000002000000030000000400000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uC774 \uC815\uB3C4\uB85C \uB9C8\uC74C\uC774 \uB9CE\uC544\uC9C0\uBA74,
        \uCE68\uBB35\uBCF4\uB2E4 \uC791\uC740 \uADE0\uC5F4\uC774 \uB354 \uC704\uD5D8\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uD754\uB4E4\uB9AC\uB294 \uAC74 \uC774\uD574\uD55C\uB2E4. \uADF8\uB798\uB3C4
        \uC5EC\uAE30\uC11C \uBC1C\uC744 \uBA48\uCD9C \uC21C \uC5C6\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uC5EC\uB7EC\uBD84\uC758 \uC0AC\uBA85\uC774 \uBB34\uC5C7\uC774\uB4E0,
        \uB8E8\uC774\uC2A4\uB97C \uD574\uCE58\uB294 \uC120\uD0DD\uC5D0\uB294 \uB3D9\uC758\uD560
        \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC774 \uB9CE\uC740 \uB9C8\uC74C\uC774 \uD55C\uACF3\uC73C\uB85C \uAC08
        \uB9AC \uC5C6\uC796\uC544. \uADF8\uB7EC\uB2C8 \uB354 \uD53C\uACE4\uD55C \uAC70\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB610 \uC55E\uC73C\uB85C \uAC00\uC790\uACE0 \uD558\uB124. \uADF8 \uB9D0\uC774
        \uC2DC\uC791\uB420 \uB54C\uB9C8\uB2E4 \uB4A4\uC5D0 \uB0A8\uB294 \uC5BC\uAD74\uBD80\uD130
        \uB5A0\uC62C\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_3_4_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000002000000030000000500000006000000
    Lines:
    - SpeakerId: 1
      Text: "\uB2E4\uB4E4 \uAC19\uC740 \uAE38\uC744 \uBCF4\uB294 \uCC99\uD558\uC9C0\uB9CC,
        \uC2DC\uC120\uC774 \uD5A5\uD55C \uB05D\uC740 \uC804\uBD80 \uB2E4\uB974\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uC758\uC2EC\uB3C4 \uB450\uB824\uC6C0\uB3C4 \uB098\uC911\uC774\uB2E4.
        \uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC558\uACE0, \uB098\uB294 \uB05D\uC744
        \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB05D\uC744 \uB17C\uD558\uAE30 \uC804\uC5D0, \uB204\uAC00 \uBA3C\uC800
        \uC0C1\uCC98 \uC785\uB294\uC9C0\uBD80\uD130 \uBCF4\uC544\uC57C \uD558\uC9C0
        \uC54A\uACA0\uC2B5\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uB2E4\uB4E4 \uC785\uC73C\uB85C\uB294 \uACB0\uB9D0\uC744 \uB9D0\uD558\uC9C0\uB9CC,
        \uC18D\uC5D0\uC120 \uC804\uBD80 \uB2E4\uB978 \uD5C8\uAE30\uB97C \uD0A4\uC6B0\uACE0
        \uC788\uAD70."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB204\uAD70\uAC00 \uBA3C\uC800 \uC4F0\uB7EC\uC838\uC57C \uD55C\uB2E4\uBA74
        \uADF8\uAC74 \uB098\uC5EC\uC57C\uC9C0, \uB108\uD76C\uAC00 \uB420 \uC21C \uC5C6\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_3_5_6_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000002000000030000000500000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uC774\uB807\uAC8C \uBAA8\uC774\uBA74 \uB204\uAC00 \uBB34\uB108\uC9C8\uC9C0\uBCF4\uB2E4,
        \uB204\uAC00 \uB05D\uAE4C\uC9C0 \uC228\uAE38\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uB204\uAC00 \uC5B4\uB5A4 \uB9C8\uC74C\uC73C\uB85C \uC11C \uC788\uB4E0
        \uC0C1\uAD00\uC5C6\uC5B4. \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uAC00\uB294 \uAC83\uB9CC\uC740
        \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uBAA8\uB450\uC758 \uB73B\uC774 \uB2E4\uB974\uB2E4\uB294 \uAC74 \uC555\uB2C8\uB2E4.
        \uD558\uC9C0\uB9CC \uC81C\uAC00 \uC9C0\uD0A4\uB824\uB294 \uC0AC\uB78C\uB9CC\uC740
        \uC774 \uC18C\uB780\uC5D0\uC11C \uBE7C \uB450\uACE0 \uC2F6\uAD70\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC774 \uC815\uB3C4\uBA74 \uCF54\uC2A4\uAC00 \uC544\uB2C8\uB77C \uC5F0\uD68C\uC9C0.
        \uB204\uAC00 \uBA3C\uC800 \uBB34\uB108\uC9C8\uC9C0 \uAE30\uB300\uB418\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uC88B\uC544, \uB2E4\uB4E4 \uB9D0\uC740 \uBA4B\uC9C0\uB124. \uADF8\uB798\uC11C
        \uADF8 \uBA4B\uC9C4 \uACB0\uB9D0 \uC544\uB798 \uB204\uAC00 \uBA3C\uC800 \uAE54\uB9AC\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_3_5_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000002000000030000000600000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uD55C\uC790\uB9AC\uC5D0 \uC774\uB807\uAC8C \uB2E4\uB978 \uACB0\uD54D\uC774
        \uBAA8\uC600\uB294\uB370\uB3C4 \uC544\uC9C1 \uD568\uAED8 \uC11C \uC788\uB2E4\uB294
        \uAC8C \uB354 \uC2E0\uAE30\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uAC01\uC790\uC758 \uC0DD\uAC01\uC774 \uB2E4\uB974\uB354\uB77C\uB3C4,
        \uC9C0\uAE08\uC740 \uAC19\uC740 \uBC29\uD5A5\uC744 \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB300\uC758\uC640 \uACB0\uB9D0\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4\uB9CC,
        \uC81C\uAC8C \uAC00\uC7A5 \uC911\uC694\uD55C \uAC74 \uADF8 \uC0AC\uB78C\uC758
        \uBB34\uC0AC\uC785\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uD754\uB4E4\uB824\uB3C4 \uC88B\uB2E4. \uB204\uAD70\uAC00\uB294 \uB05D\uAE4C\uC9C0
        \uBC84\uD2F0\uACE0 \uBAA8\uB450\uB97C \uC138\uC6CC\uC57C \uD558\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uD070 \uB9D0\uB4E4\uC740 \uB298 \uADF8\uB7F4\uB4EF\uD558\uC9C0. \uADFC\uB370
        \uADF8 \uB9D0\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uBC00\uB824\uB098\uB294 \uCABD\uC740
        \uB204\uAC00 \uBCF4\uB098?"
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_3_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000002000000040000000500000006000000
    Lines:
    - SpeakerId: 1
      Text: "\uC774 \uC815\uB3C4\uB85C \uB9C8\uC74C\uC774 \uB9CE\uC544\uC9C0\uBA74,
        \uCE68\uBB35\uBCF4\uB2E4 \uC791\uC740 \uADE0\uC5F4\uC774 \uB354 \uC704\uD5D8\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uD754\uB4E4\uB9AC\uB294 \uAC74 \uC774\uD574\uD55C\uB2E4. \uADF8\uB798\uB3C4
        \uC5EC\uAE30\uC11C \uBC1C\uC744 \uBA48\uCD9C \uC21C \uC5C6\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC774 \uB9CE\uC740 \uB9C8\uC74C\uC774 \uD55C\uACF3\uC73C\uB85C \uAC08
        \uB9AC \uC5C6\uC796\uC544. \uADF8\uB7EC\uB2C8 \uB354 \uD53C\uACE4\uD55C \uAC70\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC774\uC57C, \uD55C\uC790\uB9AC\uC5D0 \uC774\uB807\uAC8C \uB9CE\uC740
        \uACB0\uD54D\uC774 \uBAA8\uC774\uB2C8 \uD5A5\uC774 \uC815\uB9D0 \uC9C4\uD558\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uAC01\uC790\uC758 \uC774\uC720\uAC00 \uB2E4\uB974\uB354\uB77C\uB3C4,
        \uBB34\uB108\uC9C0\uB294 \uC21C\uAC04\uB9CC\uD07C\uC740 \uB0B4\uAC00 \uB9C9\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_4_5_6_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000002000000040000000500000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uB2E4\uB4E4 \uAC19\uC740 \uAE38\uC744 \uBCF4\uB294 \uCC99\uD558\uC9C0\uB9CC,
        \uC2DC\uC120\uC774 \uD5A5\uD55C \uB05D\uC740 \uC804\uBD80 \uB2E4\uB974\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uC758\uC2EC\uB3C4 \uB450\uB824\uC6C0\uB3C4 \uB098\uC911\uC774\uB2E4.
        \uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC558\uACE0, \uB098\uB294 \uB05D\uC744
        \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC774\uB807\uAC8C \uB2E4 \uBAA8\uC5EC\uC11C \uAC19\uC740 \uB05D\uC744
        \uBCF8\uB2E4\uB294 \uB9D0, \uC194\uC9C1\uD788 \uB09C \uC544\uC9C1\uB3C4 \uC798
        \uBAA8\uB974\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uB2E4\uB4E4 \uC785\uC73C\uB85C\uB294 \uACB0\uB9D0\uC744 \uB9D0\uD558\uC9C0\uB9CC,
        \uC18D\uC5D0\uC120 \uC804\uBD80 \uB2E4\uB978 \uD5C8\uAE30\uB97C \uD0A4\uC6B0\uACE0
        \uC788\uAD70."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB2E4\uB4E4 \uC790\uAE30 \uC774\uC720\uB294 \uBD84\uBA85\uD574. \uBB38\uC81C\uB294
        \uADF8\uB7F0 \uC774\uC720\uAC00 \uB298 \uB204\uAD70\uAC00\uB97C \uBC00\uC5B4\uB0B8\uB2E4\uB294
        \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_4_5_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000002000000040000000600000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uC774 \uC815\uB3C4\uB85C \uB9C8\uC74C\uC774 \uB9CE\uC544\uC9C0\uBA74,
        \uCE68\uBB35\uBCF4\uB2E4 \uC791\uC740 \uADE0\uC5F4\uC774 \uB354 \uC704\uD5D8\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uD754\uB4E4\uB9AC\uB294 \uAC74 \uC774\uD574\uD55C\uB2E4. \uADF8\uB798\uB3C4
        \uC5EC\uAE30\uC11C \uBC1C\uC744 \uBA48\uCD9C \uC21C \uC5C6\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC774 \uB9CE\uC740 \uB9C8\uC74C\uC774 \uD55C\uACF3\uC73C\uB85C \uAC08
        \uB9AC \uC5C6\uC796\uC544. \uADF8\uB7EC\uB2C8 \uB354 \uD53C\uACE4\uD55C \uAC70\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uAC01\uC790\uC758 \uC774\uC720\uAC00 \uB2E4\uB974\uB354\uB77C\uB3C4,
        \uBB34\uB108\uC9C0\uB294 \uC21C\uAC04\uB9CC\uD07C\uC740 \uB0B4\uAC00 \uB9C9\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB610 \uC55E\uC73C\uB85C \uAC00\uC790\uACE0 \uD558\uB124. \uADF8 \uB9D0\uC774
        \uC2DC\uC791\uB420 \uB54C\uB9C8\uB2E4 \uB4A4\uC5D0 \uB0A8\uB294 \uC5BC\uAD74\uBD80\uD130
        \uB5A0\uC62C\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_4_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000002000000050000000600000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uB2E4\uB4E4 \uAC19\uC740 \uAE38\uC744 \uBCF4\uB294 \uCC99\uD558\uC9C0\uB9CC,
        \uC2DC\uC120\uC774 \uD5A5\uD55C \uB05D\uC740 \uC804\uBD80 \uB2E4\uB974\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 2
      Text: "\uC758\uC2EC\uB3C4 \uB450\uB824\uC6C0\uB3C4 \uB098\uC911\uC774\uB2E4.
        \uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC558\uACE0, \uB098\uB294 \uB05D\uC744
        \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uB2E4\uB4E4 \uC785\uC73C\uB85C\uB294 \uACB0\uB9D0\uC744 \uB9D0\uD558\uC9C0\uB9CC,
        \uC18D\uC5D0\uC120 \uC804\uBD80 \uB2E4\uB978 \uD5C8\uAE30\uB97C \uD0A4\uC6B0\uACE0
        \uC788\uAD70."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uB204\uAD70\uAC00 \uBA3C\uC800 \uC4F0\uB7EC\uC838\uC57C \uD55C\uB2E4\uBA74
        \uADF8\uAC74 \uB098\uC5EC\uC57C\uC9C0, \uB108\uD76C\uAC00 \uB420 \uC21C \uC5C6\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB2E4\uB4E4 \uC790\uAE30 \uC774\uC720\uB294 \uBD84\uBA85\uD574. \uBB38\uC81C\uB294
        \uADF8\uB7F0 \uC774\uC720\uAC00 \uB298 \uB204\uAD70\uAC00\uB97C \uBC00\uC5B4\uB0B8\uB2E4\uB294
        \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_2_5_6_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000003000000040000000500000006000000
    Lines:
    - SpeakerId: 1
      Text: "\uC774\uB807\uAC8C \uBAA8\uC774\uBA74 \uB204\uAC00 \uBB34\uB108\uC9C8\uC9C0\uBCF4\uB2E4,
        \uB204\uAC00 \uB05D\uAE4C\uC9C0 \uC228\uAE38\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uBAA8\uB450\uC758 \uB73B\uC774 \uB2E4\uB974\uB2E4\uB294 \uAC74 \uC555\uB2C8\uB2E4.
        \uD558\uC9C0\uB9CC \uB8E8\uC774\uC2A4\uB9CC\uC740 \uC774 \uC18C\uB780\uC5D0\uC11C
        \uBE7C \uB450\uACE0 \uC2F6\uAD70\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB2E4\uB4E4 \uB108\uBB34 \uB9CE\uC740 \uAC78 \uC9CA\uC5B4\uC9C0\uACE0
        \uC788\uB124. \uB09C \uADF8\uB0E5 \uC870\uC6A9\uD788 \uB05D\uB0AC\uC73C\uBA74
        \uC88B\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC774 \uC815\uB3C4\uBA74 \uCF54\uC2A4\uAC00 \uC544\uB2C8\uB77C \uC5F0\uD68C\uC9C0.
        \uB204\uAC00 \uBA3C\uC800 \uBB34\uB108\uC9C8\uC9C0 \uAE30\uB300\uB418\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uACB0\uC815\uC774 \uD544\uC694\uD558\uB2E4\uBA74 \uB0B4\uAC00 \uAC10\uB2F9\uD558\uACA0\uB2E4.
        \uB2E4\uB9CC \uB05D\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC544 \uB2EC\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_3_4_5_6_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000003000000040000000500000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uD55C\uC790\uB9AC\uC5D0 \uC774\uB807\uAC8C \uB2E4\uB978 \uACB0\uD54D\uC774
        \uBAA8\uC600\uB294\uB370\uB3C4 \uC544\uC9C1 \uD568\uAED8 \uC11C \uC788\uB2E4\uB294
        \uAC8C \uB354 \uC2E0\uAE30\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uB300\uC758\uC640 \uACB0\uB9D0\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4\uB9CC,
        \uC81C\uAC8C \uAC00\uC7A5 \uC911\uC694\uD55C \uAC74 \uB8E8\uC774\uC2A4\uC758
        \uBB34\uC0AC\uC785\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uB204\uAC00 \uC633\uC740\uC9C0\uBCF4\uB2E4, \uC5B8\uC81C\uCBE4 \uC880
        \uC26C\uAC8C \uB418\uB294\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 5
      Text: "\uC228\uAE30\uB294 \uC0AC\uB78C, \uBD99\uB4DC\uB294 \uC0AC\uB78C, \uB5A0\uB3C4\uB294
        \uC0AC\uB78C\uAE4C\uC9C0. \uC624\uB298 \uACF5\uAE30\uAC00 \uAF64 \uC798 \uC775\uC5C8\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uC0AC\uB791\uC774\uB4E0 \uC758\uC2EC\uC774\uB4E0 \uB2E4 \uC88B\uC9C0.
        \uADFC\uB370 \uADF8\uB7F0 \uB9D0 \uB4A4\uC5D0 \uB0A8\uB294 \uC0AC\uB78C\uC740
        \uB204\uAC00 \uC138\uB098?"
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_3_4_5_7_frag0
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ParticipantIds: 0100000003000000040000000600000007000000
    Lines:
    - SpeakerId: 1
      Text: "\uC774 \uC815\uB3C4\uB85C \uB9C8\uC74C\uC774 \uB9CE\uC544\uC9C0\uBA74,
        \uCE68\uBB35\uBCF4\uB2E4 \uC791\uC740 \uADE0\uC5F4\uC774 \uB354 \uC704\uD5D8\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 3
      Text: "\uC5EC\uB7EC\uBD84\uC758 \uC0AC\uBA85\uC774 \uBB34\uC5C7\uC774\uB4E0,
        \uB8E8\uC774\uC2A4\uB97C \uD574\uCE58\uB294 \uC120\uD0DD\uC5D0\uB294 \uB3D9\uC758\uD560
        \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 4
      Text: "\uC774 \uB9CE\uC740 \uB9C8\uC74C\uC774 \uD55C\uACF3\uC73C\uB85C \uAC08
        \uB9AC \uC5C6\uC796\uC544. \uADF8\uB7EC\uB2C8 \uB354 \uD53C\uACE4\uD55C \uAC70\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 6
      Text: "\uAC01\uC790\uC758 \uC774\uC720\uAC00 \uB2E4\uB974\uB354\uB77C\uB3C4,
        \uBB34\uB108\uC9C0\uB294 \uC21C\uAC04\uB9CC\uD07C\uC740 \uB0B4\uAC00 \uB9C9\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
    - SpeakerId: 7
      Text: "\uB610 \uC55E\uC73C\uB85C \uAC00\uC790\uACE0 \uD558\uB124. \uADF8 \uB9D0\uC774
        \uC2DC\uC791\uB420 \uB54C\uB9C8\uB2E4 \uB4A4\uC5D0 \uB0A8\uB294 \uC5BC\uAD74\uBD80\uD130
        \uB5A0\uC62C\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
    FragmentId: Stage_1_Phase2_group_1_3_4_6_7_frag0
    Condition:
