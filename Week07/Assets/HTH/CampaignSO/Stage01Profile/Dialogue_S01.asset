      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4, \uB2F9\uC2E0\uC5D0\uAC8C \uD5CC\uC2E0\uD558\uB294
        \uAC83\uC774 \uC800\uC758 \uC758\uBB34\uC774\uC790 \uAE30\uC068\uC785\uB2C8\uB2E4. 
        \uB8E8\uC774\uC2A4\uB97C \uB300\uC2E0\uD574 \uC0AC\uB0E5\uC744 \uD558\uB294
        \uAC83\uB3C4 \uC81C\uAC90 \uD798\uB4E0 \uAE30\uB3C4\uB098 \uC218\uD589\uACFC
        \uAC19\uC544\uC694. \uADF8\uB7EC\uB2C8 \uB8E8\uC774\uC2A4\uB294 \uC544\uBB34\uAC83\uB3C4
        \uD558\uC9C0 \uC54A\uC544\uB3C4 \uAD1C\uCC2E\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
