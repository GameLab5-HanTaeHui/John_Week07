    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 4
      Text: "\uB124 \uB9D0\uC740 \uBC30\uACE0\uD508 \uC18C\uB9AC\uC778\uB370, \uB4E3\uACE0
        \uC788\uC73C\uBA74 \uC790\uAFB8 \uB204\uAC00 \uC0AC\uB77C\uC9C8 \uAC83 \uAC19\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB2F9\uC2E0\uC774 \uBA3C\uC800 \uB098\uC120\uB2E4\uACE0 \uD574\uC11C
        \uBAA8\uB4E0 \uAC8C \uD574\uACB0\uB41C\uB2E4\uACE0 \uBBFF\uAE34 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC870\uAE08\uB9CC \uB354 \uD754\uB4E4\uB9AC\uBA74 \uB531 \uC88B\uACA0\uB124.
        \uC544\uC9C1\uC740 \uD5A5\uC774 \uB35C \uC62C\uB790\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uC544\uBB34\uB3C4 \uB098\uC11C\uC9C0 \uC54A\uB294 \uAC83\uBCF4\uB2E4
        \uB0AB\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uADF8 \uC120\uD0DD \uB54C\uBB38\uC5D0 \uB8E8\uC774\uC2A4\uAC00 \uC704\uD5D8\uD574\uC9C4\uB2E4\uBA74
        \uBC1B\uC544\uB4E4\uC77C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uACB0\uAD6D \uB108\uC758 \uBAA8\uB450\uB294 \uD55C \uC0AC\uB78C\uBFD0\uC774\uAD70."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
