%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1266fe8242184fc43b35ffd43f99155e, type: 3}
  m_Name: Dialogue_S01
  m_EditorClassIdentifier: Assembly-CSharp::HTH.Campaign.CampaignDialogueSO
  _stageId: Stage_1_Phase2
  _soloDialogues: []
  _groupDialogues:
  - ComboId: '#1'
    ComboKey: '#1'
    ParticipantIds: 01000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uC0AC\uB78C\uB4E4\uC774 \uC11C\uB85C\uB97C \uBBFF\uB294 \uD45C\uC815\uC744
        \uC9C0\uC744 \uB54C\uB9C8\uB2E4, \uB098\uB294 \uADF8 \uD2C8\uC774 \uC5B4\uB514\uC11C\uBD80\uD130
        \uBC8C\uC5B4\uC9C8\uC9C0 \uBA3C\uC800 \uBCF4\uAC8C \uB41C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uB2E4\uC815\uD55C \uB9D0\uC740 \uBC30\uC6E0\uB2E4. \uD558\uC9C0\uB9CC
        \uB2E4\uC815\uD55C \uC0AC\uB78C\uC774 \uB418\uB294 \uBC95\uC740 \uB05D\uB0B4
        \uBC30\uC6B0\uC9C0 \uBABB\uD588\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uBAA8\uB450\uC5D0\uAC8C \uBD04\uC774 \uC628\uB2E4\uBA74, \uB098\uB294
        \uC65C \uB298 \uBB38\uBC16\uC5D0\uC11C \uADF8 \uC628\uB3C4\uB9CC \uD6D4\uCCD0\uBD10\uC57C
        \uD558\uB294 \uAC78\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: '#2'
    ComboKey: '#2'
    ParticipantIds: 02000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uC5EC\uAE30\uC11C \uBA48\uCD94\uBA74 \uC9C0\uAE08\uAE4C\uC9C0 \uBC84\uD168
        \uC628 \uC2DC\uAC04\uB9C8\uC800 \uD750\uB824\uC9C8 \uAC83 \uAC19\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uB3D9\uB8CC\uB97C \uC544\uB07C\uC9C0 \uC54A\uB294 \uAC8C \uC544\uB2C8\uB2E4.
        \uB2E4\uB9CC \uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC740 \uC804\uC7C1 \uC55E\uC5D0\uC11C
        \uC26C\uC5B4 \uAC00\uC790\uB294 \uB9D0\uC774 \uB450\uB824\uC6B8 \uBFD0\uC774\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC5B8\uC820\uAC00\uB294 \uC81C\uB300\uB85C \uB05D\uB9FA\uC5B4\uC57C
        \uD574. \uADF8\uB798\uC57C \uC783\uC5B4\uBC84\uB9B0 \uAC83\uB4E4\uB3C4 \uADF8\uB0E5
        \uC9C0\uB098\uAC04 \uC77C\uC774 \uC544\uB2C8\uAC8C \uB420 \uD14C\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: '#3'
    ComboKey: '#3'
    ParticipantIds: 03000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4\uAC00 \uC228\uC744 \uACE0\uB974\uB294 \uC18C\uB9AC\uB9CC
        \uB4E4\uB9AC\uBA74, \uC138\uC0C1\uC758 \uC18C\uB780\uC740 \uC7A0\uC2DC \uBA40\uC5B4\uC9C4\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uBAA8\uB450\uB97C \uC704\uD55C \uC77C\uC774\uB77C\uB294 \uB9D0\uC740
        \uC790\uC8FC \uB4E4\uC5C8\uC9C0\uB9CC, \uADF8 \uB9D0\uC774 \uAC00\uAE4C\uC6B4
        \uC0AC\uB78C \uD558\uB098\uB3C4 \uC9C0\uCF1C \uC8FC\uC9C0 \uBABB\uD55C\uB2E4\uBA74
        \uC27D\uAC8C \uBBFF\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uC774 \uB9C8\uC74C\uC774 \uC8C4\uB77C\uBA74, \uB098\uB294 \uAE30\uAEBC\uC774
        \uADF8 \uC8C4\uB97C \uAE30\uB3C4\uCC98\uB7FC \uD488\uACE0 \uAC00\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: '#4'
    ComboKey: '#4'
    ParticipantIds: 04000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 4
      Text: "\uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uB294 \uC2DC\uAC04\uC774
        \uD544\uC694\uD558\uB2E4. \uBB34\uC5B8\uAC00\uB97C \uBC14\uB77C\uB294 \uC77C\uC870\uCC28
        \uC774\uC81C\uB294 \uB108\uBB34 \uBB34\uAC81\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB2E4 \uC54C\uACE0 \uC788\uB2E4. \uB0B4\uAC00 \uCE68\uBB35\uD558\uB294
        \uB3D9\uC548 \uB204\uAD70\uAC00\uB294 \uB354 \uAE4A\uC774 \uB2E4\uCE5C\uB2E4\uB294
        \uAC83\uB3C4, \uADF8\uB798\uB3C4 \uB098\uB294 \uC6C0\uC9C1\uC774\uC9C0 \uBABB\uD55C\uB2E4\uB294
        \uAC83\uB3C4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB204\uAD70\uAC00 \uB0B4 \uBAAB\uC758 \uD604\uC2E4\uAE4C\uC9C0 \uAC00\uB824
        \uC900\uB2E4\uBA74, \uC7A0\uAE50\uCBE4\uC740 \uADF8 \uADF8\uB298 \uC544\uB798
        \uC788\uACE0 \uC2F6\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: '#5'
    ComboKey: '#5'
    ParticipantIds: 05000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 5
      Text: "\uC0AC\uB78C\uC740 \uC808\uB9DD\uD560 \uB54C \uAC00\uC7A5 \uC194\uC9C1\uD55C
        \uD5A5\uC744 \uB0B8\uB2E4. \uC5B5\uC9C0\uB85C \uC228\uAE34 \uAC10\uC815\uC77C\uC218\uB85D
        \uB4B7\uB9DB\uC774 \uAE4A\uC9C0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uB05D\uC740 \uB298 \uC9E7\uC9C0. \uC624\uB798 \uB0A8\uB294 \uAC74 \uADF8
        \uB4A4\uC5D0 \uB0A8\uC740 \uACF5\uAE30\uC640 \uC0AC\uB78C\uB4E4\uC758 \uC5BC\uAD74\uC774\uB354\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC774 \uC6A9\uBCD1\uB2E8\uC740 \uC544\uC9C1 \uB35C \uC775\uC5C8\uC5B4.
        \uC870\uAE08\uB9CC \uB354 \uC11C\uB85C\uB97C \uBBFF\uACE0, \uC870\uAE08\uB9CC
        \uB354 \uC11C\uB85C\uB97C \uC758\uC2EC\uD558\uBA74 \uC644\uC131\uB420 \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: '#6'
    ComboKey: '#6'
    ParticipantIds: 06000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 6
      Text: "\uB204\uAD70\uAC00 \uC55E\uC5D0 \uC11C\uC57C \uD55C\uB2E4\uBA74, \uB098\uB294
        \uC790\uAFB8 \uADF8\uAC8C \uB0B4 \uBAAB\uC774\uB77C\uACE0 \uC0DD\uAC01\uD558\uAC8C
        \uB41C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB0B4\uAC00 \uBA3C\uC800 \uC815\uD558\uBA74 \uBAA8\uB450\uAC00 \uB35C
        \uB2E4\uCE60 \uAC70\uB77C \uBBFF\uC5C8\uB2E4. \uADF8\uAC8C \uB9DE\uB294\uC9C0\uB294
        \uC544\uC9C1\uB3C4 \uC798 \uBAA8\uB974\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uC88B\uC740 \uC758\uB3C4\uB77C\uB294 \uB9D0 \uC544\uB798\uC5D0\uC11C\uB3C4,
        \uB204\uAD70\uAC00\uC758 \uBAAB\uC740 \uC27D\uAC8C \uAC00\uB824\uC9C8 \uC218
        \uC788\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: '#7'
    ComboKey: '#7'
    ParticipantIds: 07000000
    SituationType: "\uAC1C\uC778 \uB3C5\uBC31"
    Trigger: "\uD734\uC2DD / \uBC24 / \uC870\uC0AC \uC911"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 7
      Text: "\uBA3C\uC800 \uC6C0\uC9C1\uC778 \uC0AC\uB78C\uC740 \uC0B0\uB2E4. \uB4A4\uC5D0
        \uB0A8\uC740 \uC0AC\uB78C\uC740 \uAE30\uC5B5\uC774 \uB41C\uB2E4. \uB098\uB294
        \uADF8 \uAE30\uC5B5\uB4E4\uC744 \uB108\uBB34 \uB9CE\uC774 \uB370\uB9AC\uACE0
        \uC654\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uD070 \uB9D0\uC774 \uB098\uC62C\uC218\uB85D, \uC815\uC791 \uC791\uACE0
        \uAD6C\uCCB4\uC801\uC778 \uC774\uB984\uB4E4\uC740 \uB354 \uC27D\uAC8C \uD750\uB824\uC9C4\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB098\uB294 \uD654\uAC00 \uB09C \uAC8C \uC544\uB2C8\uB2E4. \uB2E4\uB9CC
        \uB610 \uB204\uAD70\uAC00\uB97C \uB0A8\uACA8 \uB450\uACE0 \uAC00\uB294 \uBC1C\uAC78\uC74C\uC744
        \uACAC\uB51C \uC218 \uC5C6\uC744 \uBFD0\uC774\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C001
    ComboKey: '#1|#2'
    ParticipantIds: 0100000002000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#2"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB124\uAC00 \uB05D\uC744 \uBCF4\uB824\uB294 \uAC74 \uC54C\uACA0\uC5B4.
        \uB2E4\uB9CC \uBAA8\uB450\uAC00 \uAC19\uC740 \uC18D\uB3C4\uB85C \uAC77\uB294
        \uAC74 \uC544\uB2C8\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC624\uB298\uC740 \uC5EC\uAE30\uC11C \uC815\uBE44\uD558\uACE0, \uB0B4\uC77C
        \uC544\uCE68 \uBC14\uB85C \uC774\uB3D9\uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC5D4\uBE44, \uB10C \uB298 \uB9D0\uBCF4\uB2E4 \uB9CE\uC774 \uBCF4\uACE0
        \uC788\uC9C0. \uADF8\uB807\uB2E4\uBA74 \uB0B4\uAC00 \uC65C \uBA48\uCD9C \uC218
        \uC5C6\uB294\uC9C0\uB3C4 \uC54C \uAC70\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\u2026\uC870\uAE08\uB9CC \uB354 \uC26C\uBA74 \uC548 \uB3FC? \uBC1C\uC774
        \uBB34\uAC70\uC6CC."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4\uC758 \uC0C1\uD0DC\uB97C \uACE0\uB824\uD574\uC57C
        \uD569\uB2C8\uB2E4. \uBB34\uB9AC\uD55C \uC774\uB3D9\uC740 \uC704\uD5D8\uD569\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB458 \uB2E4 \uB9DE\uB294 \uB9D0\uC774\uB2E4. \uC815\uBE44\uC640 \uD734\uC2DD\uC744
        \uBCD1\uD589\uD558\uC790."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uADF8\uB7FC \uC800\uB141\uC740 \uB530\uB73B\uD55C \uAC70\uC57C? \uD1A0\uB2C8\uB294
        \uAD6D\uBB3C\uC774 \uC788\uB294 \uAC8C \uC88B\uC544!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uC2DD\uC0AC\uBD80\uD130 \uD558\uC8E0. \uB2E4\uB4E4 \uC9C0\uCCD0 \uC788\uC73C\uB2C8\uAE4C\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uC6C0\uC9C1\uC774\uAE30 \uC804\uC5D0 \uB4A4\uC5D0 \uB0A8\uB294 \uC0AC\uB78C\uC774
        \uC5C6\uB294\uC9C0 \uD655\uC778\uD574. \uB298 \uADF8\uAC8C \uBB38\uC81C\uC600\uC73C\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C002
    ComboKey: '#1|#3'
    ParticipantIds: 0100000003000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#3"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB370\uC6B0\uC2A4, \uC9C0\uD0A4\uACE0 \uC2F6\uC740 \uB9C8\uC74C\uC774
        \uD074\uC218\uB85D \uB354 \uB9CE\uC740 \uAC78 \uAC00\uB9AC\uAC8C \uB418\uB354\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC640\uC544, \uC624\uB298 \uBE75\uC740 \uC870\uAE08 \uB531\uB531\uD574!
        \uADFC\uB370 \uC539\uB2E4 \uBCF4\uBA74 \uACE0\uC18C\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uC911\uC7AC\uB294 \uACE0\uB9D9\uC2B5\uB2C8\uB2E4\uB9CC, \uC81C \uC6B0\uC120\uC21C\uC704\uB294
        \uBD84\uBA85\uD569\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\u2026\uADF8\uB7F0 \uAC78 \uC798\uB3C4 \uB290\uB07C\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uD1A0\uB2C8\uB294 \uC791\uC740 \uCC28\uC774\uB3C4 \uC798 \uC54C\uC544\uCC28\uB9AC\uB2C8\uAE4C\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC2DD\uC0AC\uAC00 \uB05D\uB098\uBA74 \uC7A5\uBE44 \uC810\uAC80\uC774\uB2E4.
        \uB0B4\uC77C\uC740 \uB354 \uD5D8\uD574\uC9C8 \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4\uB294 \uBA3C\uC800 \uC26C\uAC8C \uD558\uACA0\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB610 \uB530\uB85C \uB5BC\uC5B4\uB193\uB294\uAD70."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uC9C0\uAE08\uC740 \uB2E4\uD234 \uB54C\uAC00 \uC544\uB2C8\uB2E4. \uD544\uC694\uD55C
        \uC900\uBE44\uBD80\uD130 \uB05D\uB0B4\uC790."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C003
    ComboKey: '#1|#4'
    ParticipantIds: 0100000004000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#4"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uC870\uC6A9\uD788 \uC788\uACE0 \uC2F6\uB2E4\uB294 \uB9C8\uC74C, \uC774\uD574\uD574.
        \uD558\uC9C0\uB9CC \uCE68\uBB35\uC774 \uB298 \uC548\uC804\uD55C \uAC74 \uC544\uB2C8\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC774\uB300\uB85C \uAC00\uB2E4\uAC04 \uB2A6\uB294\uB2E4. \uBAA8\uB450\uAC00
        \uB108\uBB34 \uB290\uB824."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB10C \uBB3B\uB294 \uBC29\uC2DD\uC774 \uBD80\uB4DC\uB7EC\uC6CC\uC11C
        \uB300\uB2F5 \uC548 \uD574\uB3C4 \uB418\uB294 \uAE30\uBD84\uC774 \uB4E4\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uC9C0\uCE5C \uAC70\uACA0\uC8E0. \uC624\uB798 \uBC84\uD2F0\uB824\uBA74
        \uAC00\uB054\uC740 \uBA48\uCDB0\uC57C \uD558\uB2C8\uAE4C\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC9C0\uAE08\uC740 \uBA48\uCD9C \uC218 \uC5C6\uC5B4. \uC544\uC9C1 \uD574\uC57C
        \uD560 \uC77C\uC774 \uB0A8\uC544 \uC788\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uADF8\uB798\uB3C4\u2026 \uB2E4\uB4E4 \uBA54\uC774\uB9CC\uD07C \uC55E\uC73C\uB85C
        \uBCFC \uC218 \uC788\uB294 \uAC74 \uC544\uB2C8\uB2C8\uAE4C\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C004
    ComboKey: '#1|#5'
    ParticipantIds: 0100000005000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#5"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB124\uAC00 \uD5A5\uC744 \uB9D0\uD560 \uB54C\uB9C8\uB2E4, \uB204\uAD70\uAC00\uB294
        \uC774\uBBF8 \uB3C4\uB9C8 \uC704\uC5D0 \uC624\uB978 \uAE30\uBD84\uC774 \uB4E4\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uB8E8\uC774\uC2A4\uB97C \uB9CE\uC774 \uAC71\uC815\uD558\uC2DC\uB294\uAD70\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC5D4\uBE44\uB294 \uC7AC\uBBF8\uC788\uC5B4. \uC6C3\uACE0 \uC788\uB294\uB370\uB3C4
        \uB208\uC740 \uB298 \uB2E4\uB978 \uB9DB\uC744 \uC7AC\uACE0 \uC788\uAC70\uB4E0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uAC71\uC815\uC774 \uC544\uB2D9\uB2C8\uB2E4. \uB2F9\uC5F0\uD55C \uCC45\uC784\uC785\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uCC45\uC784\uC774\uB77C\u2026 \uC0AC\uB791\uACFC\uB294 \uB2E4\uB978
        \uB9D0\uCC98\uB7FC \uB4E4\uB9AC\uB124\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB9D0\uC758 \uC774\uB984\uC774 \uBB34\uC5C7\uC774\uB4E0, \uC81C\uAC00
        \uC9C0\uCF1C\uC57C \uD55C\uB2E4\uB294 \uC0AC\uC2E4\uC740 \uBCC0\uD558\uC9C0
        \uC54A\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C005
    ComboKey: '#1|#6'
    ParticipantIds: 0100000006000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#6"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uD504\uB9AC\uB4DC, \uB2E4 \uB124 \uBAAB\uC73C\uB85C \uB9CC\uB4E4\uBA74
        \uC544\uBB34\uB3C4 \uC81C\uB300\uB85C \uC11C\uC9C0 \uBABB\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB108\uB294\u2026 \uC7AC\uCD09 \uC548 \uD574\uC11C \uC88B\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB108\uBB34 \uC624\uB798 \uB0A8\uC758 \uB9C8\uC74C\uC744 \uC77D\uC73C\uBA74
        \uC815\uC791 \uC790\uAE30 \uBC1C\uBC11\uC744 \uB193\uCE5C\uB2E4. \uB124\uAC00
        \uBB34\uB108\uC9C0\uB294 \uAC83\uB9CC\uC740 \uB0B4\uAC00 \uB9C9\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uC800\uB3C4 \uB204\uAD70\uAC00\uB97C \uC7AC\uCD09\uD560 \uC790\uACA9\uC740
        \uC5C6\uC73C\uB2C8\uAE4C\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uADF8 \uB9D0, \uC870\uAE08 \uC774\uC0C1\uD558\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uADF8\uB0E5\u2026 \uC624\uB798 \uBA48\uCDB0 \uC788\uB358 \uC0AC\uB78C\uC740
        \uC6C0\uC9C1\uC774\uB294 \uBC95\uC744 \uC798 \uBAA8\uB978\uB2E4\uB294 \uB73B\uC774\uC5D0\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C006
    ComboKey: '#1|#7'
    ParticipantIds: 0100000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #1|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB124 \uC9C8\uBB38\uC740 \uAC70\uC2AC\uB9AC\uC9C0\uB9CC \uAF2D \uD544\uC694\uD55C
        \uB9D0\uC774\uAE30\uB3C4 \uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC5D4\uBE44\uB294 \uC0AC\uB78C\uB4E4 \uD45C\uC815 \uC798 \uBCF4\uC9C0?
        \uD1A0\uB2C8\uB3C4 \uC880 \uC54C\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB124\uAC00 \uC870\uC6A9\uD560\uC218\uB85D \uB354 \uC758\uC2EC\uC2A4\uB7EC\uC6CC.
        \uC544\uBB34\uB3C4 \uADF8\uB807\uAC8C \uC624\uB798 \uC911\uAC04\uC5D0\uB9CC
        \uC11C \uC788\uC9C4 \uBABB\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uADF8\uAC74 \uC88B\uC740 \uBC84\uB987\uB9CC\uC740 \uC544\uB2C8\uC5D0\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC751! \uC54C\uC544\uB3C4 \uBAA8\uB974\uB294 \uCC99\uD558\uBA74 \uB418\uC796\uC544?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\u2026\uD1A0\uB2C8\uB294 \uAC00\uB054 \uB108\uBB34 \uC815\uD655\uD55C
        \uB9D0\uC744 \uD558\uB124\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C007
    ComboKey: '#2|#3'
    ParticipantIds: 0200000003000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #2|#3"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uD55C\uCABD\uB9CC \uBCF4\uACE0 \uC788\uC744 \uC5EC\uC720\uB294 \uC5C6\uB2E4.
        \uBAA8\uB450\uB97C \uC0DD\uAC01\uD55C\uB2E4\uBA74 \uB354 \uC11C\uB458\uB7EC\uC57C
        \uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB0B4\uAC00 \uB9E1\uC73C\uBA74 \uB41C\uB2E4. \uADF8\uAC8C \uAC00\uC7A5
        \uC548\uC815\uC801\uC774\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB05D\uC744 \uC11C\uB450\uB97C\uC218\uB85D \uB354 \uC57D\uD55C \uC0AC\uB78C\uC774
        \uBA3C\uC800 \uB2E4\uCE69\uB2C8\uB2E4. \uADF8 \uC810\uC740 \uC78A\uC9C0 \uB9D0\uC544
        \uC8FC\uC2ED\uC2DC\uC624."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uC815\uB9D0 \uBAA8\uB450\uAC00 \uADF8\uAC78 \uC6D0\uD55C\uB2E4\uACE0
        \uC0DD\uAC01\uD558\uC138\uC694?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uC6D0\uD558\uC9C0 \uC54A\uC544\uB3C4 \uD544\uC694\uD558\uB2E4\uBA74
        \uD574\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uADF8 \uB9D0\uC740\u2026 \uB9C8\uCE58 \uBA85\uB839\uCC98\uB7FC \uB4E4\uB9AC\uB124\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C008
    ComboKey: '#2|#4'
    ParticipantIds: 0200000004000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #2|#4"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uC9C0\uD0A4\uACE0 \uC2F6\uC740 \uC0AC\uB78C\uC774 \uC788\uB2E4\uBA74
        \uB354\uB354\uC6B1 \uC2F8\uC6C0\uC744 \uB05D\uB0B4\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB10C \uB108\uBB34 \uB9E4\uB044\uB7EC\uC6CC. \uB2E4\uB4E4 \uB110 \uD3B8\uD558\uAC8C
        \uC5EC\uAE30\uB294\uB370, \uC774\uC0C1\uD558\uAC8C \uB124 \uD754\uC801\uC740
        \uC5C6\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uBA54\uC774, \uB05D\uC744 \uBD10\uC57C \uD55C\uB2E4\uB294 \uB9D0\uC740
        \uC54C\uC544. \uADFC\uB370 \uB09C \uAC00\uB054 \uBA48\uCD94\uACE0 \uC2F6\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uADF8\uB807\uAC8C \uBCF4\uC600\uB098\uC694?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uBCF4\uC600\uB0D0\uACE0 \uBB3B\uB294 \uC0AC\uB78C\uC740 \uB300\uAC1C
        \uC54C\uACE0 \uC788\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\u2026\uC0C8\uD134\uC740 \uB298 \uC544\uD508 \uACF3\uC744 \uBA3C\uC800
        \uBCF4\uB124\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
