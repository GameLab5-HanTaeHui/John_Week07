        \uB204\uAC00 \uB05D\uAE4C\uC9C0 \uC228\uAE38\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574\uC838."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB2E4\uB4E4 \uB108\uBB34 \uB9CE\uC740 \uAC78 \uC9CA\uC5B4\uC9C0\uACE0
        \uC788\uB124. \uB09C \uADF8\uB0E5 \uC870\uC6A9\uD788 \uB05D\uB0AC\uC73C\uBA74
        \uC88B\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC774 \uC815\uB3C4\uBA74 \uCF54\uC2A4\uAC00 \uC544\uB2C8\uB77C \uC5F0\uD68C\uC9C0.
        \uB204\uAC00 \uBA3C\uC800 \uBB34\uB108\uC9C8\uC9C0 \uAE30\uB300\uB418\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uACB0\uC815\uC774 \uD544\uC694\uD558\uB2E4\uBA74 \uB0B4\uAC00 \uAC10\uB2F9\uD558\uACA0\uB2E4.
        \uB2E4\uB9CC \uB05D\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC544 \uB2EC\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uC88B\uC544, \uB2E4\uB4E4 \uB9D0\uC740 \uBA4B\uC9C0\uB124. \uADF8\uB798\uC11C
        \uADF8 \uBA4B\uC9C4 \uACB0\uB9D0 \uC544\uB798 \uB204\uAC00 \uBA3C\uC800 \uAE54\uB9AC\uB294\uB370?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C107
    ComboKey: '#2|#3|#4|#5|#6'
    ParticipantIds: 0200000003000000040000000500000006000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #2|#3|#4|#5|#6"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uAC01\uC790\uC758 \uC0DD\uAC01\uC774 \uB2E4\uB974\uB354\uB77C\uB3C4,
        \uC9C0\uAE08\uC740 \uAC19\uC740 \uBC29\uD5A5\uC744 \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB300\uC758\uC640 \uACB0\uB9D0\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4\uB9CC,
        \uC81C\uAC8C \uAC00\uC7A5 \uC911\uC694\uD55C \uAC74 \uB8E8\uC774\uC2A4\uC758
        \uBB34\uC0AC\uC785\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB204\uAC00 \uC633\uC740\uC9C0\uBCF4\uB2E4, \uC5B8\uC81C\uCBE4 \uC880
        \uC26C\uAC8C \uB418\uB294\uC9C0\uAC00 \uB354 \uAD81\uAE08\uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC624\uB298\uC740 \uC720\uB09C\uD788 \uACF5\uAE30\uAC00 \uBCF5\uC7A1\uD558\uB124.
        \uC11C\uB85C \uB2E4\uB978 \uC628\uB3C4\uAC00 \uD55C\uB370 \uC11E\uC5EC \uC788\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uD754\uB4E4\uB824\uB3C4 \uC88B\uB2E4. \uB204\uAD70\uAC00\uB294 \uB05D\uAE4C\uC9C0
        \uBC84\uD2F0\uACE0 \uBAA8\uB450\uB97C \uC138\uC6CC\uC57C \uD558\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C108
    ComboKey: '#2|#3|#4|#5|#7'
    ParticipantIds: 0200000003000000040000000500000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #2|#3|#4|#5|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uD754\uB4E4\uB9AC\uB294 \uAC74 \uC774\uD574\uD55C\uB2E4. \uADF8\uB798\uB3C4
        \uC5EC\uAE30\uC11C \uBC1C\uC744 \uBA48\uCD9C \uC21C \uC5C6\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uC5EC\uB7EC\uBD84\uC758 \uC0AC\uBA85\uC774 \uBB34\uC5C7\uC774\uB4E0,
        \uB8E8\uC774\uC2A4\uB97C \uD574\uCE58\uB294 \uC120\uD0DD\uC5D0\uB294 \uB3D9\uC758\uD560
        \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uC774 \uB9CE\uC740 \uB9C8\uC74C\uC774 \uD55C\uACF3\uC73C\uB85C \uAC08
        \uB9AC \uC5C6\uC796\uC544. \uADF8\uB7EC\uB2C8 \uB354 \uD53C\uACE4\uD55C \uAC70\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC774\uC57C, \uD55C\uC790\uB9AC\uC5D0 \uC774\uB807\uAC8C \uB9CE\uC740
        \uACB0\uD54D\uC774 \uBAA8\uC774\uB2C8 \uD5A5\uC774 \uC815\uB9D0 \uC9C4\uD558\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB610 \uC55E\uC73C\uB85C \uAC00\uC790\uACE0 \uD558\uB124. \uADF8 \uB9D0\uC774
        \uC2DC\uC791\uB420 \uB54C\uB9C8\uB2E4 \uB4A4\uC5D0 \uB0A8\uB294 \uC5BC\uAD74\uBD80\uD130
        \uB5A0\uC62C\uB77C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: C109
    ComboKey: '#2|#3|#4|#6|#7'
    ParticipantIds: 0200000003000000040000000600000007000000
    SituationType: "\uC0DD\uC874 \uC870\uD569 \uB300\uC0AC"
    Trigger: "\uC0DD\uC874 \uC870\uD569: #2|#3|#4|#6|#7"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uC758\uC2EC\uB3C4 \uB450\uB824\uC6C0\uB3C4 \uB098\uC911\uC774\uB2E4.
        \uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC558\uACE0, \uB098\uB294 \uB05D\uC744
        \uBD10\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB05D\uC744 \uB17C\uD558\uAE30 \uC804\uC5D0, \uB204\uAC00 \uBA3C\uC800
        \uC0C1\uCC98 \uC785\uB294\uC9C0\uBD80\uD130 \uBCF4\uC544\uC57C \uD558\uC9C0
        \uC54A\uACA0\uC2B5\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uC774\uB807\uAC8C \uB2E4 \uBAA8\uC5EC\uC11C \uAC19\uC740 \uB05D\uC744
        \uBCF8\uB2E4\uB294 \uB9D0, \uC194\uC9C1\uD788 \uB09C \uC544\uC9C1\uB3C4 \uC798
        \uBAA8\uB974\uACA0\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB204\uAD70\uAC00 \uBA3C\uC800 \uC4F0\uB7EC\uC838\uC57C \uD55C\uB2E4\uBA74
        \uADF8\uAC74 \uB098\uC5EC\uC57C\uC9C0, \uB108\uD76C\uAC00 \uB420 \uC21C \uC5C6\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB2E4\uB4E4 \uC790\uAE30 \uC774\uC720\uB294 \uBD84\uBA85\uD574. \uBB38\uC81C\uB294
        \uADF8\uB7F0 \uC774\uC720\uAC00 \uB298 \uB204\uAD70\uAC00\uB97C \uBC00\uC5B4\uB0B8\uB2E4\uB294
