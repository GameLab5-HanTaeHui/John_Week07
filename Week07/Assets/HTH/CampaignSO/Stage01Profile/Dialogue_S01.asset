    Visibility: 
    FragmentId: 
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB124\uAC00 \uD5A5\uC744 \uB9D0\uD560 \uB54C\uB9C8\uB2E4, \uB204\uAD70\uAC00\uB294
        \uC774\uBBF8 \uB3C4\uB9C8 \uC704\uC5D0 \uC624\uB978 \uAE30\uBD84\uC774 \uB4E4\uC5B4."
