      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uD504\uB9AC\uB4DC, \uBA3C\uC800 \uB098\uC11C\uB294 \uB9C8\uC74C\uC774
        \uB298 \uAC00\uC7A5 \uC88B\uC740 \uB2F5\uC774 \uB418\uB294 \uAC74 \uC544\uB2D9\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uC0C8\uD134, \uB124 \uC758\uC2EC\uC774 \uD544\uC694\uD55C \uAC74 \uC548\uB2E4.
        \uADF8\uB798\uB3C4 \uB204\uAD70\uAC00\uB294 \uBA3C\uC800 \uBAB8\uC744 \uC138\uC6CC\uC57C
