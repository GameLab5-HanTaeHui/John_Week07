  - ComboId: COND_P02_01
    ComboKey: '#2'
    ParticipantIds: 02000000
    SituationType: "\uD504\uB85C\uD30C\uC77C \uD575\uC2EC\uBB38\uC7A5"
    Trigger: "\uC0AC\uB9DD \uC0AC\uAC74\uC774 \uBC1C\uC0DD\uD55C \uC0C1\uD0DC\uC5D0\uC11C,
      \uBA54\uC774(#2) \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD63C\uC790
      \uC788\uACE0, \uBA54\uC774\uAC00 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC744 \uC2DC"
    Visibility: 
    FragmentId: P02_01
    TriggerDeadIds: 
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uB204\uAD6C\uC758 \uC8FD\uC74C\uC5D0\uB3C4 \uD754\uB4E4\uB9AC\uC9C0
        \uB9C8\uB77C, \uBA54\uC774. \uC0B4\uC544\uB0A8\uC740 \uAC83\uC5D0 \uC9D1\uC911\uD574\uB77C.
        \uB098\uB294 \uC0B4\uC544\uB0A8\uC558\uB2E4. \uB0B4\uAC00 \uAC00\uBB38\uC758
        \uBA78\uC871\uC5D0\uB3C4 \uC0B4\uC544 \uC788\uB294 \uAC83\uC5D0\uB294 \uC774\uC720\uAC00
        \uC788\uB2E4. \uADF8\uB798\uC57C\uB9CC \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: COND_P02_02
    ComboKey: '#2|#5'
    ParticipantIds: 0200000005000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751 / \uBCF5\uC218\uC790"
    Trigger: "\uBA54\uC774(#2),\uD1A0\uB2C8(#5)\uAC00 \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0
      \uB458\uB9CC \uC788\uACE0, \uD1A0\uB2C8\uAC00 \uBC30\uD68C\uC790(\uC0C8\uD134)\uC5D0\uAC8C
      \uC0AC\uB9DD \uB2F9\uD558\uC9C0 \uC54A\uACE0, \uBCF5\uC218\uC790(\uBA54\uC774)\uC5D0\uAC8C
      \uC0AC\uB9DD\uB2F9\uD560 \uC2DC"
    Visibility: 
    FragmentId: P02_02
    TriggerDeadIds: 05000000
    UnlockConditionId: P05_04
    HintOfConditionId: 
    Lines:
    - SpeakerId: 5
      Text: "\uD5E4\uD5E4... \uBA54\uC774 \uC624\uBE60\uB294 \uC54C\uACE0 \uC788\uC5C8\uAD6C\uB098.
        \uACB0\uAD6D \uBA54\uC774 \uC624\uBE60\uD55C\uD14C \uC8FD\uC5B4\uBC84\uB9AC\uAC8C
        \uB410\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uBA54\uC774 \uC624\uBE60\uB294 \uB098\uC05C \uC0AC\uB78C\uC744 \uC4F0\uB7EC\uD2B8\uB9B4
        \uB54C \uBC18\uC9DD\uC5EC. \uBAA8\uB450\uAC00 \uC88B\uC544\uD558\uB294 \uC601\uC6C5\uC774\uC57C!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC601\uC6C5\uC774\uB77C\uC11C \uC4F0\uB7EC\uD2B8\uB9AC\uB294 \uAC8C
        \uC544\uB2C8\uB2E4. \uAC00\uBB38\uC758 \uC774\uB984\uC744 \uB418\uC0B4\uB9AC\uAE30
        \uC704\uD568\uC77C \uBFD0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC544\uD558\uD558! \uC624\uBE60 \uC0AC\uC2E4\uC740 \uADF8\uB7F0\uAC70\uC5D0
        \uAD00\uC2EC \uC5C6\uC796\uC544. \uBA54\uC774 \uC624\uBE60, \uC774\uC720
        \uC5C6\uB294 \uC8FD\uC74C\uC740 \uC5C6\uB2E4\uC9C0\uB9CC \uC0B4\uC544\uAC00\uB294
        \uB370\uB294 \uC774\uC720\uAC00 \uC5C6\uC5B4!"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC73C\uC544.. \uC544\uD504\uB2E4... \uD1A0\uB2C8 \uC8FD\uC5B4\uBC84\uB824..."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "...\uC0B4\uC544\uAC00\uB294 \uB370 \uC774\uC720\uAC00 \uC5C6\uB2E4\uACE0?
        \uADF8\uB7F4\uB9AC\uAC00..."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
