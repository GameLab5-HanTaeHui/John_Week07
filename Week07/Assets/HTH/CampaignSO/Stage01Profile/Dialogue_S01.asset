  - ComboId: DTH_1
    ComboKey: '#2|#3|#4|#5|#6|#7'
    ParticipantIds: 020000000300000004000000050000000600000007000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751"
    Trigger: "\uC5D4\uBE44 \uC0AC\uB9DD"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 01000000
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uC5D4\uBE44\uAC00 \uC774\uB807\uAC8C \uC0AC\uB77C\uC9C8 \uC904\uC740
        \uBAB0\uB790\uC5B4. \uBBFF\uC5C8\uB358 \uB9CC\uD07C, \uBE48\uC790\uB9AC\uAC00
        \uB354 \uC704\uD5D8\uD558\uAC8C \uB290\uAEF4\uC9C4\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4, \uC7A0\uAE50 \uC5EC\uAE30 \uC788\uC5B4\uC694. \uC9C0\uAE08\uC740
        \uB9C8\uC74C\uC774 \uD750\uD2B8\uB7EC\uC9C0\uC9C0 \uC54A\uAC8C \uD558\uB294
        \uAC8C \uBA3C\uC800\uC785\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uC5D4\uBE44\uB294 \uC870\uC6A9\uD574\uC11C \uD3B8\uD588\uB294\uB370\u2026
        \uC870\uC6A9\uD55C \uC0AC\uB78C\uB3C4 \uC774\uB807\uAC8C \uC0AC\uB77C\uC9C0\uB294\uAD6C\uB098."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC5D4\uBE44 \uC5B8\uB2C8\uB294 \uB298 \uD55C\uBC1C \uC55E\uC11C \uC788\uB294
        \uAC83 \uAC19\uC558\uB294\uB370\u2026 \uC774\uB7F0 \uC2DD\uC73C\uB85C \uBE44\uAC8C
        \uB420 \uC904\uC740 \uBAB0\uB790\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB0B4\uAC00 \uBA3C\uC800 \uB9C9\uC558\uC5B4\uC57C \uD588\uB2E4. \uC5D4\uBE44\uAC00
        \uB0A8\uAE34 \uCE68\uBB35\uAE4C\uC9C0 \uB0B4\uAC00 \uC9CA\uC5B4\uC9C0\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uBD80\uB4DC\uB7EC\uC6B4 \uB9D0 \uB4A4\uC5D0 \uBB50\uAC00 \uC788\uC5C8\uB294\uC9C0\uB294
        \uC774\uC81C \uBABB \uBB3B\uACA0\uB124. \uADF8\uB798\uB3C4 \uB204\uAC00 \uB0A8\uACBC\uB294\uC9C0\uB294
        \uBD10\uC57C \uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: DTH_2
    ComboKey: '#1|#3|#4|#5|#6|#7'
    ParticipantIds: 010000000300000004000000050000000600000007000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751"
    Trigger: "\uBA54\uC774 \uC0AC\uB9DD"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 02000000
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uBA54\uC774\uAC00 \uBA48\uCDC4\uC5B4\uC694. \uB204\uAD6C\uBCF4\uB2E4
        \uB05D\uC744 \uBCF4\uB824 \uD558\uB358 \uC0AC\uB78C\uC774\u2026"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uADF8\uC758 \uBC29\uC2DD\uC774 \uBD88\uC548\uD558\uAE34 \uD588\uC9C0\uB9CC,
        \uC774\uB7F0 \uACB0\uACFC\uAE4C\uC9C0 \uBC14\uB780 \uC801\uC740 \uC5C6\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uC774\uC81C \uB354 \uAC00\uC790\uACE0 \uB9D0\uD560 \uC0AC\uB78C\uC774
        \uC904\uC5C8\uB124. \uADF8\uB7F0\uB370 \uC65C \uD558\uB098\uB3C4 \uAC00\uBCCD\uC9C0
        \uC54A\uC9C0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uBA54\uC774 \uC624\uBE60\uC758 \uBD88\uAF43\uC774 \uAEBC\uC84C\uC5B4.
        \uC774\uB807\uAC8C \uBE68\uB9AC \uC2DD\uC744 \uC904\uC740 \uBAB0\uB790\uB294\uB370."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uBA54\uC774\uAC00 \uC9CA\uC5B4\uC9C4 \uACB0\uB9D0\uC744 \uB0B4\uAC00
        \uB300\uC2E0 \uB05D\uAE4C\uC9C0 \uAC00\uC838\uAC00\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uACB0\uB9D0\uB9CC \uBCF4\uB358 \uC0AC\uB78C\uC774 \uACB0\uAD6D \uACFC\uC815\uC5D0\uC11C
        \uC0AC\uB77C\uC84C\uC5B4. \uADF8\uB798\uC11C \uB0B4\uAC00 \uACC4\uC18D \uBB3C\uC5C8\uB358
        \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: DTH_3
    ComboKey: '#1|#2|#4|#5|#6|#7'
    ParticipantIds: 010000000200000004000000050000000600000007000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751"
    Trigger: "\uB370\uC6B0\uC2A4 \uC0AC\uB9DD"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 03000000
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB370\uC6B0\uC2A4\uAC00 \uC0AC\uB77C\uC84C\uB2E4\uBA74, \uC774\uC81C
        \uB8E8\uC774\uC2A4\uB97C \uBD99\uC7A1\uACE0 \uC788\uB358 \uC138\uACC4\uB3C4
        \uD754\uB4E4\uB9AC\uACA0\uC8E0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC9C0\uAE08\uC740 \uB8E8\uC774\uC2A4\uBD80\uD130 \uCC59\uACA8. \uB354
        \uBB34\uB108\uC9C0\uB294 \uC0AC\uB78C\uC740 \uC5C6\uC5B4\uC57C \uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uB370\uC6B0\uC2A4\u2026? \uB300\uB2F5\uD574. \uB098, \uC774\uC81C \uC5B4\uB514\uC5D0
        \uAE30\uB300\uC57C \uD574?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uB458\uC774 \uD558\uB098\uCC98\uB7FC \uBD99\uC5B4 \uC788\uC5C8\uB294\uB370\u2026
        \uD558\uB098\uAC00 \uB5A8\uC5B4\uC9C0\uBA74 \uB098\uBA38\uC9C0\uB294 \uC5B4\uB5BB\uAC8C
        \uB420\uAE4C?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB8E8\uC774\uC2A4 \uACC1\uC5D0 \uB0B4\uAC00 \uC11C\uACA0\uB2E4. \uB370\uC6B0\uC2A4\uAC00
        \uB0A8\uAE34 \uBE48\uC790\uB9AC\uB97C \uBC29\uCE58\uD558\uC9C0 \uC54A\uACA0\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uD55C\uACF3\uC5D0 \uB108\uBB34 \uB9CE\uC740 \uBB34\uAC8C\uB97C \uC2E4\uC73C\uBA74,
        \uB0A8\uC740 \uCABD\uC740 \uC11C \uC788\uB294 \uBC95\uBD80\uD130 \uC78A\uC5B4\uBC84\uB9AC\uAC8C
        \uB3FC."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: DTH_4
    ComboKey: '#1|#2|#3|#5|#6|#7'
    ParticipantIds: 010000000200000003000000050000000600000007000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751"
    Trigger: "\uB8E8\uC774\uC2A4 \uC0AC\uB9DD"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 04000000
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uB8E8\uC774\uC2A4\uB294 \uC26C\uACE0 \uC2F6\uB2E4\uACE0 \uD588\uC744
        \uBFD0\uC778\uB370\u2026 \uC6B0\uB9AC\uB294 \uADF8 \uB9D0\uB3C4 \uC81C\uB300\uB85C
        \uB4E3\uC9C0 \uBABB\uD588\uB124\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uB8E8\uC774\uC2A4\uAE4C\uC9C0 \uC783\uC5C8\uB2E4. \uB354\uB294 \uB204\uAD6C\uB3C4
        \uB4A4\uC5D0 \uB0A8\uAE30\uC9C0 \uC54A\uACA0\uB2E4\uACE0 \uD588\uB294\uB370."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uB8E8\uC774\uC2A4\uAC00 \uC5C6\uB294 \uAE38\uC774\uB77C\uBA74, \uC81C\uAC00
        \uAC78\uC5B4\uC57C \uD560 \uC774\uC720\uB3C4 \uC0AC\uB77C\uC84C\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uB8E8\uC774\uC2A4 \uC624\uBE60\uB294 \uC870\uC6A9\uD588\uB294\uB370\u2026
        \uC870\uC6A9\uD55C \uB9DB\uC740 \uC0AC\uB77C\uC9C0\uACE0 \uB098\uC11C \uB354
        \uC624\uB798 \uB0A8\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uADF8\uAC00 \uB354 \uC26C\uC5B4\uB3C4 \uB41C\uB2E4\uACE0 \uB9D0\uD574\uC92C\uC5B4\uC57C
        \uD588\uB2E4. \uB0B4\uAC00 \uB300\uC2E0 \uC9CA\uC5B4\uC9C8 \uC218 \uC788\uC5C8\uB294\uB370."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uBA48\uCD94\uACE0 \uC2F6\uB2E4\uB358 \uC0AC\uB78C\uC744 \uB05D\uAE4C\uC9C0
        \uB04C\uACE0 \uC628 \uACB0\uACFC\uAC00 \uC774\uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: DTH_5
    ComboKey: '#1|#2|#3|#4|#6|#7'
    ParticipantIds: 010000000200000003000000040000000600000007000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751"
    Trigger: "\uD1A0\uB2C8 \uC0AC\uB9DD"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 05000000
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uD1A0\uB2C8\uB294 \uB298 \uC6C3\uACE0 \uC788\uC5C8\uC8E0. \uADF8 \uC6C3\uC74C\uC774
        \uBB34\uC5C7\uC744 \uAC00\uB9AC\uACE0 \uC788\uC5C8\uB294\uC9C0, \uC774\uC81C
        \uD655\uC778\uD560 \uC218 \uC5C6\uB124\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uD1A0\uB2C8\uAC00 \uBE60\uC84C\uB2E4\uACE0 \uD574\uC11C \uB05D\uB09C
        \uAC74 \uC544\uB2C8\uC57C. \uB0A8\uC740 \uD754\uC801\uBD80\uD130 \uD655\uC778\uD574\uC57C
        \uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uBD88\uC548\uD55C \uC544\uC774\uC600\uC2B5\uB2C8\uB2E4. \uB8E8\uC774\uC2A4\uC5D0\uAC8C
        \uAC00\uAE4C\uC774 \uC624\uC9C0 \uBABB\uD558\uAC8C \uD55C \uD310\uB2E8\uC774
        \uD2C0\uB9AC\uC9C4 \uC54A\uC558\uAD70\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uD1A0\uB2C8\uAC00 \uC870\uC6A9\uD558\uB2C8\uAE4C \uC774\uC0C1\uD574.
        \uBC1D\uC740 \uC18C\uB9AC\uAC00 \uC0AC\uB77C\uC84C\uB294\uB370, \uC548\uC2EC\uC774
        \uB418\uC9C4 \uC54A\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uC544\uC774\uCC98\uB7FC \uC6C3\uB358 \uC5BC\uAD74 \uB4A4\uC758 \uC5B4\uB460\uC744
        \uB0B4\uAC00 \uB108\uBB34 \uB2A6\uAC8C \uBD24\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB4DC\uB514\uC5B4 \uC870\uC6A9\uD574\uC84C\uB124. \uADF8\uB7F0\uB370
        \uBB38\uC81C\uB294, \uC870\uC6A9\uD574\uC9C4 \uB4A4\uC5D0\uB3C4 \uCC1C\uCC1C\uD558\uB2E4\uB294
        \uAC70\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: DTH_6
    ComboKey: '#1|#2|#3|#4|#5|#7'
    ParticipantIds: 010000000200000003000000040000000500000007000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751"
    Trigger: "\uD504\uB9AC\uB4DC \uC0AC\uB9DD"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 06000000
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uD504\uB9AC\uB4DC\uB294 \uB05D\uAE4C\uC9C0 \uB204\uAD70\uAC00\uC758
        \uBAAB\uC744 \uB300\uC2E0 \uAC00\uC838\uAC00\uB824 \uD588\uC5B4\uC694. \uADF8\uAC8C
        \uBAA8\uB450\uB97C \uC0B4\uB9AC\uB294 \uAE38\uC774\uB77C \uBBFF\uC73C\uBA74\uC11C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC65C \uB124\uAC00 \uBA3C\uC800\uC600\uC5B4. \uC65C \uB610 \uC774\uB7F0
        \uC2DD\uC73C\uB85C \uBE44\uC5B4 \uBC84\uB824\uC57C \uD574."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uC88B\uC740 \uB73B\uC73C\uB85C \uD3EC\uC7A5\uD558\uAE30\uC5D4, \uB0A8\uC740
        \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uB0A8\uC740 \uBB34\uAC8C\uAC00 \uB108\uBB34
        \uD07D\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uBBF8\uC548\uD574. \uB108\uB294 \uB298 \uB300\uC2E0 \uC9CA\uC5B4\uC84C\uB294\uB370,
        \uB098\uB294 \uB05D\uAE4C\uC9C0 \uAE30\uB300\uAE30\uB9CC \uD588\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uD504\uB9AC\uB4DC \uC624\uBE60\uB294 \uAC00\uC7A5 \uBA3C\uC800 \uB098\uC130\uC5B4.
        \uADF8\uB7F0 \uC0AC\uB78C\uC740 \uC0AC\uB77C\uC9C0\uB294 \uC21C\uAC04\uAE4C\uC9C0
        \uB530\uB73B\uD558\uAD6C\uB098."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uBD10. \uACB0\uAD6D \uB9C8\uC9C0\uB9C9 \uC120\uD0DD\uAE4C\uC9C0 \uD63C\uC790
        \uAC00\uC838\uAC14\uC796\uC544. \uB0A8\uC740 \uC0AC\uB78C\uD55C\uD14C \uBB3C\uC5B4\uBCF4\uC9C0\uB3C4
        \uC54A\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: DTH_7
    ComboKey: '#1|#2|#3|#4|#5|#6'
    ParticipantIds: 010000000200000003000000040000000500000006000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751"
    Trigger: "\uC0C8\uD134 \uC0AC\uB9DD"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 07000000
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 1
      Text: "\uC0C8\uD134\uC740 \uB05D\uAE4C\uC9C0 \uC758\uC2EC\uD588\uC5B4\uC694.
        \uC5B4\uCA4C\uBA74 \uC6B0\uB9AC\uAC00 \uC678\uBA74\uD55C \uAC78 \uAC00\uC7A5
        \uC815\uD655\uD788 \uBCF4\uACE0 \uC788\uC5C8\uB294\uC9C0\uB3C4\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC0C8\uD134\uC774 \uC5C6\uC73C\uBA74 \uC6B0\uB9B4 \uBA48\uCDB0 \uC138\uC6B8
        \uC0AC\uB78C\uC774 \uC904\uC5B4\uB4E0\uB2E4. \uADF8\uAC8C \uC624\uD788\uB824
        \uB450\uB835\uAD70."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uC0C8\uD134\uC758 \uC9C8\uBB38\uC740 \uBD88\uD3B8\uD588\uC9C0\uB9CC,
        \uC644\uC804\uD788 \uD2C0\uB9B0 \uB9D0\uC740 \uC544\uB2C8\uC5C8\uC2B5\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 4
      Text: "\uC0C8\uD134\uC740 \uACC4\uC18D \uBB3C\uC5C8\uC9C0. \uB098\uB294 \uBB3B\uB294
        \uAC83\uB3C4 \uC9C0\uCCE4\uB294\uB370\u2026 \uC774\uC81C \uB204\uAC00 \uBB3C\uC5B4\uBD10?"
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC0C8\uD134 \uC5B8\uB2C8\uB294 \uD750\uB984\uC744 \uC790\uAFB8 \uB04A\uC5C8\uC5B4.
        \uADFC\uB370 \uADF8\uAC8C \uC5C6\uC73C\uB2C8\uAE4C, \uAE38\uC774 \uB108\uBB34
        \uB9E4\uB044\uB7EC\uC6CC."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uC0C8\uD134\uC758 \uC758\uC2EC\uC774 \uB098\uB97C \uBA48\uCDB0 \uC138\uC6E0\uB2E4.
        \uC774\uC81C\uB294 \uB0B4\uAC00 \uC2A4\uC2A4\uB85C \uBB3C\uC5B4\uC57C \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: SPEC_LOVER_CHAIN
    ComboKey: '#4|#1|#2|#6|#7|#5'
    ParticipantIds: 040000000100000002000000060000000700000005000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751 / \uC5F0\uC778 \uC5F0\uC1C4"
    Trigger: "\uB370\uC6B0\uC2A4 \uC0AC\uB9DD \uD6C4 \uB8E8\uC774\uC2A4 \uC5F0\uC1C4
      \uBD95\uAD34"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 03000000
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 4
      Text: "\uB370\uC6B0\uC2A4\uAC00 \uC5C6\uC73C\uBA74\u2026 \uC5EC\uAE34 \uB108\uBB34
        \uC2DC\uB044\uB7FD\uACE0, \uB108\uBB34 \uBC1D\uC544."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uB8E8\uC774\uC2A4, \uC9C0\uAE08\uC740 \uC5EC\uAE30 \uC788\uC5B4\uC694.
        \uB204\uAD70\uAC00\uC758 \uBE48\uC790\uB9AC\uB97C \uB354 \uD06C\uAC8C \uB9CC\uB4E4
        \uD544\uC694\uB294 \uC5C6\uC796\uC544\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uB8E8\uC774\uC2A4\uB97C \uBD99\uC7A1\uC544. \uC9C0\uAE08 \uBB34\uB108\uC9C0\uBA74
        \uC804\uBD80 \uC783\uB294\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uB0B4\uAC00 \uACC1\uC5D0 \uC11C\uACA0\uB2E4. \uAE30\uB300\uB3C4 \uB41C\uB2E4.
        \uADF8\uB7EC\uB2C8 \uC9C0\uAE08\uC740 \uC228\uB9CC \uC26C\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uBE48\uC790\uB9AC\uB97C \uB9D0\uB85C \uBA54\uC6B8 \uC218\uB294 \uC5C6\uC5B4.
        \uADF8\uB798\uB3C4 \uB193\uC544\uBC84\uB9AC\uAC8C \uB450\uBA74 \uC548 \uB3FC."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC624\uB298\uC740 \uC7A5\uB09C\uCE58\uBA74 \uC548 \uB418\uB294 \uB0A0
        \uAC19\uC544. \uB8E8\uC774\uC2A4 \uC624\uBE60, \uB208 \uAC10\uC9C0 \uB9C8."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: SPEC_SCAPEGOAT
    ComboKey: '#2|#7|#1|#3'
    ParticipantIds: 02000000070000000100000003000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751 / \uD76C\uC0DD\uC591"
    Trigger: "\uD504\uB9AC\uB4DC\uAC00 \uB300\uC2E0 \uC0AC\uB9DD"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 06000000
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uC65C \uB610 \uB124\uAC00 \uBA3C\uC800 \uB098\uC11C. \uC774\uB7F0 \uC2DD\uC73C\uB85C
        \uAC00\uACE0 \uC2F6\uC9C4 \uC54A\uC558\uB294\uB370."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uBD10. \uACB0\uAD6D \uC120\uD0DD\uC744 \uBE7C\uC557\uACE0 \uB5A0\uB0AC\uC796\uC544.
        \uC0B4\uC544\uB0A8\uC740 \uC0AC\uB78C\uD55C\uD14C\uB294 \uBB3B\uC9C0\uB3C4
        \uC54A\uACE0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 3
      Text: "\uBA3C\uC800 \uB0B4\uBBF8\uB294 \uC190\uC774 \uC544\uB984\uB2E4\uC6CC
        \uBCF4\uC77C \uC218\uB294 \uC788\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uB0A8\uC740
        \uCABD\uC5D0\uAC90 \uC624\uB798 \uB0A8\uB294 \uC77C\uC774\uAE30\uB3C4 \uD569\uB2C8\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: SPEC_WANDERER
    ComboKey: '#7|#1|#2|#5'
    ParticipantIds: 07000000010000000200000005000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751 / \uBC30\uD68C\uC790"
    Trigger: "\uC0C8\uD134 \uC774\uB3D9 \uB4A4 \uC774\uC804 \uAD6C\uC5ED \uC0AC\uB9DD"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 07000000
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 7
      Text: "\u2026\uB610 \uB0A8\uACBC\uC5B4. \uC774\uBC88\uC5D0\uB3C4 \uB0B4\uAC00
        \uBA3C\uC800 \uC6C0\uC9C1\uC600\uAE30 \uB54C\uBB38\uC5D0."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uC0C8\uD134 \uD0D3\uB9CC\uC740 \uC544\uB2C8\uC5D0\uC694. \uD558\uC9C0\uB9CC
        \uC0C8\uD134\uC774 \uADF8 \uB9D0\uC744 \uBBFF\uC9C0 \uC54A\uC744 \uAC83\uB3C4
        \uC54C\uC544\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uC9C0\uAE08 \uD544\uC694\uD55C \uAC74 \uC774\uC720\uB97C \uCC3E\uB294
        \uAC70\uC57C. \uC5EC\uAE30\uC11C \uBA48\uCD94\uBA74 \uC0C1\uD669\uC774 \uB354
        \uB098\uBE60\uC9C8 \uC218 \uC788\uC5B4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 5
      Text: "\uC774\uC804 \uC790\uB9AC\uC5D0\uB3C4 \uB204\uAC00 \uC788\uC5C8\uAD6C\uB098\u2026
        \uC6C0\uC9C1\uC778 \uB4A4\uC758 \uB9DB\uC740 \uB298 \uB2A6\uAC8C \uC62C\uB77C\uC640."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: SPEC_MURDERER
    ComboKey: '#5|#1|#2|#7'
    ParticipantIds: 05000000010000000200000007000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751 / \uC0B4\uC778\uC790"
    Trigger: "\uD1A0\uB2C8\uC640 \uAC19\uC740 \uAD6C\uC5ED\uC5D0\uC11C \uC0AC\uB9DD
      \uBC1C\uC0DD"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 05000000
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 5
      Text: "\uC5B4\u2026 \uC65C \uC4F0\uB7EC\uC84C\uC5B4? \uBC29\uAE08\uAE4C\uC9C0
        \uAD1C\uCC2E\uC558\uC796\uC544. \uC815\uB9D0 \uC774\uC0C1\uD558\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uD1A0\uB2C8, \uBC29\uAE08 \uBB58 \uBD24\uB098\uC694? \uBAA8\uB974\uB294
        \uCC99\uD558\uAE30\uC5D4 \uB108\uBB34 \uAC00\uAE4C\uC6E0\uC5B4\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 2
      Text: "\uBAA8\uB450 \uB5A8\uC5B4\uC838. \uAC19\uC740 \uAD6C\uC5ED\uC5D0 \uC788\uB358
        \uC0AC\uB78C\uBD80\uD130 \uD655\uC778\uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uADC0\uC5EC\uC6B4 \uC5BC\uAD74 \uB4A4\uC5D0 \uC228\uC740 \uAC8C \uBB54\uC9C0
        \uC774\uC81C \uBD10\uC57C\uACA0\uB124."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
  - ComboId: SPEC_REVENGER
    ComboKey: '#2|#1|#6|#7'
    ParticipantIds: 02000000010000000600000007000000
    SituationType: "\uC0AC\uB9DD \uBC18\uC751 / \uBCF5\uC218\uC790"
    Trigger: "\uBA54\uC774\uAC00 \uC0B4\uC778\uC790\uB97C \uC751\uC9D5"
    Visibility: 
    FragmentId: 
    TriggerDeadIds: 05000000
    UnlockConditionId: 
    HintOfConditionId: 
    Lines:
    - SpeakerId: 2
      Text: "\uAC10\uC815\uC73C\uB85C \uC6C0\uC9C1\uC778 \uAC74 \uC544\uB2C8\uC57C.
        \uB354 \uBC88\uC9C0\uC9C0 \uC54A\uAC8C \uBA48\uCDB0 \uC138\uC6B4 \uAC83\uBFD0\uC774\uC57C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 1
      Text: "\uBA54\uC774\uB294 \uACB0\uAD6D \uCC45\uC784\uC744 \uBB3C\uC5C8\uAD70\uC694.
        \uBB38\uC81C\uB294 \uADF8 \uCC45\uC784\uC774 \uC5B4\uB514\uAE4C\uC9C0 \uC774\uC5B4\uC9C8\uC9C0\uC608\uC694."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 6
      Text: "\uC545\uC744 \uBA48\uCD98 \uC120\uD0DD\uC774\uB2E4. \uD558\uC9C0\uB9CC
        \uADF8 \uC120\uD0DD\uC758 \uBB34\uAC8C\uB3C4 \uB204\uAD70\uAC00\uB294 \uC9CA\uC5B4\uC838\uC57C
        \uD55C\uB2E4."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    - SpeakerId: 7
      Text: "\uB05D\uB09C \uAC78\uB85C \uBCF4\uC9C4 \uB9C8. \uD558\uB098\uAC00 \uBA48\uCDC4\uB2E4\uACE0
        \uD574\uC11C \uB0A8\uC740 \uD754\uC801\uAE4C\uC9C0 \uC0AC\uB77C\uC9C4 \uAC74
        \uC544\uB2C8\uB2C8\uAE4C."
      RevealCharacterId: -1
      RevealCharacterName: 
      IsProfileClue: 0
      ProfileClueId: 
      ProfileCategory: 
    Condition:
      RequiredFragmentId: 
      MinLoopCount: 0
