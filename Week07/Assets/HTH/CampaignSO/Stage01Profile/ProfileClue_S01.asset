    ClueText: "\uD568\uAED8\uB77C\uB294 \uB9D0\uC740 \uD3B8\uB9AC\uD574. \uBB38\uC81C\uB294
      \uADF8 \uB9D0 \uBC16\uC73C\uB85C \uBC00\uB824\uB098\uB294 \uC0AC\uB78C\uC740
      \uD56D\uC0C1 \uB2A6\uAC8C \uBCF4\uC778\uB2E4\uB294 \uAC70\uC9C0."
    ClueSpeakerId: 7
    HintText: "\uC5D4\uBE44\uC758 \uBD80\uB4DC\uB7EC\uC6B4 \uC911\uC7AC \uC55E\uC5D0\uC11C
      \uC0C8\uD134\uC740 \uACF5\uB3D9\uCCB4\uB77C\uB294 \uB9D0\uC744 \uC27D\uAC8C
      \uBBFF\uC9C0 \uC54A\uC744 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uC5D4\uBE44(#1),\uC0C8\uD134(#7) \uAC19\uC740 \uC870\uC0AC
