    DesignerNote: 
  - ProfileClueId: P03_03
    CharacterId: 3
    ClueIndex: 3
    ProfileKeyword: "\uAC10\uC815 \uD2B8\uB9AC\uAC70"
    ProfileTruth: "\uADF8\uB798\uC11C \uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C
      \uC9C0\uD0A4\uAE30 \uC704\uD574 \uD0C0\uC778\uC744 \uBC30\uC81C\uD558\uACE0
      \uAD00\uACC4\uB97C \uD1B5\uC81C\uD558\uB824 \uD55C\uB2E4."
    ClueText: "\uD070 \uB73B\uC774 \uAC00\uAE4C\uC6B4 \uC0AC\uB78C \uD558\uB098\uB97C
      \uC704\uD5D8\uD558\uAC8C \uB9CC\uB4E0\uB2E4\uBA74, \uC800\uB294 \uADF8 \uB73B\uC744
      \uB05D\uAE4C\uC9C0 \uBBFF\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
    ClueSpeakerId: 3
    HintText: "\uBA54\uC774\uC758 \uC804\uC9C4\uC740 \uB370\uC6B0\uC2A4\uC5D0\uAC8C
      \uC790\uC8FC \uC704\uD5D8 \uC2E0\uD638\uCC98\uB7FC \uB4E4\uB9B4 \uAC70\uC57C."
