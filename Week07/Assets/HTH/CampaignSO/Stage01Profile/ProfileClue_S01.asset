      / #3\uC774 #2\uC640 \uAC19\uC740 \uCE78 / #4 \uC0DD\uC874"
    ConditionType: 
    RecommendedCombo: '#2|#3'
    DesignerNote: 
  - ProfileClueId: P03_04
    CharacterId: 3
    ClueIndex: 4
    ProfileKeyword: "\uAD00\uACC4 \uC5ED\uD560"
    ProfileTruth: "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C \uBCF4\uD638\uD558\uACE0
      \uC788\uB2E4\uACE0 \uBBFF\uC9C0\uB9CC, \uC2E4\uC81C\uB85C\uB294 \uB8E8\uC774\uC2A4\uB97C
      \uACE0\uB9BD\uC2DC\uD0A4\uACE0 \uC788\uB2E4."
    ClueText: "\uACE0\uD574\uB97C \uB4E3\uB294\uB2E4\uB294 \uAC74 \uC6A9\uC11C\uAC00
      \uC544\uB2C8\uB77C, \uADF8 \uBB34\uAC8C\uB97C \uD568\uAED8 \uB4E4\uC5EC\uB2E4\uBCF4\uB294
      \uC77C\uC785\uB2C8\uB2E4."
    ClueSpeakerId: 3
    HintText: "\uC0C8\uD134\uC740 \uBB34\uAC70\uC6B4 \uB9D0\uC744 \uC544\uBB34\uC5D0\uAC8C\uB098
      \uB9E1\uAE30\uC9C0 \uC54A\uC544. \uB370\uC6B0\uC2A4\uB77C\uBA74 \uC870\uC6A9\uD788
      \uB4E4\uC5B4\uC904\uC9C0\uB3C4 \uBAB0\uB77C."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC0AC\uAC74 \uACB0\uACFC / #7\uC774
      \uC774\uB3D9\uD558\uBA70 \uC9C1\uC804 \uCE78\uC5D0\uC11C \uC0AC\uB9DD \uBC1C\uC0DD
      / \uC774\uB3D9 \uD6C4 #7\uC774 #3 \uD63C\uC790 \uC788\uB294 \uCE78\uC5D0 \uB3C4\uCC29"
    ConditionType: 
    RecommendedCombo: '#3|#7'
    DesignerNote: 
  - ProfileClueId: P03_05
    CharacterId: 3
    ClueIndex: 5
    ProfileKeyword: "\uC5ED\uD560 \uC5F0\uACB0"
    ProfileTruth: "\uB370\uC6B0\uC2A4\uB294 \uB9C8\uC655 \uD1A0\uBC8C\uC774 \uB05D\uB098\uB3C4
      \uB8E8\uC774\uC2A4\uB97C \uACC4\uC18D \uC18D\uBC15\uD558\uACE0 \uB193\uC544\uC8FC\uC9C0
      \uC54A\uC73C\uB824\uACE0 \uD55C\uB2E4."
    ClueText: "\uB0B4\uAC00 \uC0AC\uB77C\uC9C0\uBA74, \uADF8 \uC0AC\uB78C\uC758 \uC138\uACC4\uB3C4
      \uD568\uAED8 \uC228\uC744 \uC783\uC744\uAE4C \uBD10 \uB450\uB835\uC2B5\uB2C8\uB2E4."
    ClueSpeakerId: 3
    HintText: "\uB370\uC6B0\uC2A4\uAC00 \uD63C\uC790 \uC788\uC744 \uB54C\uB294, \uC5C6\uB294
      \uC0AC\uB78C\uC758 \uC228\uC18C\uB9AC\uAE4C\uC9C0 \uC138\uB294 \uAC83 \uAC19\uC544."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC120\uD0DD \uC870\uC0AC \uAD6C\uC5ED
      / #3 \uB2E8\uB3C5 / #4\uAC00 \uB2E4\uB978 \uCE78\uC5D0 \uC0DD\uC874 / \uC774\uC804
