    ConditionType: 
    RecommendedCombo: '#3'
    DesignerNote: 
  - ProfileClueId: P04_01
    CharacterId: 4
    ClueIndex: 1
    ProfileKeyword: "\uD589\uB3D9 \uC6D0\uB9AC"
    ProfileTruth: "\uB8E8\uC774\uC2A4\uB294 \uC804\uC7C1\uACFC \uBC18\uBCF5\uB41C
      \uC120\uD0DD \uC18D\uC5D0\uC11C \uC815\uC2E0\uC801\uC73C\uB85C \uC644\uC804\uD788
      \uC18C\uC9C4\uB41C \uC0C1\uD0DC\uB2E4."
    ClueText: "\uC544\uBB34 \uC77C\uB3C4 \uD558\uC9C0 \uC54A\uB294 \uC2DC\uAC04\uC774,
      \uB098\uB97C \uACA8\uC6B0 \uC228 \uC26C\uAC8C \uD574."
