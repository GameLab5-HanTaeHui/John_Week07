  - ProfileClueId: P07_05
    CharacterId: 7
    ClueIndex: 5
    ProfileKeyword: "\uD76C\uC0DD \uAD6C\uC870 \uC790\uCCB4\uC5D0 \uB300\uD55C \uBD84\uB178"
    ProfileTruth: "\uC0C8\uD134\uC740 \uACB0\uAD6D \uB204\uAD70\uAC00\uAC00 \uD76C\uC0DD\uB418\uB294
      \uAD6C\uC870 \uC790\uCCB4\uC5D0 \uBD84\uB178\uD558\uACE0 \uC758\uBB38\uC744
      \uC81C\uAE30\uD558\uB294 \uC778\uBB3C\uC774\uB2E4."
    ClueText: "\uB098\uB294 \uD55C \uC0AC\uB78C\uC5D0\uAC8C\uB9CC \uD654\uB09C \uAC8C
      \uC544\uB2C8\uC57C. \uB204\uAD70\uAC00\uB97C \uB0A8\uACA8 \uB450\uACE0\uB3C4
      \uAD6C\uC6D0\uC774\uB77C\uACE0 \uBD80\uB974\uB294 \uBC29\uC2DD\uC774 \uC2EB\uC740
      \uAC70\uC9C0."
    ClueSpeakerId: 7
    HintText: "\uB204\uAD70\uAC00\uC758 \uC8FD\uC74C \uC774\uD6C4 \uC0C8\uD134\uC744
      \uC870\uC0AC\uD558\uBA74, \uC0C8\uD134\uC758 \uBD84\uB178\uAC00 \uB204\uAD6C
      \uD55C \uBA85\uB9CC \uD5A5\uD55C \uAC83\uC774 \uC544\uB2D8\uC744 \uC54C \uC218
      \uC788\uB2E4."
    AcquireCondition: "\uC0AC\uB9DD \uC0AC\uAC74 \uC9C1\uD6C4 / \uC0C8\uD134(#7)
      \uC0DD\uC874 / \uBA54\uC774(#2) \uB610\uB294 \uD504\uB9AC\uB4DC(#6)\uAC00 \uAC19\uC740
      \uC870\uC0AC \uAD6C\uC5ED\uC5D0 \uC788\uC74C"
    ConditionType: after_death
    RecommendedCombo: '#7 alive, same_area_contains:#2_or_#6'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uC0C8\uD134\uC740 \uC5EC\uC790"
