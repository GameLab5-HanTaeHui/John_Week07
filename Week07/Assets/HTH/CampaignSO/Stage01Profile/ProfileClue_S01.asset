    ClueSpeakerId: 4
    HintText: "\uD504\uB9AC\uB4DC\uAC00 \uACC1\uC5D0 \uC788\uC73C\uBA74, \uB8E8\uC774\uC2A4\uB294
      \uB204\uAC00 \uB204\uAD6C\uB97C \uBD99\uB4E4\uACE0 \uC788\uB294\uC9C0 \uB354
