    ProfileTruth: "\uC0C8\uD134\uC740 \uB9C8\uC655\uC744 \uC4F0\uB7EC\uB728\uB9AC\uB294
      \uAC83\uBCF4\uB2E4 \uADF8 \uACFC\uC815\uC5D0\uC11C \uBC1C\uC0DD\uD558\uB294
      \uD76C\uC0DD\uC744 \uB354 \uC911\uC694\uD558\uAC8C \uBCF8\uB2E4."
    ClueText: "\uC774\uAE30\uB294 \uAC83\uBCF4\uB2E4 \uC911\uC694\uD55C \uAC74, \uC774\uAE30\uB7EC
      \uAC00\uB294 \uAE38\uC5D0 \uB204\uAC00 \uC0AC\uB77C\uC9C0\uB294\uC9C0\uC57C."
    ClueSpeakerId: 7
    HintText: "\uBA54\uC774\uC640 \uD504\uB9AC\uB4DC \uC0AC\uC774\uC5D0 \uC0C8\uD134\uC774
      \uC788\uC73C\uBA74, \uC2B9\uB9AC\uC640 \uD76C\uC0DD\uC758 \uAE30\uC900\uC774
      \uAC08\uB77C\uC9C8 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uBA54\uC774(#2),\uD504\uB9AC\uB4DC(#6),\uC0C8\uD134(#7) \uAC19\uC740
      \uC870\uC0AC \uAD6C\uC5ED / P06_01~P06_05 \uC911 1\uAC1C \uC774\uC0C1 \uD68D\uB4DD
      \uD6C4"
    ConditionType: group_contains
    RecommendedCombo: '#2|#6|#7'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uC0C8\uD134\uC740 \uC5EC\uC790"
  - ProfileClueId: P07_04
    CharacterId: 7
    ClueIndex: 4
    ProfileKeyword: "\uACF5\uB3D9\uCCB4 \uBD88\uC2E0 / \uAC70\uB9AC\uB450\uAE30"
    ProfileTruth: "\uC0C8\uD134\uC740 \uACF5\uB3D9\uCCB4\uB97C \uC644\uC804\uD788
      \uBBFF\uC9C0 \uC54A\uC73C\uBA70 \uD56D\uC0C1 \uD55C \uBC1C \uB5A8\uC5B4\uC838
