  _stageId: Stage_1_Phase2
  _clues:
  - ProfileClueId: P01_01
    CharacterId: 1
    ClueIndex: 1
    ProfileKeyword: "\uD589\uB3D9 \uC6D0\uB9AC"
    ProfileTruth: "\uC5D4\uBE44\uB294 \uC5B4\uB9B0 \uC2DC\uC808 \uC54C \uC218 \uC5C6\uB294
      \uC774\uC720\uB85C \uBD80\uBAA8\uC5D0\uAC8C\uC11C \uC720\uAE30\uB2F9\uD55C
      \uACBD\uD5D8\uC774 \uC788\uB2E4."
    ClueText: "\uB098\uB294 \uC0AC\uB78C\uBCF4\uB2E4, \uC0AC\uB78C\uACFC \uC0AC\uB78C
      \uC0AC\uC774\uC5D0 \uC0DD\uAE30\uB294 \uAC04\uACA9\uC744 \uBA3C\uC800 \uBCF4\uAC8C
      \uB3FC."
    ClueSpeakerId: 1
    HintText: "\uBA54\uC774\uC640 \uC0C8\uD134\uC774 \uAC19\uC740 \uC790\uB9AC\uC5D0
      \uC788\uC73C\uBA74, \uB9D0\uBCF4\uB2E4 \uBA3C\uC800 \uBC8C\uC5B4\uC9C0\uB294
      \uD2C8\uC774 \uBCF4\uC77C \uAC83 \uAC19\uC544."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC120\uD0DD \uC870\uC0AC \uAD6C\uC5ED
      / #1\uC774 #2,#7\uACFC \uAC19\uC740 \uCE78 / \uD574\uB2F9 \uD134 \uC0AC\uB9DD
      \uC5C6\uC74C"
    ConditionType: 
    RecommendedCombo: '#1|#2|#7'
    DesignerNote: 
  - ProfileClueId: P01_02
    CharacterId: 1
    ClueIndex: 2
    ProfileKeyword: "\uAC10\uC815 \uD2B8\uB9AC\uAC70"
    ProfileTruth: "\uC5D4\uBE44\uB294 \uD604\uC7AC \uB9C8\uC655\uC774 \uC2EC\uC5B4\uB454
      \uC2A4\uD30C\uC774\uB85C\uC11C \uC6A9\uBCD1\uB2E8\uC5D0 \uB4E4\uC5B4\uC654\uB2E4."
    ClueText: "\uB450 \uC0AC\uB78C\uC774 \uC11C\uB85C\uB97C \uB2F9\uC5F0\uD788 \uC120\uD0DD\uD558\uB294
      \uC21C\uAC04, \uB0B4 \uC790\uB9AC\uB294 \uCC98\uC74C\uBD80\uD130 \uC5C6\uC5C8\uB358
      \uAC83\uCC98\uB7FC \uB290\uAEF4\uC838."
    ClueSpeakerId: 1
    HintText: "\uB458\uC774 \uD568\uAED8 \uC788\uB294 \uACF3\uC5D0\uB294 \uC774\uC0C1\uD558\uAC8C
      \uBB38\uD131\uC774 \uC0DD\uACA8. \uB4E4\uC5B4\uAC00\uB3C4 \uC548\uCABD\uC740
      \uC544\uB2CC \uB290\uB08C\uC774\uC57C."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC120\uD0DD \uC870\uC0AC \uAD6C\uC5ED
      / #1\uC774 #3,#4\uC640 \uAC19\uC740 \uCE78 / #3,#4 \uBAA8\uB450 \uC0DD\uC874"
    ConditionType: 
    RecommendedCombo: '#1|#3|#4'
    DesignerNote: 
  - ProfileClueId: P01_03
    CharacterId: 1
    ClueIndex: 3
    ProfileKeyword: "\uC228\uACA8\uC9C4 \uC57D\uC810"
    ProfileTruth: "\uC5D4\uBE44\uB294 \uC6A9\uBCD1\uB2E8\uC758 \uAD00\uACC4\uC640
      \uC628\uAE30\uB97C \uB3D9\uACBD\uD558\uACE0 \uC788\uB2E4."
    ClueText: "\uB2E4\uC815\uD55C \uB9D0\uC740 \uBC30\uC6E0\uC9C0\uB9CC, \uB204\uAD70\uAC00\uC758
      \uC548\uCABD\uC5D0 \uBA38\uBB34\uB294 \uBC95\uC740 \uC544\uC9C1\uB3C4 \uBAA8\uB974\uACA0\uC5B4."
    ClueSpeakerId: 1
    HintText: "\uAC00\uB054\uC740 \uD63C\uC790 \uC788\uC744 \uB54C\uBCF4\uB2E4, \uB204\uAD70\uAC00\uC640
      \uD5E4\uC5B4\uC9C4 \uB4A4\uAC00 \uB354 \uC870\uC6A9\uD558\uAC8C \uB4E4\uB824."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC120\uD0DD \uC870\uC0AC \uAD6C\uC5ED
      / #1 \uB2E8\uB3C5 / \uC9C1\uC804 \uB8E8\uD504\uC5D0\uC11C #1\uC774 2\uC778
      \uC774\uC0C1 \uC870\uD569 \uB300\uC0AC \uC218\uC9D1"
    ConditionType: 
    RecommendedCombo: '#1'
    DesignerNote: 
  - ProfileClueId: P01_04
    CharacterId: 1
    ClueIndex: 4
    ProfileKeyword: "\uC695\uB9DD"
    ProfileTruth: "\uADF8\uB7EC\uB098 \uC5D4\uBE44\uB294 \uC790\uC2E0\uC774 \uADF8
      \uAD00\uACC4\uB97C \uBB34\uB108\uB728\uB9B4 \uC874\uC7AC\uB77C\uB294 \uC0AC\uC2E4\uC744
      \uC54C\uACE0 \uC788\uB2E4."
    ClueText: "\uBD80\uC218\uACE0 \uC2F6\uC5C8\uB358 \uAC8C \uC544\uB2C8\uB77C, \uB098\uB3C4
      \uADF8 \uC548\uC5D0 \uC788\uC5C8\uB2E4\uACE0 \uBBFF\uACE0 \uC2F6\uC5C8\uB358
      \uAC83\uBFD0\uC774\uC57C."
    ClueSpeakerId: 1
    HintText: "\uAC19\uC740 \uC7A5\uBA74\uC744 \uB2E4\uC2DC \uBCF4\uBA74, \uCC98\uC74C\uC5D4
      \uC548 \uBCF4\uC774\uB358 \uBE48\uC790\uB9AC\uAC00 \uBCF4\uC5EC."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC120\uD0DD \uC870\uC0AC \uAD6C\uC5ED
      / #1,#3,#4 \uAC19\uC740 \uCE78 / \uAC19\uC740 \uC870\uD569\uC744 \uB450 \uBC88\uC9F8
      \uC774\uC0C1 \uC870\uC0AC"
    ConditionType: 
    RecommendedCombo: '#1|#3|#4'
    DesignerNote: 
  - ProfileClueId: P01_05
    CharacterId: 1
    ClueIndex: 5
    ProfileKeyword: "\uC5ED\uD560 \uC5F0\uACB0"
    ProfileTruth: "\uADF8\uB798\uC11C \uC5D4\uBE44\uB294 \uC9C0\uD0A4\uACE0 \uC2F6\uC73C\uBA74\uC11C\uB3C4
      \uC2DC\uD5D8\uD558\uACE0 \uD754\uB4DC\uB294 \uBAA8\uC21C\uB41C \uD589\uB3D9\uC744
      \uBCF4\uC778\uB2E4."
    ClueText: "\uC0B4\uC544\uB0A8\uB294\uB2E4\uB294 \uAC74 \uAC00\uB054 \uC0C1\uC774
      \uC544\uB2C8\uB77C, \uB05D\uAE4C\uC9C0 \uBCF4\uB77C\uB294 \uBC8C\uCC98\uB7FC
      \uB290\uAEF4\uC838."
    ClueSpeakerId: 1
    HintText: "\uC5B4\uB5A4 \uC0AC\uB78C\uC740 \uC0AC\uB77C\uC9C0\uACE0, \uC5B4\uB5A4
      \uC0AC\uB78C\uC740 \uB0A8\uC544. \uB0A8\uC740 \uCABD\uC774 \uB354 \uAC00\uBCBC\uC6B4
      \uAC74 \uC544\uB2C8\uC57C."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC120\uD0DD \uC870\uC0AC \uAD6C\uC5ED
      / #1\uC774 \uD3EC\uD568\uB41C \uCE78\uC5D0\uC11C \uC0AC\uAC74 \uBC1C\uC0DD
      \uD6C4 #1\uB9CC \uC0DD\uC874 \uB610\uB294 #1\uC774 \uC0DD\uC874\uC790 \uC911
      \uD558\uB098"
    ConditionType: 
    RecommendedCombo: '#1|ANY'
    DesignerNote: 
  - ProfileClueId: P02_01
    CharacterId: 2
    ClueIndex: 1
    ProfileKeyword: "\uD589\uB3D9 \uC6D0\uB9AC"
    ProfileTruth: "\uBA54\uC774\uB294 \uAC00\uBB38\uC758 \uBAB0\uB77D \uC774\uD6C4,
      \uC790\uC2E0\uB9CC \uC0B4\uC544\uB0A8\uC558\uB2E4\uB294 \uC0AC\uC2E4\uC5D0
      \uC758\uBBF8\uB97C \uBD80\uC5EC\uD574\uC57C \uD55C\uB2E4\uB294 \uAC15\uBC15\uC744
      \uC9CA\uC5B4\uC84C\uB2E4."
    ClueText: "\uC5EC\uAE30\uC11C \uBA48\uCD94\uBA74, \uC9C0\uAE08\uAE4C\uC9C0 \uAC78\uC5B4\uC628
      \uAE38\uAE4C\uC9C0 \uC804\uBD80 \uD750\uB824\uC9C8 \uAC83 \uAC19\uC544."
    ClueSpeakerId: 2
    HintText: "\uBA54\uC774\uB294 \uD63C\uC790 \uC788\uC744\uC218\uB85D \uB354 \uBA40\uB9AC
      \uC788\uB294 \uB05D\uC744 \uBCF4\uB294 \uC0AC\uB78C \uAC19\uC544."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC120\uD0DD \uC870\uC0AC \uAD6C\uC5ED
      / #2 \uB2E8\uB3C5 / \uB8E8\uD504 3\uC77C\uCC28 \uC774\uD6C4"
    ConditionType: 
    RecommendedCombo: '#2'
    DesignerNote: 
  - ProfileClueId: P02_02
    CharacterId: 2
    ClueIndex: 2
    ProfileKeyword: "\uC228\uACA8\uC9C4 \uC57D\uC810"
    ProfileTruth: "\uBA54\uC774\uB294 \uB9C8\uC655\uC744 \uB2E8\uC21C\uD55C \uC801\uC774
      \uC544\uB2C8\uB77C, \uC790\uC2E0\uC758 \uC0DD\uC874\uACFC \uC0C1\uC2E4\uC744
      \uC815\uB2F9\uD654\uD574 \uC904 \uB9C8\uC9C0\uB9C9 \uACB0\uB9D0\uB85C \uBCF8\uB2E4."
    ClueText: "\uB3D9\uB8CC\uB97C \uBD99\uC7A1\uB294 \uAC74, \uC5B4\uCA4C\uBA74 \uB0B4
      \uB05D\uC744 \uB204\uAD70\uAC00 \uBD10\uC8FC\uAE38 \uBC14\uB77C\uB294 \uB9C8\uC74C\uC77C\uC9C0\uB3C4
      \uBAB0\uB77C."
    ClueSpeakerId: 2
    HintText: "\uC5D4\uBE44 \uC55E\uC5D0\uC11C\uB77C\uBA74 \uBA54\uC774\uB3C4 \uAC00\uB054
      \uCE7C\uC744 \uB0B4\uB824\uB193\uB294 \uAC83 \uAC19\uC544."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC120\uD0DD \uC870\uC0AC \uAD6C\uC5ED
      / #2\uAC00 #1\uACFC \uAC19\uC740 \uCE78 / \uD574\uB2F9 \uD134 \uC0AC\uB9DD
      \uC5C6\uC74C"
    ConditionType: 
    RecommendedCombo: '#1|#2'
    DesignerNote: 
  - ProfileClueId: P02_03
    CharacterId: 2
    ClueIndex: 3
    ProfileKeyword: "\uAC10\uC815 \uD2B8\uB9AC\uAC70"
    ProfileTruth: "\uBA54\uC774\uB294 \uB3D9\uB8CC\uB4E4\uC744 \uC18C\uC911\uD788
      \uC5EC\uAE30\uC9C0\uB9CC, \uB3D9\uC2DC\uC5D0 \uC790\uC2E0\uC774 \uBB34\uB108\uC9C0\uC9C0
      \uC54A\uB3C4\uB85D \uB05D\uAE4C\uC9C0 \uD568\uAED8 \uC11C \uC788\uC5B4\uC57C
      \uD560 \uC99D\uC778\uB4E4\uB85C \uC778\uC2DD\uD55C\uB2E4."
    ClueText: "\uBA48\uCD94\uC790\uB294 \uB9D0\uC740 \uC26C\uC790\uB294 \uB9D0\uC774
      \uC544\uB2C8\uB77C, \uB0B4\uAC00 \uBD99\uC7A1\uACE0 \uC788\uB358 \uC774\uC720\uB97C
      \uB193\uC73C\uB77C\uB294 \uB9D0\uCC98\uB7FC \uB4E4\uB824."
    ClueSpeakerId: 2
    HintText: "\uB8E8\uC774\uC2A4\uAC00 \uBA48\uCD94\uACE0 \uC2F6\uC5B4 \uD560\uC218\uB85D
      \uBA54\uC774\uB294 \uB354 \uC55E\uC73C\uB85C \uBC00\uC5B4\uBD99\uC77C \uAC70\uC57C."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC120\uD0DD \uC870\uC0AC \uAD6C\uC5ED
      / #2\uAC00 #4\uC640 \uAC19\uC740 \uCE78 / #3\uC774 \uAC19\uC740 \uCE78\uC5D0
      \uC5C6\uC74C"
    ConditionType: 
    RecommendedCombo: '#2|#4'
    DesignerNote: 
  - ProfileClueId: P02_04
    CharacterId: 2
    ClueIndex: 4
    ProfileKeyword: "\uAD00\uACC4 \uC0C1\uCC98"
    ProfileTruth: "\uBA54\uC774\uB294 \uB204\uAD70\uAC00\uAC00 \uBA48\uCD94\uAC70\uB098
      \uB5A0\uB098\uB294 \uAC83\uC744 \uAC1C\uC778\uC758 \uC120\uD0DD\uC774 \uC544\uB2C8\uB77C,
      \uC790\uC2E0\uC774 \uBD99\uC7A1\uC544 \uC628 \uC758\uBBF8\uAC00 \uBB34\uB108\uC9C0\uB294
      \uC9D5\uC870\uB85C \uBC1B\uC544\uB4E4\uC778\uB2E4."
    ClueText: "\uB204\uAD70\uAC00 \uD55C \uC0AC\uB78C\uC5D0\uAC8C\uB9CC \uAC12\uC744
      \uCE58\uB974\uAC8C \uD558\uB294 \uB05D\uC740, \uB354 \uC774\uC0C1 \uC2B9\uB9AC\uCC98\uB7FC
      \uBCF4\uC774\uC9C0 \uC54A\uC544."
    ClueSpeakerId: 2
    HintText: "\uD504\uB9AC\uB4DC\uB294 \uB298 \uBA3C\uC800 \uC11C\uB824 \uD558\uACE0,
      \uBA54\uC774\uB294 \uADF8\uB7F0 \uB4B7\uBAA8\uC2B5\uC744 \uC624\uB798 \uBCF4\uC9C0
      \uBABB\uD574."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC120\uD0DD \uC870\uC0AC \uAD6C\uC5ED
      / #2\uAC00 #6\uACFC \uAC19\uC740 \uCE78 / \uD504\uB9AC\uB4DC\uC758 \uD76C\uC0DD
      \uAC00\uB2A5 \uC0C1\uD669\uC740 \uC544\uC9C1 \uBC1C\uC0DD\uD558\uC9C0 \uC54A\uC74C"
    ConditionType: 
    RecommendedCombo: '#2|#6'
    DesignerNote: 
  - ProfileClueId: P02_05
    CharacterId: 2
    ClueIndex: 5
    ProfileKeyword: "\uC5ED\uD560 \uC5F0\uACB0"
    ProfileTruth: "\uACB0\uAD6D \uBA54\uC774\uB294 \uB3D9\uB8CC\uB97C \uC9C0\uD0A4\uB824\uB294
      \uB9C8\uC74C\uACFC \uC790\uC2E0\uC758 \uC11C\uC0AC\uB97C \uC644\uC131\uD558\uB824\uB294
      \uAC15\uBC15\uC744 \uAD6C\uBD84\uD558\uC9C0 \uBABB\uD574, \uBAA8\uB450\uB97C
      \uB05D\uAE4C\uC9C0 \uB04C\uACE0 \uAC00\uB824\uB294 \uC704\uD5D8\uC131\uC744
      \uC9C0\uB2CC\uB2E4."
    ClueText: "\uAC10\uC815\uC73C\uB85C \uD718\uB450\uB978 \uAC8C \uC544\uB2C8\uC57C.
      \uB354 \uBC88\uC9C0\uAE30 \uC804\uC5D0 \uBA48\uCDB0 \uC138\uC6B4 \uAC83\uBFD0\uC774\uC57C."
    ClueSpeakerId: 2
    HintText: "\uD1A0\uB2C8\uC640 \uBA54\uC774\uAC00 \uAC00\uAE4C\uC6CC\uC9C0\uBA74,
      \uB18D\uB2F4\uC73C\uB85C \uB118\uAE38 \uC218 \uC5C6\uB294 \uC120\uC774 \uC0DD\uAE38\uC9C0\uB3C4
      \uBAB0\uB77C."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC0AC\uAC74 \uACB0\uACFC / #2\uC640
      #5\uAC00 \uAC19\uC740 \uCE78\uC774 \uB418\uC5B4 #5 \uC0AC\uB9DD / #2 \uC0DD\uC874"
    ConditionType: 
    RecommendedCombo: '#2|#5'
    DesignerNote: 
  - ProfileClueId: P03_01
    CharacterId: 3
    ClueIndex: 1
    ProfileKeyword: "\uD589\uB3D9 \uC6D0\uB9AC"
    ProfileTruth: "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C \uC0AC\uB791\uD558\uC9C0\uB9CC,
      \uADF8 \uAC10\uC815\uC744 \uC2E0\uC131\uD55C \uC758\uBBF8\uB85C \uD3EC\uC7A5\uD558\uBA70
      \uC815\uB2F9\uD654\uD55C\uB2E4."
    ClueText: "\uC138\uC0C1\uC740 \uB113\uB2E4\uC9C0\uB9CC, \uB0B4 \uAE30\uC900\uC740
      \uC5B8\uC81C\uB098 \uD55C \uC0AC\uB78C\uC5D0\uAC8C\uB85C \uB3CC\uC544\uC635\uB2C8\uB2E4."
    ClueSpeakerId: 3
    HintText: "\uB370\uC6B0\uC2A4\uAC00 \uB9D0\uD558\uB294 \uC548\uC804\uC740 \uB298
      \uAC19\uC740 \uBC29\uD5A5\uC744 \uD5A5\uD558\uB294 \uAC83 \uAC19\uC544."
    AcquireCondition: "\uC870\uC0AC \uBAA8\uB4DC / \uC120\uD0DD \uC870\uC0AC \uAD6C\uC5ED
      / #3\uACFC #4\uAC00 \uAC19\uC740 \uCE78 / \uD574\uB2F9 \uD134 \uC0AC\uB9DD
      \uC5C6\uC74C"
    ConditionType: 
    RecommendedCombo: '#3|#4'
    DesignerNote: 
  - ProfileClueId: P03_02
    CharacterId: 3
    ClueIndex: 2
    ProfileKeyword: "\uC228\uACA8\uC9C4 \uC57D\uC810"
    ProfileTruth: "\uB370\uC6B0\uC2A4\uC5D0\uAC8C \uB8E8\uC774\uC2A4\uB294 \uC5F0\uC778\uC774\uC790
      \uC0B6\uC758 \uC758\uBBF8\uC774\uBA70 \uC720\uC77C\uD55C \uAD6C\uC6D0\uC774\uB2E4."
    ClueText: "\uC9C0\uD0A8\uB2E4\uB294 \uB9D0\uC774 \uBB38\uC774 \uB420 \uC218\uB3C4
      \uC788\uB2E4\uB294 \uAC78 \uC555\uB2C8\uB2E4. \uADF8\uB798\uB3C4 \uC190\uC7A1\uC774\uB97C
      \uB193\uAE30\uAC00 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
    ClueSpeakerId: 3
    HintText: "\uC5D4\uBE44\uB294 \uB458 \uC0AC\uC774\uC758 \uC870\uC6A9\uD55C \uBB38\uD2C8\uC744
      \uB108\uBB34 \uC798 \uBCF4\uB294 \uAC83 \uAC19\uC544."
