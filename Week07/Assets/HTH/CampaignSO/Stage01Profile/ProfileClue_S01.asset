    ClueIndex: 1
    ProfileKeyword: "\uC720\uAE30 / \uACB0\uD54D"
    ProfileTruth: "\uC5D4\uBE44\uB294 \uC5B4\uB9B0 \uC2DC\uC808 \uC54C \uC218 \uC5C6\uB294
      \uC774\uC720\uB85C \uBD80\uBAA8\uC5D0\uAC8C\uC11C \uBC84\uB824\uC84C\uB2E4."
    ClueText: "\uC5D4\uBE44\uB294 \uC5B4\uB9B0 \uC2DC\uC808 \uC54C \uC218 \uC5C6\uB294
      \uC774\uC720\uB85C \uBD80\uBAA8\uC5D0\uAC8C\uC11C \uBC84\uB824\uC84C\uB2E4."
    ClueSpeakerId: 1
    HintText: "\uC5D4\uBE44\uB294 \uC5B4\uB9B0 \uC2DC\uC808 \uBD80\uBAA8\uB2D8\uC758
      \uBC18\uB300\uC5D0\uB3C4 \uBD88\uAD6C\uD558\uACE0 \uC9D1\uC744 \uB098\uC640
      \uC5EC\uD589\uC744 \uC2DC\uC791\uD588\uB2E4."
    AcquireCondition: "\uC5D4\uBE44(#1)\uAC00 \uC870\uC0AC \uC9C0\uC815 \uAD6C\uC5ED\uC5D0
      \uD63C\uC790 \uC788\uACE0, \uBAA8\uB4E0 \uAD6C\uC5ED\uC5D0\uC11C \uC0AC\uB9DD
      \uC0AC\uAC74\uC774 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC744 \uC2DC"
    ConditionType: 
    RecommendedCombo: '#1|#2|#7'
    DesignerNote: 
  - ProfileClueId: P01_02
    CharacterId: 1
    ClueIndex: 2
    ProfileKeyword: "\uC2A4\uD30C\uC774 / \uC784\uBB34"
    ProfileTruth: "\uC5D4\uBE44\uB294 \uD604\uC7AC \uB9C8\uC655\uC774 \uC2EC\uC5B4\uB454
      \uC2A4\uD30C\uC774\uB85C\uC11C \uC6A9\uBCD1\uB2E8\uC5D0 \uB4E4\uC5B4\uC654\uB2E4."
    ClueText: "\uC5D4\uBE44\uB294 \uD604\uC7AC \uB9C8\uC655\uC774 \uC2EC\uC5B4\uB454
      \uC2A4\uD30C\uC774\uB85C\uC11C \uC6A9\uBCD1\uB2E8\uC5D0 \uB4E4\uC5B4\uC654\uB2E4."
    ClueSpeakerId: 1
    HintText: "\uC5D4\uBE44\uB294 \uC6A9\uBCD1\uB2E8\uC758 \uB3D9\uB8CC\uB4E4\uACFC
      \uB9C8\uC655\uC744 \uD1A0\uBC8C\uD558\uAE30 \uC704\uD55C \uC5EC\uC815\uC744
      \uD568\uAED8 \uD574 \uC654\uB2E4."
    AcquireCondition: "\uC5D4\uBE44(#1)\uC640 \uD1A0\uB2C8(#5), 2\uBA85\uB9CC \uC870\uC0AC
      \uC9C0\uC815 \uAD6C\uC5ED\uC5D0 \uD568\uAED8 \uC788\uACE0, \uC870\uC0AC \uC9C0\uC815
      \uAD6C\uC5ED\uC5D0\uC11C \uC544\uBB34\uB3C4 \uC0AC\uB9DD\uD558\uC9C0 \uC54A\uC558\uC744
      \uC2DC"
    ConditionType: 
    RecommendedCombo: '#1|#3|#4'
    DesignerNote: 
  - ProfileClueId: P01_03
    CharacterId: 1
    ClueIndex: 3
    ProfileKeyword: "\uAD00\uACC4\uC640 \uC628\uAE30 \uB3D9\uACBD"
    ProfileTruth: "\uC5D4\uBE44\uB294 \uC6A9\uBCD1\uB2E8 \uC0AC\uB78C\uB4E4 \uC0AC\uC774\uC758
      \uCE5C\uBC00\uD55C \uAD00\uACC4\uB97C \uB3D9\uACBD\uD558\uACE0 \uC788\uB2E4."
