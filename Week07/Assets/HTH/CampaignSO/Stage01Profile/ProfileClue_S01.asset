  m_Script: {fileID: 11500000, guid: fe03aad3cacf1a348aaa1a7af78dcac4, type: 3}
  m_Name: ProfileClue_S01
  m_EditorClassIdentifier: Assembly-CSharp::HTH.Campaign.ProfileClueDataSO
  _stageId: Stage_1_Phase2
  _clues:
  - ProfileClueId: P01_01
    CharacterId: 1
    ClueIndex: 1
    ProfileKeyword: "\uC720\uAE30 / \uACB0\uD54D"
    ProfileTruth: "\uC5D4\uBE44\uB294 \uC5B4\uB9B0 \uC2DC\uC808 \uC54C \uC218 \uC5C6\uB294
      \uC774\uC720\uB85C \uBD80\uBAA8\uC5D0\uAC8C\uC11C \uC720\uAE30\uB2F9\uD55C
      \uACBD\uD5D8\uC774 \uC788\uB2E4."
    ClueText: "\uC774\uC720\uB77C\uB3C4 \uC54C\uC558\uB2E4\uBA74 \uB35C \uC624\uB798
      \uBD99\uC7A1\uC558\uC744\uAE4C. \uBC84\uB824\uC9C4 \uC790\uB9AC\uC5D0\uB294
      \uB298 \uB2F5 \uC5C6\uB294 \uC9C8\uBB38\uB9CC \uB0A8\uB354\uB77C."
    ClueSpeakerId: 1
    HintText: "\uC5D4\uBE44\uAC00 \uD63C\uC790 \uB0A8\uC73C\uBA74, \uBC29\uAE08 \uBCF8
      \uB530\uB73B\uD55C \uAD00\uACC4\uB97C \uC624\uB798 \uACF1\uC539\uC744 \uAC83
      \uAC19\uB2E4."
    AcquireCondition: "\uC5D4\uBE44(#1) \uD63C\uC790 \uC788\uB294 \uC870\uC0AC \uAD6C\uC5ED
      / \uC9C1\uC804 \uB8E8\uD504\uC5D0\uC11C P03_02 \uB610\uB294 P04_04 \uD68D\uB4DD"
    ConditionType: solo
    RecommendedCombo: "#1 \uB2E8\uB3C5, \uB2E8 \uC9C1\uC804 \uD68D\uB4DD \uC870\uAC01\uC774
      #3|#4"
    DesignerNote: "\uC720\uB3C4 \uB300\uC0AC\uB294 \uC815\uB2F5\uC744 \uC9C1\uC811
      \uB9D0\uD558\uC9C0 \uC54A\uACE0 \uD574\uB2F9 \uC870\uAC74 \uC870\uD569\uC744
      \uB9CC\uB4E4\uAC8C \uD558\uB294 \uC6A9\uB3C4"
  - ProfileClueId: P01_02
    CharacterId: 1
    ClueIndex: 2
    ProfileKeyword: "\uC2A4\uD30C\uC774 / \uC784\uBB34"
    ProfileTruth: "\uC5D4\uBE44\uB294 \uD604\uC7AC \uB9C8\uC655\uC774 \uC2EC\uC5B4\uB454
      \uC2A4\uD30C\uC774\uB85C\uC11C \uC6A9\uBCD1\uB2E8\uC5D0 \uB4E4\uC5B4\uC654\uB2E4."
    ClueText: "\uBCF4\uACE0\uC11C\uC5D0 \uC801\uD78C \uC774\uB984\uBCF4\uB2E4, \uC2E4\uC81C\uB85C
      \uBD80\uB974\uB294 \uBAA9\uC18C\uB9AC\uAC00 \uBA3C\uC800 \uB5A0\uC624\uB974\uAE30
      \uC2DC\uC791\uD588\uC5B4."
    ClueSpeakerId: 1
    HintText: "\uD1A0\uB2C8\uB294 \uC5D4\uBE44\uC758 \uB2E4\uC815\uD568\uC774 \uB108\uBB34
      \uC798 \uB2E4\uB4EC\uC5B4\uC9C4 \uB9D0\uC774\uB77C\uACE0 \uB290\uB084\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    AcquireCondition: "\uC5D4\uBE44(#1)\uC640 \uD1A0\uB2C8(#5)\uAC00 \uAC19\uC740
      \uCE78 / \uD574\uB2F9 \uD134 \uC0AC\uB9DD \uC5C6\uC74C / P01_01 \uD68D\uB4DD
      \uD6C4"
    ConditionType: group_contains
    RecommendedCombo: "#1|#5, no_death, P01_01 \uC774\uD6C4"
    DesignerNote: "\uC720\uB3C4 \uB300\uC0AC\uB294 \uC815\uB2F5\uC744 \uC9C1\uC811
      \uB9D0\uD558\uC9C0 \uC54A\uACE0 \uD574\uB2F9 \uC870\uAC74 \uC870\uD569\uC744
      \uB9CC\uB4E4\uAC8C \uD558\uB294 \uC6A9\uB3C4"
  - ProfileClueId: P01_03
    CharacterId: 1
    ClueIndex: 3
    ProfileKeyword: "\uAD00\uACC4\uC640 \uC628\uAE30 \uB3D9\uACBD"
    ProfileTruth: "\uC5D4\uBE44\uB294 \uC6A9\uBCD1\uB2E8\uC758 \uAD00\uACC4\uC640
      \uC628\uAE30\uB97C \uB3D9\uACBD\uD558\uACE0 \uC788\uB2E4."
    ClueText: "\uB450 \uC0AC\uB78C\uC774 \uC11C\uB85C\uB97C \uCC3E\uB294 \uAC78 \uBCF4\uBA74,
      \uD6D4\uCCD0\uBCF8 \uC628\uB3C4\uB9CC\uC73C\uB85C\uB3C4 \uC190\uB05D\uC774
      \uB530\uB73B\uD574\uC9C0\uB294 \uAE30\uBD84\uC774 \uB4E4\uC5B4."
    ClueSpeakerId: 1
    HintText: "\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4 \uC0AC\uC774\uC5D0 \uC5D4\uBE44\uB97C
      \uC138\uC6B0\uBA74, \uC5D4\uBE44\uC758 \uC2DC\uC120\uC774 \uAC00\uC7A5 \uD754\uB4E4\uB9B4
      \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uC5D4\uBE44(#1),\uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4)\uAC00
      \uAC19\uC740 \uC870\uC0AC \uAD6C\uC5ED / \uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4)
      \uC0DD\uC874"
    ConditionType: group_contains
    RecommendedCombo: '#1|#3|#4'
    DesignerNote: "\uC720\uB3C4 \uB300\uC0AC\uB294 \uC815\uB2F5\uC744 \uC9C1\uC811
      \uB9D0\uD558\uC9C0 \uC54A\uACE0 \uD574\uB2F9 \uC870\uAC74 \uC870\uD569\uC744
      \uB9CC\uB4E4\uAC8C \uD558\uB294 \uC6A9\uB3C4"
  - ProfileClueId: P01_04
    CharacterId: 1
    ClueIndex: 4
    ProfileKeyword: "\uAD00\uACC4\uB97C \uBB34\uB108\uB728\uB9B4 \uC874\uC7AC\uB77C\uB294
      \uC790\uAC01"
    ProfileTruth: "\uADF8\uB7EC\uB098 \uC5D4\uBE44\uB294 \uC790\uC2E0\uC774 \uADF8
      \uAD00\uACC4\uB97C \uBB34\uB108\uB728\uB9B4 \uC874\uC7AC\uB77C\uB294 \uC0AC\uC2E4\uC744
      \uC54C\uACE0 \uC788\uB2E4."
    ClueText: "\uAC00\uAE4C\uC6CC\uC9C0\uACE0 \uC2F6\uC740 \uB9C8\uC74C\uC774 \uCEE4\uC9C8\uC218\uB85D,
      \uB098\uB294 \uC790\uAFB8 \uADF8 \uC0AC\uC774\uAC00 \uC5B4\uB514\uC11C \uBC8C\uC5B4\uC9C8\uC9C0
      \uD655\uC778\uD558\uAC8C \uB3FC."
    ClueSpeakerId: 1
    HintText: "\uBA54\uC774\uC640 \uC0C8\uD134\uC774 \uBD80\uB52A\uD788\uB294 \uC790\uB9AC\uC5D0
      \uC5D4\uBE44\uAC00 \uC788\uC73C\uBA74, \uC5D4\uBE44\uB294 \uD2C8\uC744 \uADF8\uB0E5
      \uC9C0\uB098\uCE58\uC9C0 \uC54A\uC744 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uC5D4\uBE44(#1),\uBA54\uC774(#2),\uC0C8\uD134(#7) \uAC19\uC740
      \uC870\uC0AC \uAD6C\uC5ED / P07_02 \uD68D\uB4DD \uD6C4"
    ConditionType: group_contains
    RecommendedCombo: "#1|#2|#7, P02/P07 \uAC08\uB4F1 \uC870\uAC01 \uC774\uD6C4"
    DesignerNote: "\uC720\uB3C4 \uB300\uC0AC\uB294 \uC815\uB2F5\uC744 \uC9C1\uC811
      \uB9D0\uD558\uC9C0 \uC54A\uACE0 \uD574\uB2F9 \uC870\uAC74 \uC870\uD569\uC744
      \uB9CC\uB4E4\uAC8C \uD558\uB294 \uC6A9\uB3C4"
  - ProfileClueId: P01_05
    CharacterId: 1
    ClueIndex: 5
    ProfileKeyword: "\uC9C0\uD0A4\uACE0 \uD754\uB4DC\uB294 \uC790\uAE30\uBAA8\uC21C"
    ProfileTruth: "\uADF8\uB798\uC11C \uC5D4\uBE44\uB294 \uC9C0\uD0A4\uACE0 \uC2F6\uC73C\uBA74\uC11C\uB3C4
      \uC2DC\uD5D8\uD558\uACE0 \uD754\uB4DC\uB294 \uBAA8\uC21C\uB41C \uD589\uB3D9\uC744
      \uBCF4\uC778\uB2E4."
    ClueText: "\uC9C0\uD0A4\uACE0 \uC2F6\uC740 \uB9C8\uC74C\uACFC \uD754\uB4E4\uC5B4
      \uBCF4\uACE0 \uC2F6\uC740 \uB9C8\uC74C\uC774 \uAC19\uC740 \uBC29\uD5A5\uC5D0\uC11C
      \uB098\uC640. \uADF8\uB798\uC11C \uB0B4\uAC00 \uC81C\uC77C \uBBFF\uC744 \uC218
      \uC5C6\uC5B4."
    ClueSpeakerId: 1
    HintText: "\uC5D4\uBE44\uAC00 \uAD00\uACC4\uC758 \uC911\uC2EC\uBD80\uC5D0 \uC624\uB798
      \uBA38\uBB3C\uBA74, \uC790\uC2E0\uC774 \uC6D0\uD558\uB294 \uAC83\uACFC \uD558\uB294
      \uC77C\uC774 \uC5C7\uAC08\uB9AC\uB294 \uC21C\uAC04\uC774 \uC62C \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uC5D4\uBE44(#1),\uBA54\uC774(#2),\uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4)
      \uAC19\uC740 \uC870\uC0AC \uAD6C\uC5ED / P01_01~P01_04 \uC911 3\uAC1C \uC774\uC0C1
      \uD68D\uB4DD"
    ConditionType: required_clue_count
    RecommendedCombo: "#1|#2|#3|#4, P01 3\uAC1C \uC774\uC0C1"
    DesignerNote: "\uC720\uB3C4 \uB300\uC0AC\uB294 \uC815\uB2F5\uC744 \uC9C1\uC811
      \uB9D0\uD558\uC9C0 \uC54A\uACE0 \uD574\uB2F9 \uC870\uAC74 \uC870\uD569\uC744
      \uB9CC\uB4E4\uAC8C \uD558\uB294 \uC6A9\uB3C4"
  - ProfileClueId: P02_01
    CharacterId: 2
    ClueIndex: 1
    ProfileKeyword: "\uC0DD\uC874\uC790 \uAC15\uBC15"
    ProfileTruth: "\uBA54\uC774\uB294 \uAC00\uBB38\uC758 \uBAB0\uB77D \uC774\uD6C4,
      \uC790\uC2E0\uB9CC \uC0B4\uC544\uB0A8\uC558\uB2E4\uB294 \uC0AC\uC2E4\uC5D0
      \uC758\uBBF8\uB97C \uBD80\uC5EC\uD574\uC57C \uD55C\uB2E4\uB294 \uAC15\uBC15\uC744
      \uC9CA\uC5B4\uC84C\uB2E4."
    ClueText: "\uB0B4\uAC00 \uC0B4\uC544\uB0A8\uC740 \uC774\uC720\uAC00 \uC5C6\uB2E4\uBA74,
      \uB0A8\uACA8\uC9C4 \uC774\uB984\uB3C4 \uACB0\uAD6D \uB3CC\uBB34\uB354\uAE30\uC640
      \uB2E4\uB974\uC9C0 \uC54A\uC544."
    ClueSpeakerId: 2
    HintText: "\uBA54\uC774\uAC00 \uD63C\uC790 \uB0A8\uC73C\uBA74, \uC804\uD22C\uBCF4\uB2E4
      \uB354 \uC624\uB798 \uBD99\uC7A1\uACE0 \uC788\uB294 \uC774\uC720\uB97C \uB9D0\uD560\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    AcquireCondition: "\uBA54\uC774(#2) \uD63C\uC790 \uC788\uB294 \uC870\uC0AC \uAD6C\uC5ED
      / \uC9C1\uC804 \uD134\uC5D0 \uC0AC\uB9DD \uC0AC\uAC74 \uBC1C\uC0DD"
    ConditionType: after_death
    RecommendedCombo: "#2 \uB2E8\uB3C5, previous_turn_death"
    DesignerNote: "\uBA54\uC774\uC758 \uD575\uC2EC\uC740 \uAD8C\uB825\uC695\uC774
      \uC544\uB2C8\uB77C \uC0DD\uC874\uACFC \uC0C1\uC2E4\uC5D0 \uC758\uBBF8\uB97C
      \uBD80\uC5EC\uD558\uB824\uB294 \uAC15\uBC15"
  - ProfileClueId: P02_02
    CharacterId: 2
    ClueIndex: 2
    ProfileKeyword: "\uB9C8\uC655 = \uB9C8\uC9C0\uB9C9 \uACB0\uB9D0"
    ProfileTruth: "\uBA54\uC774\uB294 \uB9C8\uC655\uC744 \uB2E8\uC21C\uD55C \uC801\uC774
      \uC544\uB2C8\uB77C, \uC790\uC2E0\uC758 \uC0DD\uC874\uACFC \uC0C1\uC2E4\uC744
      \uC815\uB2F9\uD654\uD574 \uC904 \uB9C8\uC9C0\uB9C9 \uACB0\uB9D0\uB85C \uBCF8\uB2E4."
    ClueText: "\uB9C8\uC9C0\uB9C9 \uC801\uC774 \uC0AC\uB77C\uC838\uC57C, \uB0B4\uAC00
      \uBC84\uD168 \uC628 \uC2DC\uAC04\uB3C4 \uACA8\uC6B0 \uD55C \uBB38\uC7A5\uC73C\uB85C
      \uB05D\uB9FA\uC744 \uC218 \uC788\uC5B4."
    ClueSpeakerId: 2
    HintText: "\uD1A0\uB2C8\uB294 \uBA54\uC774\uAC00 \uB05D\uC774\uB77C\uB294 \uB9D0\uC5D0
      \uC5BC\uB9C8\uB098 \uC27D\uAC8C \uB2EC\uC544\uC624\uB974\uB294\uC9C0 \uBCFC
      \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uBA54\uC774(#2),\uD1A0\uB2C8(#5) \uAC19\uC740 \uC870\uC0AC
      \uAD6C\uC5ED / DL_C024_03 \uB610\uB294 DL_C084_03 \uD68D\uB4DD \uD6C4 \u203B\uD574\uB2F9
      \uB300\uC0AC\uB294 ProfileClueID\uAC00 \uC5C6\uC5B4 DialogueID\uB85C \uD45C\uAE30"
    ConditionType: group_contains
    RecommendedCombo: '#2|#5'
    DesignerNote: "\uBA54\uC774\uC758 \uACB0\uB9D0 \uAC15\uBC15\uC744 \uD1A0\uB2C8\uAC00
      \uC790\uADF9\uD558\uB294 \uAD6C\uC870"
  - ProfileClueId: P02_03
    CharacterId: 2
    ClueIndex: 3
    ProfileKeyword: "\uB3D9\uB8CC = \uC99D\uC778"
    ProfileTruth: "\uBA54\uC774\uB294 \uB3D9\uB8CC\uB4E4\uC744 \uC18C\uC911\uD788
      \uC5EC\uAE30\uC9C0\uB9CC, \uB3D9\uC2DC\uC5D0 \uC790\uC2E0\uC774 \uBB34\uB108\uC9C0\uC9C0
      \uC54A\uB3C4\uB85D \uB05D\uAE4C\uC9C0 \uD568\uAED8 \uC11C \uC788\uC5B4\uC57C
      \uD560 \uC99D\uC778\uB4E4\uB85C \uC778\uC2DD\uD55C\uB2E4."
    ClueText: "\uD568\uAED8 \uC11C \uC788\uC5B4 \uC918. \uB108\uD76C\uAC00 \uC0AC\uB77C\uC9C0\uBA74
      \uB0B4\uAC00 \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uC774\uC720\uB3C4 \uD568\uAED8
      \uD750\uB824\uC9C8 \uAC83 \uAC19\uC544."
    ClueSpeakerId: 2
    HintText: "\uBA48\uCD94\uACE0 \uC2F6\uC740 \uB8E8\uC774\uC2A4 \uC55E\uC5D0\uC11C
      \uBA54\uC774\uB294 \uB3D9\uB8CC\uB97C \uC5B4\uB5BB\uAC8C \uBD99\uC7A1\uB294\uC9C0
      \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uC5D4\uBE44(#1),\uBA54\uC774(#2),\uB8E8\uC774\uC2A4(#4) \uAC19\uC740
      \uC870\uC0AC \uAD6C\uC5ED / DL_C023_03 \uD68D\uB4DD \uD6C4 \u203B\uD574\uB2F9
      \uB300\uC0AC\uB294 ProfileClueID\uAC00 \uC5C6\uC5B4 DialogueID\uB85C \uD45C\uAE30"
    ConditionType: group_contains
    RecommendedCombo: '#1|#2|#4'
    DesignerNote: "\uB3D9\uB8CC\uB97C \uC218\uB2E8\uC73C\uB85C \uBCF4\uB294 \uAC83\uC774
      \uC544\uB2C8\uB77C, \uC790\uC2E0\uC758 \uC758\uBBF8\uAC00 \uBB34\uB108\uC9C0\uC9C0
      \uC54A\uAC8C \uD558\uB294 \uC99D\uC778\uC73C\uB85C \uBD99\uC7A1\uB294\uB2E4\uB294
      \uC810\uC744 \uAC15\uC870"
  - ProfileClueId: P02_04
    CharacterId: 2
    ClueIndex: 4
    ProfileKeyword: "\uBA48\uCDA4 = \uC758\uBBF8 \uBD95\uAD34"
    ProfileTruth: "\uBA54\uC774\uB294 \uB204\uAD70\uAC00\uAC00 \uBA48\uCD94\uAC70\uB098
      \uB5A0\uB098\uB294 \uAC83\uC744 \uAC1C\uC778\uC758 \uC120\uD0DD\uC774 \uC544\uB2C8\uB77C,
      \uC790\uC2E0\uC774 \uBD99\uC7A1\uC544 \uC628 \uC758\uBBF8\uAC00 \uBB34\uB108\uC9C0\uB294
      \uC9D5\uC870\uB85C \uBC1B\uC544\uB4E4\uC778\uB2E4."
    ClueText: "\uBA48\uCD94\uACE0 \uC2F6\uB2E4\uB294 \uB9D0\uC774 \uB54C\uB85C\uB294,
      \uB0B4\uAC00 \uBD99\uC7A1\uC544 \uC628 \uBAA8\uB4E0 \uAC8C \uD5DB\uB418\uB2E4\uB294
      \uB9D0\uCC98\uB7FC \uB4E4\uB824."
    ClueSpeakerId: 2
    HintText: "\uBA54\uC774\uC640 \uB8E8\uC774\uC2A4\uB97C \uB458\uB9CC \uB450\uBA74,
      \uC804\uC9C4\uACFC \uC815\uC9C0\uAC00 \uAC00\uC7A5 \uC9C1\uC811\uC801\uC73C\uB85C
      \uBD80\uB52A\uD790 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uBA54\uC774(#2),\uB8E8\uC774\uC2A4(#4) \uAC19\uC740 \uC870\uC0AC
      \uAD6C\uC5ED / \uB8E8\uC774\uC2A4(#4) \uC0DD\uC874 / \uD574\uB2F9 \uD134 \uC0AC\uB9DD
      \uC5C6\uC74C"
    ConditionType: group_contains
    RecommendedCombo: '#2|#4'
    DesignerNote: "\uC0AC\uBA85 \uC774\uD0C8\uBCF4\uB2E4 \uB0B4\uBA74\uC758 \uC758\uBBF8
      \uBD95\uAD34 \uACF5\uD3EC\uC5D0 \uCD08\uC810"
  - ProfileClueId: P02_05
    CharacterId: 2
    ClueIndex: 5
    ProfileKeyword: "\uBAA8\uB450\uB97C \uB04C\uACE0 \uAC00\uB294 \uC704\uD5D8\uC131"
    ProfileTruth: "\uACB0\uAD6D \uBA54\uC774\uB294 \uB3D9\uB8CC\uB97C \uC9C0\uD0A4\uB824\uB294
      \uB9C8\uC74C\uACFC \uC790\uC2E0\uC758 \uC11C\uC0AC\uB97C \uC644\uC131\uD558\uB824\uB294
      \uAC15\uBC15\uC744 \uAD6C\uBD84\uD558\uC9C0 \uBABB\uD574, \uBAA8\uB450\uB97C
      \uB05D\uAE4C\uC9C0 \uB04C\uACE0 \uAC00\uB824\uB294 \uC704\uD5D8\uC131\uC744
      \uC9C0\uB2CC\uB2E4."
    ClueText: "\uB0B4\uAC00 \uC55E\uC5D0\uC11C \uB04C\uC9C0 \uC54A\uC73C\uBA74 \uBAA8\uB450
      \uD769\uC5B4\uC9C8 \uAC83 \uAC19\uC544. \uADF8\uAC8C \uB450\uB824\uC6CC\uC11C
      \uB354 \uBE60\uB974\uAC8C \uAC77\uB294\uB2E4."
    ClueSpeakerId: 2
    HintText: "\uD504\uB9AC\uB4DC\uC640 \uC0C8\uD134\uC774 \uB3D9\uC2DC\uC5D0 \uC788\uC73C\uBA74,
      \uBA54\uC774\uC758 \uC804\uC9C4\uC774 \uCC45\uC784\uC778\uC9C0 \uAC15\uC694\uC778\uC9C0
      \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uBA54\uC774(#2),\uD504\uB9AC\uB4DC(#6),\uC0C8\uD134(#7) \uAC19\uC740
      \uC870\uC0AC \uAD6C\uC5ED / \uD504\uB9AC\uB4DC(#6),\uC0C8\uD134(#7) \uC0DD\uC874"
    ConditionType: group_contains
    RecommendedCombo: '#2|#6|#7'
    DesignerNote: "\uC545\uC758\uAC00 \uC544\uB2CC \uD655\uC2E0\uC5D0\uC11C \uBE44\uB86F\uB41C
      \uC704\uD5D8\uC131"
  - ProfileClueId: P03_01
    CharacterId: 3
    ClueIndex: 1
    ProfileKeyword: "\uC0AC\uB791\uC758 \uC2E0\uC131\uD654"
    ProfileTruth: "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C \uC0AC\uB791\uD558\uC9C0\uB9CC,
      \uADF8 \uAC10\uC815\uC744 \uC2E0\uC131\uD55C \uC758\uBBF8\uB85C \uD3EC\uC7A5\uD558\uBA70
      \uC815\uB2F9\uD654\uD55C\uB2E4."
    ClueText: "\uC774 \uB9C8\uC74C\uC774 \uC695\uB9DD\uC774\uB77C\uBA74 \uACAC\uB51C
      \uC218 \uC5C6\uC5C8\uACA0\uC9C0. \uADF8\uB798\uC11C \uB098\uB294 \uADF8\uAC83\uC744
      \uAE30\uB3C4\uC758 \uC774\uB984\uC73C\uB85C \uBD88\uB800\uB2E4."
    ClueSpeakerId: 3
    HintText: "\uB8E8\uC774\uC2A4\uC640 \uB5A8\uC5B4\uC9C4 \uB370\uC6B0\uC2A4\uB294
      \uC790\uC2E0\uC758 \uB9C8\uC74C\uC5D0 \uBD99\uC778 \uC774\uB984\uC744 \uACE0\uBC31\uD560\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    AcquireCondition: "\uB370\uC6B0\uC2A4(#3) \uD63C\uC790 \uC788\uB294 \uC870\uC0AC
      \uAD6C\uC5ED / P03_02 \uB610\uB294 P04_04 \uD68D\uB4DD \uD6C4"
    ConditionType: solo
    RecommendedCombo: "#3 \uB2E8\uB3C5, P03/P04 \uAD00\uACC4 \uC870\uAC01 \uC774\uD6C4"
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uB370\uC6B0\uC2A4\uB294 \uC5EC\uC790"
  - ProfileClueId: P03_02
    CharacterId: 3
    ClueIndex: 2
    ProfileKeyword: "\uB8E8\uC774\uC2A4 = \uC0B6\uC758 \uC758\uBBF8 / \uAD6C\uC6D0"
    ProfileTruth: "\uB370\uC6B0\uC2A4\uC5D0\uAC8C \uB8E8\uC774\uC2A4\uB294 \uC5F0\uC778\uC774\uC790
      \uC0B6\uC758 \uC758\uBBF8\uC774\uBA70 \uC720\uC77C\uD55C \uAD6C\uC6D0\uC774\uB2E4."
    ClueText: "\uB8E8\uC774\uC2A4\uAC00 \uB0B4 \uACC1\uC5D0 \uC788\uC744 \uB54C\uB9CC,
      \uC138\uC0C1\uC774 \uC544\uC9C1 \uBB34\uB108\uC9C8 \uC218 \uC5C6\uB2E4\uB294
      \uC0DD\uAC01\uC774 \uB4ED\uB2C8\uB2E4."
    ClueSpeakerId: 3
    HintText: "\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4\uB9CC \uB0A8\uAE30\uBA74,
      \uB458 \uC0AC\uC774\uAC00 \uC5BC\uB9C8\uB098 \uB2EB\uD78C \uC138\uACC4\uC778\uC9C0
      \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4)\uB9CC \uAC19\uC740
      \uC870\uC0AC \uAD6C\uC5ED / \uD574\uB2F9 \uAD6C\uC5ED\uC5D0 \uB2E4\uB978 \uC778\uBB3C
      \uC5C6\uC74C"
    ConditionType: exact_group
    RecommendedCombo: '#3|#4 exact only'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uB370\uC6B0\uC2A4\uB294 \uC5EC\uC790"
  - ProfileClueId: P03_03
    CharacterId: 3
    ClueIndex: 3
    ProfileKeyword: "\uD0C0\uC778 \uBC30\uC81C / \uAD00\uACC4 \uD1B5\uC81C"
    ProfileTruth: "\uADF8\uB798\uC11C \uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C
      \uC9C0\uD0A4\uAE30 \uC704\uD574 \uD0C0\uC778\uC744 \uBC30\uC81C\uD558\uACE0
      \uAD00\uACC4\uB97C \uD1B5\uC81C\uD558\uB824 \uD55C\uB2E4."
    ClueText: "\uC88B\uC740 \uC0AC\uB78C\uC774\uB77C \uD574\uB3C4, \uB8E8\uC774\uC2A4\uC5D0\uAC8C
      \uB108\uBB34 \uAC00\uAE4C\uC6CC\uC9C0\uB294 \uAC74 \uD5C8\uB77D\uD560 \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4."
    ClueSpeakerId: 3
    HintText: "\uC5D4\uBE44\uAC00 \uB8E8\uC774\uC2A4\uC5D0\uAC8C \uD3B8\uD558\uAC8C
      \uB2E4\uAC00\uAC00\uBA74, \uB370\uC6B0\uC2A4\uC758 \uACBD\uACC4\uAC00 \uAC00\uC7A5
      \uC120\uBA85\uD574\uC9C8 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uC5D4\uBE44(#1),\uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4)
      \uAC19\uC740 \uC870\uC0AC \uAD6C\uC5ED / P01_01~P01_05 \uC911 1\uAC1C \uC774\uC0C1
      \uD68D\uB4DD"
    ConditionType: group_contains
    RecommendedCombo: '#1|#3|#4'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uB370\uC6B0\uC2A4\uB294 \uC5EC\uC790"
  - ProfileClueId: P03_04
    CharacterId: 3
    ClueIndex: 4
    ProfileKeyword: "\uBCF4\uD638\uB77C\uB294 \uC774\uB984\uC758 \uACE0\uB9BD"
    ProfileTruth: "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C \uBCF4\uD638\uD558\uACE0
      \uC788\uB2E4\uACE0 \uBBFF\uC9C0\uB9CC, \uC2E4\uC81C\uB85C\uB294 \uB8E8\uC774\uC2A4\uB97C
      \uACE0\uB9BD\uC2DC\uD0A4\uACE0 \uC788\uB2E4."
    ClueText: "\uBC16\uC774 \uC704\uD5D8\uD558\uB2E4\uBA74, \uBB38\uC744 \uB2EB\uB294
      \uAC83\uC774 \uBCF4\uD638\uAC00 \uC544\uB2C8\uACE0 \uBB34\uC5C7\uC785\uB2C8\uAE4C."
    ClueSpeakerId: 3
    HintText: "\uC0C8\uD134\uC740 \uB370\uC6B0\uC2A4\uC5D0\uAC8C \uBCF4\uD638\uC640
      \uAC10\uAE08\uC758 \uACBD\uACC4\uB97C \uC9C1\uC811 \uBB3C\uC744 \uC218 \uC788\uC744
      \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uB370\uC6B0\uC2A4(#3),\uC0C8\uD134(#7) \uAC19\uC740 \uC870\uC0AC
      \uAD6C\uC5ED / P07_05 \uD68D\uB4DD \uD6C4"
    ConditionType: group_contains
    RecommendedCombo: '#3|#7'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uB370\uC6B0\uC2A4\uB294 \uC5EC\uC790"
  - ProfileClueId: P03_05
    CharacterId: 3
    ClueIndex: 5
    ProfileKeyword: "\uD1A0\uBC8C \uC774\uD6C4\uC758 \uC18D\uBC15"
    ProfileTruth: "\uB370\uC6B0\uC2A4\uB294 \uB9C8\uC655 \uD1A0\uBC8C\uC774 \uB05D\uB098\uB3C4
      \uB8E8\uC774\uC2A4\uB97C \uACC4\uC18D \uC18D\uBC15\uD558\uACE0 \uB193\uC544\uC8FC\uC9C0
      \uC54A\uC73C\uB824\uACE0 \uD55C\uB2E4."
    ClueText: "\uC2F8\uC6C0\uC774 \uB05D\uB098\uB3C4 \uBB38\uC744 \uC5F4 \uD544\uC694\uB294
      \uC5C6\uC2B5\uB2C8\uB2E4. \uD3C9\uC628\uC740 \uB2EB\uD78C \uBC29 \uC548\uC5D0\uC11C\uB3C4
      \uC9C0\uD0AC \uC218 \uC788\uC73C\uB2C8\uAE4C\uC694."
    ClueSpeakerId: 3
    HintText: "\uB9C8\uC655 \uD1A0\uBC8C \uC774\uD6C4\uB97C \uB9D0\uD558\uAC8C \uD558\uBA74,
      \uB370\uC6B0\uC2A4\uAC00 \uC815\uB9D0 \uB8E8\uC774\uC2A4\uB97C \uB193\uC544\uC904
      \uC218 \uC788\uB294\uC9C0 \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uB370\uC6B0\uC2A4(#3)\uAC00 \uB8E8\uC774\uC2A4(#4)\uC640
      \uAC19\uC740 \uAD6C\uC5ED\uC5D0 \uC788\uC74C / P03_01~P03_04 \uBC0F P04_01~P04_04
      \uC911 3\uAC1C \uC774\uC0C1 \uD68D\uB4DD"
    ConditionType: required_clue_count
    RecommendedCombo: "#3|#4, P03/P04 \uAD00\uACC4 \uC870\uAC01 3\uAC1C \uC774\uC0C1"
    DesignerNote: "\uAE30\uC874 \uB8E8\uC774\uC2A4 \uC0AC\uB9DD \uC870\uAC74 \uB300\uC2E0
      \uCD5C\uC885 \uD504\uB85C\uD30C\uC77C\uC758 \u2018\uD1A0\uBC8C \uC774\uD6C4\uC5D0\uB3C4
      \uC18D\uBC15\u2019 \uD56D\uBAA9\uC5D0 \uB9DE\uCDA4"
  - ProfileClueId: P04_01
    CharacterId: 4
    ClueIndex: 1
    ProfileKeyword: "\uC815\uC2E0\uC801 \uC18C\uC9C4"
    ProfileTruth: "\uB8E8\uC774\uC2A4\uB294 \uC804\uC7C1\uACFC \uBC18\uBCF5\uB41C
      \uC120\uD0DD \uC18D\uC5D0\uC11C \uC815\uC2E0\uC801\uC73C\uB85C \uC644\uC804\uD788
      \uC18C\uC9C4\uB41C \uC0C1\uD0DC\uB2E4."
    ClueText: "\uC120\uD0DD\uD574\uC57C \uD558\uB294 \uB0A0\uC774 \uB108\uBB34 \uB9CE\uC558\uC5B4.
      \uC774\uC81C\uB294 \uC544\uBB34\uAC83\uB3C4 \uACE0\uB974\uC9C0 \uC54A\uB294
      \uC2DC\uAC04\uC774 \uD544\uC694\uD574."
    ClueSpeakerId: 4
    HintText: "\uB8E8\uC774\uC2A4\uB294 \uD63C\uC790 \uC788\uC744 \uB54C \uAC00\uC7A5
      \uC870\uC6A9\uD558\uC9C0\uB9CC, \uADF8 \uCE68\uBB35\uC774 \uBE44\uC5B4 \uC788\uB294
      \uAC74 \uC544\uB2D0 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uB8E8\uC774\uC2A4(#4) \uD63C\uC790 \uC788\uB294 \uC870\uC0AC
      \uAD6C\uC5ED / minLoopCount 2 \uC774\uC0C1"
    ConditionType: solo
    RecommendedCombo: "#4 \uB2E8\uB3C5, loop>=2"
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uB8E8\uC774\uC2A4\uB294 \uB0A8\uC790"
  - ProfileClueId: P04_02
    CharacterId: 4
    ClueIndex: 2
    ProfileKeyword: "\uC778\uC9C0\uD558\uC9C0\uB9CC \uAC1C\uC785\uD558\uC9C0 \uC54A\uC74C"
    ProfileTruth: "\uB8E8\uC774\uC2A4\uB294 \uB300\uBD80\uBD84\uC758 \uC0C1\uD669\uC744
      \uC778\uC9C0\uD558\uACE0 \uC788\uC9C0\uB9CC \uC758\uB3C4\uC801\uC73C\uB85C
      \uAC1C\uC785\uD558\uC9C0 \uC54A\uB294\uB2E4."
    ClueText: "\uB2E4 \uB4E4\uB824. \uB204\uAC00 \uB9DE\uB294\uC9C0\uB3C4 \uC870\uAE08\uC740
      \uC54C\uC544. \uADF8\uB7F0\uB370 \uB07C\uC5B4\uB4E4 \uD798\uC774 \uC5C6\uC5B4."
    ClueSpeakerId: 4
    HintText: "\uBA54\uC774\uC640 \uC0C8\uD134\uC774 \uBD80\uB52A\uD788\uB294 \uC790\uB9AC\uC5D0
      \uB8E8\uC774\uC2A4\uAC00 \uC788\uC73C\uBA74, \uB8E8\uC774\uC2A4\uAC00 \uCE68\uBB35\uD558\uB294
      \uC774\uC720\uAC00 \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uBA54\uC774(#2),\uB8E8\uC774\uC2A4(#4),\uC0C8\uD134(#7) \uAC19\uC740
      \uC870\uC0AC \uAD6C\uC5ED / P07_02 \uD68D\uB4DD \uD6C4"
    ConditionType: group_contains
    RecommendedCombo: '#2|#4|#7'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uB8E8\uC774\uC2A4\uB294 \uB0A8\uC790"
  - ProfileClueId: P04_03
    CharacterId: 4
    ClueIndex: 3
    ProfileKeyword: "\uD604\uC7AC \uC548\uC815\uC5D0 \uBA38\uBB34\uB974\uB824 \uD568"
    ProfileTruth: "\uB8E8\uC774\uC2A4\uB294 \uAC08\uB4F1\uACFC \uC120\uD0DD\uC744
      \uD53C\uD558\uACE0 \uD604\uC7AC\uC758 \uC548\uC815\uB41C \uC0C1\uD0DC\uC5D0
      \uBA38\uBB34\uB974\uB824 \uD55C\uB2E4."
    ClueText: "\uC55E\uC73C\uB85C \uAC00\uC790\uB294 \uB9D0\uBCF4\uB2E4, \uC624\uB298
      \uC544\uBB34 \uC77C\uB3C4 \uC5C6\uC5C8\uB2E4\uB294 \uB9D0\uC774 \uB354 \uAC04\uC808\uD574."
    ClueSpeakerId: 4
    HintText: "\uBA54\uC774\uC758 \uC804\uC9C4 \uC55E\uC5D0 \uB8E8\uC774\uC2A4\uB97C
      \uC138\uC6B0\uBA74, \uB8E8\uC774\uC2A4\uAC00 \uC6D0\uD558\uB294 \uAC83\uC774
      \uBB34\uC5C7\uC778\uC9C0 \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uBA54\uC774(#2),\uB8E8\uC774\uC2A4(#4) \uAC19\uC740 \uC870\uC0AC
      \uAD6C\uC5ED / \uD574\uB2F9 \uD134 \uC0AC\uB9DD \uC5C6\uC74C"
    ConditionType: group_contains
    RecommendedCombo: '#2|#4, no_death'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uB8E8\uC774\uC2A4\uB294 \uB0A8\uC790"
  - ProfileClueId: P04_04
    CharacterId: 4
    ClueIndex: 4
    ProfileKeyword: "\uB370\uC6B0\uC2A4 = \uBD88\uC548\uC815\uD55C \uBC84\uD300\uBAA9"
    ProfileTruth: "\uB8E8\uC774\uC2A4\uC5D0\uAC8C \uB370\uC6B0\uC2A4\uB294 \uC0AC\uB791\uC774\uBA74\uC11C
      \uB3D9\uC2DC\uC5D0 \uD604\uC2E4\uC744 \uD68C\uD53C\uD560 \uC218 \uC788\uAC8C
      \uD574\uC8FC\uB294 \uBD88\uC548\uC815\uD55C \uBC84\uD300\uBAA9\uC774\uB2E4."
    ClueText: "\uB370\uC6B0\uC2A4\uAC00 \uACC1\uC5D0 \uC788\uC73C\uBA74 \uD604\uC2E4\uC774
      \uC870\uAE08 \uBA40\uC5B4\uC838. \uADF8\uAC8C \uD3B8\uD574\uC11C, \uBB34\uC11C\uC6CC."
    ClueSpeakerId: 4
    HintText: "\uB370\uC6B0\uC2A4\uC640 \uB8E8\uC774\uC2A4\uB97C \uB458\uB9CC \uB0A8\uAE30\uBA74,
      \uB8E8\uC774\uC2A4\uAC00 \uBB34\uC5C7\uC5D0 \uAE30\uB300\uB294\uC9C0 \uAC00\uC7A5
      \uC798 \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uB370\uC6B0\uC2A4(#3),\uB8E8\uC774\uC2A4(#4)\uB9CC \uAC19\uC740
      \uC870\uC0AC \uAD6C\uC5ED / P03_01~P03_05 \uC911 1\uAC1C \uC774\uC0C1 \uD68D\uB4DD"
    ConditionType: exact_group
    RecommendedCombo: '#3|#4 exact only'
    DesignerNote: "\uC548\uC804\uC7A5\uCE58\uBCF4\uB2E4 \uBD88\uC548\uC815\uD55C
      \uBC84\uD300\uBAA9\uC73C\uB85C \uD45C\uD604 \uC870\uC815"
  - ProfileClueId: P04_05
    CharacterId: 4
    ClueIndex: 5
    ProfileKeyword: "\uAE30\uB300\uC5B4 \uBC84\uD2F0\uB294 \uC120\uD0DD"
    ProfileTruth: "\uB8E8\uC774\uC2A4\uB294 \uACB0\uAD6D \uC2A4\uC2A4\uB85C \uC0B4\uC544\uAC00\uB824
      \uD558\uAE30\uBCF4\uB2E4 \uB204\uAD70\uAC00\uC5D0\uAC8C \uAE30\uB300\uC5B4
      \uBC84\uD2F0\uB294 \uC120\uD0DD\uC744 \uD558\uACE0 \uC788\uB2E4."
    ClueText: "\uD63C\uC790 \uC124 \uC218 \uC788\uB2E4\uBA74 \uC88B\uC558\uACA0\uC9C0.
      \uADF8\uB7F0\uB370 \uB098\uB294 \uC774\uBBF8 \uAE30\uB300\uB294 \uBC95\uBD80\uD130
      \uBC30\uC6CC \uBC84\uB838\uC5B4."
    ClueSpeakerId: 4
    HintText: "\uB370\uC6B0\uC2A4\uAC00 \uC0AC\uB77C\uC9C4 \uC9C1\uD6C4 \uB8E8\uC774\uC2A4\uB97C
      \uC870\uC0AC\uD558\uBA74, \uB8E8\uC774\uC2A4\uC758 \uBC84\uD300\uBAA9\uC774
      \uBB34\uC5C7\uC774\uC5C8\uB294\uC9C0 \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uB370\uC6B0\uC2A4(#3) \uC0AC\uB9DD \uC9C1\uD6C4 / \uB8E8\uC774\uC2A4(#4)
      \uC5F0\uC1C4 \uC0AC\uB9DD \uCC98\uB9AC \uC804 \uC720\uC608 \uD0C0\uC774\uBC0D
      \uB610\uB294 \uB8E8\uC774\uC2A4(#4) \uC2DC\uC810 \uD68C\uC0C1 \uC870\uAC01"
    ConditionType: after_death_or_memory
    RecommendedCombo: "dead:#3, pending:#4 \uB610\uB294 memory:#4"
    DesignerNote: "\uC989\uC2DC \uC0AC\uB9DD \uCC98\uB9AC \uAD6C\uC870\uB77C\uBA74
      \uD68C\uC0C1 \uC870\uAC01\uC73C\uB85C \uCD9C\uB825"
  - ProfileClueId: P05_01
    CharacterId: 5
    ClueIndex: 1
    ProfileKeyword: "\uB9C8\uC655\uC131 \uC8FC\uBC29 / \uAE08\uAE30 \uC694\uB9AC"
    ProfileTruth: "\uD1A0\uB2C8\uB294 \uACFC\uAC70 \uB9C8\uC655\uC131\uC758 \uC8FC\uBC29\uC5D0\uC11C
      \uC77C\uD588\uC73C\uBA70, \uAE08\uAE30\uB41C \uC694\uB9AC\uC5D0 \uC911\uB3C5\uB418\uC5B4
      \uCD94\uBC29\uB2F9\uD588\uB2E4."
    ClueText: "\uB9C8\uC655\uC131\uC758 \uBD88\uC740 \uC774\uC0C1\uD558\uAC8C \uC624\uB798
      \uB0A8\uC544. \uD55C\uBC88 \uB9DB\uBCF8 \uAC74, \uCAD3\uACA8\uB09C \uB4A4\uC5D0\uB3C4
      \uD600\uB05D\uC5D0\uC11C \uC548 \uC0AC\uB77C\uC9C0\uAC70\uB4E0."
    ClueSpeakerId: 5
    HintText: "\uD1A0\uB2C8\uB97C \uD63C\uC790 \uB450\uBA74, \uD1A0\uB2C8\uAC00 \uC5B4\uB514\uC11C\uBD80\uD130
      \uADF8\uB7F0 \uD5C8\uAE30\uB97C \uBC30\uC6E0\uB294\uC9C0 \uD758\uB9B4\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    AcquireCondition: "\uD1A0\uB2C8(#5) \uD63C\uC790 \uC788\uB294 \uC870\uC0AC \uAD6C\uC5ED
      / \uC0AC\uB9DD \uC0AC\uAC74 1\uD68C \uC774\uC0C1 \uAD00\uCC30 \uD6C4"
    ConditionType: solo_after_event
    RecommendedCombo: "#5 \uB2E8\uB3C5, death_seen>=1"
    DesignerNote: "\uCD5C\uC885 \uD504\uB85C\uD30C\uC77C \uBCC0\uACBD\uC5D0 \uB530\uB77C
      \uD1A0\uB2C8\uC758 \uACFC\uAC70 \uD575\uC2EC \uC0AC\uAC74\uC744 1\uBC88 \uB2E8\uC11C\uB85C
      \uC774\uB3D9"
  - ProfileClueId: P05_02
    CharacterId: 5
    ClueIndex: 2
    ProfileKeyword: "\uADC0\uC5EC\uC6B4 \uD45C\uBA74 \uC5F0\uAE30"
    ProfileTruth: "\uD1A0\uB2C8\uB294 \uAC89\uC73C\uB85C \uADC0\uC5FD\uACE0 \uD574\uB9D1\uC740
      \uB2E8\uC21C\uD55C \uC0AC\uB78C\uCC98\uB7FC \uD589\uB3D9\uD55C\uB2E4."
    ClueText: "\uD1A0\uB2C8\uB294 \uADF8\uB0E5 \uBC30\uACE0\uD508 \uAC70\uC57C! \uBB34\uC11C\uC6B4
      \uC598\uAE30\uB294 \uC5B4\uB978\uB4E4\uC774\uB098 \uD574."
    ClueSpeakerId: 5
    HintText: "\uD504\uB9AC\uB4DC\uCC98\uB7FC \uBCF4\uD638\uD558\uB824\uB294 \uC778\uBB3C
      \uC55E\uC5D0\uC11C \uD1A0\uB2C8\uB294 \uAC00\uC7A5 \uD574\uB9D1\uC740 \uC5BC\uAD74\uC744
      \uBCF4\uC77C \uC218 \uC788\uB2E4."
    AcquireCondition: "\uD1A0\uB2C8(#5),\uD504\uB9AC\uB4DC(#6) \uAC19\uC740 \uC870\uC0AC
      \uAD6C\uC5ED / \uD574\uB2F9 \uD134 \uC0AC\uB9DD \uC5C6\uC74C"
    ConditionType: group_contains
    RecommendedCombo: '#5|#6, no_death'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uD1A0\uB2C8\uB294 \uC5EC\uC790"
  - ProfileClueId: P05_03
    CharacterId: 5
    ClueIndex: 3
    ProfileKeyword: "\uAD00\uCC30 \uD6C4 \uC0B4\uC778"
    ProfileTruth: "\uD1A0\uB2C8\uB294 \uC0AC\uB78C\uB4E4 \uC0AC\uC774\uC758 \uAC08\uB4F1
      \uD750\uB984\uACFC \uAC10\uC815, \uAD00\uACC4 \uBCC0\uD654\uB97C \uAD00\uCC30\uD55C
      \uB4A4 \uB300\uC0C1\uC744 \uC815\uD574 \uC0B4\uC778\uD55C\uB2E4."
    ClueText: "\uC0AC\uB78C\uB4E4\uC740 \uC2F8\uC6B0\uAE30 \uC9C1\uC804\uC774 \uC81C\uC77C
      \uC194\uC9C1\uD574. \uD45C\uC815\uB3C4, \uBAA9\uC18C\uB9AC\uB3C4, \uB0C4\uC0C8\uB3C4
      \uC804\uBD80 \uB2EC\uB77C\uC838."
    ClueSpeakerId: 5
    HintText: "\uC5D4\uBE44\uC640 \uD1A0\uB2C8\uB294 \uC11C\uB85C \uB2E4\uB978 \uBC29\uC2DD\uC73C\uB85C
      \uC0AC\uB78C \uC0AC\uC774\uC758 \uBCC0\uD654\uB97C \uBCF8\uB2E4."
    AcquireCondition: "\uC5D4\uBE44(#1),\uD1A0\uB2C8(#5) \uAC19\uC740 \uC870\uC0AC
      \uAD6C\uC5ED / P01_01~P01_05 \uC911 1\uAC1C \uC774\uC0C1 \uD68D\uB4DD \uD6C4"
    ConditionType: group_contains
    RecommendedCombo: '#1|#5'
    DesignerNote: "\uD1A0\uB2C8\uAC00 \uC989\uD765 \uC0B4\uC778\uC790\uAC00 \uC544\uB2C8\uB77C
      \uAD00\uCC30 \uD6C4 \uB300\uC0C1\uC744 \uC815\uD558\uB294 \uC778\uBB3C\uC784\uC744
      \uAC15\uC870"
  - ProfileClueId: P05_04
    CharacterId: 5
    ClueIndex: 4
    ProfileKeyword: "\uC8FD\uC74C \uC774\uD6C4\uC758 \uBCC0\uD654 \uC911\uC2DC"
    ProfileTruth: "\uD1A0\uB2C8\uB294 \uC8FD\uC74C\uBFD0\uB9CC \uC544\uB2C8\uB77C,
      \uADF8 \uC8FD\uC74C\uC774 \uC8FC\uBCC0\uC5D0 \uC5B4\uB5A4 \uBCC0\uD654\uB97C
      \uB9CC\uB4E4\uC5B4 \uB0B4\uB294\uC9C0\uB3C4 \uC911\uC694\uD558\uAC8C \uC5EC\uAE34\uB2E4."
    ClueText: "\uB108\uBB34 \uC870\uC6A9\uD788 \uB05D\uB098\uBA74 \uC544\uAE5D\uC796\uC544.
      \uB0A8\uC740 \uC5BC\uAD74\uB4E4\uC774 \uBB54\uAC00\uB97C \uC644\uC131\uD574
      \uC8FC\uB294\uB370."
    ClueSpeakerId: 5
    HintText: "\uC0AC\uB9DD \uC9C1\uD6C4 \uD1A0\uB2C8\uB97C \uC870\uC0AC\uD558\uBA74,
      \uD1A0\uB2C8\uAC00 \uC8FD\uC74C \uC774\uD6C4\uC758 \uBCC0\uD654\uB97C \uC5B4\uB5BB\uAC8C
      \uBCF4\uB294\uC9C0 \uB4DC\uB7EC\uB0A0 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uC0AC\uB9DD \uC0AC\uAC74 \uC9C1\uD6C4 / \uD1A0\uB2C8(#5)
      \uC0DD\uC874 / \uD1A0\uB2C8(#5)\uAC00 \uC0AC\uB9DD \uBC1C\uC0DD \uAD6C\uC5ED
      \uB610\uB294 \uAC19\uC740 \uC870\uC0AC \uAD6C\uC5ED\uC5D0 \uC874\uC7AC"
    ConditionType: after_death
    RecommendedCombo: '#5 alive, death_here_or_observed'
    DesignerNote: "\uB2E8\uC21C \uC0AC\uB9DD \uC9C1\uD6C4\uBCF4\uB2E4 \uD1A0\uB2C8\uAC00
      \uC0AC\uAC74\uACFC \uAC00\uAE4C\uC6B4 \uC704\uCE58\uC5D0 \uC788\uC744 \uB54C
      \uCD9C\uB825"
  - ProfileClueId: P05_05
    CharacterId: 5
    ClueIndex: 5
    ProfileKeyword: "\uC808\uB9DD\uD55C \uC2EC\uC7A5\uC5D0 \uB300\uD55C \uC695\uB9DD"
    ProfileTruth: "\uD1A0\uB2C8\uB294 \uAE08\uAE30\uB41C \uC694\uB9AC\uC758 \uC7AC\uB8CC\uB85C\uC11C
      \uC808\uB9DD\uD55C \uC0AC\uB78C\uC758 \uC2EC\uC7A5\uC744 \uC6D0\uD574 \uC0B4\uC778\uC744
      \uC800\uC9C0\uB978\uB2E4."
    ClueText: "\uC808\uB9DD\uC774 \uAE4A\uC744\uC218\uB85D \uC2EC\uC7A5\uC740 \uC624\uB798
      \uB0A8\uC544. \uADF8\uB0E5 \uC8FD\uC740 \uAC74 \uC2F1\uAC70\uC6CC. \uBB34\uB108\uC9C4
      \uB4A4\uC5D0\uC57C \uC7AC\uB8CC\uAC00 \uB3FC."
    ClueSpeakerId: 5
    HintText: "\uD1A0\uB2C8\uC758 \uC870\uAC01\uC744 \uCDA9\uBD84\uD788 \uBAA8\uC740
      \uB4A4 \uD63C\uC790 \uB450\uBA74, \uD1A0\uB2C8\uAC00 \uBB34\uC5C7\uC744 \uC7AC\uB8CC\uB85C
      \uC6D0\uD558\uB294\uC9C0 \uB9D0\uD560 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uD1A0\uB2C8(#5) \uD63C\uC790 \uC788\uB294 \uC870\uC0AC \uAD6C\uC5ED
      / P05_01~P05_04 \uC911 3\uAC1C \uC774\uC0C1 \uD68D\uB4DD / \uC0AC\uB9DD \uC0AC\uAC74
      1\uD68C \uC774\uC0C1 \uAD00\uCC30"
    ConditionType: required_clue_count
    RecommendedCombo: "#5 \uB2E8\uB3C5, P05 3\uAC1C \uC774\uC0C1, death_seen>=1"
    DesignerNote: "\uCD5C\uC885 \uD504\uB85C\uD30C\uC77C\uC758 \u2018\uC808\uB9DD\uD55C
      \uC0AC\uB78C\uC758 \uC2EC\uC7A5\u2019 \uD56D\uBAA9 \uBC18\uC601"
  - ProfileClueId: P06_01
    CharacterId: 6
    ClueIndex: 1
    ProfileKeyword: "\uBAA8\uB4E0 \uC77C\uC744 \uC9C1\uC811 \uC9CA\uC5B4\uC9C0\uB294
      \uC2E0\uB150"
    ProfileTruth: "\uD504\uB9AC\uB4DC\uB294 \uACFC\uAC70\uC758 \uACBD\uD5D8\uC744
      \uD1B5\uD574 \uC790\uC2E0\uC774 \uBAA8\uB4E0 \uC77C\uC744 \uC9C1\uC811 \uC9CA\uC5B4\uC838\uC57C
      \uD55C\uB2E4\uB294 \uD655\uACE0\uD55C \uC2E0\uB150\uC744 \uAC16\uAC8C \uB418\uC5C8\uB2E4."
    ClueText: "\uB0B4\uAC00 \uBA3C\uC800 \uBC1B\uC73C\uBA74, \uC801\uC5B4\uB3C4 \uB204\uAD70\uAC00\uB294
      \uB0A8\uB294\uB2E4. \uADF8 \uBBFF\uC74C\uC774 \uB098\uB97C \uC5EC\uAE30\uAE4C\uC9C0
      \uB04C\uACE0 \uC654\uB2E4."
    ClueSpeakerId: 6
    HintText: "\uD504\uB9AC\uB4DC\uB294 \uD63C\uC790 \uC788\uC744 \uB54C\uB3C4 \uB204\uAD70\uAC00\uC758
      \uBAAB\uC744 \uC0DD\uAC01\uD558\uACE0 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uD504\uB9AC\uB4DC(#6) \uD63C\uC790 \uC788\uB294 \uC870\uC0AC
      \uAD6C\uC5ED / \uB8E8\uD504 2\uD68C \uC774\uC0C1 \uC9C4\uD589"
    ConditionType: solo
    RecommendedCombo: "#6 \uB2E8\uB3C5, loop>=2"
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uD504\uB9AC\uB4DC\uB294 \uB0A8\uC790"
  - ProfileClueId: P06_02
    CharacterId: 6
    ClueIndex: 2
    ProfileKeyword: "\uC2A4\uC2A4\uB85C \uD76C\uC0DD\uD558\uB824 \uD568"
    ProfileTruth: "\uD504\uB9AC\uB4DC\uB294 \uB3D9\uB8CC\uB97C \uC9C0\uD0A4\uAE30
      \uC704\uD574 \uD56D\uC0C1 \uC2A4\uC2A4\uB85C\uB97C \uD76C\uC0DD\uD558\uB824
      \uD55C\uB2E4."
    ClueText: "\uC704\uD5D8\uD55C \uC790\uB9AC\uB77C\uBA74 \uB0B4\uAC00 \uAC00\uACA0\uB2E4.
      \uB204\uAC00 \uB0A8\uC544\uC57C \uD558\uB294\uC9C0\uB294 \uC544\uC9C1 \uC815\uD558\uC9C0
      \uC54A\uC544\uB3C4 \uB3FC."
    ClueSpeakerId: 6
    HintText: "\uBA54\uC774\uC758 \uC804\uC9C4 \uC606\uC5D0 \uD504\uB9AC\uB4DC\uB97C
      \uB450\uBA74, \uD504\uB9AC\uB4DC\uAC00 \uC5B4\uB5A4 \uC2DD\uC73C\uB85C \uC55E\uC5D0
      \uC11C\uB294\uC9C0 \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uBA54\uC774(#2),\uD504\uB9AC\uB4DC(#6) \uAC19\uC740 \uC870\uC0AC
      \uAD6C\uC5ED / P02_01~P02_05 \uC911 1\uAC1C \uC774\uC0C1 \uD68D\uB4DD \uD6C4"
    ConditionType: group_contains
    RecommendedCombo: '#2|#6'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uD504\uB9AC\uB4DC\uB294 \uB0A8\uC790"
  - ProfileClueId: P06_03
    CharacterId: 6
    ClueIndex: 3
    ProfileKeyword: "\uCC45\uC784 \uB3C5\uC810\uC5D0 \uC775\uC219\uD574\uC9D0"
    ProfileTruth: "\uADF8\uB7EC\uB098 \uD504\uB9AC\uB4DC\uB294 \uC810\uC810 \uC120\uD0DD\uACFC
      \uCC45\uC784\uC744 \uD63C\uC790 \uB5A0\uC548\uB294 \uBC29\uC2DD\uC5D0 \uC775\uC219\uD574\uC9C4\uB2E4."
    ClueText: "\uCC98\uC74C\uC5D4 \uB300\uC2E0\uD558\uB294 \uAC83\uC774\uC5C8\uB2E4.
      \uADF8\uB7F0\uB370 \uC5B4\uB290 \uC21C\uAC04\uBD80\uD130, \uBB3B\uAE30 \uC804\uC5D0
      \uB0B4\uAC00 \uC815\uD558\uACE0 \uC788\uC5C8\uB2E4."
    ClueSpeakerId: 6
    HintText: "\uC5D4\uBE44\uB294 \uD504\uB9AC\uB4DC\uC758 \uC120\uC758\uAC00 \uC5B8\uC81C
      \uACB0\uC815\uAD8C\uC73C\uB85C \uBC14\uB00C\uB294\uC9C0 \uAC74\uB4DC\uB9B4
      \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uC5D4\uBE44(#1),\uD504\uB9AC\uB4DC(#6) \uAC19\uC740 \uC870\uC0AC
      \uAD6C\uC5ED / \uD574\uB2F9 \uD134 \uC0AC\uB9DD \uC5C6\uC74C"
    ConditionType: group_contains
    RecommendedCombo: '#1|#6, no_death'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uD504\uB9AC\uB4DC\uB294 \uB0A8\uC790"
  - ProfileClueId: P06_04
    CharacterId: 6
    ClueIndex: 4
    ProfileKeyword: "\uD0C0\uC778\uC758 \uC120\uD0DD\uAD8C\uAE4C\uC9C0 \uB300\uC2E0\uD568"
    ProfileTruth: "\uD504\uB9AC\uB4DC\uB294 \uD0C0\uC778\uC744 \uC704\uD55C\uB2E4\uACE0
      \uBBFF\uC9C0\uB9CC, \uC2E4\uC81C\uB85C\uB294 \uD0C0\uC778\uC758 \uC120\uD0DD\uAD8C\uAE4C\uC9C0
      \uB300\uC2E0\uD558\uB824 \uD55C\uB2E4."
    ClueText: "\uB0B4\uAC00 \uB300\uC2E0 \uC120\uD0DD\uD558\uBA74 \uBAA8\uB450\uAC00
      \uB35C \uB2E4\uCE60 \uAC70\uB77C \uBBFF\uC5C8\uB2E4. \uADF8\uAC8C \uB204\uAD6C\uC758
      \uC120\uD0DD\uC744 \uC9C0\uC6B0\uB294\uC9C0\uB3C4 \uBAA8\uB974\uACE0."
    ClueSpeakerId: 6
    HintText: "\uC0C8\uD134\uC740 \uD504\uB9AC\uB4DC\uC758 \uD76C\uC0DD\uC774 \uC815\uB9D0
      \uBAA8\uB450\uC758 \uC120\uD0DD\uC778\uC9C0 \uBB3C\uC744 \uC218 \uC788\uC744
      \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uD504\uB9AC\uB4DC(#6),\uC0C8\uD134(#7) \uAC19\uC740 \uC870\uC0AC
      \uAD6C\uC5ED / P07_01~P07_05 \uC911 1\uAC1C \uC774\uC0C1 \uD68D\uB4DD \uD6C4"
    ConditionType: group_contains
    RecommendedCombo: '#6|#7'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uD504\uB9AC\uB4DC\uB294 \uB0A8\uC790"
  - ProfileClueId: P06_05
    CharacterId: 6
    ClueIndex: 5
    ProfileKeyword: "\uB0B4\uAC00 \uD76C\uC0DD\uD574\uC57C \uBAA8\uB450\uAC00 \uC0B0\uB2E4\uB294
      \uD655\uC2E0"
    ProfileTruth: "\uD504\uB9AC\uB4DC\uB294 \uACB0\uAD6D \u201C\uB0B4\uAC00 \uD76C\uC0DD\uD574\uC57C
      \uBAA8\uB450\uAC00 \uC0B0\uB2E4\u201D\uB294 \uC798\uBABB\uB41C \uD655\uC2E0\uC5D0
      \uC0AC\uB85C\uC7A1\uD78C \uC0C1\uD0DC\uB2E4."
    ClueText: "\uB0B4\uAC00 \uC0AC\uB77C\uC9C0\uBA74 \uBAA8\uB450\uAC00 \uC0B0\uB2E4\uACE0
      \uBBFF\uC5C8\uB2E4. \uBB38\uC81C\uB294, \uADF8 \uBBFF\uC74C\uB9C8\uC800 \uB0B4\uAC00
      \uD63C\uC790 \uC815\uD588\uB2E4\uB294 \uAC70\uB2E4."
    ClueSpeakerId: 6
    HintText: "\uD504\uB9AC\uB4DC\uAC00 \uC2E4\uC81C\uB85C \uB204\uAD70\uAC00\uC758
      \uC8FD\uC74C\uC744 \uB300\uC2E0\uD55C \uB4A4\uC5D0\uB294, \uADF8 \uC2E0\uB150\uC758
      \uC704\uD5D8\uC131\uC774 \uAC00\uC7A5 \uC120\uBA85\uD574\uC9C8 \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uD504\uB9AC\uB4DC(#6)\uAC00 \uD76C\uC0DD\uC591 \uD6A8\uACFC\uB85C
      \uC0AC\uB9DD\uD55C \uB4A4 / \uB0A8\uC740 \uC778\uBB3C\uC774 \uD504\uB9AC\uB4DC(#6)\uC758
      \uC120\uD0DD\uC744 \uD68C\uC0C1\uD558\uAC70\uB098 \uD504\uB9AC\uB4DC(#6) \uC2DC\uC810
      \uD68C\uC0C1 \uC870\uAC01 \uCD9C\uB825"
    ConditionType: after_death_memory
    RecommendedCombo: dead:#6, memory:#6
    DesignerNote: "\uD76C\uC0DD\uC591 \uD6A8\uACFC \uBC1C\uB3D9 \uD6C4 \uD504\uB9AC\uB4DC
      \uC0DD\uC874 \uC870\uAC74\uC740 \uC81C\uAC70"
  - ProfileClueId: P07_01
    CharacterId: 7
    ClueIndex: 1
    ProfileKeyword: "\uB4A4\uC5D0 \uB0A8\uACA8\uC57C \uD588\uB358 \uC0DD\uC874 \uAE30\uC5B5"
    ProfileTruth: "\uC0C8\uD134\uC740 \uACFC\uAC70\uC5D0 \uC0B4\uC544\uB0A8\uAE30
      \uC704\uD574 \uB204\uAD70\uAC00\uB97C \uB4A4\uC5D0 \uB0A8\uACA8\uC57C \uD588\uB358
      \uACBD\uD5D8\uC744 \uBC18\uBCF5\uD574 \uC654\uB2E4."
    ClueText: "\uB0B4\uAC00 \uC9C0\uB098\uC628 \uC790\uB9AC\uC5D0 \uB0A8\uACA8\uC9C4
      \uC0AC\uB78C\uB4E4\uC740 \uB298 \uB2A6\uAC8C \uC4F0\uB7EC\uC84C\uC5B4. \uADF8\uB798\uC11C
      \uBA3C\uC800 \uC6C0\uC9C1\uC774\uB294 \uBC1C\uC774 \uC544\uC9C1\uB3C4 \uBB34\uAC81\uB2E4."
    ClueSpeakerId: 7
    HintText: "\uB370\uC6B0\uC2A4\uC5D0\uAC8C\uB77C\uBA74 \uC0C8\uD134\uC774 \uBB34\uAC70\uC6B4
      \uC77C\uC744 \uD138\uC5B4\uB193\uC744 \uC218 \uC788\uC744\uC9C0 \uBAA8\uB978\uB2E4.
      \uC0C8\uD134\uC774 \uC9C0\uB098\uC628 \uC790\uB9AC\uC5D0 \uBB34\uC5C7\uC774
      \uB0A8\uB294\uC9C0 \uBCF4\uC790."
    AcquireCondition: "\uC0C8\uD134(#7)\uC774 \uC774\uB3D9\uD558\uBA70 \uC774\uC804
      \uCE78\uC5D0 \uB0A8\uC740 \uC778\uBB3C\uC774 \uBC30\uD68C\uC790 \uD6A8\uACFC\uB85C
      \uC0AC\uB9DD / \uC774\uB3D9 \uBAA9\uC801\uC9C0\uC5D0\uB294 \uB370\uC6B0\uC2A4(#3)
      \uD63C\uC790 \uC788\uC74C / \uC774\uB3D9 \uD6C4 \uC870\uC0AC \uAD6C\uC5ED\uC5D0\uB294
      \uC0C8\uD134(#7),\uB370\uC6B0\uC2A4(#3)\uB9CC \uC874\uC7AC"
    ConditionType: wanderer_death_then_exact_group
    RecommendedCombo: '#7 moves, previous_cell_death, destination:#3 only'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uC0C8\uD134\uC740 \uC5EC\uC790"
  - ProfileClueId: P07_02
    CharacterId: 7
    ClueIndex: 2
    ProfileKeyword: "\uB204\uAC00 \uBC84\uB824\uC9C0\uB294\uAC00\uB97C \uBA3C\uC800
      \uBD04"
    ProfileTruth: "\uC0C8\uD134\uC740 \uC5B4\uB5A4 \uC0C1\uD669\uC5D0\uC11C\uB3C4
      \u201C\uADF8 \uC120\uD0DD\uC73C\uB85C \uB204\uAC00 \uBC84\uB824\uC9C0\uB294\uAC00\u201D\uB97C
      \uBA3C\uC800 \uC0DD\uAC01\uD55C\uB2E4."
    ClueText: "\uB124\uAC00 \uB9D0\uD558\uB294 \uB05D\uAE4C\uC9C0 \uAC00\uB294 \uB3D9\uC548,
      \uB204\uAC00 \uB0A8\uACA8\uC9C0\uB294\uC9C0\uBD80\uD130 \uB9D0\uD574."
    ClueSpeakerId: 7
    HintText: "\uBA54\uC774\uC640 \uC0C8\uD134\uC744 \uB458\uB9CC \uB450\uBA74, \uB05D\uACFC
      \uACFC\uC815\uC758 \uCC28\uC774\uAC00 \uAC00\uC7A5 \uC9C1\uC811\uC801\uC73C\uB85C
      \uBCF4\uC77C \uAC83 \uAC19\uB2E4."
    AcquireCondition: "\uBA54\uC774(#2),\uC0C8\uD134(#7) \uAC19\uC740 \uC870\uC0AC
      \uAD6C\uC5ED / \uD574\uB2F9 \uD134 \uC0AC\uB9DD \uC5C6\uC74C"
    ConditionType: group_contains
    RecommendedCombo: '#2|#7, no_death'
    DesignerNote: "\uC131\uBCC4 \uAE30\uC900: \uC0C8\uD134\uC740 \uC5EC\uC790"
  - ProfileClueId: P07_03
    CharacterId: 7
    ClueIndex: 3
