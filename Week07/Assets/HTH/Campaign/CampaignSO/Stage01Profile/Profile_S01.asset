  m_Name: Profile_S01
  m_EditorClassIdentifier: Assembly-CSharp::HTH.Campaign.ProfileDataSO
  _stageId: CampaignMode
  _characterProfiles:
  - CharacterId: 1
    CharacterFullName: "\uC5D4\uBE44"
    CharacterRole: 
    CharacterIcon: {fileID: 21300000, guid: b68ce7ee735957f46aac983d4fca0803, type: 3}
    FinalTalk:
      IntroLines: []
      Question: 
      Choices: []
      CorrectIndex: 0
      ResultDialogues: []
  - CharacterId: 2
    CharacterFullName: "\uBA54\uC774"
    CharacterRole: 
    CharacterIcon: {fileID: 21300000, guid: ac9088d1bf1998a44a8eeec403dd264d, type: 3}
    FinalTalk:
      IntroLines:
      - SpeakerId: 2
        Text: "\uBB34\uC2A8 \uC77C\uC774\uC9C0, \uC5D4\uBE44?\n\uC774\uB7F0 \uACF3\uAE4C\uC9C0
          \uD63C\uC790 \uBD88\uB7EC\uB0B4\uB2E4\uB2C8."
      - SpeakerId: 1
        Text: "\uADF8\uB0A0 \uC77C \uB54C\uBB38\uC5D0\uC694.\n\uB4E4\uC73C\uBA74
          \uB9C8\uC74C\uC774 \uC870\uAE08 \uBD88\uD3B8\uD558\uC2E4 \uC218\uB3C4 \uC788\uC5B4\uC694."
      Question: 
      Choices:
      - "\uC0C8\uD134\uB2D8\uC774 \uD6C4\uBC29 \uACF5\uACA9\uC744 \uCE74\uC6B4\uD130
        \uD574\uC8FC\uC154\uC11C \uC815\uB9D0 \uB2E4\uD589\uC774\uC5C8\uC5B4\uC694.\n\uB8E8\uC774\uC2A4
        \uB2D8\uC774 \uBD80\uC0C1\uB2F9\uD558\uAE34 \uD588\uC9C0\uB9CC\u2026 \uADF8\uB798\uB3C4
        \uB355\uBD84\uC5D0 \uC804\uBA78\uD558\uC9C0 \uC54A\uC558\uC73C\uB2C8 \uB2E4\uD589\uC774\uC5D0\uC694."
      - "\uB8E8\uC774\uC2A4\uB2D8\uC774 \uC804\uC7A5 \uC911\uAC04\uC5D0\uC11C \uC11C
        \uACC4\uC2DC\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uBD80\uC0C1\uB2F9\uD558\uC9C0
        \uC54A\uC558\uC744 \uD14C\uACE0,\n\uC5B4\uCA4C\uBA74\u2026 \uB4DC\uB798\uACE4\uC744
        \uCC98\uCE58\uD588\uC744 \uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4\uC694. \uB8E8\uC774\uC2A4\uB2D8\uC740
        \uC65C \uAC00\uB9CC\uD788 \uACC4\uC168\uB358 \uAC78\uAE4C\uC694?"
      - "\uB370\uC6B0\uC2A4\uB2D8\uC740 \uB8E8\uC774\uC2A4\uB2D8\uC774 \uC4F0\uB7EC\uC9C4
        \uAC78 \uBCF4\uC790\uB9C8\uC790 \uADC0\uD658 \uC8FC\uBB38\uC744 \uC0AC\uC6A9\uD558\uC168\uB358
        \uAC83 \uAC19\uC544\uC694.\n\uADF8\uB54C \uBA54\uC774\uB2D8\uC774 \uB9C8\uC9C0\uB9C9
        \uC77C\uACA9\uC744 \uB0A0\uB9AC\uAE30 \uC9C1\uC804\uC774\uC5C8\uB294\uB370..
        \uB108\uBB34 \uC544\uC26C\uC6CC\uC694."
      - "\uD504\uB9AC\uB4DC\uB2D8\uC740 \uBA54\uC774\uB2D8\uC774 \uB108\uBB34 \uC55E\uC73C\uB85C
        \uB098\uAC00 \uC788\uC5B4\uC11C \uBC29\uC5B4\uBCBD \uC704\uCE58\uB97C \uB9DE\uCD94\uAE30
        \uC5B4\uB824\uC6E0\uB2E4\uACE0 \uD558\uC168\uC5B4\uC694.\n\uD3C9\uC18C\uC5D0\uB294
        \uBAA8\uB450\uB97C \uC9C0\uCF1C \uC8FC\uB358 \uBD84\uC778\uB370.. \uC774\uBC88\uC5D4
        \uD798\uB4DC\uC168\uB098\uBD10\uC694."
      CorrectIndex: 2
      ResultDialogues:
      - ChoiceIndex: 0
        Lines:
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC774 \uD6C4\uBC29 \uACF5\uACA9\uC744 \uCE74\uC6B4\uD130
            \uD574\uC8FC\uC154\uC11C \uC815\uB9D0 \uB2E4\uD589\uC774\uC5C8\uC5B4\uC694.
            \n\uB8E8\uC774\uC2A4 \uB2D8\uC774 \uBD80\uC0C1\uB2F9\uD558\uAE34 \uD588\uC9C0\uB9CC\u2026
            \uADF8\uB798\uB3C4 \uB355\uBD84\uC5D0 \uC804\uBA78\uD558\uC9C0 \uC54A\uC558\uC73C\uB2C8
            \uB2E4\uD589\uC774\uC5D0\uC694."
        - SpeakerId: 2
          Text: "\uB2E4\uD589?"
        - SpeakerId: 1
          Text: "\uB124. \uC0C8\uD134\uB2D8\uC774 \uB9C9\uC9C0 \uC54A\uC558\uB2E4\uBA74
            \uB354 \uD070 \uD53C\uD574\uAC00 \uB0AC\uC744 \uC218\uB3C4 \uC788\uC73C\uB2C8\uAE4C\uC694."
        - SpeakerId: 2
          Text: "\uADF8\uAC74 \uB9DE\uC544.\n\uC0C8\uD134\uC774 \uADF8\uAC78 \uB9C9\uC740
            \uAC74 \uC0AC\uC2E4\uC774\uC9C0."
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uB2E4\uCE58\uC168\uC9C0\uB9CC\uC694."
        - SpeakerId: 2
          Text: "\uADF8\uAC78 \uAC00\uBCCD\uAC8C \uB9D0\uD558\uC9C0 \uB9C8.\n\uB8E8\uC774\uC2A4\uAC00
            \uB2E4\uCE5C \uAC74 \uB2E4\uD589 \uAC19\uC740 \uB9D0\uB85C \uC815\uB9AC\uD560
            \uC77C\uC774 \uC544\uB2C8\uC57C."
        - SpeakerId: 1
          Text: "\uC8C4\uC1A1\uD574\uC694. \uC800\uB294 \uADF8\uB0E5 \uC804\uBA78\uC740
            \uD53C\uD588\uB2E4\uB294 \uB73B\uC73C\uB85C\u2026"
        - SpeakerId: 2
          Text: "\uC54C\uC544.\n\uD558\uC9C0\uB9CC \uADF8\uB0A0 \uC77C\uC744 \uADF8\uB807\uAC8C
            \uACC4\uC0B0\uD558\uB4EF \uB9D0\uD558\uBA74 \uC548 \uB3FC."
        IsSuccess: 0
      - ChoiceIndex: 1
        Lines:
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC774 \uC804\uC7A5 \uC911\uAC04\uC5D0\uC11C
            \uC11C \uACC4\uC2DC\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uBD80\uC0C1 \uB2F9\uD558\uC9C0
            \uC54A\uC558\uC744 \uD14C\uACE0, \n\uC5B4\uCA4C\uBA74\u2026 \uB4DC\uB798\uACE4\uC744
            \uCC98\uCE58\uD588\uC744 \uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4\uC694.
            \uB8E8\uC774\uC2A4\uB2D8\uC740 \uC65C \uAC00\uB9CC\uD788 \uACC4\uC168\uB358
            \uAC78\uAE4C\uC694?"
        - SpeakerId: 2
          Text: "\uB8E8\uC774\uC2A4 \uD0D3\uC744 \uD558\uACE0 \uC2F6\uC740 \uAC70\uC57C?"
        - SpeakerId: 1
          Text: "\uC544\uB1E8. \uADF8\uB0E5 \uADF8\uB54C \uC704\uCE58\uAC00 \uC911\uC694\uD588\uB358
            \uAC83 \uAC19\uC544\uC11C\uC694."
        - SpeakerId: 2
          Text: "\uB8E8\uC774\uC2A4\uB294 \uC6D0\uB798 \uC27D\uAC8C \uACB0\uC815\uD558\uB294
            \uC0AC\uB78C\uC774 \uC544\uB2C8\uC57C.\n\uADF8\uAC8C \uB2F5\uB2F5\uD560
            \uB54C\uB294 \uC788\uC9C0\uB9CC, \uADF8\uAC78 \uBAB0\uB790\uB358 \uAC74
            \uC544\uB2C8\uC57C."
        - SpeakerId: 1
          Text: "\uADF8\uB798\uB3C4 \uADF8 \uB9DD\uC124\uC784 \uB54C\uBB38\uC5D0
            \uC804\uD22C\uAC00 \uAF2C\uC778 \uAC74 \uB9DE\uC9C0 \uC54A\uB098\uC694?"
        - SpeakerId: 2
          Text: "\uADF8\uB7F0 \uC2DD\uC73C\uB85C \uB9D0\uD558\uBA74 \uD3B8\uD558\uACA0\uC9C0.\n\uD558\uC9C0\uB9CC
            \uC804\uD22C\uB97C \uC2DC\uC791\uD55C \uAC74 \uB098\uC57C."
        - SpeakerId: 1
          Text: "\uBA54\uC774\uB2D8\uC740 \uB8E8\uC774\uC2A4\uB2D8\uC744 \uC6D0\uB9DD\uD558\uC9C0
            \uC54A\uC73C\uC138\uC694?"
        - SpeakerId: 2
          Text: "\uB204\uAD70\uAC00\uC758 \uD589\uB3D9\uC744 \uB2E8\uC21C\uD558\uAC8C
            \uD3C9\uAC00\uD558\uACE0 \uC6D0\uB9DD\uD558\uB294 \uAC74 \uC26C\uC6CC.\n\uD558\uC9C0\uB9CC
            \uB09C \uADF8\uB7EC\uACE0 \uC2F6\uC9C0 \uC54A\uC544. \uB8E8\uC774\uC2A4\uB3C4
            \uC0DD\uAC01\uC774 \uC788\uC5C8\uC744 \uAC70\uC57C.\n\u2026\uC9C0\uAE08\uC774\uB77C\uB3C4
            \uAC00\uC11C \uC0AC\uACFC\uD574\uC57C\uACA0\uC5B4."
        IsSuccess: 0
      - ChoiceIndex: 2
        Lines:
        - SpeakerId: 1
          Text: "\uB370\uC6B0\uC2A4\uB2D8\uC740 \uB8E8\uC774\uC2A4\uB2D8\uC774 \uC4F0\uB7EC\uC9C4
            \uAC78 \uBCF4\uC790\uB9C8\uC790 \uADC0\uD658 \uC8FC\uBB38\uC744 \uC0AC\uC6A9\uD558\uC168\uB358
            \uAC83 \uAC19\uC544\uC694.\n\uADF8\uB54C \uBA54\uC774\uB2D8\uC774 \uB9C8\uC9C0\uB9C9
            \uC77C\uACA9\uC744 \uB0A0\uB9AC\uAE30 \uC9C1\uC804\uC774\uC5C8\uB294\uB370..
            \uB108\uBB34 \uC544\uC26C\uC6CC\uC694."
        - SpeakerId: 2
          Text: "\u2026\uADF8\uAC78 \uB204\uAC00 \uB9D0\uD588\uC5B4?"
        - SpeakerId: 1
          Text: "\uC5EC\uB7EC \uC0AC\uB78C\uD55C\uD14C \uC870\uAE08\uC529 \uB4E4\uC5C8\uC5B4\uC694.\n\uBA54\uC774\uB2D8\uC774
            \uAC70\uC758 \uB05D\uAE4C\uC9C0 \uBAB0\uC544\uBD99\uC600\uB2E4\uB294
            \uAC83\uB3C4\uC694."
        - SpeakerId: 2
          Text: "\uAC70\uC758\uAC00 \uC544\uB2C8\uC57C.\n\uB2FF\uC558\uC5B4. \uC815\uB9D0
            \uB2FF\uAE30 \uC9C1\uC804\uC774\uC5C8\uC5B4."
        - SpeakerId: 1
          Text: "\uADF8\uB7F0\uB370 \uADC0\uD658 \uC8FC\uBB38\uC774 \uBA3C\uC800
            \uBC1C\uB3D9\uB410\uC8E0."
        - SpeakerId: 2
          Text: "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C \uBD24\uACA0\uC9C0."
        - SpeakerId: 1
          Text: "\uB124. \uB208\uC744 \uB728\uC790\uB9C8\uC790 \uB8E8\uC774\uC2A4\uB2D8\uC774
            \uC4F0\uB7EC\uC9C4 \uAC78 \uBD24\uB2E4\uACE0 \uD588\uC5B4\uC694."
        - SpeakerId: 2
          Text: "\uB610\u2026. \uB610 \uB610 \uB610 \uB8E8\uC774\uC2A4\uC600\uB124."
        - SpeakerId: 1
          Text: "\uB370\uC6B0\uC2A4\uB2D8\uB3C4 \uB180\uB77C\uC168\uC744 \uAC70\uC608\uC694.\n\uADF8
            \uC21C\uAC04\uC5D0\uB294 \uB2E4\uB978 \uAC8C \uBCF4\uC774\uC9C0 \uC54A\uC558\uC744\uC9C0\uB3C4
            \uBAB0\uB77C\uC694."
        - SpeakerId: 2
          Text: "\uADF8\uAC8C \uBB38\uC81C\uC57C.\n\uB298 \uADF8\uB798. \uB298 \uB8E8\uC774\uC2A4\uBD80\uD130
            \uBD10. \uB2E4\uB978 \uAC74 \uB4B7\uC804\uC774\uC9C0."
        - SpeakerId: 1
          Text: "\uBA54\uC774\uB2D8\uC740 \uC6A9\uBCD1\uB2E8\uC758 \uBBF8\uB798\uB97C
            \uBC14\uAFB8\uB824\uB358 \uAC70\uC796\uC544\uC694."
        - SpeakerId: 2
          Text: "\uB9DE\uC544.\n\uADF8 \uB4DC\uB798\uACE4\uC744 \uC7A1\uC558\uC73C\uBA74\u2026
            \uB2EC\uB77C\uC84C\uC744 \uAC70\uC57C."
        - SpeakerId: 1
          Text: "\uADF8\uB7F0\uB370 \uB9C8\uC9C0\uB9C9 \uC21C\uAC04\uC5D0 \uBA48\uCDB0\uBC84\uB838\uC8E0."
        - SpeakerId: 2
          Text: "\u2026\uB370\uC6B0\uC2A4\uAC00 \uBA48\uCD98 \uAC70\uC57C.\n\uB0B4\uAC00
            \uC544\uB2C8\uB77C."
        IsSuccess: 1
      - ChoiceIndex: 3
        Lines:
        - SpeakerId: 1
          Text: "\uD504\uB9AC\uB4DC\uB2D8\uC740 \uBA54\uC774\uB2D8\uC774 \uB108\uBB34
            \uC55E\uC73C\uB85C \uB098\uAC00 \uC788\uC5B4\uC11C \uBC29\uC5B4\uBCBD
            \uC704\uCE58\uB97C \uB9DE\uCD94\uAE30 \uC5B4\uB824\uC6E0\uB2E4\uACE0
            \uD558\uC168\uC5B4\uC694.\n\uD3C9\uC18C\uC5D0\uB294 \uBAA8\uB450\uB97C
            \uC9C0\uCF1C \uC8FC\uB358 \uBD84\uC778\uB370.. \uC774\uBC88\uC5D4 \uD798\uB4DC\uC168\uB098\uBD10\uC694."
        - SpeakerId: 2
          Text: "\uB0B4\uAC00 \uC55E\uC73C\uB85C \uB098\uAC04 \uAC74 \uB9DE\uC544.\n\uC608\uACE0
            \uC5C6\uC774 \uB6F0\uCCD0\uB098\uAC14\uC73C\uB2C8\uAE4C.. \uD504\uB9AC\uB4DC\uB3C4
            \uB2F9\uD669\uD588\uC744\uAC70\uC57C."
        - SpeakerId: 1
          Text: "\uD504\uB9AC\uB4DC\uB2D8\uB3C4 \uADF8\uAC78 \uB9C9\uAE30 \uC5B4\uB824\uC6E0\uB358
            \uAC83 \uAC19\uC544\uC694."
        - SpeakerId: 2
          Text: "\uD504\uB9AC\uB4DC\uB294 \uB298 \uBAA8\uB450\uB97C \uC9C0\uD0A4\uB824\uACE0
            \uD574.\n\uADF8\uAC8C \uC7A5\uC810\uC774\uBA74\uC11C \uB2E8\uC810\uC774\uC9C0."
        - SpeakerId: 1
          Text: "\uADF8\uB7EC\uBA74 \uBA54\uC774\uB2D8\uC740 \uD504\uB9AC\uB4DC\uB2D8
            \uD0D3\uC740 \uC544\uB2C8\uB77C\uACE0 \uC0DD\uAC01\uD558\uC138\uC694?"
        - SpeakerId: 2
          Text: "\uC801\uC5B4\uB3C4 \uADF8\uB0A0 \uD504\uB9AC\uB4DC\uB294 \uC790\uAE30
            \uC5ED\uD560\uC744 \uD558\uB824\uACE0 \uD588\uC5B4.\n\uB0B4\uAC00 \uB108\uBB34
            \uC55E\uC5D0 \uC788\uC5C8\uB358 \uAC83\uB3C4 \uC0AC\uC2E4\uC774\uACE0."
        - SpeakerId: 1
          Text: "\uADF8\uB798\uB3C4 \uBC29\uC5B4\uBCBD\uC774 \uC870\uAE08\uB9CC \uB354
            \uBE68\uB790\uB2E4\uBA74\u2026"
        - SpeakerId: 2
          Text: "\uADF8\uB7AC\uC73C\uBA74 \uC88B\uC558\uACA0\uC9C0. \uD558\uC9C0\uB9CC
            \uB098\uB3C4 \uB108\uBB34 \uB3C5\uB2E8\uC801\uC73C\uB85C \uD589\uB3D9\uD588\uC5B4.\n\uD504\uB9AC\uB4DC\uC758
            \uBC29\uC5B4\uBCBD \uBC94\uC704 \uC548\uC5D0\uC11C \uC6C0\uC9C1\uC5EC\uC57C
            \uD588\uB294\uB370."
        IsSuccess: 0
  - CharacterId: 3
    CharacterFullName: "\uB8E8\uC774\uC2A4"
    CharacterRole: 
    CharacterIcon: {fileID: 21300000, guid: 99bb6781bae90764faec8614b21f7e33, type: 3}
    FinalTalk:
      IntroLines:
      - SpeakerId: 3
        Text: "\uBB34\uC2A8 \uC77C\uC774\uC57C, \uC5D4\uBE44?\n\uAC11\uC790\uAE30
          \uBD88\uB7EC\uB0B4\uACE0."
      - SpeakerId: 1
        Text: "\uBCC4\uC77C\uC740 \uC544\uB2C8\uC5D0\uC694.\n\uADF8\uB0E5\u2026 \uADF8\uB0A0
          \uC77C\uC5D0 \uB300\uD574 \uB4E4\uC740 \uAC8C \uC788\uC5B4\uC11C\uC694.\n\uB8E8\uC774\uC2A4\uB2D8\uC774
          \uB108\uBB34 \uC790\uCC45\uD558\uC2DC\uB294 \uAC83 \uAC19\uC544 \uBCF4\uC5EC\uC11C
          \uBD88\uB800\uC5B4\uC694."
      Question: 
      Choices:
      - "\uD504\uB9AC\uB4DC\uB2D8\uC774 \uD638\uC704 \uBB3C\uD488\uC744 \uBC29\uC5B4\uD558\uB824\uACE0
        \uD558\uB2E4 \uBCF4\uB2C8 \uB8E8\uC774\uC2A4\uB2D8\uAE4C\uC9C0\uB294 \uBC29\uC5B4\uBCBD\uC774
        \uC138\uC6CC\uC9C0\uC9C0 \uBABB\uD588\uB358 \uAC83 \uAC19\uC544\uC694. \uADF8\uB798\uB3C4
        \uBB3C\uD488\uBCF4\uB2E4\uB294 \uB8E8\uC774\uC2A4\uB2D8\uC744 \uBC29\uC5B4\uD588\uB2E4\uBA74
        \uC88B\uC558\uC744 \uD150\uB370, \uB108\uBB34\uD558\uB124\uC694."
      - "\uD1A0\uB2C8\uB2D8\uC740\u2026 \uC911\uC694\uD55C \uBB3C\uD488\uC744 \uC9C0\uD0A4\uB824\uACE0
        \uD588\uB358 \uAC70\uACA0\uC8E0? \uD558\uD558.."
      - "\uBA54\uC774\uB2D8\uC740 \uB8E8\uC774\uC2A4\uB2D8\uC774 \uD310\uB2E8\uC744
        \uB05D\uB0BC \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB9B4 \uC0C1\uD669\uC740 \uC544\uB2C8\uB77C\uACE0
        \uC0DD\uAC01\uD574\uC11C \uBA3C\uC800 \uB3CC\uACA9\uD55C \uAC83 \uAC19\uC544\uC694.
        \uADF8\uCE58\uB9CC \uB8E8\uC774\uC2A4\uB2D8\uC758 \uD310\uB2E8\uC744 \uB4E3\uACE0
        \uD589\uB3D9\uD588\uB354\uB77C\uBA74 \uB354 \uC88B\uC558\uC744\uD150\uB370\u2026"
      - "\uC0C8\uD134\uB2D8\uC740 \uB9C8\uB825\uC758 \uD750\uB984\uC73C\uB85C \uACF5\uACA9\uC744
        \uBA3C\uC800 \uC77D\uACE0 \uC6C0\uC9C1\uC774\uC168\uB358 \uAC70\uB798\uC694.
        \uB9C8\uBC95\uC0AC\uB4E4\uC740 \uC815\uB9D0 \uB300\uB2E8\uD574\uC694! \uC800\uD76C\uC5D0\uAC8C\uB294
        \uBCF4\uC774\uC9C0 \uC54A\uB294 \uAC8C \uBCF4\uC778\uB2E4\uB2C8. \uC544,
        \uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uB8E8\uC774\uC2A4\uB2D8\uAED8\uB3C4\u2026
        \uBCF4\uC774\uC9C0 \uC54A\uC558\uACA0\uB124\uC694\u2026"
      CorrectIndex: 2
      ResultDialogues:
      - ChoiceIndex: 0
        Lines:
        - SpeakerId: 1
          Text: "\uD504\uB9AC\uB4DC\uB2D8\uC774 \uD638\uC704 \uBB3C\uD488\uC744 \uBC29\uC5B4\uD558\uB824\uACE0
            \uD558\uB2E4 \uBCF4\uB2C8 \uB8E8\uC774\uC2A4\uB2D8\uAE4C\uC9C0\uB294
            \uBC29\uC5B4\uBCBD\uC774 \uC138\uC6CC\uC9C0\uC9C0 \uBABB\uD588\uB358
            \uAC83 \uAC19\uC544\uC694. \uADF8\uB798\uB3C4 \uBB3C\uD488\uBCF4\uB2E4\uB294
            \uB8E8\uC774\uC2A4\uB2D8\uC744 \uBC29\uC5B4\uD588\uB2E4\uBA74 \uC88B\uC558\uC744
            \uD150\uB370, \uB108\uBB34\uD558\uB124\uC694."
        - SpeakerId: 3
          Text: "\uC544\uB2C8\uC57C.\n\uD504\uB9AC\uB4DC\uB294 \uADF8\uB7F0 \uC0AC\uB78C\uC774
            \uC544\uB2C8\uC57C."
        - SpeakerId: 1
          Text: "\uD558\uC9C0\uB9CC \uB8E8\uC774\uC2A4\uB2D8\uC740 \uB2E4\uCE58\uC168\uC796\uC544\uC694.\n\uBB3C\uD488\uB9CC
            \uBB34\uC0AC\uD588\uACE0\uC694."
        - SpeakerId: 3
          Text: "\uADF8\uAC74 \uACB0\uACFC\uB9CC \uBCF4\uBA74 \uADF8\uB807\uC9C0.\n\uD558\uC9C0\uB9CC
            \uD504\uB9AC\uB4DC\uB294 \uB298 \uBAA8\uB450\uB97C \uC9C0\uD0A4\uB824\uACE0
            \uD574."
        - SpeakerId: 1
          Text: "\uADF8\uB798\uB3C4 \uC870\uAE08 \uC11C\uC6B4\uD558\uC9C0 \uC54A\uC73C\uC138\uC694?\n\uC0AC\uB78C\uBCF4\uB2E4
            \uBB3C\uAC74\uC774 \uBA3C\uC800\uC600\uB358 \uAC83\uCC98\uB7FC \uBCF4\uC77C
            \uC218\uB3C4 \uC788\uC796\uC544\uC694."
        - SpeakerId: 3
          Text: "\u2026\uADF8\uB807\uAC8C \uB9D0\uD558\uC9C0 \uB9C8.\n\uADF8 \uBB3C\uD488\uC744
            \uC9C0\uD0A4\uB294 \uAC83\uB3C4 \uC6B0\uB9AC \uC784\uBB34\uC600\uC5B4."
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uC815\uB9D0 \uBAA8\uB450\uB97C \uC774\uD574\uD574\uC8FC\uC2DC\uB124\uC694."
        - SpeakerId: 3
          Text: "\uC774\uD574\uD558\uB824\uB294 \uAC70\uC57C.\n\uADF8\uB0A0 \uB2E4\uB4E4\u2026
            \uC790\uAE30 \uC790\uB9AC\uC5D0\uC11C \uBC84\uD2F0\uACE0 \uC788\uC5C8\uC73C\uB2C8\uAE4C."
        IsSuccess: 0
      - ChoiceIndex: 1
        Lines:
        - SpeakerId: 1
          Text: "\uD1A0\uB2C8\uB2D8\uC740\u2026 \uC911\uC694\uD55C \uBB3C\uD488\uC744
            \uC9C0\uD0A4\uB824\uACE0 \uD588\uB358 \uAC70\uACA0\uC8E0? \uD558\uD558.."
        - SpeakerId: 3
          Text: "\uD1A0\uB2C8\uB294 \uC804\uD22C \uC778\uC6D0\uC774 \uC544\uB2C8\uC57C.\n\uADF8
            \uC560\uAC00 \uD560 \uC218 \uC788\uB294 \uC77C\uC744 \uD55C \uAC70\uB77C\uACE0
            \uC0DD\uAC01\uD574."
        - SpeakerId: 1
          Text: "\uADF8\uB798\uB3C4 \uB2E4\uB4E4 \uC704\uD5D8\uD55C \uC0C1\uD669\uC774\uC5C8\uC796\uC544\uC694.\n\uD63C\uC790
            \uBB3C\uD488\uC744 \uB4E4\uACE0 \uD53C\uD588\uB2E4\uB294 \uAC74\u2026"
        - SpeakerId: 3
          Text: "\uBB3C\uD488\uC744 \uC783\uC73C\uBA74 \uD638\uC704 \uC784\uBB34\uB294
            \uC2E4\uD328\uC600\uC5B4.\n\uD1A0\uB2C8\uB294 \uADF8\uAC78 \uC54C\uACE0
            \uC788\uC5C8\uACA0\uC9C0."
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uD1A0\uB2C8\uB2D8\uC744 \uC6D0\uB9DD\uD558\uC9C0
            \uC54A\uC73C\uC138\uC694?"
        - SpeakerId: 3
          Text: "\uC6D0\uB9DD\uD560 \uC790\uACA9\uC774 \uC788\uC744\uAE4C.\n\uB098\uB3C4
            \uADF8\uB54C \uC544\uBB34\uAC83\uB3C4 \uC81C\uB300\uB85C \uC815\uD558\uC9C0
            \uBABB\uD588\uB294\uB370."
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uB298 \uBCF8\uC778 \uD0D3\uC73C\uB85C
            \uB3CC\uB9AC\uC2DC\uB294\uAD70\uC694."
        - SpeakerId: 3
          Text: "\uADF8\uAC8C \uD3B8\uD574\uC11C\uAC00 \uC544\uB2C8\uC57C.\n\uC2E4\uC81C\uB85C
            \uB0B4\uAC00 \uB2A6\uC5C8\uC73C\uB2C8\uAE4C."
        IsSuccess: 0
      - ChoiceIndex: 2
        Lines:
        - SpeakerId: 1
          Text: "\uBA54\uC774\uB2D8\uC740 \uB8E8\uC774\uC2A4\uB2D8\uC774 \uD310\uB2E8\uC744
            \uB05D\uB0BC \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB9B4 \uC0C1\uD669\uC740
            \uC544\uB2C8\uB77C\uACE0 \uC0DD\uAC01\uD574\uC11C \uBA3C\uC800 \uB3CC\uACA9\uD55C
            \uAC83 \uAC19\uC544\uC694. \n\uADF8\uCE58\uB9CC \uB8E8\uC774\uC2A4\uB2D8\uC758
            \uD310\uB2E8\uC744 \uB4E3\uACE0 \uD589\uB3D9\uD588\uB354\uB77C\uBA74
            \uB354 \uC88B\uC558\uC744\uD150\uB370\u2026"
        - SpeakerId: 3
          Text: "\u2026\uBA54\uC774\uAC00 \uADF8\uB807\uAC8C \uB9D0\uD588\uC5B4?"
        - SpeakerId: 1
          Text: "\uC9C1\uC811 \uADF8\uB807\uAC8C \uB9D0\uD55C \uAC74 \uC544\uB2C8\uC5D0\uC694.\n\uD558\uC9C0\uB9CC
            \uBA54\uC774\uB2D8\uC740 \uADF8 \uC21C\uAC04\uC774 \uAE30\uD68C\uC600\uB2E4\uACE0
            \uC0DD\uAC01\uD558\uC2DC\uB294 \uAC83 \uAC19\uC558\uC5B4\uC694."
        - SpeakerId: 3
          Text: "\uAE30\uD68C\u2026"
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uC544\uC9C1 \uD310\uB2E8 \uC911\uC774\uC168\uC8E0.\n\uC2F8\uC6CC\uC57C
            \uD560\uC9C0, \uBB3C\uB7EC\uB098\uC57C \uD560\uC9C0."
        - SpeakerId: 3
          Text: "\u2026\uADF8 \uB4DC\uB798\uACE4\uC740 \uADF8\uB0E5 \uB4DC\uB798\uACE4\uC774
            \uC544\uB2C8\uC5C8\uC5B4.\n\uBA54\uC774\uB294 \uBAB0\uB790\uACA0\uC9C0\uB9CC,
            \uAC89\uBAA8\uC2B5\uC774 \uC77C\uBC18\uC885\uACFC \uBE44\uC2B7\uD55C
            \uD76C\uADC0\uC885\uC774\uB77C \uD6E8\uC52C \uC704\uD5D8\uD55C \uC0C1\uD669\uC774\uC5C8\uC5B4."
        - SpeakerId: 1
          Text: "\uADF8\uB7F0\uB370 \uBA54\uC774\uB2D8\uC740 \uAE30\uB2E4\uB9AC\uC9C0
            \uC54A\uC558\uC5B4\uC694.\n\uB8E8\uC774\uC2A4\uB2D8\uC774 \uACB0\uB860\uC744
            \uB0B4\uB9AC\uAE30 \uC804\uC5D0 \uC774\uBBF8 \uC804\uD22C\uAC00 \uC2DC\uC791\uB410\uC8E0."
        - SpeakerId: 3
          Text: "\uB098\uB294\u2026 \uB0B4\uAC00 \uB2A6\uC5B4\uC11C \uADF8\uB807\uAC8C
            \uB41C \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD588\uC5B4."
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC774 \uB2A6\uC5C8\uB358 \uAC78\uAE4C\uC694?\n\uC544\uB2C8\uBA74
            \uCC98\uC74C\uBD80\uD130 \uB8E8\uC774\uC2A4\uB2D8\uC758 \uD310\uB2E8\uC744
            \uB4E4\uC744 \uC0DD\uAC01\uC774 \uC5C6\uC5C8\uB358 \uAC78\uAE4C\uC694?"
        - SpeakerId: 3
          Text: "\u2026\uADF8\uB7F0 \uC2DD\uC73C\uB85C \uC0DD\uAC01\uD558\uACE0 \uC2F6\uC9C0\uB294
            \uC54A\uC544."
        - SpeakerId: 1
          Text: "\uB124. \uC800\uB3C4 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uACE0
            \uC2F6\uC9C0\uB294 \uC54A\uC544\uC694.\n\uD558\uC9C0\uB9CC \uADF8\uB0A0
            \uB8E8\uC774\uC2A4\uB2D8\uC774 \uD310\uB2E8\uD560 \uC2DC\uAC04\uB9CC
            \uC788\uC5C8\uB2E4\uBA74, \uACB0\uACFC\uAC00 \uB2EC\uB77C\uC84C\uC744\uC9C0\uB3C4
            \uBAA8\uB974\uC796\uC544\uC694."
        - SpeakerId: 3
          Text: "\uBA54\uC774\uB294 \uB298 \uBE68\uB790\uC5B4.\n\uB0B4\uAC00 \uC2E0\uC911\uD558\uAC8C
            \uC0DD\uAC01\uD558\uACE0 \uB9D0\uC744 \uACE0\uB974\uB294 \uB3D9\uC548
            \uC774\uBBF8 \uC800 \uBA40\uB9AC \uC55E\uC73C\uB85C \uB6F0\uCCD0\uB098\uAC14\uC9C0."
        - SpeakerId: 1
          Text: "\uADF8\uB798\uC11C \uB2E4\uB4E4 \uBA54\uC774\uB2D8\uC744 \uB530\uB790\uB358
            \uAC70\uACA0\uC8E0.\n\uD558\uC9C0\uB9CC \uC774\uBC88\uC5D0\uB294\u2026
            \uB8E8\uC774\uC2A4\uB2D8\uC758 \uC758\uACAC\uC774 \uD544\uC694\uD55C
            \uC0C1\uD669\uC774\uC5C8\uC744\uC9C0\uB3C4 \uBAB0\uB77C\uC694."
        - SpeakerId: 3
          Text: "\uADF8\uB7F0\uB370 \uBA54\uC774\uB294 \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uC558\uACE0."
        - SpeakerId: 1
          Text: "\u2026\uC800\uB294 \uADF8\uB807\uAC8C \uBCF4\uC600\uC5B4\uC694."
        - SpeakerId: 3
          Text: "\uB098\uB294 \uB0B4\uAC00 \uB2E4\uCCD0\uC11C \uB2E4\uD589\uC774\uB77C\uACE0
            \uC0DD\uAC01\uD588\uC5B4.\n\uB0B4\uAC00 \uC798\uBABB \uD310\uB2E8\uD574\uC11C
            \uBAA8\uB450\uAC00 \uC8FD\uB294 \uAC83\uBCF4\uB2E4\uB294 \uB0AB\uB2E4\uACE0."
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC774 \uADF8\uB807\uAC8C\uAE4C\uC9C0 \uC0DD\uAC01\uD558\uC2E4
            \uD544\uC694\uB294 \uC5C6\uC5B4\uC694.\n\uADF8 \uC120\uD0DD\uC740 \uB8E8\uC774\uC2A4\uB2D8
            \uD63C\uC790 \uD55C \uAC8C \uC544\uB2C8\uB2C8\uAE4C\uC694."
        - SpeakerId: 3
          Text: "\uC544\uB2C8.\n\uC5B4\uCA4C\uBA74 \uC120\uD0DD\uD560 \uAE30\uD68C\uC870\uCC28
            \uC5C6\uC5C8\uB358 \uAC78\uC9C0\uB3C4 \uBAA8\uB974\uC9C0."
        IsSuccess: 1
      - ChoiceIndex: 3
        Lines:
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC740 \uB9C8\uB825\uC758 \uD750\uB984\uC73C\uB85C
            \uACF5\uACA9\uC744 \uBA3C\uC800 \uC77D\uACE0 \uC6C0\uC9C1\uC774\uC168\uB358
            \uAC70\uB798\uC694. \uB9C8\uBC95\uC0AC\uB4E4\uC740 \uC815\uB9D0 \uB300\uB2E8\uD574\uC694!
            \n\uC800\uD76C\uC5D0\uAC8C\uB294 \uBCF4\uC774\uC9C0 \uC54A\uB294 \uAC8C
            \uBCF4\uC778\uB2E4\uB2C8. \n\uC544, \uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uB8E8\uC774\uC2A4\uB2D8\uAED8\uB3C4\u2026
            \uBCF4\uC774\uC9C0 \uC54A\uC558\uACA0\uB124\uC694\u2026"
        - SpeakerId: 3
          Text: "\u2026\uADF8 \uB9D0\uC740 \uB0B4\uAC00 \uBABB \uBD10\uC11C \uB2E4\uCCE4\uB2E4\uB294
            \uB73B\uC774\uC57C?"
        - SpeakerId: 1
          Text: "\uC544, \uC544\uB2C8\uC5D0\uC694.\n\uADF8\uB7F0 \uC758\uBBF8\uB85C
            \uB9D0\uC500\uB4DC\uB9B0 \uAC74 \uC544\uB2C8\uACE0\u2026"
        - SpeakerId: 3
          Text: "\uB9DE\uC544. \uB098\uB294 \uBABB \uBD24\uC5B4.\n\uC0C8\uD134\uC774
            \uBCF8 \uB9C8\uB825\uC758 \uD750\uB984\uC744 \uB098\uB294 \uBCF4\uC9C0
            \uBABB\uD588\uC9C0."
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC744 \uD0D3\uD558\uB824\uB358 \uAC74 \uC544\uB2C8\uC5C8\uC5B4\uC694\u2026
            \uC8C4\uC1A1\uD574\uC694."
        - SpeakerId: 3
          Text: "\uAD1C\uCC2E\uC544. \uD558\uC9C0\uB9CC \uADF8\uAC74 \uB0B4\uAC00
            \uC774\uBBF8 \uACC4\uC18D \uC0DD\uAC01\uD558\uB358 \uC77C\uC774\uC57C."
        - SpeakerId: 1
          Text: "\uACC4\uC18D\uC774\uC694?"
        - SpeakerId: 3
          Text: "\uB0B4\uAC00 \uADF8\uB54C \uC870\uAE08\uB9CC \uB354 \uBE68\uB9AC
            \uC54C\uC544\uCC28\uB838\uB2E4\uBA74.\n\uC870\uAE08\uB9CC \uB354 \uBE68\uB9AC
            \uC6C0\uC9C1\uC600\uB2E4\uBA74.\n\uADF8 \uC0DD\uAC01\uC740 \uC774\uBBF8
            \uCDA9\uBD84\uD788 \uD588\uC5B4."
        - SpeakerId: 1
          Text: "\uADF8\uB7EC\uBA74 \uC0C8\uD134\uB2D8\uC774 \uC6D0\uB9DD\uC2A4\uB7FD\uC9C0\uB294
            \uC54A\uC73C\uC138\uC694?\n\uD63C\uC790\uB9CC \uC54C\uACE0 \uC6C0\uC9C1\uC778
            \uAC83\uCC98\uB7FC \uBCF4\uC77C \uC218\uB3C4 \uC788\uC796\uC544\uC694."
        - SpeakerId: 3
          Text: "\uC0C8\uD134\uC740 \uACF5\uACA9\uC744 \uB9C9\uC73C\uB824\uACE0 \uC6C0\uC9C1\uC778
            \uAC70\uC57C.\n\uC0C8\uD134\uC774 \uADF8\uB54C \uC7AC\uBE60\uB974\uAC8C
            \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uB354 \uB9CE\uC740
            \uC0AC\uB78C\uC774 \uB2E4\uCCE4\uC744\uC9C0\uB3C4 \uBAB0\uB77C."
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uC815\uB9D0 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uC138\uC694?"
        - SpeakerId: 3
          Text: "\uC751. \uADF8\uB798\uC11C \uB354 \uAD34\uB85C\uC6B4 \uAC70\uC57C.
            \uB204\uAD6C\uB97C \uD0D3\uD560 \uC218 \uC5C6\uC73C\uB2C8\uAE4C."
        IsSuccess: 0
  - CharacterId: 4
    CharacterFullName: "\uB370\uC6B0\uC2A4"
    CharacterRole: 
    CharacterIcon: {fileID: 21300000, guid: 484145e7050ecd2428f736cb1261a825, type: 3}
    FinalTalk:
      IntroLines:
      - SpeakerId: 4
        Text: "\uBB34\uC2A8 \uC77C\uC778\uAC00\uC694 \uC5D4\uBE44\uB2D8?\n\uC5EC\uC2E0\uB2D8\uAED8
          \uC870\uC6A9\uD788 \uAE30\uB3C4 \uB4DC\uB9AC\uACE0 \uC2F6\uC73C\uC2E0\uAC00\uC694?"
      - SpeakerId: 1
        Text: "\uC557, \uC544\uB1E8! \uC5EC\uC2E0\uB2D8\uAED8\uB294 \uB2E4\uC74C\uC5D0
          \uAE30\uB3C4 \uB4DC\uB9B4\uAC8C\uC694.\n\uADF8\uB0A0 \uC77C\uC5D0 \uB300\uD574
          \uB4E4\uC740 \uAC8C \uC788\uC5B4\uC694.\n\uB370\uC6B0\uC2A4\uB2D8\uAED8\uB294
          \uB9D0\uC500\uB4DC\uB9AC\uB294 \uAC8C \uC88B\uC744 \uAC83 \uAC19\uC544\uC11C\uC694."
      Question: 
      Choices:
      - "\uBA54\uC774\uB2D8\uC774 \uBA3C\uC800 \uB3CC\uACA9\uD558\uC9C0 \uC54A\uC558\uB2E4\uBA74,
        \uB370\uC6B0\uC2A4\uB2D8\uB3C4 \uADF8\uB807\uAC8C \uAE09\uD558\uAC8C \uAE30\uB3C4\uD560
        \uD544\uC694\uB294 \uC5C6\uC5C8\uC744 \uAC70\uC608\uC694. \uB108\uBB34 \uC790\uCC45\uD558\uC9C0
        \uB9C8\uC138\uC694."
      - "\uC0C8\uD134\uB2D8\uC740 \uD6C4\uBC29 \uACF5\uACA9\uC744 \uB9C9\uC73C\uB824\uACE0
        \uC6C0\uC9C1\uC778 \uAC70\uB798\uC694. \uACF5\uACA9\uC744 \uCE74\uC6B4\uD130
        \uD558\uAE34 \uD588\uC9C0\uB9CC\u2026 \uB8E8\uC774\uC2A4\uB2D8\uB3C4 \uACE0\uB824\uD588\uB2E4\uBA74
        \uC88B\uC558\uC744\uD150\uB370 \uB9D0\uC774\uC5D0\uC694."
      - "\uC0C8\uD134\uB2D8\uC740 \uB370\uC6B0\uC2A4\uB2D8\uC774 \uB8E8\uC774\uC2A4\uB2D8
        \uACC1\uC5D0 \uC788\uC73C\uB2C8 \uAD1C\uCC2E\uB2E4\uACE0 \uBBFF\uC5C8\uB358
        \uAC83 \uAC19\uC544\uC694. \uB370\uC6B0\uC2A4\uB2D8\uC774\uB77C\uBA74 \uC9C0\uD0AC
        \uC218 \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD588\uB358 \uAC70\uACA0\uC8E0."
      - "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uC2F8\uC6B8\uC9C0 \uB3C4\uB9DD\uCE60\uC9C0
        \uC815\uD558\uC9C0 \uBABB\uD574\uC11C \uC804\uC7A5 \uC911\uAC04\uC5D0 \uB0A8\uC544
        \uC788\uC5C8\uB358 \uAC83 \uAC19\uC544\uC694. \uADF8\uB807\uAC8C \uC624\uB798
        \uB9DD\uC124\uC774\uC2E0 \uC774\uC720\uAC00 \uBB50\uC600\uC744\uAE4C\uC694\u2026"
      CorrectIndex: 1
      ResultDialogues:
      - ChoiceIndex: 0
        Lines:
        - SpeakerId: 1
          Text: "\uBA54\uC774\uB2D8\uC774 \uBA3C\uC800 \uB3CC\uACA9\uD558\uC9C0 \uC54A\uC558\uB2E4\uBA74,
            \uB370\uC6B0\uC2A4\uB2D8\uB3C4 \uADF8\uB807\uAC8C \uAE09\uD558\uAC8C
            \uAE30\uB3C4\uD560 \uD544\uC694\uB294 \uC5C6\uC5C8\uC744 \uAC70\uC608\uC694.
            \uB108\uBB34 \uC790\uCC45\uD558\uC9C0 \uB9C8\uC138\uC694."
        - SpeakerId: 4
          Text: "\uBA54\uC774\uB2D8\uC774 \uBA3C\uC800 \uC6C0\uC9C1\uC778 \uAC74
            \uC0AC\uC2E4\uC785\uB2C8\uB2E4."
        - SpeakerId: 1
          Text: "\uADF8\uB7EC\uB2C8\uAE4C \uB370\uC6B0\uC2A4\uB2D8 \uD63C\uC790 \uC790\uCC45\uD558\uC2E4
            \uC77C\uC740 \uC544\uB2C8\uC5D0\uC694.\n\uC560\uCD08\uC5D0 \uC804\uD22C\uAC00
            \uADF8\uB807\uAC8C \uAC11\uC790\uAE30 \uC2DC\uC791\uB418\uC9C0 \uC54A\uC558\uB2E4\uBA74\u2026"
        - SpeakerId: 4
          Text: "\uD558\uC9C0\uB9CC \uBC84\uD504\uB97C \uAC78\uAE30\uB85C \uD55C
            \uAC74 \uC81C \uC120\uD0DD\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
        - SpeakerId: 1
          Text: "\uB124? \uADF8\uAC74 \uBA54\uC774\uB2D8\uC774 \uC694\uCCAD\uD558\uC168\uB358
            \uAC70\uC796\uC544\uC694."
        - SpeakerId: 4
          Text: "\uC694\uCCAD\uC744 \uBC1B\uC558\uB2E4\uACE0 \uD574\uC11C \uCC45\uC784\uC774
            \uC0AC\uB77C\uC9C0\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4.\n\uC800\uB294
            \uAE30\uB3C4\uD558\uB294 \uB3D9\uC548 \uB208\uC744 \uAC10\uC544\uC57C
            \uD55C\uB2E4\uB294 \uAC78 \uC54C\uACE0 \uC788\uC5C8\uC5B4\uC694."
        - SpeakerId: 1
          Text: "\uB370\uC6B0\uC2A4\uB2D8\uC740 \uC815\uB9D0 \uBAA8\uB4E0 \uAC78
            \uBCF8\uC778 \uD0D3\uC73C\uB85C \uB3CC\uB9AC\uC2DC\uB294\uAD70\uC694."
        - SpeakerId: 4
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC774 \uB2E4\uCE5C \uC21C\uAC04 \uC800\uB294
            \uB208\uC744 \uAC10\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8 \uC0AC\uC2E4\uC740
            \uBC14\uB00C\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
        IsSuccess: 0
      - ChoiceIndex: 1
        Lines:
        - SpeakerId: 4
          Text: "\uC0C8\uD134\uB2D8\uC740 \uD6C4\uBC29 \uACF5\uACA9\uC744 \uB9C9\uAE30
            \uC704\uD574 \uC6C0\uC9C1\uC774\uC168\uC2B5\uB2C8\uB2E4.\n\uADF8 \uD310\uB2E8\uC774
            \uD2C0\uB838\uB2E4\uACE0 \uB9D0\uD560 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
        - SpeakerId: 1
          Text: "\uB124.\n\uC800\uB3C4 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD574\uC694.\n\uC0C8\uD134\uB2D8\uC774
            \uC544\uB2C8\uC5C8\uB2E4\uBA74 \uB354 \uD070 \uD53C\uD574\uAC00 \uB0AC\uC744\uC9C0\uB3C4
            \uBAA8\uB974\uC8E0."
        - SpeakerId: 4
          Text: "\uADF8\uB807\uC2B5\uB2C8\uB2E4."
        - SpeakerId: 1
          Text: "\uD558\uC9C0\uB9CC \uB8E8\uC774\uC2A4\uB2D8\uC740 \uADF8 \uC790\uB9AC\uC5D0
            \uB0A8\uC544 \uC788\uC5C8\uC796\uC544\uC694.\n\uB370\uC6B0\uC2A4\uB2D8\uC774
            \uAE30\uB3C4 \uC911\uC774\uB77C \uBCFC \uC218 \uC5C6\uB358 \uB3D9\uC548\uC5D0\uB3C4\uC694."
        - SpeakerId: 4
          Text: "\u2026\u2026"
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC740 \uB9C8\uB825 \uD750\uB984\uB3C4, \uD6C4\uBC29
            \uACF5\uACA9\uB3C4 \uBCF4\uC168\uB294\uB370\u2026\n\uB8E8\uC774\uC2A4\uB2D8\uC774
            \uC704\uD5D8\uD55C \uC704\uCE58\uC5D0 \uC788\uB2E4\uB294 \uAC83\uB3C4
            \uBCF4\uC600\uC744 \uD150\uB370\uC694."
        - SpeakerId: 4
          Text: "\uC0C8\uD134\uB2D8\uC740 \uBAA8\uB450\uB97C \uC9C0\uD0A4\uB824 \uD558\uC168\uC744
            \uAC81\uB2C8\uB2E4."
        - SpeakerId: 1
          Text: "\uBB3C\uB860\uC774\uC8E0.\n\uB2E4\uB9CC \uADF8 \uBAA8\uB450 \uC548\uC5D0
            \uB8E8\uC774\uC2A4\uB2D8\uC774 \uC870\uAE08 \uB2A6\uAC8C \uB4E4\uC5B4\uAC04
            \uAC83 \uAC19\uC544\uC11C\uC694."
        - SpeakerId: 4
          Text: "\u2026\u2026"
        - SpeakerId: 1
          Text: "\uB370\uC6B0\uC2A4\uB2D8\uC740 \uC0C8\uD134\uB2D8\uC744 \uBBFF\uACE0
            \uBD80\uD0C1\uD558\uC168\uB358 \uAC70\uC796\uC544\uC694.\n\uAE30\uB3C4\uD558\uB294
            \uB3D9\uC548\uB9CC\uC774\uB77C\uB3C4 \uB8E8\uC774\uC2A4\uB2D8 \uACC1\uC5D0
            \uC788\uC5B4\uB2EC\uB77C\uACE0\uC694."
        - SpeakerId: 4
          Text: "\uC800\uB294\u2026 \uADF8\uB807\uAC8C \uBD80\uD0C1\uB4DC\uB838\uC2B5\uB2C8\uB2E4."
        - SpeakerId: 1
          Text: "\uADF8\uB7F0\uB370 \uC0C8\uD134\uB2D8\uC740 \uD6C4\uBC29\uC744 \uBCF4\uC168\uACE0,
            \uB8E8\uC774\uC2A4\uB2D8\uC740 \uC4F0\uB7EC\uC84C\uC5B4\uC694."
        - SpeakerId: 4
          Text: "\uADF8\uB9CC\uD558\uC2ED\uC2DC\uC624."
        - SpeakerId: 1
          Text: "\uC8C4\uC1A1\uD574\uC694.\n\uC800\uB294 \uADF8\uB0E5\u2026 \uB370\uC6B0\uC2A4\uB2D8\uB9CC
            \uACC4\uC18D \uC790\uCC45\uD558\uC2DC\uB294 \uAC8C \uC548\uD0C0\uAE4C\uC6CC\uC11C\uC694."
        - SpeakerId: 4
          Text: "\uC0C8\uD134\uB2D8\uC744 \uC6D0\uB9DD\uD574\uC11C\uB294 \uC548 \uB429\uB2C8\uB2E4."
        - SpeakerId: 1
          Text: "\uB124."
        - SpeakerId: 4
          Text: "\uADF8\uB7F0\uB370\u2026"
        - SpeakerId: 1
          Text: "\u2026\u2026"
        - SpeakerId: 4
          Text: "\uC65C \uB8E8\uC774\uC2A4\uB2D8\uC740 \uADF8 \uC790\uB9AC\uC5D0
            \uD63C\uC790 \uB0A8\uC544 \uC788\uC5C8\uC744\uAE4C\uC694.\n\uC774\uBC88\uB9CC\uD07C\uC740
            \uB3C4\uC800\uD788 \uCC38\uC744 \uC218\uAC00 \uC5C6\uB124\uC694."
        IsSuccess: 1
      - ChoiceIndex: 2
        Lines:
        - SpeakerId: 4
          Text: "\uCC45\uC784\uC744 \uB5A0\uB118\uACBC\uB2E4\uACE0\uC694?"
        - SpeakerId: 1
          Text: "\uC544, \uB108\uBB34 \uC138\uAC8C \uB9D0\uD588\uB098\uC694?\n\uB2E4\uB4E4
            \uB370\uC6B0\uC2A4\uB2D8\uC774 \uB8E8\uC774\uC2A4\uB2D8\uC744 \uCC59\uAE38
            \uAC70\uB77C\uACE0 \uBBFF\uC5C8\uB358 \uAC83 \uAC19\uC544\uC11C\uC694."
        - SpeakerId: 4
          Text: "\uADF8\uAC74 \uB5A0\uB118\uAE34 \uAC83\uC774 \uC544\uB2D9\uB2C8\uB2E4.\n\uBBFF\uC5B4\uC900
            \uAC83\uC774\uACA0\uC8E0."
        - SpeakerId: 1
          Text: "\uD558\uC9C0\uB9CC \uB370\uC6B0\uC2A4\uB2D8\uC740 \uAE30\uB3C4 \uC911\uC774\uC168\uC796\uC544\uC694."
        - SpeakerId: 4
          Text: "\uADF8\uB807\uB2E4\uBA74 \uC81C\uAC00 \uB354 \uC870\uC2EC\uD588\uC5B4\uC57C
            \uD569\uB2C8\uB2E4."
        - SpeakerId: 1
          Text: "\uB370\uC6B0\uC2A4\uB2D8\uAED8\uB9CC \uB108\uBB34 \uAC00\uD639\uD55C
            \uAC83 \uAC19\uC544\uC694."
        - SpeakerId: 4
          Text: "\uC544\uB2C8\uC694.\n\uB204\uAD70\uAC00 \uC800\uB97C \uBBFF\uC5C8\uB2E4\uBA74,
            \uADF8 \uBBFF\uC74C\uC744 \uAC00\uBCCD\uAC8C \uC5EC\uACA8\uC11C\uB294
            \uC548 \uB429\uB2C8\uB2E4."
        - SpeakerId: 1
          Text: "\u2026\u2026"
        - SpeakerId: 4
          Text: "\uD558\uC9C0\uB9CC \uADF8\uAC83 \uB54C\uBB38\uC5D0 \uB2E4\uB978
            \uBD84\uB4E4\uC744 \uC6D0\uB9DD\uD558\uACE0 \uC2F6\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4.\n\uBBFF\uC74C\uC740
            \uBE44\uB09C\uC774 \uC544\uB2C8\uB2C8\uAE4C\uC694."
        IsSuccess: 0
      - ChoiceIndex: 3
        Lines:
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uC2F8\uC6B8\uC9C0 \uB3C4\uB9DD\uCE60\uC9C0
            \uC815\uD558\uC9C0 \uBABB\uD574\uC11C \uC804\uC7A5 \uC911\uAC04\uC5D0
            \uB0A8\uC544 \uC788\uC5C8\uB358 \uAC83 \uAC19\uC544\uC694. \n\uADF8\uB807\uAC8C
            \uC624\uB798 \uB9DD\uC124\uC774\uC2E0 \uC774\uC720\uAC00 \uBB50\uC600\uC744\uAE4C\uC694\u2026"
        - SpeakerId: 4
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uC2E0\uC911\uD55C \uBD84\uC785\uB2C8\uB2E4.
            \n\uBD84\uBA85 \uB9C8\uB545\uD55C \uC774\uC720\uAC00 \uC788\uC5C8\uC744
            \uAC83\uC785\uB2C8\uB2E4."
        - SpeakerId: 1
          Text: "\uD558\uC9C0\uB9CC \uADF8 \uB9DD\uC124\uC784 \uB54C\uBB38\uC5D0
            \uC704\uD5D8\uD55C \uC704\uCE58\uC5D0 \uB0A8\uAC8C \uB410\uC796\uC544\uC694."
        - SpeakerId: 4
          Text: "\uADF8\uAC74 \uB8E8\uC774\uC2A4\uB2D8\uB3C4 \uC54C\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uB204\uAD6C\uBCF4\uB2E4\uB3C4
            \uC544\uD504\uAC8C \uC54C\uACE0 \uC788\uC5B4\uC694. \uACB0\uAD6D \uBD80\uC0C1\uB2F9\uD55C
            \uAC83\uB3C4 \uB8E8\uC774\uC2A4\uB2D8\uC774\uC5D0\uC694."
        - SpeakerId: 1
          Text: "\uB370\uC6B0\uC2A4\uB2D8\uC740 \uB8E8\uC774\uC2A4\uB2D8\uC744 \uC6D0\uB9DD\uD558\uC9C0
            \uC54A\uC73C\uC138\uC694?"
        - SpeakerId: 4
          Text: "\uC6D0\uB9DD\uC774\uC694?\n\uC800\uB294 \uB9E4\uC77C \uC5EC\uC2E0\uB2D8\uAED8
            \uAE30\uB3C4 \uB4DC\uB9AC\uACE0 \uC788\uC5B4\uC694. \n\uB8E8\uC774\uC2A4\uB2D8\uC774
            \uC5B4\uB5BB\uAC8C\uB4E0 \uC0B4\uC544\uACC4\uC154\uC11C \uAC10\uC0AC\uD558\uB2E4\uACE0."
        - SpeakerId: 1
          Text: "\uADF8\uB798\uB3C4 \uADF8 \uD310\uB2E8\uC774 \uB2A6\uC5B4\uC11C\u2026"
        - SpeakerId: 4
          Text: "\uADF8\uB9CC\uD558\uC138\uC694.\n\uB8E8\uC774\uC2A4\uB2D8\uC740
            \uC774\uBBF8 \uCDA9\uBD84\uD788 \uC790\uC2E0\uC744 \uD0D3\uD558\uACE0
            \uC788\uC2B5\uB2C8\uB2E4."
        IsSuccess: 0
  - CharacterId: 5
    CharacterFullName: "\uD1A0\uB2C8"
    CharacterRole: 
    CharacterIcon: {fileID: 21300000, guid: b084f8f70a654704f8aac460b6217ca0, type: 3}
    FinalTalk:
      IntroLines:
      - SpeakerId: 5
        Text: "\uC73C\uC74C... \uC5D4\uBE44?\n\uB098\uD55C\uD14C \uD560 \uB9D0 \uC788\uC5B4?"
      - SpeakerId: 1
        Text: "\uB124.\n\uADF8\uB0A0 \uBB3C\uD488\uC744 \uC9C0\uD0A4\uC168\uB358
          \uC77C\uC5D0 \uB300\uD574\uC11C\uC694."
      Question: 
      Choices:
      - "\uBA54\uC774\uB2D8 \uAC19\uC740 \uBD84\uC740 \uBB3C\uD488\uC744 \uC6B0\uC120\uC2DC\uD55C
        \uD1A0\uB2C8\uB2D8\uC758 \uD310\uB2E8\uC744 \uC774\uD574\uD558\uC9C0 \uBABB\uD560
        \uC218\uB3C4 \uC788\uACA0\uC8E0."
      - "\uD504\uB9AC\uB4DC\uB2D8\uC774 \uADF8\uB7EC\uB358\uB370\uC694? \uBB3C\uD488\uC744
        \uC9C0\uD0A4\uACE0 \uC788\uB294 \uD1A0\uB2C8\uB2D8 \uB54C\uBB38\uC5D0, \uB8E8\uC774\uC2A4\uB2D8\uC5D0\uAC8C
        \uBC29\uC5B4\uBCBD\uC744 \uC50C\uC6B8 \uC218 \uC5C6\uC5C8\uB2E4\uACE0\uC694."
      - "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uACB0\uAD6D \uD06C\uAC8C \uB2E4\uCE58\uC168\uC9C0\uB9CC,
        \uD1A0\uB2C8\uB2D8\uC774 \uBB3C\uD488\uC744 \uC9C0\uCF30\uB358 \uC120\uD0DD\uC744
        \uC874\uC911\uD588\uC744 \uAC70\uC5D0\uC694."
      - "\uC0C8\uD134\uB2D8\uC740 \uBB34\uC5C7\uBCF4\uB2E4 \uBAA8\uB450\uB97C \uC704\uD55C
        \uD310\uB2E8\uC744 \uD588\uB358 \uAC70\uC5D0\uC694. \uBB3C\uD488\uC744 \uC9C0\uD0A4\uB294
        \uAC78 \uC6B0\uC120\uC2DC\uD55C \uD1A0\uB2C8\uB2D8\uCC98\uB7FC\uC774\uC694."
      CorrectIndex: 1
      ResultDialogues:
      - ChoiceIndex: 0
        Lines:
        - SpeakerId: 1
          Text: "\uBA54\uC774\uB2D8 \uAC19\uC740 \uBD84\uC740 \uBB3C\uD488\uC744
            \uC6B0\uC120\uC2DC\uD55C \uD1A0\uB2C8\uB2D8\uC758 \uD310\uB2E8\uC744
            \uC774\uD574\uD558\uC9C0 \uBABB\uD560 \uC218\uB3C4 \uC788\uACA0\uC8E0."
        - SpeakerId: 5
          Text: "\uBA54\uC774\uB294\u2026 \uADF8\uB7F4 \uC218\uB3C4 \uC788\uC9C0."
        - SpeakerId: 1
          Text: "\uBA54\uC774\uB2D8\uC740 \uB4DC\uB798\uACE4\uC744 \uC7A1\uB294 \uCABD\uC744
            \uB354 \uC911\uC694\uD558\uAC8C \uBD24\uC73C\uB2C8\uAE4C\uC694."
        - SpeakerId: 5
          Text: "\uC751. \uBA54\uC774\uB294 \uB298 \uC55E\uC73C\uB85C \uAC00\uB294
            \uC0AC\uB78C\uC774\uB2C8\uAE4C."
        - SpeakerId: 1
          Text: "\uC11C\uC6B4\uD558\uC9C0 \uC54A\uC73C\uC138\uC694?\n\uD1A0\uB2C8\uB2D8\uB3C4
            \uC784\uBB34\uB97C \uC9C0\uD0A4\uB824\uACE0 \uD55C \uAC74\uB370\uC694."
        - SpeakerId: 5
          Text: "\uC870\uAE08\uC740.\n\uD558\uC9C0\uB9CC \uBA54\uC774\uB3C4 \uC6A9\uBCD1\uB2E8\uC744
            \uC704\uD574 \uADF8\uB7F0 \uAC70\uC796\uC544."
        - SpeakerId: 1
          Text: "\uD1A0\uB2C8\uB2D8\uC740 \uBA54\uC774\uB2D8\uC744 \uC774\uD574\uD558\uC2DC\uB124\uC694."
        - SpeakerId: 5
          Text: "\uC774\uD574\uD55C\uB2E4\uAE30\uBCF4\uB2E4\u2026 \uB2E4\uB4E4 \uC790\uAE30
            \uBC29\uC2DD\uC774 \uC788\uC5C8\uB358 \uAC70\uACA0\uC9C0."
        IsSuccess: 0
      - ChoiceIndex: 1
        Lines:
        - SpeakerId: 1
          Text: "\uD504\uB9AC\uB4DC\uB2D8\uC774 \uADF8\uB7EC\uB358\uB370\uC694? \uBB3C\uD488\uC744
            \uC9C0\uD0A4\uACE0 \uC788\uB294 \uD1A0\uB2C8\uB2D8\uC744 \uC704\uD574,
            \uB8E8\uC774\uC2A4\uB2D8\uC5D0\uAC8C \uBC29\uC5B4\uBCBD\uC744 \uC50C\uC6B8
            \uC218 \uC5C6\uC5C8\uB2E4\uACE0\uC694."
        - SpeakerId: 5
          Text: "\u2026\uBB50?"
        - SpeakerId: 1
          Text: "\uC544, \uC815\uD655\uD788 \uADF8\uB7F0 \uB9D0\uC740 \uC544\uB2C8\uC5C8\uC5B4\uC694.\n\uD558\uC9C0\uB9CC
            \uD504\uB9AC\uB4DC\uB2D8\uC774 \uD1A0\uB2C8\uB2D8\uACFC \uBB3C\uD488\uC758
            \uC704\uCE58\uB97C \uC2E0\uACBD \uC4F0\uC168\uB358 \uAC74 \uB9DE\uB294
            \uAC83 \uAC19\uC544\uC694."
        - SpeakerId: 5
          Text: "\uB098 \uB54C\uBB38\uC5D0?"
        - SpeakerId: 1
          Text: "\uD1A0\uB2C8\uB2D8\uC740 \uBB3C\uD488\uC744 \uC9C0\uD0A4\uB824\uACE0
            \uD558\uC2E0 \uAC70\uC796\uC544\uC694.\n\uADF8\uAC74 \uB2F9\uC5F0\uD55C
            \uC77C\uC774\uC8E0."
        - SpeakerId: 5
          Text: "\uADF8\uB7F0\uB370 \uD504\uB9AC\uB4DC\uAC00 \uB098\uB97C \uC2E0\uACBD
            \uC4F0\uB290\uB77C \uB8E8\uC774\uC2A4\uB97C \uBABB \uC9C0\uAF08\uB2E4\uACE0?"
        - SpeakerId: 1
          Text: "\uD504\uB9AC\uB4DC\uB2D8\uC740 \uBAA8\uB450\uB97C \uC9C0\uD0A4\uACE0
            \uC2F6\uC5B4 \uD558\uC168\uC73C\uB2C8\uAE4C\uC694.\n\uD1A0\uB2C8\uB2D8\uB3C4,
            \uBB3C\uD488\uB3C4, \uBA54\uC774\uB2D8\uB3C4."
        - SpeakerId: 5
          Text: "\uB098\uB294 \uBC29\uD574\uAC00 \uC548 \uB418\uB824\uACE0 \uD53C\uD55C
            \uAC74\uB370."
        - SpeakerId: 1
          Text: "\uB124. \uADF8\uB798\uC11C \uB354 \uC548\uD0C0\uAE4C\uC6B4 \uAC70\uC608\uC694."
        - SpeakerId: 5
          Text: "\uB0B4\uAC00 \uAC00\uB9CC\uD788 \uC788\uC5C8\uC73C\uBA74\u2026 \uD504\uB9AC\uB4DC\uAC00
            \uB35C \uD5F7\uAC08\uB838\uC744\uAE4C?"
        - SpeakerId: 1
          Text: "\uADF8\uAC74 \uC800\uB3C4 \uBAA8\uB974\uACA0\uC5B4\uC694.\n\uD558\uC9C0\uB9CC
            \uD504\uB9AC\uB4DC\uB2D8\uC740 \uD1A0\uB2C8\uB2D8 \uC704\uCE58\uB97C
            \uD655\uC778\uD558\uB294 \uC989\uC2DC \uBC29\uC5B4\uBCBD\uC744 \uD3BC\uCE58\uB824\uACE0
            \uD588\uB358 \uAC83 \uAC19\uC544\uC694."
        - SpeakerId: 5
          Text: "\uACB0\uAD6D \uB610 \uB098\uB124."
        - SpeakerId: 1
          Text: "\uD1A0\uB2C8\uB2D8 \uC798\uBABB\uC774\uB77C\uACE0 \uB9D0\uD558\uB824\uB358
            \uAC74 \uC544\uB2C8\uC5D0\uC694."
        - SpeakerId: 5
          Text: "\uC544\uB2C8.\n\uADF8\uB7F0 \uB73B\uC774 \uC544\uB2C8\uC5B4\uB3C4
            \uADF8\uB807\uAC8C \uB4E4\uB824."
        IsSuccess: 1
      - ChoiceIndex: 2
        Lines:
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uACB0\uAD6D \uD06C\uAC8C \uB2E4\uCE58\uC168\uC9C0\uB9CC,
            \uD1A0\uB2C8\uB2D8\uC774 \uBB3C\uD488\uC744 \uC9C0\uCF30\uB358 \uC120\uD0DD\uC744
            \uC874\uC911\uD588\uC744 \uAC70\uC5D0\uC694."
        - SpeakerId: 5
          Text: "\uB8E8\uC774\uC2A4\uAC00?"
        - SpeakerId: 1
          Text: "\uB124. \uB8E8\uC774\uC2A4\uB2D8\uC740 \uC2E0\uC911\uD55C \uBD84\uC774\uB2C8\uAE4C\uC694.\n\uC784\uBB34\uC758
            \uC911\uC694\uC131\uB3C4 \uC54C\uACE0 \uC788\uC5C8\uC744 \uAC70\uC608\uC694."
        - SpeakerId: 5
          Text: "\uADF8\uB7AC\uC73C\uBA74 \uC88B\uACA0\uB2E4.\n\uD1A0\uB2C8\uB294\u2026
            \uB3C4\uC6C0\uC774 \uB418\uACE0 \uC2F6\uC5C8\uC5B4."
        - SpeakerId: 1
          Text: "\uB9DE\uC544\uC694. \uD1A0\uB2C8\uB2D8\uC740 \uBB3C\uD488\uC744
            \uC9C0\uCF30\uC796\uC544\uC694.\n\uBD84\uBA85 \uB3C4\uC6C0\uC774 \uB418\uC168\uC744
            \uAC70\uC5D0\uC694."
        - SpeakerId: 5
          Text: "\uC751.\n\uADF8\uAC74 \uB0B4\uAC00 \uD574\uC57C \uD560 \uC77C\uC774\uC5C8\uC5B4."
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4 \uB2D8\uC740 \uB2E4\uCCE4\uC9C0\uB9CC, \uBD84\uBA85
            \uAE08\uBC29 \uD68C\uBCF5\uD558\uC2E4\uAC70\uC5D0\uC694."
        - SpeakerId: 5
          Text: "\u2026\uB8E8\uC774\uC2A4 \uC544\uD504\uBA74 \uC548\uB3FC."
        - SpeakerId: 1
          Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uD1A0\uB2C8\uB2D8\uC744 \uD0D3\uD558\uC9C0
            \uC54A\uC744 \uAC70\uC608\uC694."
        - SpeakerId: 5
          Text: "\u2026\uADF8\uB7AC\uC73C\uBA74 \uC88B\uACA0\uB124."
        IsSuccess: 0
      - ChoiceIndex: 3
        Lines:
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC740 \uBB34\uC5C7\uBCF4\uB2E4 \uBAA8\uB450\uB97C
            \uC704\uD55C \uD310\uB2E8\uC744 \uD588\uB358 \uAC70\uC5D0\uC694. \n\uBB3C\uD488\uC744
            \uC9C0\uD0A4\uB294 \uAC78 \uC6B0\uC120\uC2DC\uD55C \uD1A0\uB2C8\uB2D8\uCC98\uB7FC\uC694."
        - SpeakerId: 5
          Text: "\uB098\uB791 \uC0C8\uD134\uC744 \uBE44\uAD50\uD558\uB294 \uAC70\uC57C?"
        - SpeakerId: 1
          Text: "\uB458 \uB2E4 \uC790\uAE30 \uC790\uB9AC\uC5D0\uC11C \uC911\uC694\uD55C
            \uAC78 \uC9C0\uD0A4\uB824\uACE0 \uD588\uC73C\uB2C8\uAE4C\uC694."
        - SpeakerId: 5
          Text: "\uC0C8\uD134\uC740 \uD6C4\uBC29\uC744 \uB9C9\uC558\uACE0, \uB098\uB294
            \uBB3C\uD488\uC744 \uC9C0\uCF30\uC9C0."
        - SpeakerId: 1
          Text: "\uB124. \uB458 \uB2E4 \uD544\uC694\uD55C \uC77C\uC774\uC5C8\uC5B4\uC694."
        - SpeakerId: 5
          Text: "\uADF8\uB807\uAC8C \uB9D0\uD574\uC8FC\uBA74 \uACE0\uB9D9\uAE34 \uD55C\uB370\u2026\n\uADF8\uAC8C
            \uB098\uB97C \uB35C \uBB34\uC12D\uAC8C \uB9CC\uB4E4\uC9C0\uB294 \uC54A\uC544."
        - SpeakerId: 1
          Text: "\uC65C\uC694?"
        - SpeakerId: 5
          Text: "\uC0C8\uD134\uC740 \uBAA8\uB450\uB97C \uC9C0\uCF30\uC5B4.\n\uB098\uB294
            \uADF8\uB0E5 \uBB3C\uAC74\uC744 \uC548\uACE0 \uB3C4\uB9DD\uCE5C \uAC83\uCC98\uB7FC
            \uBCF4\uC600\uC796\uC544."
        - SpeakerId: 1
          Text: "\uD1A0\uB2C8\uB2D8\uC740 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uC138\uC694?"
        - SpeakerId: 5
          Text: "\uC751.\n\uADF8\uB798\uC11C \uBE44\uAD50\uD558\uBA74 \uB354 \uCD08\uB77C\uD574."
        IsSuccess: 0
  - CharacterId: 6
    CharacterFullName: "\uD504\uB9AC\uB4DC"
    CharacterRole: 
    CharacterIcon: {fileID: 21300000, guid: 80338f499f9f79640aa74de2ef72030c, type: 3}
    FinalTalk:
      IntroLines:
      - SpeakerId: 6
        Text: "\uBB34\uC2A8\uC77C\uC774\uC9C0, \uC5D4\uBE44?\n\uC774\uB807\uAC8C
          \uB530\uB85C \uBD80\uB97C \uC815\uB3C4\uBA74 \uAC00\uBCBC\uC6B4 \uC774\uC57C\uAE30\uB294
          \uC544\uB2C8\uACA0\uAD70."
      - SpeakerId: 1
        Text: "\uB124.\n\uADF8\uB0A0 \uC77C\uC5D0 \uB300\uD574 \uB4E4\uC740 \uAC8C
          \uC788\uC5B4\uC11C\uC694."
      Question: 
      Choices:
      - "\uB370\uC6B0\uC2A4\uB2D8\uC740 \uBA54\uC774\uB2D8\uC744 \uC704\uD574 \uAE30\uB3C4
        \uC911\uC774\uB77C \uC804\uC7A5\uC744 \uBCFC \uC218 \uC5C6\uC5B4\uC11C \uB8E8\uC774\uC2A4\uB2D8\uC744
        \uC9C0\uD0AC \uC218 \uC5C6\uC5C8\uB300\uC694. \uB370\uC6B0\uC2A4 \uB2D8\uC740
        \uB8E8\uC774\uC2A4 \uB2D8\uC774 \uB2E4\uCCD0\uC11C \uB9CE\uC774 \uC2AC\uD37C\uD558\uACE0
        \uACC4\uC138\uC694\u2026"
      - "\uBA54\uC774\uB2D8\uC758 \uC798\uBABB\uB41C \uD310\uB2E8\uB9CC \uC544\uB2C8\uC5C8\uB2E4\uBA74,
        \uC774 \uBAA8\uB4E0 \uC77C\uC740 \uACB0\uAD6D \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC558\uACA0\uC8E0\u2026"
      - "\uD504\uB9AC\uB4DC\uB2D8\uC774 \uBC29\uC5B4\uBCBD\uC744 \uCF1C\uB824\uB358
        \uC21C\uAC04, \uD1A0\uB2C8\uB2D8\uACFC \uBB3C\uD488\uC774 \uC5B4\uB514 \uC788\uB294\uC9C0
        \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4\uC694. \uC65C
        \uADF8\uB7F0 \uD589\uB3D9\uC744 \uD558\uC168\uB358 \uAC78\uAE4C\uC694\u2026"
      - "\uC0C8\uD134\uB2D8\uC774 \uB4DC\uB798\uACE4\uC758 \uD6C4\uBC29 \uACF5\uACA9\uC744
        \uCE74\uC6B4\uD130 \uD558\uC9C0 \uC54A\uC558\uB2E4\uBA74, \uD504\uB9AC\uB4DC\uB2D8\uC758
        \uBC29\uC5B4\uBCBD\uB9CC\uC73C\uB85C\uB294 \uB9C9\uAE30 \uC5B4\uB824\uC6E0\uC744\uC9C0\uB3C4
        \uBAB0\uB77C\uC694."
      CorrectIndex: 2
      ResultDialogues:
      - ChoiceIndex: 0
        Lines:
        - SpeakerId: 1
          Text: "\uB370\uC6B0\uC2A4\uB2D8\uC740 \uBA54\uC774\uB2D8\uC744 \uC704\uD574
            \uAE30\uB3C4 \uC911\uC774\uB77C \uC804\uC7A5\uC744 \uBCFC \uC218 \uC5C6\uC5B4\uC11C
            \uB8E8\uC774\uC2A4\uB2D8\uC744 \uC9C0\uD0AC \uC218 \uC5C6\uC5C8\uB300\uC694.
            \n\uB370\uC6B0\uC2A4 \uB2D8\uC740 \uB8E8\uC774\uC2A4 \uB2D8\uC774 \uB2E4\uCCD0\uC11C
            \uB9CE\uC774 \uC2AC\uD37C\uD558\uACE0 \uACC4\uC138\uC694\u2026"
        - SpeakerId: 6
          Text: "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uB97C \uC544\uB080\uB2E4."
        - SpeakerId: 1
          Text: "\uB124. \uB9CE\uC774\uC694.\n\uADF8\uB798\uC11C \uB354 \uB9C8\uC74C
            \uC544\uD30C\uD558\uC2DC\uB294 \uAC83 \uAC19\uC544\uC694."
        - SpeakerId: 6
          Text: "\uADF8\uAC74 \uB370\uC6B0\uC2A4\uC758 \uC8C4\uAC00 \uC544\uB2C8\uC57C.\n\uAE30\uB3C4
            \uC911\uC5D0\uB294 \uB370\uC6B0\uC2A4\uAC00 \uC544\uBB34\uAC83\uB3C4
            \uBCFC \uC218 \uC5C6\uB2E4\uB294 \uAC74 \uC6B0\uB9AC\uB3C4 \uC54C\uACE0
            \uC788\uC5C8\uC9C0."
        - SpeakerId: 1
          Text: "\uADF8\uB798\uB3C4 \uB8E8\uC774\uC2A4\uB2D8\uC774 \uB2E4\uCCE4\uC796\uC544\uC694."
        - SpeakerId: 6
          Text: "\uB204\uAD70\uAC00\uB97C \uD0D3\uD558\uAE30 \uC2DC\uC791\uD558\uBA74
            \uB05D\uC774 \uC5C6\uC5B4.\n\uB370\uC6B0\uC2A4\uB294 \uC790\uC2E0\uC774
            \uD560 \uC218 \uC788\uB294 \uAC78 \uD588\uC5B4."
        - SpeakerId: 1
          Text: "\uD504\uB9AC\uB4DC\uB2D8\uC740 \uB370\uC6B0\uC2A4\uB2D8\uC744 \uC6D0\uB9DD\uD558\uC9C0
            \uC54A\uC73C\uC138\uC694?"
        - SpeakerId: 6
          Text: "\uC6D0\uB9DD\uBCF4\uB2E4 \uBA3C\uC800 \uC0DD\uAC01\uD574\uC57C \uD560
            \uAC8C \uC788\uC5B4.\n\uB0B4\uAC00 \uC5B4\uB514\uAE4C\uC9C0 \uC9C0\uD0AC
            \uC218 \uC788\uC5C8\uB294\uC9C0."
        IsSuccess: 0
      - ChoiceIndex: 1
        Lines:
        - SpeakerId: 1
          Text: "\uBA54\uC774\uB2D8\uC758 \uC798\uBABB\uB41C \uD310\uB2E8\uB9CC \uC544\uB2C8\uC5C8\uB2E4\uBA74,
            \uC774 \uBAA8\uB4E0 \uC77C\uC740 \uACB0\uAD6D \uC77C\uC5B4\uB098\uC9C0
            \uC54A\uC558\uACA0\uC8E0\u2026"
        - SpeakerId: 6
          Text: "\uBA54\uC774\uAC00 \uBA3C\uC800 \uC6C0\uC9C1\uC778 \uAC74 \uB9DE\uB2E4."
        - SpeakerId: 1
          Text: "\uADF8 \uD310\uB2E8\uC774 \uB108\uBB34 \uC131\uAE09\uD588\uB358
            \uAC83 \uAC19\uC544\uC694."
        - SpeakerId: 6
          Text: "\uC131\uAE09\uD588\uC9C0.\n\uD558\uC9C0\uB9CC \uBA54\uC774\uB294
            \uB298 \uAE30\uD68C\uB97C \uC7A1\uB294 \uC0AC\uB78C\uC774\uC57C."
        - SpeakerId: 1
          Text: "\uADF8 \uB54C\uBB38\uC5D0 \uBAA8\uB450\uAC00 \uD718\uB9D0\uB838\uB294\uB370\uB3C4\uC694?"
        - SpeakerId: 6
          Text: "\uADF8\uAC78 \uC804\uBD80 \uBA54\uC774 \uD0D3\uC73C\uB85C \uB3CC\uB9AC\uBA74
            \uB098\uB294 \uD3B8\uD574\uC9C0\uACA0\uC9C0.\n\uD558\uC9C0\uB9CC \uADF8\uB0A0
            \uB098\uB294 \uBC29\uC5B4\uBCBD\uC744 \uC81C\uB300\uB85C \uD3BC\uCE58\uC9C0
            \uBABB\uD588\uB2E4."
        - SpeakerId: 1
          Text: "\uADF8\uB798\uB3C4 \uC2DC\uC791\uC740 \uBA54\uC774\uB2D8\uC774\uC5C8\uC796\uC544\uC694."
        - SpeakerId: 6
          Text: "\uC2DC\uC791\uBCF4\uB2E4 \uC911\uC694\uD55C \uAC74 \uADF8 \uB4A4\uC5D0
            \uB204\uAC00 \uBB34\uC5C7\uC744 \uD588\uB294\uC9C0\uC57C."
        IsSuccess: 0
      - ChoiceIndex: 2
        Lines:
        - SpeakerId: 1
          Text: "\uD504\uB9AC\uB4DC\uB2D8\uC774 \uBC29\uC5B4\uBCBD\uC744 \uCF1C\uB824\uB358
            \uC21C\uAC04, \uD1A0\uB2C8\uB2D8\uACFC \uBB3C\uD488\uC774 \uC5B4\uB514
            \uC788\uB294\uC9C0 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4\uC694.
            \n\uC65C \uADF8\uB7F0 \uD589\uB3D9\uC744 \uD558\uC168\uB358 \uAC78\uAE4C\uC694\u2026"
        - SpeakerId: 6
          Text: "\uD1A0\uB2C8\uB294 \uBB3C\uD488\uC744 \uC9C0\uD0A4\uB824 \uD588\uACA0\uC9C0."
        - SpeakerId: 1
          Text: "\uB124. \uC544\uB9C8 \uADF8\uB7AC\uC744 \uAC70\uC608\uC694.\n\uD558\uC9C0\uB9CC
            \uD504\uB9AC\uB4DC\uB2D8\uC740 \uADF8 \uC21C\uAC04 \uD1A0\uB2C8\uB2D8\uC744
            \uCC3E\uACE0 \uACC4\uC168\uC796\uC544\uC694."
        - SpeakerId: 6
          Text: "\uBC29\uC5B4\uBCBD \uC548\uC5D0 \uB123\uC5B4\uC57C \uD588\uC73C\uB2C8\uAE4C."
        - SpeakerId: 1
          Text: "\uC0AC\uB78C\uB3C4, \uBB3C\uD488\uB3C4\uC694?"
        - SpeakerId: 6
          Text: "\uB458 \uB2E4 \uC784\uBB34\uC758 \uC77C\uBD80\uC600\uB2E4.\n\uD1A0\uB2C8\uAC00
            \uC5B4\uB514 \uC788\uB294\uC9C0 \uBAA8\uB974\uBA74 \uBC29\uC5B4 \uBC94\uC704\uB97C
            \uC815\uD560 \uC218 \uC5C6\uC5C8\uB2E4."
        - SpeakerId: 1
          Text: "\uD1A0\uB2C8\uB2D8\uC740 \uBC29\uD574\uB418\uC9C0 \uC54A\uC73C\uB824\uACE0
            \uD53C\uD55C \uAC78\uC9C0\uB3C4 \uBAB0\uB77C\uC694."
        - SpeakerId: 6
          Text: "\uC54C\uACE0 \uC788\uC5B4.\n\uD558\uC9C0\uB9CC \uBCF4\uC774\uC9C0
            \uC54A\uC73C\uBA74 \uC9C0\uD0AC \uC218 \uC5C6\uC5B4."
        - SpeakerId: 1
          Text: "\uD1A0\uB2C8\uB2D8\uB3C4 \uADF8\uAC78 \uC54C\uACE0 \uC788\uC5C8\uC744\uAE4C\uC694?"
        - SpeakerId: 6
          Text: "\u2026\uC544\uB9C8 \uC54C\uACE0 \uC788\uACA0\uC9C0\uB9CC, \uD1A0\uB2C8\uB294
            \uAC81\uC774 \uB9CE\uC73C\uB2C8\uAE4C."
        - SpeakerId: 1
          Text: "\uD1A0\uB2C8\uB2D8\uC740 \uBB3C\uD488\uC744 \uC9C0\uD0A4\uB824 \uD588\uACA0\uC9C0\uB9CC,
            \uADF8 \uB54C\uBB38\uC5D0 \uD504\uB9AC\uB4DC\uB2D8\uC740 \uB354 \uC5B4\uB824\uC6B4
            \uD310\uB2E8\uC744 \uD558\uAC8C \uB41C \uAC70\uB124\uC694."
        - SpeakerId: 6
          Text: "\uB098\uB294 \uBAA8\uB450\uB97C \uC9C0\uD0A4\uACA0\uB2E4\uACE0 \uD588\uC5B4.\n\uADF8\uB7F0\uB370
            \uADF8 \uC21C\uAC04\u2026 \uC5B4\uB514\uB97C \uC9C0\uCF1C\uC57C \uD560
            \uC9C0 \uD310\uB2E8\uD560 \uC218 \uC5C6\uC5C8\uC5B4."
        - SpeakerId: 1
          Text: "\uD1A0\uB2C8\uB2D8\uC774 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4\uBA74
            \uB2EC\uB790\uC744\uAE4C\uC694?"
        - SpeakerId: 6
          Text: "\uC544\uB9C8\uB3C4.\n\uC801\uC5B4\uB3C4 \uB0B4\uAC00 \uB9DD\uC124\uC77C
            \uC774\uC720\uB294 \uD558\uB098 \uC904\uC5C8\uACA0\uC9C0."
        IsSuccess: 1
      - ChoiceIndex: 3
        Lines:
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC774 \uB4DC\uB798\uACE4\uC758 \uD6C4\uBC29 \uACF5\uACA9\uC744
            \uCE74\uC6B4\uD130 \uD558\uC9C0 \uC54A\uC558\uB2E4\uBA74, \n\uD504\uB9AC\uB4DC\uB2D8\uC758
            \uBC29\uC5B4\uBCBD\uB9CC\uC73C\uB85C\uB294 \uB9C9\uAE30 \uC5B4\uB824\uC6E0\uC744\uC9C0\uB3C4
            \uBAB0\uB77C\uC694."
        - SpeakerId: 6
          Text: "\uADF8\uAC74 \uC0AC\uC2E4\uC77C \uAC70\uB2E4.\n\uC0C8\uD134\uC774
            \uB9C9\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uB354 \uD070 \uD53C\uD574\uAC00
            \uB0AC\uACA0\uC9C0."
        - SpeakerId: 1
          Text: "\uADF8\uB7EC\uBA74 \uD504\uB9AC\uB4DC\uB2D8\uC758 \uBC29\uC5B4\uBCBD\uC740
            \uBD80\uC871\uD588\uB358 \uAC78\uAE4C\uC694?"
        - SpeakerId: 6
          Text: "\uBC29\uC5B4\uBCBD\uC5D0\uB294 \uBC94\uC704\uAC00 \uC788\uB2E4.\n\uC804\uBD80\uB97C
            \uB9C9\uC744 \uC218\uB294 \uC5C6\uC5B4."
        - SpeakerId: 1
          Text: "\uADF8\uAC8C \uB9C8\uC74C\uC5D0 \uAC78\uB9AC\uC2DC\uB098\uC694?"
        - SpeakerId: 6
          Text: "\uBB3C\uB860\uC774\uB2E4.\n\uD558\uC9C0\uB9CC \uC0C8\uD134\uC774
            \uD55C \uC77C\uAE4C\uC9C0 \uBD80\uC815\uD558\uACE0 \uC2F6\uC9C0\uB294
            \uC54A\uC544."
        - SpeakerId: 1
          Text: "\uD504\uB9AC\uB4DC\uB2D8\uC740 \uB298 \uBAA8\uB450\uB97C \uC9C0\uD0A4\uB824\uACE0
            \uD558\uC2DC\uB124\uC694."
        - SpeakerId: 6
          Text: "\uADF8\uB7EC\uB824\uACE0 \uD588\uC9C0.\n\uC131\uACF5\uD558\uC9C0
            \uBABB\uD588\uC744 \uBFD0\uC774\uB2E4."
        IsSuccess: 0
  - CharacterId: 7
    CharacterFullName: "\uC0C8\uD134"
    CharacterRole: 
    CharacterIcon: {fileID: 21300000, guid: 8808ade9a103ff54891d0fb0c80bdd0e, type: 3}
    FinalTalk:
      IntroLines:
      - SpeakerId: 7
        Text: "\uC6A9\uAC74\uB9CC \uB9D0\uD574.\n\uC774\uB7F0 \uC2DD\uC73C\uB85C
          \uBD88\uB7EC\uB0B4\uB294 \uAC74 \uC88B\uC544\uD558\uC9C0 \uC54A\uC544."
      - SpeakerId: 1
        Text: "\uADF8\uB0A0 \uC77C\uC5D0 \uB300\uD574 \uB4E4\uC740\uAC8C \uC788\uC5B4\uC11C\uC694.\n\uC0C8\uD134\uB2D8\uC774\uB77C\uBA74
          \uC2E0\uACBD \uC4F0\uC2E4 \uAC83 \uAC19\uC558\uC5B4\uC694."
      Question: 
      Choices:
      - "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uC790\uC2E0\uC774 \uAC00\uB9CC\uD788 \uC788\uB294
        \uAC8C \uD300\uC5D0 \uB3C4\uC6C0\uC744 \uC8FC\uB294 \uAE38\uC774\uB77C\uACE0
        \uC0DD\uAC01\uD588\uC744 \uAC70\uC5D0\uC694."
      - "\uD504\uB9AC\uB4DC\uB2D8\uC740 \uC0C8\uD134\uB2D8\uC774 \uACC4\uC18D \uB8E8\uC774\uC2A4\uB2D8\uC758
        \uC606\uC5D0 \uC788\uC744 \uAC70\uB77C \uBBFF\uACE0 \uC788\uC5C8\uB358 \uAC83
        \uAC19\uC544\uC694."
      - "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uC704\uD5D8\uD55C
        \uC704\uCE58\uC5D0\uC11C \uB9DD\uC124\uC774\uAE30\uB9CC \uD55C \uC790\uC2E0\uC744
        \uC790\uCC45\uD558\uACE0 \uC788\uC5B4\uC694."
      - "\uC0C8\uD134\uB2D8\uC774 \uD6C4\uBC29\uC73C\uB85C \uAC00\uC9C0 \uC54A\uC558\uB2E4\uBA74,
        \uB370\uC6B0\uC2A4\uB2D8\uC774 \uADC0\uD658 \uC8FC\uBB38\uC744 \uC0AC\uC6A9\uD560
        \uC77C\uB3C4 \uC5C6\uC5C8\uACA0\uC8E0."
      CorrectIndex: 3
      ResultDialogues:
      - ChoiceIndex: 0
        Lines:
        - SpeakerId: 1
          Text: "\uD504\uB9AC\uB4DC\uB294 \uADF8\uB807\uAC8C \uB9D0\uD560 \uAC70\uC57C.\n\uC790\uAE30
            \uBCF4\uD638\uB9C9\uC774 \uB2FF\uC9C0 \uC54A\uC740 \uCABD\uC744 \uBA3C\uC800
            \uC0DD\uAC01\uD558\uB294 \uC0AC\uB78C\uC774\uB2C8\uAE4C."
        - SpeakerId: 7
          Text: "\uC0C8\uD134\uB2D8\uC774 \uB9C9\uC544\uC900 \uAC74 \uC778\uC815\uD558\uC2DC\uBA74\uC11C\uB3C4,\n\uB8E8\uC774\uC2A4\uB2D8\uC774
            \uB2E4\uCE5C \uAC74 \uACC4\uC18D \uB9C8\uC74C\uC5D0 \uB0A8\uC544 \uC788\uB294
            \uAC83 \uAC19\uC558\uC5B4\uC694."
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC774 \uB9C9\uC544\uC900 \uAC74 \uC778\uC815\uD558\uC2DC\uBA74\uC11C\uB3C4,\n\uB8E8\uC774\uC2A4\uB2D8\uC774
            \uB2E4\uCE5C \uAC74 \uACC4\uC18D \uB9C8\uC74C\uC5D0 \uB0A8\uC544 \uC788\uB294
            \uAC83 \uAC19\uC558\uC5B4\uC694."
        - SpeakerId: 7
          Text: "\uADF8\uAC74 \uD504\uB9AC\uB4DC\uB2F5\uB124."
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC740\uC694?\n\uB8E8\uC774\uC2A4\uB2D8\uC5D0\uAC8C
            \uD30C\uD3B8\uC774 \uD284 \uAC74 \uC2E0\uACBD \uC4F0\uC774\uC9C0 \uC54A\uC73C\uC138\uC694?"
        - SpeakerId: 7
          Text: "\uC2E0\uACBD \uC4F0\uC5EC.\n\uB0B4 \uCE74\uC6B4\uD130\uAC00 \uC644\uBCBD\uD588\uB2E4\uBA74
            \uBC29\uD5A5\uC774 \uB2EC\uB790\uC744 \uC218\uB3C4 \uC788\uC73C\uB2C8\uAE4C."
        - SpeakerId: 1
          Text: "\uADF8\uB7FC\u2026"
        - SpeakerId: 7
          Text: "\uD558\uC9C0\uB9CC \uADF8\uAC74 \uD504\uB9AC\uB4DC\uB97C \uD5A5\uD55C
            \uC6D0\uB9DD\uB3C4, \uB098\uB97C \uD5A5\uD55C \uC6D0\uB9DD\uB3C4 \uC544\uB2C8\uC57C.\n\uD504\uB9AC\uB4DC\uB294
            \uADF8\uB0E5 \uBABB \uB9C9\uC740 \uC790\uB9AC\uB97C \uAE30\uC5B5\uD558\uB294
            \uAC70\uC57C."
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC740 \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uC73C\uC2DC\uB124\uC694."
        - SpeakerId: 7
          Text: "\uD754\uB4E4\uB9B0\uB2E4\uACE0 \uD574\uC11C \uADF8\uB54C \uB9C9\uC740
            \uD6C4\uBC29 \uACF5\uACA9\uC774 \uC0AC\uB77C\uC9C0\uC9C4 \uC54A\uC544."
        - SpeakerId: 1
          Text: "\u2026\u2026"
        - SpeakerId: 7
          Text: "\uD504\uB9AC\uB4DC\uB294 \uB098\uB97C \uD0D3\uD558\uB824\uB294 \uAC8C
            \uC544\uB2C8\uC57C.\n\uC790\uAE30 \uBCF4\uD638\uB9C9 \uBC16\uC5D0 \uB0A8\uC740
            \uC790\uB9AC\uB97C \uD0D3\uD558\uB294 \uAC70\uC9C0."
        IsSuccess: 0
      - ChoiceIndex: 1
        Lines:
        - SpeakerId: 7
          Text: "\uB370\uC6B0\uC2A4\uB294 \uADF8\uB7F0 \uB9D0\uC744 \uC624\uB798
            \uBD99\uC7A1\uACA0\uC9C0."
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uAED8 \uB8E8\uC774\uC2A4\uB2D8 \uACC1\uC744 \uBD80\uD0C1\uD588\uC5C8\uB2E4\uACE0
            \uD558\uC168\uC5B4\uC694."
        - SpeakerId: 7
          Text: "\uAE30\uC5B5\uD574.\n\uB098\uB3C4 \uC78A\uC740 \uC801 \uC5C6\uC5B4."
        - SpeakerId: 1
          Text: "\uADF8\uB7F0\uB370 \uC0C8\uD134\uB2D8\uC740 \uC6C0\uC9C1\uC774\uC168\uC8E0."
        - SpeakerId: 7
          Text: "\uD6C4\uBC29 \uACF5\uACA9\uC774 \uC654\uC73C\uB2C8\uAE4C.\n\uADF8\uAC78
            \uB9C9\uC9C0 \uC54A\uC73C\uBA74 \uB4A4\uCABD\uC774 \uBB34\uB108\uC84C\uC5B4."
        - SpeakerId: 1
          Text: "\uB370\uC6B0\uC2A4\uB2D8 \uC785\uC7A5\uC5D0\uC11C\uB294,\n\uBD80\uD0C1\uC774
            \uC9C0\uCF1C\uC9C0\uC9C0 \uC54A\uC740 \uAC83\uCC98\uB7FC \uB290\uAEF4\uC84C\uC744\uC9C0\uB3C4
            \uBAB0\uB77C\uC694."
        - SpeakerId: 7
          Text: "\uADF8\uB7F4 \uC218 \uC788\uC5B4."
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC740 \uAD1C\uCC2E\uC73C\uC138\uC694?"
        - SpeakerId: 7
          Text: "\uAD1C\uCC2E\uC9C4 \uC54A\uC544.\n\uD558\uC9C0\uB9CC \uB370\uC6B0\uC2A4\uAC00
            \uB098\uB97C \uC6D0\uB9DD\uD55C\uB2E4\uBA74, \uADF8\uAC74 \uB370\uC6B0\uC2A4\uC758
            \uC8C4\uCC45\uAC10\uC774 \uB2E4\uB978 \uBC29\uD5A5\uC73C\uB85C \uC0C8\uB294
            \uAC70\uC57C."
        - SpeakerId: 1
          Text: "\uB2E4\uB978 \uBC29\uD5A5\uC774\uC694?"
        - SpeakerId: 7
          Text: "\uB370\uC6B0\uC2A4\uB294 \uACB0\uAD6D \uC790\uAE30 \uD0D3\uC73C\uB85C
            \uB3CC\uC544\uAC08 \uC0AC\uB78C\uC774\uC57C.\n\uB0B4\uAC00 \uBB58 \uB9D0\uD574\uB3C4."
        - SpeakerId: 1
          Text: ......
        - SpeakerId: 7
          Text: "\uADF8\uBD80\uD0C1\uC740 \uBB34\uAC70\uC6E0\uC5B4.\n\uD558\uC9C0\uB9CC
            \uADF8 \uC21C\uAC04 \uD6C4\uBC29\uC744 \uB9C9\uB294 \uAC83\uB3C4 \uD544\uC694\uD588\uC5B4.\n\uB458
            \uB2E4 \uC0AC\uC2E4\uC774\uC57C."
        IsSuccess: 0
      - ChoiceIndex: 2
        Lines:
        - SpeakerId: 7
          Text: "\uB8E8\uC774\uC2A4\uB77C\uBA74 \uADF8\uB7F4 \uAC70\uC57C."
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC740 \uD654\uB098\uC9C0 \uC54A\uC73C\uC138\uC694?\n\uB8E8\uC774\uC2A4\uB2D8\uC774
            \uB610 \uB9DD\uC124\uC77C\uC9C0\uB3C4 \uBAA8\uB978\uB2E4\uB294 \uAC8C\uC694."
        - SpeakerId: 7
          Text: "\uD654\uAC00 \uB09C\uB2E4\uAE30\uBCF4\uB2E8...\n\uC704\uD5D8\uD558\uC9C0."
        - SpeakerId: 1
          Text: "\uC704\uD5D8\uD558\uB2E4?"
        - SpeakerId: 7
          Text: "\uB8E8\uC774\uC2A4\uB294 \uB098\uC05C \uD310\uB2E8\uC744 \uD558\uB824\uB358
            \uAC8C \uC544\uB2C8\uC600\uC5B4.\n\uC624\uD788\uB824 \uBAA8\uB450\uB97C
            \uC0DD\uAC01\uD558\uB290\uB77C \uBA48\uCDC4\uC9C0"
        - SpeakerId: 1
          Text: "\uADF8\uB7F0\uB370\uB3C4 \uBB38\uC81C\uC778\uAC00\uC694?"
        - SpeakerId: 7
          Text: "\uC804\uC7A5\uC5D0\uC11C\uB294 \uADF8\uB798.\n\uD558\uC9C0\uB9CC
            \uB8E8\uC774\uC2A4\uAC00 \uADF8\uAC78 \uC54C\uACE0 \uC788\uB2E4\uBA74,
            \uB2E4\uC74C\uC5D4 \uB2EC\uB77C\uC9C8 \uC218\uB3C4 \uC788\uC5B4."
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC740 \uB8E8\uC774\uC2A4\uB2D8\uC744 \uBBFF\uC73C\uC2DC\uB294\uAD70\uC694."
        - SpeakerId: 7
          Text: "\uBBFF\uB294\uB2E4\uAE30\uBCF4\uB2E8, \uBC14\uB014 \uAC00\uB2A5\uC131\uC774
            \uC788\uB2E4\uACE0 \uBCF4\uB294\uAC70\uC57C."
        - SpeakerId: 1
          Text: ......
        - SpeakerId: 7
          Text: "\uB9DD\uC124\uC784\uC740 \uC704\uD5D8\uD574.\n\uD558\uC9C0\uB9CC
            \uC790\uAE30 \uB9DD\uC124\uC784\uC744 \uC54C\uACE0 \uC788\uB294 \uC0AC\uB78C\uC740
            \uC544\uC9C1 \uACE0\uCE60 \uC218 \uC788\uC5B4."
        IsSuccess: 0
      - ChoiceIndex: 3
        Lines:
        - SpeakerId: 7
          Text: "\u2026\u2026\uB204\uAC00 \uADF8\uB807\uAC8C \uB9D0\uD588\uC5B4?"
        - SpeakerId: 1
          Text: "\uB204\uAD6C\uB77C\uACE0 \uB9D0\uD558\uAE34 \uC5B4\uB824\uC6CC\uC694.\n\uADF8\uB0E5
            \uADF8\uB807\uAC8C \uAE30\uC5B5\uD558\uB294 \uBD84\uB4E4\uC774 \uC788\uB294
            \uAC83 \uAC19\uC544\uC11C\uC694."
        - SpeakerId: 7
          Text: "\uB098\uB294 \uD6C4\uBC29\uC73C\uB85C \uB3C4\uB9DD\uCE5C \uAC8C
            \uC544\uB2C8\uC57C.\n\uB9C8\uB825 \uD750\uB984\uC774 \uADF8\uCABD\uC73C\uB85C
            \uBAB0\uB9AC\uACE0 \uC788\uC5C8\uC5B4."
        - SpeakerId: 1
          Text: "\uC54C\uC544\uC694.\n\uD544\uC694\uD55C \uC704\uCE58\uB97C \uC7A1\uC73C\uB824
            \uD558\uC168\uB358 \uAC70\uACA0\uC8E0."
        - SpeakerId: 7
          Text: "\uADF8\uB7FC \uC65C \uADF8\uB7F0 \uC2DD\uC73C\uB85C \uB9D0\uD574?"
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC740 \uC804\uC7A5\uC744 \uB113\uAC8C \uBCF4\uB824\uACE0
            \uC6C0\uC9C1\uC774\uC168\uACE0,\n\uB2E4\uB978 \uBD84\uB4E4\uC740 \uC0C8\uD134\uB2D8\uC774
            \uBA40\uC5B4\uC9C0\uB294 \uAC83\uB9CC \uBD24\uC744 \uC218\uB3C4 \uC788\uC73C\uB2C8\uAE4C\uC694."
        - SpeakerId: 7
          Text: "\u2026\u2026"
        - SpeakerId: 1
          Text: "\uC0C8\uD134\uB2D8\uC774 \uD2C0\uB838\uB2E4\uB294 \uB9D0\uC740 \uC544\uB2C8\uC5D0\uC694.\n\uB2E4\uB9CC
            \uC704\uD5D8\uD55C \uC21C\uAC04\uB9C8\uB2E4 \uD544\uC694\uD55C \uC704\uCE58\uAC00
            \uD6C4\uBC29\uC774\uC5C8\uB2E4\uBA74,\n\uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC740
            \uADF8\uAC78 \uB2E4\uB974\uAC8C \uBD24\uC744\uC9C0\uB3C4 \uBAB0\uB77C\uC694."
        - SpeakerId: 7
          Text: "\uB098\uB294 \uD300\uC744 \uC704\uD574 \uC6C0\uC9C1\uC600\uC5B4."
        - SpeakerId: 1
          Text: "\uB124.\n\uD558\uC9C0\uB9CC \uADF8\uAC78 \uC124\uBA85\uD558\uC9C0
            \uC54A\uC558\uB2E4\uBA74,\n\uB2E4\uB978 \uBD84\uB4E4 \uB208\uC5D0\uB294
            \uADF8\uB0E5 \uBA3C\uC800 \uBE60\uC9C0\uB294 \uC0AC\uB78C\uCC98\uB7FC
            \uBCF4\uC600\uACA0\uC8E0."
        - SpeakerId: 7
          Text: "\u2026\u2026"
        - SpeakerId: 7
          Text: "\uB098\uB294 \uB3C4\uB9DD\uCE5C \uAC8C \uC544\uB2C8\uC57C."
        - SpeakerId: 1
          Text: "\uC54C\uC544\uC694."
        - SpeakerId: 7
          Text: "\uADF8\uB7F0\uB370 \uC544\uBB34\uB3C4 \uADF8\uB807\uAC8C \uBCF4\uC9C0
            \uC54A\uC558\uB2E4\uBA74\u2026\u2026"
        - SpeakerId: 7
          Text: "\u2026\u2026\uBD88\uCF8C\uD558\uB124."
        IsSuccess: 1
