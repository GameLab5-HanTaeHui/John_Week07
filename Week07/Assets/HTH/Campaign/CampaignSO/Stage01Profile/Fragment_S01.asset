  - ProfileClueId: P01_05
    CharacterId: 1
    ClueIndex: 5
    ClueText: "\uC5D4\uBE44\uC758 \uC9C4\uC9DC \uC870\uAC01"
    HintText: "\uC5D4\uBE44\uC758 \uAC00\uC9DC \uC870\uAC01"
    HintDescription: "\uC5D4\uBE44\uC758 \uACF5\uAC1C \uD78C\uD2B8"
    Combo: 
    PlaceName: 
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines: []
    DesignerNote: 
  - ProfileClueId: P02_01
    CharacterId: 2
    ClueIndex: 1
    ClueText: "\uBA54\uC774\uB294 \uC6A9\uBCD1\uB2E8\uC758 \uCE68\uBB35\uC774 \uB4DC\uB798\uACE4\uC744
      \uB193\uCE5C \uC0AC\uAC74\uC5D0\uC11C \uBE44\uB86F\uB418\uC5C8\uB2E4\uACE0
      \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uBA54\uC774\uB294 \uC6A9\uBCD1\uB2E8\uC774 \uC6D0\uB798\uBD80\uD130
      \uC870\uC6A9\uD55C \uBD84\uC704\uAE30\uC600\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0
      \uC788\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uC6A9\uBCD1\uB2E8 \uC2E0\uC785\uACFC\uC758
      \uCCAB \uC778\uC0AC"
    Combo: 0100000002000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uBA54\uC774\uB2D8 \uC548\uB155\uD558\uC138\uC694! \uC7A0\uAE50 \uAD1C\uCC2E\uC73C\uC2E0\uAC00\uC694?"
    - TextId: 2
      Text: "\uC2E0\uC785? \uBB34\uC2A8 \uC77C\uC774\uC57C."
    - TextId: 1
      Text: "\uBCC4\uAC74 \uC544\uB2C8\uC5D0\uC694.\n\uC544\uC9C1 \uC6A9\uBCD1\uB2E8
        \uBD84\uC704\uAE30\uB97C \uC798 \uBAB0\uB77C\uC11C\uC694."
    - TextId: 2
      Text: "\uBD84\uC704\uAE30?"
    - TextId: 1
      Text: "\uB2E4\uB4E4 \uC624\uB798 \uD568\uAED8\uD55C \uAC83 \uAC19\uC740\uB370...
        \uC774\uC0C1\uD558\uAC8C \uC870\uC6A9\uD55C \uAC83 \uAC19\uC544\uC694. \uB2E4\uB4E4
        \uB0B4\uD5A5\uC801\uC778 \uBD84\uB4E4\uC778\uAC00\uC694?"
    - TextId: 2
      Text: "\uC6D0\uB798\uB294 \uC544\uB2C8\uC600\uC9C0."
    - TextId: 1
      Text: "\uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB098\uC694?"
    - TextId: 2
      Text: "\uC788\uC5C8\uC9C0.\n\uC7A1\uC744 \uC218 \uC788\uC5C8\uB358 \uB4DC\uB798\uACE4\uC744
        \uB193\uCE5C \uC77C\uC774."
    - TextId: 1
      Text: "\uB4DC\uB798\uACE4\uC774\uC694?\n\uC778\uC0DD\uC5D0\uC11C \uD55C \uBC88
        \uBCFC\uAE4C \uB9D0\uAE4C \uD55C \uD76C\uADC0\uD55C \uBAAC\uC2A4\uD130\uC778\uB370...!"
    - TextId: 2
      Text: "\uAC70\uC758 \uB05D\uB0AC\uC5C8\uC5B4.\n\uC815\uB9D0 \uAC70\uC758."
    - TextId: 1
      Text: "\uADF8\uB7F0\uB370 \uC5B4\uCA4C\uB2E4\uAC00 \uB193\uCE5C\uAC74\uAC00\uC694...?"
    - TextId: 2
      Text: "...\uADF8\uAC74 \uC544\uC9C1 \uB124\uAC00 \uC54C \uC77C\uC774 \uC544\uB2C8\uC57C."
    DesignerNote: "\uD29C\uD1A0\uB9AC\uC5BC\uC5D0\uC11C \uC5BB\uC744 \uC218 \uC788\uB294
      \uB300\uD654 \uC870\uAC01"
  - ProfileClueId: P02_02
    CharacterId: 2
    ClueIndex: 2
    ClueText: "\uBA54\uC774\uB294 \uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB97C
      \uC6B0\uC120\uD558\uB294 \uD0DC\uB3C4 \uB54C\uBB38\uC5D0 \uC6A9\uBCD1\uB2E8\uC758
      \uAE30\uD68C\uB97C \uB193\uCCE4\uB2E4\uACE0 \uB290\uB07C\uACE0 \uC788\uB2E4."
    HintText: "\uBA54\uC774\uB294 \uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB97C
      \uC6B0\uC120\uD55C \uD310\uB2E8\uC744 \uC6A9\uBCD1\uB2E8\uC744 \uC704\uD55C
      \uD76C\uC0DD\uC774\uB77C\uACE0 \uBC1B\uC544\uB4E4\uC774\uACE0 \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uB418\uC9DA\uC5B4 \uBCF4\uB294
      \uBA54\uC774\uC640 \uB8E8\uC774\uC2A4\uC758 \uAE30\uC5B5"
    Combo: 010000000200000003000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P02_01
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uB8E8\uC774\uC2A4.\n\uADF8\uB0A0 \uB370\uC6B0\uC2A4\uAC00 \uB110 \uBCF4\uC790\uB9C8\uC790
        \uC5B4\uB5A4 \uD45C\uC815\uC744 \uC9C0\uC5C8\uB294\uC9C0 \uC54C\uC544?"
    - TextId: 3
      Text: "\u2026\u2026\uB098\uB3C4 \uC815\uD655\uD788\uB294 \uAE30\uC5B5\uB098\uC9C0
        \uC54A\uC544.\n\uC815\uC2E0\uC774 \uC5C6\uC5C8\uC73C\uB2C8\uAE4C."
    - TextId: 2
      Text: "\uB098\uB294 \uAE30\uC5B5\uD574.\n\uB4DC\uB798\uACE4\uB3C4, \uC804\uD669\uB3C4,
        \uB0B4 \uAC80\uB3C4 \uC548\uC911\uC5D0 \uC5C6\uC5C8\uC5B4.\n\uADF8 \uC560
        \uB208\uC5D0\uB294 \uB108\uBC16\uC5D0 \uC5C6\uC5C8\uC9C0."
    - TextId: 3
      Text: "\uADF8\uAC74 \uB0B4 \uD0D3\uC774\uC57C.\n\uB0B4\uAC00 \uADF8 \uC790\uB9AC\uC5D0
        \uBA48\uCDB0 \uC788\uC9C0 \uC54A\uC558\uB2E4\uBA74\u2014"
    - TextId: 2
      Text: "\uB610 \uB124 \uD0D3\uC774\uB77C\uACE0 \uD558\uB824\uACE0?\n\uB8E8\uC774\uC2A4,
        \uB124\uAC00 \uC4F0\uB7EC\uC9C4 \uAC74 \uC2DC\uC791\uC774\uC5C8\uC5B4.\n\uB05D\uB0B8
        \uAC74 \uB370\uC6B0\uC2A4\uC758 \uC8FC\uBB38\uC774\uC5C8\uACE0."
    - TextId: 3
      Text: "\uBA54\uC774!"
    - TextId: 2
      Text: "\uB098\uB294 \uC544\uC9C1\uB3C4 \uBAA8\uB974\uACA0\uC5B4.\n\uADF8 \uC21C\uAC04
        \uB370\uC6B0\uC2A4\uAC00 \uBCF8 \uAC8C \uC815\uB9D0 \uC6A9\uBCD1\uB2E8\uC774\uC5C8\uB294\uC9C0,\n\uC544\uB2C8\uBA74
        \uB108 \uD558\uB098\uC600\uB294\uC9C0."
    - TextId: 1
      Text: "(\uBA54\uC774\uB294 \uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB9CC
        \uBCF4\uACE0 \uC788\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uB124.)"
    - TextId: 1
      Text: "(\uC544\uC9C1 \uC9C1\uC811 \uB9D0\uD558\uC9C4 \uC54A\uC9C0\uB9CC, \uC6D0\uB9DD\uC740
        \uC774\uBBF8 \uADF8\uCABD\uC73C\uB85C \uD5A5\uD558\uACE0 \uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P02_03
    CharacterId: 2
    ClueIndex: 3
    ClueText: "\uBA54\uC774\uB294 \uB370\uC6B0\uC2A4\uC758 \uADC0\uD658 \uC8FC\uBB38\uC744
      \uAD6C\uC870\uAC00 \uC544\uB2CC \uAE30\uD68C\uB97C \uB04A\uC5B4\uB0B8 \uC120\uD0DD\uC73C\uB85C
      \uBC1B\uC544\uB4E4\uC774\uACE0 \uC788\uB2E4."
    HintText: "\uBA54\uC774\uB294 \uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB97C
      \uC0B4\uB9AC\uAE30 \uC704\uD574 \uADC0\uD658 \uC8FC\uBB38\uC744 \uC4F4 \uC77C\uC744
      \uC774\uD574\uD558\uACE0 \uBC1B\uC544\uB4E4\uC774\uACE0 \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uBC1C\uC0DD\uD55C \uBA54\uC774\uC640
      \uC5F0\uC778\uB4E4\uC758 \uCDA9\uB3CC"
    Combo: 01000000020000000300000004000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites:
    - P02_02
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uADF8\uB0A0 \uB124\uAC00 \uC870\uAE08\uB9CC \uB2A6\uAC8C \uC8FC\uBB38\uC744
        \uC37C\uB2E4\uBA74,\n\uC6B0\uB9AC\uB294 \uB4DC\uB798\uACE4\uC744 \uC7A1\uC558\uC5B4."
    - TextId: 4
      Text: "\uB098\uB294 \uB110 \uBC29\uD574\uD558\uB824\uB358 \uAC8C \uC544\uB2C8\uC57C.\n\uB8E8\uC774\uC2A4\uAC00
        \uC4F0\uB7EC\uC9C4 \uAC78 \uBD24\uACE0, \uADF8 \uC21C\uAC04\uC5D4 \uADC0\uD658\uC2DC\uD0AC
        \uC218\uBC16\uC5D0 \uC5C6\uC5C8\uC5B4."
    - TextId: 2
      Text: "\uADF8\uB798.\n\uB108\uD55C\uD14C\uB294 \uB4DC\uB798\uACE4\uBCF4\uB2E4
        \uB8E8\uC774\uC2A4\uAC00 \uBA3C\uC800\uC600\uACA0\uC9C0."
    - TextId: 3
      Text: "\uBA54\uC774, \uADF8\uB9CC\uD574.\n\uB370\uC6B0\uC2A4\uB294 \uB0A0 \uC0B4\uB9AC\uB824\uACE0
        \uD588\uC5B4."
    - TextId: 2
      Text: "\uADF8\uB9AC\uACE0 \uC6B0\uB9AC\uB294 \uBBF8\uB798\uB97C \uC783\uC5C8\uC9C0."
    - TextId: 4
      Text: "\u2026\u2026\uADF8\uB807\uAC8C \uB9D0\uD558\uC9C0 \uB9C8."
    - TextId: 2
      Text: "\uD2C0\uB9B0 \uB9D0\uC774\uC57C?\n\uB0B4 \uAC80\uC774 \uB2FF\uAE30 \uC9C1\uC804\uC774\uC5C8\uC5B4.\n\uC815\uB9D0\uB85C
        \uB05D\uB0BC \uC218 \uC788\uC5C8\uB2E4\uACE0."
    - TextId: 3
      Text: "\uADF8\uAC74 \uB0B4 \uD0D3\uC774\uC57C.\n\uB0B4\uAC00 \uADF8 \uC790\uB9AC\uC5D0
        \uBA48\uCDB0 \uC788\uC9C0 \uC54A\uC558\uB2E4\uBA74\u2014"
    - TextId: 2
      Text: "\uADF8\uB9CC\uD574, \uB8E8\uC774\uC2A4.\n\uB124\uAC00 \uBA48\uCD98 \uAC74
        \uC2DC\uC791\uC774\uC5C8\uC744 \uBFD0\uC774\uC57C."
    - TextId: 2
      Text: "\uC815\uB9D0 \uB05D\uB09C \uAC74,\n\uADF8 \uC8FC\uBB38\uC774 \uC6B0\uB9AC\uB97C
        \uC804\uC7A5\uC5D0\uC11C \uB5BC\uC5B4\uB0C8\uC744 \uB54C\uC600\uC5B4."
    - TextId: 4
      Text: "\uB098\uB294 \uB8E8\uC774\uC2A4\uB97C \uC783\uC744 \uC218 \uC5C6\uC5C8\uC5B4."
    - TextId: 2
      Text: "\uADF8\uB798\uC11C \uB4DC\uB798\uACE4\uC744 \uC783\uC5C8\uC9C0.\n\uC6B0\uB9AC\uAC00
        \uB354 \uD070 \uBB34\uB300\uB85C \uAC08 \uAE30\uD68C\uAE4C\uC9C0."
    - TextId: 1
      Text: "(\uB370\uC6B0\uC2A4\uC5D0\uAC90 \uAD6C\uC6D0\uC774\uC5C8\uACE0,\n\uBA54\uC774\uC5D0\uAC90
        \uB9C8\uC9C0\uB9C9 \uC77C\uACA9\uC744 \uBE7C\uC557\uC740 \uC8FC\uBB38\uC774\uC5C8\uB124.)"
    - TextId: 1
      Text: "(\uAC19\uC740 \uC120\uD0DD\uB3C4 \uC774\uB807\uAC8C \uAC08\uB77C\uC9C8
        \uC218 \uC788\uAD6C\uB098.)"
    DesignerNote: 
  - ProfileClueId: P02_04
    CharacterId: 2
    ClueIndex: 4
    ClueText: "\uBA54\uC774\uB294 \uD1A0\uB2C8\uAC00 \uB2E8\uC21C\uD788 \uB3C4\uB9DD\uCE5C
      \uAC83\uC774 \uC544\uB2C8\uB77C, \uC790\uAE30 \uBC29\uC2DD\uC73C\uB85C \uC6A9\uBCD1\uB2E8\uC744
      \uC9C0\uD0A4\uB824 \uD588\uC744 \uAC00\uB2A5\uC131\uC744 \uC758\uC2DD\uD558\uACE0
      \uC788\uB2E4."
    HintText: "\uBA54\uC774\uB294 \uD1A0\uB2C8\uAC00 \uBB3C\uD488\uC744 \uCC59\uAE34
      \uD589\uB3D9\uC744 \uCC98\uC74C\uBD80\uD130 \uC6A9\uBCD1\uB2E8\uC744 \uBC84\uB9AC\uAE30
      \uC704\uD55C \uBC30\uC2E0\uC73C\uB85C \uD655\uC2E0\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uCC3D\uACE0\uC5D0\uC11C \uBA54\uC774\uC640 \uD504\uB9AC\uB4DC\uAC00
      \uB418\uC9DA\uC740 \uD1A0\uB2C8\uC758 \uB3C4\uB9DD\uCE5C \uC774\uC720"
    Combo: 010000000200000006000000
    PlaceName: "\uCC3D\uACE0"
    DeadRequired: 
    Prerequisites:
    - P02_03
    SimultaneousIds:
    - P05_03
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uC5EC\uAE34 \uC5EC\uC804\uD788 \uBB3C\uD488\uC774 \uB9CE\uB124.\n\uD1A0\uB2C8\uAC00
        \uB298 \uC2E0\uACBD \uC4F0\uB358 \uAC83\uB4E4."
    - TextId: 6
      Text: "\uD1A0\uB2C8\uB294 \uADF8\uB7F0 \uAC78 \uAC00\uBCCD\uAC8C \uC5EC\uAE30\uC9C0
        \uC54A\uC558\uC5B4.\n\uC758\uB8B0 \uBB3C\uD488\uB3C4, \uBCF4\uAE09\uD488\uB3C4,
        \uACC4\uC57D\uB3C4."
    - TextId: 2
      Text: "\uADF8\uB0A0\uB3C4 \uBB3C\uD488\uC744 \uBA3C\uC800 \uBCF8 \uAC70\uC57C?\n\uB4DC\uB798\uACE4\uC774
        \uB208\uC55E\uC5D0 \uC788\uC5C8\uB294\uB370?"
    - TextId: 6
      Text: "\uD1A0\uB2C8\uB294 \uC2F8\uC6B8 \uC218 \uC5C6\uC5C8\uC5B4.\n\uADF8\uB7EC\uB2C8\uAE4C
        \uC790\uC2E0\uC774 \uD560 \uC218 \uC788\uB294 \uC77C\uC744 \uD558\uB824 \uD588\uACA0\uC9C0."
    - TextId: 2
      Text: "\uADF8\uAC8C \uBB3C\uD488\uC744 \uC9C0\uD0A4\uB294 \uAC70\uC600\uACE0?"
    - TextId: 6
      Text: "\uC544\uB9C8\uB3C4.\n\uD1A0\uB2C8\uC5D0\uAC8C\uB294 \uADF8\uAC8C \uC6A9\uBCD1\uB2E8\uC744
        \uC9C0\uD0A4\uB294 \uBC29\uC2DD\uC774\uC5C8\uC744 \uAC70\uC57C."
    - TextId: 2
      Text: "\u2026\u2026"
    - TextId: 6
      Text: "\uADF8 \uC21C\uAC04 \uD1A0\uB2C8\uC640 \uBB3C\uD488\uC774 \uBCF4\uC774\uC9C0
        \uC54A\uC558\uB358 \uAC83\uB3C4 \uC0AC\uC2E4\uC774\uC57C.\n\uB098\uB294 \uBA54\uC774
        \uB108\uC640, \uD1A0\uB2C8\uC640, \uBB3C\uD488\uAE4C\uC9C0 \uBAA8\uB450 \uBCF4\uB824
        \uD588\uC5B4."
    - TextId: 2
      Text: "\uB098\uB294 \uB4DC\uB798\uACE4\uB9CC \uBCF4\uACE0 \uC788\uC5C8\uACE0,\n\uD1A0\uB2C8\uB294
        \uBB3C\uD488\uC744 \uBCF4\uACE0 \uC788\uC5C8\uACE0,\n\uB108\uB294 \uD769\uC5B4\uC9C4
        \uC804\uC7A5\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4?"
    - TextId: 6
      Text: "\u2026\u2026\uADF8\uB0A0 \uC6B0\uB9AC\uB294 \uC804\uBD80 \uB2E4\uB978
        \uAC78 \uBCF4\uACE0 \uC788\uC5C8\uC5B4."
    - TextId: 1
      Text: "(\uBA54\uC774\uB294 \uD1A0\uB2C8\uB97C \uB2E8\uC21C\uD55C \uB3C4\uB9DD\uC790\uB85C\uB9CC
        \uBCF4\uACE0 \uC788\uC5C8\uC5B4.)"
    - TextId: 1
      Text: "(\uD558\uC9C0\uB9CC \uD1A0\uB2C8\uC5D0\uAC8C\uB3C4 \uC9C0\uD0A4\uB824\uB358
        \uAC8C \uC788\uC5C8\uB2E4\uB294 \uAC70\uB124.)"
    DesignerNote: "\uD574\uB2F9 \uC870\uAC01 \uD68D\uB4DD \uC2DC \uC790\uB3D9\uC73C\uB85C
      P05_03\uC774 \uB3D9\uC2DC \uD68D\uB4DD\uB428"
  - ProfileClueId: P02_05
    CharacterId: 2
    ClueIndex: 5
    ClueText: "\uBA54\uC774\uB294 \uB4A4\uB2A6\uAC8C \uC6A9\uBCD1\uB2E8\uC758 \uBD95\uAD34\uAC00
      \uC11C\uB85C\uC758 \uC624\uD574\uC640 \uCE68\uBB35\uC5D0\uC11C \uBE44\uB86F\uB418\uC5C8\uB2E4\uACE0
      \uAE68\uB2EB\uACE0 \uC788\uB2E4."
    HintText: "\uBA54\uC774\uB294 \uD1A0\uB2C8\uB97C \uCC98\uB2E8\uD55C \uAC83\uC73C\uB85C
      \uC6A9\uBCD1\uB2E8\uC758 \uADE0\uC5F4\uC774 \uC644\uC804\uD788 \uD574\uC18C\uB418\uC5C8\uB2E4\uACE0
      \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uBA54\uC774\uB294 \uD1A0\uB2C8\uB97C \uCC98\uB2E8\uD588\uC9C0\uB9CC,
      \uB0A8\uC740 \uC0AC\uB78C\uC740 \uC544\uBB34\uB3C4 \uC5C6\uC5C8\uB2E4."
    Combo: 010000000200000005000000
    PlaceName: 
    DeadRequired: 03000000040000000600000007000000
    Prerequisites:
    - P02_04
    - P05_01
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uD1A0\uB2C8!!!! \uC5B4\uC9F8\uC11C \uADF8\uB7F0 \uC9D3\uC744 \uD55C
        \uAC70\uC57C!!"
    - TextId: 1
      Text: "\uB054\uCC0D\uD55C \uC9D3\uC744 \uC800\uC9C8\uB800\uC5B4\uC694.. \uB3C4\uB300\uCCB4
        \uC6A9\uBCD1\uB2E8 \uC548\uC5D0\uB294 \uBB34\uC2A8 \uC77C\uC774 \uC788\uB358
        \uAC74\uAC00\uC694? \uB4DC\uB798\uACE4\uACFC \uC870\uC6B0\uD588\uB358 \uADF8
        \uC0AC\uAC74, \uB2E8\uC21C \uD300\uD569\uC758 \uBB38\uC81C\uAC00 \uC544\uB2C8\uC5C8\uB358
        \uAC74\uAC00\uC694?"
    - TextId: 2
      Text: "\uC544\uBB34 \uAC83\uB3C4 \uC228\uAE30\uC9C0 \uC54A\uC558\uC5B4... \uC788\uB294
        \uADF8\uB300\uB85C\uC57C. \uC815\uB9D0 \uC0AC\uC18C\uD55C, \uC544\uC8FC \uC0AC\uC18C\uD55C
        \uC624\uD574 \uD558\uB098\uAC00 \uB208\uB369\uC774\uCC98\uB7FC \uCEE4\uC84C\uC744
        \uBFD0\uC774\uC57C..."
    - TextId: 1
      Text: "\uC815\uB9D0 \uC544\uBB34 \uC77C\uB3C4 \uC5C6\uC5C8\uB2E4\uBA74, \uC774\uB7F0
        \uC2DD\uC73C\uB85C \uC6A9\uBCD1\uB2E8\uC774 \uD30C\uAD6D\uC73C\uB85C \uCE58\uB2EB\uC558\uC744
        \uB9AC \uC5C6\uC796\uC544\uC694!"
    - TextId: 2
      Text: "\uD1A0\uB2C8\uB294 \uB450\uB824\uC6CC\uD588\uC744 \uAC70\uC57C. \uC790\uC2E0\uC774
        \uB3C4\uC6C0\uC774 \uB418\uC9C0 \uBABB\uD588\uB2E4\uB294 \uC0AC\uC2E4 \uC790\uCCB4\uC5D0
        \uC774\uBBF8 \uC9D3\uB20C\uB9AC\uACE0 \uC788\uB294 \uC0C1\uD0DC\uC600\uB358
        \uAC70\uC57C..."
    - TextId: 2
      Text: "\uB2E4\uB4E4 \uB611\uAC19\uC558\uC5B4.. \uB0B4\uAC00 \uB193\uCE58\uACE0
        \uC2F6\uC9C0 \uC54A\uC740 \uAE30\uD68C\uB3C4 \uB3D9\uB8CC\uB4E4\uC758 \uB208\uC5D0\uB294
        \uADF8\uC800 \uBB34\uBAA8\uD55C \uD589\uB3D9\uC73C\uB85C \uBCF4\uC600\uB358
        \uAC70\uACA0\uC9C0. \uB370\uC6B0\uC2A4\uC758 \uADC0\uD658 \uC8FC\uBB38\uB3C4
        \uB9C8\uCC2C\uAC00\uC9C0\uC57C. \uC5B4\uCA4C\uBA74, \uADF8\uB3C4 \uBAA8\uB450\uB97C
        \uC9C0\uD0A4\uAE30 \uC704\uD55C \uCD5C\uC120\uC758 \uC120\uD0DD\uC744 \uD55C
        \uAC78\uC9C0\uB3C4..."
    - TextId: 1
      Text: "\uB9D0\uD558\uC9C0 \uC54A\uC73C\uBA74 \uC54C \uC218 \uC5C6\uB294 \uAC70\uC5D0\uC694.
        \uC0AC\uB78C\uB4E4\uC740 \uAC01\uC790 \uC800\uB9C8\uB2E4\uC758 \uBC29\uC2DD\uC73C\uB85C
        \uC138\uC0C1\uC744 \uD574\uC11D\uD558\uB2C8\uAE4C\uC694."
    - TextId: 2
      Text: "\uADF8\uB798... \uB0A8\uB4E4 \uB208\uC5D0\uB294, \uB0B4\uAC00 \uADF8\uC800
        \uB9E4\uBC88 \uBB34\uB9AC\uD558\uB294 \uBBF8\uB828\uD55C \uC0AC\uB78C\uC73C\uB85C
        \uBCF4\uC600\uC744 \uD14C\uC9C0..."
    - TextId: 2
      Text: "\uC774\uC81C \uB2E4 \uB05D\uB0AC\uC5B4. \uC544\uBB34 \uC18C\uC6A9\uC774
        \uC5C6\uC5B4. \uB193\uCCD0\uBC84\uB9B0 \uB4DC\uB798\uACE4\uB3C4, \uC313\uC5EC\uBC84\uB9B0
        \uC624\uD574\uB3C4... \uBAA8\uB450 \uBB34\uC758\uBBF8\uD574\uC84C\uC5B4."
    - TextId: 1
      Text: "(\uC6A9\uBCD1\uB2E8\uC740 \uC644\uC804\uD788 \uBD95\uAD34 \uB410\uC5B4...
        \uC774\uAC78\uB85C \uC774\uC81C \uB05D\uC778\uAC00?)"
    DesignerNote: 
  - ProfileClueId: P03_01
    CharacterId: 3
    ClueIndex: 1
    ClueText: "\uB8E8\uC774\uC2A4\uB294 \uC798\uBABB \uD310\uB2E8\uD574 \uBAA8\uB450\uC5D0\uAC8C
      \uD53C\uD574\uB97C \uC904\uAE4C \uBD10 \uC27D\uAC8C \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0
      \uBABB\uD55C\uB2E4."
    HintText: "\uB8E8\uC774\uC2A4\uB294 \uC704\uD5D8\uD55C \uC0C1\uD669\uC77C\uC218\uB85D
      \uBE60\uB974\uAC8C \uACB0\uC815\uC744 \uB0B4\uB9AC\uB294 \uAC83\uC774 \uAC00\uC7A5
      \uC911\uC694\uD558\uB2E4\uACE0 \uC0DD\uAC01\uD55C\uB2E4."
    HintDescription: "\uC5EC\uAD00\uC5D0\uC11C \uB098\uB208 \uC2E0\uC785\uACFC \uB8E8\uC774\uC2A4\uC758
      \uCCAB \uC778\uC0AC"
    Combo: 0100000003000000
    PlaceName: "\uC5EC\uAD00"
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uB8E8\uC774\uC2A4\uB2D8, \uB9DE\uC73C\uC2DC\uC8E0?\n\uC624\uB298\uBD80\uD130
        \uD569\uB958\uD558\uAC8C \uB41C \uC5D4\uBE44\uC608\uC694. \uC798 \uBD80\uD0C1\uB4DC\uB824\uC694."
    - TextId: 3
      Text: "\uB8E8\uC774\uC2A4\uC57C. \uB098\uB3C4 \uC798 \uBD80\uD0C1\uD574."
    - TextId: 1
      Text: "\uB2E4\uB4E4 \uC624\uB798 \uD568\uAED8\uD558\uC2E0 \uAC83 \uAC19\uC544\uC11C
        \uC870\uAE08 \uAE34\uC7A5\uD588\uC5B4\uC694.\n\uC81C\uAC00 \uBB54\uAC00 \uC870\uC2EC\uD574\uC57C
        \uD560 \uAC8C \uC788\uC744\uAE4C\uC694?"
    - TextId: 3
      Text: "\uC870\uC2EC\uD574\uC57C \uD560 \uAC83\u2026\u2026"
    - TextId: 1
      Text: "\uC5B4\uB835\uAC8C \uC0DD\uAC01\uD558\uC9C0 \uC54A\uC73C\uC154\uB3C4
        \uB3FC\uC694.\n\uADF8\uB0E5 \uC2E0\uC785\uC5D0\uAC8C \uD574\uC8FC\uACE0 \uC2F6\uC740
        \uB9D0 \uAC19\uC740 \uAC70\uC694."
    - TextId: 3
      Text: "\uBB34\uC5B8\uAC00\uB97C \uC815\uD574\uC57C \uD560 \uB54C\uB294, \uB108\uBB34
        \uBE68\uB9AC \uB2F5\uC744 \uB0B4\uB9AC\uC9C0 \uC54A\uB294 \uAC8C \uC88B\uC544."
    - TextId: 1
      Text: "\uC2E0\uC911\uD558\uAC8C \uD310\uB2E8\uD558\uB77C\uB294 \uB9D0\uC500\uC774\uC2E0\uAC00\uC694?"
    - TextId: 3
      Text: "\uD55C \uBC88 \uC798\uBABB \uC815\uD558\uBA74, \uADF8 \uC120\uD0DD\uC744
        \uB418\uB3CC\uB9B4 \uC218 \uC5C6\uC744 \uB54C\uAC00 \uC788\uAC70\uB4E0."
    - TextId: 1
      Text: "\uADF8\uB7FC \uC5B8\uC81C \uC6C0\uC9C1\uC5EC\uC57C \uD558\uB294\uC9C0\uB294
        \uC5B4\uB5BB\uAC8C \uC544\uB098\uC694?"
    - TextId: 3
      Text: "\uADF8\uAC78 \uC54C \uC218 \uC788\uB2E4\uBA74 \uC88B\uACA0\uC9C0."
    - TextId: 1
      Text: "(\uB8E8\uC774\uC2A4\uB294 \uC27D\uAC8C \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0
        \uBABB\uD558\uB294 \uC0AC\uB78C\uC774\uB124.)"
    - TextId: 1
      Text: "(\uC798\uBABB\uB41C \uD310\uB2E8\uC774 \uB204\uAD70\uAC00\uB97C \uB2E4\uCE58\uAC8C
        \uD560\uAE4C \uBD10 \uB450\uB824\uC6CC\uD558\uACE0 \uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P03_02
    CharacterId: 3
    ClueIndex: 2
    ClueText: "\uB8E8\uC774\uC2A4\uB294 \uBA54\uC774\uAC00 \uC790\uC2E0\uC758 \uD310\uB2E8\uC744
      \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uACE0 \uBA3C\uC800 \uC6C0\uC9C1\uC600\uB2E4\uB294
      \uC0AC\uC2E4\uC744 \uB9C8\uC74C\uC5D0 \uAC78\uB824 \uD558\uACE0 \uC788\uB2E4."
    HintText: "\uB8E8\uC774\uC2A4\uB294 \uBA54\uC774\uAC00 \uC790\uC2E0\uC758 \uD310\uB2E8\uC744
      \uCDA9\uBD84\uD788 \uAE30\uB2E4\uB9B0 \uB4A4 \uD568\uAED8 \uC6C0\uC9C1\uC600\uB2E4\uACE0
      \uAE30\uC5B5\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uB9C8\uC8FC\uD55C \uBA54\uC774\uC640
      \uB8E8\uC774\uC2A4\uC758 \uC5C7\uAC08\uB9B0 \uD310\uB2E8"
    Combo: 010000000200000003000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P03_01
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uADF8\uB0A0 \uB124\uAC00 \uC870\uAE08\uB9CC \uBE68\uB9AC \uC815\uD588\uB2E4\uBA74
        \uB2EC\uB77C\uC84C\uC744\uAE4C?"
    - TextId: 3
      Text: "\u2026\u2026\uBAA8\uB974\uACA0\uC5B4."
    - TextId: 2
      Text: "\uB098\uB294 \uAE30\uB2E4\uB9B4 \uC218 \uC5C6\uC5C8\uC5B4.\n\uADF8\uB54C\uB294
        \uAE30\uD68C\uAC00 \uB208\uC55E\uC5D0 \uC788\uC5C8\uC73C\uB2C8\uAE4C."
    - TextId: 3
      Text: "\uB124\uAC00 \uC65C \uC6C0\uC9C1\uC600\uB294\uC9C0\uB294 \uC54C\uC544."
    - TextId: 2
      Text: "\uADF8\uB7FC \uC544\uC9C1\uB3C4 \uB124 \uD0D3\uC774\uB77C\uACE0 \uC0DD\uAC01\uD574?"
    - TextId: 3
      Text: "\uB0B4\uAC00 \uBA3C\uC800 \uB9D0\uD588\uC5B4\uC57C \uD588\uC5B4.\n\uC2F8\uC6B8\uC9C0,
        \uBB3C\uB7EC\uB0A0\uC9C0."
    - TextId: 2
      Text: "\uADF8 \uB9D0\uC774 \uC5C6\uC73C\uB2C8\uAE4C \uB0B4\uAC00 \uC6C0\uC9C1\uC778
        \uAC70\uC57C."
    - TextId: 3
      Text: "\uADF8\uB798\uC11C \uB354 \uC0DD\uAC01\uB098."
    - TextId: 2
      Text: "\uBB50\uAC00?"
    - TextId: 3
      Text: "\uB124\uAC00 \uD2C0\uB838\uB2E4\uB294 \uAC8C \uC544\uB2C8\uB77C\u2026\n\uB0B4
        \uD310\uB2E8\uC774 \uB05D\uB098\uAE30\uB3C4 \uC804\uC5D0, \uC774\uBBF8 \uC804\uD22C\uAC00
        \uC2DC\uC791\uB410\uB2E4\uB294 \uAC83."
    - TextId: 1
      Text: "(\uBA54\uC774\uB294 \uAE30\uB2E4\uB9B4 \uC218 \uC5C6\uC5C8\uACE0,\n\uB8E8\uC774\uC2A4\uB294
        \uD310\uB2E8\uC744 \uB05D\uB0B4\uC9C0 \uBABB\uD588\uC5B4.)"
    - TextId: 1
      Text: "(\uB8E8\uC774\uC2A4\uD55C\uD14C\uB294 \uADF8\uAC8C \uC544\uC9C1\uB3C4
        \uAC78\uB824 \uC788\uB124.)"
    DesignerNote: 
  - ProfileClueId: P03_03
    CharacterId: 3
    ClueIndex: 3
    ClueText: "\uB8E8\uC774\uC2A4\uB294 \uC790\uC2E0\uC774 \uC6C0\uC9C1\uC774\uBA74
      \uC9C4\uD615\uC774 \uB354 \uD754\uB4E4\uB9B4\uAE4C \uBD10 \uC704\uD5D8\uD55C
      \uC704\uCE58\uC5D0 \uBA48\uCDB0 \uC788\uC5C8\uB2E4."
    HintText: "\uB8E8\uC774\uC2A4\uB294 \uC790\uC2E0\uC758 \uC548\uC804\uB9CC\uC744
      \uC704\uD574 \uC77C\uBD80\uB7EC \uC804\uC7A5 \uD55C\uAC00\uC6B4\uB370\uC5D0
      \uBA38\uBB3C\uB800\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uC0C8\uD134\uC774 \uB418\uC9DA\uC740
      \uADF8\uB0A0 \uB8E8\uC774\uC2A4\uC758 \uC704\uCE58"
    Combo: 010000000300000007000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P03_02
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 7
      Text: "\uADF8\uB0A0 \uB10C \uC65C \uADF8 \uC790\uB9AC\uC5D0 \uACC4\uC18D \uC11C
        \uC788\uC5C8\uC5B4?"
    - TextId: 3
      Text: "\uC6C0\uC9C1\uC774\uBA74 \uB354 \uC704\uD5D8\uD574\uC9C8 \uAC83 \uAC19\uC558\uC5B4."
    - TextId: 7
      Text: "\uAC00\uB9CC\uD788 \uC788\uB294 \uAC8C \uB354 \uC704\uD5D8\uD588\uC5B4.\n\uADF8
        \uC704\uCE58\uB294 \uD6C4\uBC29 \uACF5\uACA9\uC774 \uAE68\uC84C\uC744 \uB54C
        \uAC00\uC7A5 \uC548 \uC88B\uC740 \uC790\uB9AC\uC600\uC5B4."
    - TextId: 3
      Text: "\uC9C0\uAE08\uC740 \uC54C\uC544."
    - TextId: 7
      Text: "\uADF8\uB54C\uB3C4 \uC54C\uC558\uC5B4\uC57C\uC9C0."
    - TextId: 3
      Text: "\uADF8\uB54C\uB294\u2026 \uB0B4\uAC00 \uC5B4\uB514\uB85C \uC6C0\uC9C1\uC5EC\uB3C4
        \uB204\uAD70\uAC00\uC758 \uAE38\uC744 \uB9C9\uC744 \uAC83 \uAC19\uC558\uC5B4."
    - TextId: 7
      Text: "\uADF8\uB798\uC11C \uBA48\uCDC4\uACE0?"
    - TextId: 3
      Text: "\uC798\uBABB \uC6C0\uC9C1\uC5EC\uC11C \uC9C4\uD615\uC744 \uB9DD\uCE60\uAE4C
        \uBD10.."
    - TextId: 7
      Text: "\uADF8 \uB9DD\uC124\uC784 \uB54C\uBB38\uC5D0 \uC9C4\uD615\uC740 \uB354
        \uBD88\uC548\uD574\uC84C\uC5B4."
    - TextId: 3
      Text: "\u2026\u2026\uADF8\uB807\uACA0\uC9C0."
    - TextId: 1
      Text: "(\uB8E8\uC774\uC2A4\uB294 \uB3C4\uB9DD\uCE58\uB824\uACE0 \uBA48\uCD98
        \uAC8C \uC544\uB2C8\uC57C.)"
    - TextId: 1
      Text: "(\uC798\uBABB \uC6C0\uC9C1\uC77C\uAE4C \uBD10 \uBA48\uCDC4\uACE0, \uADF8\uAC8C
        \uB354 \uD070 \uBE48\uD2C8\uC774 \uB41C \uAC70\uB124.)"
    DesignerNote: 
  - ProfileClueId: P03_04
    CharacterId: 3
    ClueIndex: 4
    ClueText: "\uB8E8\uC774\uC2A4\uB294 \uC790\uC2E0\uC774 \uADF8\uB0A0 \uC544\uBB34
      \uACB0\uC815\uB3C4 \uB0B4\uB9AC\uC9C0 \uBABB\uD588\uB2E4\uB294 \uC0AC\uC2E4\uC744
      \uC544\uC9C1 \uC790\uCC45\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uB8E8\uC774\uC2A4\uB294 \uADF8\uB0A0 \uC790\uC2E0\uC774 \uCDA9\uBD84\uD788
      \uBA85\uD655\uD55C \uC9C0\uC2DC\uB97C \uB0B4\uB838\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0
      \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uB9C8\uC8FC\uD55C \uB8E8\uC774\uC2A4\uC640
      \uB370\uC6B0\uC2A4\uC758 \uBA48\uCD98 \uD310\uB2E8"
    Combo: 010000000300000004000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites:
    - P03_03
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uADF8\uB0A0 \uC77C, \uC544\uC9C1\uB3C4 \uB124 \uD0D3\uC774\uB77C\uACE0
        \uC0DD\uAC01\uD574?"
    - TextId: 3
      Text: "\u2026\u2026\uC544\uB2C8\uB77C\uACE0 \uB9D0\uD558\uACE0 \uC2F6\uC5B4.\n\uADF8\uB7F0\uB370
        \uC798 \uC548 \uB3FC."
    - TextId: 4
      Text: "\uB124\uAC00 \uB2E4\uCE5C \uAC74 \uB124 \uC798\uBABB\uC774 \uC544\uB2C8\uC57C."
    - TextId: 3
      Text: "\uB0B4\uAC00 \uB2E4\uCE5C \uAC83\uBCF4\uB2E4,\n\uC544\uBB34 \uB9D0\uB3C4
        \uD558\uC9C0 \uBABB\uD588\uB2E4\uB294 \uAC8C \uB354 \uC624\uB798 \uB0A8\uC544."
    - TextId: 3
      Text: "\uC2F8\uC6B0\uC790\uACE0 \uB9D0\uD558\uC9C0\uB3C4 \uBABB\uD588\uACE0,\n\uBB3C\uB7EC\uB098\uC790\uACE0
        \uB9D0\uD558\uC9C0\uB3C4 \uBABB\uD588\uC5B4."
    - TextId: 3
      Text: "\uADF8\uB0E5 \uACC4\uC18D \uC0DD\uAC01\uB9CC \uD588\uC5B4.\n\uC5B4\uB290
        \uCABD\uC774 \uB354 \uB35C \uC704\uD5D8\uD55C\uC9C0."
    - TextId: 4
      Text: "\uADF8 \uC0C1\uD669\uC5D0\uC11C \uBC14\uB85C \uC815\uD558\uB294 \uAC74
        \uB204\uAD6C\uC5D0\uAC8C\uB3C4 \uC26C\uC6B4 \uC77C\uC774 \uC544\uB2C8\uC5C8\uC5B4."
    - TextId: 3
      Text: "\uD558\uC9C0\uB9CC \uB204\uAD70\uAC00\uB294 \uC815\uD588\uC5B4\uC57C
        \uD588\uC5B4.\n\uADF8\uAC8C \uB0B4\uAC00 \uD574\uC57C \uD560 \uC77C\uC774\uC5C8\uB2E4\uBA74\u2026"
    - TextId: 1
      Text: "(\uB8E8\uC774\uC2A4\uB294 \uB2E4\uCE5C \uAC83\uBCF4\uB2E4,\n\uC544\uBB34
        \uACB0\uC815\uB3C4 \uB0B4\uB9AC\uC9C0 \uBABB\uD588\uB2E4\uB294 \uAC78 \uB354
        \uAD34\uB85C\uC6CC\uD558\uACE0 \uC788\uB124.)"
    - TextId: 1
      Text: "(\uC800 \uCE68\uBB35\uC740 \uC544\uC9C1 \uB8E8\uC774\uC2A4 \uC548\uC5D0
        \uB0A8\uC544 \uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P03_05
    CharacterId: 3
    ClueIndex: 5
    ClueText: "\uB8E8\uC774\uC2A4\uB294 \uBA54\uC774\uAC00 \uC790\uC2E0\uC758 \uD310\uB2E8\uC744
      \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uACE0 \uBA3C\uC800 \uB3CC\uACA9\uD55C \uC77C\uC774
      \uC544\uC9C1 \uB9C8\uC74C\uC5D0 \uB0A8\uC544 \uC788\uB2E4."
    HintText: "\uB8E8\uC774\uC2A4\uB294 \uBA54\uC774\uAC00 \uC790\uC2E0\uC758 \uD310\uB2E8\uC744
      \uCDA9\uBD84\uD788 \uAE30\uB2E4\uB9B0 \uB4A4 \uC6C0\uC9C1\uC600\uB2E4\uACE0
      \uBC1B\uC544\uB4E4\uC774\uACE0 \uC788\uB2E4."
    HintDescription: "\uC5EC\uAD00\uC5D0 \uBAA8\uC778 \uBA54\uC774, \uB8E8\uC774\uC2A4,
      \uB370\uC6B0\uC2A4, \uC0C8\uD134\uC758 \uC5C7\uAC08\uB9B0 \uD310\uB2E8"
    Combo: 0100000002000000030000000400000007000000
    PlaceName: "\uC5EC\uAD00"
    DeadRequired: 
    Prerequisites:
    - P03_04
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uB8E8\uC774\uC2A4, \uADF8\uB0A0 \uB124\uAC00 \uC870\uAE08\uB9CC \uBE68\uB9AC
        \uB9D0\uD588\uC5B4\uB3C4 \uB2EC\uB77C\uC84C\uC744\uAE4C?\n\uAE30\uD68C\uAC00
        \uB208\uC55E\uC5D0 \uC788\uC5C8\uC73C\uB2C8\uAE4C \uAE30\uB2E4\uB9B4 \uC218
        \uC5C6\uC5C8\uC5B4."
    - TextId: 4
      Text: "\uBA54\uC774, \uC9C0\uAE08 \uADF8 \uB9D0\uC744 \uAF2D \uD574\uC57C \uD574?"
    - TextId: 2
      Text: "\uD574\uC57C \uD574.\n\uC6B0\uB9B0 \uC544\uC9C1\uB3C4 \uADF8\uB0A0\uC5D0
        \uBB36\uC5EC \uC788\uC796\uC544."
    - TextId: 7
      Text: "\uADF8\uB0A0 \uC804\uC7A5\uC740 \uC774\uBBF8 \uC6C0\uC9C1\uC774\uACE0
        \uC788\uC5C8\uC5B4.\n\uBA48\uCD98 \uC0AC\uB78C\uC744 \uAE30\uB2E4\uB824\uC8FC\uC9C4
        \uC54A\uC544."
    - TextId: 3
      Text: "\uB0B4\uAC00 \uB2A6\uC5C8\uB2E4\uB294 \uAC74 \uC54C\uC544."
    - TextId: 2
      Text: "\uB098\uB294 \uB124\uAC00 \uD2C0\uB838\uB2E4\uACE0 \uC0DD\uAC01\uD574\uC11C
        \uC6C0\uC9C1\uC778 \uAC8C \uC544\uB2C8\uC57C.\n\uADF8\uB0E5\u2026 \uB354
        \uAE30\uB2E4\uB9AC\uBA74 \uAE30\uD68C\uAC00 \uC0AC\uB77C\uC9C8 \uAC83 \uAC19\uC558\uC5B4."
    - TextId: 3
      Text: "\uADF8\uB7FC \uB098\uB294 \uBB58 \uD588\uC5B4\uC57C \uD588\uC744\uAE4C?"
    - TextId: 2
      Text: "\uBB50\uB77C\uB3C4 \uB9D0\uD588\uC5B4\uC57C\uC9C0.\n\uC2F8\uC6B0\uC790\uACE0
        \uD558\uB4E0, \uBB3C\uB7EC\uB098\uC790\uACE0 \uD558\uB4E0."
    - TextId: 3
      Text: "\uD55C \uBC88\uCBE4\uC740, \uB0B4 \uD310\uB2E8\uC744 \uAE30\uB2E4\uB824\uC92C\uC73C\uBA74
        \uD588\uC5B4."
    - TextId: 2
      Text: "\uADF8\uB54C\uB294 \uADF8\uB7F4 \uC2DC\uAC04\uC774 \uC5C6\uC5C8\uC5B4."
    - TextId: 3
      Text: "\uC54C\uC544.\n\uADF8\uB798\uC11C \uB124\uAC00 \uBA3C\uC800 \uC6C0\uC9C1\uC774\uB358
        \uC21C\uAC04\uC774 \uACC4\uC18D \uAE30\uC5B5\uC5D0 \uB0A8\uC544."
    - TextId: 3
      Text: "\uB0B4\uAC00 \uB2A6\uC5C8\uB358 \uAC74\uC9C0,\n\uB124\uAC00 \uB108\uBB34
        \uBE68\uB790\uB358 \uAC74\uC9C0 \uC544\uC9C1\uB3C4 \uBAA8\uB974\uACA0\uC5B4."
    - TextId: 1
      Text: "(\uB8E8\uC774\uC2A4\uB294 \uC790\uAE30\uAC00 \uB2A6\uC5C8\uB2E4\uACE0
        \uC0DD\uAC01\uD558\uACE0 \uC788\uC5B4.)"
    - TextId: 1
      Text: "(\uD558\uC9C0\uB9CC \uC9C4\uC9DC \uC0C1\uCC98\uB294, \uBA54\uC774\uAC00
        \uADF8\uC758 \uD310\uB2E8\uC744 \uAE30\uB2E4\uB824\uC8FC\uC9C0 \uC54A\uC558\uB2E4\uB294
        \uAC70\uB124.)"
    DesignerNote: 
  - ProfileClueId: P04_01
    CharacterId: 4
    ClueIndex: 1
    ClueText: "\uB370\uC6B0\uC2A4\uB294 \uC6A9\uBCD1\uB2E8 \uC804\uCCB4\uB97C \uAC71\uC815\uD558\uB294
      \uB4EF \uBCF4\uC774\uC9C0\uB9CC, \uD2B9\uD788 \uB8E8\uC774\uC2A4\uC758 \uC548\uC804\uC744
      \uAC00\uC7A5 \uBA3C\uC800 \uC2E0\uACBD \uC4F0\uACE0 \uC788\uB2E4."
    HintText: "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uBCF4\uB2E4 \uBA54\uC774\uC758
      \uC804\uD22C \uC131\uACFC\uB97C \uAC00\uC7A5 \uC911\uC694\uD558\uAC8C \uC0DD\uAC01\uD558\uACE0
      \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uB9C8\uC8FC\uD55C \uC2E0\uC785\uACFC
      \uB370\uC6B0\uC2A4\uC758 \uCCAB \uC778\uC0AC"
    Combo: 0100000004000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uB370\uC6B0\uC2A4\uB2D8, \uB9DE\uC73C\uC2DC\uC8E0?\n\uC0C8\uB85C \uD569\uB958\uD55C
        \uC5D4\uBE44\uC608\uC694. \uC798 \uBD80\uD0C1\uB4DC\uB824\uC694."
    - TextId: 4
      Text: "\uC2E0\uC785\uC774\uC2DC\uAD70\uC694. \uBC18\uAC11\uC2B5\uB2C8\uB2E4.\n\uD639\uC2DC
        \uB2E4\uCE5C \uACF3\uC774 \uC788\uB2E4\uBA74 \uBC14\uB85C \uB9D0\uC500\uD574\uC8FC\uC138\uC694."
    - TextId: 1
      Text: "\uCC98\uC74C \uBCF4\uB294 \uC0AC\uB78C\uD55C\uD14C\uB3C4 \uBA3C\uC800
        \uC0C1\uD0DC\uBD80\uD130 \uC0B4\uD53C\uC2DC\uB124\uC694?"
    - TextId: 4
      Text: "\uC2B5\uAD00\uC785\uB2C8\uB2E4.\n\uB204\uAC00 \uB2E4\uCE58\uC9C0\uB294
        \uC54A\uC558\uB294\uC9C0 \uBA3C\uC800 \uBCF4\uAC8C \uB418\uAC70\uB4E0\uC694."
    - TextId: 1
      Text: "\uADF8\uC911\uC5D0\uC11C\uB3C4 \uD2B9\uD788 \uC2E0\uACBD \uC4F0\uB294
        \uBD84\uC774 \uC788\uB098\uC694?"
    - TextId: 4
      Text: "\u2026\u2026\uB8E8\uC774\uC2A4\uB2D8\uC785\uB2C8\uB2E4."
    - TextId: 1
      Text: "\uB8E8\uC774\uC2A4\uB2D8\uC774\uC694?"
    - TextId: 4
      Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uAD1C\uCC2E\uB2E4\uACE0 \uB9D0\uC500\uD558\uC154\uB3C4,\n\uAD1C\uCC2E\uC9C0
        \uC54A\uC744 \uB54C\uAC00 \uB9CE\uC73C\uB2C8\uAE4C\uC694."
    - TextId: 1
      Text: "(\uB370\uC6B0\uC2A4\uC758 \uC2DC\uC120\uC740 \uACB0\uAD6D \uB8E8\uC774\uC2A4\uC5D0\uAC8C
        \uD5A5\uD558\uB124.)"
    - TextId: 1
      Text: "(\uC88B\uC544. \uC57D\uD55C \uBD80\uBD84\uC774 \uBCF4\uC600\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P04_02
    CharacterId: 4
    ClueIndex: 2
    ClueText: "\uB370\uC6B0\uC2A4\uB294 \uAE30\uB3C4\uC5D0 \uB4E4\uC5B4\uAC00\uBA74
      \uC804\uC7A5 \uC0C1\uD669\uC744 \uC9C1\uC811 \uBCFC \uC218 \uC5C6\uB2E4\uB294
      \uD55C\uACC4\uB97C \uAC00\uC9C0\uACE0 \uC788\uB2E4."
    HintText: "\uB370\uC6B0\uC2A4\uB294 \uAE30\uB3C4 \uC911\uC5D0\uB3C4 \uC804\uC7A5\uC758
      \uBAA8\uB4E0 \uC0C1\uD669\uC744 \uC815\uD655\uD788 \uD655\uC778\uD560 \uC218
      \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uBA54\uC774\uAC00 \uC9C0\uC801\uD55C
      \uB370\uC6B0\uC2A4\uC758 \uAE30\uB3C4"
    Combo: 010000000200000004000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites:
    - P04_01
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uB370\uC6B0\uC2A4.\n\uB124 \uBC84\uD504\uB294 \uC5EC\uC804\uD788 \uB290\uB9AC\uB124."
    - TextId: 4
      Text: "\uAE30\uB3C4\uC5D0\uB294 \uC2DC\uAC04\uC774 \uD544\uC694\uD569\uB2C8\uB2E4.\n\uAE09\uD558\uAC8C
        \uC678\uC6B4\uB2E4\uACE0 \uB418\uB294 \uC77C\uC774 \uC544\uB2D9\uB2C8\uB2E4."
    - TextId: 2
      Text: "\uC804\uD22C \uC911\uC5D0\uB294 \uADF8 \uC2DC\uAC04\uC774 \uC81C\uC77C
        \uC544\uAE4C\uC6CC.\n\uB208\uC55E\uC5D0\uC11C \uAE30\uD68C\uAC00 \uC0AC\uB77C\uC9C8
        \uC218\uB3C4 \uC788\uC796\uC544."
    - TextId: 4
      Text: "\uC54C\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uD558\uC9C0\uB9CC \uC81C\uB300\uB85C
        \uAE30\uB3C4\uD558\uC9C0 \uC54A\uC73C\uBA74, \uC544\uBB34\uB3C4 \uC9C0\uD0AC
        \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    - TextId: 2
      Text: "\uADF8\uB7FC \uAE30\uB3C4\uD558\uB294 \uB3D9\uC548\uC5D4?\n\uC8FC\uBCC0
        \uC0C1\uD669\uC740 \uC5B4\uB5BB\uAC8C \uBD10?"
    - TextId: 4
      Text: "\u2026\u2026\uBCFC \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uB208\uC744 \uAC10\uACE0
        \uC9D1\uC911\uD574\uC57C \uD558\uB2C8\uAE4C\uC694."
    - TextId: 2
      Text: "\uADF8\uB798\uC11C \uADF8\uB0A0\uB3C4 \uBABB \uBD24\uAD6C\uB098."
    - TextId: 4
      Text: "\uBA54\uC774\uB2D8\u2026"
    - TextId: 2
      Text: "\uC544\uB2C8, \uADF8\uB0E5 \uD655\uC778\uD55C \uAC70\uC57C.\n\uB124\uAC00
        \uB208\uC744 \uAC10\uACE0 \uC788\uB294 \uB3D9\uC548\uC5D0\uB3C4 \uC804\uC7A5\uC740
        \uACC4\uC18D \uC6C0\uC9C1\uC600\uC73C\uB2C8\uAE4C."
    - TextId: 1
      Text: "(\uB370\uC6B0\uC2A4\uB294 \uAE30\uB3C4 \uC911\uC5D4 \uC804\uC7A5\uC744
        \uBCFC \uC218 \uC5C6\uAD6C\uB098.)"
    - TextId: 1
      Text: "(\uADF8 \uBE48\uD2C8\uC5D0 \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB294\uC9C0\uAC00
        \uC911\uC694\uD558\uACA0\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P04_03
    CharacterId: 4
    ClueIndex: 3
    ClueText: "\uB370\uC6B0\uC2A4\uB294 \uAE30\uB3C4\uC5D0 \uB4E4\uC5B4\uAC00\uAE30
      \uC804, \uB8E8\uC774\uC2A4 \uACC1\uC744 \uC9C0\uCF1C\uB2EC\uB77C\uACE0 \uC0C8\uD134\uC5D0\uAC8C
      \uBD80\uD0C1\uD588\uB2E4.."
    HintText: "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uAC00 \uD63C\uC790 \uC788\uC5B4\uB3C4
      \uAD1C\uCC2E\uB2E4\uACE0 \uC0DD\uAC01\uD574 \uC544\uBB34\uC5D0\uAC8C\uB3C4
      \uBD80\uD0C1\uD558\uC9C0 \uC54A\uC558\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uB4DC\uB7EC\uB09C \uB370\uC6B0\uC2A4\uC640
      \uC0C8\uD134\uC758 \uC5C7\uAC08\uB9B0 \uD310\uB2E8"
    Combo: 010000000400000007000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P04_02
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uC0C8\uD134\uB2D8.\n\uADF8\uB0A0 \uC81C\uAC00 \uBB50\uB77C\uACE0 \uBD80\uD0C1\uB4DC\uB838\uB294\uC9C0
        \uAE30\uC5B5\uD558\uC2DC\uB098\uC694?"
    - TextId: 7
      Text: "\uB8E8\uC774\uC2A4 \uACC1\uC5D0 \uC788\uC5B4\uB2EC\uB77C\uACE0 \uD588\uC9C0."
    - TextId: 4
      Text: "\uB124.\n\uC81C\uAC00 \uAE30\uB3C4\uD558\uB294 \uB3D9\uC548\uB9CC\uC774\uB77C\uB3C4\uC694."
    - TextId: 7
      Text: "\uAE30\uC5B5\uD574.\n\uADF8\uB798\uC11C \uCC98\uC74C\uC5D4 \uB8E8\uC774\uC2A4
        \uC606\uC5D0 \uC788\uC5C8\uC5B4."
    - TextId: 4
      Text: "\uADF8\uB7F0\uB370 \uC0C8\uD134\uB2D8\uC740 \uC6C0\uC9C1\uC774\uC168\uC8E0."
    - TextId: 7
      Text: "\uD6C4\uBC29 \uACF5\uACA9\uC774 \uB4E4\uC5B4\uC624\uACE0 \uC788\uC5C8\uC5B4.\n\uADF8\uAC78
        \uB9C9\uC9C0 \uC54A\uC73C\uBA74 \uC804\uC7A5\uC774 \uBB34\uB108\uC84C\uC744
        \uAC70\uC57C."
    - TextId: 4
      Text: "\uADF8\uB798\uB3C4 \uC800\uB294 \uC0C8\uD134\uB2D8\uAED8 \uB8E8\uC774\uC2A4\uB2D8\uC744
        \uBD80\uD0C1\uB4DC\uB838\uC2B5\uB2C8\uB2E4."
    - TextId: 7
      Text: "\uADF8 \uC21C\uAC04\uC5D4 \uB8E8\uC774\uC2A4 \uD55C \uC0AC\uB78C\uB9CC
        \uBCFC \uC218 \uC5C6\uC5C8\uC5B4."
    - TextId: 7
      Text: "\uB0B4\uAC00 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4\uBA74,\n\uB8E8\uC774\uC2A4\uB9CC\uC774
        \uC544\uB2C8\uB77C \uBAA8\uB450\uAC00 \uC704\uD5D8\uD588\uC744 \uAC70\uC57C."
    - TextId: 1
      Text: "(\uB370\uC6B0\uC2A4\uB294 \uC0C8\uD134\uC5D0\uAC8C \uB8E8\uC774\uC2A4\uB97C
        \uB9E1\uACBC\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC788\uB124.)"
    - TextId: 1
      Text: "(\uD558\uC9C0\uB9CC \uC0C8\uD134\uC740 \uB8E8\uC774\uC2A4\uBCF4\uB2E4
        \uD6C4\uBC29 \uACF5\uACA9\uC744 \uBA3C\uC800 \uBD24\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P04_04
    CharacterId: 4
    ClueIndex: 4
    ClueText: "\uB370\uC6B0\uC2A4\uB294 \uC0C8\uD134\uC774 \uD6C4\uBC29\uC744 \uB9C9\uC544\uB0C8\uB2E4\uB294
      \uC0AC\uC2E4\uBCF4\uB2E4, \uB8E8\uC774\uC2A4\uAC00 \uC4F0\uB7EC\uC84C\uB2E4\uB294
      \uACB0\uACFC\uC5D0 \uB354 \uC9D1\uCC29\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uB370\uC6B0\uC2A4\uB294 \uC0C8\uD134\uC774 \uD6C4\uBC29\uC744 \uB9C9\uC544\uB0C8\uAE30
      \uB54C\uBB38\uC5D0 \uB8E8\uC774\uC2A4\uC758 \uBD80\uC0C1 \uC5ED\uC2DC \uC5B4\uCA54
      \uC218 \uC5C6\uB294 \uACB0\uACFC\uC600\uB2E4\uACE0 \uBC1B\uC544\uB4E4\uC774\uACE0
      \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uB8E8\uC774\uC2A4, \uB370\uC6B0\uC2A4,
      \uC0C8\uD134\uC774 \uB9C8\uC8FC\uD55C \uD30C\uD3B8\uC758 \uC9C4\uC0C1"
    Combo: 01000000030000000400000007000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites:
    - P04_03
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uC0C8\uD134\uB2D8.\n\uD6C4\uBC29 \uACF5\uACA9\uC744 \uB9C9\uC558\uB2E4\uACE0
        \uD558\uC168\uC8E0."
    - TextId: 4
      Text: "\uADF8\uB7F0\uB370 \uB8E8\uC774\uC2A4\uB2D8\uC5D0\uAC8C \uB0A0\uC544\uAC04
        \uD30C\uD3B8\uC740 \uBB50\uC600\uB098\uC694?"
    - TextId: 7
      Text: "\uD6C4\uBC29 \uC804\uCCB4\uAC00 \uBB34\uB108\uC9C0\uB294 \uAC74 \uB9C9\uC558\uC5B4.\n\uD558\uC9C0\uB9CC
        \uCE74\uC6B4\uD130\uAC00 \uC644\uBCBD\uD558\uC9C4 \uC54A\uC558\uC5B4."
    - TextId: 3
      Text: "\uB370\uC6B0\uC2A4, \uADF8\uB9CC\uD574.\n\uADF8\uAC74 \uC0C8\uD134\uB9CC\uC758
        \uC798\uBABB\uC774 \uC544\uB2C8\uC57C."
    - TextId: 4
      Text: "\uC800\uB294 \uB208\uC744 \uAC10\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8\uB798\uC11C
        \uC0C8\uD134\uB2D8\uC774 \uB9C9\uC544\uC8FC\uC168\uB2E4\uACE0 \uBBFF\uC744
        \uC218\uBC16\uC5D0 \uC5C6\uC5C8\uC5B4\uC694."
    - TextId: 7
      Text: "\uB0B4\uAC00 \uB193\uCE5C \uAC74 \uD30C\uD3B8\uC774\uC5C8\uC5B4.\n\uACF5\uACA9
        \uC804\uCCB4\uB294 \uC544\uB2C8\uC5C8\uC5B4."
    - TextId: 4
      Text: "\uC800\uC5D0\uAC8C\uB294 \uADF8 \uCC28\uC774\uAC00 \uC911\uC694\uD558\uC9C0
        \uC54A\uC2B5\uB2C8\uB2E4."
    - TextId: 4
      Text: "\uB8E8\uC774\uC2A4\uB2D8\uC774 \uC4F0\uB7EC\uC84C\uB2E4\uB294 \uACB0\uACFC\uB9CC
        \uB0A8\uC558\uC73C\uB2C8\uAE4C\uC694."
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uB9C9\uC544\uB0B8 \uCABD\uC744 \uAE30\uC5B5\uD558\uACE0,\n\uB370\uC6B0\uC2A4\uB294
        \uB2FF\uC544\uBC84\uB9B0 \uD30C\uD3B8\uB9CC \uBCF4\uACE0 \uC788\uB124.)"
    - TextId: 1
      Text: "(\uAC19\uC740 \uC0AC\uAC74\uC778\uB370, \uB0A8\uC740 \uC7A5\uBA74\uC774
        \uB2EC\uB77C.)"
    DesignerNote: 
  - ProfileClueId: P04_05
    CharacterId: 4
    ClueIndex: 5
    ClueText: "\uB370\uC6B0\uC2A4\uB294 \uBAA8\uB450\uB97C \uC783\uC740 \uB4A4\uC5D0\uB3C4,
      \uC0C8\uD134\uC774 \uD6C4\uBC29\uC744 \uB9C9\uC73C\uB824 \uD588\uB2E4\uB294
      \uC0AC\uC2E4\uBCF4\uB2E4 \uB8E8\uC774\uC2A4\uB97C \uACE0\uB824\uD558\uC9C0
      \uBABB\uD588\uB2E4\uB294 \uC810\uC5D0 \uBB34\uB108\uC9C0\uACE0 \uC788\uB2E4."
    HintText: "\uB370\uC6B0\uC2A4\uB294 \uBAA8\uB450\uAC00 \uC8FD\uC740 \uB4A4, \uC0C8\uD134\uC774
      \uB8E8\uC774\uC2A4\uBCF4\uB2E4 \uD6C4\uBC29 \uACF5\uACA9\uC744 \uC6B0\uC120\uD55C
      \uD310\uB2E8\uC744 \uC644\uC804\uD788 \uC774\uD574\uD558\uACE0 \uBC1B\uC544\uB4E4\uC774\uACE0
      \uC788\uB2E4."
    HintDescription: "\uC5F0\uC778\uC744 \uC783\uC740 \uC2AC\uD514, \uB3D9\uB8CC\uB4E4\uC758
      \uC8FD\uC74C\u2026 \uB370\uC6B0\uC2A4\uB294 \uC544\uBB34 \uAC83\uB3C4 \uBC1B\uC544\uB4E4\uC77C
      \uC218 \uC5C6\uC5C8\uB2E4."
    Combo: 010000000400000007000000
    PlaceName: 
    DeadRequired: 02000000030000000500000006000000
    Prerequisites:
    - P04_04
    - P07_03
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uC0C8\uD134\uB2D8.\n\uD6C4\uBC29\uC744 \uB9C9\uC73C\uB824\uACE0 \uC6C0\uC9C1\uC600\uB2E4\uACE0
        \uD558\uC168\uC8E0."
    - TextId: 7
      Text: "\uADF8\uB798.\n\uADF8\uB54C\uB294 \uADF8\uAC8C \uBAA8\uB450\uB97C \uC0B4\uB9AC\uB294
        \uAE38\uC774\uB77C\uACE0 \uC0DD\uAC01\uD588\uC5B4."
    - TextId: 4
      Text: "\uBAA8\uB450\uB77C\uB2C8\uC694.\n\uC9C0\uAE08 \uC5EC\uAE30\uC5D0\uB294
        \uB204\uAC00 \uB0A8\uC544 \uC788\uB098\uC694?"
    - TextId: 4
      Text: "\uBA54\uC774\uB2D8\uB3C4 \uC8FD\uC5C8\uC2B5\uB2C8\uB2E4.\n\uD1A0\uB2C8\uB2D8\uB3C4,
        \uD504\uB9AC\uB4DC\uB2D8\uB3C4\u2026\n\uB8E8\uC774\uC2A4\uB2D8\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4."
    - TextId: 7
      Text: "\uB370\uC6B0\uC2A4\u2026"
    - TextId: 4
      Text: "\uC800\uB294 \uB8E8\uC774\uC2A4\uB2D8\uC744 \uBD80\uD0C1\uB4DC\uB838\uC2B5\uB2C8\uB2E4."
    - TextId: 7
      Text: "\uD6C4\uBC29 \uACF5\uACA9\uC744 \uB9C9\uC9C0 \uC54A\uC558\uB2E4\uBA74,\n\uB354
        \uB9CE\uC740 \uC0AC\uB78C\uC774 \uC8FD\uC5C8\uC744 \uAC70\uC57C."
    - TextId: 4
      Text: "\uADF8 \uB9D0\uC740 \uC774\uC81C \uC544\uBB34 \uC758\uBBF8\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uACB0\uAD6D
        \uC544\uBB34\uB3C4 \uB0A8\uC9C0 \uC54A\uC558\uC73C\uB2C8\uAE4C\uC694."
    - TextId: 4
      Text: "\uC0C8\uD134\uB2D8\uC774 \uB9C9\uC544\uB0B8 \uAC74 \uD6C4\uBC29\uC774\uC5C8\uC8E0.\n\uB8E8\uC774\uC2A4\uB2D8\uC740
        \uC544\uB2C8\uC5C8\uC2B5\uB2C8\uB2E4."
    - TextId: 7
      Text: "\uB098\uB294 \uBAA8\uB450\uB97C \uC0B4\uB9AC\uB824\uACE0 \uD588\uC5B4."
    - TextId: 4
      Text: "\uADF8 \uBAA8\uB450 \uC548\uC5D0,\n\uB8E8\uC774\uC2A4\uB2D8\uC740 \uC5C6\uC5C8\uB098
        \uBCF4\uB124\uC694."
    - TextId: 1
      Text: "(\uB370\uC6B0\uC2A4\uB294 \uC0C8\uD134\uC774 \uBB34\uC5C7\uC744 \uB9C9\uC558\uB294\uC9C0\uBCF4\uB2E4,\n\uBB34\uC5C7\uC744
        \uB193\uCCE4\uB294\uC9C0\uB9CC \uBCF4\uACE0 \uC788\uB124.)"
    - TextId: 1
      Text: "(\uD558\uC9C0\uB9CC \uC774 \uC0C1\uD0DC\uB85C\uB294 \uBD80\uC871\uD574.\n\uB370\uC6B0\uC2A4\uB294
        \uC774\uBBF8 \uB108\uBB34 \uBB34\uB108\uC84C\uACE0, \uC0C8\uD134\uC740 \uC544\uC9C1
        \uBC84\uD2F0\uACE0 \uC788\uC5B4.)"
    - TextId: 1
      Text: "(\uC544\uB9C8 \uB610 \uCC98\uC74C\uC73C\uB85C \uB418\uB3CC\uC544\uAC00\uACA0\uC9C0.\n\uB2E4\uC74C\uC5D0\uB294
        \uC774 \uB9D0\uC744 \uB354 \uC77C\uCC0D \uCC14\uB7EC \uB123\uC5B4\uC57C\uACA0\uC5B4.)"
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uD6C4\uBC29\uC744 \uBD24\uACE0, \uB8E8\uC774\uC2A4\uB294
        \uBCF4\uC9C0 \uBABB\uD588\uB2E4.\n\uC774 \uBB38\uC7A5\uC774 \uB370\uC6B0\uC2A4\uB97C
        \uBB34\uB108\uB728\uB9B4 \uC5F4\uC1E0\uC57C.)"
    DesignerNote: "P07_04 \uD68D\uB4DD \uC2DC \uC790\uB3D9\uC73C\uB85C \uB3D9\uC2DC
      \uD68D\uB4DD\uB428"
  - ProfileClueId: P05_01
    CharacterId: 5
    ClueIndex: 1
    ClueText: "\uD1A0\uB2C8\uB294 \uB4DC\uB798\uACE4\uACFC\uC758 \uC870\uC6B0 \uC911,
      \uBE44\uC804\uD22C\uC6D0\uC73C\uB85C\uC11C \uC758\uB8B0 \uBB3C\uD488\uC744
      \uC9C0\uD0A4\uAE30 \uC704\uD574 \uB3C4\uB9DD\uC744 \uC120\uD0DD\uD588\uB2E4."
    HintText: "\uD1A0\uB2C8\uB294 \uC758\uB8B0 \uBB3C\uD488\uC744 \uC9C0\uD0A8 \uC790\uC2E0\uC758
      \uD310\uB2E8\uC774 \uD300\uC5D0\uAC8C \uCDA9\uBD84\uD55C \uB3C4\uC6C0\uC774
      \uB418\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uD1A0\uB2C8\uB294 \uCC3D\uACE0\uC5D0 \uD63C\uC790 \uB0A8\uC544
      \uC790\uC2E0\uC758 \uC4F8\uBAA8\uB97C \uC0DD\uAC01\uD558\uB294 \uC815\uC2E0
      \uCC29\uB780 \uC99D\uC138\uB97C \uBCF4\uC778\uB2E4."
    Combo: 0100000005000000
    PlaceName: "\uCC3D\uACE0"
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 1
    Lines:
    - TextId: 5
      Text: "\uB098\uB294 \uBD84\uBA85 \uD300\uC5D0 \uB3C4\uC6C0\uC774 \uB410\uC5B4.
        \uB098\uB294 \uBD84\uBA85 \uD300\uC5D0 \uB3C4\uC6C0\uC774 \uB410\uC5B4. \\n\uB098\uB294
        \uBD84\uBA85 \uD300\uC5D0 \uB3C4\uC6C0\uC774 \uB410\uC5B4. \uB098\uB294 \uBD84\uBA85
        \uD300\uC5D0 \uB3C4\uC6C0\uC774 \uB410\uC5B4. \\n\uB098\uB294 \uBD84\uBA85
        \uD300\uC5D0 \uB3C4\uC6C0\uC774 \uB410\uC5B4. \uB098\uB294 \uBD84\uBA85 \uD300\uC5D0
        \uB3C4\uC6C0\uC774 \uB410\uC5B4."
    - TextId: 1
      Text: "\uD1A0\uB2C8\uB2D8? \uAD1C\uCC2E\uC73C\uC2E0\uAC00\uC694??"
    - TextId: 5
      Text: "\uB0B4\uAC00 \uB3C4\uB9DD\uCE5C \uAC74 \uC758\uB8B0 \uBB3C\uD488\uC744
        \uC9C0\uD0A4\uAE30 \uC704\uD574\uC11C\uC57C! \uC65C \uC774 \uC0AC\uC2E4\uC744
        \uBAA8\uB974\uACE0 \uC788\uB294 \uAC70\uC57C? \\n\uC65C \uB2E4\uB4E4 \uB098\uB97C
        \uACC4\uC18D \uADF8\uB7F0 \uB208\uC73C\uB85C \uCCD0\uB2E4\uBCF4\uACE0 \uC788\uB294
        \uAC70\uC57C!!"
    - TextId: 5
      Text: "\uB098\uB294 \uBD84\uBA85 \uB3C4\uC6C0\uC774 \uB410\uC5B4...."
    DesignerNote: "\uC774 \uC0C1\uD669 \uD55C\uC815\uC73C\uB85C, \uAC15\uC81C\uD1F4\uACE0
      \uC9C1\uC804(\uC5D4\uBE44\uAC00 \uC8FD\uAE30 \uC804)\uC5D0 #1 \uC5D4\uBE44\uC640
      #5 \uD1A0\uB2C8\uC758 \uB2E4\uC774\uC5BC\uB85C\uADF8\uB97C \uCD9C\uB825\uD560
      \uC218 \uC788\uB294\uC9C0? \uADF8\uB9AC\uACE0 \uAC15\uC81C \uD1F4\uACE0 \uD6C4
      #5 \uD1A0\uB2C8\uC758 \uC870\uAC01\uC744 \uD68D\uB4DD\uD560 \uC218 \uC788\uAC8C
      \uD574\uC904 \uC218 \uC788\uB294\uC9C0?"
  - ProfileClueId: P05_02
    CharacterId: 5
    ClueIndex: 2
    ClueText: "\uD1A0\uB2C8\uB294 \uAC81\uC5D0 \uC9C8\uB838\uC9C0\uB9CC, \uC790\uC2E0\uC774
      \uD560 \uC218 \uC788\uB294 \uC77C\uC740 \uC758\uB8B0 \uBB3C\uD488\uC744 \uC9C0\uD0A4\uB294
      \uAC83\uBFD0\uC774\uB77C\uACE0 \uBBFF\uC9C0 \uC54A\uC558\uC744\uAE4C."
    HintText: "\uD1A0\uB2C8\uB294 \uC758\uB8B0 \uBB3C\uD488\uC744 \uD551\uACC4\uB85C
      \uC0BC\uC544 \uCC98\uC74C\uBD80\uD130 \uB3D9\uB8CC\uB4E4\uC744 \uBC84\uB9AC\uACE0
      \uB3C4\uB9DD\uCE58\uB824 \uD588\uB2E4."
    HintDescription: "\uD504\uB9AC\uB4DC\uB294 \uCC3D\uACE0\uC5D0 \uD63C\uC790 \uB0A8\uC544
      \uD1A0\uB2C8\uC5D0 \uAD00\uD55C \uADF8\uB54C\uC758 \uAE30\uC5B5\uC744 \uB418\uC9DA\uB294\uB2E4."
    Combo: 0100000006000000
    PlaceName: "\uCC3D\uACE0"
    DeadRequired: 
    Prerequisites:
    - P06_02
    SimultaneousIds:
    - P06_03
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uD504\uB9AC\uB4DC\uB2D8\uC740 \uCC3D\uACE0\uB3C4 \uC790\uC8FC \uC0B4\uD53C\uC2DC\uB124\uC694."
    - TextId: 6
      Text: "\uC758\uB8B0 \uBB3C\uD488\uC774\uB098 \uBCF4\uAE09\uD488\uC740 \uAC00\uBCCD\uAC8C
        \uBCF4\uBA74 \uC548 \uB3FC.\n\uC791\uC740 \uC2E4\uC218\uAC00 \uD070 \uBB38\uC81C\uB85C
        \uC774\uC5B4\uC9C8 \uB54C\uAC00 \uB9CE\uAC70\uB4E0."
    - TextId: 1
      Text: "\uADF8\uB0A0 \uC758\uB8B0 \uBB3C\uD488\uB3C4 \uADF8\uB7AC\uB098\uC694?"
    - TextId: 1
      Text: "\uC544, \uB300\uB2F5\uD558\uAE30 \uACE4\uB780\uD558\uC2DC\uBA74 \uC548
        \uD558\uC154\uB3C4 \uB3FC\uC694."
    - TextId: 6
      Text: "\uC544\uB2C8\uC57C.\n\uADF8\uB0A0\uB3C4 \uBB3C\uD488\uC740 \uC911\uC694\uD588\uC5B4."
    - TextId: 6
      Text: "\uD1A0\uB2C8\uB294 \uC758\uB8B0 \uBB3C\uD488\uC744 \uC9C0\uD0A4\uAE30
        \uC704\uD574 \uCD5C\uC120\uC744 \uB2E4\uD588\uC9C0."
    - TextId: 1
      Text: "\uD558\uC9C0\uB9CC \uADF8 \uD0D3\uC5D0 \uBC29\uC5B4\uBCBD \uC704\uCE58\uB97C
        \uC815\uD558\uAE30 \uC5B4\uB824\uC6B0\uC168\uAD70\uC694."
    - TextId: 6
      Text: "\uADF8 \uC9E7\uC740 \uC21C\uAC04\uC5D0, \uB098\uB294 \uB108\uBB34 \uB9CE\uC740
        \uAC78 \uBCF4\uB824\uACE0 \uD588\uC5B4.\n\uB098\uB294 \uBAA8\uB450\uB97C
        \uC9C0\uD0A4\uACE0 \uC2F6\uC5C8\uB294\uB370,"
    - TextId: 1
      Text: "(\uD504\uB9AC\uB4DC\uC758 \uBC29\uC5B4 \uD310\uB2E8\uC774 \uD754\uB4E4\uB838\uB2E4\uB294
        \uAC70\uB124.)"
    - TextId: 1
      Text: "(\uC774\uAC74 \uD504\uB9AC\uB4DC\uC5D0\uAC8C \uC544\uC9C1 \uB0A8\uC544
        \uC788\uB294 \uC0C1\uCC98\uC57C.)"
    DesignerNote: "P06_03 \uD68D\uB4DD \uC2DC \uC790\uB3D9\uC73C\uB85C \uB3D9\uC2DC
      \uD68D\uB4DD\uB428"
  - ProfileClueId: P05_03
    CharacterId: 5
    ClueIndex: 3
    ClueText: "\uD1A0\uB2C8\uB294 \uC790\uC2E0\uC774 \uBB3C\uD488\uC744 \uC9C0\uD0A4\uB824
      \uD55C \uD589\uB3D9\uC774 \uD504\uB9AC\uB4DC\uC758 \uBC29\uC5B4 \uD310\uB2E8\uC744
      \uD754\uB4E4\uC5C8\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4\uACE0 \uBD88\uC548\uD574\uD558\uC9C0
      \uC54A\uC558\uC744\uAE4C"
    HintText: "\uD1A0\uB2C8\uB294 \uC790\uC2E0\uC758 \uD589\uB3D9\uC774 \uD504\uB9AC\uB4DC\uC758
      \uBC29\uC5B4 \uD310\uB2E8\uC5D0 \uC544\uBB34\uB7F0 \uC601\uD5A5\uC744 \uC8FC\uC9C0
      \uC54A\uC558\uB2E4\uACE0 \uD655\uC2E0\uD588\uC744 \uAC83\uC774\uB2E4"
    HintDescription: "\uCC3D\uACE0\uC5D0\uC11C \uBA54\uC774\uC640 \uD504\uB9AC\uB4DC\uAC00
      \uB418\uC9DA\uC740 \uD1A0\uB2C8\uC758 \uB3C4\uB9DD\uCE5C \uC774\uC720"
    Combo: 010000000200000006000000
    PlaceName: "\uCC3D\uACE0"
    DeadRequired: 
    Prerequisites:
    - P02_03
    SimultaneousIds:
    - P02_04
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uC5EC\uAE34 \uC5EC\uC804\uD788 \uBB3C\uD488\uC774 \uB9CE\uB124.\n\uD1A0\uB2C8\uAC00
        \uB298 \uC2E0\uACBD \uC4F0\uB358 \uAC83\uB4E4."
    - TextId: 6
      Text: "\uD1A0\uB2C8\uB294 \uADF8\uB7F0 \uAC78 \uAC00\uBCCD\uAC8C \uC5EC\uAE30\uC9C0
        \uC54A\uC558\uC5B4.\n\uC758\uB8B0 \uBB3C\uD488\uB3C4, \uBCF4\uAE09\uD488\uB3C4,
        \uACC4\uC57D\uB3C4."
    - TextId: 2
      Text: "\uADF8\uB0A0\uB3C4 \uBB3C\uD488\uC744 \uBA3C\uC800 \uBCF8 \uAC70\uC57C?\n\uB4DC\uB798\uACE4\uC774
        \uB208\uC55E\uC5D0 \uC788\uC5C8\uB294\uB370?"
    - TextId: 6
      Text: "\uD1A0\uB2C8\uB294 \uC2F8\uC6B8 \uC218 \uC5C6\uC5C8\uC5B4.\n\uADF8\uB7EC\uB2C8\uAE4C
        \uC790\uC2E0\uC774 \uD560 \uC218 \uC788\uB294 \uC77C\uC744 \uD558\uB824 \uD588\uACA0\uC9C0."
    - TextId: 2
      Text: "\uADF8\uAC8C \uBB3C\uD488\uC744 \uC9C0\uD0A4\uB294 \uAC70\uC600\uACE0?"
    - TextId: 6
      Text: "\uC544\uB9C8\uB3C4.\n\uD1A0\uB2C8\uC5D0\uAC8C\uB294 \uADF8\uAC8C \uC6A9\uBCD1\uB2E8\uC744
        \uC9C0\uD0A4\uB294 \uBC29\uC2DD\uC774\uC5C8\uC744 \uAC70\uC57C."
    - TextId: 2
      Text: "\u2026\u2026"
    - TextId: 6
      Text: "\uADF8 \uC21C\uAC04 \uD1A0\uB2C8\uC640 \uBB3C\uD488\uC774 \uBCF4\uC774\uC9C0
        \uC54A\uC558\uB358 \uAC83\uB3C4 \uC0AC\uC2E4\uC774\uC57C.\n\uB098\uB294 \uBA54\uC774
        \uB108\uC640, \uD1A0\uB2C8\uC640, \uBB3C\uD488\uAE4C\uC9C0 \uBAA8\uB450 \uBCF4\uB824
        \uD588\uC5B4."
    - TextId: 2
      Text: "\uB098\uB294 \uB4DC\uB798\uACE4\uB9CC \uBCF4\uACE0 \uC788\uC5C8\uACE0,\n\uD1A0\uB2C8\uB294
        \uBB3C\uD488\uC744 \uBCF4\uACE0 \uC788\uC5C8\uACE0,\n\uB108\uB294 \uD769\uC5B4\uC9C4
        \uC804\uC7A5\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4?"
    - TextId: 6
      Text: "\u2026\u2026\uADF8\uB0A0 \uC6B0\uB9AC\uB294 \uC804\uBD80 \uB2E4\uB978
        \uAC78 \uBCF4\uACE0 \uC788\uC5C8\uC5B4."
    - TextId: 1
      Text: "(\uBA54\uC774\uB294 \uD1A0\uB2C8\uB97C \uB2E8\uC21C\uD55C \uB3C4\uB9DD\uC790\uB85C\uB9CC
        \uBCF4\uACE0 \uC788\uC5C8\uC5B4.)"
    - TextId: 1
      Text: "(\uD558\uC9C0\uB9CC \uD1A0\uB2C8\uC5D0\uAC8C\uB3C4 \uC9C0\uD0A4\uB824\uB358
        \uAC8C \uC788\uC5C8\uB2E4\uB294 \uAC70\uB124.)"
    DesignerNote: "P02_04 \uD68D\uB4DD \uC2DC \uC790\uB3D9\uC73C\uB85C \uB3D9\uC2DC
      \uD68D\uB4DD\uB428"
  - ProfileClueId: P05_04
    CharacterId: 5
    ClueIndex: 4
    ClueText: "\uC5D4\uBE44\uC758 \uC815\uC2E0 \uC0C1\uD0DC\uB294 \uC624\uB85C\uC9C0
      \uC790\uC2E0\uC5D0"
    HintText: "\uC5D4\uBE44\uC758 \uC815\uC2E0 \uC0C1\uD0DC\uB294 \uC624\uB85C\uC9C0
      \uC790\uC2E0\uC5D0 \uB300\uD55C \uBD88\uC2E0 \uB54C\uBB38\uC5D0 \uC77C\uC5B4\uB0AC\uB2E4."
    HintDescription: "\uB2A6\uC740 \uC800\uB141, \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC5D4\uBE44\uAC00
      \uB2F9\uD588\uB2E4. \uD1A0\uB2C8\uB294 \uB2E8\uC6D0\uB4E4\uC744 \uBAA8\uB450
      \uC0B4\uD574\uD588\uB2E4."
    Combo: 0100000005000000
    PlaceName: 
    DeadRequired: 0200000003000000040000000600000007000000
    Prerequisites:
    - P05_03
    SimultaneousIds: []
    IsForcedExitFragment: 1
    Lines:
    - TextId: 5
      Text: "\uB098\uB294..... \uBD84\uBA85..... \uD300\uC5D0.... \uB3C4\uC6C0\uC774....
        \uB410\uC5B4....."
    - TextId: 1
      Text: "(\uC820\uC7A5! \uB2E8\uC6D0\uB4E4\uC774 \uC804\uBD80 \uC8FD\uC5C8\uC5B4.
        \uB610 \uB2E4\uC2DC \uB3CC\uC544\uAC00\uC57C\uB9CC \uD574. \uD1A0\uB2C8 \uCABD\uC740
        \uD604\uC7AC \uC815\uC2E0\uC0C1\uD0DC\uAC00 \uBD88\uC548\uC815\uD574. \uB2E4\uC74C
        \uB8E8\uD504 \uB54C\uB294 \uCD5C\uB300\uD55C \uD53C\uD574\uBCF4\uC790.)"
    DesignerNote: "\uC774 \uC0C1\uD669 \uD55C\uC815\uC73C\uB85C, \uAC15\uC81C\uD1F4\uACE0
      \uC9C1\uC804(\uC5D4\uBE44\uAC00 \uC8FD\uAE30 \uC804)\uC5D0 #1 \uC5D4\uBE44\uC640
      #5 \uD1A0\uB2C8\uC758 \uB2E4\uC774\uC5BC\uB85C\uADF8\uB97C \uCD9C\uB825\uD560
      \uC218 \uC788\uB294\uC9C0? \uADF8\uB9AC\uACE0 \uAC15\uC81C \uD1F4\uACE0 \uD6C4
      #5 \uD1A0\uB2C8\uC758 \uC870\uAC01\uC744 \uD68D\uB4DD\uD560 \uC218 \uC788\uAC8C
      \uD574\uC904 \uC218 \uC788\uB294\uC9C0?"
  - ProfileClueId: P05_05
    CharacterId: 5
    ClueIndex: 5
    ClueText: "\uD1A0\uB2C8\uB294 \uBB3C\uD488\uC744 \uC9C0\uD0A8 \uC790\uC2E0\uC758
      \uD589\uB3D9\uC774 \uC624\uD788\uB824 \uD504\uB9AC\uB4DC\uC5D0\uAC8C \uD574\uAC00
      \uB418\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC5EC, \uC2EC\uAC01\uD55C \uC790\uAE30\uD610\uC624\uC5D0
      \uBE60\uC84C\uB2E4."
    HintText: "\uD1A0\uB2C8\uB294 \uD504\uB9AC\uB4DC\uAC00 \uC790\uC2E0\uC758 \uD310\uB2E8\uC744
      \uC774\uD574\uD574 \uC8FC\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD588\uC9C0\uB9CC,
      \uB2E4\uB978 \uB2E8\uC6D0\uB4E4\uC758 \uB208\uCD08\uB9AC\uB97C \uBC84\uD2F0\uC9C0
      \uBABB\uD558\uACE0 \uD3ED\uBC1C\uD558\uC600\uB2E4."
    HintDescription: "\uC5D4\uBE44\uC640 \uD1A0\uB2C8\uC758 \uB3C5\uB300. \uD504\uB9AC\uB4DC\uB294
      \uD76C\uC0DD\uD588\uACE0 \uB098\uBA38\uC9C0 \uB3D9\uB8CC\uB4E4 \uC5ED\uC2DC
      \uBAA8\uB450 \uC8FD\uC5C8\uB2E4."
    Combo: 010000000500000006000000
    PlaceName: 
    DeadRequired: 02000000030000000400000007000000
    Prerequisites:
    - P05_04
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uD1A0\uB2C8\uB2D8! \uC9C4\uC815\uD558\uC138\uC694."
    - TextId: 2
      Text: "\uC9C4\uC815? \uB108 \uAC19\uC73C\uBA74 \uADF8\uAC8C \uB420 \uAC83 \uAC19\uC544?"
    - TextId: 1
      Text: "(\uB4DC\uB514\uC5B4 \uB2E4\uC2DC \uC774\uC57C\uAE30\uB97C \uB098\uB20C
        \uC218 \uC788\uAC8C \uB410\uC5B4. \uC544\uB9C8 \uB9C8\uC9C0\uB9C9 \uAE30\uD68C\uC77C\uC9C0\uB3C4
        \uBAB0\uB77C) \uC800\uB77C\uBA74 \uD1A0\uB2C8\uB2D8\uC758 \uB9C8\uC74C\uC744
        \uC774\uD574\uD560 \uC218 \uC788\uC5B4\uC694."
    - TextId: 2
      Text: "\uC774\uBBF8 \uBAA8\uB4E0 \uAC8C \uB05D\uB0AC\uC5B4. \uBAA8\uB450 \uC8FD\uC5C8\uC5B4...
        \uD504\uB9AC\uB4DC\uAE4C\uC9C0..."
    - TextId: 1
      Text: "\uC65C \uB2E8\uC6D0\uB4E4 \uBAA8\uB450\uAC00 \uD1A0\uB2C8\uB2D8\uC744
        \uC2EB\uC5B4\uD55C\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC2E0 \uAC70\uC5D0\uC694?"
    - TextId: 2
      Text: "\uADF8\uB188\uB4E4\uC740 \uBB3C\uD488 \uC9C0\uD0A4\uB824\uACE0 \uD55C
        \uB098\uC5D0\uAC8C \uB3C4\uB9DD\uC790\uC758 \uB099\uC778\uC744 \uCC0D\uC73C\uB824
        \uD55C \uB188\uB4E4\uC774\uC57C!!! \uD504\uB9AC\uB4DC\uB294 \uB098 \uB54C\uBB38\uC5D0
        \uB8E8\uC774\uC2A4\uB97C \uBCF4\uD638\uD558\uC9C0 \uBABB\uD588\uB358 \uAC78
        \uC54C\uACE0, \uB098\uB97C \uBC8C\uB808\uBCF4\uB4EF\uC774 \uCCD0\uB2E4\uBD24\uC5B4!!
        \uBD84\uBA85\uD574!!!!"
    - TextId: 1
      Text: "\uB2E8\uC6D0\uB4E4\uC740 \uC11C\uB85C \uADF8 \uC0AC\uAC74\uC5D0 \uB300\uD574
        \uB9D0\uC744 \uC544\uAF08\uB358 \uAC8C \uC544\uB2C8\uC5D0\uC694? \uD504\uB9AC\uB4DC\uB2D8\uC740
        \uADF8\uB7F0 \uB9D0\uC744 \uC9C1\uC811 \uD558\uC9C0 \uC54A\uC73C\uC168\uC5B4\uC694!"
    - TextId: 2
      Text: "\uC2DC\uB044\uB7EC\uC5B4\uC5B4\uC5B4!!!!!!!! \uC774\uC81C \uB2E4 \uC758\uBBF8
        \uC5C6\uC5B4!!!!!!!!!!!!!!!!!!!!"
    DesignerNote: "\uD504\uB9AC\uB4DC\uAC00 \uD76C\uC0DD\uC591 \uD6A8\uACFC\uB97C
      \uBC1C\uB3D9\uD574\uC11C \uC5D4\uBE44 \uB300\uC2E0 \uC0AC\uB9DD\uD558\uB294
      \uC5ED\uD560 \uAE30\uB2A5\uC744 \uD558\uB294\uB370, \uC774 \uB85C\uC9C1\uC774
      \uC81C\uB300\uB85C \uC791\uB3D9\uB418\uB294\uC9C0 \uD655\uC778\uD560 \uD544\uC694\uAC00
      \uC788\uC74C"
  - ProfileClueId: P06_01
    CharacterId: 6
    ClueIndex: 1
    ClueText: "\uD504\uB9AC\uB4DC\uB294 \uC9C0\uCF1C\uC57C \uD560 \uC0AC\uB78C\uC774
      \uBCF4\uC774\uC9C0 \uC54A\uC73C\uBA74 \uC9C0\uD0AC \uC218 \uC5C6\uB2E4\uACE0
      \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uD504\uB9AC\uB4DC\uB294 \uC804\uD22C\uC5D0\uC11C \uAC00\uC7A5 \uC911\uC694\uD55C
      \uAC83\uC740 \uAC01\uC790 \uC54C\uC544\uC11C \uC0B4\uC544\uB0A8\uB294 \uAC83\uC774\uB77C\uACE0
      \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uB098\uB208 \uC2E0\uC785\uACFC
      \uD504\uB9AC\uB4DC\uC758 \uCCAB \uC778\uC0AC"
    Combo: 0100000006000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uD504\uB9AC\uB4DC\uB2D8, \uB9DE\uC73C\uC2DC\uC8E0?\n\uC6A9\uBCD1\uB2E8\uC5D0
        \uC0C8\uB85C \uD569\uB958\uD55C \uC5D4\uBE44\uC608\uC694. \uC798 \uBD80\uD0C1\uB4DC\uB824\uC694."
    - TextId: 6
      Text: "\uC2E0\uC785\uC774\uAD6C\uB098.\n\uD504\uB9AC\uB4DC\uC57C. \uBAA8\uB974\uB294
        \uAC8C \uC788\uC73C\uBA74 \uC5B8\uC81C\uB4E0 \uBB3C\uC5B4\uBD10."
    - TextId: 1
      Text: "\uC81C\uAC00 \uBA3C\uC800 \uC870\uC2EC\uD574\uC57C \uD560 \uAC8C \uC788\uC744\uAE4C\uC694?"
    - TextId: 6
      Text: "\uD63C\uC790 \uC55E\uC11C\uAC00\uC9C0 \uC54A\uB294 \uAC83.\n\uADF8\uB9AC\uACE0
        \uB204\uAC00 \uC5B4\uB514\uC5D0 \uC788\uB294\uC9C0 \uACC4\uC18D \uBCF4\uB294
        \uAC83."
    - TextId: 1
      Text: "\uC704\uCE58\uAC00 \uC911\uC694\uD55C\uAC00\uC694?"
    - TextId: 6
      Text: "\uC9C0\uCF1C\uC57C \uD560 \uC0AC\uB78C\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC73C\uBA74,
        \uC9C0\uD0AC \uC218 \uC5C6\uC73C\uB2C8\uAE4C..."
    - TextId: 1
      Text: "\uADF8\uB807\uAD70\uC694. \uBA85\uC2EC\uD560\uAC8C\uC694."
    - TextId: 1
      Text: "(\uC9C0\uCF1C\uC57C \uD560 \uC0AC\uB78C\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC73C\uBA74
        \uC9C0\uD0AC \uC218 \uC5C6\uB2E4\uB77C.\n\uD504\uB9AC\uB4DC\uD55C\uD14C\uB294
        \uAF64 \uC544\uD508 \uB9D0 \uAC19\uB124.)"
    DesignerNote: 
  - ProfileClueId: P06_02
    CharacterId: 6
    ClueIndex: 2
    ClueText: "\uD504\uB9AC\uB4DC\uB294 \uADF8\uB0A0 \uB4DC\uB798\uACE4\uBCF4\uB2E4
      \uD769\uC5B4\uC9C4 \uC804\uC7A5\uACFC \uC9C0\uCF1C\uC57C \uD560 \uC0AC\uB78C\uB4E4\uC744
      \uB354 \uC2E0\uACBD \uC4F0\uACE0 \uC788\uC5C8\uB2E4."
    HintText: "\uD504\uB9AC\uB4DC\uB294 \uBA54\uC774\uAC00 \uB4DC\uB798\uACE4\uC744
      \uACF5\uACA9\uD558\uB294 \uB3D9\uC548 \uC804\uC7A5 \uC0C1\uD669\uC744 \uAC70\uC758
      \uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uC558\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uBD80\uB52A\uD78C \uBA54\uC774\uC640
      \uD504\uB9AC\uB4DC"
    Combo: 010000000200000006000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P06_01
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uB124\uAC00 \uBCF4\uD638\uB9C9\uB9CC \uC81C\uB300\uB85C \uD3BC\uCCE4\uB2E4\uBA74,\n\uB8E8\uC774\uC2A4\uAC00
        \uC4F0\uB7EC\uC9C0\uB294 \uC77C\uC740 \uC5C6\uC5C8\uC5B4."
    - TextId: 6
      Text: "\uADF8\uB807\uAC8C \uAC04\uB2E8\uD55C \uC77C\uC774 \uC544\uB2C8\uC5C8\uC5B4.\n\uADF8\uB0A0
        \uC804\uC7A5\uC740 \uC774\uBBF8 \uD769\uC5B4\uC838 \uC788\uC5C8\uC5B4."
    - TextId: 2
      Text: "\uADF8\uB798\uC11C?\n\uBAA8\uB450\uB97C \uC9C0\uD0A4\uACA0\uB2E4\uB294
        \uB9D0\uC740 \uC26C\uC6E0\uACE0?"
    - TextId: 6
      Text: "\uC26C\uC6B4 \uB9D0\uC774 \uC544\uB2C8\uC57C.\n\uADF8\uB798\uC11C \uC544\uC9C1\uB3C4
        \uC78A\uC9C0 \uBABB\uD558\uB294 \uAC70\uC57C."
    - TextId: 2
      Text: "\uB098\uB294 \uB4DC\uB798\uACE4\uC744 \uBCF4\uACE0 \uC788\uC5C8\uC5B4.\n\uC815\uB9D0
        \uB05D\uB0BC \uC218 \uC788\uC5C8\uB2E4\uACE0."
    - TextId: 6
      Text: "\uD558\uC9C0\uB9CC \uB098\uB294 \uB4DC\uB798\uACE4\uB9CC \uBCFC \uC218
        \uC5C6\uC5C8\uC5B4."
    - TextId: 6
      Text: "\uBA54\uC774 \uB108\uB3C4, \uB8E8\uC774\uC2A4\uB3C4, \uB370\uC6B0\uC2A4\uB3C4,
        \uC0C8\uD134\uB3C4,\n\uADF8\uB9AC\uACE0 \uBCF4\uC774\uC9C0 \uC54A\uB358 \uD1A0\uB2C8\uC640
        \uBB3C\uD488\uAE4C\uC9C0 \uBD10\uC57C \uD588\uC5B4."
    - TextId: 1
      Text: "(\uBA54\uC774\uB294 \uB4DC\uB798\uACE4\uC744 \uBD24\uACE0,\n\uD504\uB9AC\uB4DC\uB294
        \uD769\uC5B4\uC9C4 \uC804\uC7A5\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB124.)"
    - TextId: 1
      Text: "(\uAC19\uC740 \uC21C\uAC04\uC744 \uBCF4\uACE0\uB3C4, \uAE30\uC5B5\uD558\uB294
        \uC7A5\uBA74\uC774 \uB2EC\uB77C.)"
    DesignerNote: 
  - ProfileClueId: P06_03
    CharacterId: 6
    ClueIndex: 3
    ClueText: "\uD504\uB9AC\uB4DC\uB294 \uD1A0\uB2C8\uC640 \uBB3C\uD488\uC774 \uBCF4\uC774\uC9C0
      \uC54A\uC544 \uBC29\uC5B4\uBCBD \uC704\uCE58\uB97C \uC815\uD558\uB294 \uB370
      \uD754\uB4E4\uB838\uB2E4\uACE0 \uAE30\uC5B5\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uD504\uB9AC\uB4DC\uB294 \uD1A0\uB2C8\uC640 \uBB3C\uD488\uC758 \uC704\uCE58\uB97C
      \uC815\uD655\uD788 \uC54C\uACE0 \uC788\uC5C8\uC9C0\uB9CC \uC77C\uBD80\uB7EC
      \uBC29\uC5B4\uD558\uC9C0 \uC54A\uC558\uB2E4."
    HintDescription: "\uD504\uB9AC\uB4DC\uB294 \uCC3D\uACE0\uC5D0 \uD63C\uC790 \uB0A8\uC544
      \uD1A0\uB2C8\uC5D0 \uAD00\uD55C \uADF8\uB54C\uC758 \uAE30\uC5B5\uC744 \uB418\uC9DA\uB294\uB2E4."
    Combo: 0100000006000000
    PlaceName: "\uCC3D\uACE0"
    DeadRequired: 
    Prerequisites:
    - P06_02
    SimultaneousIds:
    - P05_02
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uD504\uB9AC\uB4DC\uB2D8\uC740 \uCC3D\uACE0\uB3C4 \uC790\uC8FC \uC0B4\uD53C\uC2DC\uB124\uC694."
    - TextId: 6
      Text: "\uC758\uB8B0 \uBB3C\uD488\uC774\uB098 \uBCF4\uAE09\uD488\uC740 \uAC00\uBCCD\uAC8C
        \uBCF4\uBA74 \uC548 \uB3FC.\n\uC791\uC740 \uC2E4\uC218\uAC00 \uD070 \uBB38\uC81C\uB85C
        \uC774\uC5B4\uC9C8 \uB54C\uAC00 \uB9CE\uAC70\uB4E0."
    - TextId: 1
      Text: "\uADF8\uB0A0 \uC758\uB8B0 \uBB3C\uD488\uB3C4 \uADF8\uB7AC\uB098\uC694?"
    - TextId: 1
      Text: "\uC544, \uB300\uB2F5\uD558\uAE30 \uACE4\uB780\uD558\uC2DC\uBA74 \uC548
        \uD558\uC154\uB3C4 \uB3FC\uC694."
    - TextId: 6
      Text: "\uC544\uB2C8\uC57C.\n\uADF8\uB0A0\uB3C4 \uBB3C\uD488\uC740 \uC911\uC694\uD588\uC5B4."
    - TextId: 6
      Text: "\uBB38\uC81C\uB294 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4\uB294 \uAC70\uC57C.\n\uD1A0\uB2C8\uB3C4,
        \uBB3C\uD488\uB3C4."
    - TextId: 1
      Text: "\uADF8\uB798\uC11C \uBC29\uC5B4\uBCBD \uC704\uCE58\uB97C \uC815\uD558\uAE30
        \uC5B4\uB824\uC6B0\uC168\uAD70\uC694."
    - TextId: 6
      Text: "\uADF8 \uC9E7\uC740 \uC21C\uAC04\uC5D0, \uB098\uB294 \uB108\uBB34 \uB9CE\uC740
        \uAC78 \uBCF4\uB824\uACE0 \uD588\uC5B4.\n\uB098\uB294 \uBAA8\uB450\uB97C
        \uC9C0\uD0A4\uACE0 \uC2F6\uC5C8\uB294\uB370,\n\uADF8 \uC21C\uAC04 \uBAA8\uB450\uAC00
        \uC5B4\uB514 \uC788\uB294\uC9C0 \uC54C \uC218 \uC5C6\uC5C8\uC5B4."
    - TextId: 1
      Text: "(\uD1A0\uB2C8\uC640 \uBB3C\uD488\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC558\uAE30
        \uB54C\uBB38\uC5D0,\n\uD504\uB9AC\uB4DC\uC758 \uBC29\uC5B4 \uD310\uB2E8\uC774
        \uD754\uB4E4\uB838\uB2E4\uB294 \uAC70\uB124.)"
    - TextId: 1
      Text: "(\uC774\uAC74 \uD504\uB9AC\uB4DC\uC5D0\uAC8C \uC544\uC9C1 \uB0A8\uC544
        \uC788\uB294 \uC0C1\uCC98\uC57C.)"
    DesignerNote: "\uD574\uB2F9 \uC870\uAC01 \uD68D\uB4DD \uC2DC \uC790\uB3D9\uC73C\uB85C
      P05_02\uAC00 \uB3D9\uC2DC \uD68D\uB4DD\uB428"
  - ProfileClueId: P06_04
    CharacterId: 6
    ClueIndex: 4
    ClueText: "\uD504\uB9AC\uB4DC\uB294 \uC0C8\uD134\uC774 \uB9C9\uC9C0 \uBABB\uD55C
      \uD30C\uD3B8\uAE4C\uC9C0 \uC790\uC2E0\uC774 \uB9C9\uC558\uC5B4\uC57C \uD588\uB2E4\uACE0
      \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uD504\uB9AC\uB4DC\uB294 \uB8E8\uC774\uC2A4\uAC00 \uB2E4\uCE5C \uC77C\uC744
      \uC0C8\uD134\uC758 \uCE74\uC6B4\uD130 \uC2E4\uD328 \uB54C\uBB38\uC774\uB77C\uACE0\uB9CC
      \uC5EC\uAE30\uACE0 \uC788\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uB418\uC9DA\uC5B4 \uBCF4\uB294
      \uD504\uB9AC\uB4DC\uC640 \uC0C8\uD134\uC758 \uAE30\uC5B5"
    Combo: 010000000600000007000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P06_03
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 7
      Text: "\uADF8\uB0A0 \uD6C4\uBC29 \uACF5\uACA9\uC740 \uB9C9\uC558\uC5B4.\n\uC644\uC804\uD788\uB294
        \uC544\uB2C8\uC5C8\uC9C0\uB9CC."
    - TextId: 6
      Text: "\uD30C\uD3B8\uC774 \uD280\uC5C8\uC9C0.\n\uC804\uC7A5 \uC911\uAC04\uC73C\uB85C."
    - TextId: 7
      Text: "\uB0B4\uAC00 \uC870\uAE08\uB9CC \uB354 \uC815\uD655\uD588\uC73C\uBA74,\n\uB8E8\uC774\uC2A4\uAE4C\uC9C0
        \uAC00\uC9C0 \uC54A\uC558\uC744 \uAC70\uC57C."
    - TextId: 6
      Text: "\uADF8 \uD30C\uD3B8\uC744 \uB9C9\uC558\uC5B4\uC57C \uD558\uB294 \uAC74
        \uB098\uC600\uC5B4."
    - TextId: 7
      Text: "\uD504\uB9AC\uB4DC, \uADF8\uB54C \uB124\uAC00 \uBD10\uC57C \uD560 \uAC74
        \uB108\uBB34 \uB9CE\uC558\uC5B4."
    - TextId: 6
      Text: "\uADF8\uB798\uB3C4 \uBD24\uC5B4\uC57C \uD588\uC5B4.\n\uBA54\uC774\uB3C4,
        \uB8E8\uC774\uC2A4\uB3C4, \uB370\uC6B0\uC2A4\uB3C4,\n\uBCF4\uC774\uC9C0 \uC54A\uB358
        \uD1A0\uB2C8\uC640 \uBB3C\uD488\uB3C4."
    - TextId: 7
      Text: "\uC804\uC7A5\uC744 \uC804\uBD80 \uBCF4\uB824 \uD558\uBA74 \uB2A6\uC5B4.\n\uD6C4\uBC29
        \uACF5\uACA9\uC740 \uD55C\uC21C\uAC04\uC774\uC5C8\uACE0, \uD30C\uD3B8\uC740
        \uB354 \uBE68\uB790\uC5B4."
    - TextId: 6
      Text: "\uADF8\uB798\uC11C \uC544\uC9C1\uB3C4 \uADF8 \uC21C\uAC04\uC774 \uACC4\uC18D
        \uB5A0\uC62C\uB77C."
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uD30C\uD3B8\uC744 \uC644\uC804\uD788 \uB9C9\uC9C0
        \uBABB\uD588\uACE0,\n\uD504\uB9AC\uB4DC\uB294 \uADF8 \uD30C\uD3B8\uC744 \uB9C9\uC9C0
        \uBABB\uD55C \uAC78 \uC790\uAE30 \uCC45\uC784\uC73C\uB85C \uBCF4\uACE0 \uC788\uB124.)"
    - TextId: 1
      Text: "(\uB9C9\uC73C\uB824\uB358 \uC0AC\uB78C\uB4E4\uB07C\uB9AC\uB3C4, \uB0A8\uC740
        \uC0C1\uCC98\uB294 \uB2E4\uB974\uAD6C\uB098.)"
    DesignerNote: 
  - ProfileClueId: P06_05
    CharacterId: 6
    ClueIndex: 5
    ClueText: "\uD504\uB9AC\uB4DC\uB294 \uBAA8\uB450\uB97C \uC9C0\uD0A4\uC9C0 \uBABB\uD55C
      \uCC45\uC784\uC744 \uC544\uC9C1\uB3C4 \uD63C\uC790 \uB04C\uC5B4\uC548\uC73C\uB824
      \uD558\uACE0 \uC788\uB2E4."
    HintText: "\uD504\uB9AC\uB4DC\uB294 \uB8E8\uC774\uC2A4\uAC00 \uB2E4\uCE5C \uCC45\uC784\uC744
      \uC0C8\uD134\uACFC \uD1A0\uB2C8\uC5D0\uAC8C\uB9CC \uB3CC\uB9AC\uB824 \uD558\uACE0
      \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0 \uBAA8\uC778 \uBA54\uC774\uC640 \uB370\uC6B0\uC2A4,
      \uADF8\uB9AC\uACE0 \uD504\uB9AC\uB4DC"
    Combo: 01000000020000000400000006000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites:
    - P06_04
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uD504\uB9AC\uB4DC.\n\uC544\uC9C1\uB3C4 \uADF8\uB0A0 \uBCF4\uD638\uB9C9\uC744
        \uC0DD\uAC01\uD574?"
    - TextId: 6
      Text: "\uC0DD\uAC01\uD558\uC9C0 \uC54A\uC73C\uB824\uACE0 \uD574\uB3C4 \uB5A0\uC62C\uB77C."
    - TextId: 4
      Text: "\uD504\uB9AC\uB4DC\uB9CC\uC758 \uC798\uBABB\uC740 \uC544\uB2C8\uC57C.\n\uADF8\uB54C\uB294
        \uBAA8\uB450\uAC00 \uAE09\uD588\uC5B4."
    - TextId: 2
      Text: "\uADF8\uB798\uB3C4 \uBCF4\uD638\uB9C9\uC774 \uB2FF\uC558\uB2E4\uBA74,\n\uB8E8\uC774\uC2A4\uB294
        \uC4F0\uB7EC\uC9C0\uC9C0 \uC54A\uC558\uACA0\uC9C0."
    - TextId: 6
      Text: "\uB9DE\uC544.\n\uB0B4 \uBCF4\uD638\uB9C9\uC740 \uB2FF\uC9C0 \uC54A\uC558\uC5B4."
    - TextId: 4
      Text: "\uADF8\uAC74 \uB124\uAC00 \uC804\uBD80 \uCC45\uC784\uC9C8 \uC77C\uC774
        \uC544\uB2C8\uC57C."
    - TextId: 6
      Text: "\uD558\uC9C0\uB9CC \uB098\uB294 \uBAA8\uB450\uB97C \uC9C0\uD0A4\uACA0\uB2E4\uACE0
        \uD588\uC5B4."
    - TextId: 6
      Text: "\uC0C8\uD134\uC774 \uB9C9\uC9C0 \uBABB\uD55C \uD30C\uD3B8\uB3C4,\n\uD1A0\uB2C8\uC640
        \uBB3C\uD488\uC774 \uC0AC\uB77C\uC838 \uC0DD\uAE34 \uBE48\uD2C8\uB3C4,\n\uC804\uBD80
        \uB0B4\uAC00 \uB9C9\uC558\uC5B4\uC57C \uD588\uC5B4."
    - TextId: 2
      Text: "\uADF8\uB807\uAC8C\uAE4C\uC9C0 \uB04C\uC5B4\uC548\uC73C\uBA74 \uBB50\uAC00
        \uB0A8\uB294\uB370?"
    - TextId: 6
      Text: "\uC801\uC5B4\uB3C4 \uB204\uAD70\uAC00\uB97C \uBBF8\uC6CC\uD558\uC9C0\uB294
        \uC54A\uC544\uB3C4 \uB418\uC796\uC544."
    - TextId: 4
      Text: "\uD504\uB9AC\uB4DC\u2026\u2026"
    - TextId: 6
      Text: "\uB0B4\uAC00 \uBABB\uD574\uC11C \uB05D\uB09C \uAC70\uB77C\uBA74,\n\uBBF8\uC6CC\uD574\uC57C
        \uD560 \uC0AC\uB78C\uC740 \uB098 \uD558\uB098\uBA74 \uB418\uB2C8\uAE4C."
    - TextId: 1
      Text: "(\uD504\uB9AC\uB4DC\uB294 \uC544\uC9C1\uB3C4 \uBAA8\uB4E0 \uCC45\uC784\uC744
        \uC790\uAE30 \uC548\uC5D0 \uBB36\uC5B4\uB450\uB824 \uD558\uACE0 \uC788\uC5B4.)"
    - TextId: 1
      Text: "(\uADF8 \uB9E4\uB4ED\uC744 \uD1A0\uB2C8 \uCABD\uC73C\uB85C \uC870\uAE08\uB9CC
        \uB3CC\uB9AC\uBA74 \uB418\uACA0\uB124.)"
    DesignerNote: 
  - ProfileClueId: P07_01
    CharacterId: 7
    ClueIndex: 1
    ClueText: "\uC0C8\uD134\uC740 \uC804\uD22C\uC5D0\uC11C \uC81C\uC790\uB9AC\uC5D0
      \uBA38\uBB34\uB294 \uAC83\uBCF4\uB2E4 \uC0C1\uD669\uC5D0 \uB9DE\uB294 \uC704\uCE58\uB97C
      \uC7A1\uB294 \uAC83\uC774 \uC911\uC694\uD558\uB2E4\uACE0 \uC0DD\uAC01\uD55C\uB2E4."
    HintText: "\uC0C8\uD134\uC740 \uC804\uD22C \uC911 \uD55C\uBC88 \uC815\uD55C \uC704\uCE58\uB97C
      \uB05D\uAE4C\uC9C0 \uC9C0\uD0A4\uB294 \uAC83\uC774 \uAC00\uC7A5 \uC548\uC804\uD558\uB2E4\uACE0
      \uC0DD\uAC01\uD55C\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uB9C8\uC8FC\uD55C \uC5D4\uBE44\uC640
      \uC0C8\uD134\uC758 \uCCAB \uC778\uC0AC"
    Combo: 0100000007000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uC0C8\uD134\uB2D8, \uB9DE\uC73C\uC2DC\uC8E0?\n\uC0C8\uB85C \uD569\uB958\uD55C
        \uC5D4\uBE44\uC608\uC694. \uC798 \uBD80\uD0C1\uB4DC\uB824\uC694."
    - TextId: 7
      Text: "\uC0C8\uD134.\n\uC6D0\uAC70\uB9AC \uC9C0\uC6D0\uC744 \uB9E1\uACE0 \uC788\uC5B4."
    - TextId: 1
      Text: "\uC6D0\uAC70\uB9AC \uC9C0\uC6D0\uC774\uBA74 \uB4A4\uCABD\uC5D0\uC11C
        \uC2F8\uC6B0\uC2DC\uB294 \uAC74\uAC00\uC694?"
    - TextId: 7
      Text: "\uC0C1\uD669\uC5D0 \uB530\uB77C \uB2EC\uB77C.\n\uC911\uC694\uD55C \uAC74
        \uB4A4\uC5D0 \uC788\uB294 \uAC8C \uC544\uB2C8\uB77C, \uC788\uC5B4\uC57C \uD560
        \uC704\uCE58\uC5D0 \uC788\uB294 \uAC70\uC57C."
    - TextId: 7
      Text: "\uC804\uD22C\uC5D0\uC11C\uB294 \uD55C \uBC1C \uB2A6\uAC8C \uC6C0\uC9C1\uC774\uB294
        \uAC83\uBCF4\uB2E4,\n\uC798\uBABB\uB41C \uC790\uB9AC\uC5D0 \uBA48\uCDB0 \uC788\uB294
        \uAC8C \uB354 \uC704\uD5D8\uD574."
    - TextId: 1
      Text: "\uADF8\uB7FC \uACC4\uC18D \uC704\uCE58\uB97C \uC0B4\uD53C\uC154\uC57C\uACA0\uB124\uC694."
    - TextId: 7
      Text: "\uB2F9\uC5F0\uD558\uC9C0. \uC704\uCE58\uAC00 \uBB34\uB108\uC9C0\uBA74
        \uC9C4\uD615\uB3C4 \uBB34\uB108\uC838."
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uC804\uD22C\uB97C \uC704\uCE58\uC640 \uD750\uB984\uC73C\uB85C
        \uBCF4\uB294 \uC0AC\uB78C\uC774\uB124.)"
    - TextId: 1
      Text: "(\uADF8\uB0A0 \uB204\uAC00 \uC5B4\uB514\uC5D0 \uC788\uC5C8\uB294\uC9C0\uAC00,
        \uC911\uC694\uD55C \uB2E8\uC11C\uAC00 \uB418\uACA0\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P07_02
    CharacterId: 7
    ClueIndex: 2
    ClueText: "\uC0C8\uD134\uC740 \uB8E8\uC774\uC2A4\uAC00 \uC704\uD5D8\uD55C \uC704\uCE58\uC5D0\uC11C
      \uB9DD\uC124\uC778 \uAC83\uC774 \uC804\uC7A5\uC744 \uB354 \uBD88\uC548\uC815\uD558\uAC8C
      \uB9CC\uB4E4\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uC0C8\uD134\uC740 \uB8E8\uC774\uC2A4\uAC00 \uADF8 \uC790\uB9AC\uC5D0
      \uBA48\uCDB0 \uC788\uC5C8\uAE30 \uB54C\uBB38\uC5D0 \uC804\uC7A5\uC774 \uB354
      \uC548\uC815\uC801\uC73C\uB85C \uC720\uC9C0\uB418\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0
      \uC788\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uC0C8\uD134\uC774 \uC9C0\uC801\uD55C
      \uADF8\uB0A0 \uB8E8\uC774\uC2A4\uC758 \uC704\uCE58"
    Combo: 010000000300000007000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P07_01
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 7
      Text: "\uB8E8\uC774\uC2A4. \uADF8\uB0A0 \uB124\uAC00 \uC11C \uC788\uB358 \uC704\uCE58,
        \uAE30\uC5B5\uD574?"
    - TextId: 3
      Text: "\u2026\u2026\uAE30\uC5B5\uD574. \uC804\uC7A5 \uC911\uAC04\uC774\uC5C8\uC9C0."
    - TextId: 7
      Text: "\uAC00\uC7A5 \uC560\uB9E4\uD55C \uC790\uB9AC\uC600\uC5B4.\n\uC55E\uC73C\uB85C
        \uB098\uC544\uAC04 \uAC83\uB3C4 \uC544\uB2C8\uACE0, \uB4A4\uB85C \uBB3C\uB7EC\uB09C
        \uAC83\uB3C4 \uC544\uB2C8\uC5C8\uC9C0."
    - TextId: 3
      Text: "\uC6C0\uC9C1\uC774\uBA74 \uB354 \uC704\uD5D8\uD574\uC9C8 \uAC83 \uAC19\uC558\uC5B4."
    - TextId: 7
      Text: "\uADF8\uB807\uAC8C \uBA48\uCDB0 \uC788\uB294 \uAC8C \uB354 \uC704\uD5D8\uD588\uC5B4.\n\uD6C4\uBC29
        \uACF5\uACA9\uC774 \uAE68\uC84C\uC744 \uB54C, \uD30C\uD3B8\uC774 \uD5A5\uD560
        \uC218 \uC788\uB294 \uC790\uB9AC\uC600\uC73C\uB2C8\uAE4C."
    - TextId: 3
      Text: "\uC9C0\uAE08\uC740 \uC54C\uACE0 \uC788\uC5B4."
    - TextId: 7
      Text: "\uADF8 \uC790\uB9AC\uB294 \uBE44\uC5B4 \uC788\uC5B4\uC57C \uD588\uC5B4.\n\uD6C4\uBC29
        \uACF5\uACA9\uC774 \uAE68\uC9C0\uBA74, \uD30C\uD3B8\uC774 \uD758\uB7EC\uB4E4
        \uC704\uCE58\uC600\uC73C\uB2C8\uAE4C."
    - TextId: 3
      Text: "\u2026\u2026\uC6C0\uC9C1\uC774\uBA74 \uB354 \uD754\uB4E4\uB9B4 \uAC70\uB77C\uACE0
        \uC0DD\uAC01\uD588\uC5B4."
    - TextId: 7
      Text: "\uD558\uC9C0\uB9CC \uB10C \uAC70\uAE30\uC5D0 \uB0A8\uC558\uACE0,\n\uACB0\uAD6D
        \uD30C\uD3B8\uC740 \uADF8\uCABD\uC73C\uB85C \uD280\uC5C8\uC5B4."
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uB8E8\uC774\uC2A4\uAC00 \uBA48\uCD98 \uC774\uC720\uBCF4\uB2E4,\n\uADF8\uAC00
        \uC11C \uC788\uB358 \uC704\uCE58\uB97C \uB354 \uBB38\uC81C\uB85C \uBCF4\uACE0
        \uC788\uB124.)"
    - TextId: 1
      Text: "(\uB8E8\uC774\uC2A4\uC758 \uB9DD\uC124\uC784\uC740 \uC0C8\uD134\uC5D0\uAC8C
        \uC804\uC7A5\uC758 \uBE48\uD2C8\uC73C\uB85C \uB0A8\uC544 \uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P07_03
    CharacterId: 7
    ClueIndex: 3
    ClueText: "\uC0C8\uD134\uC740 \uB8E8\uC774\uC2A4 \uACC1\uC744 \uB5A0\uB09C \uAC83\uC774
      \uB3C4\uB9DD\uC774 \uC544\uB2C8\uB77C, \uD6C4\uBC29 \uACF5\uACA9\uC744 \uB9C9\uAE30
      \uC704\uD55C \uD310\uB2E8\uC774\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0
      \uC788\uB2E4."
    HintText: "\uC0C8\uD134\uC740 \uADF8\uB0A0 \uB8E8\uC774\uC2A4 \uACC1\uC744 \uB5A0\uB09C
      \uC774\uC720\uAC00 \uC790\uC2E0\uC758 \uC548\uC804\uC744 \uBA3C\uC800 \uD655\uBCF4\uD558\uAE30
      \uC704\uD574\uC11C\uC600\uB2E4\uACE0 \uC778\uC815\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uB9C8\uC8FC\uD55C \uB370\uC6B0\uC2A4\uC640
      \uC0C8\uD134\uC758 \uC5C7\uAC08\uB9B0 \uAE30\uC5B5"
    Combo: 010000000400000007000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P07_02
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uC0C8\uD134. \uADF8\uB0A0 \uB108\uB294 \uB8E8\uC774\uC2A4 \uACC1\uC744
        \uB5A0\uB0AC\uC5B4."
    - TextId: 7
      Text: "\uC54C\uC544."
    - TextId: 4
      Text: "\uB098\uB294 \uB108\uD55C\uD14C \uBD80\uD0C1\uD588\uC5B4.\n\uB0B4\uAC00
        \uAE30\uB3C4\uD558\uB294 \uB3D9\uC548\uB9CC\uC774\uB77C\uB3C4 \uB8E8\uC774\uC2A4
        \uACC1\uC5D0 \uC788\uC5B4\uB2EC\uB77C\uACE0."
    - TextId: 7
      Text: "\uD6C4\uBC29 \uACF5\uACA9\uC774 \uB4E4\uC5B4\uC624\uACE0 \uC788\uC5C8\uC5B4.\n\uADF8\uAC78
        \uB9C9\uC9C0 \uC54A\uC73C\uBA74 \uC804\uC7A5\uC774 \uBB34\uB108\uC84C\uC744
        \uAC70\uC57C."
    - TextId: 4
      Text: "\uADF8\uB798\uB3C4 \uB8E8\uC774\uC2A4\uB294 \uB124 \uC606\uC5D0 \uC788\uC5C8\uC796\uC544."
    - TextId: 7
      Text: "\uADF8\uB798\uC11C \uB354 \uBE68\uB9AC \uC6C0\uC9C1\uC5EC\uC57C \uD588\uC5B4.\n\uB0B4\uAC00
        \uB2A6\uC73C\uBA74, \uB8E8\uC774\uC2A4\uB9CC\uC774 \uC544\uB2C8\uB77C \uBAA8\uB450\uAC00
        \uC704\uD5D8\uD588\uC73C\uB2C8\uAE4C."
    - TextId: 4
      Text: "\uB108\uB294 \uD56D\uC0C1 \uADF8\uB7F0 \uC2DD\uC774\uC57C.\n\uB5A0\uB098\uC57C
        \uD560 \uC774\uC720\uBD80\uD130 \uCC3E\uC9C0."
    - TextId: 7
      Text: "\uB3C4\uB9DD\uCE5C \uAC8C \uC544\uB2C8\uC57C.\n\uB0B4\uAC00 \uC788\uC5B4\uC57C
        \uD560 \uC704\uCE58\uAC00 \uBC14\uB010 \uAC70\uC57C."
    - TextId: 1
      Text: "(\uB370\uC6B0\uC2A4\uB294 \uC0C8\uD134\uC774 \uB8E8\uC774\uC2A4\uB97C
        \uBC84\uB838\uB2E4\uACE0 \uBCF4\uACE0 \uC788\uACE0,\n\uC0C8\uD134\uC740 \uD6C4\uBC29\uC744
        \uB9C9\uAE30 \uC704\uD574 \uC6C0\uC9C1\uC600\uB2E4\uACE0 \uBBFF\uACE0 \uC788\uB124.)"
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uC790\uC2E0\uC774 \uB3C4\uB9DD\uCE5C \uAC8C \uC544\uB2C8\uB77C,
        \uD300\uC744 \uC704\uD55C \uC704\uCE58\uB85C \uC62E\uACBC\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0
        \uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P07_04
    CharacterId: 7
    ClueIndex: 4
    ClueText: "\uC0C8\uD134\uC740 \uBAA8\uB450\uB97C \uC0B4\uB9AC\uAE30 \uC704\uD55C
      \uD310\uB2E8\uC774\uC5C8\uB2E4\uACE0 \uBBFF\uACE0 \uC788\uC9C0\uB9CC, \uADF8
      \uACB0\uACFC \uC544\uBB34\uB3C4 \uB0A8\uC9C0 \uC54A\uC558\uB2E4\uB294 \uC0AC\uC2E4
      \uC55E\uC5D0\uC11C \uD754\uB4E4\uB9AC\uACE0 \uC788\uB2E4."
    HintText: "\uC0C8\uD134\uC740 \uB3D9\uB8CC\uB4E4\uC774 \uBAA8\uB450 \uC8FD\uC740
      \uB4A4\uC5D0\uB3C4 \uC790\uC2E0\uC758 \uD310\uB2E8\uC5D0 \uC544\uBB34\uB7F0
      \uC758\uC2EC\uC774\uB098 \uB3D9\uC694\uB97C \uB290\uB07C\uC9C0 \uC54A\uACE0
      \uC788\uB2E4."
    HintDescription: "\uC5F0\uC778\uC758 \uD30C\uAD6D, \uB3D9\uB8CC\uB4E4\uC758 \uC8FD\uC74C\u2026
      \uC0C8\uD134\uC740 \uB05D\uB0B4 \uC790\uC2E0\uC758 \uD310\uB2E8\uC774 \uB0A8\uAE34
      \uACB0\uACFC\uB97C \uB9C8\uC8FC\uD588\uB2E4."
    Combo: 010000000400000007000000
    PlaceName: 
    DeadRequired: 02000000030000000500000006000000
    Prerequisites:
    - P04_04
    - P07_03
    SimultaneousIds:
    - P04_05
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uC0C8\uD134. \uB108\uB294 \uD6C4\uBC29\uC744 \uB9C9\uC73C\uB824\uACE0
        \uC6C0\uC9C1\uC600\uB2E4\uACE0 \uD588\uC9C0."
    - TextId: 7
      Text: "\uADF8\uB798. \uADF8\uB54C\uB294 \uADF8\uAC8C \uBAA8\uB450\uB97C \uC0B4\uB9AC\uB294
        \uAE38\uC774\uB77C\uACE0 \uC0DD\uAC01\uD588\uC5B4."
    - TextId: 4
      Text: "\uBAA8\uB450\uB77C\uB2C8. \uC9C0\uAE08 \uC5EC\uAE30\uC5D4 \uB204\uAC00
        \uB0A8\uC544 \uC788\uB294\uB370?"
    - TextId: 4
      Text: "\uBA54\uC774\uB3C4 \uC8FD\uC5C8\uC5B4!\n\uD1A0\uB2C8\uB3C4, \uD504\uB9AC\uB4DC\uB3C4,
        \uB8E8\uC774\uC2A4\uB3C4 \uBAA8\uB450 \uC5C6\uB2E4\uACE0!"
    - TextId: 7
      Text: "\uB370\uC6B0\uC2A4."
    - TextId: 4
      Text: "\uB098\uB294 \uB8E8\uC774\uC2A4\uB97C \uB9E1\uACBC\uC5C8\uC9C0."
    - TextId: 7
      Text: "\uD6C4\uBC29 \uACF5\uACA9\uC744 \uB9C9\uC9C0 \uC54A\uC558\uB2E4\uBA74,\n\uB354
        \uB9CE\uC740 \uC0AC\uB78C\uC774 \uC8FD\uC5C8\uC744 \uAC70\uC57C."
    - TextId: 4
      Text: "\uADF8 \uB9D0, \uC774\uC81C \uC544\uBB34 \uC758\uBBF8 \uC5C6\uC5B4.\n\uACB0\uAD6D
        \uC544\uBB34\uB3C4 \uB0A8\uC9C0 \uC54A\uC558\uC796\uC544."
    - TextId: 4
      Text: "\uB124\uAC00 \uB9C9\uC544\uB0B8 \uAC74 \uD6C4\uBC29\uC774\uC5C8\uC9C0.\n\uB8E8\uC774\uC2A4\uB294
        \uC544\uB2C8\uC5C8\uC5B4."
    - TextId: 7
      Text: "\uB098\uB294 \uBAA8\uB450\uB97C \uC0B4\uB9AC\uB824\uACE0 \uD588\uC5B4."
    - TextId: 4
      Text: "\uADF8 \uBAA8\uB450 \uC548\uC5D0,\n\uB8E8\uC774\uC2A4\uB294 \uC5C6\uC5C8\uB098
        \uBD10."
    - TextId: 1
      Text: "(\uB370\uC6B0\uC2A4\uB294 \uC0C8\uD134\uC774 \uBB34\uC5C7\uC744 \uB9C9\uC558\uB294\uC9C0\uBCF4\uB2E4,\n\uBB34\uC5C7\uC744
        \uB193\uCCE4\uB294\uC9C0\uB9CC \uBCF4\uACE0 \uC788\uB124.)"
    - TextId: 1
      Text: "(\uD558\uC9C0\uB9CC \uC0C8\uD134\uB3C4 \uD754\uB4E4\uB9AC\uACE0 \uC788\uC5B4.\n\uD300\uC744
        \uC704\uD55C \uD310\uB2E8\uC774\uC5C8\uB2E4\uB294 \uB9D0\uC774, \uC774\uC81C\uB294
        \uC2A4\uC2A4\uB85C\uB97C \uBC84\uD2F0\uAC8C \uD558\uB294 \uBCC0\uBA85\uCC98\uB7FC
        \uB4E4\uB9AC\uACA0\uB124.)"
    - TextId: 1
      Text: "(\uC544\uB9C8 \uB610 \uCC98\uC74C\uC73C\uB85C \uB418\uB3CC\uC544\uAC00\uACA0\uC9C0.\n\uB2E4\uC74C\uC5D0\uB294
        \uC0C8\uD134\uC5D0\uAC8C\uB3C4 \uC774 \uADE0\uC5F4\uC744 \uB354 \uC77C\uCC0D
        \uC2EC\uC5B4\uB46C\uC57C\uACA0\uC5B4.)"
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uBAA8\uB450\uB97C \uAD6C\uD558\uB824 \uD588\uACE0,
        \uACB0\uAD6D \uC544\uBB34\uB3C4 \uAD6C\uD558\uC9C0 \uBABB\uD588\uB2E4.\n\uC774
        \uBAA8\uC21C\uC774 \uC0C8\uD134\uC744 \uD754\uB4E4 \uC5F4\uC1E0\uC57C.)"
    DesignerNote: "\uD574\uB2F9 \uC870\uAC01 \uD68D\uB4DD \uC2DC \uC790\uB3D9\uC73C\uB85C
      P04_05\uAC00 \uB3D9\uC2DC \uD68D\uB4DD\uB428"
  - ProfileClueId: P07_05
    CharacterId: 7
    ClueIndex: 5
    ClueText: "\uC0C8\uD134\uC740 \uB4A4\uB2A6\uAC8C \uC6A9\uBCD1\uB2E8\uC758 \uBD95\uAD34\uAC00
      \uC11C\uB85C\uC758 \uC624\uD574\uC640 \uCE68\uBB35\uC5D0\uC11C \uBE44\uB86F\uB418\uC5C8\uB2E4\uACE0
      \uAE68\uB2EB\uACE0 \uC788\uB2E4."
    HintText: "\uC0C8\uD134\uC740 \uB3D9\uB8CC\uB4E4\uC758 \uC8FD\uC74C\uC5D0 \uBB34\uB364\uB364\uD588\uB2E4."
    HintDescription: "\uC0C8\uD134\uC740 \uBAA8\uB450\uAC00 \uC8FD\uC744 \uB54C\uAE4C\uC9C0
      \uBC29\uAD00\uD588\uB2E4."
    Combo: 0100000007000000
    PlaceName: 
    DeadRequired: 0200000003000000040000000500000006000000
    Prerequisites:
    - P07_04
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uC6A9\uBCD1\uB2E8\uC758 \uB3D9\uB8CC\uB4E4\uC740 \uC885\uC885 \uB9D0\uD588\uC8E0.
        \uC0C8\uD134\uB2D8\uC740 \uD56D\uC0C1 \uC790\uC2E0\uC758 \uBAA9\uC228\uC744
        \uC6B0\uC120\uC2DC \uD55C\uB2E4\uACE0\uC694."
    - TextId: 7
      Text: "\uADF8\uAC74 \uC624\uD574\uC57C.. \uB098\uB294 \uD300\uC744 \uC704\uD55C
        \uD310\uB2E8\uC744 \uD588\uC5B4. \uADF8\uB54C\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uC57C.
        \uD300\uC744 \uAD6C\uD558\uAE30 \uC704\uD574 \uD6C4\uBC29\uC73C\uB85C \uC774\uB3D9\uD574\uC57C
        \uD55C\uB2E4\uB294 \uC120\uD0DD\uC744 \uD55C \uAC83\uBFD0\uC774\uC57C."
    - TextId: 1
      Text: "\uC9C0\uAE08\uB3C4 \uD300\uC744 \uC704\uD55C \uD310\uB2E8\uC744 \uD55C
        \uAC74\uAC00\uC694? \uC758\uC2EC\uC758 \uC528\uC557\uC774 \uACB0\uAD6D \uC774
        \uC6A9\uBCD1\uB2E8\uC744 \uD30C\uAD6D\uC73C\uB85C \uC774\uB04C\uC5C8\uC5B4\uC694.
        \uC0C8\uD134\uB2D8\uC740 \uADF8\uAC78 \uAC00\uB9CC\uD788 \uC9C0\uCF1C\uBCF4\uC168\uACE0\uC694."
    - TextId: 7
      Text: "\uB9D0\uD558\uC9C0 \uC54A\uC73C\uBA74 \uBAB0\uB77C... \uC6B0\uB9AC\uB4E4\uC740
        \uB300\uD654\uAC00 \uD544\uC694\uD588\uC5B4..."
    - TextId: 1
      Text: "(\uC0DD\uAC01\uBCF4\uB2E4 \uB0C9\uCCA0\uD55C \uC131\uACA9\uC774\uC57C.
        \uC624\uD574\uC758 \uC528\uC557\uC744 \uC2EC\uAE30 \uC704\uD574\uC120 \uC2E0\uC911\uD574\uC57C
        \uB420 \uD544\uC694\uAC00 \uC788\uACA0\uC5B4. \uC544\uB9C8 \uB610 \uCC98\uC74C\uC73C\uB85C
        \uB418\uB3CC\uC544\uAC08\uAC70\uC57C. \uB300\uBE44\uB97C \uD558\uC790.)"
    DesignerNote: 
