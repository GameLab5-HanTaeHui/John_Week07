--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18c9251cd66a9054e91ce5b6b9949e22, type: 3}
  m_Name: Fragment_S01
  m_EditorClassIdentifier: Assembly-CSharp::HTH.Campaign.FragmentDataSO
  _stageId: CampaignMode
  _fragments:
  - ProfileClueId: P01_01
    CharacterId: 1
    ClueIndex: 1
    ClueText: "\uC0AC\uB78C\uACFC \uC7A5\uC18C\uAC00 \uB531 \uB9DE\uC544\uB5A8\uC5B4\uC9C0\uBA74,
      \uD3C9\uC18C\uC5D4 \uAF2D\uAF2D \uC228\uACA8\uB480\uB358 \uB9D0\uC774 \uD758\uB7EC\uB098\uC62C
      \uB54C\uAC00 \uC788\uC5B4! \uC5ED\uC2DC \uC0AC\uB78C\uC740 \uBD84\uC704\uAE30\uB97C
      \uD0C0\uB294 \uBC95\uC774\uB2C8\uAE4C~"
    HintText: "\uD558\uB8E8\uC5D0 \uC544\uCE68, \uC810\uC2EC, \uC800\uB141 \uCD1D
      \uC138\uBC88 \uB300\uD654\uB97C \uBCFC \uC218 \uC788\uC5B4!"
    HintDescription: "\uC5D4\uBE44\uB294 \uD1F4\uACE0 \uD6C4\uC5D0\uB3C4 \uAE30\uC5B5\uC774
      \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uB294 \uD2B9\uBCC4\uD55C \uB2A5\uB825\uC744
      \uAC00\uC9C0\uACE0 \uC788\uB2E4!"
    Combo: 
    PlaceName: 
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines: []
    DesignerNote: 
  - ProfileClueId: P01_02
    CharacterId: 1
    ClueIndex: 2
    ClueText: "\uC5D4\uBE44\uAC00 \uC5C6\uB294 \uACF3\uC758 \uB300\uD654\uB294 \uB4E4\uC744
      \uC218 \uC5C6\uC5B4! \uB2E8\uC11C\uB97C \uC6D0\uD55C\uB2E4\uBA74, \uC5D4\uBE44\uB3C4
      \uADF8 \uC790\uB9AC\uC5D0 \uC788\uC5B4\uC57C \uD574! \uC5D4\uBE44\uC758 \uADC0\uB9CC
      \uB530\uB85C \uB5BC\uC5B4\uC904 \uC218 \uC5C6\uC73C\uB2C8\uAE4C~"
    HintText: "\uD558\uB8E8\uAC00 \uC9C0\uB098\uBA74 \uC778\uBB38\uB4E4\uC774 \uC6D0\uB798
      \uC788\uB358 \uC7A5\uC18C\uB85C \uB3CC\uC544\uC640!\n\uC8FD\uC5C8\uB358 \uC0AC\uB78C\uB3C4
      \uBFC5 \uD558\uACE0 \uC0B4\uC544\uB09C\uB2E4\uAD6C?"
    HintDescription: "\uC5D4\uBE44\uAC00 \uC5C6\uB294 \uACF3\uC758 \uB300\uD654\uB294
      \uB4E4\uC744 \uC218 \uC5C6\uB2E4. \uC5D4\uBE44\uC758 \uADC0\uB294 \uD558\uB098\uBFD0\uC774\uB2C8\uAE4C!"
    Combo: 
    PlaceName: 
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines: []
    DesignerNote: 
  - ProfileClueId: P01_03
    CharacterId: 1
    ClueIndex: 3
    ClueText: "\uB300\uD654\uB97C \uB05D\uAE4C\uC9C0 \uB4E4\uC73C\uBA74, \uADF8 \uC0AC\uB78C\uC758
      \uB9C8\uC74C \uD55C \uC870\uAC01\uC744 \uC5BB\uC744 \uC218 \uC788\uC5B4! \uB2E4\uB4E4
      \uC5D4\uBE44\uB97C \uC2E0\uB8B0\uD55C\uB2E4\uB294 \uB73B\uC774\uACA0\uC9C0><"
    HintText: "\uC0AC\uB78C\uB4E4\uC744 \uC8FD\uC774\uB294 \uAC78 \uB9DD\uC124\uC774\uC9C0
      \uB9D0\uC790!\n\uC77C\uB2E8 \uC800\uC9C8\uB7EC \uBC84\uB9AC\uB294\uAC70\uC57C!"
    HintDescription: "\uC5D4\uBE44\uB294 \uB2E4\uB978 \uC0AC\uB78C\uC758 \uB9D0\uC5D0\uC11C
      \uC544\uC8FC \uC791\uC740 \uADE0\uC5F4\uC744 \uC798 \uCC3E\uC544\uB0B8\uB2E4.
      \uCE6D\uCC2C\uD574\uB3C4 \uB3FC!"
    Combo: 
    PlaceName: 
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines: []
    DesignerNote: 
  - ProfileClueId: P01_04
    CharacterId: 1
    ClueIndex: 4
    ClueText: "\uADF8\uB7F0\uB370 \uADF8 \uC870\uAC01\uC744 \uC804\uBD80 \uC9C4\uC9DC\uB77C\uACE0
      \uBBFF\uC73C\uBA74 \uC548 \uB3FC!"
    HintText: 
    HintDescription: "\uC5D4\uBE44\uB294 \uBAA8\uB450\uC758 \uD3B8\uC778 \uCC99\uD558\uC9C0\uB9CC,
      \uC0AC\uC2E4 \uAC00\uC7A5 \uBA3C\uC800 \uC758\uC2EC\uBD80\uD130 \uD55C\uB2E4.
      \uB098\uC05C \uAC74 \uC544\uB2C8\uC57C. \uCD94\uB9AC\uB2C8\uAE4C!"
    Combo: 
    PlaceName: 
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines: []
    DesignerNote: 
  - ProfileClueId: P01_05
    CharacterId: 1
    ClueIndex: 5
    ClueText: "\uC870\uAC01\uB4E4\uC744 \uC798 \uBE44\uAD50\uD574 \uBD10!"
    HintText: 
    HintDescription: "\uC5D4\uBE44\uAC00 \uBAA8\uC740 \uC870\uAC01\uB4E4\uC740 \uD1F4\uACE0\uB97C
      \uB118\uC5B4 \uAE30\uB85D\uB41C\uB2E4. \uBC18\uBCF5\uB418\uB294 \uAC74 \uD3C9\uBC94\uD55C
      \uB2E8\uC6D0\uB4E4 \uBFD0!"
    Combo: 
    PlaceName: 
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines: []
    DesignerNote: 
  - ProfileClueId: P02_01
    CharacterId: 2
    ClueIndex: 1
    ClueText: "\uBA54\uC774\uB294 \uC6A9\uBCD1\uB2E8\uC758 \uCE68\uBB35\uC774 \uB4DC\uB798\uACE4\uC744
      \uB193\uCE5C \uC0AC\uAC74\uC5D0\uC11C \uBE44\uB86F\uB418\uC5C8\uB2E4\uACE0
      \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uBA54\uC774\uB294 \uC6A9\uBCD1\uB2E8\uC774 \uC6D0\uB798\uBD80\uD130
      \uC870\uC6A9\uD55C \uBD84\uC704\uAE30\uC600\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0
      \uC788\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uC2E0\uC785\uACFC \uBA54\uC774\uC758
      \uCCAB \uC778\uC0AC"
    Combo: 0100000002000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uBA54\uC774\uB2D8 \uB9DE\uC73C\uC2DC\uC8E0? \uC624\uB298\uBD80\uD130
        \uD569\uB958\uD558\uAC8C \uB41C \uC5D4\uBE44\uC5D0\uC694.\n\uC798 \uBD80\uD0C1\uB4DC\uB824\uC694!"
    - TextId: 2
      Text: "\uC2E0\uC785? \uADF8\uB798. \uC798 \uBD80\uD0C1\uD574.\n\uB8E8\uC774\uC2A4
        \uB300\uC2E0 \uB4E4\uC5B4\uC628 \uAC70\uB2C8\uAE4C \uC801\uB2F9\uD788 \uD574\uC11C\uB294
        \uC548 \uB420\uAC70\uC57C."
    - TextId: 1
      Text: "\uB8E8\uC774\uC2A4\uB2D8\uC774\uB77C\uBA74 \uADF8 \uC131\uAE30\uC0AC\uBD84
        \uB9D0\uC500\uD558\uC2DC\uB294\uAC70\uC8E0?\n\uC870\uAE08 \uBD80\uB2F4\uB418\uB124\uC694."
    - TextId: 2
      Text: "\uBD80\uB2F4 \uAC00\uC838. \uC6A9\uBCD1\uB2E8\uC740 \uBD80\uB2F4 \uC5C6\uC774
        \uD560 \uC218 \uC788\uB294 \uC77C\uC774 \uC544\uB2C8\uB2C8\uAE4C."
    - TextId: 1
      Text: "\uC557, \uC54C\uACA0\uC2B5\uB2C8\uB2E4..!\n\uBA54\uC774\uB2D8\uC740
        \uAD49\uC7A5\uD788 \uB2E8\uD638\uD558\uC2DC\uB124\uC694."
    - TextId: 2
      Text: "\uB9DD\uC124\uC774\uB294 \uAC83 \uBCF4\uB2E4\uB294 \uB098\uC544.\n\uC6B0\uB9AC\uB294
        \uB9DD\uC124\uC774\uB2E4\uAC00 \uB4DC\uB798\uACE4\uC744 \uB193\uCCE4\uAC70\uB4E0."
    - TextId: 1
      Text: "\uB4DC\uB798\uACE4\uC774\uC694?! \uC778\uC0DD\uC5D0\uC11C \uD55C \uBC88
        \uBCFC\uAE4C \uB9D0\uAE4C \uD55C \uD76C\uADC0\uD55C \uBAAC\uC2A4\uD130\uC778\uB370...!"
    - TextId: 2
      Text: "\uC815\uB9D0 \uAC70\uC758 \uB2E4 \uC7A1\uC558\uC5C8\uC5B4.\n\uB0B4\uAC00
        \uC870\uAE08\uB9CC \uB354 \uBE68\uB790\uB354\uB77C\uBA74..."
    - TextId: 1
      Text: "\uC9C0\uAE08 \uB4DC\uB798\uACE4 \uC18C\uC7AC\uAC00 \uD76C\uADC0\uD574\uC11C
        \uC815\uB9D0 \uBE44\uC2FC \uAC12\uC5D0 \uD314\uB9AC\uACE0 \uC788\uB2E4\uB294
        \uC18C\uC2DD\uC744 \uB4E4\uC5C8\uC5B4\uC694.\n\uB108\uBB34 \uC544\uAE4C\uC6CC\uC694..."
    - TextId: 2
      Text: "\uB3C8 \uBFD0\uB9CC \uC544\uB2C8\uB77C \uC6B0\uB9AC \uC6A9\uBCD1\uB2E8\uC758
        \uC774\uB984\uC744 \uC54C\uB9B4 \uC808\uD638\uC758 \uAE30\uD68C\uC600\uB294\uB370.\n...\uADF8
        \uD6C4\uB85C \uC6B0\uB9AC \uC6A9\uBCD1\uB2E8 \uBD84\uC704\uAE30\uB3C4 \uC5B4\uC218\uC120\uD574\uC84C\uC5B4.\n\uC2E0\uC785,
        \uBD84\uC704\uAE30\uAC00 \uC880 \uADF8\uB807\uB354\uB77C\uB3C4 \uC774\uD574\uD574\uB77C."
    - TextId: 1
      Text: "\uC557, \uB124. \uC870\uC2EC\uD558\uACA0\uC2B5\uB2C8\uB2E4.\n\uADF8\uB7F0\uB370
        \uC5B4\uCA4C\uB2E4\uAC00 \uB193\uCE5C\uAC74\uAC00\uC694...?"
    - TextId: 2
      Text: "...\uADF8\uAC74 \uC544\uC9C1 \uB124\uAC00 \uC54C \uC77C\uC774 \uC544\uB2C8\uC57C."
    DesignerNote: "\"\uD29C\uD1A0\uB9AC\uC5BC\uC5D0\uC11C \uC5BB\uC744 \uC218 \uC788\uB294"
  - ProfileClueId: P02_02
    CharacterId: 2
    ClueIndex: 2
    ClueText: "\uBA54\uC774\uB294 \uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB97C
      \uC6B0\uC120\uD558\uB294 \uD0DC\uB3C4 \uB54C\uBB38\uC5D0 \uAE30\uD68C\uB97C
      \uB193\uCCE4\uB2E4\uACE0 \uB290\uB07C\uACE0 \uC788\uB2E4."
    HintText: "\uBA54\uC774\uB294 \uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB9CC
      \uBD24\uB2E4\uB294 \uC0AC\uC2E4\uC5D0 \uC9C8\uD22C\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uB418\uC9DA\uC5B4 \uBCF4\uB294
      \uBA54\uC774\uC640 \uB8E8\uC774\uC2A4\uC758 \uAE30\uC5B5\n\uD544\uC694 \uB2E8\uC11C:
      \uD6C8\uB828\uC7A5\uC5D0\uC11C \uC2E0\uC785\uACFC \uBA54\uC774\uC758 \uCCAB
      \uC778\uC0AC"
    Combo: 010000000200000003000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites:
    - P02_01
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uB8E8\uC774\uC2A4. \uADF8\uB0A0 \uB370\uC6B0\uC2A4\uAC00 \uB110 \uBCF4\uC790\uB9C8\uC790
        \uC5B4\uB5A4 \uD45C\uC815\uC744 \uC9C0\uC5C8\uB294\uC9C0 \uC54C\uC544?"
    - TextId: 3
      Text: "\uB098\uB3C4 \uC815\uD655\uD788\uB294 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC544.\n\uB4DC\uB798\uACE4\uC744
        \uBD24\uACE0... \uB208\uC744 \uB728\uB2C8\uAE4C \uBCD1\uC2E4\uC5D0 \uC788\uC5C8\uC5B4."
    - TextId: 2
      Text: "\uB098\uB294 \uAE30\uC5B5\uD574. \uB4DC\uB798\uACE4\uB3C4, \uC804\uD669\uB3C4,
        \uB0B4 \uAC80\uB3C4 \uC548\uC911\uC5D0 \uC5C6\uC5C8\uC5B4.\n\uADF8 \uC560
        \uB208\uC5D0\uB294 \uB108\uBC16\uC5D0 \uC5C6\uC5C8\uC9C0."
    - TextId: 3
      Text: "\uADF8\uAC74 \uB0B4 \uD0D3\uC774\uC57C. \uB0B4\uAC00 \uADF8 \uC790\uB9AC\uC5D0
        \uBA48\uCDB0 \uC788\uC9C0 \uC54A\uC558\uB2E4\uBA74\u2014"
    - TextId: 2
      Text: "\uB610 \uB124 \uD0D3\uC774\uB77C\uACE0 \uD558\uB824\uACE0?\n\uB8E8\uC774\uC2A4,
        \uB124\uAC00 \uC4F0\uB7EC\uC9C4 \uAC74 \uC2DC\uC791\uC774\uC5C8\uC5B4. \uB370\uC6B0\uC2A4\uC758
        \uC8FC\uBB38\uC774 \uBAA8\uB4E0\uAC78 \uB05D\uB0B4\uBC84\uB9B0\uAC70\uC9C0."
    - TextId: 3
      Text: "\uBA54\uC774! \uC124\uB9C8 \uB370\uC6B0\uC2A4\uB97C \uD0D3\uD558\uB824\uB294\uAC70\uC57C?"
    - TextId: 2
      Text: "\uB098\uB294 \uC544\uC9C1\uB3C4 \uBAA8\uB974\uACA0\uC5B4.\n\uADF8 \uC21C\uAC04
        \uB370\uC6B0\uC2A4\uAC00 \uBCF8 \uAC8C \uC815\uB9D0 \uBD80\uC0C1\uC790\uC600\uB294\uC9C0,
        \uC544\uB2C8\uBA74 \uB8E8\uC774\uC2A4 \uB108 \uD558\uB098\uC600\uB294\uC9C0."
    - TextId: 2
      Text: "\uB8E8\uC774\uC2A4, \uC6B0\uB9AC\uAC00 \uB0A0\uB9B0 \uAE30\uD68C\uB294
        \uC791\uC740 \uAC8C \uC544\uB2C8\uC57C.\n\uB108\uB3C4 \uC9C0\uAE08 \uB2E4\uCE5C
        \uC0C1\uD0DC\uB77C \uC54C\uACA0\uC9C0\uB9CC \uACC4\uC18D \uD638\uC704\uAC19\uC740
        \uC791\uC740 \uC784\uBB34\uB9CC \uD558\uB2E4\uAC00 \uBD80\uC0C1\uB2F9\uD558\uBA74
        \uC6B0\uB9AC\uB294 \uB05D\uC774\uC57C.\n\uC791\uC740 \uAE30\uD68C\uB77C\uB3C4
        \uC7A1\uC544\uC57C \uD574."
    - TextId: 3
      Text: "\uBB34\uC2A8 \uB9D0\uC778\uC9C0\uB294 \uC54C\uACA0\uC5B4.\n\uC804\uBD80
        \uB0B4 \uC798\uBABB\uC774\uC57C.\n\uADF8\uB7EC\uB2C8\uAE4C \uB370\uC6B0\uC2A4\uC758
        \uD0D3\uC740 \uD558\uC9C0 \uB9D0\uC544\uC918."
    - TextId: 2
      Text: "\uD558. \uB208\uBB3C\uACA8\uC6CC\uC11C \uBABB\uBD10\uC8FC\uACA0\uB124."
    - TextId: 1
      Text: "(\uBA54\uC774\uB294 \uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB9CC
        \uBCF4\uACE0 \uC788\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uB124.)"
    - TextId: 1
      Text: "(\uC544\uC9C1 \uC9C1\uC811 \uB9D0\uD558\uC9C4 \uC54A\uC9C0\uB9CC, \uC6D0\uB9DD\uC740
        \uC774\uBBF8 \uADF8\uCABD\uC73C\uB85C \uD5A5\uD558\uACE0 \uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P02_03
    CharacterId: 2
    ClueIndex: 3
    ClueText: "\uBA54\uC774\uB294 \uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB97C
      \uC720\uB3C5 \uBA3C\uC800 \uCC59\uAE30\uB294 \uAC83\uC744 \uC624\uB798 \uC804\uBD80\uD130
      \uBD88\uD3B8\uD558\uAC8C \uB290\uAF08\uB2E4."
    HintText: "\uBA54\uC774\uB294 \uB370\uC6B0\uC2A4\uC758 \uD68C\uBCF5 \uB2A5\uB825\uC774\uB098
      \uD504\uB9AC\uC2A4\uD2B8 \uC5ED\uD560 \uC790\uCCB4\uB97C \uBD88\uC2E0\uD558\uACE0
      \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uBC1C\uC0DD\uD55C \uBA54\uC774\uC640
      \uC5F0\uC778\uC758 \uCDA9\uB3CC\n\uD544\uC694 \uB2E8\uC11C: \uC608\uBC30\uC2E4\uC5D0\uC11C
      \uB418\uC9DA\uC5B4 \uBCF4\uB294 \uBA54\uC774\uC640 \uB8E8\uC774\uC2A4\uC758
      \uAE30\uC5B5"
    Combo: 01000000020000000300000004000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites:
    - P02_02
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uB8E8\uC774\uC2A4\uB2D8, \uC57D \uB4DC\uC2E4 \uC2DC\uAC04\uC785\uB2C8\uB2E4."
    - TextId: 3
      Text: "\uC870\uAE08 \uC774\uB530\uAC00 \uBA39\uC744\uAC8C."
    - TextId: 4
      Text: "\uADF8\uB7EC\uB2E4 \uB610 \uB193\uCE58\uC2ED\uB2C8\uB2E4. \uC9C0\uAE08
        \uB4DC\uC138\uC694."
    - TextId: 2
      Text: "\uB370\uC6B0\uC2A4, \uB8E8\uC774\uC2A4\uAC00 \uC560\uB3C4 \uC544\uB2C8\uACE0."
    - TextId: 4
      Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uAD1C\uCC2E\uB2E4\uACE0 \uB9D0\uD558\uACE0
        \uB118\uC5B4\uAC00\uB294 \uC77C\uC774 \uB9CE\uC73C\uB2C8\uAE4C\uC694."
    - TextId: 2
      Text: "\uB8E8\uC774\uC2A4\uAC00 \uADF8\uB807\uAE34 \uD558\uC9C0.\n\uD558\uC9C0\uB9CC
        \uB370\uC6B0\uC2A4\uB294 \uB298 \uB8E8\uC774\uC2A4\uAC00 \uAD1C\uCC2E\uC740\uC9C0\uBD80\uD130
        \uBCF4\uC796\uC544."
    - TextId: 1
      Text: "\uB370\uC6B0\uC2A4\uB2D8\uC774 \uC138\uC2EC\uD558\uC154\uC11C \uADF8\uB7F0
        \uAC70 \uC544\uB2CC\uAC00\uC694?\n\uB8E8\uC774\uC2A4\uB2D8\uC758 \uCE58\uB8CC\uB97C
        \uC804\uB2F4\uD558\uACE0 \uACC4\uC2DC\uAE30\uB3C4 \uD558\uACE0."
    - TextId: 2
      Text: "\uC138\uC2EC\uD558\uC9C0. \uB8E8\uC774\uC2A4\uD55C\uD14C\uB294."
    - TextId: 4
      Text: "\uBA54\uC774\uB2D8. \uC800\uB294 \uB8E8\uC774\uC2A4\uB2D8\uB9CC \uC2E0\uACBD\uC4F0\uB294\uAC8C
        \uC544\uB2C8\uC5D0\uC694.\n\uBAA8\uB4E0 \uB2E8\uC6D0\uB4E4\uC758 \uAC74\uAC15\uC744
        \uD56D\uC0C1 \uD655\uC778\uD558\uACE0 \uC788\uC5B4\uC694."
    - TextId: 2
      Text: "\uC544, \uBB50. \uD2C0\uB9B0 \uB9D0\uC740 \uC544\uB2C8\uC796\uC544.\n\uC804\uD22C
        \uC911\uC5D0\uB3C4, \uC2DD\uC0AC \uC911\uC5D0\uB3C4, \uC758\uB8B0 \uBC1B\uC744
        \uB54C\uB3C4.\n\uD56D\uC0C1 \uB8E8\uC774\uC2A4\uB9CC \uBCF4\uACE0 \uC788\uC796\uC544."
    - TextId: 3
      Text: "\uBA54\uC774, \uADF8\uB9CC\uD574. \uB370\uC6B0\uC2A4\uB294 \uD504\uB9AC\uC2A4\uD2B8\uB85C\uC11C
        \uC5ED\uD560\uC5D0 \uCDA9\uC2E4\uD55C \uAC83 \uBFD0\uC774\uC796\uC544."
    - TextId: 2
      Text: "\uC54C\uC558\uC5B4. \uB098\uB3C4 \uB370\uC6B0\uC2A4\uAC00 \uB098\uC058\uB2E4\uB294
        \uB9D0\uC740 \uC548 \uD588\uC5B4."
    - TextId: 1
      Text: "\uBA54\uC774\uB2D8\uC740 \uB370\uC6B0\uC2A4\uB2D8\uC774 \uB8E8\uC774\uC2A4\uB2D8\uC744
        \uCC59\uAE30\uB294 \uAC8C \uBD88\uD3B8\uD558\uC138\uC694?"
    - TextId: 2
      Text: "\uBD88\uD3B8\uD558\uB2E4\uAE30\uBCF4\uB2E8... \uAD81\uAE08\uD55C \uAC70\uC57C."
    - TextId: 1
      Text: "\uBB50\uAC00\uC694?"
    - TextId: 2
      Text: "\uB370\uC6B0\uC2A4 \uB208\uC5D0, \uB8E8\uC774\uC2A4 \uB9D0\uACE0 \uB2E4\uB978
        \uC0AC\uB78C\uB3C4 \uC81C\uB300\uB85C \uBCF4\uC774\uB294\uC9C0."
    - TextId: 1
      Text: "(\uBA54\uC774\uB294 \uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB97C
        \uCC59\uAE30\uB294 \uAC78 \uB2E8\uC21C\uD55C \uBC30\uB824\uB85C\uB9CC \uBCF4\uC9C0
        \uC54A\uC544.)"
    - TextId: 1
      Text: "(\uC704\uAE09\uD55C \uC21C\uAC04\uC5D0\uB3C4 \uB370\uC6B0\uC2A4\uAC00
        \uB204\uAD6C\uB97C \uBA3C\uC800 \uBCFC\uC9C0 \uC774\uBBF8 \uC758\uC2EC\uD558\uACE0
        \uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P02_04
    CharacterId: 2
    ClueIndex: 4
    ClueText: "\uBA54\uC774\uB294 \uD1A0\uB2C8\uAC00 \uB2E8\uC21C\uD788 \uB3C4\uB9DD\uCE5C
      \uAC83\uC774 \uC544\uB2C8\uB77C, \uC790\uC2E0\uC758 \uBC29\uC2DD\uC73C\uB85C
      \uC6A9\uBCD1\uB2E8\uC744 \uC9C0\uD0A4\uB824 \uD588\uC744 \uAC00\uB2A5\uC131\uC744
      \uC758\uC2DD\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uBA54\uC774\uB294 \uD1A0\uB2C8\uAC00 \uBB3C\uD488\uC744 \uCC59\uAE34
      \uD589\uB3D9\uC744 \uCC98\uC74C\uBD80\uD130 \uC6A9\uBCD1\uB2E8\uC744 \uBC84\uB9AC\uAE30
      \uC704\uD55C \uBC30\uC2E0\uC73C\uB85C \uD655\uC2E0\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uCC3D\uACE0\uC5D0\uC11C \uBA54\uC774\uC640 \uD504\uB9AC\uB4DC\uAC00
      \uB418\uC9DA\uC740 \uD1A0\uB2C8\uC758 \uC758\uB3C4\n\uD544\uC694 \uB2E8\uC11C:
      \uC608\uBC30\uC2E4\uC5D0\uC11C \uBC1C\uC0DD\uD55C \uBA54\uC774\uC640 \uC5F0\uC778\uC758
      \uCDA9\uB3CC"
    Combo: 010000000200000006000000
    PlaceName: "\uCC3D\uACE0"
    DeadRequired: 
    Prerequisites:
    - P02_03
    SimultaneousIds:
    - P05_03
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uD760... \uBC27\uC904\uC774 \uC5B4\uB514 \uC788\uB354\uB77C.\n\uADF8\uB098\uC800\uB098
        \uC5EC\uAE34 \uC5EC\uC804\uD788 \uBB3C\uD488\uC774 \uB9CE\uAD70.\n\uAE54\uB054\uD558\uAC8C
        \uC190\uC9C8\uB418\uC5B4 \uC788\uC5B4."
    - TextId: 6
      Text: "\uD1A0\uB2C8\uAC00 \uAD00\uB9AC\uD558\uB358\uAC70\uC57C.\n\uD1A0\uB2C8\uB294
        \uADF8\uB7F0 \uAC78 \uAC00\uBCCD\uAC8C \uC5EC\uAE30\uC9C0 \uC54A\uC558\uC5B4.\n\uC758\uB8B0
        \uBB3C\uD488\uB3C4, \uBCF4\uAE09\uD488\uB3C4, \uACC4\uC57D\uB3C4."
    - TextId: 2
      Text: "\uC544. \uD504\uB9AC\uB4DC. \uD1A0\uB2C8\uB294 \uD504\uB9AC\uB4DC\uB97C
        \uD3C9\uC18C\uC5D0 \uC798 \uB530\uB790\uC9C0.\n(\uB098\uB294 \uBB34\uC11C\uC6CC
        \uD558\uB358\uB370...)"
    - TextId: 2
      Text: "...\uADF8\uB798\uC11C \uADF8 \uB0A0 \uBB3C\uD488\uC744 \uB4E4\uACE0
        \uB3C4\uB9DD\uCE5C\uAC74\uAC00?\n\uB4DC\uB798\uACE4\uC774 \uB208\uC55E\uC5D0
        \uC788\uC5C8\uB294\uB370\uB3C4?"
    - TextId: 6
      Text: "\uD1A0\uB2C8\uB294 \uC2F8\uC6B8 \uC218 \uC5C6\uC5C8\uC5B4.\n\uADF8\uB7EC\uB2C8\uAE4C
        \uC790\uC2E0\uC774 \uD560 \uC218 \uC788\uB294 \uC77C\uC744 \uD558\uB824 \uD588\uACA0\uC9C0."
    - TextId: 2
      Text: "\uBB34\uC2A8 \uC77C\uC744 \uD558\uB824\uACE0 \uD55C \uAC70\uC9C0?"
    - TextId: 6
      Text: "\uC544\uB9C8... \uBB3C\uD488\uC744 \uC9C0\uD0A4\uB824\uACE0 \uD588\uB358
        \uAC83 \uAC19\uC544.\n\uD1A0\uB2C8\uC5D0\uAC8C\uB294 \uADF8\uAC8C \uC6B0\uB9AC
        \uC6A9\uBCD1\uB2E8\uC744 \uC9C0\uD0A4\uB294 \uBC29\uC2DD\uC774\uC5C8\uC744
        \uAC70\uC57C."
    - TextId: 2
      Text: "\u2026\u2026"
    - TextId: 6
      Text: "\uADF8 \uC21C\uAC04 \uD1A0\uB2C8\uC640 \uBB3C\uD488\uC774 \uBCF4\uC774\uC9C0
        \uC54A\uC558\uB358 \uAC83\uB3C4 \uC0AC\uC2E4\uC774\uC57C.\n\uB098\uB294 \uBA54\uC774
        \uB108\uC640, \uD1A0\uB2C8\uC640, \uBB3C\uD488\uAE4C\uC9C0 \uBAA8\uB450 \uBCF4\uB824\uB2E4
        \uBC29\uC5B4\uC5D0 \uC2E4\uD328\uD588\uACE0.\n\uD558\uC9C0\uB9CC \uD1A0\uB2C8\uB294
        \uB3C4\uC6C0\uC774 \uB418\uB824\uACE0 \uD588\uB358 \uAC83 \uAC19\uC544.\n\uC544\uC9C1
        \uC5B4\uB9B0 \uC544\uC774\uB2C8\uAE4C \uB108\uBB34 \uBAB0\uC544\uC138\uC6B0\uC9C0
        \uB9C8."
    - TextId: 2
      Text: "...\uADF8\uB0A0 \uC6B0\uB9AC\uB294 \uC804\uBD80 \uB2E4\uB978 \uAC78
        \uBCF4\uACE0 \uC788\uC5C8\uB358 \uAC74\uAC00.\n\uB0B4\uAC00 \uC624\uD574\uB97C
        \uD588\uAD70.\n\uB2E4\uB978 \uB2E8\uC6D0\uB4E4\uC5D0\uAC8C\uB3C4 \uB9D0\uD574\uB450\uB3C4\uB85D
        \uD558\uC9C0."
    - TextId: 1
      Text: "(\uBA54\uC774\uB294 \uD1A0\uB2C8\uB97C \uB2E8\uC21C\uD55C \uB3C4\uB9DD\uC790\uB85C\uB9CC
        \uBCF4\uACE0 \uC788\uC5C8\uC5B4.)"
    - TextId: 1
      Text: "(\uD558\uC9C0\uB9CC \uD1A0\uB2C8\uC5D0\uAC8C\uB3C4 \uC9C0\uD0A4\uB824\uB358
        \uAC8C \uC788\uC5C8\uB2E4\uB294 \uAC70\uB124.)"
    DesignerNote: "\"\uD574\uB2F9 \uC870\uAC01 \uD68D\uB4DD \uC2DC \uC790\uB3D9\uC73C\uB85C"
  - ProfileClueId: P02_05
    CharacterId: 2
    ClueIndex: 5
    ClueText: "\uBA54\uC774\uB294 \uB4A4\uB2A6\uAC8C \uC6A9\uBCD1\uB2E8\uC758 \uBD95\uAD34\uAC00
      \uC11C\uB85C\uC758 \uC624\uD574\uC640 \uCE68\uBB35\uC5D0\uC11C \uBE44\uB86F\uB418\uC5C8\uB2E4\uACE0
      \uAE68\uB2EB\uACE0 \uC788\uB2E4."
    HintText: "\uBA54\uC774\uB294 \uD1A0\uB2C8\uB97C \uCC98\uB2E8\uD55C \uAC83\uC73C\uB85C
      \uC6A9\uBCD1\uB2E8\uC758 \uADE0\uC5F4\uC774 \uC644\uC804\uD788 \uD574\uC18C\uB418\uC5C8\uB2E4\uACE0
      \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uD1A0\uB2C8\uB97C \uB2E8\uC8C4\uD588\uC9C0\uB9CC, \uC544\uBB34\uB3C4
      \uB0A8\uC9C0 \uC54A\uC558\uB2E4.\n\uD544\uC694 \uB2E8\uC11C: \uCC3D\uACE0\uC5D0\uC11C
      \uBC1C\uACAC\uD55C \uD1A0\uB2C8\uC758 \uC815\uC2E0 \uCC29\uB780, \uCC3D\uACE0\uC5D0\uC11C
      \uBA54\uC774\uC640 \uD504\uB9AC\uB4DC\uAC00 \uB418\uC9DA\uC740 \uD1A0\uB2C8\uC758
      \uC758\uB3C4"
    Combo: 010000000200000005000000
    PlaceName: 
    DeadRequired: 03000000040000000600000007000000
    Prerequisites:
    - P02_04
    - P05_01
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uD1A0\uB2C8!!!! \uC5B4\uC9F8\uC11C \uADF8\uB7F0 \uC9D3\uC744 \uD55C
        \uAC70\uC57C!!"
    - TextId: 1
      Text: "\uB054\uCC0D\uD55C \uC9D3\uC744 \uC800\uC9C8\uB800\uC5B4\uC694.. \uB3C4\uB300\uCCB4
        \uC6A9\uBCD1\uB2E8 \uC548\uC5D0\uB294 \uBB34\uC2A8 \uC77C\uC774 \uC788\uB358
        \uAC74\uAC00\uC694?\n\uB4DC\uB798\uACE4\uACFC \uC870\uC6B0\uD588\uB358 \uADF8
        \uC0AC\uAC74, \uB2E8\uC21C \uD300\uD569\uC758 \uBB38\uC81C\uAC00 \uC544\uB2C8\uC5C8\uB358
        \uAC74\uAC00\uC694?"
    - TextId: 2
      Text: "\uC544\uBB34 \uAC83\uB3C4 \uC228\uAE30\uC9C0 \uC54A\uC558\uC5B4... \uC788\uB294
        \uADF8\uB300\uB85C\uC57C.\n\uC815\uB9D0 \uC0AC\uC18C\uD55C, \uC544\uC8FC
        \uC0AC\uC18C\uD55C \uC624\uD574 \uD558\uB098\uAC00 \uB208\uB369\uC774\uCC98\uB7FC
        \uCEE4\uC84C\uC744 \uBFD0\uC774\uC57C..."
    - TextId: 1
      Text: "\uC815\uB9D0 \uC544\uBB34 \uC77C\uB3C4 \uC5C6\uC5C8\uB2E4\uBA74, \uC774\uB7F0
        \uC2DD\uC73C\uB85C \uC6A9\uBCD1\uB2E8\uC774 \uD30C\uAD6D\uC73C\uB85C \uCE58\uB2EB\uC558\uC744
        \uB9AC \uC5C6\uC796\uC544\uC694!"
    - TextId: 2
      Text: "\uD1A0\uB2C8\uB294 \uB450\uB824\uC6CC\uD588\uC744 \uAC70\uC57C.\n\uC790\uC2E0\uC774
        \uB3C4\uC6C0\uC774 \uB418\uC9C0 \uBABB\uD588\uB2E4\uB294 \uC0AC\uC2E4 \uC790\uCCB4\uC5D0
        \uC774\uBBF8 \uC9D3\uB20C\uB9AC\uACE0 \uC788\uB294 \uC0C1\uD0DC\uC600\uB358
        \uAC70\uC57C..."
    - TextId: 2
      Text: "\uB2E4\uB4E4 \uB611\uAC19\uC558\uC5B4.. \uB0B4\uAC00 \uB193\uCE58\uACE0
        \uC2F6\uC9C0 \uC54A\uC740 \uAE30\uD68C\uB3C4 \uB3D9\uB8CC\uB4E4\uC758 \uB208\uC5D0\uB294
        \uADF8\uC800 \uBB34\uBAA8\uD55C \uD589\uB3D9\uC73C\uB85C \uBCF4\uC600\uB358
        \uAC70\uACA0\uC9C0.\n\uB370\uC6B0\uC2A4\uC758 \uADC0\uD658 \uC8FC\uBB38\uB3C4
        \uB9C8\uCC2C\uAC00\uC9C0\uC57C.\n\uC5B4\uCA4C\uBA74, \uADF8\uB3C4 \uBAA8\uB450\uB97C
        \uC9C0\uD0A4\uAE30 \uC704\uD55C \uCD5C\uC120\uC758 \uC120\uD0DD\uC744 \uD55C
        \uAC78\uC9C0\uB3C4..."
    - TextId: 1
      Text: "\uB9D0\uD558\uC9C0 \uC54A\uC73C\uBA74 \uC54C \uC218 \uC5C6\uB294 \uAC70\uC5D0\uC694.\n\uC0AC\uB78C\uB4E4\uC740
        \uAC01\uC790 \uC800\uB9C8\uB2E4\uC758 \uBC29\uC2DD\uC73C\uB85C \uC138\uC0C1\uC744
        \uD574\uC11D\uD558\uB2C8\uAE4C\uC694."
    - TextId: 2
      Text: "\uADF8\uB798... \uB0A8\uB4E4 \uB208\uC5D0\uB294, \uB0B4\uAC00 \uADF8\uC800
        \uB9E4\uBC88\n\uBB34\uB9AC\uD558\uB294 \uBBF8\uB828\uD55C \uC0AC\uB78C\uC73C\uB85C
        \uBCF4\uC600\uC744\n\uD14C\uC9C0..."
    - TextId: 2
      Text: "\uC774\uC81C \uB2E4 \uB05D\uB0AC\uC5B4. \uC544\uBB34 \uC18C\uC6A9\uC774
        \uC5C6\uC5B4.\n\uB193\uCCD0\uBC84\uB9B0 \uB4DC\uB798\uACE4\uB3C4, \uC313\uC5EC\uBC84\uB9B0
        \uC624\uD574\uB3C4... \uBAA8\uB450 \uBB34\uC758\uBBF8\uD574\uC84C\uC5B4."
    - TextId: 1
      Text: "(\uC6A9\uBCD1\uB2E8\uC740 \uC644\uC804\uD788 \uBD95\uAD34 \uB410\uC5B4...
        \uC774\uAC78\uB85C \uC774\uC81C \uB05D\uC778\uAC00?)"
    DesignerNote: 
  - ProfileClueId: P03_01
    CharacterId: 3
    ClueIndex: 1
    ClueText: "\uB8E8\uC774\uC2A4\uB294 \uC798\uBABB \uD310\uB2E8\uD574 \uBAA8\uB450\uC5D0\uAC8C
      \uD53C\uD574\uB97C \uC904\uAE4C \uBD10 \uC27D\uAC8C \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0
      \uBABB\uD55C\uB2E4."
    HintText: "\uB8E8\uC774\uC2A4\uB294 \uC704\uD5D8\uD55C \uC0C1\uD669\uC77C\uC218\uB85D
      \uBE60\uB974\uAC8C \uACB0\uC815\uC744 \uB0B4\uB9AC\uB294 \uAC83\uC774 \uAC00\uC7A5
      \uC911\uC694\uD558\uB2E4\uACE0 \uC0DD\uAC01\uD55C\uB2E4."
    HintDescription: "\uC5EC\uAD00\uC5D0\uC11C \uC2E0\uC785\uACFC \uB8E8\uC774\uC2A4\uC758
      \uCCAB \uC778\uC0AC"
    Combo: 0100000003000000
    PlaceName: "\uC5EC\uAD00"
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uB8E8\uC774\uC2A4\uB2D8, \uB9DE\uC73C\uC2DC\uC8E0?\n\uC624\uB298\uBD80\uD130
        \uD569\uB958\uD558\uAC8C \uB41C \uC5D4\uBE44\uC608\uC694. \uC798 \uBD80\uD0C1\uB4DC\uB824\uC694."
    - TextId: 3
      Text: "\uB8E8\uC774\uC2A4\uC57C. \uB098\uB3C4 \uC798 \uBD80\uD0C1\uD574."
    - TextId: 1
      Text: "\uB2E4\uB4E4 \uC624\uB798 \uD568\uAED8\uD558\uC2E0 \uAC83 \uAC19\uC544\uC11C
        \uC870\uAE08 \uAE34\uC7A5\uD588\uC5B4\uC694.\n\uC81C\uAC00 \uBB54\uAC00 \uC870\uC2EC\uD574\uC57C
        \uD560 \uAC8C \uC788\uC744\uAE4C\uC694?"
    - TextId: 3
      Text: "\uC870\uC2EC\uD574\uC57C \uD560 \uAC83\u2026\u2026"
    - TextId: 1
      Text: "\uC5B4\uB835\uAC8C \uC0DD\uAC01\uD558\uC9C0 \uC54A\uC73C\uC154\uB3C4
        \uB3FC\uC694.\n\uADF8\uB0E5 \uC2E0\uC785\uC5D0\uAC8C \uD574\uC8FC\uACE0 \uC2F6\uC740
        \uB9D0 \uAC19\uC740 \uAC70\uC694."
    - TextId: 3
      Text: "\uBB34\uC5B8\uAC00\uB97C \uC815\uD574\uC57C \uD560 \uB54C\uB294, \uB108\uBB34
        \uBE68\uB9AC \uB2F5\uC744 \uB0B4\uB9AC\uC9C0 \uC54A\uB294 \uAC8C \uC88B\uC544."
    - TextId: 1
      Text: "\uC2E0\uC911\uD558\uAC8C \uD310\uB2E8\uD558\uB77C\uB294 \uB9D0\uC500\uC774\uC2E0\uAC00\uC694?"
    - TextId: 3
      Text: "\uD55C \uBC88 \uC798\uBABB \uC815\uD558\uBA74, \uADF8 \uC120\uD0DD\uC744
        \uB418\uB3CC\uB9B4 \uC218 \uC5C6\uC744 \uB54C\uAC00 \uC788\uAC70\uB4E0."
    - TextId: 1
      Text: "\uADF8\uB7FC \uC5B8\uC81C \uC6C0\uC9C1\uC5EC\uC57C \uD558\uB294\uC9C0\uB294
        \uC5B4\uB5BB\uAC8C \uC544\uB098\uC694?"
    - TextId: 3
      Text: "\uADF8\uAC78 \uC54C \uC218 \uC788\uB2E4\uBA74 \uC88B\uACA0\uC9C0."
    - TextId: 1
      Text: "(\uB8E8\uC774\uC2A4\uB294 \uC27D\uAC8C \uACB0\uC815\uC744 \uB0B4\uB9AC\uC9C0
        \uBABB\uD558\uB294 \uC0AC\uB78C\uC774\uB124.)"
    - TextId: 1
      Text: "(\uC798\uBABB\uB41C \uD310\uB2E8\uC774 \uB204\uAD70\uAC00\uB97C \uB2E4\uCE58\uAC8C
        \uD560\uAE4C \uBD10 \uB450\uB824\uC6CC\uD558\uACE0 \uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P03_02
    CharacterId: 3
    ClueIndex: 2
    ClueText: "\uB8E8\uC774\uC2A4\uB294 \uBA54\uC774\uAC00 \uC790\uC2E0\uC758 \uD310\uB2E8\uC744
      \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uACE0 \uBA3C\uC800 \uC6C0\uC9C1\uC600\uB2E4\uB294
      \uC0AC\uC2E4\uC744 \uB9C8\uC74C\uC5D0 \uAC78\uB824 \uD558\uACE0 \uC788\uB2E4."
    HintText: "\uB8E8\uC774\uC2A4\uB294 \uBA54\uC774\uAC00 \uC790\uC2E0\uC758 \uD310\uB2E8\uC744
      \uAE30\uB2E4\uB9B0 \uB4A4 \uD568\uAED8 \uC6C0\uC9C1\uC778 \uAC83\uC5D0 \uB9CC\uC871\uD558\uACE0
      \uC788\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uC54C\uAC8C\uB41C \uBA54\uC774\uC640
      \uB8E8\uC774\uC2A4\uC758 \uC5C7\uAC08\uB9B0 \uD310\uB2E8\n\uD544\uC694 \uB2E8\uC11C:
      \uC5EC\uAD00\uC5D0\uC11C \uC2E0\uC785\uACFC \uB8E8\uC774\uC2A4\uC758 \uCCAB
      \uC778\uC0AC"
    Combo: 010000000200000003000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P03_01
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 3
      Text: "\uC624\uB298 \uC800\uB141 \uBA54\uB274\uB294 \uBB58\uB85C \uD558\uBA74
        \uC88B\uC744\uAE4C.\n\uC74C.. \uC0C8\uD134\uC740 \uACE0\uAE30\uB97C \uC2EB\uC5B4\uD558\uC9C0.\n\uC0C8\uD134\uB3C4
        \uBA39\uC744 \uC218 \uC788\uB294 \uACE0\uAE30 \uC694\uB9AC\uB97C \uCC3E\uC544\uBCFC\uAE4C."
    - TextId: 2
      Text: "\uB8E8\uC774\uC2A4, \uC800\uB141 \uBA54\uB274 \uD558\uB098 \uC815\uD558\uB294
        \uB370\uB3C4 \uADF8\uB807\uAC8C \uC624\uB798 \uAC78\uB824?"
    - TextId: 3
      Text: "\uB2E4\uB4E4 \uBA39\uAE30 \uC2EB\uC740 \uAC8C \uC788\uC744 \uC218\uB3C4
        \uC788\uC796\uC544."
    - TextId: 2
      Text: "\uADF8\uB7FC \uACE0\uAE30\uB791 \uCC44\uC18C \uBC18\uBC18 \uC11E\uC778
        \uC2A4\uD29C\uB85C \uD574.\n\uACC4\uC18D \uC0DD\uAC01\uB9CC \uD558\uB2E4
        \uC800\uB141 \uBABB\uBA39\uACA0\uB2E4."
    - TextId: 3
      Text: "\uADF8\uB807\uC9C0\uB9CC \uC0C8\uD134\uC774... ...\uC544\uB0D0.\n\uADF8\uB807\uAC8C
        \uD558\uC790."
    - TextId: 2
      Text: "\uC0C8\uD134\uC740 \uACE0\uAE30 \uC2EB\uC5B4\uD558\uB2C8\uAE4C, \uC57C\uCC44\uB9CC
        \uB123\uC5B4\uC11C \uB530\uB85C \uB9CC\uB4E4\uAC70\uC57C.\n\uC2DC\uAC04 \uB9DE\uCDB0\uC11C
        \uBA39\uC73C\uB7EC \uC640."
    - TextId: 1
      Text: "\uBA54\uC774\uB2D8\uC774 \uC815\uD558\uBA74 \uB8E8\uC774\uC2A4\uB2D8\uC740
        \uBCF4\uD1B5 \uB530\uB974\uC2DC\uB124\uC694."
    - TextId: 3
      Text: "\uBA54\uC774\uB294 \uBE60\uB974\uAC8C \uD569\uB9AC\uC801\uC778 \uD310\uB2E8\uC744
        \uD558\uB2C8\uAE4C.\n\uADF8\uB798\uC11C \uB2E4\uB4E4 \uBA54\uC774\uB97C \uB530\uB974\uB294
        \uD3B8\uC774\uC57C.\n\uADF8 \uB0A0\uC5D0\uB3C4 \uADF8\uB7AC\uC9C0."
    - TextId: 1
      Text: "(\uB8E8\uC774\uC2A4\uB294 \uBA54\uC774\uC758 \uC120\uD0DD\uC744 \uBCC4\uB85C
        \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4 \uD558\uC9C0 \uC54A\uB294 \uAC83 \uAC19\uB124.)"
    DesignerNote: 
  - ProfileClueId: P03_03
    CharacterId: 3
    ClueIndex: 3
    ClueText: "\uB8E8\uC774\uC2A4\uB294 \uB4DC\uB798\uACE4\uC758 \uC704\uD5D8\uC131\uC744
      \uC54C\uC558\uC9C0\uB9CC, \uB9D0 \uD560 \uD0C0\uC774\uBC0D\uC744 \uB193\uCCD0
      \uC804\uC7A5 \uAC00\uC6B4\uB370 \uB0A8\uAC8C \uB418\uC5C8\uB2E4."
    HintText: "\uB8E8\uC774\uC2A4\uB294 \uC804\uC7A5 \uD55C\uAC00\uC6B4\uB370\uAC00
      \uC548\uC804\uD55C \uC7A5\uC18C\uB77C\uACE0 \uC0DD\uAC01\uD574 \uADF8\uACF3\uC5D0
      \uBA38\uBB3C\uB800\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uC0C8\uD134\uC5D0\uAC8C \uBC1D\uD788\uB294
      \uB8E8\uC774\uC2A4\uC758 \uC774\uC720\n\uD544\uC694 \uB2E8\uC11C: \uD6C8\uB828\uC7A5\uC5D0\uC11C
      \uC54C\uAC8C\uB41C \uBA54\uC774\uC640 \uB8E8\uC774\uC2A4\uC758 \uC5C7\uAC08\uB9B0
      \uD310\uB2E8"
    Combo: 010000000300000007000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P03_02
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 7
      Text: "\uB8E8\uC774\uC2A4, \uADF8\uB0A0 \uC65C \uADF8 \uC790\uB9AC\uC5D0 \uACC4\uC18D
        \uC11C \uC788\uC5C8\uC5B4?"
    - TextId: 3
      Text: "\uB4DC\uB798\uACE4\uC744 \uC7A1\uC544\uC57C \uD560 \uC9C0, \uB3C4\uB9DD\uCCD0\uC57C
        \uD560 \uC9C0 \uC0DD\uAC01\uD558\uACE0 \uC788\uC5C8\uC5B4."
    - TextId: 7
      Text: "\uADF8\uB798\uB3C4 \uAC00\uB9CC\uD788 \uC788\uB294\uAC74 \uB108\uBB34
        \uC704\uD5D8\uD588\uC5B4.\n\uADF8 \uC704\uCE58\uB294 \uB4DC\uB798\uACE4\uC758
        \uD6C4\uBC29 \uACF5\uACA9\uC758 \uD30C\uD3B8\uC774 \uD288 \uC218 \uC788\uB294
        \uAC00\uC7A5 \uC704\uD5D8\uD55C \uC790\uB9AC\uC600\uC5B4.\n\uC804\uD22C\uAC00
        \uBC8C\uC5B4\uC9C0\uBA74 \uC790\uC2E0\uC758 \uBAB8\uC740 \uC2A4\uC2A4\uB85C
        \uC9C0\uCF1C\uC57C \uD574."
    - TextId: 3
      Text: "\uC54C\uACE0\uB294 \uC788\uC5C8\uC9C0\uB9CC... \uC0DD\uAC01\uD560 \uD2C8\uB3C4
        \uC5C6\uC774\n\uBA54\uC774\uAC00 \uB6F0\uCCD0\uB098\uAC14\uACE0, \uBA54\uC774\uB97C
        \uBD80\uB974\uBA74 \uBA54\uC774\uC758\n\uC815\uC2E0\uC774 \uD750\uD2B8\uB7EC\uC838
        \uB4DC\uB798\uACE4\uC758 \uACF5\uACA9\uC5D0 \uB2F9\uD560 \uAC83\n\uAC19\uC558\uC5B4."
    - TextId: 3
      Text: "\uB098\uB294 \uC6B0\uC120 \uC804\uD22C\uB97C \uC911\uB2E8\uD558\uACE0
        \uC2F6\uC5C8\uC5B4.\n\uADF8 \uC640\uC911\uC5D0 \uB2E4\uB4E4 \uBA54\uC774\uB97C
        \uB530\uB77C \uC804\uD22C\uB97C \uC2DC\uC791\uD588\uACE0, \uC77C\uC774 \uAC77\uC7A1\uC744
        \uC218 \uC5C6\uC774 \uCEE4\uC9C0\uB294 \uAC83 \uAC19\uC544\uC11C \uC544\uBB34\uAC83\uB3C4
        \uD560 \uC218 \uC5C6\uC5C8\uC5B4."
    - TextId: 7
      Text: "\uC65C \uADF8\uB807\uAC8C\uAE4C\uC9C0 \uC804\uD22C\uB97C \uB9DD\uC124\uC600\uB358\uAC70\uC57C?\n\uADF8\uC815\uB3C4
        \uD06C\uAE30\uC758 \uB4DC\uB798\uACE4\uC774\uB77C\uBA74 \uC6B0\uB9AC\uB3C4
        \uCDA9\uBD84\uD788 \uC7A1\uC744 \uC218 \uC788\uC5C8\uC796\uC544. \uADF8 \uB4DC\uB798\uACE4\uC744
        \uC7A1\uC558\uB354\uB77C\uBA74 \uC6B0\uB9AC\uC758 \uCC98\uC9C0\uB3C4 \uD6E8\uC52C
        \uC88B\uC544\uC84C\uC744\uD150\uB370. \uBA54\uC774\uAC00 \uB204\uAD6C\uBCF4\uB2E4
        \uC6B0\uB9AC \uC6A9\uBCD1\uB2E8\uC774 \uC798 \uB418\uAE38 \uBC14\uB77C\uACE0
        \uC788\uB2E4\uB294 \uAC78 \uC54C\uC796\uC544."
    - TextId: 3
      Text: "\uC5ED\uC2DC... \uB2E4\uB4E4 \uC804\uD600 \uBAB0\uB790\uAD6C\uB098.\n\uADF8
        \uB4DC\uB798\uACE4\uC740 \uC77C\uBC18 \uB4DC\uB798\uACE4\uACFC \uBE44\uC2B7\uD558\uAC8C
        \uC0DD\uAE34 \uD76C\uADC0\uC885\uC774\uC600\uC5B4.\n\uAC89\uBAA8\uC2B5\uC5D0
        \uC18D\uC544\uC11C \uB364\uBCD0\uB2E4\uAC00 \uC804\uBA78\uD55C \uC6A9\uBCD1\uB2E8\uC774
        \uD55C\uB458\uC774 \uC544\uB0D0."
    - TextId: 7
      Text: "\uBB50?! \uADF8\uB7F0 \uAC74 \uB354 \uBE68\uB9AC \uB9D0 \uD588\uC5B4\uC57C\uC9C0!"
    - TextId: 3
      Text: "...\uB9D0 \uD560 \uD0C0\uC774\uBC0D\uC744 \uC7A0\uAE50 \uB193\uCE5C
        \uC0AC\uC774\uC5D0 \uB108\uBB34 \uB9CE\uC740 \uC77C\uC774 \uC77C\uC5B4\uB0AC\uC5B4."
    - TextId: 7
      Text: "\uD558\uC544... \uC5B4\uCA50\uC9C0.\n\uBCF4\uD1B5 \uBA54\uC774\uC5D0\uAC8C
        \uB9DE\uCDB0\uC8FC\uB294 \uB124\uAC00 \uC774\uC0C1\uD558\uB9AC\uB9CC\uCE58
        \uAC00\uB9CC\uD788 \uC788\uB354\uB77C."
    - TextId: 3
      Text: "...\uB354 \uBE68\uB9AC \uB9D0\uD588\uB354\uB77C\uBA74 \uBB54\uAC00 \uB2EC\uB77C\uC84C\uC744\uAE4C?"
    - TextId: 7
      Text: "\uC544\uB0D0. \uC9C0\uAE08 \uC640\uC11C \uADF8\uB7F0\uAC74 \uBB34\uC758\uBBF8\uD574.\n\uD479
        \uC26C\uACE0 \uC5BC\uB978 \uB0AB\uAE30\uB098 \uD574.\n\uB2E4\uB4E4 \uAC71\uC815\uD558\uACE0
        \uC788\uC5B4."
    - TextId: 1
      Text: "(\uB8E8\uC774\uC2A4\uB294 \uB3C4\uB9DD\uCE58\uB824\uACE0 \uBA48\uCD98
        \uAC8C \uC544\uB2C8\uC57C.)"
    - TextId: 1
      Text: "(\uC798\uBABB \uC6C0\uC9C1\uC77C\uAE4C \uBD10 \uBA48\uCDC4\uACE0, \uADF8\uAC8C
        \uB354 \uD070 \uBE48\uD2C8\uC774 \uB41C \uAC70\uB124.)"
    DesignerNote: 
  - ProfileClueId: P03_04
    CharacterId: 3
    ClueIndex: 4
    ClueText: "\uB8E8\uC774\uC2A4\uB294 \uC790\uC2E0\uC774 \uADF8\uB0A0 \uC544\uBB34
      \uACB0\uC815\uB3C4 \uB0B4\uB9AC\uC9C0 \uBABB\uD588\uB2E4\uB294 \uC0AC\uC2E4\uC744
      \uC544\uC9C1 \uC790\uCC45\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uB8E8\uC774\uC2A4\uB294 \uADF8\uB0A0 \uC790\uC2E0\uC774 \uCDA9\uBD84\uD788
      \uBA85\uD655\uD55C \uC9C0\uC2DC\uB97C \uB0B4\uB838\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0
      \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uBCF4\uAC8C\uB41C \uB8E8\uC774\uC2A4\uC758
      \uC790\uCC45\uACFC \uC704\uB85C\uD558\uB294 \uB370\uC6B0\uC2A4\n\uD544\uC694
      \uB2E8\uC11C: \uD6C8\uB828\uC7A5\uC5D0\uC11C \uC0C8\uD134\uC5D0\uAC8C \uBC1D\uD788\uB294
      \uB8E8\uC774\uC2A4\uC758 \uC774\uC720"
    Combo: 010000000300000004000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites:
    - P03_03
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uADF8\uB0A0 \uC77C, \uC544\uC9C1\uB3C4 \uB8E8\uC774\uC2A4\uB2D8 \uD0D3\uC774\uB77C\uACE0
        \uC0DD\uAC01\uD558\uC138\uC694?"
    - TextId: 3
      Text: "\u2026\u2026\uC544\uB2C8\uB77C\uACE0 \uB9D0\uD558\uACE0 \uC2F6\uC5B4.\n\uADF8\uB7F0\uB370
        \uC798 \uC548 \uB3FC."
    - TextId: 4
      Text: "\uB8E8\uC774\uC2A4\uB2D8\uC774 \uB2E4\uCE5C \uAC74 \uC2A4\uC2A4\uB85C\uC758
        \uC798\uBABB\uC774 \uC544\uB2C8\uC5D0\uC694."
    - TextId: 3
      Text: "\uB0B4\uAC00 \uB2E4\uCE5C \uAC83\uBCF4\uB2E4, \uC544\uBB34 \uB9D0\uB3C4
        \uD558\uC9C0 \uBABB\uD588\uB2E4\uB294 \uAC8C \uB354 \uC624\uB798 \uB0A8\uC544."
    - TextId: 3
      Text: "\uC2F8\uC6B0\uC790\uACE0 \uB9D0\uD558\uC9C0\uB3C4 \uBABB\uD588\uACE0,
        \uBB3C\uB7EC\uB098\uC790\uACE0 \uB9D0\uD558\uC9C0\uB3C4 \uBABB\uD588\uC5B4."
    - TextId: 3
      Text: "\uADF8\uB0E5 \uACC4\uC18D \uC0DD\uAC01\uB9CC \uD588\uC5B4.\n\uC5B4\uB290
        \uCABD\uC774 \uB354 \uB35C \uC704\uD5D8\uD55C\uC9C0."
    - TextId: 4
      Text: "\uADF8 \uC0C1\uD669\uC5D0\uC11C \uBC14\uB85C \uC815\uD558\uB294 \uAC74
        \uB204\uAD6C\uC5D0\uAC8C\uB3C4 \uC26C\uC6B4 \uC77C\uC774 \uC544\uB2C8\uC5C8\uC5B4\uC694.\n\uBA54\uC774\uB2D8\uB3C4
        \uB108\uBB34 \uBE60\uB974\uAC8C \uB6F0\uCCD0\uB098\uAC14\uACE0, \uC0C8\uD134\uB2D8\uB3C4..
        \uB8E8\uC774\uC2A4 \uB2D8\uC758 \uACC1\uC744 \uB5A0\uB098\uBC84\uB838\uC5B4\uC694."
    - TextId: 3
      Text: "\uC544\uB0D0. \uB0B4\uAC00 \uBE60\uB974\uAC8C \uC815\uD588\uC5B4\uC57C
        \uD588\uC5B4.\n\uADF8\uAC8C \uB0B4\uAC00 \uD574\uC57C \uD560 \uC77C\uC774\uC5C8\uB294\uB370.\n...\uADF8\uB798\uB3C4
        \uBA54\uC774\uAC00 \uC870\uAE08\uB9CC \uB354 \uAE30\uB2E4\uB824 \uC92C\uB354\uB77C\uBA74."
    - TextId: 1
      Text: "(\uB8E8\uC774\uC2A4\uB294 \uB2E4\uCE5C \uAC83\uBCF4\uB2E4, \uC544\uBB34
        \uACB0\uC815\uB3C4 \uB0B4\uB9AC\uC9C0 \uBABB\uD588\uB2E4\uB294 \uAC78 \uB354
        \uAD34\uB85C\uC6CC\uD558\uACE0 \uC788\uB124.)"
    - TextId: 1
      Text: "(\uC800 \uCE68\uBB35\uC740 \uC544\uC9C1 \uB8E8\uC774\uC2A4 \uC548\uC5D0
        \uB0A8\uC544 \uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P03_05
    CharacterId: 3
    ClueIndex: 5
    ClueText: "\uB8E8\uC774\uC2A4\uB294 \uB9C8\uB825\uC758 \uD750\uB984\uC744 \uC77D\uC9C0
      \uBABB\uD574 \uB4DC\uB798\uACE4\uC758 \uACF5\uACA9\uC744 \uD53C\uD558\uC9C0
      \uBABB\uD588\uB2E4."
    HintText: "\uB8E8\uC774\uC2A4\uB294 \uB9C8\uB825\uC758 \uD750\uB984\uC744 \uC77D\uC744
      \uC218 \uC788\uC9C0\uB9CC \uB4DC\uB798\uACE4\uC758 \uACF5\uACA9\uC744 \uB9C9\uC544\uB0B4\uAE30
      \uC704\uD574 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4."
    HintDescription: "\uC5EC\uAD00\uC5D0\uC11C \uBA54\uC774, \uB8E8\uC774\uC2A4,
      \uB370\uC6B0\uC2A4, \uC0C8\uD134\uC758 \uB300\uD654\uB85C \uC54C\uAC8C \uB41C
      \uD604\uC7AC \uC6A9\uBCD1\uB2E8\uC758 \uC704\uAE30\uC640 \uADF8\uB0A0\uC758
      \uC9C4\uC0C1\n\uD544\uC694 \uB2E8\uC11C: \uC608\uBC30\uC2E4\uC5D0\uC11C \uBCF4\uAC8C\uB41C
      \uB8E8\uC774\uC2A4\uC758 \uC790\uCC45\uACFC \uC704\uB85C\uD558\uB294 \uB370\uC6B0\uC2A4"
    Combo: 0100000002000000030000000400000007000000
    PlaceName: "\uC5EC\uAD00"
    DeadRequired: 
    Prerequisites:
    - P03_04
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uB370\uC6B0\uC2A4, \uB8E8\uC774\uC2A4\uB294 \uC5B8\uC81C\uCBE4 \uD68C\uBCF5\uB418\uB294\uAC70\uC9C0?\n\uD68C\uBCF5
        \uC18D\uB3C4\uAC00 \uB108\uBB34 \uB290\uB824."
    - TextId: 4
      Text: "\uBA54\uC774\uB2D8, \uB8E8\uC774\uC2A4\uB2D8\uC740 \uADF8\uB0A0 \uD06C\uAC8C
        \uB2E4\uCE58\uC168\uC5B4\uC694.\n\uC870\uAE08\uC529\uC774\uC9C0\uB9CC \uD68C\uBCF5\uD558\uACE0
        \uACC4\uC138\uC694."
    - TextId: 2
      Text: "\uC544\uB2C8, \uB354 \uBE60\uB978 \uBC29\uBC95\uC774 \uD544\uC694\uD574.\n\uB8E8\uC774\uC2A4\uAC00
        \uD68C\uBCF5\uD558\uB294 \uB3D9\uC548 \uC758\uB8B0\uAC00 \uC810\uCC28 \uB04A\uAE30\uACE0
        \uC788\uC5B4.\n\uC774\uB300\uB85C \uAC00\uB2E4\uAC04 \uC6A9\uBCD1\uB2E8\uC774
        \uD574\uC81C\uB420 \uC704\uAE30\uB77C\uACE0."
    - TextId: 7
      Text: "\uBA54\uC774\uAC00 \uB9D0\uC744 \uC880 \uAC70\uCE60\uAC8C \uD558\uAE34
        \uD588\uC9C0\uB9CC... \uC758\uB8B0\uAC00 \uB04A\uAE30\uACE0 \uC788\uB294\uAC74
        \uC0AC\uC2E4\uC774\uC57C."
    - TextId: 3
      Text: "...\uBBF8\uC548\uD574. \uD070 \uC0C1\uCC98\uB9CC \uC544\uBB3C\uBA74
        \uBC14\uB85C \uC758\uB8B0\uB97C \uBC1B\uB3C4\uB85D \uD558\uC790."
    - TextId: 7
      Text: "\uC548\uB3FC, \uC9C0\uAE08 \uB8E8\uC774\uC2A4 \uC8FC\uBCC0\uC758 \uB9C8\uB825
        \uD750\uB984\uC774 \uC0C1\uB2F9\uD788 \uBD88\uC548\uC815\uD574.\n\uC774 \uC0C1\uD0DC\uB85C
        \uC758\uB8B0\uB97C \uBC1B\uC544\uBD24\uC790 \uB8E8\uC774\uC2A4\uB3C4 \uB354
        \uB2E4\uCE58\uACE0 \uC758\uB8B0\uB3C4 \uC2E4\uD328\uD560\uAC8C \uBD84\uBA85\uD574."
    - TextId: 3
      Text: "\uC0C8\uD134, \uB0B4 \uC8FC\uBCC0\uC758 \uB9C8\uB825 \uD750\uB984\uC774
        \uBCF4\uC5EC?"
    - TextId: 7
      Text: "\uB2F9\uC5F0\uD558\uC9C0. \uB09C \uB9C8\uBC95\uC0AC\uB2C8\uAE4C.\n\uB9C8\uB825\uC758
        \uD750\uB984\uC744 \uBCFC \uC218 \uC788\uC5B4\uC57C \uB9C8\uBC95\uC0AC\uAC00
        \uB420 \uC218 \uC788\uC5B4."
    - TextId: 2
      Text: "\uB9C8\uBB3C\uC774 \uC544\uB2C8\uB77C \uC0AC\uB78C\uC758 \uB9C8\uB825
        \uD750\uB984\uB3C4 \uBCFC \uC218 \uC788\uC5C8\uAD70.\n\uADF8 \uB0A0\uC5D4
        \uB4DC\uB798\uACE4\uC758 \uB9C8\uB825 \uD750\uB984\uC744 \uC77D\uC5C8\uB2E4\uACE0
        \uD588\uC5C8\uB098?"
    - TextId: 7
      Text: "\uC751. \uB9C8\uB825 \uD750\uB984\uC744 \uBCF4\uACE0 \uD6C4\uBC29\uC73C\uB85C
        \uBE60\uC838\uC11C \uB4DC\uB798\uACE4\uC758 \uACF5\uACA9\uC744 \uCE74\uC6B4\uD130
        \uCE5C\uAC70\uC57C."
    - TextId: 2
      Text: "\uC0C8\uD134\uC758 \uBE60\uB978 \uD310\uB2E8 \uB355\uBD84\uC5D0 \uC804\uBA78\uD558\uC9C0
        \uC54A\uC744 \uC218 \uC788\uC5C8\uAD70."
    - TextId: 4
      Text: "\uC0C8\uD134\uB2D8... \uB8E8\uC774\uC2A4\uB2D8\uAED8\uB294 \uADF8\uB54C
        \uC65C \uB9D0\uC500\uB4DC\uB9AC\uC9C0 \uC54A\uC558\uB098\uC694?"
    - TextId: 7
      Text: "\uADF8\uAC74... \uBBF8\uC548\uD574.\n\uB9D0\uD560 \uD2C8\uC774 \uC5C6\uC5C8\uC5B4.\n\uACF5\uACA9\uC774
        \uB9E4\uC6B0 \uBE60\uB978 \uC18D\uB3C4\uB85C \uB0A0\uC544\uC654\uACE0, \uADF8\uAC78
        \uCE74\uC6B4\uD130 \uD558\uAE30 \uC704\uD574\uC11C\uB294 \uC8FC\uBB38\uC744
        \uC601\uCC3D\uD558\uBA74\uC11C \uD6C4\uBC29\uC73C\uB85C \uC774\uB3D9\uD574\uC57C
        \uD588\uAC70\uB4E0."
    - TextId: 3
      Text: "\uADF8\uB7AC\uAD6C\uB098. \uAD1C\uCC2E\uC544.\n\uC0C8\uD134\uC774 \uACF5\uACA9\uC744
        \uB9C9\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uB2E4\uB978 \uB2E8\uC6D0\uB4E4\uAE4C\uC9C0
        \uD06C\uAC8C \uB2E4\uCCE4\uC744\uAC70\uC57C."
    - TextId: 2
      Text: "\uBB50\uAC00 \uB410\uB358 \uBE68\uB9AC \uD68C\uBCF5\uC774\uB098 \uD574,
        \uB8E8\uC774\uC2A4.\n\uC758\uB8B0\uAC00 \uB04A\uAE30\uBA74 \uC6B0\uB9AC \uC6A9\uBCD1\uB2E8\uB3C4
        \uB05D\uC774\uB2C8\uAE4C.\n\uB09C \uAC04\uB2E4."
    - TextId: 7
      Text: "\uC544, \uB8E8\uC774\uC2A4. \uBA54\uC774\uAC00 \uACFC\uC77C \uBC14\uAD6C\uB2C8\uB97C
        \uAC00\uC838\uC654\uC5B4.\n\uB3C8\uB3C4 \uC5C6\uC744\uD150\uB370 \uC774\uB807\uAC8C
        \uD070\uAC78 \uC0AC\uC654\uC9C0 \uBB50\uC57C.\n\uBD80\uB044\uB7EC\uC6CC\uC11C
        \uC800\uB7EC\uB098\uBD10."
    - TextId: 7
      Text: "\uBA54\uC774, \uAC19\uC774 \uAC00!"
    - TextId: 1
      Text: "(\uD750\uC74C...)"
    DesignerNote: 
  - ProfileClueId: P04_01
    CharacterId: 4
    ClueIndex: 1
    ClueText: "\uB370\uC6B0\uC2A4\uB294 \uC6A9\uBCD1\uB2E8 \uC804\uCCB4\uB97C \uAC71\uC815\uD558\uB294
      \uB4EF \uBCF4\uC774\uC9C0\uB9CC, \uD2B9\uD788 \uB8E8\uC774\uC2A4\uC758 \uC548\uC804\uC744
      \uAC00\uC7A5 \uBA3C\uC800 \uC2E0\uACBD \uC4F0\uACE0 \uC788\uB2E4."
    HintText: "\uB370\uC6B0\uC2A4\uB294 \uB8E8\uC774\uC2A4\uBCF4\uB2E4 \uBA54\uC774\uC758
      \uC804\uD22C \uC131\uACFC\uB97C \uAC00\uC7A5 \uC911\uC694\uD558\uAC8C \uC0DD\uAC01\uD558\uACE0
      \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uC2E0\uC785\uACFC \uB370\uC6B0\uC2A4\uC758
      \uCCAB \uC778\uC0AC"
    Combo: 0100000004000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uB370\uC6B0\uC2A4\uB2D8, \uB9DE\uC73C\uC2DC\uC8E0?\n\uC0C8\uB85C \uD569\uB958\uD55C
        \uC5D4\uBE44\uC608\uC694. \uC798 \uBD80\uD0C1\uB4DC\uB824\uC694!"
    - TextId: 4
      Text: "\uBC18\uAC11\uC2B5\uB2C8\uB2E4, \uC5D4\uBE44 \uC528.\n\uD639\uC2DC \uB2E4\uCE5C
        \uACF3\uC774 \uC788\uB2E4\uBA74 \uC5B8\uC81C\uB4E0 \uB9D0\uC500\uD574 \uC8FC\uC138\uC694."
    - TextId: 1
      Text: "\uCC98\uC74C\uBD80\uD130 \uCE58\uB8CC \uC598\uAE30\uC2DC\uB124\uC694.\n\uD504\uB9AC\uC2A4\uD2B8\uB77C\uC11C
        \uADF8\uB7F0\uAC00\uC694?"
    - TextId: 4
      Text: "\uB2E4\uCE5C \uAC78 \uC228\uAE30\uB294 \uC0AC\uB78C\uB3C4 \uC788\uC73C\uB2C8\uAE4C\uC694.\n\uAD1C\uCC2E\uB2E4\uACE0
        \uB9D0\uD558\uB294 \uC0AC\uB78C\uC77C\uC218\uB85D \uB354 \uBD10\uC57C \uD569\uB2C8\uB2E4."
    - TextId: 1
      Text: "\uB2E4\uCE5C \uAC78 \uC228\uAE30\uB294 \uC0AC\uB78C\uC774 \uC788\uB098\uC694?\n\uC544\uD50C\uD150\uB370..!"
    - TextId: 4
      Text: "\uB8E8\uC774\uC2A4\uB2D8\uC774 \uC720\uB3C5 \uADF8\uB7EC\uC2ED\uB2C8\uB2E4.\n\uAD1C\uCC2E\uB2E4\uACE0
        \uB9D0\uD558\uACE0 \uB118\uC5B4\uAC00\uB294 \uC77C\uC774 \uB9CE\uC544\uC694.\n\uADF8\uB798\uC11C
        \uC81C\uAC00 \uB354 \uC2E0\uACBD \uC4F0\uB294 \uAC83\uBFD0\uC774\uC5D0\uC694."
    - TextId: 1
      Text: "\uB8E8\uC774\uC2A4\uB2D8\uC740 \uACFC\uBB35\uD558\uC2E0 \uBD84\uC778\uAC00\uBD10\uC694.\n\uADF8\uB7FC
        \uB2E4\uB978 \uBD84\uB4E4\uB3C4 \uADF8\uB807\uAC8C \uCC59\uAE30\uC2DC\uB098\uC694?"
    - TextId: 4
      Text: "\uBB3C\uB860\uC785\uB2C8\uB2E4. \uB2E4\uB9CC\u2026 \uB8E8\uC774\uC2A4\uB2D8\uC740
        \uC870\uAE08 \uB354\n\uB193\uCE58\uAE30 \uC26C\uC6B4 \uC0AC\uB78C\uC774\uB77C
        \uC8FC\uC758\uB97C \uAE30\uC6B8\uC774\uB294\n\uD3B8\uC785\uB2C8\uB2E4."
    - TextId: 1
      Text: "(\uB370\uC6B0\uC2A4\uB294 \uBAA8\uB450\uB97C \uAC71\uC815\uD558\uB294
        \uAC83\uCC98\uB7FC\n\uB9D0\uD558\uC9C0\uB9CC, \uB8E8\uC774\uC2A4\uC5D0\uAC8C\uB9CC
        \uC720\uB3C5 \uC2DC\uC120\uC774 \uC624\uB798\n\uBA38\uBB38\uB2E4.)"
    - TextId: 1
      Text: "(\uB8E8\uC774\uC2A4\uB97C \uCC59\uAE30\uB294 \uC77C\uC774 \uB370\uC6B0\uC2A4\uC5D0\uAC8C\uB294
        \uC2B5\uAD00\uBCF4\uB2E4 \uB354 \uAE4A\uC740 \uBB34\uC5B8\uAC00 \uAC19\uC544.)"
    DesignerNote: 
  - ProfileClueId: P04_02
    CharacterId: 4
    ClueIndex: 2
    ClueText: "\uB370\uC6B0\uC2A4\uB294 \uAE30\uB3C4\uC5D0 \uB4E4\uC5B4\uAC00\uBA74
      \uC804\uC7A5 \uC0C1\uD669\uC744 \uC9C1\uC811 \uBCFC \uC218 \uC5C6\uB2E4."
    HintText: "\uB370\uC6B0\uC2A4\uB294 \uAE30\uB3C4 \uC911\uC5D0\uB3C4 \uC804\uC7A5\uC758
      \uBAA8\uB4E0 \uC0C1\uD669\uC744 \uC815\uD655\uD788 \uC54C \uC218 \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uBCF8 \uB370\uC6B0\uC2A4\uC758
      \uAE30\uB3C4\uB97C \uC9C0\uC801\uD558\uB294 \uBA54\uC774\n\uD544\uC694 \uB2E8\uC11C:
      \uC608\uBC30\uC2E4\uC5D0\uC11C \uC2E0\uC785\uACFC \uB370\uC6B0\uC2A4\uC758
      \uCCAB \uC778\uC0AC"
    Combo: 010000000200000004000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites:
    - P04_01
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uB370\uC6B0\uC2A4. \uB124 \uBC84\uD504\uB294 \uC5EC\uC804\uD788 \uB290\uB824.\n\uBC1C\uB3D9
        \uC2DC\uAC04\uC744 \uB354 \uB2E8\uCD95\uD560 \uC218\uB294 \uC5C6\uC5B4?"
    - TextId: 4
      Text: "\uAE30\uB3C4\uC5D0\uB294 \uC2DC\uAC04\uC774 \uD544\uC694\uD569\uB2C8\uB2E4.\n\uAE09\uD558\uAC8C
        \uC678\uC6B4\uB2E4\uACE0 \uB418\uB294 \uC77C\uC774 \uC544\uB2D9\uB2C8\uB2E4."
    - TextId: 2
      Text: "\uC804\uD22C \uC911\uC5D0\uB294 \uADF8 \uC2DC\uAC04\uC774 \uC81C\uC77C
        \uC544\uAE4C\uC6CC.\n\uB208\uC55E\uC5D0\uC11C \uAE30\uD68C\uAC00 \uC0AC\uB77C\uC9C8
        \uC218\uB3C4 \uC788\uC796\uC544."
    - TextId: 1
      Text: "\uBC84\uD504\uB97C \uAC78\uB824\uBA74 \uAE30\uB3C4\uAC00 \uD544\uC694\uD558\uAD70\uC694.
        \uAE30\uB3C4\uB294 \uC5B4\uB5BB\uAC8C \uD558\uB294\uAC74\uAC00\uC694?\n\uC800\uB3C4
        \uD574 \uBCF4\uACE0 \uC2F6\uC5B4\uC694!"
    - TextId: 4
      Text: "\uB9C8\uC74C\uC744 \uAC00\uB2E4\uB4EC\uACE0 \uB208\uC744 \uAC10\uC740
        \uD6C4 \uC5EC\uC2E0\uB2D8\uAED8 \uAE30\uB3C4\uD558\uBA74 \uB429\uB2C8\uB2E4.\n\uD558\uC9C0\uB9CC
        \uC61B \uC2E0\uB4E4\uC758 \uC5B8\uC5B4\uB85C \uAE30\uB3C4\uD574\uC57C \uD574\uC11C,
        \uC544\uB9C8 \uC5D4\uBE44\uB2D8\uC740 \uAE30\uB3C4\uD55C\uB2E4 \uD574\uB3C4
        \uD070 \uD6A8\uACFC\uB294 \uC5C6\uC744\uAC70\uC5D0\uC694."
    - TextId: 1
      Text: "\uC557 \uADF8\uB807\uAD70\uC694, \uC544\uC26C\uC6CC\uB77C.\n\uC61B \uC2E0\uB4E4\uC758
        \uC5B8\uC5B4\uB77C\uB2C8 \uBB54\uAC00 \uB300\uB2E8\uD574\uC694!"
    - TextId: 1
      Text: "\uC5B4\uB77C, \uADF8\uB7F0\uB370 \uB208\uC744 \uAC10\uC544\uC57C \uD558\uB294\uAC70\uBA74
        \uAE30\uB3C4 \uC911\uC5D4 \uC544\uBB34\uAC83\uB3C4 \uBCFC \uC218 \uC5C6\uB294\uAC74\uAC00\uC694?"
    - TextId: 4
      Text: "\uADF8\uB807\uC2B5\uB2C8\uB2E4, \uC544\uBB34\uAC83\uB3C4 \uBCFC \uC218
        \uC5C6\uC5B4\uC694.\n\uC2E0\uC131\uD55C \uAE30\uB3C4 \uC758\uC2DD \uC911\uC5D0\uB294
        \uC18D\uC138\uC758 \uAC83\uC744 \uB208\uC5D0 \uB2F4\uC73C\uBA74 \uC548\uB418\uB2C8\uAE4C\uC694."
    - TextId: 2
      Text: "\uADF8\uB798\uC11C \uADF8\uB0A0\uB3C4 \uBABB \uBD24\uAD6C\uB098."
    - TextId: 4
      Text: "\uBA54\uC774\uB2D8\u2026 \uC800\uB294 \uBA54\uC774\uB2D8\uC758 \uC694\uCCAD\uC73C\uB85C
        \uBC84\uD504\uB97C..."
    - TextId: 2
      Text: "\uC544\uB2C8, \uADF8\uB0E5 \uD655\uC778\uD55C \uAC70\uC57C.\n\uB124\uAC00
        \uB208\uC744 \uAC10\uACE0 \uC788\uB294 \uB3D9\uC548\uC5D0\uB3C4 \uC804\uC7A5\uC740
        \uACC4\uC18D \uC6C0\uC9C1\uC600\uC73C\uB2C8\uAE4C.\n\uB108\uB97C \uD0D3\uD558\uB294\uAC8C
        \uC544\uB0D0.\n\uADF8\uB807\uAC8C \uB4E4\uB838\uB2E4\uBA74 \uBBF8\uC548\uD558\uB2E4."
    - TextId: 1
      Text: "(\uB370\uC6B0\uC2A4\uB294 \uAE30\uB3C4 \uC911\uC5D4 \uC804\uC7A5\uC744
        \uBCFC \uC218 \uC5C6\uAD6C\uB098.)"
    - TextId: 1
      Text: "(\uADF8 \uBE48\uD2C8\uC5D0 \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB294\uC9C0\uAC00
        \uC911\uC694\uD558\uACA0\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P04_03
    CharacterId: 4
    ClueIndex: 3
    ClueText: "\uB370\uC6B0\uC2A4\uB294 \uC790\uC2E0\uC774 \uB8E8\uC774\uC2A4\uB97C
      \uC9C0\uCF1C \uC904 \uAC83\uC774\uB77C\uB294 \uB2E8\uC6D0\uB4E4\uC758 \uAE30\uB300\uC5D0
      \uBD80\uC751\uD574\uC57C \uD55C\uB2E4\uACE0 \uC0DD\uAC01\uD588\uB2E4."
    HintText: "\uB370\uC6B0\uC2A4\uB294 \uC790\uC2E0\uC774 \uB8E8\uC774\uC2A4\uB97C
      \uC9C0\uCF1C \uC904 \uAC83\uC774\uB77C\uB294 \uB2E8\uC6D0\uB4E4\uC758 \uAE30\uB300\uB97C
      \uBD80\uB2F4\uC2A4\uB7FD\uAC8C \uC0DD\uAC01\uD588\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uC0C8\uD134\uACFC \uB370\uC6B0\uC2A4\uC758
      \uB300\uD654\uB85C \uC54C\uAC8C\uB41C \uD56D\uC0C1 \uB8E8\uC774\uC2A4\uB97C
      \uC9C0\uD0A4\uB358 \uB370\uC6B0\uC2A4\n\uD544\uC694 \uB2E8\uC11C: \uC608\uBC30\uC2E4\uC5D0\uC11C
      \uBCF8 \uB370\uC6B0\uC2A4\uC758 \uAE30\uB3C4\uB97C \uC9C0\uC801\uD558\uB294
      \uBA54\uC774"
    Combo: 010000000400000007000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P04_02
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 7
      Text: "\uB370\uC6B0\uC2A4, \uB8E8\uC774\uC2A4 \uC57D \uCC59\uACBC\uC5B4?\n\uC2AC\uC2AC
        \uC57D \uBA39\uC744 \uC2DC\uAC04 \uC544\uB0D0?"
    - TextId: 4
      Text: "\uACE7 \uAC00\uC838\uB2E4\uB4DC\uB9AC\uB824\uACE0 \uD588\uC2B5\uB2C8\uB2E4."
    - TextId: 7
      Text: "\uC5ED\uC2DC \uB124\uAC00 \uCC59\uAE30\uB294\uAD6C\uB098."
    - TextId: 4
      Text: "\uC800\uB294 \uB8E8\uC774\uC2A4\uB2D8\uC758 \uD68C\uBCF5\uC744 \uB2F4\uB2F9\uD558\uACE0
        \uC788\uC2B5\uB2C8\uB2E4.\n\uADF8\uAC83\uC774 \uC800\uC758 \uC77C\uC785\uB2C8\uB2E4."
    - TextId: 7
      Text: "\uADF8\uB807\uACA0\uC9C0. \uB8E8\uC774\uC2A4 \uCABD\uC740 \uB298 \uB124\uAC00
        \uBA3C\uC800 \uBCF4\uB2C8\uAE4C."
    - TextId: 1
      Text: "\uB370\uC6B0\uC2A4\uB2D8\uC740 \uAD49\uC7A5\uD788 \uB4E0\uB4E0\uD55C
        \uBD84\uC778\uAC00\uBD10\uC694.\n\uB2E4\uB978 \uBD84\uB4E4\uB3C4 \uADF8\uB807\uAC8C
        \uC0DD\uAC01\uD558\uC2DC\uB098\uC694?"
    - TextId: 7
      Text: "\uB300\uBD80\uBD84 \uB370\uC6B0\uC2A4\uB97C \uBBFF\uACE0 \uC788\uC5B4.\n\uB8E8\uC774\uC2A4\uAC00
        \uC5B4\uB514\uC5D0 \uC788\uB354\uB77C\uB3C4 \uB370\uC6B0\uC2A4\uAC00 \uBCF4\uACE0
        \uC788\uACA0\uC9C0, \uB77C\uACE0 \uC0DD\uAC01\uD558\uC9C0."
    - TextId: 4
      Text: "\uADF8\uAC74\u2026\u2026"
    - TextId: 7
      Text: "\uBD80\uB2F4 \uC8FC\uB824\uB294 \uB9D0\uC740 \uC544\uB2C8\uC57C.\n\uADF8\uB0E5
        \uC0AC\uC2E4\uC774 \uADF8\uB807\uB2E4\uB294 \uAC70\uC9C0.\n\uB298 \uADF8\uB7AC\uC796\uC544?"
    - TextId: 1
      Text: "\uB8E8\uC774\uC2A4\uB2D8 \uACC1\uC5D0 \uB370\uC6B0\uC2A4\uB2D8\uC774
        \uC788\uC73C\uBA74, \uB2E4\uB4E4 \uC870\uAE08 \uC548\uC2EC\uD558\uC2DC\uB294\uAD70\uC694."
    - TextId: 4
      Text: "\uC548\uC2EC\u2026\u2026"
    - TextId: 7
      Text: "\uADF8\uB7F0 \uD3B8\uC774\uC9C0. \uADF8\uB7EC\uB2C8\uAE4C \uADF8\uB0A0\uB3C4
        \uB0B4\uAC00 \uD6C4\uBC29\uC73C\uB85C \uC6C0\uC9C1\uC77C \uC218 \uC788\uC5C8\uB358
        \uAC70\uACE0."
    - TextId: 4
      Text: "\uC800\uB294 \uADF8\uB54C \uAE30\uB3C4 \uC911\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8\uB798\uC11C
        \uC0C8\uD134\uB2D8\uAED8 \uB8E8\uC774\uC2A4\uB2D8\uC744 \uBD80\uD0C1\uB4DC\uB838\uB294\uB370..."
    - TextId: 7
      Text: "\uADF8\uAC74 \uBBF8\uC548\uD558\uAC8C \uC0DD\uAC01\uD574.\n\uD558\uC9C0\uB9CC
        \uADF8 \uC21C\uAC04\uC5D4 \uD6C4\uBC29 \uACF5\uACA9\uC774 \uBA3C\uC800 \uBCF4\uC600\uC5B4.\n\uB2E4\uB978
        \uC0AC\uB78C\uB4E4\uB3C4 \uAC01\uC790 \uC5ED\uD560\uC5D0 \uCDA9\uC2E4\uD588\uACE0."
    - TextId: 4
      Text: "\u2026\u2026"
    - TextId: 4
      Text: "\uB2E4\uB4E4 \uC800\uB97C \uBBFF\uACE0 \uACC4\uC168\uB358 \uAC74\uAC00\uC694..?\n\uC81C\uAC00
        \uB8E8\uC774\uC2A4\uB2D8\uC744 \uC9C0\uD0AC \uAC70\uB77C\uACE0..."
    - TextId: 1
      Text: "(\uB2E4\uB978 \uB2E8\uC6D0\uB4E4\uC740 \uAC00\uBCCD\uAC8C \uB9D0\uD558\uACE0
        \uC788\uC5B4.)"
    - TextId: 1
      Text: "(\uD558\uC9C0\uB9CC \uB370\uC6B0\uC2A4\uB294 \u2018\uB8E8\uC774\uC2A4\uB294
        \uB370\uC6B0\uC2A4\uAC00\n\uC9C0\uD0AC \uAC83\u2019\uC774\uB77C\uB294 \uB9D0\uC744
        \uCC45\uC784\uC73C\uB85C \uBC1B\uC544\uB4E4\uC774\uACE0\n\uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P04_04
    CharacterId: 4
    ClueIndex: 4
    ClueText: "\uB370\uC6B0\uC2A4\uB294 \uC0C8\uD134\uC774 \uD6C4\uBC29\uC744 \uB9C9\uC544\uB0C8\uB2E4\uB294
      \uC0AC\uC2E4\uBCF4\uB2E4, \uB8E8\uC774\uC2A4\uAC00 \uC4F0\uB7EC\uC84C\uB2E4\uB294
      \uACB0\uACFC\uC5D0 \uB354 \uC9D1\uCC29\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uB370\uC6B0\uC2A4\uB294 \uC0C8\uD134\uC774 \uD6C4\uBC29\uC744 \uB9C9\uC544\uB0C8\uAE30
      \uB54C\uBB38\uC5D0 \uB8E8\uC774\uC2A4\uC758 \uBD80\uC0C1 \uC5ED\uC2DC \uC5B4\uCA54
      \uC218 \uC5C6\uB294 \uACB0\uACFC\uC600\uB2E4\uACE0 \uBC1B\uC544\uB4E4\uC774\uACE0
      \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uB8E8\uC774\uC2A4, \uB370\uC6B0\uC2A4
      \uADF8\uB9AC\uACE0 \uC0C8\uD134\uC774 \uBC1D\uD78C \uD30C\uD3B8\uC758 \uC9C4\uC0C1\n\uD544\uC694
      \uB2E8\uC11C: \uD6C8\uB828\uC7A5\uC5D0\uC11C \uC0C8\uD134\uACFC \uB370\uC6B0\uC2A4\uC758
      \uB300\uD654\uB85C \uC54C\uAC8C\uB41C \uD56D\uC0C1 \uB8E8\uC774\uC2A4\uB97C
      \uC9C0\uD0A4\uB358 \uB370\uC6B0\uC2A4"
    Combo: 01000000030000000400000007000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites:
    - P04_03
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uC0C8\uD134\uB2D8. \uADF8 \uB0A0, \uD6C4\uBC29 \uACF5\uACA9\uC744 \uB9C9\uC558\uB2E4\uACE0
        \uD558\uC168\uC8E0."
    - TextId: 4
      Text: "\uADF8\uB7F0\uB370 \uB8E8\uC774\uC2A4\uB2D8\uC5D0\uAC8C \uB0A0\uC544\uAC04
        \uD30C\uD3B8\uC740 \uBB50\uC600\uB098\uC694?"
    - TextId: 7
      Text: "\uD6C4\uBC29 \uC804\uCCB4\uAC00 \uBB34\uB108\uC9C0\uB294 \uAC74 \uB9C9\uC558\uC5B4.\n\uD558\uC9C0\uB9CC
        \uCE74\uC6B4\uD130\uAC00 \uC644\uBCBD\uD558\uC9C4 \uC54A\uC558\uC5B4."
    - TextId: 3
      Text: "\uB370\uC6B0\uC2A4, \uADF8\uB9CC\uD574. \uADF8\uAC74 \uC0C8\uD134\uB9CC\uC758
        \uC798\uBABB\uC774 \uC544\uB2C8\uC57C."
    - TextId: 4
      Text: "\uC800\uB294 \uB208\uC744 \uAC10\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8\uB798\uC11C
        \uC0C8\uD134\uB2D8\uC774 \uB9C9\uC544\uC8FC\uC2E4 \uAC70\uB77C\uACE0 \uBBFF\uC744
        \uC218\uBC16\uC5D0 \uC5C6\uC5C8\uC5B4\uC694."
    - TextId: 7
      Text: "\uB0B4\uAC00 \uB193\uCE5C \uAC74 \uD30C\uD3B8\uC774\uC5C8\uC5B4.\n\uB300\uBD80\uBD84\uC758
        \uACF5\uACA9\uC740 \uB9C9\uC544\uB0C8\uC5B4!"
    - TextId: 4
      Text: "\uC800\uC5D0\uAC8C\uB294 \uADF8 \uCC28\uC774\uAC00 \uC911\uC694\uD558\uC9C0
        \uC54A\uC2B5\uB2C8\uB2E4."
    - TextId: 4
      Text: "\uB8E8\uC774\uC2A4\uB2D8\uC774 \uC4F0\uB7EC\uC84C\uB2E4\uB294 \uACB0\uACFC\uB9CC
        \uB0A8\uC558\uC73C\uB2C8\uAE4C\uC694."
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uB9C9\uC544\uB0B8 \uCABD\uC744 \uAE30\uC5B5\uD558\uACE0,
        \uB370\uC6B0\uC2A4\uB294 \uB2FF\uC544\uBC84\uB9B0 \uD30C\uD3B8\uB9CC \uBCF4\uACE0
        \uC788\uB124.)"
    - TextId: 1
      Text: "(\uAC19\uC740 \uC0AC\uAC74\uC778\uB370, \uB0A8\uC740 \uC7A5\uBA74\uC774
        \uB2EC\uB77C.)"
    DesignerNote: 
  - ProfileClueId: P04_05
    CharacterId: 4
    ClueIndex: 5
    ClueText: "\uB370\uC6B0\uC2A4\uB294 \uBAA8\uB450\uB97C \uC783\uC740 \uB4A4\uC5D0\uB3C4,
      \uC0C8\uD134\uC774 \uD6C4\uBC29\uC744 \uB9C9\uC73C\uB824 \uD588\uB2E4\uB294
      \uC0AC\uC2E4\uBCF4\uB2E4 \uB8E8\uC774\uC2A4\uB97C \uACE0\uB824\uD558\uC9C0
      \uBABB\uD588\uB2E4\uB294 \uC810\uC5D0 \uBB34\uB108\uC9C0\uACE0 \uC788\uB2E4."
    HintText: "\uB370\uC6B0\uC2A4\uB294 \uBAA8\uB450\uAC00 \uC8FD\uC740 \uB4A4, \uC0C8\uD134\uC774
      \uB8E8\uC774\uC2A4\uBCF4\uB2E4 \uD6C4\uBC29 \uACF5\uACA9\uC744 \uC6B0\uC120\uD55C
      \uD310\uB2E8\uC744 \uC644\uC804\uD788 \uC774\uD574\uD558\uACE0 \uBC1B\uC544\uB4E4\uC774\uACE0
      \uC788\uB2E4."
    HintDescription: " \uC5F0\uC778 \uADF8\uB9AC\uACE0 \uB3D9\uB8CC\uB4E4\uC758 \uC8FD\uC74C\u2026
      \uBC29\uAD00\uD558\uB294 \uC0C8\uD134, \uC808\uB9DD\uD558\uB294 \uB370\uC6B0\uC2A4.\n\uD544\uC694
      \uB2E8\uC11C: \uD6C8\uB828\uC5D0\uC11C \uB370\uC6B0\uC2A4\uC758 \uACFC\uBCF4\uD638\uB97C
      \uC9C0\uC801\uD558\uB294 \uC0C8\uD134 \uC608\uBC30\uC2E4\uC5D0\uC11C \uB8E8\uC774\uC2A4,
      \uB370\uC6B0\uC2A4 \uADF8\uB9AC\uACE0 \uC0C8\uD134\uC774 \uBC1D\uD78C \uD30C\uD3B8\uC758
      \uC9C4\uC0C1"
    Combo: 010000000400000007000000
    PlaceName: 
    DeadRequired: 030000000500000006000000
    Prerequisites:
    - P04_04
    - P07_03
    SimultaneousIds:
    - P07_04
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uC0C8\uD134\uB2D8. \uADF8\uB0A0 \uD6C4\uBC29\uC744 \uB9C9\uC73C\uB824\uACE0
        \uC6C0\uC9C1\uC600\uB2E4\uACE0 \uD558\uC168\uC8E0."
    - TextId: 7
      Text: "...\uADF8\uB54C\uB294 \uADF8\uAC8C \uBAA8\uB450\uB97C \uC0B4\uB9AC\uB294
        \uAE38\uC774\uB77C\uACE0 \uC0DD\uAC01\uD588\uC5B4."
    - TextId: 4
      Text: "\uBAA8\uB450\uB77C\uB2C8. \uC9C0\uAE08 \uC5EC\uAE30\uC5D4 \uB204\uAC00
        \uB0A8\uC544 \uC788\uC8E0?"
    - TextId: 4
      Text: "\uBAA8\uB450 \uC8FD\uC5C8\uC5B4\uC694! \uBA54\uC774\uB2D8, \uD1A0\uB2C8\uB2D8,
        \uD504\uB9AC\uB4DC\uB2D8\uB3C4, \uB8E8\uC774\uC2A4\uB2D8\uB3C4 \uBAA8\uB450
        \uC5C6\uB2E4\uACE0\uC694!!"
    - TextId: 7
      Text: ...
    - TextId: 4
      Text: "\uC800\uB294 \uADF8\uB0A0 \uB8E8\uC774\uC2A4\uB2D8\uC744 \uB9E1\uACBC\uC5C8\uC5B4\uC694."
    - TextId: 7
      Text: "\uD6C4\uBC29 \uACF5\uACA9\uC744 \uB9C9\uC9C0 \uC54A\uC558\uB2E4\uBA74,
        \uB354 \uB9CE\uC740 \uC0AC\uB78C\uC774 \uC8FD\uC5C8\uC744 \uAC70\uC57C."
    - TextId: 4
      Text: "\uADF8 \uB9D0, \uC774\uC81C \uC544\uBB34 \uC758\uBBF8 \uC5C6\uC5B4\uC694.\n\uC0C8\uD134\uB2D8\uC740
        \uACC4\uC18D \uB3C4\uB9DD\uCE58\uAE30\uB9CC \uD558\uB2E4\uAC00 \uBAA8\uB450\uB97C
        \uC8FD\uAC8C \uB0B4\uBC84\uB824 \uB454 \uAC70\uC5D0\uC694."
    - TextId: 4
      Text: "\uB8E8\uC774\uC2A4\uB2D8\uC744 \uBC84\uB9AC\uACE0 \uB3C4\uB9DD\uCE60
        \uB54C \uBD80\uD130 \uC54C\uC544\uBD24\uC5B4\uC57C \uD588\uB294\uB370!!!"
    - TextId: 7
      Text: "\uB098\uB294 \uBAA8\uB450\uB97C \uC0B4\uB9AC\uB824\uACE0 \uD588\uC5B4..."
    - TextId: 4
      Text: "\uC9C0\uAE08 \uC774 \uC0C1\uD669\uC744 \uBCF4\uACE0\uB3C4 \uADF8\uB7F0
        \uB9D0\uC774 \uB098\uC640\uC694?\n\uC0C8\uD134\uB2D8 \uB9D0\uACE0 \uB2E4\uB978\uBD84\uAED8
        \uBC84\uD504\uB97C \uAC78\uC5B4 \uB4DC\uB824\uC57C \uD588\uB358 \uAC74\uB370...
        \uC544\uC544..."
    - TextId: 1
      Text: "(\uC801\uC758 \uC2B5\uACA9\uC5D0 \uBAA8\uB450 \uC8FD\uC5B4\uBC84\uB838\uB124.\n\uC0C8\uD134\uC740
        \uACC4\uC18D \uD6C4\uBC29\uC73C\uB85C \uC790\uB9AC\uB97C \uC62E\uAE30\uBA74\uC11C
        \uC0B4\uC544\uB0A8\uC558\uC9C0\uB9CC...)"
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uD754\uB4E4\uB9AC\uACE0 \uC788\uC5B4.\n\uD300\uC744
        \uC704\uD55C \uD310\uB2E8\uC774\uC5C8\uB2E4\uB294 \uB9D0\uC774 \uC774\uC81C\uB294
        \uBCC0\uBA85\uCC98\uB7FC \uB4E4\uB9AC\uACA0\uB124.)"
    - TextId: 1
      Text: "(\uC544\uB9C8 \uB610 \uCC98\uC74C\uC73C\uB85C \uB418\uB3CC\uC544\uAC00\uACA0\uC9C0.\n\uB2E4\uC74C\uC5D0\uB294
        \uC0C8\uD134\uC5D0\uAC8C\uB3C4 \uC774 \uADE0\uC5F4\uC744 \uB354 \uC77C\uCC0D
        \uC2EC\uC5B4\uB46C\uC57C\uACA0\uC5B4.)"
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uBAA8\uB450\uB97C \uAD6C\uD558\uB824 \uD588\uACE0,
        \uACB0\uAD6D \uC544\uBB34\uB3C4 \uAD6C\uD558\uC9C0 \uBABB\uD588\uB2E4.\n\uC774
        \uBAA8\uC21C\uC774 \uC0C8\uD134\uC744 \uD754\uB4E4 \uC5F4\uC1E0\uC57C.)"
    DesignerNote: "\"P07_04 \uD68D\uB4DD \uC2DC \uC790\uB3D9\uC73C\uB85C \uB3D9\uC2DC"
  - ProfileClueId: P05_01
    CharacterId: 5
    ClueIndex: 1
    ClueText: "\uD1A0\uB2C8\uB294 \uB4DC\uB798\uACE4\uACFC\uC758 \uC870\uC6B0 \uC911,
      \uBE44\uC804\uD22C\uC6D0\uC73C\uB85C\uC11C \uC758\uB8B0 \uBB3C\uD488\uC744
      \uC9C0\uD0A4\uAE30 \uC704\uD574 \uB3C4\uB9DD\uC744 \uC120\uD0DD\uD588\uB2E4."
    HintText: "\uD1A0\uB2C8\uB294 \uC758\uB8B0 \uBB3C\uD488\uC744 \uC9C0\uD0A8 \uC790\uC2E0\uC758
      \uD310\uB2E8\uC774 \uD300\uC5D0\uAC8C \uCDA9\uBD84\uD55C \uB3C4\uC6C0\uC774
      \uB418\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uCC3D\uACE0\uC5D0\uC11C \uBC1C\uACAC\uD55C \uD1A0\uB2C8\uC758
      \uC815\uC2E0 \uCC29\uB780\uC73C\uB85C \uC5D4\uBE44\uAC00 \uC8FD\uB2E4"
    Combo: 0100000005000000
    PlaceName: "\uCC3D\uACE0"
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 1
    Lines:
    - TextId: 5
      Text: "\uB098\uB294 \uBD84\uBA85 \uD300\uC5D0 \uB3C4\uC6C0\uC774 \uB410\uC5B4.
        \uB098\uB294 \uBD84\uBA85 \uD300\uC5D0 \uB3C4\uC6C0\uC774 \uB410\uC5B4.\n\uB098\uB294
        \uBD84\uBA85 \uD300\uC5D0 \uB3C4\uC6C0\uC774 \uB410\uC5B4. \uB098\uB294 \uBD84\uBA85
        \uD300\uC5D0 \uB3C4\uC6C0\uC774 \uB410\uC5B4.\n\uB098\uB294 \uBD84\uBA85
        \uD300\uC5D0 \uB3C4\uC6C0\uC774 \uB410\uC5B4. \uB098\uB294 \uBD84\uBA85 \uD300\uC5D0
        \uB3C4\uC6C0\uC774 \uB410\uC5B4."
    - TextId: 1
      Text: "\uD1A0\uB2C8\uB2D8? \uAD1C\uCC2E\uC73C\uC2E0\uAC00\uC694??"
    - TextId: 5
      Text: "\uB0B4\uAC00 \uB3C4\uB9DD\uCE5C \uAC74 \uC758\uB8B0 \uBB3C\uD488\uC744
        \uC9C0\uD0A4\uAE30 \uC704\uD574\uC11C\uC57C!\n\uC65C \uC774 \uC0AC\uC2E4\uC744
        \uBAA8\uB974\uACE0 \uC788\uB294 \uAC70\uC57C?\n\uC65C \uB2E4\uB4E4 \uB098\uB97C
        \uACC4\uC18D \uADF8\uB7F0 \uB208\uC73C\uB85C \uCCD0\uB2E4\uBCF4\uACE0 \uC788\uB294
        \uAC70\uC57C!!"
    - TextId: 5
      Text: "\uB098\uB294 \uBD84\uBA85 \uB3C4\uC6C0\uC774 \uB410\uC5B4...."
    DesignerNote: "\"\uC774 \uC0C1\uD669 \uD55C\uC815\uC73C\uB85C, \uAC15\uC81C\uD1F4\uACE0"
  - ProfileClueId: P05_02
    CharacterId: 5
    ClueIndex: 2
    ClueText: "\uD1A0\uB2C8\uC758 \uD589\uB3D9\uC740 \uD504\uB9AC\uB4DC\uC758 \uD310\uB2E8\uC744
      \uC5B4\uB835\uAC8C \uD588\uB2E4."
    HintText: "\uD1A0\uB2C8\uC758 \uD589\uB3D9\uC740 \uD504\uB9AC\uB4DC\uC758 \uD310\uB2E8\uC744
      \uB3C4\uC654\uB2E4."
    HintDescription: "\uCC3D\uACE0\uC5D0\uC11C \uD504\uB9AC\uB4DC\uAC00 \uD68C\uC0C1\uD558\uB294
      \uADF8\uB0A0\uC758 \uD1A0\uB2C8\n\uD544\uC694 \uB2E8\uC11C: \uD6C8\uB828\uC7A5\uC5D0\uC11C
      \uBCF8 \uBA54\uC774\uC640 \uD504\uB9AC\uB4DC\uC758 \uCDA9\uB3CC"
    Combo: 0100000006000000
    PlaceName: "\uCC3D\uACE0"
    DeadRequired: 
    Prerequisites:
    - P06_02
    SimultaneousIds:
    - P06_03
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uD504\uB9AC\uB4DC\uB2D8\uC740 \uCC3D\uACE0\uB3C4 \uC790\uC8FC \uC0B4\uD53C\uC2DC\uB124\uC694."
    - TextId: 6
      Text: "\uC758\uB8B0 \uBB3C\uD488\uC774\uB098 \uBCF4\uAE09\uD488\uC740 \uAC00\uBCCD\uAC8C
        \uBCF4\uBA74 \uC548 \uB3FC.\n\uC791\uC740 \uC2E4\uC218\uAC00 \uD070 \uBB38\uC81C\uB85C
        \uC774\uC5B4\uC9C8 \uB54C\uAC00 \uB9CE\uAC70\uB4E0."
    - TextId: 1
      Text: "\uADF8\uB0A0 \uC758\uB8B0 \uBB3C\uD488\uB3C4 \uADF8\uB7AC\uB098\uC694?"
    - TextId: 6
      Text: "\uB9DE\uC544. \uC5B4\uB290 \uC0C1\uB2E8\uC758 \uC911\uC694\uD55C \uBB3C\uD488\uC744
        \uD638\uC1A1\uD574\uB2EC\uB77C\uB294 \uC758\uB8B0\uC600\uC5B4."
    - TextId: 6
      Text: "\uBB38\uC81C\uB294 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4\uB294 \uAC70\uC57C.\n\uD1A0\uB2C8\uB3C4,
        \uBB3C\uD488\uB3C4."
    - TextId: 1
      Text: "\uADF8\uB798\uC11C \uBC29\uC5B4\uBCBD \uC704\uCE58\uB97C \uC815\uD558\uAE30
        \uC5B4\uB824\uC6B0\uC168\uAD70\uC694."
    - TextId: 6
      Text: "\uADF8 \uC9E7\uC740 \uC21C\uAC04\uC5D0, \uB098\uB294 \uB108\uBB34 \uB9CE\uC740
        \uAC78 \uBCF4\uB824\uACE0 \uD588\uC5B4.\n\uB098\uB294 \uBAA8\uB450\uB97C
        \uC9C0\uD0A4\uACE0 \uC2F6\uC5C8\uB294\uB370, \uADF8 \uC21C\uAC04 \uD1A0\uB2C8\uAC00
        \uC5B4\uB514 \uC788\uB294\uC9C0 \uC54C \uC218 \uC5C6\uC5C8\uC5B4."
    - TextId: 1
      Text: "(\uD1A0\uB2C8\uC640 \uBB3C\uD488\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC558\uAE30
        \uB54C\uBB38\uC5D0, \uD504\uB9AC\uB4DC\uC758 \uBC29\uC5B4 \uD310\uB2E8\uC774
        \uD754\uB4E4\uB838\uB2E4\uB294 \uAC70\uB124.)"
    - TextId: 1
      Text: "(\uC774\uAC74 \uD504\uB9AC\uB4DC\uC5D0\uAC8C \uC544\uC9C1 \uB0A8\uC544
        \uC788\uB294 \uC0C1\uCC98\uC57C.)"
    DesignerNote: "\"P06_03 \uD68D\uB4DD \uC2DC \uC790\uB3D9\uC73C\uB85C \uB3D9\uC2DC"
  - ProfileClueId: P05_03
    CharacterId: 5
    ClueIndex: 3
    ClueText: "\uC6A9\uBCD1\uB2E8\uC758 \uB2E8\uC6D0\uB4E4\uC740 \uD1A0\uB2C8\uAC00
      \uBB3C\uD488\uC744 \uC9C0\uD0A4\uAE30 \uC704\uD574 \uB098\uB984\uC758 \uBC29\uBC95\uC73C\uB85C
      \uB178\uB825\uD588\uB2E4\uACE0 \uC0DD\uAC01\uD55C\uB2E4."
    HintText: "\uC6A9\uBCD1\uB2E8\uC758 \uB2E8\uC6D0\uB4E4\uC740 \uD1A0\uB2C8\uAC00
      \uD63C\uB780\uC744 \uD2C8\uD0C0 \uBB3C\uD488\uC744 \uB4E4\uACE0 \uB3C4\uB9DD\uCE58\uB824\uACE0
      \uD55C \uBC30\uC2E0\uC790\uB77C\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uCC3D\uACE0\uC5D0\uC11C \uBA54\uC774\uC640 \uD504\uB9AC\uB4DC\uAC00
      \uB418\uC9DA\uC740 \uD1A0\uB2C8\uC758 \uC758\uB3C4\n\uD544\uC694 \uB2E8\uC11C:
      \uC608\uBC30\uC2E4\uC5D0\uC11C \uBC1C\uC0DD\uD55C \uBA54\uC774\uC640 \uC5F0\uC778\uC758
      \uCDA9\uB3CC"
    Combo: 010000000200000006000000
    PlaceName: "\uCC3D\uACE0"
    DeadRequired: 
    Prerequisites:
    - P02_03
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uD760... \uBC27\uC904\uC774 \uC5B4\uB514 \uC788\uB354\uB77C.\n\uADF8\uB098\uC800\uB098
        \uC5EC\uAE34 \uC5EC\uC804\uD788 \uBB3C\uD488\uC774 \uB9CE\uAD70.\n\uC804\uBD80
        \uAE54\uB054\uD558\uAC8C \uC190\uC9C8\uB418\uC5B4 \uC788\uC5B4."
    - TextId: 6
      Text: "\uD1A0\uB2C8\uAC00 \uAD00\uB9AC\uD558\uB358\uAC70\uC57C.\n\uD1A0\uB2C8\uB294
        \uADF8\uB7F0 \uAC78 \uAC00\uBCCD\uAC8C \uC5EC\uAE30\uC9C0 \uC54A\uC558\uC5B4.\n\uC758\uB8B0
        \uBB3C\uD488\uB3C4, \uBCF4\uAE09\uD488\uB3C4, \uACC4\uC57D\uB3C4."
    - TextId: 2
      Text: "\uC544. \uD504\uB9AC\uB4DC. \uD1A0\uB2C8\uB294 \uD504\uB9AC\uB4DC\uB97C
        \uD3C9\uC18C\uC5D0 \uC798 \uB530\uB790\uC9C0.\n(\uB098\uB294 \uBB34\uC11C\uC6CC
        \uD558\uB358\uB370...)"
    - TextId: 2
      Text: "...\uADF8\uB798\uC11C \uADF8 \uB0A0 \uBB3C\uD488\uC744 \uB4E4\uACE0
        \uB3C4\uB9DD\uCE5C\uAC74\uAC00?\n\uB4DC\uB798\uACE4\uC774 \uB208\uC55E\uC5D0
        \uC788\uC5C8\uB294\uB370\uB3C4?"
    - TextId: 6
      Text: "\uD1A0\uB2C8\uB294 \uC2F8\uC6B8 \uC218 \uC5C6\uC5C8\uC5B4.\n\uADF8\uB7EC\uB2C8\uAE4C
        \uC790\uC2E0\uC774 \uD560 \uC218 \uC788\uB294 \uC77C\uC744 \uD558\uB824 \uD588\uACA0\uC9C0."
    - TextId: 2
      Text: "\uBB34\uC2A8 \uC77C\uC744 \uD558\uB824\uACE0 \uD55C \uAC70\uC9C0?"
    - TextId: 6
      Text: "\uC544\uB9C8... \uBB3C\uD488\uC744 \uC9C0\uD0A4\uB824\uACE0 \uD588\uB358
        \uAC83 \uAC19\uC544.\n\uD1A0\uB2C8\uC5D0\uAC8C\uB294 \uADF8\uAC8C \uC6B0\uB9AC
        \uC6A9\uBCD1\uB2E8\uC744 \uC9C0\uD0A4\uB294 \uBC29\uC2DD\uC774\uC5C8\uC744
        \uAC70\uC57C."
    - TextId: 2
      Text: "\u2026\u2026"
    - TextId: 6
      Text: "\uADF8 \uC21C\uAC04 \uD1A0\uB2C8\uC640 \uBB3C\uD488\uC774 \uBCF4\uC774\uC9C0
        \uC54A\uC558\uB358 \uAC83\uB3C4 \uC0AC\uC2E4\uC774\uC57C.\n\uB098\uB294 \uBA54\uC774
        \uB108\uC640, \uD1A0\uB2C8\uC640, \uBB3C\uD488\uAE4C\uC9C0 \uBAA8\uB450 \uBCF4\uB824\uB2E4
        \uBC29\uC5B4\uC5D0 \uC2E4\uD328\uD588\uACE0.\n\uD558\uC9C0\uB9CC \uD1A0\uB2C8\uB294
        \uB3C4\uC6C0\uC774 \uB418\uB824\uACE0 \uD588\uB358 \uAC83 \uAC19\uC544.\n\uC544\uC9C1
        \uC5B4\uB9B0 \uC544\uC774\uB2C8\uAE4C \uB108\uBB34 \uBAB0\uC544\uC138\uC6B0\uC9C0
        \uB9C8."
    - TextId: 2
      Text: "...\uADF8\uB0A0 \uC6B0\uB9AC\uB294 \uC804\uBD80 \uB2E4\uB978 \uAC78
        \uBCF4\uACE0 \uC788\uC5C8\uB358 \uAC74\uAC00.\n\uB0B4\uAC00 \uC624\uD574\uB97C
        \uD588\uAD70.\n\uB2E4\uB978 \uB2E8\uC6D0\uB4E4\uC5D0\uAC8C\uB3C4 \uB9D0\uD574\uB450\uB3C4\uB85D
        \uD558\uC9C0."
    - TextId: 1
      Text: "(\uBA54\uC774\uB294 \uD1A0\uB2C8\uB97C \uB2E8\uC21C\uD55C \uB3C4\uB9DD\uC790\uB85C\uB9CC
        \uBCF4\uACE0 \uC788\uC5C8\uC5B4.)"
    - TextId: 1
      Text: "(\uD558\uC9C0\uB9CC \uD1A0\uB2C8\uC5D0\uAC8C\uB3C4 \uC9C0\uD0A4\uB824\uB358
        \uAC8C \uC788\uC5C8\uB2E4\uB294 \uAC70\uB124.)"
    DesignerNote: "\"P02_04 \uD68D\uB4DD \uC2DC \uC790\uB3D9\uC73C\uB85C \uB3D9\uC2DC"
  - ProfileClueId: P05_04
    CharacterId: 5
    ClueIndex: 4
    ClueText: "\uD1A0\uB2C8\uC758 \uC815\uC2E0 \uC0C1\uD0DC\uB294 \uD0C0\uC778\uC5D0
      \uB300\uD55C \uADFC\uAC70 \uC5C6\uB294 \uC758\uC2EC\uACFC \uBD88\uC2E0 \uB54C\uBB38\uC5D0
      \uBD95\uAD34 \uB410\uB2E4."
    HintText: "\uD1A0\uB2C8\uC758 \uC815\uC2E0 \uC0C1\uD0DC\uB294 \uC624\uB85C\uC9C0
      \uC790\uC2E0\uC5D0 \uB300\uD55C \uBD88\uC2E0 \uB54C\uBB38\uC5D0 \uC77C\uC5B4\uB0AC\uB2E4."
    HintDescription: "\uC6A9\uBCD1\uB2E8\uC744 \uBAB0\uC0B4\uD55C \uD1A0\uB2C8\n\uD544\uC694
      \uB2E8\uC11C: \uCC3D\uACE0\uC5D0\uC11C \uBA54\uC774\uC640 \uD504\uB9AC\uB4DC\uAC00
      \uB418\uC9DA\uC740 \uD1A0\uB2C8\uC758 \uC758\uB3C4"
    Combo: 0100000005000000
    PlaceName: 
    DeadRequired: 0200000003000000040000000600000007000000
    Prerequisites:
    - P05_03
    SimultaneousIds: []
    IsForcedExitFragment: 1
    Lines:
    - TextId: 5
      Text: "\uB098\uB294..... \uBD84\uBA85..... \uD300\uC5D0.... \uB3C4\uC6C0\uC774....
        \uB410\uC5B4....."
    - TextId: 1
      Text: "(\uC820\uC7A5! \uB2E8\uC6D0\uB4E4\uC774 \uC804\uBD80 \uC8FD\uC5C8\uC5B4.\n\uB610
        \uB2E4\uC2DC \uB3CC\uC544\uAC00\uC57C\uB9CC \uD574.\n\uD1A0\uB2C8 \uCABD\uC740
        \uD604\uC7AC \uC815\uC2E0\uC0C1\uD0DC\uAC00 \uBD88\uC548\uC815\uD574.\n\uB2E4\uC74C
        \uB8E8\uD504 \uB54C\uB294 \uCD5C\uB300\uD55C \uD53C\uD574\uBCF4\uC790.)"
    DesignerNote: "\"\uC774 \uC0C1\uD669 \uD55C\uC815\uC73C\uB85C, \uAC15\uC81C\uD1F4\uACE0"
  - ProfileClueId: P05_05
    CharacterId: 5
    ClueIndex: 5
    ClueText: "\uD1A0\uB2C8\uB294 \uBB3C\uD488\uC744 \uC9C0\uD0A8 \uC790\uC2E0\uC758
      \uD589\uB3D9\uC774 \uC624\uD788\uB824 \uD504\uB9AC\uB4DC\uC5D0\uAC8C \uD574\uAC00
      \uB418\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC5EC, \uC2EC\uAC01\uD55C \uC790\uAE30\uD610\uC624\uC5D0
      \uBE60\uC84C\uB2E4."
    HintText: "\uD1A0\uB2C8\uB294 \uD504\uB9AC\uB4DC\uAC00 \uC790\uC2E0\uC758 \uD310\uB2E8\uC744
      \uC774\uD574\uD574 \uC8FC\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD588\uC9C0\uB9CC,
      \uB2E4\uB978 \uB2E8\uC6D0\uB4E4\uC758 \uB208\uCD08\uB9AC\uB97C \uBC84\uD2F0\uC9C0
      \uBABB\uD558\uACE0 \uD3ED\uBC1C\uD558\uC600\uB2E4."
    HintDescription: "\uC6A9\uBCD1\uB2E8\uC758 \uBD95\uAD34, \uC5D4\uBE44\uB97C \uC704\uD574
      \uD76C\uC0DD\uD55C \uD504\uB9AC\uB4DC \uB355\uC5D0 \uC5D4\uBE44\uB294 \uD1A0\uB2C8\uC640\uC758
      \uB3C5\uB300\uB97C \uC131\uC0AC\uC2DC\uD0AC \uC218 \uC788\uC5C8\uB2E4.\n\uD544\uC694
      \uB2E8\uC11C: \uC6A9\uBCD1\uB2E8\uC744 \uBAB0\uC0B4\uD55C \uD1A0\uB2C8"
    Combo: 010000000500000006000000
    PlaceName: 
    DeadRequired: 02000000030000000400000007000000
    Prerequisites:
    - P05_04
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uD1A0\uB2C8\uB2D8!! \uC9C4\uC815\uD558\uC138\uC694."
    - TextId: 5
      Text: "\uC9C4\uC815? \uB108 \uAC19\uC73C\uBA74 \uADF8\uAC8C \uB420 \uAC83 \uAC19\uC544?!"
    - TextId: 1
      Text: "(\uB4DC\uB514\uC5B4 \uB2E4\uC2DC \uC774\uC57C\uAE30\uB97C \uB098\uB20C
        \uC218 \uC788\uAC8C \uB410\uC5B4.\n\uC544\uB9C8 \uB9C8\uC9C0\uB9C9 \uAE30\uD68C\uC77C\uC9C0\uB3C4
        \uBAB0\uB77C) \uC800\uB77C\uBA74 \uD1A0\uB2C8\uB2D8\uC758 \uB9C8\uC74C\uC744
        \uC774\uD574\uD560 \uC218 \uC788\uC5B4\uC694."
    - TextId: 5
      Text: "\uC774\uBBF8 \uBAA8\uB4E0 \uAC8C \uB05D\uB0AC\uC5B4.\n\uBAA8\uB450 \uC8FD\uC5C8\uC5B4...
        \uD504\uB9AC\uB4DC\uAE4C\uC9C0..."
    - TextId: 1
      Text: "\uC65C \uB2E8\uC6D0\uB4E4 \uBAA8\uB450\uAC00 \uD1A0\uB2C8\uB2D8\uC744
        \uC2EB\uC5B4\uD55C\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC2E0 \uAC70\uC5D0\uC694?"
    - TextId: 5
      Text: "\uADF8\uB188\uB4E4\uC740 \uBB3C\uD488\uC744 \uC9C0\uD0A4\uB824\uACE0
        \uD55C \uB098\uC5D0\uAC8C \uB3C4\uB9DD\uC790\uC758 \uB099\uC778\uC744 \uCC0D\uC73C\uB824
        \uD55C \uB188\uB4E4\uC774\uC57C!!!\n\uBA54\uC774\uB294 \uB0B4\uAC00 \uB3C4\uB9DD\uCCE4\uB2E4\uACE0
        \uBD24\uACA0\uC9C0. \uB8E8\uC774\uC2A4\uB294 \uC544\uBB34 \uB9D0\uB3C4 \uC548
        \uD588\uC5B4."
    - TextId: 5
      Text: "\uBAA8\uB450 \uB9D0\uB85C\uB294 \uBB3C\uD488\uC744 \uC9C0\uD0A8 \uAC83\uB3C4\n\uC911\uC694\uD558\uB314\uC9C0\uB9CC
        \uB2E4\uB4E4 \uB098\uB97C \uBC30\uC2E0\uC790 \uCDE8\uAE09 \uD558\uACE0\n\uC788\uB358\uAC70\uC57C!!!!!!"
    - TextId: 1
      Text: "\uD1A0\uB2C8\uB2D8, \uB2E8\uC6D0\uBD84\uB4E4\uC740 \uADF8\uB807\uAC8C
        \uC0DD\uAC01\uD558\uACE0 \uC788\uC9C0 \uC54A\uC558\uC5B4\uC694!!"
    - TextId: 5
      Text: "\uC2DC\uB044\uB7EC\uC5B4\uC5B4\uC5B4!!!!!!!!\n\uC774\uC81C \uB2E4 \uC758\uBBF8
        \uC5C6\uC5B4!!!!!!!!!!!!!!!!!!!!\n\uADF8\uB098\uB9C8 \uC81C\uC77C \uBBFF\uC5C8\uB358
        \uD504\uB9AC\uB4DC\uB3C4, \uB098\uB97C \uD0D3\uD558\uACE0 \uC788\uC5C8\uB358
        \uAC8C \uBD84\uBA85\uD574!!!"
    - TextId: 5
      Text: "\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC774 \uB098\uB97C \uBC30\uC2E0\uC790
        \uCDE8\uAE09 \uD558\uB294 \uAC74\n\uC0C1\uAD00\uC5C6\uC9C0\uB9CC... \uD558\uC9C0\uB9CC
        \uD504\uB9AC\uB4DC\uAC00..\n\uD504\uB9AC\uB4DC\uC870\uCC28 \uB098\uB97C \uBBFF\uC5B4\uC8FC\uC9C0
        \uC54A\uC558\uC5B4!!!!"
    - TextId: 1
      Text: "\uD1A0\uB2C8\uB2D8, \uADF8\uAC74 \uD1A0\uB2C8\uB2D8\uC758 \uB9DD\uC0C1\uC774\uC5D0\uC694!!\n\uC624\uD788\uB824
        \uD504\uB9AC\uB4DC\uB2D8\uC740 \uD1A0\uB2C8\uB2D8\uC744 \uC5B4\uB5BB\uAC8C\uB4E0
        \uC774\uD574\uD558\uC2DC\uACE0, \uBCF4\uD638\uAC00 \uB2A6\uC5C8\uB358 \uC790\uAE30
        \uD0D3\uC774\uB77C\uACE0 \uC0DD\uAC01\uD558\uACE0 \uACC4\uC168\uC5B4\uC694!"
    - TextId: 5
      Text: "...\uBB50? \uD504\uB9AC\uB4DC\uAC00 \uB0B4 \uD0D3\uC774 \uC544\uB2C8\uB77C
        \uC790\uAE30 \uD0D3\uC744 \uD588\uB2E4\uACE0?"
    - TextId: 5
      Text: "\uAC70\uC9D3\uB9D0..."
    - TextId: 5
      Text: ..........
    - TextId: 5
      Text: "\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    - TextId: 1
      Text: "(\uBBF8\uCCD0\uBC84\uB9AC\uACA0\uB124. \uC65C \uC774\uB7F0 \uC77C\uC5D0
        \uB0B4\uAC00 \uD718\uB9D0\uB9AC\uAC8C \uB41C\uAC78\uAE4C.)"
    - TextId: 1
      Text: "(\uD558... \uD1A0\uB2C8\uB294 \uB2E8\uC21C\uD788 \uC790\uC2E0\uC744
        \uBBF8\uC6CC\uD574\uC11C \uBB34\uB108\uC9C4 \uAC8C \uC544\uB2C8\uC57C.)"
    - TextId: 1
      Text: "(\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC774 \uC790\uC2E0\uC744 \uC5B4\uB5BB\uAC8C
        \uBCFC\uC9C0 \uACC4\uC18D\n\uC758\uC2EC\uD558\uB2E4\uAC00, \uACB0\uAD6D \uADF8
        \uC758\uC2EC\uC5D0 \uC0BC\uCF1C\uC84C\uC5B4.)"
    DesignerNote: "\"\uD504\uB9AC\uB4DC\uAC00 \uD76C\uC0DD\uC591 \uD6A8\uACFC\uB97C"
  - ProfileClueId: P06_01
    CharacterId: 6
    ClueIndex: 1
    ClueText: "\uD504\uB9AC\uB4DC\uB294 \uC790\uC2E0\uC774 \uC9C0\uD0A4\uC9C0 \uBABB\uD55C
      \uC0AC\uB78C\uB4E4\uC5D0 \uB300\uD55C \uC8C4\uCC45\uAC10\uC744 \uAC00\uC9C0\uACE0
      \uC788\uB2E4."
    HintText: "\uD504\uB9AC\uB4DC\uB294 \uC790\uC2E0\uC758 \uC2DC\uC57C \uBC16\uC73C\uB85C
      \uC0AC\uB77C\uC9C4 \uC0AC\uB78C\uC740 \uBC29\uC5B4\uD558\uC9C0 \uC54A\uC544\uB3C4
      \uB41C\uB2E4\uACE0 \uC0DD\uAC01\uD55C\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uC2E0\uC785\uACFC \uD504\uB9AC\uB4DC\uC758
      \uCCAB \uC778\uC0AC"
    Combo: 0100000006000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uD504\uB9AC\uB4DC\uB2D8, \uB9DE\uC73C\uC2DC\uC8E0?\n\uC6A9\uBCD1\uB2E8\uC5D0
        \uC0C8\uB85C \uD569\uB958\uD55C \uC5D4\uBE44\uC608\uC694. \uC798 \uBD80\uD0C1\uB4DC\uB824\uC694!"
    - TextId: 6
      Text: "\uC2E0\uC785\uC774\uAD6C\uB098. \uD0F1\uCEE4 \uD504\uB9AC\uB4DC\uC57C.\n\uBAA8\uB974\uB294
        \uAC8C \uC788\uC73C\uBA74 \uC5B8\uC81C\uB4E0 \uBB3C\uC5B4\uBD10."
    - TextId: 1
      Text: "\uD6C8\uB828 \uC911\uC774\uC168\uC5B4\uC694?"
    - TextId: 6
      Text: "\uC751. \uC815\uD655\uD788\uB294 \uC815\uB9AC \uC911\uC774\uC5C8\uC5B4.\n\uAC80\uC9D1\uC774\uB098
        \uBC29\uD328\uAC00 \uBC14\uB2E5\uC5D0 \uAD74\uB7EC\uB2E4\uB2C8\uBA74 \uB204\uAC00
        \uBC1C\uC744 \uD5DB\uB514\uB51C \uC218\uB3C4 \uC788\uC796\uC544."
    - TextId: 1
      Text: "\uC544! \uC800\uB3C4 \uB3C4\uC640\uB4DC\uB9B4\uAC8C\uC694.\n\uC774\uB7F0
        \uAC83\uB3C4 \uC9C1\uC811 \uCC59\uAE30\uC138\uC694?"
    - TextId: 6
      Text: "\uC624, \uACE0\uB9C8\uC6CC. \uB208\uC5D0 \uBCF4\uC774\uBA74 \uCE58\uC6CC\uC57C\uC9C0.\n\uBAA8\uB978\uCC99
        \uD588\uB2E4\uAC00 \uB204\uAC00 \uB2E4\uCE58\uBA74 \uACC4\uC18D \uC0DD\uAC01\uB098\uAC70\uB4E0."
    - TextId: 1
      Text: "\uD504\uB9AC\uB4DC\uB2D8\uC740 \uD300\uC6D0\uB4E4\uC744 \uC798 \uCC59\uAE30\uC2DC\uB124\uC694.\n\uBC29\uC5B4
        \uB2F4\uB2F9\uC774\uB77C \uADF8\uB7F0\uAC00\uC694?"
    - TextId: 6
      Text: "\uD558\uD558, \uADF8\uB7EC\uB824\uB098? \uB098\uB294 \uC801\uBCF4\uB2E4
        \uC544\uAD70\uC744 \uBA3C\uC800 \uBCF4\uAC8C \uB3FC.\n\uB204\uAC00 \uB108\uBB34
        \uC55E\uC73C\uB85C \uAC14\uB294\uC9C0, \uB204\uAC00 \uB4A4\uB85C \uBE60\uC84C\uB294\uC9C0,
        \uB204\uAC00 \uC548 \uBCF4\uC774\uB294\uC9C0."
    - TextId: 1
      Text: "\uC5B4\uB77C, \uC704\uCE58\uAC00 \uADF8\uB807\uAC8C \uC911\uC694\uD55C\uAC00\uC694?"
    - TextId: 6
      Text: "\uBC29\uC5B4\uB9C9\uC744 \uD3BC\uCE60 \uB54C \uBC94\uC704\uB97C \uAC00\uB2A0\uD574\uC57C
        \uD558\uB2C8\uAE4C.\n\uB0B4 \uC2DC\uC57C \uC548\uC5D0 \uC5C6\uB294 \uC0AC\uB78C\uC740...
        \uC9C0\uD0AC \uC218 \uC5C6\uC5B4."
    - TextId: 1
      Text: "\uADF8\uB807\uAD70\uC694. \uBA85\uC2EC\uD560\uAC8C\uC694."
    - TextId: 6
      Text: "\uC751. \uAF2D \uC2E0\uACBD\uC368\uC918.\n\uADF8\uB098\uC800\uB098 \uAC19\uC774
        \uCE58\uC6B0\uB2C8\uAE4C \uAE08\uBC29 \uB05D\uB0AC\uB124.\n\uB3C4\uC640\uC918\uC11C
        \uACE0\uB9C8\uC6CC, \uC5D4\uBE44."
    - TextId: 1
      Text: "\uBCC4\uB9D0\uC500\uC744\uC694!"
    - TextId: 1
      Text: "(\uC9C0\uCF1C\uC57C \uD560 \uC0AC\uB78C\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC73C\uBA74
        \uC9C0\uD0AC \uC218 \uC5C6\uB2E4\uB77C.\n\uD504\uB9AC\uB4DC\uD55C\uD14C\uB294
        \uAF64 \uC544\uD508 \uB9D0 \uAC19\uB124.)"
    DesignerNote: 
  - ProfileClueId: P06_02
    CharacterId: 6
    ClueIndex: 2
    ClueText: "\uD504\uB9AC\uB4DC\uB294 \uBA54\uC774\uC758 \uB3CC\uBC1C \uD589\uB3D9\uC5D0\uB3C4
      \uB2F9\uD669\uD558\uC9C0 \uC54A\uB294\uB2E4."
    HintText: "\uD504\uB9AC\uB4DC\uB294 \uBA54\uC774\uC758 \uB3CC\uBC1C \uD589\uB3D9\uC5D0
      \uBD88\uCF8C\uD568\uC744 \uB290\uB07C\uACE0 \uC788\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uBCF8 \uBA54\uC774\uC640 \uD504\uB9AC\uB4DC\uC758
      \uCDA9\uB3CC\n\uD544\uC694 \uB2E8\uC11C: \uD6C8\uB828\uC7A5\uC5D0\uC11C \uC2E0\uC785\uACFC
      \uD504\uB9AC\uB4DC\uC758 \uCCAB \uC778\uC0AC"
    Combo: 010000000200000006000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P06_01
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 2
      Text: "\uD504\uB9AC\uB4DC, \uC774\uBC88\uC5D4 \uC880 \uB354 \uBE68\uB9AC \uB530\uB77C\uC640.\n\uB0B4\uAC00
        \uB4E4\uC5B4\uAC00\uBA74 \uBC14\uB85C \uBC29\uC5B4\uBCBD \uB9DE\uCDB0\uC918\uC57C
        \uD574."
    - TextId: 6
      Text: "\uADF8 \uC804\uC5D0 \uB124\uAC00 \uB108\uBB34 \uAE4A\uAC8C \uB4E4\uC5B4\uAC00\uC9C0
        \uC54A\uC73C\uBA74 \uC88B\uACA0\uB294\uB370."
    - TextId: 2
      Text: "\uADF8\uB807\uAC8C \uC5B4\uBB3C\uCA61\uAC70\uB9AC\uB2E4\uAC00\uB294
        \uAE30\uD68C\uB97C \uB193\uCE58\uACE0 \uB9CC\uB2E4.\n\uAE30\uD68C\uB294 \uADF8\uB807\uAC8C
        \uD568\uBD80\uB85C \uC8FC\uC5B4\uC9C0\uB294\uAC8C \uC544\uB0D0."
    - TextId: 6
      Text: "\uADF8\uB798\uC11C \uB0B4\uAC00 \uB298 \uACE0\uC0DD\uD558\uC9C0.\n\uC880
        \uCC9C\uCC9C\uD788 \uAC00\uB77C\uACE0!"
    - TextId: 2
      Text: "\uB2F5\uB2F5\uD558\uAD70. \uADF8\uB798\uB3C4 \uB298 \uB9DE\uCD94\uB358\uB370.\n\uB108\uB294
        \uB0B4\uAC00 \uC5B4\uB514\uB85C \uAC08\uC9C0 \uB300\uCDA9 \uC54C\uC796\uC544."
    - TextId: 6
      Text: "\uADF8\uAC74 \uB9DE\uC544. \uB10C \uB298 \uC55E\uC73C\uB85C\uB9CC \uAC00\uB2C8\uAE4C."
    - TextId: 1
      Text: "\uBA54\uC774\uB2D8\uC774 \uB108\uBB34 \uBB34\uBAA8\uD558\uB2E4\uACE0
        \uC0DD\uAC01\uD558\uC138\uC694?"
    - TextId: 6
      Text: "\uBA54\uC774? \uB0B4\uAC00 \uBCF8 \uC0AC\uB78C \uC911\uC5D0 \uC81C\uC77C
        \uBB34\uBAA8\uD558\uC9C0.\n\uADFC\uB370 \uC774\uC0C1\uD558\uAC8C\uB3C4 \uB9C9\uAE30
        \uC5B4\uB824\uC6B4 \uCABD\uC740 \uC544\uB2C8\uC57C."
    - TextId: 1
      Text: "\uC5C7, \uC5B4\uC9F8\uC11C\uC8E0?"
    - TextId: 6
      Text: "\uBC29\uD5A5\uC774 \uBD84\uBA85\uD558\uAC70\uB4E0.\n\uC55E\uC73C\uB85C
        \uAC00\uAC70\uB098. \uBE68\uB9AC \uAC00\uAC70\uB098.\n\uB108\uBB34 \uAE4A\uAC8C
        \uAC00\uAC70\uB098.\n\uC704\uD5D8\uD558\uC9C0\uB9CC \uC6C0\uC9C1\uC784\uC744
        \uC77D\uC744 \uC218\uB294 \uC788\uC5B4."
    - TextId: 2
      Text: "\uC5B4\uC774, \uCE6D\uCC2C\uC774\uC57C, \uC695\uC774\uC57C?"
    - TextId: 6
      Text: "\uB458 \uB2E4."
    DesignerNote: 
  - ProfileClueId: P06_03
    CharacterId: 6
    ClueIndex: 3
    ClueText: "\uD504\uB9AC\uB4DC\uB294 \uD1A0\uB2C8\uC640 \uBB3C\uD488\uC774 \uBCF4\uC774\uC9C0
      \uC54A\uC544 \uBC29\uC5B4\uBCBD \uC704\uCE58\uB97C \uC815\uD558\uB294 \uB370
      \uD754\uB4E4\uB838\uB2E4\uACE0 \uAE30\uC5B5\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uD504\uB9AC\uB4DC\uB294 \uD1A0\uB2C8\uC640 \uBB3C\uD488\uC758 \uC704\uCE58\uB97C
      \uC815\uD655\uD788 \uC54C\uACE0 \uC788\uC5C8\uC9C0\uB9CC \uC77C\uBD80\uB7EC
      \uBC29\uC5B4\uD558\uC9C0 \uC54A\uC558\uB2E4."
    HintDescription: "\uCC3D\uACE0\uC5D0\uC11C \uD504\uB9AC\uB4DC\uAC00 \uD68C\uC0C1\uD558\uB294
      \uADF8\uB0A0\uC758 \uD1A0\uB2C8\n\uD544\uC694 \uB2E8\uC11C: \uD6C8\uB828\uC7A5\uC5D0\uC11C
      \uBCF8 \uBA54\uC774\uC640 \uD504\uB9AC\uB4DC\uC758 \uCDA9\uB3CC"
    Combo: 0100000006000000
    PlaceName: "\uCC3D\uACE0"
    DeadRequired: 
    Prerequisites:
    - P06_02
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uD504\uB9AC\uB4DC\uB2D8\uC740 \uCC3D\uACE0\uB3C4 \uC790\uC8FC \uC0B4\uD53C\uC2DC\uB124\uC694."
    - TextId: 6
      Text: "\uC758\uB8B0 \uBB3C\uD488\uC774\uB098 \uBCF4\uAE09\uD488\uC740 \uAC00\uBCCD\uAC8C
        \uBCF4\uBA74 \uC548 \uB3FC.\n\uC791\uC740 \uC2E4\uC218\uAC00 \uD070 \uBB38\uC81C\uB85C
        \uC774\uC5B4\uC9C8 \uB54C\uAC00 \uB9CE\uAC70\uB4E0."
    - TextId: 1
      Text: "\uADF8\uB0A0 \uC758\uB8B0 \uBB3C\uD488\uB3C4 \uADF8\uB7AC\uB098\uC694?"
    - TextId: 6
      Text: "\uB9DE\uC544. \uC5B4\uB290 \uC0C1\uB2E8\uC758 \uC911\uC694\uD55C \uBB3C\uD488\uC744
        \uD638\uC1A1\uD574\uB2EC\uB77C\uB294 \uC758\uB8B0\uC600\uC5B4."
    - TextId: 6
      Text: "\uBB38\uC81C\uB294 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4\uB294 \uAC70\uC57C.\n\uD1A0\uB2C8\uB3C4,
        \uBB3C\uD488\uB3C4."
    - TextId: 1
      Text: "\uADF8\uB798\uC11C \uBC29\uC5B4\uBCBD \uC704\uCE58\uB97C \uC815\uD558\uAE30
        \uC5B4\uB824\uC6B0\uC168\uAD70\uC694."
    - TextId: 6
      Text: "\uADF8 \uC9E7\uC740 \uC21C\uAC04\uC5D0, \uB098\uB294 \uB108\uBB34 \uB9CE\uC740
        \uAC78 \uBCF4\uB824\uACE0 \uD588\uC5B4.\n\uB098\uB294 \uBAA8\uB450\uB97C
        \uC9C0\uD0A4\uACE0 \uC2F6\uC5C8\uB294\uB370, \uADF8 \uC21C\uAC04 \uD1A0\uB2C8\uAC00
        \uC5B4\uB514 \uC788\uB294\uC9C0 \uC54C \uC218 \uC5C6\uC5C8\uC5B4."
    - TextId: 1
      Text: "(\uD1A0\uB2C8\uC640 \uBB3C\uD488\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC558\uAE30
        \uB54C\uBB38\uC5D0, \uD504\uB9AC\uB4DC\uC758 \uBC29\uC5B4 \uD310\uB2E8\uC774
        \uD754\uB4E4\uB838\uB2E4\uB294 \uAC70\uB124.)"
    - TextId: 1
      Text: "(\uC774\uAC74 \uD504\uB9AC\uB4DC\uC5D0\uAC8C \uC544\uC9C1 \uB0A8\uC544
        \uC788\uB294 \uC0C1\uCC98\uC57C.)"
    DesignerNote: "\"\uD574\uB2F9 \uC870\uAC01 \uD68D\uB4DD \uC2DC \uC790\uB3D9\uC73C\uB85C"
  - ProfileClueId: P06_04
    CharacterId: 6
    ClueIndex: 4
    ClueText: "\uD504\uB9AC\uB4DC\uB294 \uC0C8\uD134\uC774 \uB9C9\uC9C0 \uBABB\uD55C
      \uD30C\uD3B8\uAE4C\uC9C0 \uC790\uC2E0\uC774 \uB9C9\uC558\uC5B4\uC57C \uD588\uB2E4\uACE0
      \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uD504\uB9AC\uB4DC\uB294 \uADF8 \uB0A0 \uC0AC\uB77C\uC9C4 \uC0AC\uB78C\uACFC
      \uBB3C\uD488\uC5D0 \uB300\uD574 \uC6D0\uB9DD\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uADF8\uB0A0\uC744 \uD68C\uC0C1\uD558\uB294
      \uD504\uB9AC\uB4DC\uC640 \uC0C8\uD134\n\uD544\uC694 \uB2E8\uC11C: \uCC3D\uACE0\uC5D0\uC11C
      \uD504\uB9AC\uB4DC\uAC00 \uD68C\uC0C1\uD558\uB294 \uADF8\uB0A0\uC758 \uD1A0\uB2C8"
    Combo: 010000000600000007000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P06_03
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 7
      Text: "\uADF8\uB0A0 \uD6C4\uBC29 \uACF5\uACA9\uC740 \uB9C9\uC558\uC5B4.\n\uC644\uC804\uD788\uB294
        \uC544\uB2C8\uC5C8\uC9C0\uB9CC."
    - TextId: 6
      Text: "\uAE09\uD558\uAC8C \uB300\uC751\uD558\uAE30 \uC5B4\uB824\uC6E0\uC744\uD150\uB370
        \uACE0\uC0DD\uD588\uC5B4.\n\uB0B4\uAC00 \uBC29\uC5B4\uD558\uC9C0 \uBABB\uD55C
        \uAC83 \uAE4C\uC9C0 \uBD10\uC918\uC11C \uACE0\uB9C8\uC6CC."
    - TextId: 7
      Text: "\uD558\uC9C0\uB9CC... \uB0B4\uAC00 \uC870\uAE08\uB9CC \uB354 \uC815\uD655\uD588\uC73C\uBA74,
        \uB8E8\uC774\uC2A4\uAE4C\uC9C0 \uAC00\uC9C0 \uC54A\uC558\uC744 \uAC70\uC57C."
    - TextId: 6
      Text: "\uC544\uB0D0. \uADF8 \uD30C\uD3B8\uC744 \uB9C9\uC558\uC5B4\uC57C \uD558\uB294
        \uAC74 \uB098\uC600\uC5B4.\n\uB0B4 \uCC45\uC784\uC774\uC57C."
    - TextId: 7
      Text: "\uD504\uB9AC\uB4DC, \uADF8\uB54C \uB124\uAC00 \uBD10\uC57C \uD560 \uAC74
        \uB108\uBB34 \uB9CE\uC558\uC5B4."
    - TextId: 6
      Text: "\uADF8\uB798\uB3C4 \uC804\uBD80 \uBD24\uC5B4\uC57C \uD588\uC5B4.\n\uADF8\uAC8C
        \uB0B4 \uC77C\uC778\uB370."
    - TextId: 7
      Text: "\uC544\uB0D0. \uC2EC\uC9C0\uC5B4 \uBB3C\uD488\uB3C4 \uC0AC\uB77C\uC9C4
        \uC0C1\uD669\uC5D0\uC11C\uB3C4 \uC55E\uCABD \uC0AC\uB78C\uB4E4\uC744 \uC9C0\uCF1C\uB0C8\uC796\uC544.\n\uD504\uB9AC\uB4DC\uB294
        \uCDA9\uBD84\uD788 \uC5ED\uD560\uC744 \uB2E4 \uD588\uC5B4."
    - TextId: 6
      Text: "\uB0B4\uAC00 \uC880 \uB354 \uBE68\uB9AC \uCC3E\uC544\uB0C8\uB354\uB77C\uBA74..."
    - TextId: 7
      Text: "\uD504\uB9AC\uB4DC! \uB124 \uCC45\uC784\uC774 \uC544\uB0D0.\n\uC0AC\uB77C\uC9C4
        \uC0AC\uB78C\uC774 \uBB38\uC81C\uC57C."
    - TextId: 6
      Text: "...\uC815\uB9D0 \uADF8\uB7F0\uAC78\uAE4C."
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uD30C\uD3B8\uC744 \uC644\uC804\uD788 \uB9C9\uC9C0
        \uBABB\uD588\uACE0,\n\uD504\uB9AC\uB4DC\uB294 \uADF8 \uD30C\uD3B8\uC744 \uB9C9\uC9C0
        \uBABB\uD55C \uAC78 \uC790\uAE30\n\uCC45\uC784\uC73C\uB85C \uBCF4\uACE0 \uC788\uB124.)"
    - TextId: 1
      Text: "(\uB9C9\uC73C\uB824\uB358 \uC0AC\uB78C\uB4E4\uB07C\uB9AC\uB3C4, \uB0A8\uC740
        \uC0C1\uCC98\uB294 \uB2E4\uB974\uAD6C\uB098.)"
    DesignerNote: 
  - ProfileClueId: P06_05
    CharacterId: 6
    ClueIndex: 5
    ClueText: "\uD504\uB9AC\uB4DC\uB294 \uB370\uC6B0\uC2A4 \uB355\uBD84\uC5D0 \uBAA8\uB450\uAC00
      \uC0B4\uC558\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uD504\uB9AC\uB4DC\uB294 \uB370\uC6B0\uC2A4\uAC00 \uB8E8\uC774\uC2A4\uB97C
      \uC9C0\uD0A4\uC9C0 \uBABB\uD588\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uC608\uBC30\uC2E4\uC5D0\uC11C \uADF8\uB0A0\uC744 \uD68C\uC0C1\uD558\uB294
      \uBA54\uC774, \uB370\uC6B0\uC2A4 \uADF8\uB9AC\uACE0 \uD504\uB9AC\uB4DC\n\uD544\uC694
      \uB2E8\uC11C: \uD6C8\uB828\uC7A5\uC5D0\uC11C \uADF8\uB0A0\uC744 \uD68C\uC0C1\uD558\uB294
      \uD504\uB9AC\uB4DC\uC640 \uC0C8\uD134"
    Combo: 01000000020000000400000006000000
    PlaceName: "\uC608\uBC30\uC2E4"
    DeadRequired: 
    Prerequisites:
    - P06_04
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uD504\uB9AC\uB4DC\uB2D8, \uADF8 \uCD1B\uB300\uB294 \uC81C\uAC00 \uB098\uC911\uC5D0
        \uC815\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4.\n\uB0A0\uCE74\uB85C\uC6CC\uC11C
        \uC190\uC744 \uB2E4\uCE58\uC2E4 \uC218\uB3C4 \uC788\uC5B4\uC694."
    - TextId: 6
      Text: "\uAD1C\uCC2E\uC544. \uAE30\uC6B8\uC5B4\uC9C4 \uCC44 \uB450\uBA74 \uB118\uC5B4\uC9C8
        \uC218\uB3C4 \uC788\uC796\uC544."
    - TextId: 2
      Text: "\uB108\uB294 \uADF8\uB7F0 \uAC83\uB3C4 \uADF8\uB0E5 \uBABB \uC9C0\uB098\uCE58\uB0D0?"
    - TextId: 6
      Text: "\uBA54\uC774, \uBD24\uC73C\uBA74 \uB108\uB3C4 \uC880 \uCE58\uC6CC\uB77C.\n\uB098\uC911\uC5D0
        \uBB34\uC2A8 \uC77C\uC774 \uC0DD\uAE30\uBA74 \uACC4\uC18D \uC0DD\uAC01\uB0A0\uAC78."
    - TextId: 4
      Text: "...\uADF8\uB0A0\uB3C4 \uADF8\uB798\uC11C \uACC4\uC18D \uB5A0\uC62C\uB9AC\uC2DC\uB294
        \uAC74\uAC00\uC694?"
    - TextId: 6
      Text: "...\uC751. \uB0B4 \uBCF4\uD638\uB9C9\uC774 \uB2FF\uC9C0 \uC54A\uC558\uB358
        \uAC8C \uACC4\uC18D \uB0A8\uC544."
    - TextId: 2
      Text: "\uADF8\uB798\uB3C4 \uB370\uC6B0\uC2A4\uAC00 \uADC0\uD658 \uC8FC\uBB38\uC744
        \uC548 \uC37C\uB2E4\uBA74 \uB2EC\uB790\uC744 \uC218\uB3C4 \uC788\uC796\uC544.\n\uB4DC\uB798\uACE4\uC740
        \uAC70\uC758 \uC4F0\uB7EC\uC9C0\uAE30 \uC9C1\uC804\uC774\uC5C8\uACE0."
    - TextId: 4
      Text: "\uBA54\uC774\uB2D8\u2026 \uC8C4\uC1A1\uD574\uC694."
    - TextId: 6
      Text: "\uC544\uB2C8. \uB098\uB294 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uC9C0
        \uC54A\uC544."
    - TextId: 2
      Text: "\uBB50?"
    - TextId: 6
      Text: "\uADF8\uB54C \uB8E8\uC774\uC2A4\uB294 \uC4F0\uB7EC\uC84C\uACE0, \uC804\uC7A5\uC740
        \uC774\uBBF8 \uD769\uC5B4\uC838 \uC788\uC5C8\uC5B4.\n\uB0B4 \uBCF4\uD638\uB9C9\uB3C4
        \uB2FF\uC9C0 \uC54A\uC558\uACE0, \uC0C8\uD134\uC758 \uCE74\uC6B4\uD130\uB3C4
        \uC644\uBCBD\uD558\uC9C0 \uC54A\uC558\uC9C0."
    - TextId: 6
      Text: "\uADF8 \uC0C1\uD0DC\uB85C \uACC4\uC18D \uC2F8\uC6E0\uB2E4\uBA74 \uBAA8\uB450\uAC00
        \uB2E4\uCCE4\uC744 \uC218\uB3C4 \uC788\uC5B4."
    - TextId: 4
      Text: "\uD504\uB9AC\uB4DC\uB2D8\uC740\u2026 \uC800\uB97C \uC6D0\uB9DD\uD558\uC9C0
        \uC54A\uC73C\uC2ED\uB2C8\uAE4C?"
    - TextId: 6
      Text: "\uC6D0\uB9DD\uD558\uC9C0 \uC54A\uC544. \uB370\uC6B0\uC2A4 \uB355\uBD84\uC5D0
        \uBAA8\uB450 \uC0B4\uC544 \uB3CC\uC544\uC654\uC796\uC544."
    - TextId: 2
      Text: "\uD558\uC9C0\uB9CC \uB4DC\uB798\uACE4\uC740 \uB193\uCCE4\uC5B4.\n\uB4DC\uB798\uACE4\uC744
        \uC7A1\uC558\uB354\uB77C\uBA74 \uB8E8\uC774\uC2A4\uB3C4 \uB354 \uC88B\uC740
        \uCE58\uB8CC\uB97C \uBC1B\uC744 \uC218 \uC788\uC5C8\uB2E4\uACE0!"
    - TextId: 6
      Text: "\uB9DE\uC544. \uD558\uC9C0\uB9CC \uC911\uC694\uD55C \uAC74 \uB4DC\uB798\uACE4\uC774
        \uC544\uB0D0."
    - TextId: 1
      Text: "(\uD504\uB9AC\uB4DC\uB294 \uB370\uC6B0\uC2A4\uC758 \uADC0\uD658\uB9C8\uBC95\uC744
        \uC2E4\uD328\uB85C\uB9CC \uBCF4\uC9C0 \uC54A\uC544.)"
    - TextId: 1
      Text: "(\uC624\uD788\uB824 \uADF8\uB54C \uB354 \uBB34\uB9AC\uD588\uB2E4\uBA74
        \uBAA8\uB450\uAC00 \uC704\uD5D8\uD588\uC744 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD558\uACE0
        \uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P07_01
    CharacterId: 7
    ClueIndex: 1
    ClueText: "\uC0C8\uD134\uC740 \uC804\uD22C\uC5D0\uC11C \uC81C\uC790\uB9AC\uC5D0
      \uBA38\uBB34\uB294 \uAC83\uBCF4\uB2E4 \uC0C1\uD669\uC5D0 \uB9DE\uB294 \uC704\uCE58\uB97C
      \uC7A1\uB294 \uAC83\uC774 \uC911\uC694\uD558\uB2E4\uACE0 \uC0DD\uAC01\uD55C\uB2E4."
    HintText: "\uC0C8\uD134\uC740 \uC804\uD22C \uC911 \uD55C\uBC88 \uC815\uD55C \uC704\uCE58\uB97C
      \uB05D\uAE4C\uC9C0 \uC9C0\uD0A4\uB294 \uAC83\uC774 \uAC00\uC7A5 \uC548\uC804\uD558\uB2E4\uACE0
      \uC0DD\uAC01\uD55C\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uC2E0\uC785\uACFC \uC0C8\uD134\uC758
      \uCCAB \uC778\uC0AC"
    Combo: 0100000007000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites: []
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uC0C8\uD134\uB2D8, \uB9DE\uC73C\uC2DC\uC8E0?\n\uC0C8\uB85C \uD569\uB958\uD55C
        \uC5D4\uBE44\uC608\uC694. \uC798 \uBD80\uD0C1\uB4DC\uB824\uC694."
    - TextId: 7
      Text: "...\uC870\uAE08 \uB354 \uB0B4 \uCABD\uC73C\uB85C \uC640\uBD10."
    - TextId: 1
      Text: "\uC5B4, \uB124..! \uC5EC\uAE30 \uC788\uC73C\uBA74 \uB418\uB098\uC694?"
    - TextId: 7
      Text: "\uC88B\uC544. \uAC70\uAE30 \uC11C\uC11C \uC598\uAE30\uD574."
    - TextId: 7
      Text: "\uC0C8\uD134. \uC6D0\uAC70\uB9AC \uB9C8\uBC95\uC0AC\uC57C."
    - TextId: 1
      Text: "\uD639\uC2DC \uC65C \uC5EC\uAE30 \uC11C \uC788\uC5B4\uC57C \uD558\uB294\uC9C0
        \uC5EC\uCB64\uBD10\uB3C4 \uB418\uB098\uC694..?"
    - TextId: 7
      Text: "\uBC29\uAE08 \uB124\uAC00 \uC11C \uC788\uB358 \uACF3\uC740 \uBB38\uC744
        \uB4F1\uC9C0\uACE0 \uC788\uC5C8\uC5B4.\n\uC67C\uCABD\uC5D0\uB294 \uB300\uAC80\uB4E4\uC774,
        \uC624\uB978\uCABD\uC5D0\uB294 \uBC29\uD328 \uB354\uBBF8\uAC00 \uC788\uC5C8\uC5B4.\n\uB204\uAC00
        \uACF5\uACA9\uD558\uBA74 \uD53C\uD560 \uC218 \uC5C6\uB294 \uB124\uAC00 \uBA3C\uC800
        \uB2F9\uD574."
    - TextId: 1
      Text: "\uC544\u2026 \uC81C \uC548\uC804 \uB54C\uBB38\uC774\uC5C8\uB098\uC694?
        \uAC10\uC0AC\uD569\uB2C8\uB2E4."
    - TextId: 7
      Text: "\uB0B4 \uB208\uC5D0\uB294 \uC548 \uBCF4\uB824\uACE0 \uD574\uB3C4 \uBCF4\uC5EC.\n\uC6D0\uAC70\uB9AC
        \uB9C8\uBC95\uC0AC\uC5D0\uAC8C \uC704\uCE58\uB294 \uBAA9\uC228\uACFC\uB3C4
        \uAC19\uC544."
    - TextId: 1
      Text: "\uC544\uD558, \uADF8\uB7EC\uBA74 \uD56D\uC0C1 \uD6C4\uBC29\uC5D0 \uACC4\uC2DC\uACA0\uB124\uC694?"
    - TextId: 7
      Text: "\uAF2D \uADF8\uB7F0\uAC74 \uC544\uB0D0. \uC0C1\uD669\uC744 \uD56D\uC0C1
        \uC8FC\uC2DC\uD558\uACE0 \uD544\uC694\uD55C \uACF3\uC73C\uB85C \uC6C0\uC9C1\uC5EC.\n\uC548\uC804\uD55C
        \uACF3\uC73C\uB85C \uB3C4\uB9DD\uAC04\uB2E4\uACE0 \uC0DD\uAC01\uD560 \uC218\uB3C4
        \uC788\uACA0\uC9C0\uB9CC, \uBCF4\uD1B5 \uD544\uC694\uD55C \uC790\uB9AC\uB294
        \uC548\uC804\uD558\uC9C0 \uC54A\uC544."
    - TextId: 7
      Text: "\uC804\uC120\uC5D0\uC11C \uB9C9\uC9C0 \uBABB\uD55C \uD30C\uD3B8\uC774\uB098,
        \uD6C4\uBC29\uC744 \uB178\uB9AC\uB294 \uACF5\uACA9\uB3C4 \uD56D\uC0C1 \uB300\uBE44\uD574\uC57C
        \uD558\uAC70\uB4E0.\n\uB204\uAD6C\uB098 \uD6C4\uBC29\uC758 \uB9C8\uBC95\uC0AC\uB97C
        1\uC21C\uC704\uB85C \uC81C\uAC70\uD558\uACE0 \uC2F6\uC5B4 \uD558\uB2C8\uAE4C."
    - TextId: 7
      Text: "...\uC808\uB300 \uB3C4\uB9DD\uCE58\uB294\uAC8C \uC544\uB0D0."
    - TextId: 1
      Text: "(\uC0C8\uD134\uC774 \uC9C0\uC815\uD574\uC900 \uC704\uCE58\uB294 \uB0B4\uAC00
        \uB2E4\uB978\n\uC0AC\uB78C\uC758 \uACF5\uACA9\uC5D0 \uB300\uC751\uD560 \uC218
        \uC788\uB294\n\uC790\uB9AC\uC774\uAE30\uB3C4, \uB0B4\uAC00 \uC0C8\uD134\uC744
        \uACF5\uACA9\uD558\uAE30 \uD798\uB4E0\n\uC790\uB9AC\uC774\uAE30\uB3C4 \uD574.)"
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uACBD\uACC4\uC2EC\uC774 \uB9CE\uC544. \uC870\uC2EC\uD574\uC57C\uACA0\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P07_02
    CharacterId: 7
    ClueIndex: 2
    ClueText: "\uC0C8\uD134\uC740 \uB8E8\uC774\uC2A4\uAC00 \uC704\uD5D8\uD55C \uC704\uCE58\uC5D0\uC11C
      \uB9DD\uC124\uC778 \uAC83\uC774 \uC804\uC7A5\uC744 \uB354 \uBD88\uC548\uC815\uD558\uAC8C
      \uB9CC\uB4E4\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC788\uB2E4."
    HintText: "\uC0C8\uD134\uC740 \uB8E8\uC774\uC2A4\uAC00 \uADF8 \uC790\uB9AC\uC5D0
      \uBA48\uCDB0 \uC788\uC5C8\uAE30 \uB54C\uBB38\uC5D0 \uC804\uC7A5\uC774 \uB354
      \uC548\uC815\uC801\uC73C\uB85C \uC720\uC9C0\uB418\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0
      \uC788\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uC0C8\uD134\uC774 \uB418\uC9DA\uC740
      \uB8E8\uC774\uC2A4\uC758 \uC704\uCE58\n\uD544\uC694 \uB2E8\uC11C: \uD6C8\uB828\uC7A5\uC5D0\uC11C
      \uC0C8\uD134\uC774 \uB418\uC9DA\uC740 \uB8E8\uC774\uC2A4\uC758 \uC704\uCE58"
    Combo: 010000000300000007000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P07_01
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 3
      Text: "\uC0C8\uD134, \uC800\uB141 \uC790\uB9AC\uB294 \uC5B4\uB514\uAC00 \uC88B\uC544?\n\uBA54\uC774\uAC00
        \uACE7 \uB0B4\uB824\uC62C \uAC83 \uAC19\uC740\uB370."
    - TextId: 7
      Text: "\uB098\uB294 \uCF54\uB108 \uCABD."
    - TextId: 3
      Text: "\uBB38\uACFC \uACC4\uB2E8\uC774 \uAC19\uC774 \uBCF4\uC774\uB294 \uC790\uB9AC\uB77C
        \uADF8\uB7F0\uAC70\uC9C0?"
    - TextId: 7
      Text: "\uAE00\uC384."
    - TextId: 1
      Text: "\uC2DD\uC0AC \uC790\uB9AC\uB3C4 \uADF8\uB807\uAC8C \uACE0\uB974\uC138\uC694?"
    - TextId: 7
      Text: "\uC2B5\uAD00\uC774\uC57C."
    - TextId: 3
      Text: "\uC0C8\uD134\uC740 \uB298 \uBA3C\uC800 \uC790\uB9AC\uB97C \uBD10.\n\uB098\uB294
        \uBA54\uB274\uBD80\uD130 \uACE0\uBBFC\uD558\uB294\uB370."
    - TextId: 3
      Text: "\uC624, \uC774\uAC83\uBD10. \uC624\uB298\uC740 \uD574\uC0B0\uBB3C \uC694\uB9AC\uAC00
        \uC2E0\uC120\uD558\uB300.\n\uB9DB\uC788\uACA0\uB2E4."
    - TextId: 3
      Text: "\uC73C\uC74C... \uADFC\uB370 \uC0C8\uD134\uC740 \uBE44\uB9B0 \uC74C\uC2DD
        \uC2EB\uC5B4\uD558\uC9C0 \uC54A\uC558\uB098?\n\uC57C\uCC44 \uC694\uB9AC\uB85C
        \uD560\uAE4C?"
    - TextId: 7
      Text: "\uB8E8\uC774\uC2A4\uB294 \uBA54\uB274\uB3C4 \uC624\uB798 \uACE0\uBBFC\uD558\uC9C0.\n\uBA54\uC774\uB791\uC740
        \uC815\uBC18\uB300\uC57C."
    - TextId: 3
      Text: "\uD558\uD558, \uBA38\uC4F1\uD558\uB124. \uB2E4\uB4E4 \uBA39\uC744 \uC218
        \uC788\uB294 \uAC78 \uACE0\uB974\uB824\uB2E4 \uBCF4\uB2C8\uAE4C."
    - TextId: 7
      Text: "\uC758\uB3C4\uB294 \uC88B\uC9C0\uB9CC, \uBB38\uC81C\uB294 \uB124\uAC00
        \uACE0\uBBFC\uD558\uB294 \uB3D9\uC548 \uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uB3C4
        \uBA48\uCDB0\uC57C \uD55C\uB2E4\uB294 \uAC70\uC57C."
    - TextId: 1
      Text: "\uC8FC\uBCC0\uC774\uC694?"
    - TextId: 7
      Text: "\uC0AC\uB78C\uB4E4\uC774 \uB124 \uACB0\uC815\uC744 \uAE30\uB2E4\uB824.\n\uC544\uB2C8\uBA74
        \uAE30\uB2E4\uB9AC\uB2E4 \uBABB\uD574 \uBA3C\uC800 \uC6C0\uC9C1\uC5EC.\n\uADF8
        \uB0A0\uB3C4 \uADF8\uB7AC\uC9C0."
    - TextId: 3
      Text: "\u2026\u2026"
    - TextId: 1
      Text: "\uC0C8\uD134\uB2D8, \uB8E8\uC774\uC2A4\uB2D8\uC740 \uC2E0\uC911\uD558\uC2E0
        \uAC70\uC796\uC544\uC694.\n\uC9C0\uAE08\uB3C4 \uC0C8\uD134\uB2D8\uC744 \uC0DD\uAC01\uD574\uC11C
        \uADF8\uB7EC\uC2E0\uAC74\uB370..."
    - TextId: 7
      Text: "\uBB50, \uB0B4 \uB9D0\uC740 \uBAA8\uB4E0\uAC8C \uB2E4 \uC88B\uC744 \uC218\uB294
        \uC5C6\uB2E4\uB294 \uB73B\uC774\uC5C8\uC5B4.\n\uB8E8\uC774\uC2A4\uC758 \uC2E0\uC911\uD568\uB3C4
        \uD544\uC694\uD558\uC9C0."
    - TextId: 7
      Text: "\uC800\uB141 \uBA54\uB274\uB294 \uD574\uC0B0\uBB3C \uC694\uB9AC\uB85C
        \uD558\uC790."
    - TextId: 3
      Text: "\uC5B4, \uD574\uC0B0\uBB3C \uAD1C\uCC2E\uC544?\n\uBE44\uB9B0 \uC74C\uC2DD
        \uC2EB\uC5B4\uD558\uC9C0 \uC54A\uC558\uC5B4?"
    - TextId: 7
      Text: "\uC2EB\uC5B4\uD574."
    - TextId: 3
      Text: "\uADF8\uB7EC\uBA74 \uC57C\uCC44 \uC694\uB9AC\uB97C..."
    - TextId: 7
      Text: "\uD574\uC0B0\uBB3C."
    - TextId: 3
      Text: "\uC5B4\uC5B4.. \uC54C\uACA0\uC5B4. \uC0AC\uC7A5\uB2D8 \uC5EC\uAE30 \uD574\uBB3C\uCC1C
        \uB300\uC9DC\uC694~"
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uB8E8\uC774\uC2A4\uB97C \uBBF8\uC6CC\uD574\uC11C
        \uC9C0\uC801\uD558\uB294 \uAC8C \uC544\uB2C8\uC57C.)"
    - TextId: 1
      Text: "(\uD558\uC9C0\uB9CC \uB8E8\uC774\uC2A4\uAC00 \uBA48\uCDB0 \uC788\uB294
        \uC2DC\uAC04 \uC790\uCCB4\uB97C \uC704\uD5D8\uD55C \uBCC0\uC218\uB85C \uBCF4\uACE0
        \uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P07_03
    CharacterId: 7
    ClueIndex: 3
    ClueText: "\uC0C8\uD134\uC740 \uB8E8\uC774\uC2A4 \uACC1\uC744 \uB5A0\uB09C \uAC83\uC774
      \uB3C4\uB9DD\uC774 \uC544\uB2C8\uB77C, \uD6C4\uBC29 \uACF5\uACA9\uC744 \uB9C9\uAE30
      \uC704\uD55C \uD310\uB2E8\uC774\uC5C8\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0
      \uC788\uB2E4."
    HintText: "\uC0C8\uD134\uC740 \uADF8\uB0A0 \uB8E8\uC774\uC2A4 \uACC1\uC744 \uB5A0\uB09C
      \uC774\uC720\uAC00 \uC790\uC2E0\uC758 \uC548\uC804\uC744 \uBA3C\uC800 \uD655\uBCF4\uD558\uAE30
      \uC704\uD574\uC11C\uC600\uB2E4\uACE0 \uC778\uC815\uD558\uACE0 \uC788\uB2E4."
    HintDescription: "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uB370\uC6B0\uC2A4\uC758 \uACFC\uBCF4\uD638\uB97C
      \uC9C0\uC801\uD558\uB294 \uC0C8\uD134\n\uD544\uC694 \uB2E8\uC11C: \uD6C8\uB828\uC7A5\uC5D0\uC11C
      \uC0C8\uD134\uC774 \uB418\uC9DA\uC740 \uB8E8\uC774\uC2A4\uC758 \uC704\uCE58"
    Combo: 010000000400000007000000
    PlaceName: "\uD6C8\uB828\uC7A5"
    DeadRequired: 
    Prerequisites:
    - P07_02
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uC0C8\uD134\uB2D8, \uC7A0\uC2DC \uC2DC\uAC04 \uAD1C\uCC2E\uC73C\uC2ED\uB2C8\uAE4C?\n\uB8E8\uC774\uC2A4\uB2D8\uC774
        \uAC78\uC744 \uB54C \uC67C\uCABD\uC73C\uB85C \uC870\uAE08 \uAE30\uC6B0\uB294
        \uAC83 \uAC19\uC2B5\uB2C8\uB2E4. \uB0B4\uC77C \uD55C \uBC88 \uBD10\uC8FC\uC2E4
        \uC218 \uC788\uB098\uC694?"
    - TextId: 7
      Text: "\uC67C\uBC1C\uC5D0 \uD798\uC774 \uB35C \uB4E4\uC5B4\uAC00.\n\uB9C8\uB825
        \uD750\uB984\uB3C4 \uADF8\uCABD\uC774 \uC57D\uD574."
    - TextId: 1
      Text: "\uC5C7, \uC774\uBBF8 \uC54C\uACE0 \uACC4\uC168\uAD70\uC694.\n\uADF8\uB7F0
        \uAC83\uB3C4 \uBCF4\uC774\uC138\uC694?"
    - TextId: 7
      Text: "\uB9C8\uB825 \uD750\uB984\uC774 \uD754\uB4E4\uB9AC\uBA74 \uC790\uC138\uB3C4
        \uAC19\uC774 \uD754\uB4E4\uB824."
    - TextId: 4
      Text: "\uADF8\uB0A0\uB3C4 \uADF8\uB807\uAC8C \uB4DC\uB798\uACE4\uC758 \uD750\uB984\uC744
        \uBCF4\uC2E0 \uAC70\uC8E0."
    - TextId: 7
      Text: "\uB9DE\uC544. \uD6C4\uBC29\uC73C\uB85C \uB9C8\uB825\uC774 \uBE60\uB974\uAC8C
        \uBAB0\uB9AC\uACE0 \uC788\uC5C8\uC5B4.\n\uD070 \uACF5\uACA9\uC774 \uC788\uC744
        \uC608\uACE0\uC600\uC9C0."
    - TextId: 4
      Text: "\uC800\uB294 \uC0C8\uD134\uB2D8\uAED8 \uBD80\uD0C1\uB4DC\uB838\uC5B4\uC694.\n\uC81C\uAC00
        \uAE30\uB3C4\uD558\uB294 \uB3D9\uC548\uB9CC\uC774\uB77C\uB3C4 \uB8E8\uC774\uC2A4\uB2D8
        \uACC1\uC5D0 \uC788\uC5B4\uB2EC\uB77C\uACE0\uC694."
    - TextId: 7
      Text: "\uD558\uC9C0\uB9CC \uADF8 \uACF5\uACA9\uC744 \uCE74\uC6B4\uD130 \uCE58\uB824\uBA74
        \uC8FC\uBB38\uC744 \uC601\uCC3D\uD558\uBA74\uC11C \uD6C4\uBC29\uC73C\uB85C
        \uC774\uB3D9\uD574\uC57C \uD588\uC5B4.\n\uADF8\uAC78 \uB9C9\uC9C0 \uC54A\uC73C\uBA74
        \uD6C4\uBC29\uC740 \uC804\uBA78\uC774\uC5C8\uC5B4."
    - TextId: 4
      Text: "\uADF8\uB798\uB3C4 \uC81C \uBD80\uD0C1\uC744..."
    - TextId: 7
      Text: "\uB0B4\uAC00 \uB2A6\uC73C\uBA74 \uB8E8\uC774\uC2A4\uB9CC\uC774 \uC544\uB2C8\uB77C
        \uBAA8\uB450\uAC00 \uC704\uD5D8\uD55C \uC0C1\uD669\uC774\uC5C8\uC5B4."
    - TextId: 4
      Text: ...
    - TextId: 7
      Text: "\uB370\uC6B0\uC2A4, \uB8E8\uC774\uC2A4\uB294 \uC544\uAE30\uAC00 \uC544\uB2C8\uC57C.\n\uC790\uAFB8
        \uADF8\uB807\uAC8C \uACFC\uBCF4\uD638 \uD558\uB824\uACE0 \uD558\uBA74 \uC548\uB3FC."
    - TextId: 7
      Text: "\uADF8\uB54C \uC77C\uC740 \uBB50\uB77C\uACE0 \uD574\uB3C4 \uC5B4\uCA54
        \uC218 \uC5C6\uC5B4.\n\uB2E4\uB978 \uC120\uD0DD\uC744 \uD560 \uC21C \uC5C6\uC5C8\uC5B4."
    - TextId: 1
      Text: "(\uB370\uC6B0\uC2A4\uB294 \uC0C8\uD134\uC774 \uB8E8\uC774\uC2A4\uB97C
        \uBC84\uB838\uB2E4\uACE0 \uBCF4\uACE0\n\uC788\uACE0, \uC0C8\uD134\uC740 \uD6C4\uBC29\uC744
        \uB9C9\uAE30 \uC704\uD574\n\uC6C0\uC9C1\uC600\uB2E4\uACE0 \uBBFF\uACE0 \uC788\uB124.)"
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uC790\uC2E0\uC774 \uB3C4\uB9DD\uCE5C \uAC8C \uC544\uB2C8\uB77C,
        \uD300\uC744 \uC704\uD55C \uC704\uCE58\uB85C \uC62E\uACBC\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0
        \uC788\uC5B4.)"
    DesignerNote: 
  - ProfileClueId: P07_04
    CharacterId: 7
    ClueIndex: 4
    ClueText: "\uC0C8\uD134\uC740 \uBAA8\uB450\uB97C \uC0B4\uB9AC\uAE30 \uC704\uD55C
      \uD310\uB2E8\uC774\uC5C8\uB2E4\uACE0 \uBBFF\uACE0 \uC788\uC9C0\uB9CC, \uADF8
      \uACB0\uACFC \uC544\uBB34\uB3C4 \uB0A8\uC9C0 \uC54A\uC558\uB2E4\uB294 \uC0AC\uC2E4
      \uC55E\uC5D0\uC11C \uD754\uB4E4\uB9AC\uACE0 \uC788\uB2E4."
    HintText: "\uC0C8\uD134\uC740 \uB3D9\uB8CC\uB4E4\uC774 \uBAA8\uB450 \uC8FD\uC740
      \uB4A4\uC5D0\uB3C4 \uC790\uC2E0\uC758 \uD310\uB2E8\uC5D0 \uC544\uBB34\uB7F0
      \uC758\uC2EC\uC774\uB098 \uB3D9\uC694\uB97C \uB290\uB07C\uC9C0 \uC54A\uACE0
      \uC788\uB2E4."
    HintDescription: " \uC5F0\uC778 \uADF8\uB9AC\uACE0 \uB3D9\uB8CC\uB4E4\uC758 \uC8FD\uC74C\u2026
      \uBC29\uAD00\uD558\uB294 \uC0C8\uD134, \uC808\uB9DD\uD558\uB294 \uB370\uC6B0\uC2A4.\n\uD544\uC694
      \uB2E8\uC11C: \uD6C8\uB828\uC5D0\uC11C \uB370\uC6B0\uC2A4\uC758 \uACFC\uBCF4\uD638\uB97C
      \uC9C0\uC801\uD558\uB294 \uC0C8\uD134 \uC608\uBC30\uC2E4\uC5D0\uC11C \uB8E8\uC774\uC2A4,
      \uB370\uC6B0\uC2A4 \uADF8\uB9AC\uACE0 \uC0C8\uD134\uC774 \uBC1D\uD78C \uD30C\uD3B8\uC758
      \uC9C4\uC0C1"
    Combo: 010000000400000007000000
    PlaceName: 
    DeadRequired: 030000000500000006000000
    Prerequisites:
    - P04_04
    - P07_03
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 4
      Text: "\uC0C8\uD134\uB2D8. \uADF8\uB0A0 \uD6C4\uBC29\uC744 \uB9C9\uC73C\uB824\uACE0
        \uC6C0\uC9C1\uC600\uB2E4\uACE0 \uD558\uC168\uC8E0."
    - TextId: 7
      Text: "...\uADF8\uB54C\uB294 \uADF8\uAC8C \uBAA8\uB450\uB97C \uC0B4\uB9AC\uB294
        \uAE38\uC774\uB77C\uACE0 \uC0DD\uAC01\uD588\uC5B4."
    - TextId: 4
      Text: "\uBAA8\uB450\uB77C\uB2C8. \uC9C0\uAE08 \uC5EC\uAE30\uC5D4 \uB204\uAC00
        \uB0A8\uC544 \uC788\uC8E0?"
    - TextId: 4
      Text: "\uBAA8\uB450 \uC8FD\uC5C8\uC5B4\uC694! \uBA54\uC774\uB2D8, \uD1A0\uB2C8\uB2D8,
        \uD504\uB9AC\uB4DC\uB2D8\uB3C4, \uB8E8\uC774\uC2A4\uB2D8\uB3C4 \uBAA8\uB450
        \uC5C6\uB2E4\uACE0\uC694!!"
    - TextId: 7
      Text: ...
    - TextId: 4
      Text: "\uC800\uB294 \uADF8\uB0A0 \uB8E8\uC774\uC2A4\uB2D8\uC744 \uB9E1\uACBC\uC5C8\uC5B4\uC694."
    - TextId: 7
      Text: "...\uADF8\uB54C \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uB354
        \uB9CE\uC740 \uC0AC\uB78C\uC774 \uC8FD\uC5C8\uC744 \uAC70\uC57C."
    - TextId: 4
      Text: "\uADF8 \uB9D0, \uC774\uC81C \uC544\uBB34 \uC758\uBBF8 \uC5C6\uC5B4\uC694.\n\uC0C8\uD134\uB2D8\uC740
        \uACC4\uC18D \uB3C4\uB9DD\uCE58\uAE30\uB9CC \uD558\uB2E4\uAC00 \uBAA8\uB450\uB97C
        \uC8FD\uAC8C \uB0B4\uBC84\uB824 \uB454 \uAC70\uC5D0\uC694."
    - TextId: 4
      Text: "\uB8E8\uC774\uC2A4\uB2D8\uC744 \uBC84\uB9AC\uACE0 \uB3C4\uB9DD\uCE60
        \uB54C \uBD80\uD130 \uC54C\uC544\uBD24\uC5B4\uC57C \uD588\uB294\uB370!!!"
    - TextId: 7
      Text: "\uB098\uB294 \uBAA8\uB450\uB97C \uC704\uD574\uC11C..."
    - TextId: 4
      Text: "\uC9C0\uAE08 \uC774 \uC0C1\uD669\uC744 \uBCF4\uACE0\uB3C4 \uADF8\uB7F0
        \uB9D0\uC774 \uB098\uC640\uC694?\n\uC0C8\uD134\uB2D8 \uB9D0\uACE0 \uB2E4\uB978\uBD84\uAED8
        \uBC84\uD504\uB97C \uAC78\uC5B4 \uB4DC\uB824\uC57C \uD588\uB358 \uAC74\uB370...
        \uC544\uC544..."
    - TextId: 1
      Text: "(\uC801\uC758 \uC2B5\uACA9\uC5D0 \uBAA8\uB450 \uC8FD\uC5B4\uBC84\uB838\uB124.\n\uC0C8\uD134\uC740
        \uACC4\uC18D \uD6C4\uBC29\uC73C\uB85C \uC790\uB9AC\uB97C \uC62E\uAE30\uBA74\uC11C
        \uC0B4\uC544\uB0A8\uC558\uC9C0\uB9CC...)"
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uD754\uB4E4\uB9AC\uACE0 \uC788\uC5B4.\n\uD300\uC744
        \uC704\uD55C \uD310\uB2E8\uC774\uC5C8\uB2E4\uB294 \uB9D0\uC774 \uC774\uC81C\uB294
        \uBCC0\uBA85\uCC98\uB7FC \uB4E4\uB9AC\uACA0\uB124.)"
    - TextId: 1
      Text: "(\uC544\uB9C8 \uB610 \uCC98\uC74C\uC73C\uB85C \uB418\uB3CC\uC544\uAC00\uACA0\uC9C0.\n\uB2E4\uC74C\uC5D0\uB294
        \uC0C8\uD134\uC5D0\uAC8C\uB3C4 \uC774 \uADE0\uC5F4\uC744 \uB354 \uC77C\uCC0D
        \uC2EC\uC5B4\uB46C\uC57C\uACA0\uC5B4.)"
    - TextId: 1
      Text: "(\uC0C8\uD134\uC740 \uBAA8\uB450\uB97C \uAD6C\uD558\uB824 \uD588\uACE0,
        \uACB0\uAD6D \uC544\uBB34\uB3C4 \uAD6C\uD558\uC9C0 \uBABB\uD588\uB2E4.\n\uC774
        \uBAA8\uC21C\uC774 \uC0C8\uD134\uC744 \uD754\uB4E4 \uC5F4\uC1E0\uC57C.)"
    DesignerNote: "\"\uD574\uB2F9 \uC870\uAC01 \uD68D\uB4DD \uC2DC \uC790\uB3D9\uC73C\uB85C"
  - ProfileClueId: P07_05
    CharacterId: 7
    ClueIndex: 5
    ClueText: "\uC0C8\uD134\uC740 \uB4A4\uB2A6\uAC8C \uC6A9\uBCD1\uB2E8\uC758 \uBD95\uAD34\uAC00
      \uC11C\uB85C\uC758 \uC624\uD574\uC640 \uCE68\uBB35\uC5D0\uC11C \uBE44\uB86F\uB418\uC5C8\uB2E4\uACE0
      \uAE68\uB2EB\uACE0 \uC788\uB2E4."
    HintText: "\uC0C8\uD134\uC740 \uB3D9\uB8CC\uB4E4\uC758 \uC8FD\uC74C\uC5D0 \uBB34\uB364\uB364\uD588\uB2E4."
    HintDescription: "\uBAA8\uB450\uC758 \uC8FD\uC74C\uC744 \uBC29\uAD00\uD55C \uC0C8\uD134\n\uD544\uC694
      \uB2E8\uC11C: \uC5F0\uC778 \uADF8\uB9AC\uACE0 \uB3D9\uB8CC\uB4E4\uC758 \uC8FD\uC74C\u2026
      \uBC29\uAD00\uD558\uB294 \uC0C8\uD134, \uC808\uB9DD\uD558\uB294 \uB370\uC6B0\uC2A4."
    Combo: 0100000007000000
    PlaceName: 
    DeadRequired: 03000000040000000500000006000000
    Prerequisites:
    - P07_04
    SimultaneousIds: []
    IsForcedExitFragment: 0
    Lines:
    - TextId: 1
      Text: "\uC6A9\uBCD1\uB2E8\uC758 \uB3D9\uB8CC\uB4E4\uC740 \uC885\uC885 \uB9D0\uD588\uC8E0.\n\uC0C8\uD134\uB2D8\uC740
        \uD56D\uC0C1 \uC790\uC2E0\uC758 \uBAA9\uC228\uC744 \uC6B0\uC120\uC2DC \uD55C\uB2E4\uACE0\uC694."
    - TextId: 7
      Text: "\uADF8\uAC74 \uC624\uD574\uC57C. \uB098\uB294 \uD300\uC744 \uC704\uD55C
        \uD310\uB2E8\uC744 \uD588\uC5B4.\n\uADF8\uB54C\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uC57C.\n\uD300\uC744
        \uAD6C\uD558\uAE30 \uC704\uD574 \uD6C4\uBC29\uC73C\uB85C \uC774\uB3D9\uD574\uC57C
        \uD55C\uB2E4\uB294 \uC120\uD0DD\uC744 \uD55C \uAC83\uBFD0\uC774\uC57C."
    - TextId: 1
      Text: "\uC9C0\uAE08\uB3C4 \uD300\uC744 \uC704\uD55C \uD310\uB2E8\uC744 \uD55C
        \uAC74\uAC00\uC694?\n\uC758\uC2EC\uC758 \uC528\uC557\uC774 \uACB0\uAD6D \uC774
        \uC6A9\uBCD1\uB2E8\uC744 \uD30C\uAD6D\uC73C\uB85C \uC774\uB04C\uC5C8\uC5B4\uC694.
        \uC0C8\uD134\uB2D8\uC740 \uADF8\uAC78 \uAC00\uB9CC\uD788 \uC9C0\uCF1C\uBCF4\uC168\uACE0\uC694."
    - TextId: 7
      Text: "\uB9D0\uD558\uC9C0 \uC54A\uC73C\uBA74 \uBAB0\uB77C... \uC6B0\uB9AC\uB4E4\uC740
        \uB300\uD654\uAC00 \uD544\uC694\uD588\uC5B4..."
    - TextId: 1
      Text: "(\uC0DD\uAC01\uBCF4\uB2E4 \uB0C9\uCCA0\uD55C \uC131\uACA9\uC774\uC57C.\n\uC624\uD574\uC758
        \uC528\uC557\uC744 \uC2EC\uAE30 \uC704\uD574\uC120 \uC2E0\uC911\uD574\uC57C
        \uB420 \uD544\uC694\uAC00 \uC788\uACA0\uC5B4.\n\uC544\uB9C8 \uB610 \uCC98\uC74C\uC73C\uB85C
        \uB418\uB3CC\uC544\uAC08\uAC70\uC57C.\n\uB300\uBE44\uD574\uC57C\uD574.)"
    DesignerNote: 
